<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Dapper" Version="2.1.66" />
        <PackageReference Include="Microsoft.AspNetCore.Authentication.Google" Version="10.0.1" />
        <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.1" />
        <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="10.0.1" />
        <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.1" />
        <!--
            Microsoft.VisualStudio.Web.CodeGeneration.Design WAS REFERENCED HERE
            AND HAS BEEN REMOVED. Do not re-add it to this project.

            It is a DESIGN-TIME package: its only purpose is to let
            `dotnet aspnet-codegenerator` scaffold controllers and views. The
            application never calls into it. Verified before removal — zero
            source references to Microsoft.VisualStudio.Web.CodeGeneration.*,
            and zero use of Entity Framework Core anywhere in Client, Server or
            Shared. Data access is Dapper over Microsoft.Data.Sqlite; see
            DbRepository.

            It dominated the deliverable. A Release publish carried 38 extra
            assemblies totalling 34.72 MB — 26.2% of a 132.55 MB package — and
            the restore graph shows every one of them was reachable ONLY from
            this single reference: Roslyn 22.43 MB, Entity Framework Core
            5.42 MB (for an app that does not use EF at all), MSBuild 3.70 MB,
            the NuGet client 2.24 MB, plus the scaffolding assemblies, Humanizer
            and Mono.TextTemplating.

            Two narrower fixes were tried first and rejected on evidence:
              PrivateAssets="all"  governs what flows to CONSUMING projects. This
                                   is a direct reference in the app itself, so it
                                   would not stop the copy to output/publish.
              ExcludeAssets="runtime;native"
                                   BREAKS RESTORE: NU1202 x48. Excluding runtime
                                   assets makes NuGet compatibility-check the
                                   Humanizer.Core.<lang> satellite packages, which
                                   target only netstandard2.0/net6.0.
              ExcludeAssets="all"  builds, but consumes no assets at all —
                                   including the build/tools assets scaffolding
                                   needs — so it does not preserve scaffolding
                                   either, while still forcing the whole graph to
                                   restore. A reference that does nothing.

            If someone genuinely needs to scaffold, add the package back
            temporarily, generate the code, and remove it again — it is a
            development tool, not a dependency of this application.
        -->
        <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
        <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.15.0" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Client\AuthWithAdmin.Client.csproj" />
        <ProjectReference Include="..\Shared\AuthWithAdmin.Shared.csproj" />
    </ItemGroup>

    <!--
        CONFIGURATION MUST NOT SHIP IN THE PUBLISH PACKAGE.

        The web SDK publishes appsettings*.json by default, so a Release publish
        carried Server/appsettings.json into the deliverable — with the live
        development JWT signing key, Gmail app password, Airtable token and
        Google client secret in plaintext. Uploading that package would put four
        real credentials on the faculty server, and because appsettings.json is
        the BASE configuration layer it is also what would load if nothing
        overrode it.

        CopyToPublishDirectory="Never" — deliberately not deletion, and not
        emptying the file. CopyToOutputDirectory is left alone, so both files
        still reach bin/ and local development is completely unchanged; only the
        publish step skips them.

        appsettings.Development.json holds no secrets (log levels only) and is
        never loaded when ASPNETCORE_ENVIRONMENT=Production, but there is no
        reason to ship a config file for an environment the server will not run.

        appsettings.Production.template.json is NOT excluded. It is committed,
        placeholder-only, and not loaded by the application — the name the host
        loads is appsettings.Production.json — so it travels with the package as
        the operator's checklist. See docs/DEPLOYMENT.md.

        WHAT THIS MEANS FOR DEPLOYMENT: the published app has no configuration of
        its own. Every value must come from environment variables or from an
        appsettings.Production.json placed on the server (git-ignored, never
        built). That is the intended posture, not a gap.
    -->
    <ItemGroup>
      <Content Update="appsettings.json"             CopyToPublishDirectory="Never" />
      <Content Update="appsettings.Development.json" CopyToPublishDirectory="Never" />
    </ItemGroup>

    <ItemGroup>
      <None Include="wwwroot\Emails\AddedByAdmin.html" />
      <None Include="wwwroot\Emails\ForgetPassword.html" />
      <None Include="wwwroot\Emails\GotApproved.html" />
      <None Include="wwwroot\Emails\VerifyEmail.html" />
    </ItemGroup>

    <!--
        Ensure static-web-asset content-root directories exist.

        ASP.NET Core writes a static-web-assets manifest that lists `compressed/`
        and `jsmodules/` under the project's intermediate output as content roots.
        On dev startup (UseStaticWebAssets), each content root is wrapped in a
        PhysicalFileProvider — and PhysicalFileProvider throws
        DirectoryNotFoundException if the directory does not exist on disk.

        Some configurations (notably hosted Blazor WASM with no .razor.js modules
        and no compressible-asset matches) leave these directories uncreated by
        the SDK. The server then crashes during WebApplication.CreateBuilder and
        every /_framework/* request 404s because the host is dead.

        This target creates the directories before the manifest is consumed.
        Empty directories are fine — PhysicalFileProvider is happy as long as
        they exist.
    -->
    <Target Name="EnsureStaticWebAssetContentRoots" BeforeTargets="Build;PrepareForRun">
        <MakeDir Directories="$(IntermediateOutputPath)compressed" />
        <MakeDir Directories="$(IntermediateOutputPath)jsmodules" />
    </Target>

</Project>
