<component name="ProjectRunConfigurationManager">
  <!--
    Shared Rider run configuration for local Motiva development.

    WHY THIS FILE EXISTS
    Rider will happily auto-create a temporary ".NET Project" configuration that
    launches Server/bin/Debug/net10.0/AuthWithAdmin.Server directly. That path
    does NOT read Server/Properties/launchSettings.json, so it gets no
    ASPNETCORE_URLS and no ASPNETCORE_ENVIRONMENT: Kestrel falls back to its
    built-in http://localhost:5000 and the app runs as Production.

    That breaks Google Calendar OAuth. The redirect_uri Motiva sends is composed
    per request from Request.Scheme + Request.Host (see
    GoogleCalendarController.BuildCallbackUri), so on port 5000 it becomes
    http://localhost:5000/api/google-calendar/callback — which is not the URI
    registered in Google Cloud, and Google answers 400 redirect_uri_mismatch.

    This configuration is of type "LaunchSettings", so it runs THROUGH the
    launch profile and inherits applicationUrl =
    https://localhost:7275;http://localhost:5297.

    The name is deliberately explicit rather than "AuthWithAdmin.Server": the
    auto-created one uses that exact name too, and two identical labels in the
    run dropdown is how the wrong one gets picked without anyone noticing.
  -->
  <configuration default="false"
                 name="Motiva Server (https://localhost:7275)"
                 type="LaunchSettings"
                 factoryName=".NET Launch Settings Profile">
    <option name="LAUNCH_PROFILE_PROJECT_FILE_PATH" value="$PROJECT_DIR$/Server/AuthWithAdmin.Server.csproj" />
    <option name="LAUNCH_PROFILE_TFM" value="net10.0" />
    <option name="LAUNCH_PROFILE_NAME" value="AuthWithAdmin.Server" />
    <option name="USE_EXTERNAL_CONSOLE" value="0" />
    <option name="USE_MONO" value="0" />
    <option name="RUNTIME_ARGUMENTS" value="" />
    <option name="GENERATE_APPLICATIONHOST_CONFIG" value="1" />
    <option name="SHOW_IIS_EXPRESS_OUTPUT" value="0" />
    <option name="SEND_DEBUG_REQUEST" value="1" />
    <option name="ADDITIONAL_IIS_EXPRESS_ARGUMENTS" value="" />
    <method v="2">
      <option name="Build" />
    </method>
  </configuration>
</component>
