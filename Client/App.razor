@using Microsoft.AspNetCore.Components.Authorization
@using AuthWithAdmin.Client.AuthPages

@inject IAuthenticationService _Auth


<CascadingAuthenticationState>

    <!-- פרטי המשתמש - משותפים לכולם -->
    <CascadingValue Value="user">
        <Router AppAssembly="@typeof(Program).Assembly">
            <Found Context="routeData">
                <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">

                    <!-- בזמן האימות -->
                    <Authorizing>
                        <text>Please wait, we are authorizing the user.</text>
                    </Authorizing>

                    <NotAuthorized>
                        <!-- אין אישור -->
                        <NotAllowed/>
                    </NotAuthorized>

                </AuthorizeRouteView>
            </Found>
            
            <NotFound>
                
                <!-- דף לא קיים -->
                <LayoutView Layout="@typeof(MainLayout)">
                    <NotFoundPage/>
                </LayoutView>
                
            </NotFound>
        </Router>
    </CascadingValue>
</CascadingAuthenticationState>

@code {

    //המשתמש עצמו
    User? user;
    // Prevents a stale async-void completion from overwriting a newer result.
    // Each call increments the counter; only the most recent completion applies.
    private int _authHandlerVersion;

    protected override async Task OnInitializedAsync()
    {
        //קבלת פרטי המשתמש
        _Auth.OnAuthenticationStateChanged += HandleAuthenticationStateChanged;
        HandleAuthenticationStateChanged();
    }

    //בכל פעם שמשהו בהזדהות משתנה
    private async void HandleAuthenticationStateChanged()
    {
        var version = ++_authHandlerVersion;
        var loadedUser = await _Auth.GetUserFromClaimAsync();
        if (version == _authHandlerVersion)
        {
            user = loadedUser;
            await InvokeAsync(StateHasChanged);
        }
    }

    public void Dispose()
    {
        _Auth.OnAuthenticationStateChanged -= HandleAuthenticationStateChanged;
    }

}