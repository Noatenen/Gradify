@namespace AuthWithAdmin.Client.Components
@inject NavigationManager Nav
@inject IJSRuntime        JS

@*
    MCopyLinkAction — "here is a link, take it".

    A compact header action, NOT a content card: a label, and one control that
    puts the absolute URL on the clipboard. It is the shape the product already
    used for the student registration link, lifted out so the Assignments
    workspace and StudentRegistrationLink share one implementation instead of
    two copies of the same thirty lines.

    THE CALLER PASSES A ROUTE, NEVER A URL. The absolute address is built here
    with NavigationManager.ToAbsoluteUri, which derives scheme and host from the
    app's own base address — so nothing that renders this has to know, or can
    get wrong, which environment it is running in.

    THE ADDRESS ITSELF IS NOT OURS. This component owns the interaction; the
    route comes from whoever owns the destination (StudentFormLinks for a form,
    StudentRegistrationLink for team registration). It is deliberately not a
    place to add a default route — a copy control with an opinion about where it
    points is the second source of truth this was extracted to remove.
*@

<div class="mcl @Class">
    <span class="mcl-label" title="@Url">@Label</span>

    <button type="button"
            class="mcl-btn @(_copied ? "mcl-btn-done" : "")"
            @onclick="CopyAsync"
            aria-label="@($"{Label} — העתקה")">
        @if (_copied)
        {
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M20 6 9 17l-5-5"></path>
            </svg>
            <span>@CopiedLabel</span>
        }
        else
        {
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="9" y="9" width="13" height="13" rx="2"></rect>
                <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
            </svg>
            <span>@ButtonLabel</span>
        }
    </button>
</div>

@code {
    /// <summary>App-relative route to copy, e.g. <c>/student/assignment</c>.
    /// Required, and required to be a route rather than a URL — see the note
    /// at the top of this file.</summary>
    [Parameter, EditorRequired] public string Route { get; set; } = "";

    /// <summary>What the link is called where it is shown.</summary>
    [Parameter, EditorRequired] public string Label { get; set; } = "";

    /// <summary>The control's own text. Defaulted because almost every caller
    /// wants the same two words.</summary>
    [Parameter] public string ButtonLabel { get; set; } = "העתקת קישור";

    /// <summary>Confirmation text. The feedback is INLINE, on the control that
    /// was pressed, rather than a page toast: a toast belongs to a page that
    /// owns one (the form editor has its own), and a header action that can
    /// appear on any screen cannot assume it.</summary>
    [Parameter] public string CopiedLabel { get; set; } = "הועתק";

    /// <summary>Positioning only — the caller owns where this sits, the
    /// component owns what it looks like.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>The absolute address, derived from the app's base URI. Exposed
    /// through the label's tooltip so the value is inspectable without being
    /// printed at full width across a header.</summary>
    private string Url => Nav.ToAbsoluteUri(Route).ToString();

    private bool _copied;

    private async Task CopyAsync()
    {
        // Guarded: navigator.clipboard is undefined on a non-secure origin and
        // an unhandled interop throw surfaces as a Blazor error overlay.
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", Url);
            _copied = true;
        }
        catch
        {
            return;
        }

        StateHasChanged();
        await Task.Delay(2500);
        _copied = false;
    }
}
