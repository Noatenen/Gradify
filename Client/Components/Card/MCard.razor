@namespace AuthWithAdmin.Client.Components

@{
    RenderFragment header = @<div class="m-card-header">
        @if (Icon is not null)
        {
            <div class="m-card-header-icon">@Icon</div>
        }
        @if (!string.IsNullOrWhiteSpace(Title) || !string.IsNullOrWhiteSpace(Subtitle))
        {
            <div class="m-card-header-text">
                @if (!string.IsNullOrWhiteSpace(Title))
                {
                    <h3 class="m-card-title">@Title</h3>
                }
                @if (!string.IsNullOrWhiteSpace(Subtitle))
                {
                    <p class="m-card-subtitle">@Subtitle</p>
                }
            </div>
        }
        @if (TrailingContent is not null)
        {
            <div class="m-card-header-trailing">@TrailingContent</div>
        }
    </div>;
}

@{
    RenderFragment content = @<text>
        @if (HasHeader) { @header }
        @ChildContent
    </text>;

    // AmbientEdge draws a 1px gradient as the card's own background and lays the
    // real surface on top of it, so it needs one extra element. Every other
    // variant renders exactly the markup it always did.
    RenderFragment shell = content;
    if (Variant == CardVariant.AmbientEdge)
    {
        shell = @<div class="m-card-inner">@content</div>;
    }
}

@if (Interactive)
{
    <div class="@RootClass"
         role="button"
         tabindex="0"
         @onclick="HandleClickAsync"
         @onkeydown="HandleKeyDownAsync">
        @shell
    </div>
}
else
{
    <div class="@RootClass">@shell</div>
}

@code {
    /// <summary>
    /// <c>Default</c> — hairline border, no resting shadow.
    /// <c>Elevated</c> — the same card with a raised shadow.
    /// <c>Ambient</c> — the soft radial wash used behind hero content.
    /// <c>AmbientEdge</c> — the System Master's highest-emphasis surface: a 1px
    /// violet→transparent→teal gradient rule around a white card. Added in Phase
    /// 4B, when the finalized Tasks screen used it on three sections at once;
    /// before that the treatment existed only as the <c>--motiva-gradient-edge</c>
    /// token with nothing consuming it.
    ///
    /// <para>Note that <c>Ambient</c> (a background wash) and <c>AmbientEdge</c>
    /// (a border) are different treatments, not two names for one thing.</para>
    /// </summary>
    public enum CardVariant { Default, Elevated, Ambient, AmbientEdge }

    /// <summary>"None" gives the card itself zero padding so ChildContent can run
    /// edge-to-edge (full-bleed lists/dividers/panels); the optional header still
    /// gets its own token-driven inset in that case — see MCard.razor.css's
    /// ".m-card-padding-none .m-card-header" rule, which only applies here and
    /// never touches Small/Medium/Large.</summary>
    public enum CardPadding { Small, Medium, Large, None }

    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public CardVariant Variant { get; set; } = CardVariant.Default;
    [Parameter] public CardPadding Padding { get; set; } = CardPadding.Medium;

    /// <summary>Whether the whole card is a click/keyboard target. Independent of
    /// <see cref="Variant"/> so a card's visual style (Default/Elevated/Ambient)
    /// and its interaction mode can be combined freely, e.g. an Ambient hero
    /// card that is also clickable.</summary>
    [Parameter] public bool Interactive { get; set; }

    /// <summary>Makes the card fill its parent's height and lay its content out
    /// as a column, so a card in a stretched grid/flex row sizes from the row
    /// rather than from its own content. Exists because Blazor CSS isolation
    /// stops a caller from styling this component's root element: without it, a
    /// page cannot make an MCard fill a fixed-height grid track at all.</summary>
    [Parameter] public bool Fill { get; set; }

    [Parameter] public string? Class { get; set; }
    [Parameter] public EventCallback<MouseEventArgs> OnClick { get; set; }

    /// <summary>Optional leading icon area in the header row. The caller supplies
    /// the icon markup (e.g. an "oi" glyph span) — MCard only sizes/positions it
    /// and has no opinion on icon font or a forced circle/badge treatment.</summary>
    [Parameter] public RenderFragment? Icon { get; set; }

    /// <summary>Optional header title, rendered as an h3. If a card needs a
    /// different heading level for document-outline reasons, skip this parameter
    /// and place a heading inside <see cref="ChildContent"/> instead — MCard still
    /// has no opinion on heading level there.</summary>
    [Parameter] public string? Title { get; set; }

    /// <summary>Optional header subtitle, shown under <see cref="Title"/> in a
    /// muted, smaller style.</summary>
    [Parameter] public string? Subtitle { get; set; }

    /// <summary>Optional compact trailing header content — a count badge, a small
    /// action button, or similar. Pinned to the end of the header row regardless
    /// of how many lines Title/Subtitle wrap to.</summary>
    [Parameter] public RenderFragment? TrailingContent { get; set; }

    private bool HasHeader =>
        Icon is not null
        || !string.IsNullOrWhiteSpace(Title)
        || !string.IsNullOrWhiteSpace(Subtitle)
        || TrailingContent is not null;

    private string RootClass =>
        $"m-card m-card-{Variant.ToString().ToLowerInvariant()} m-card-padding-{Padding.ToString().ToLowerInvariant()}"
        + (Interactive ? " m-card-interactive" : "")
        + (Fill ? " m-card-fill" : "")
        + (string.IsNullOrWhiteSpace(Class) ? "" : $" {Class}");

    private async Task HandleClickAsync(MouseEventArgs e)
    {
        if (OnClick.HasDelegate) await OnClick.InvokeAsync(e);
    }

    // Mirrors the div-as-button keyboard pattern already used elsewhere in
    // this codebase (e.g. TaskMilestoneAccordion.razor, TeamTasksCard.razor)
    // rather than inventing a new one.
    private async Task HandleKeyDownAsync(KeyboardEventArgs e)
    {
        if (e.Key is "Enter" or " " && OnClick.HasDelegate)
        {
            await OnClick.InvokeAsync(new MouseEventArgs());
        }
    }
}