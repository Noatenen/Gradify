@namespace AuthWithAdmin.Client.Components

@*
    MRowList — container for MRow.

    Master: "Motiva has no literal <table>; every list is .row — build once,
    no separate table component needed." This is the list half of that
    pattern: it owns the divider rhythm (hairline between rows, none after
    the last one) and nothing else. It is generic on purpose — no tasks,
    requests or dashboard data shapes reach it.
*@

<div class="@RootClass" role="@Role" aria-label="@AriaLabel">
    @ChildContent
</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Hairline divider between rows. On by default (the Master's
    /// list pattern); turn it off for a list that already sits inside its own
    /// separated blocks.</summary>
    [Parameter] public bool Divided { get; set; } = true;

    /// <summary>
    /// Pads the rows for a list that fills a bordered card.
    ///
    /// <para><b>Why this exists.</b> MRow's own rhythm is the Master's
    /// <c>--pad-row: 14px 2px</c>, and that near-zero inline padding is correct
    /// for its original context — a list sitting directly on the page surface,
    /// where the row should read as a line of content and its text should align
    /// with the prose around it. Drop the same list into an
    /// <c>MCard Padding="None"</c> and that 2px becomes the ONLY inset, so the
    /// text sits against the card's hairline.</para>
    ///
    /// <para>The student Knowledge Center already hit this and solved it
    /// privately (<c>::deep .kc-row { padding-inline: 12px }</c> in
    /// LearningMaterialsPage.razor.css). Every mentor list needs the same thing.
    /// Rather than a third and fourth copy of that override, the relationship
    /// is named once here.</para>
    ///
    /// <para><b>Opt-in, so nothing already shipped moves.</b> Default false —
    /// every existing caller renders exactly as before.</para>
    /// </summary>
    [Parameter] public bool Inset { get; set; }

    /// <summary>Optional accessible name. Only when named is the list exposed
    /// as a group — an unnamed group announces a boundary with nothing to
    /// identify it, which is noise rather than help.</summary>
    [Parameter] public string? AriaLabel { get; set; }

    [Parameter] public string? Class { get; set; }

    private string? Role => string.IsNullOrWhiteSpace(AriaLabel) ? null : "group";

    private string RootClass =>
        "m-row-list"
        + (Divided ? " m-row-list-divided" : "")
        + (Inset   ? " m-row-list-inset"   : "")
        + (string.IsNullOrWhiteSpace(Class) ? "" : $" {Class}");
}
