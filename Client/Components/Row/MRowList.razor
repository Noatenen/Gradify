@namespace AuthWithAdmin.Client.Components

@*
    MRowList — container for MRow.

    Master: "Motiva has no literal <table>; every list is .row — build once,
    no separate table component needed." This is the list half of that
    pattern: it owns the divider rhythm (hairline between rows, none after
    the last one) and nothing else. It is generic on purpose — no tasks,
    requests or dashboard data shapes reach it.
*@

<div class="@RootClass" role="@Role" aria-label="@AriaLabel">
    @ChildContent
</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Hairline divider between rows. On by default (the Master's
    /// list pattern); turn it off for a list that already sits inside its own
    /// separated blocks.</summary>
    [Parameter] public bool Divided { get; set; } = true;

    /// <summary>Optional accessible name. Only when named is the list exposed
    /// as a group — an unnamed group announces a boundary with nothing to
    /// identify it, which is noise rather than help.</summary>
    [Parameter] public string? AriaLabel { get; set; }

    [Parameter] public string? Class { get; set; }

    private string? Role => string.IsNullOrWhiteSpace(AriaLabel) ? null : "group";

    private string RootClass =>
        "m-row-list"
        + (Divided ? " m-row-list-divided" : "")
        + (string.IsNullOrWhiteSpace(Class) ? "" : $" {Class}");
}
