@namespace AuthWithAdmin.Client.Components

@*
    MRow — one dense information row. The Master calls this the product's
    "table": a start-aligned primary block, an end-aligned meta/status/action
    block, space-between, hairline divider (owned by MRowList), no zebra.

    Every slot is generic. Nothing here knows what a task, a request or a
    submission is — pages compose Leading/Status/Meta/Trailing from their own
    data and from other primitives (MStatusDot, MStatusBadge, MButton).

    Interaction uses a real <a>/<button>, never a click-only div, so keyboard
    activation, focus order and the browser's own affordances come for free.
*@

@{
    RenderFragment body =
        @<text>
            @if (Leading is not null)
            {
                <span class="m-row-leading">@Leading</span>
            }

            <span class="m-row-main">
                @if (ChildContent is not null)
                {
                    @ChildContent
                }
                else
                {
                    @if (PrimaryContent is not null)
                    {
                        <span class="m-row-primary">@PrimaryContent</span>
                    }
                    else if (!string.IsNullOrWhiteSpace(Primary))
                    {
                        <span class="m-row-primary">@Primary</span>
                    }

                    @if (SecondaryContent is not null)
                    {
                        <span class="m-row-secondary">@SecondaryContent</span>
                    }
                    else if (!string.IsNullOrWhiteSpace(Secondary))
                    {
                        <span class="m-row-secondary">@Secondary</span>
                    }
                }
            </span>

            @if (Status is not null || !string.IsNullOrWhiteSpace(Meta) || Trailing is not null)
            {
                <span class="m-row-end">
                    @if (Status is not null)
                    {
                        @Status
                    }
                    @if (!string.IsNullOrWhiteSpace(Meta))
                    {
                        <span class="@MetaClass">@Meta</span>
                    }
                    @if (Trailing is not null)
                    {
                        @Trailing
                    }
                </span>
            }
        </text>;
}

@if (!string.IsNullOrWhiteSpace(Href))
{
    <a class="@RootClass"
       href="@Href"
       download="@Download"
       target="@Target"
       rel="@ResolvedRel"
       aria-label="@AriaLabel"
       aria-current="@AriaCurrent">@body</a>
}
else if (OnClick.HasDelegate)
{
    <button type="button"
            class="@RootClass"
            aria-label="@AriaLabel"
            aria-current="@AriaCurrent"
            @onclick="OnClick">
        @body
    </button>
}
else
{
    <div class="@RootClass" aria-current="@AriaCurrent">@body</div>
}

@code {
    /// <summary>Tone for the end-aligned meta text. The Master draws an overdue
    /// date in rose and an ordinary one in muted ink — same slot, different
    /// meaning. Limited to the three permitted semantics.</summary>
    public enum RowMetaTone { Default, Violet, Teal, Rose }

    /// <summary>Start-of-row slot: a status dot, checkbox, avatar or icon.</summary>
    [Parameter] public RenderFragment? Leading { get; set; }

    /// <summary>The row's main text. Ignored when <see cref="ChildContent"/>
    /// is supplied.</summary>
    [Parameter] public string? Primary { get; set; }

    /// <summary>Markup form of <see cref="Primary"/>.</summary>
    [Parameter] public RenderFragment? PrimaryContent { get; set; }

    /// <summary>Quieter second line under the primary text.</summary>
    [Parameter] public string? Secondary { get; set; }

    /// <summary>Markup form of <see cref="Secondary"/>.</summary>
    [Parameter] public RenderFragment? SecondaryContent { get; set; }

    /// <summary>Full override of the main block, for rows whose content is
    /// richer than primary + secondary text. Takes precedence over all four
    /// Primary/Secondary parameters.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>End-of-row status slot — typically an MStatusDot or
    /// MStatusBadge. Kept as a slot rather than a status enum so this
    /// primitive never owns a status→colour mapping of its own.</summary>
    [Parameter] public RenderFragment? Status { get; set; }

    /// <summary>End-of-row meta text: a date, a count.</summary>
    [Parameter] public string? Meta { get; set; }

    [Parameter] public RowMetaTone MetaTone { get; set; } = RowMetaTone.Default;

    /// <summary>End-of-row action slot — a button, a chevron.</summary>
    [Parameter] public RenderFragment? Trailing { get; set; }

    /// <summary>Renders the row as a link. Takes precedence over
    /// <see cref="OnClick"/>.</summary>
    [Parameter] public string? Href { get; set; }

    /// <summary>Filename for the anchor's <c>download</c> attribute, when the
    /// row *is* the download. Added in Phase 4C: the finalized Knowledge Center
    /// makes the whole row the activation target rather than parking a button
    /// in <see cref="Trailing"/>, and there was no way to express a real
    /// download that way.
    ///
    /// <para>Ignored unless <see cref="Href"/> is set. Purely additive — a
    /// caller that supplies nothing renders exactly the markup it did before,
    /// since Blazor omits an attribute whose value is null.</para></summary>
    [Parameter] public string? Download { get; set; }

    /// <summary>Anchor <c>target</c>, e.g. "_blank" for a row that leaves the
    /// app. Ignored unless <see cref="Href"/> is set.</summary>
    [Parameter] public string? Target { get; set; }

    /// <summary>Anchor <c>rel</c>. Left null in the common case: when
    /// <see cref="Target"/> is "_blank" this component supplies
    /// "noopener noreferrer" itself, so a caller cannot forget it and open a
    /// reverse-tabnabbing hole. Set explicitly only to override that.</summary>
    [Parameter] public string? Rel { get; set; }

    /// <summary>Renders the row as a button.</summary>
    [Parameter] public EventCallback<MouseEventArgs> OnClick { get; set; }

    /// <summary>Marks the row as the currently open/selected one. Exposed as
    /// aria-current="true" rather than aria-selected, which would require a
    /// listbox/grid parent this primitive deliberately does not impose.</summary>
    [Parameter] public bool Selected { get; set; }

    [Parameter] public string? AriaLabel { get; set; }

    [Parameter] public string? Class { get; set; }

    private string? AriaCurrent => Selected ? "true" : null;

    private string? ResolvedRel =>
        !string.IsNullOrWhiteSpace(Rel) ? Rel
        : Target == "_blank" ? "noopener noreferrer"
        : null;

    private string MetaClass =>
        MetaTone == RowMetaTone.Default
            ? "m-row-meta"
            : $"m-row-meta m-row-meta-{MetaTone.ToString().ToLowerInvariant()}";

    private string RootClass =>
        "m-row"
        + (Selected ? " m-row-selected" : "")
        + (string.IsNullOrWhiteSpace(Class) ? "" : $" {Class}");
}
