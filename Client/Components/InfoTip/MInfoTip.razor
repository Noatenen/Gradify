@namespace AuthWithAdmin.Client.Components

@*
    MInfoTip — the small "what is this screen for?" affordance.

    WHY IT EXISTS
    ─────────────
    Every finished Management page carried a descriptive sentence beside its
    h1 explaining what the screen does. Read once, then permanent noise —
    and on a settings page it competed with the settings themselves. The
    sentence is still worth having; it is just worth having ON DEMAND.

    Nothing in the project could already do this: a search for a tooltip
    primitive turned up only `title=""` attributes and two wizard-local CSS
    classes named "tooltip". So this is the smallest shared one, and the ten
    Management pages all call it rather than each rolling its own.

    HOVER *AND* KEYBOARD
    ────────────────────
    The trigger is a real <button>, so it is tabbable, and the bubble is
    revealed by `:hover` on the wrapper OR `:focus-visible` on the button.
    A CSS-only reveal is deliberate: a JS-driven popover would need
    outside-click handling, an escape key listener and a portal to escape
    `overflow`, none of which a one-sentence hint earns.

    ACCESSIBILITY
    ─────────────
    The button carries an aria-label naming what it opens; the bubble is
    role="tooltip" and referenced by aria-describedby, so a screen reader
    announces the sentence without the user having to hover anything.

    NO LAYOUT SHIFT
    ───────────────
    The wrapper is inline-flex and sized to the 20px button; the bubble is
    absolutely positioned out of flow, so showing it never moves the title
    it sits beside.
*@

<span class="@RootClass">
    <button type="button"
            class="m-infotip-btn"
            aria-label="@TriggerLabel"
            aria-describedby="@_id">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor"
             stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="9" />
            <path d="M12 16v-4" />
            <path d="M12 8h.01" />
        </svg>
    </button>

    <span class="m-infotip-bubble" role="tooltip" id="@_id">@Text</span>
</span>

@code {
    /// <summary>The sentence the page used to print under its title.
    /// Keep it to one line of explanation — this is a hint, not help text.</summary>
    [Parameter, EditorRequired] public string Text { get; set; } = "";

    /// <summary>Accessible name for the trigger itself. The default names the
    /// action rather than repeating the sentence, which the bubble already
    /// supplies through aria-describedby.</summary>
    [Parameter] public string TriggerLabel { get; set; } = "מידע על הדף";

    [Parameter] public string? Class { get; set; }

    private readonly string _id = $"m-infotip-{Guid.NewGuid():N}";

    private string RootClass =>
        "m-infotip" + (string.IsNullOrWhiteSpace(Class) ? "" : $" {Class}");
}
