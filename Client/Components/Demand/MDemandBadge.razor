@namespace AuthWithAdmin.Client.Components

@*
    MDemandBadge — how many teams asked for a project.

    WHY IT EXISTS
    ─────────────
    When a lecturer assigns a team to a project, the fact that decides the move
    is rarely the match score on its own — it is how contested the project is.
    A 49-point match on a project nobody else wants is a free decision; the same
    49 on a project three other teams put first is a decision that costs someone
    else theirs. Before this, that fact was on the screen exactly once, as a
    weighted integer in a column called "ביקוש", which is unreadable as a
    signal and appears nowhere near the recommendation it should qualify.

    IT IS INFORMATION, NOT AN ALARM
    ───────────────────────────────
    High demand is NOT a warning: it is a normal, expected property of a good
    project, and a screen that paints it rose teaches the lecturer to flinch at
    the projects students actually want. So every level here is neutral ink with
    a violet meter — the same restraint the rest of the Motiva system applies to
    counts. Rose belongs to the one thing that IS a conflict: the project is
    already taken and assigning this team would displace another. That line
    lives on the recommendation row, not here.

    THE NUMBERS ARE REAL
    ────────────────────
    `Teams` and `FirstChoice` are counted from the submitted preference forms —
    the same rows the server sums into its weighted DemandScore (30/20/10 by
    priority). The weighted score answers "how wanted", which is why it is still
    what the board sorts on; these two answer "by whom, and how badly", which is
    what a person needs in order to choose. Neither is derivable from the other,
    which is why this component takes the counts rather than the score.

    THE METER IS SOLID VIOLET
    ─────────────────────────
    Not the signature gradient. A 3px segment renders the violet→teal sweep as
    its blue midpoint and stops reading as the brand at all — see the shared
    note on small marks in the system.
*@

<span class="@RootClass" title="@Tooltip" aria-label="@(Size == DemandSize.Meter ? Tooltip : null)">
    <span class="m-demand-meter" aria-hidden="true">
        <span class="m-demand-seg @(Level >= 1 ? "m-demand-seg--on" : "")"></span>
        <span class="m-demand-seg @(Level >= 2 ? "m-demand-seg--on" : "")"></span>
        <span class="m-demand-seg @(Level >= 3 ? "m-demand-seg--on" : "")"></span>
    </span>

    @if (Size != DemandSize.Meter)
    {
        <span class="m-demand-text">@Text</span>

        @* The first-choice count is a second, quieter fact: how badly, after
           how many. It reads as a qualifier of the number before it, so it is
           set apart rather than run into the same sentence. *@
        @if (Size == DemandSize.Full && FirstChoice > 0)
        {
            <span class="m-demand-first">· @FirstChoice בעדיפות ראשונה</span>
        }
    }
</span>

@code {
    /// <summary><c>Full</c> — the whole sentence, for a preference the lecturer
    /// is reading one at a time. <c>Compact</c> — count only, for a list of
    /// recommendations where the badge qualifies a row rather than being read.
    /// <c>Meter</c> — three bars and nothing else, for a chip that has no room
    /// for words and only needs to say "this one is contested".</summary>
    public enum DemandSize { Full, Compact, Meter }

    /// <summary>How many distinct teams listed this project anywhere in their
    /// preferences.</summary>
    [Parameter] public int Teams { get; set; }

    /// <summary>How many of them put it first. A project four teams listed but
    /// nobody ranked first is a very different object from one two teams both
    /// put at the top, and the level alone cannot tell them apart.</summary>
    [Parameter] public int FirstChoice { get; set; }

    [Parameter] public DemandSize Size { get; set; } = DemandSize.Compact;

    [Parameter] public string? Class { get; set; }

    /// <summary>0 nobody · 1 one team · 2 two or three · 3 four or more.
    /// Deliberately coarse: the exact count is in the text, and the meter's job
    /// is to be comparable down a column at a glance.</summary>
    private int Level => Teams switch
    {
        <= 0 => 0,
        1    => 1,
        2 or 3 => 2,
        _    => 3
    };

    private string RootClass =>
        $"m-demand m-demand--l{Level} {SizeClass} {Class}".TrimEnd();

    private string SizeClass => Size switch
    {
        DemandSize.Full   => "m-demand--full",
        DemandSize.Meter  => "m-demand--meter",
        _                 => "m-demand--compact"
    };

    /// <summary>"4 ביקשו", not "4 צוותים ביקשו". The badge only ever sits
    /// against a project, in a screen about teams, so the unit is carried by
    /// the context — and repeating it on every row of a preference list turns
    /// a number into a sentence. The full noun stays in the tooltip, which is
    /// where a reader goes when the short form is not enough.</summary>
    private string Text => Size switch
    {
        DemandSize.Full when Teams <= 0 => "אין ביקוש",
        _ when Teams <= 0               => "ללא ביקוש",
        _                               => $"{Teams} ביקשו"
    };

    private string TeamWord => Teams == 1 ? "צוות" : "צוותים";

    private string Tooltip => Teams <= 0
        ? "אף צוות לא דירג את הפרויקט הזה"
        : FirstChoice > 0
            ? $"{Teams} {TeamWord} דירגו את הפרויקט, מתוכם {FirstChoice} בעדיפות ראשונה"
            : $"{Teams} {TeamWord} דירגו את הפרויקט, אף אחד לא בעדיפות ראשונה";
}
