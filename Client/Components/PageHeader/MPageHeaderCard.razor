@namespace AuthWithAdmin.Client.Components

@*
    MPageHeaderCard — the compact white-surface page header.

    WHY THIS EXISTS ALONGSIDE MPageHeader
    ─────────────────────────────────────
    MPageHeader is the Master's *ambient band*: a transparent gradient wash
    that edge-bleeds to the shell, used by greeting/dashboard/tasks screens.
    It is deliberately NOT a card.

    Several ordinary content pages instead want the approved Motiva *card*
    language — the same white `.motiva-panel` surface every other section on
    the page already wears — so the page title reads as a surface, not as
    loose text floating on the canvas. That card was being hand-rolled per
    page (sfp-header-card, sub-header-card, ser-header, ntf-header, …), some
    on `.motiva-panel` and some still on the legacy `--g-*` tokens, so the
    same idea rendered four slightly different ways.

    This is that card, named once. It wears `.motiva-panel` (the standard
    surface, from motiva-base.css) and lays out a single row:

        [ leading ]  title            [ actions ]
                     optional subtitle

    ANATOMY, DELIBERATELY MINIMAL
    ─────────────────────────────
    • Leading — an optional slot for whatever sits before the title. A page
      with a section icon passes its icon chip here; a page that navigates up
      passes <MAdminBack/> here (the ONE back affordance — this component does
      not draw its own arrow). The slot is style-agnostic on purpose so it can
      hold either without the component taking a position on which.
    • Title — the page's h1, at the app's standard page-title step.
    • Subtitle / SubtitleContent — one quiet supporting line.
    • Actions — an end-aligned slot for a single primary control.

    RTL is set on the header itself so the component is correct regardless of
    whether the host page already declared it.
*@

<header class="@RootClass" dir="rtl">
    <div class="m-page-header-card-main">
        @if (Leading is not null)
        {
            <div class="m-page-header-card-leading">@Leading</div>
        }

        <div class="m-page-header-card-text">
            @if (!string.IsNullOrWhiteSpace(Title))
            {
                <h1 class="m-page-header-card-title">@Title</h1>
            }

            @if (SubtitleContent is not null)
            {
                <div class="m-page-header-card-subtitle">@SubtitleContent</div>
            }
            else if (!string.IsNullOrWhiteSpace(Subtitle))
            {
                <p class="m-page-header-card-subtitle">@Subtitle</p>
            }
        </div>
    </div>

    @if (Actions is not null)
    {
        <div class="m-page-header-card-actions">@Actions</div>
    }
</header>

@code {
    /// <summary>The page's h1, rendered at the app's standard page-title
    /// step (the same --motiva-font-size-h1 the hand-rolled headers used, so
    /// migrated pages render an identical title).</summary>
    [Parameter] public string? Title { get; set; }

    /// <summary>One quiet supporting line under the title. Ignored when
    /// <see cref="SubtitleContent"/> is supplied.</summary>
    [Parameter] public string? Subtitle { get; set; }

    /// <summary>Markup form of <see cref="Subtitle"/>, for the rare case a
    /// supporting line needs more than plain text.</summary>
    [Parameter] public RenderFragment? SubtitleContent { get; set; }

    /// <summary>Optional slot before the title — a section icon chip, or
    /// <c>&lt;MAdminBack/&gt;</c> for a page that navigates up. Style-agnostic:
    /// the caller supplies the full leading element.</summary>
    [Parameter] public RenderFragment? Leading { get; set; }

    /// <summary>Optional end-aligned slot on the title row — typically one
    /// primary MButton. Collapses to nothing when unused.</summary>
    [Parameter] public RenderFragment? Actions { get; set; }

    [Parameter] public string? Class { get; set; }

    private string RootClass =>
        "m-page-header-card motiva-panel"
        + (string.IsNullOrWhiteSpace(Class) ? "" : $" {Class}");
}
