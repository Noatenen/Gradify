@namespace AuthWithAdmin.Client.Components

@*
    MPageHeader — the Master's ambient page header, in its two approved
    variants. The Master: "Two variants — hero-with-KPI and compact — same
    gradient formula, share one component with a 'compact' prop."

    Hero    → Dashboard, Requests: greeting / state summary, then a snapshot
              slot (stepper, KPI row).
    Compact → Tasks, Knowledge Center: page title + one line of context,
              same ambient wash, no greeting.

    The header carries its own inline padding (--motiva-content-padding-inline)
    rather than sitting inside a padded page container, because the Master's
    ambient band bleeds to the shell edge while its text still lines up with
    the content below it. No page-specific business logic lives here.
*@

<header class="@RootClass">
    <div class="m-page-header-body">
        @if (!string.IsNullOrWhiteSpace(Title))
        {
            <h1 class="m-page-header-title">@Title</h1>
        }

        @if (SubtitleContent is not null)
        {
            <div class="m-page-header-subtitle">@SubtitleContent</div>
        }
        else if (!string.IsNullOrWhiteSpace(Subtitle))
        {
            <p class="m-page-header-subtitle">@Subtitle</p>
        }
    </div>

    @if (ChildContent is not null)
    {
        <div class="m-page-header-content">@ChildContent</div>
    }
</header>

@code {
    public enum HeaderVariant
    {
        /// <summary>Dashboard / Requests — stronger ambient wash, quiet greeting
        /// line, larger supporting row. The page's loud element is what sits in
        /// <see cref="ChildContent"/>, not the title.</summary>
        Hero,

        /// <summary>Tasks / Knowledge Center — the page title itself is the loud
        /// element (25px/700), one line of context under it.</summary>
        Compact
    }

    [Parameter] public HeaderVariant Variant { get; set; } = HeaderVariant.Compact;

    /// <summary>Rendered as the page's h1 in both variants. In Hero this is the
    /// greeting/state line, which the Master styles quieter than a page title —
    /// that is a visual decision only; it is still the document's top heading,
    /// so screen-reader users get a real h1 on every page either way.</summary>
    [Parameter] public string? Title { get; set; }

    /// <summary>One line of supporting text. Ignored when
    /// <see cref="SubtitleContent"/> is supplied.</summary>
    [Parameter] public string? Subtitle { get; set; }

    /// <summary>Markup form of <see cref="Subtitle"/> — used by the Master's
    /// Dashboard hero, whose supporting line is a two-ended row (milestone on
    /// one side, overall progress on the other) rather than plain text.</summary>
    [Parameter] public RenderFragment? SubtitleContent { get; set; }

    /// <summary>Optional slot under the text block: the KPI row (MKpiGrid), a
    /// milestone stepper, or any other page-supplied snapshot content. The
    /// header has no opinion on what goes here.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    [Parameter] public string? Class { get; set; }

    private string RootClass =>
        $"m-page-header m-page-header-{Variant.ToString().ToLowerInvariant()}"
        + (string.IsNullOrWhiteSpace(Class) ? "" : $" {Class}");
}
