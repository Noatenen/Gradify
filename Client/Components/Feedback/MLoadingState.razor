@namespace AuthWithAdmin.Client.Components
@*
    MLoadingState — the student experience's one "we are fetching this" surface.

    Every finalized student page had grown its own copy of the same three
    things: a bordered circle with a rotating top edge, a muted label beside
    or under it, and a private @keyframes to spin it (tsk-spin, kc-spin,
    pw-spin, …). The markup was identical; only the prefix differed.

    It is NOT an MEmptyState variant. An empty state is a resolved answer
    ("there is nothing here"); loading is the absence of an answer, and the
    Master's empty state is text-only by design. Keeping them apart is what
    stops a spinner inheriting the empty state's 64px vertical rhythm.

    Two variants, both already in the finalized pages:
      Block  — /tasks: column, the branded Motiva mark, the page's whole
               content area.
      Inline — /learning: row, 18px ring, sits inside a section.
*@
<div class="@RootClass" role="status" aria-live="polite">
    @if (Variant == LoadingVariant.Block)
    {
        @* Block is the page/panel-sized wait, which is exactly where the
           brand should be doing the waiting — so it draws the Motiva mark
           (MotivaLoaderMark) instead of the ring. Inline keeps the ring on
           purpose: an 18px mark sitting on a line of text is illegible, and
           the icon drawing itself next to a single row would be louder than
           the thing it is annotating. Nothing about the API, the role, the
           label or the callers changes. *@
        <MotivaLoaderMark Class="motiva-loader-mark-md" />
    }
    else
    {
        <span class="m-loading-spinner" aria-hidden="true"></span>
    }
    @if (!string.IsNullOrWhiteSpace(Label))
    {
        <span class="m-loading-label">@Label</span>
    }
</div>

@code {
    public enum LoadingVariant
    {
        /// <summary>Column, large ring — a whole page or panel is loading.</summary>
        Block,

        /// <summary>Row, small ring — a section inside an already-rendered page.</summary>
        Inline
    }

    [Parameter] public LoadingVariant Variant { get; set; } = LoadingVariant.Block;

    /// <summary>Visible text beside the spinner. Also the accessible name —
    /// the wrapper is role="status", so this is announced. Omitting it leaves
    /// a spinner with no announcement, which is only right when a nearby
    /// heading already says what is loading.</summary>
    [Parameter] public string? Label { get; set; }

    [Parameter] public string? Class { get; set; }

    private string RootClass =>
        $"m-loading m-loading-{Variant.ToString().ToLowerInvariant()}"
        + (string.IsNullOrWhiteSpace(Class) ? "" : $" {Class}");
}
