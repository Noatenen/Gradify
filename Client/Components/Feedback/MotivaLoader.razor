@namespace AuthWithAdmin.Client.Components
@*
    MotivaLoader — the branded "the system is loading" surface.

    The Motiva icon drawing itself, with "המערכת נטענת..." under it.
    Deliberately unadorned: no card, no border, no panel, no tinted
    ground. It is meant to be dropped into whatever container is already
    there — a page body, a dashboard slot, a modal, a section — and to
    inherit that container's own centring and rhythm.

    Relationship to MLoadingState: MLoadingState stays the component
    every fetching page calls, because those pages each say what THEY
    are loading ("טוענת משימות…"). MotivaLoader is for the case where
    the whole system is what is loading, so the one system-level string
    is the right one — the pre-boot splash, a full-page gate, a shell
    that has nothing more specific to say. MLoadingState's Block variant
    renders the same MotivaLoaderMark, so the two never disagree
    visually.

    Styles live in wwwroot/css/motiva-loader.css, shared with
    index.html; see the header there for why they are not scoped.
*@
<div class="@RootClass" role="status" aria-live="polite" aria-busy="true"
     aria-label="@(string.IsNullOrWhiteSpace(Label) ? AriaLabel : null)">
    <MotivaLoaderMark />
    @if (!string.IsNullOrWhiteSpace(Label))
    {
        <p class="motiva-loader-label">@Label</p>
    }
</div>

@code {
    public enum LoaderSize
    {
        /// <summary>32px mark — inside a section or a modal body.</summary>
        Sm,

        /// <summary>56px mark — the default; a page or panel is loading.</summary>
        Md,

        /// <summary>88px mark — a full-page or full-viewport gate.</summary>
        Lg
    }

    [Parameter] public LoaderSize Size { get; set; } = LoaderSize.Md;

    /// <summary>The visible line under the mark, which is also the accessible
    /// name — the wrapper is role="status", so it is announced as written and
    /// no second sr-only copy is added. Blank it out only when a heading
    /// beside the loader already says what is loading; the root then falls
    /// back to <see cref="AriaLabel"/> so the status is never silent.</summary>
    [Parameter] public string Label { get; set; } = "המערכת נטענת...";

    /// <summary>Announcement used only when <see cref="Label"/> is blank.</summary>
    [Parameter] public string AriaLabel { get; set; } = "המערכת נטענת";

    [Parameter] public string? Class { get; set; }

    private string RootClass =>
        $"motiva-loader motiva-loader-{Size.ToString().ToLowerInvariant()}"
        + (string.IsNullOrWhiteSpace(Class) ? "" : $" {Class}");
}
