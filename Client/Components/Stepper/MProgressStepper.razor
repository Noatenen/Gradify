@namespace AuthWithAdmin.Client.Components

@*
    MProgressStepper — the System Master's ProgressStepper.

    Master §6: "ProgressStepper — Dashboard, Mentor project workspace —
    circle + connector; 'current' step carries the breathing animation,
    others are static." Until Phase 4D this existed only as hand-rolled
    markup inside StudentDashboardHero; it is a component now because the
    Master names it as one.

    Three states, drawn exactly as Motiva Student Dashboard V4 draws them
    (V4:95-103): Done = teal fill + ✓, Current = white with a violet ring
    and a slow breathing halo, Upcoming = white with a neutral ring. The
    connector between two steps is teal when the step BEFORE it is done and
    neutral otherwise — the fill therefore stops at the current step.

    Labels are optional and render in their own row beneath the rail, one
    per step, aligned to the step above. The label slot is a RenderFragment
    so a caller can make it interactive (V4's expandable milestone label)
    without this component owning any expand/collapse behaviour.

    Generic on purpose: no milestone, task or project type reaches it.
*@

<div class="@RootClass" style="--m-stepper-count: @Steps.Count">
    <div class="m-stepper-rail" role="list" aria-label="@AriaLabel">
        @for (var i = 0; i < Steps.Count; i++)
        {
            var index = i;
            var step  = Steps[index];
            var isLast = index == Steps.Count - 1;

            <div class="m-stepper-step" role="listitem">
                @if (OnSelect.HasDelegate)
                {
                    <button type="button"
                            class="@DotClass(step)"
                            title="@step.Label"
                            aria-label="@StepAriaLabel(step)"
                            aria-current="@(step.State == StepState.Current ? "step" : null)"
                            @onclick="@(() => OnSelect.InvokeAsync(index))">
                        @if (step.State == StepState.Done)
                        {
                            <span class="m-stepper-check" aria-hidden="true">✓</span>
                        }
                    </button>
                }
                else
                {
                    <span class="@DotClass(step)"
                          role="img"
                          aria-label="@StepAriaLabel(step)"
                          aria-current="@(step.State == StepState.Current ? "step" : null)">
                        @if (step.State == StepState.Done)
                        {
                            <span class="m-stepper-check" aria-hidden="true">✓</span>
                        }
                    </span>
                }

                @if (!isLast)
                {
                    <span class="m-stepper-line @(step.State == StepState.Done ? "m-stepper-line-filled" : "m-stepper-line-muted")"
                          aria-hidden="true"></span>
                }
            </div>
        }
    </div>

    @if (LabelTemplate is not null)
    {
        @* Same column track as the rail, so every label sits under its step. *@
        <div class="m-stepper-labels">
            @for (var i = 0; i < Steps.Count; i++)
            {
                <div class="m-stepper-label-cell">@LabelTemplate((i, Steps[i]))</div>
            }
        </div>
    }
</div>

@code {
    /// <summary>The Master's three step states. Deliberately closed — a fourth
    /// would need a fourth semantic colour, which the visual rules forbid.</summary>
    public enum StepState { Done, Current, Upcoming }

    /// <summary>One step. <see cref="Label"/> is the accessible/tooltip name;
    /// visible label markup comes from <see cref="LabelTemplate"/>.</summary>
    public sealed record Step(string Label, StepState State);

    [Parameter, EditorRequired] public IReadOnlyList<Step> Steps { get; set; } = Array.Empty<Step>();

    /// <summary>Optional label row. Receives (index, step) so a caller can key
    /// its own expand/collapse state off the index.</summary>
    [Parameter] public RenderFragment<(int Index, Step Step)>? LabelTemplate { get; set; }

    /// <summary>When set, each dot becomes a button reporting its index. When
    /// unset the dots render as non-interactive images — no click-only divs
    /// and no unreachable buttons either way.</summary>
    [Parameter] public EventCallback<int> OnSelect { get; set; }

    /// <summary>Accessible name for the rail as a whole.</summary>
    [Parameter] public string? AriaLabel { get; set; }

    [Parameter] public string? Class { get; set; }

    private static string DotClass(Step step) =>
        $"m-stepper-dot m-stepper-dot-{step.State.ToString().ToLowerInvariant()}";

    private static string StepAriaLabel(Step step) => step.State switch
    {
        StepState.Done     => $"{step.Label} — הושלם",
        StepState.Current  => $"{step.Label} — שלב נוכחי",
        _                  => $"{step.Label} — טרם התחיל",
    };

    private string RootClass =>
        "m-stepper" + (string.IsNullOrWhiteSpace(Class) ? "" : $" {Class}");
}
