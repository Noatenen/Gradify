@namespace AuthWithAdmin.Client.Components

@*
    MSectionHeading — the Master's section label, optionally with a trailing
    "see all" link on the same baseline.

    WHY THIS IS A COMPONENT AND NOT PAGE CSS
    The label itself (13px / 700 / 0.06em tracking / secondary ink) already
    existed, but as a private rule re-declared inside each page's own
    stylesheet. The mentor screens need it in eleven places across three
    pages, every one of them paired with a "לכל ה… ←" link at the opposite
    end of the row — so this is the point at which copying it a twelfth time
    stops being cheaper than naming it.

    DELIBERATELY NOT RETROFITTED ONTO THE STUDENT PAGES. Their private rules
    are left exactly as they are: this phase must not move a single student
    pixel, and swapping their markup for this component is a refactor with
    no user-visible benefit. Adopting it there is a later, separate change —
    which is also why every value below is read from a token rather than
    copied as a literal, so the two cannot drift while both exist.
*@

<div class="@RootClass">
    <p class="m-section-heading-label" id="@LabelId">
        @if (Icon is not null)
        {
            <span class="m-section-heading-icon" aria-hidden="true">@Icon</span>
        }
        @Text
        @if (!string.IsNullOrWhiteSpace(Count))
        {
            <span class="m-section-heading-count motiva-count">@Count</span>
        }
    </p>

    @if (Trailing is not null)
    {
        <div class="m-section-heading-trailing">@Trailing</div>
    }
    else if (!string.IsNullOrWhiteSpace(LinkHref))
    {
        <a class="m-section-heading-link" href="@LinkHref">@LinkText</a>
    }
</div>

@code {
    /// <summary>
    /// Optional glyph before the label — a small semantic marker for the kind
    /// of thing the section holds.
    ///
    /// <para>Decorative by contract: it is wrapped in <c>aria-hidden</c>,
    /// because the heading's own text already names the section and a screen
    /// reader announcing "inbox, requests requiring a decision" would be
    /// reading the same fact twice.</para>
    ///
    /// <para>Additive — null by default, so every existing caller renders the
    /// exact markup it did before this parameter existed.</para></summary>
    [Parameter] public RenderFragment? Icon { get; set; }

    /// <summary>The section's name — "הגשות לבדיקה", "הפרויקטים שלי".</summary>
    [Parameter, EditorRequired] public string Text { get; set; } = "";

    /// <summary>Optional quiet count rendered after the label ("· 3"). The
    /// design prints it in the muted ink at regular weight, so it reads as an
    /// annotation on the heading rather than as part of the heading.
    ///
    /// <para>The separator is CSS, not markup. It used to be a literal "· " in
    /// front of the value, which is correct for the base look and wrong inside
    /// <c>.motiva-final</c>, where the finished design renders this as a round
    /// count pill — the middot then sat INSIDE the pill. Moving it to a
    /// <c>::before</c> lets the final scope drop it while the base scope keeps
    /// the exact same output.</para></summary>
    [Parameter] public string? Count { get; set; }

    /// <summary>Optional end-aligned link ("לכל המשימות ←").</summary>
    [Parameter] public string? LinkHref { get; set; }
    [Parameter] public string? LinkText { get; set; }

    /// <summary>Arbitrary end-aligned content, when the slot needs a button
    /// rather than a link (the personal-tasks "+" affordance). Wins over
    /// <see cref="LinkHref"/> when both are supplied.</summary>
    [Parameter] public RenderFragment? Trailing { get; set; }

    /// <summary>Optional id for the label, so a section below it can point at
    /// this heading with aria-labelledby instead of repeating the name.</summary>
    [Parameter] public string? LabelId { get; set; }

    [Parameter] public string? Class { get; set; }

    private string RootClass =>
        "m-section-heading" + (string.IsNullOrWhiteSpace(Class) ? "" : $" {Class}");
}
