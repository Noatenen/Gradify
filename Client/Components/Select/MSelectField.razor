@namespace AuthWithAdmin.Client.Components

@*
    MSelectField — a self-managed wrapper around MSelect for ordinary form bindings.

    WHY IT EXISTS
    MSelect requires the CALLER to own the Open / OpenChanged state so a screen
    with many selects can enforce "one open at a time" and outside-click-to-close
    at the page level (the pattern UsersManagement and UserImportWizard use).
    Most form fields do not need that coordination — they appear alone in a modal
    row or in a filter bar and should just work like a native <select> without any
    open-state wiring in the parent.

    MSelectField is that drop-in: it wraps MSelect and manages _open itself.
    Outside-click dismissal is handled by a transparent fixed backdrop rendered
    whenever the menu is open (the same approach MModal uses for its scrim).

    INTERFACE
    Options  — use MSelect.Option records (same type, same namespace).
    @bind-Value — works for string fields. For int fields, use:
        Value="@_field.ToString()"
        ValueChanged="@(v => _field = int.TryParse(v, out var n) ? n : 0)"
    Disabled, Placeholder, AriaLabel, Class, Searchable, SearchPlaceholder —
    forwarded directly to MSelect. EVERY parameter MSelect grows has to be
    repeated here or a caller setting it on the wrapper throws at RENDER time,
    not at build time: Blazor resolves component parameters by reflection, so
    the compiler is happy and the page dies. Learned the hard way with
    Searchable.
*@

@if (_open)
{
    <div class="m-selfield-bd"
         @onclick="Close"
         @onclick:stopPropagation="true">
    </div>
}

<MSelect Options="@Options"
         Value="@Value"
         ValueChanged="@HandleValueChanged"
         Open="@_open"
         OpenChanged="@SetOpen"
         Disabled="@Disabled"
         Searchable="@Searchable"
         SearchPlaceholder="@SearchPlaceholder"
         Placeholder="@Placeholder"
         AriaLabel="@AriaLabel"
         Class="@Class"
         OnDismiss="@Close" />

@code {
    [Parameter, EditorRequired] public IReadOnlyList<MSelect.Option> Options { get; set; } = Array.Empty<MSelect.Option>();

    [Parameter] public string?                Value        { get; set; }
    [Parameter] public EventCallback<string>  ValueChanged { get; set; }
    [Parameter] public bool                   Disabled     { get; set; }
    [Parameter] public bool                   Searchable   { get; set; }
    [Parameter] public string                 SearchPlaceholder { get; set; } = "חיפוש…";
    [Parameter] public string                 Placeholder  { get; set; } = "בחירה";
    [Parameter] public string?                AriaLabel    { get; set; }
    [Parameter] public string?                Class        { get; set; }

    private bool _open;

    private void SetOpen(bool open) => _open = open;

    private void Close() => _open = false;

    private async Task HandleValueChanged(string value)
    {
        if (ValueChanged.HasDelegate)
            await ValueChanged.InvokeAsync(value);
    }
}
