@namespace AuthWithAdmin.Client.Components

@*
    MEmptyState — the Master's empty state.

    Master: "One calm sentence + one supporting line — never an illustration."
    That is why this component has no Icon/Illustration parameter: the
    constraint is enforced by the API, not left to each caller's discretion.

    All copy is supplied by the page. Nothing task-, request- or
    dashboard-specific is hardcoded here.
*@

<div class="@RootClass" role="@Role" aria-live="@AriaLive">
    @if (!string.IsNullOrWhiteSpace(Title))
    {
        <p class="m-empty-title">@Title</p>
    }

    @if (DescriptionContent is not null)
    {
        <div class="m-empty-text">@DescriptionContent</div>
    }
    else if (!string.IsNullOrWhiteSpace(Description))
    {
        <p class="m-empty-text">@Description</p>
    }

    @if (Action is not null)
    {
        <div class="m-empty-action">@Action</div>
    }
</div>

@code {
    /// <summary>The calm sentence — what is (not) here.</summary>
    [Parameter] public string? Title { get; set; }

    /// <summary>The supporting line — what will make it appear.</summary>
    [Parameter] public string? Description { get; set; }

    /// <summary>Markup form of <see cref="Description"/>, for a supporting line
    /// that contains a link or emphasis.</summary>
    [Parameter] public RenderFragment? DescriptionContent { get; set; }

    /// <summary>Optional single action — typically one MButton. The Master
    /// never shows more than one.</summary>
    [Parameter] public RenderFragment? Action { get; set; }

    /// <summary>Announce the empty state politely when it appears. Off by
    /// default (a state present on first paint needs no announcement); turn it
    /// on where the emptiness is the *result* of a user action, e.g. a filter
    /// that matched nothing — otherwise a screen-reader user gets silence.</summary>
    [Parameter] public bool Live { get; set; }

    [Parameter] public string? Class { get; set; }

    private string? Role => Live ? "status" : null;
    private string? AriaLive => Live ? "polite" : null;

    private string RootClass =>
        "m-empty" + (string.IsNullOrWhiteSpace(Class) ? "" : $" {Class}");
}
