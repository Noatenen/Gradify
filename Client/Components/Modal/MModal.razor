@namespace AuthWithAdmin.Client.Components
@implements IAsyncDisposable
@inject IJSRuntime JS

@*
    Reusable visual/behavioral modal shell. Follows the same overlay +
    tabindex="-1" + Escape-via-@onkeydown pattern already established by
    Client/Shared/MentorProfileModal.razor — no new JS interop is
    introduced. See design/design-system/components/MModal.md for the
    documented focus-trap limitation.
*@

@if (IsOpen)
{
    <div class="m-modal-overlay"
         @ref="_overlayRef"
         tabindex="-1"
         @onclick="HandleBackdropClickAsync"
         @onkeydown="HandleKeyDownAsync">
        <div class="@DialogClass"
             role="dialog"
             aria-modal="true"
             aria-labelledby="@ResolvedLabelledBy"
             @onclick:stopPropagation="true">

            @if (HeaderContent is not null || !string.IsNullOrWhiteSpace(Title) || ShowCloseButton)
            {
                <div class="m-modal-header">
                    @if (HeaderContent is not null)
                    {
                        @*  A caller-supplied lead. The finished design's inspection
                            popups do not head themselves with a plain title — they
                            head themselves with chips (stage · signal · milestone ·
                            task type) and put the name underneath. The close button
                            still belongs to the shell, so the lead sits beside it
                            rather than replacing the whole row. *@
                        <div class="m-modal-header-lead">@HeaderContent</div>
                    }
                    else if (!string.IsNullOrWhiteSpace(Title))
                    {
                        <h2 class="m-modal-title" id="@_titleId">@Title</h2>
                    }
                    @if (ShowCloseButton)
                    {
                        <button type="button" class="m-modal-close" @onclick="RequestCloseAsync" aria-label="סגירה">
                            <span class="oi oi-x" aria-hidden="true"></span>
                        </button>
                    }
                </div>
            }

            <div class="@BodyClass">
                @ChildContent
            </div>

            @if (FooterContent is not null)
            {
                <div class="m-modal-footer">
                    @FooterContent
                </div>
            }
        </div>
    </div>
}

@code {
    /// <summary>How wide the dialog may grow.
    ///
    /// <para><c>Wide</c> is the desktop WORKSPACE size — a surface you work
    /// IN rather than read down. At Large a review with a description, a date
    /// pair, files, a trail and a decision becomes a 720px column you scroll
    /// through twice; Wide gives it room for a content column and a stable
    /// action column beside it. Additive: no existing caller changes.</para>
    /// </summary>
    public enum ModalSize { Small, Medium, Large, Wide }

    /// <summary>How the shell presents itself.
    ///
    /// <para><c>Standard</c> — the general dialog: divider-free pad, actions
    /// collected at the end of the footer row.</para>
    ///
    /// <para><c>QuickView</c> — the "inspect this entity without leaving the
    /// page" popup the finished design draws (see
    /// <c>design-reference/Motiva Mentor Home.dc.html:163-189</c>): 480px, and
    /// a footer ruled off from the body with the dismiss control at the reading
    /// start and the one navigating CTA at the end. It is a presentation
    /// modifier, not a second component — the body is still whatever the
    /// domain component supplies.</para></summary>
    public enum ModalVariant { Standard, QuickView }

    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public string? Title { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? FooterContent { get; set; }

    /// <summary>Renders in the header row in place of <see cref="Title"/>, beside
    /// the close button. For inspection popups that head themselves with chips
    /// rather than a plain heading; set <see cref="AriaLabelledBy"/> alongside it
    /// so the dialog still names itself.</summary>
    [Parameter] public RenderFragment? HeaderContent { get; set; }

    /// <summary>Drops the body's own padding, for content that is already laid
    /// out as full-bleed sections with their own pad and divider rules. Without
    /// it such content is padded twice and its rules stop reaching the edges.</summary>
    [Parameter] public bool FlushBody { get; set; }

    [Parameter] public ModalVariant Variant { get; set; } = ModalVariant.Standard;
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public bool CloseOnBackdrop { get; set; } = true;
    [Parameter] public bool ShowCloseButton { get; set; } = true;
    [Parameter] public ModalSize Size { get; set; } = ModalSize.Medium;

    /// <summary>Overrides the auto-generated aria-labelledby target. Only
    /// needed when the caller renders its own heading inside ChildContent
    /// instead of using the Title parameter.</summary>
    /// <summary>Let the dialog take the height its content needs, and move the
    /// scrolling out to the overlay when it cannot fit.
    ///
    /// <para><b>The default is the right one for most dialogs.</b> A dialog is
    /// normally capped at the viewport with its BODY scrolling inside, which
    /// keeps the header and the footer's actions pinned and always reachable —
    /// exactly what you want for a form or a confirmation.</para>
    ///
    /// <para>It is the wrong one for a surface you READ ACROSS rather than fill
    /// in. The assignment workspace lays a team, its preferences and the
    /// system's recommendation side by side to be compared; capping it at 88vh
    /// put a second scrollbar inside a dialog that was itself already the thing
    /// being scrolled, and cut the comparison in half on a screen with room to
    /// show all of it.</para>
    ///
    /// <para>With this on there is at most ONE scrollbar: none while the
    /// content fits, and the overlay's own once it does not. The dialog still
    /// centres when it fits (margin-block: auto against a flex-start overlay),
    /// so nothing moves at normal heights.</para></summary>
    [Parameter] public bool FitContent { get; set; }

    [Parameter] public string? AriaLabelledBy { get; set; }
    [Parameter] public string? Class { get; set; }

    private readonly string _titleId = $"m-modal-title-{Guid.NewGuid():N}";
    private ElementReference _overlayRef;
    private bool _wasOpen;
    private bool _scrollLocked;

    private string? ResolvedLabelledBy =>
        !string.IsNullOrWhiteSpace(AriaLabelledBy) ? AriaLabelledBy :
        !string.IsNullOrWhiteSpace(Title) ? _titleId : null;

    private string DialogClass =>
        $"m-modal-dialog m-modal-{Size.ToString().ToLowerInvariant()}"
        + (Variant == ModalVariant.QuickView ? " m-modal-quickview" : "")
        + (FitContent ? " m-modal-fit" : "")
        + (string.IsNullOrWhiteSpace(Class) ? "" : $" {Class}");


    private string BodyClass => FlushBody ? "m-modal-body m-modal-body-flush" : "m-modal-body";

    protected override async Task OnParametersSetAsync()
    {
        if (IsOpen && !_scrollLocked)
            try { await JS.InvokeVoidAsync("gradify.scrollLock.lock"); } catch { }
        else if (!IsOpen && _scrollLocked)
            try { await JS.InvokeVoidAsync("gradify.scrollLock.unlock"); } catch { }

        _scrollLocked = IsOpen;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Auto-focus only on the closed→open transition, never on every
        // re-render, otherwise typing into a field inside the modal body
        // would keep losing focus back to the overlay.
        if (IsOpen && !_wasOpen)
        {
            try { await _overlayRef.FocusAsync(); }
            catch { /* element may not be attached yet on prerender */ }
        }
        _wasOpen = IsOpen;
    }

    public async ValueTask DisposeAsync()
    {
        if (_scrollLocked)
            try { await JS.InvokeVoidAsync("gradify.scrollLock.unlock"); } catch { }
    }

    private async Task HandleBackdropClickAsync()
    {
        if (CloseOnBackdrop) await RequestCloseAsync();
    }

    private async Task HandleKeyDownAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") await RequestCloseAsync();
    }

    private async Task RequestCloseAsync()
    {
        if (OnClose.HasDelegate) await OnClose.InvokeAsync();
    }
}
