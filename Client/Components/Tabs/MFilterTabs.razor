@namespace AuthWithAdmin.Client.Components

@*
    MFilterTabs — the finalized design's segmented pill group.

    Every screen in the Claude Design project filters the same way: a tinted
    track on the title row, a raised white pill for the selection, and an
    optional violet count riding the tab it belongs to. Motiva Mentor Tasks
    draws it as הכל · ממתינות לבדיקתך② · … ; Motiva Student Tasks final draws
    the identical object.

    It is a filter switcher, NOT a tablist: the panels below stay in the
    document and the control narrows them, so each tab is a toggle button with
    aria-pressed rather than role="tab". Making it a real tablist would promise
    arrow-key panel switching that the page does not implement.

    ── RELATIONSHIP TO Pages/Tasks/TaskStatusTabs ───────────────────────────
    That component is the same pills, hand-rolled for the student Tasks screen
    before there was a shared one, with four fixed tabs baked into its markup.
    It is deliberately NOT changed here: this pass must not move a student
    pixel. Folding it into this component is a later, separate refactor — which
    is why every value in the stylesheet beside this file is read from the same
    token TaskStatusTabs reads, so the two cannot drift while both exist.
*@

<nav class="m-filter-tabs" aria-label="@AriaLabel">
    @foreach (var tab in Tabs)
    {
        var key      = tab.Key;
        var selected = string.Equals(ActiveKey ?? "", key, StringComparison.Ordinal);

        <button type="button"
                class="@TabClass(selected)"
                aria-pressed="@(selected ? "true" : "false")"
                @onclick="@(() => OnSelect.InvokeAsync(key))">
            @tab.Label
            @if (tab.Badge > 0)
            {
                <span class="m-filter-tab-badge motiva-count">@tab.Badge</span>
            }
        </button>
    }
</nav>

@code {
    /// <summary>One tab. <paramref name="Key"/> is the filter value the page
    /// stores — the empty string is the conventional "show everything" tab.
    /// A <paramref name="Badge"/> of 0 renders no badge at all, so a count that
    /// has dropped to zero stops shouting instead of showing a "0".</summary>
    public sealed record Tab(string Key, string Label, int Badge = 0);

    [Parameter, EditorRequired] public IReadOnlyList<Tab> Tabs { get; set; } = Array.Empty<Tab>();

    /// <summary>The selected tab's key. Null and "" mean the same thing.</summary>
    [Parameter] public string? ActiveKey { get; set; }

    /// <summary>Raised with the clicked tab's key. Selecting is not toggling:
    /// clicking the active tab re-selects it, and clearing is what the "all"
    /// tab is for.</summary>
    [Parameter] public EventCallback<string> OnSelect { get; set; }

    /// <summary>Accessible name for the group — "סינון משימות".</summary>
    [Parameter] public string? AriaLabel { get; set; }

    private static string TabClass(bool selected) =>
        selected ? "m-filter-tab m-filter-tab-active" : "m-filter-tab";
}