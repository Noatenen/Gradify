@namespace AuthWithAdmin.Client.Components

@*
    MToggle — the System Master's on/off switch.

    Geometry and motion are taken verbatim from the finalized Profile screen
    (design-reference/motiva/project/Motiva Profile.dc.html:428-433, the
    `toggleStyle(on)` helper): a 34x20 track, a 16px knob inset 2px, violet
    when on and the strong edge line when off, sliding 14px in .15s ease-out.

    It is a real <button aria-pressed>, not a styled checkbox, because that is
    what the Master renders and because aria-pressed announces the two states
    correctly without a paired <label>. RTL is handled by flipping the knob's
    travel direction, not by mirroring the whole control.
*@

<button type="button"
        class="@RootClass"
        role="switch"
        aria-checked="@(Checked ? "true" : "false")"
        aria-pressed="@(Checked ? "true" : "false")"
        aria-label="@AriaLabel"
        disabled="@Disabled"
        @onclick="HandleClickAsync">
    <span class="m-toggle-knob"></span>
</button>

@code {
    /// <summary>Current on/off state. This is a controlled component — it never
    /// mutates its own state, so the parent stays the single source of truth
    /// and an optimistic update can be rolled back on a failed save.</summary>
    [Parameter] public bool Checked { get; set; }

    [Parameter] public EventCallback<bool> CheckedChanged { get; set; }

    [Parameter] public bool Disabled { get; set; }

    /// <summary>Accessible name. Required whenever the toggle's own row label
    /// is not programmatically associated with it.</summary>
    [Parameter] public string? AriaLabel { get; set; }

    [Parameter] public string? Class { get; set; }

    private string RootClass =>
        "m-toggle"
        + (Checked ? " m-toggle-on" : "")
        + (string.IsNullOrWhiteSpace(Class) ? "" : $" {Class}");

    private async Task HandleClickAsync()
    {
        if (Disabled) return;
        if (CheckedChanged.HasDelegate) await CheckedChanged.InvokeAsync(!Checked);
    }
}
