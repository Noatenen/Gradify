@namespace AuthWithAdmin.Client.Components

@*
    MKpiGrid — the Master's shared KPI row layout.

    The Master's own consistency audit fixed a real bug here: the KPI grid
    used to cap each card at a fixed 208px, so on wide desktop the row fell
    short of the list/table below it. Columns therefore stretch
    (minmax(0, 1fr)) and the grid carries no max-width — it fills its
    container, so the KPI row shares exactly the horizontal boundaries of
    the section beneath it.

    Layout only. It holds MKpiCard children and knows nothing about them.
*@

<div class="@RootClass" role="@Role" aria-label="@AriaLabel">
    @ChildContent
</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Desktop column count. The Master's finalized screens all show
    /// four ("KPI card count varies by page … the pattern itself is identical"),
    /// so 4 is the default; the parameter exists so a page with three real
    /// metrics gets three full-width columns instead of an empty fourth slot.
    /// Clamped to 1–4 — the medium/small breakpoints below always win anyway.</summary>
    [Parameter] public int Columns { get; set; } = 4;

    /// <summary>Optional accessible name. When set, the row is exposed as a
    /// named group so its cards are announced as one unit rather than as
    /// loose links/buttons.</summary>
    [Parameter] public string? AriaLabel { get; set; }

    [Parameter] public string? Class { get; set; }

    private string RootClass =>
        $"m-kpi-grid m-kpi-grid-cols-{Math.Clamp(Columns, 1, 4)}"
        + (string.IsNullOrWhiteSpace(Class) ? "" : $" {Class}");

    // role="group" only when it has a name — an unnamed group adds a
    // landmark-like announcement with nothing to identify it.
    private string? Role => string.IsNullOrWhiteSpace(AriaLabel) ? null : "group";
}
