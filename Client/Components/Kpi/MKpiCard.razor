@namespace AuthWithAdmin.Client.Components

@*
    MKpiCard — the Master's single KPI card, in all three states it actually
    uses: non-interactive, interactive (link or filter button), and
    selected/pressed.

    The Master's implementation reference is explicit that this is ONE
    component — "KpiCard / KpiGrid … supports link, button, and pressed/filter
    states" — so there is no TasksKpiCard / RequestsKpiCard / DashboardKpiCard.
    A page supplies numbers, a label, an accent and (optionally) a handler;
    nothing about tasks, requests or dashboards lives here.

    Element choice follows the Master's own markup, which uses a real <a> for
    "jump to this section" and a real <button aria-pressed> for "filter by
    this metric" — never a click-only div.
*@

@{
    RenderFragment body =
        @<text>
            @if (Icon is not null)
            {
                <span class="m-kpi-ic" aria-hidden="true">@Icon</span>
            }
            <span class="m-kpi-text">
                @if (!string.IsNullOrWhiteSpace(Value))
                {
                    <strong class="m-kpi-value">@Value</strong>
                }
                @if (!string.IsNullOrWhiteSpace(Label))
                {
                    <span class="m-kpi-label">@Label</span>
                }
                @if (ChildContent is not null)
                {
                    <span class="m-kpi-support">@ChildContent</span>
                }
            </span>
        </text>;
}

@if (!string.IsNullOrWhiteSpace(Href))
{
    <a class="@RootClass" href="@Href" aria-label="@AriaLabel">@body</a>
}
else if (OnClick.HasDelegate)
{
    <button type="button"
            class="@RootClass"
            aria-pressed="@AriaPressed"
            aria-label="@AriaLabel"
            @onclick="OnClick">
        @body
    </button>
}
else
{
    <div class="@RootClass" aria-label="@AriaLabel">@body</div>
}

@code {
    /// <summary>
    /// A KPI card's accent is a <b>presentation</b> colour — the card outline and
    /// the icon chip — not a status semantic. The System Master scopes its
    /// "three semantic colors only — violet / teal / rose — never introduce a
    /// fourth" rule to StatusChip/StatusDot, and those stay closed to three
    /// (see <see cref="MStatusDot.DotTone"/>, which is unchanged).
    ///
    /// <para>The finalized Tasks screen draws four KPIs in four distinct hues,
    /// so <c>Periwinkle</c> and <c>Cobalt</c> were added in Phase 4B. Members are
    /// named for the hue, like the three that came before them, rather than for
    /// the metric that happens to use them — a "Scheduled" or "Team" member would
    /// bake one page's meaning into a shared component.</para>
    ///
    /// <para><c>Amber</c> was added in the same phase for the finalized Requests
    /// screen's "מחכות לתגובתך" card. It is the same presentation-only contract:
    /// the Requests screen draws that KPI in amber while its row status still
    /// resolves onto the permitted three, and <see cref="MStatusDot.DotTone"/>
    /// is deliberately left unchanged.</para>
    ///
    /// <para><c>None</c> is the uncoloured card: ink value on the default
    /// hairline border. New members are appended, never inserted, so no existing
    /// member's ordinal changes.</para>
    /// </summary>
    public enum KpiAccent { None, Violet, Teal, Rose, Periwinkle, Cobalt, Amber }

    /// <summary>The metric itself — kept as a string, not an int, so a page can
    /// pass "12", "3/8" or "—" without this component owning formatting.</summary>
    [Parameter] public string? Value { get; set; }

    /// <summary>What the number means. Always visible: the accent colour is
    /// never the only carrier of meaning.</summary>
    [Parameter] public string? Label { get; set; }

    [Parameter] public KpiAccent Accent { get; set; } = KpiAccent.None;

    /// <summary>Optional leading glyph, drawn in a tinted chip in the card's
    /// accent. The caller supplies the markup (an "oi" span or an inline SVG) —
    /// MKpiCard sizes and tints the chip and has no opinion on icon system.
    /// Always rendered aria-hidden: the label carries the meaning.</summary>
    [Parameter] public RenderFragment? Icon { get; set; }

    /// <summary>Optional supporting content under the label — a delta, a
    /// secondary count. Justified by the Master only where the card genuinely
    /// carries a second fact; the default KPI is icon + number + label.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Renders the card as a link (the Master's "jump to the matching
    /// section" behaviour). Takes precedence over <see cref="OnClick"/>.</summary>
    [Parameter] public string? Href { get; set; }

    /// <summary>Renders the card as a button. Keyboard activation, focus and
    /// disabled semantics come from the native element — nothing is hand-rolled.</summary>
    [Parameter] public EventCallback<MouseEventArgs> OnClick { get; set; }

    /// <summary>Selected/pressed state for filter cards. Nullable on purpose:
    /// aria-pressed is emitted only for cards that really are toggles, so a
    /// card that merely runs an action is not announced as a toggle button.</summary>
    [Parameter] public bool? Pressed { get; set; }

    /// <summary>Overrides the accessible name when Value + Label do not read
    /// well on their own (e.g. "4" + "השבוע" → "4 משימות להגשה השבוע").</summary>
    [Parameter] public string? AriaLabel { get; set; }

    [Parameter] public string? Class { get; set; }

    private string? AriaPressed => Pressed is null ? null : (Pressed.Value ? "true" : "false");

    private string RootClass =>
        $"m-kpi m-kpi-{Accent.ToString().ToLowerInvariant()}"
        + (Pressed == true ? " m-kpi-pressed" : "")
        + (string.IsNullOrWhiteSpace(Class) ? "" : $" {Class}");
}
