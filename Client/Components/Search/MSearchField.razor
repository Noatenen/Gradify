@namespace AuthWithAdmin.Client.Components

@*
    MSearchField — the Master's search control.

    System Master §6: "SearchField — Appears in: Knowledge Center — Only one
    instance today — still worth componentizing before it's needed elsewhere."

    Shape is taken from the finalized Knowledge Center screen
    (Motiva Resources.dc.html:104-107) and the Master's own "Filters & search"
    swatch: a translucent white pill with a hairline card border, a violet
    magnifier, and a borderless input that inherits the page typeface.

    Deliberately NOT a filter control. The Master lists FilterControl/FilterChip
    as a separate component (Requests, Tasks) — this one owns free-text query
    entry and nothing else, so it has no opinion about what is being searched.

    The magnifier is inline SVG rather than an "oi" glyph on purpose: the Master
    specifies "thin outline (stroke ~1.6-2px), rounded joins, single weight" and
    open-iconic is a solid icon font, which reads visibly heavier next to the
    Design's own stroke icons. RequestThreadRow / RequestsKpiRow already
    established inline SVG for exactly this reason.
*@

<div class="@RootClass" style="@StyleAttr">
    <svg class="m-search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none"
         stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
         aria-hidden="true" focusable="false">
        <circle cx="11" cy="11" r="7"></circle>
        <path d="m21 21-4.3-4.3"></path>
    </svg>

    <input class="m-search-input"
           type="search"
           value="@Value"
           placeholder="@Placeholder"
           aria-label="@AriaLabel"
           autocomplete="off"
           @oninput="HandleInputAsync"
           @onkeydown="HandleKeyDownAsync" />
</div>

@code {
    /// <summary>The current query. Supports <c>@bind-Value</c>.</summary>
    [Parameter] public string? Value { get; set; }

    [Parameter] public EventCallback<string> ValueChanged { get; set; }

    [Parameter] public string? Placeholder { get; set; }

    /// <summary>Accessible name for the input. Required in practice: the
    /// Design draws no visible label, so without this the field announces as
    /// an unlabelled edit box.</summary>
    [Parameter] public string? AriaLabel { get; set; }

    /// <summary>CSS length capping the field's width, e.g. "480px". Passed
    /// through as an inline style because it is caller layout data (how wide
    /// this particular field should be), not a design token this component
    /// gets to decide.</summary>
    [Parameter] public string? MaxWidth { get; set; }

    [Parameter] public string? Class { get; set; }

    private string RootClass =>
        "m-search" + (string.IsNullOrWhiteSpace(Class) ? "" : $" {Class}");

    private string? StyleAttr =>
        string.IsNullOrWhiteSpace(MaxWidth) ? null : $"max-width:{MaxWidth}";

    private async Task HandleInputAsync(ChangeEventArgs e)
    {
        var next = e.Value?.ToString() ?? "";
        if (next == (Value ?? "")) return;

        Value = next;
        if (ValueChanged.HasDelegate) await ValueChanged.InvokeAsync(next);
    }

    // Escape clears the query. The Design draws no clear affordance and none is
    // added here — but a search that can only be exited by selecting all and
    // deleting is a keyboard dead end, and this costs nothing visually.
    private async Task HandleKeyDownAsync(KeyboardEventArgs e)
    {
        if (e.Key != "Escape" || string.IsNullOrEmpty(Value)) return;

        Value = "";
        if (ValueChanged.HasDelegate) await ValueChanged.InvokeAsync("");
    }
}
