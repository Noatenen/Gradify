@namespace AuthWithAdmin.Client.Components
@using AuthWithAdmin.Shared.AuthSharedModels
@using AuthWithAdmin.Client.Services
@inject IPersonalTasksService PersonalTasks
@inject IGoogleCalendarService GoogleCalendar
@inject NavigationManager Nav

@*
    MentorPersonalTaskModal — create / edit / delete one mentor personal task.

    Extracted from MentorTasksPage so the calendar can offer the SAME editor
    rather than growing a second one. The precedent is TeamTaskEditModal, which
    the student tasks page and the student planner already share for exactly this
    reason: one component, one set of validation rules, one delete confirmation,
    and no way for two screens to drift apart.

    It owns its form state and calls IPersonalTasksService itself. Callers pass
    the task to edit (or null to create), the projects they may associate, and
    react to the result — they never reimplement create, update or delete.
*@

@{
    // ── ONE editor, two shells ────────────────────────────────────────────
    // The fields and the actions are hoisted into fragments so the modal shell
    // and the calendar's inline card can render the IDENTICAL markup. Nothing
    // below is duplicated: same state, same validation, same save order, same
    // Google Calendar story. Only the box around them changes.
    RenderFragment fields = @<text>
        <div class="mpt-row mpt-row-grow">
            <label class="mpt-field-label" for="mpt-title">שם המשימה</label>
            <input id="mpt-title" class="mpt-field" maxlength="200"
                   placeholder="למשל: סיכום פגישה עם הצוות"
                   disabled="@_saving" @bind="_formTitle" @bind:event="oninput" />
        </div>

        @* Options come from the caller's own authorized project list, so the
           select cannot offer a project this mentor may not use. The server
           re-validates every save regardless.

           THE ROW IS OMITTED WHEN THERE IS NOTHING TO CHOOSE. With an empty
           list this rendered a select whose only option was "ללא שיוך" — a
           control that cannot change anything, sitting where a real field
           belongs. It reaches that state for a LECTURER, whose personal tasks
           the server will not let carry a project at all
           (CreatePersonalTask rejects a ProjectId unless MentorsProjectAsync),
           and for a mentor who supervises nothing.

           Nothing changes for a mentor with projects, which is every mentor
           this modal was written for: the row renders exactly as before, from
           the same list, with the same server validation behind it. *@
        @if (Projects.Count > 0)
        {
            <div class="mpt-row mpt-row-grow">
                <label class="mpt-field-label" for="mpt-project">פרויקט משויך (אופציונלי)</label>
                <MSelectField Options="@ProjectOptions"
                              Value="@_formProjectId.ToString()"
                              ValueChanged="@(v => _formProjectId = int.TryParse(v, out var n) ? n : 0)"
                              Disabled="@_saving"
                              Class="mpt-field" />
            </div>
        }

        <div class="mpt-row mpt-row-full">
            <label class="mpt-field-label" for="mpt-notes">תיאור / הערות (אופציונלי)</label>
            <textarea id="mpt-notes" class="mpt-field mpt-field-notes" rows="3" maxlength="1000"
                      placeholder="פרטים, החלטות או מה צריך להכין…"
                      disabled="@_saving" @bind="_formDescription"></textarea>
        </div>

        @*
            ── SCHEDULING ─────────────────────────────────────────────────────
            One question at a time, each revealed only by answering the one
            before it:

                תאריך יעד            always
              + הוספת שעה            once there is a date
              + הוספת שעת סיום       once there is a time

            A task is a thing that is DUE ON A DAY. Most are only that, so most
            of this section never appears. Asking every task for a start hour
            and an end hour — as this form did — asks two questions of a note
            that needed none, and gives optional scheduling the same visual
            weight as the task's own name.

            The steps are text links, not fields: they are offers, and an offer
            must not look like something waiting to be filled in.
        *@
        <div class="mpt-row">
            <label class="mpt-field-label" for="mpt-due">
                תאריך יעד@(DateIsRequired ? "" : " (אופציונלי)")
                @if (DateIsRequired)
                {
                    <span class="mpt-required" aria-hidden="true">*</span>
                }
            </label>
            <MDateField Value="@_formDue"
                        ValueChanged="OnDueChangedAsync"
                        Label="תאריך יעד"
                        Placeholder="בחירת תאריך"
                        Disabled="@_saving"
                        Invalid="@(DateIsRequired && _formDue is null)" />
        </div>

        @if (_formDue is not null && !_showTime)
        {
            <button type="button" class="mpt-reveal" disabled="@_saving" @onclick="ShowTime">
                <span aria-hidden="true">+</span> הוספת שעה
            </button>
        }

        @if (_showTime)
        {
            @* ONE field while the task is just due at an hour. It becomes
               שעת התחלה only once an end exists — a lone time is a deadline,
               and calling it a start when nothing follows it is wrong. *@
            <div class="mpt-times @(_showEnd ? "mpt-times-pair" : "")">
                <div class="mpt-time">
                    <label class="mpt-field-label">
                        @(_showEnd ? "שעת התחלה" : "שעה")
                        @if (TimesAreRequired)
                        {
                            <span class="mpt-required" aria-hidden="true">*</span>
                        }
                    </label>
                    <MTimeField Value="@_formStart"
                                ValueChanged="OnStartChangedAsync"
                                Label="@(_showEnd ? "שעת התחלה" : "שעה")"
                                Disabled="@_saving"
                                Invalid="@(TimesAreRequired && string.IsNullOrEmpty(_formStart))" />
                </div>

                @if (_showEnd)
                {
                    <div class="mpt-time">
                        <label class="mpt-field-label">
                            שעת סיום
                            @if (TimesAreRequired)
                            {
                                <span class="mpt-required" aria-hidden="true">*</span>
                            }
                        </label>
                        <MTimeField Value="@_formEnd"
                                    ValueChanged="OnEndChangedAsync"
                                    Label="שעת סיום"
                                    Disabled="@_saving"
                                    Invalid="@(TimesAreRequired && string.IsNullOrEmpty(_formEnd))" />
                    </div>
                }
            </div>

            @* Duration is the third question, and only the tasks that are
               really a scheduled block ever get asked it. Google needs one,
               so switching the toggle on opens this by itself. *@
            <div class="mpt-reveal-row">
                @if (!_showEnd)
                {
                    <button type="button" class="mpt-reveal" disabled="@_saving" @onclick="ShowEnd">
                        <span aria-hidden="true">+</span> הוספת שעת סיום
                    </button>
                }
                <button type="button" class="mpt-reveal mpt-reveal-muted"
                        disabled="@_saving" @onclick="ClearTimesAsync">
                    הסרת השעה
                </button>
            </div>
        }

        @*
            ── Google Calendar ────────────────────────────────────────────────
            The same connect / toggle / confirm-removal pattern TeamTaskEditModal
            uses, against the same OAuth grant and the same event service. It asks
            for NOTHING extra: the event's date is תאריך and its hours are the two
            fields above, so there is no second date to keep in sync and no way
            for the calendar to disagree with the task.

            Progressive disclosure: OFF is the default and reveals no fields, so a
            task saved without touching this behaves exactly as it did before this
            section existed.
        *@
        @if (_gcalStatus is null)
        {
            @* Status still loading. Rendering nothing — rather than a spinner or
               a guessed state — keeps the modal from jumping and stops it ever
               showing a toggle it may have to retract. *@
        }
        else if (!_gcalStatus.IsConnected)
        {
            <div class="mpt-gcal-notice">
                <span class="mpt-gcal-notice-text">יומן Google לא מחובר</span>
                <button type="button" class="mpt-gcal-connect"
                        @onclick="ConnectCalendarAsync" disabled="@_saving">
                    חיבור
                </button>
            </div>
        }
        else
        {
            <div class="mpt-gcal">
                <div class="mpt-gcal-head">
                    <span class="mpt-gcal-title">הוספה ליומן Google</span>
                    @* Not disabled while the removal question is open: _addToCalendar
                       stays true until the user answers, so the toggle keeps reading
                       ON — which is the truth, the event is still in their calendar. *@
                    <MToggle Checked="_addToCalendar"
                             AriaLabel="הוספה ליומן Google"
                             Disabled="@(_saving || _calBusy)"
                             CheckedChanged="OnCalendarToggled" />
                </div>

                @if (_confirmRemove)
                {
                    @* Turning the toggle off on an already-synced task deletes a
                       real event out of the mentor's personal calendar. Not a
                       thing to do silently on a stray click. *@
                    <div class="mpt-gcal-confirm" role="alertdialog" aria-label="הסרת המשימה מיומן Google">
                        <p class="mpt-gcal-confirm-text">הסרת המשימה מיומן Google?</p>
                        <div class="mpt-gcal-confirm-actions">
                            <MButton Variant="MButton.ButtonVariant.Secondary"
                                     Size="MButton.ButtonSize.Small"
                                     Disabled="@_calBusy"
                                     OnClick="@(() => _confirmRemove = false)">ביטול</MButton>
                            <MButton Variant="MButton.ButtonVariant.Danger"
                                     Size="MButton.ButtonSize.Small"
                                     Loading="@_calBusy"
                                     OnClick="ConfirmRemoveAsync">הסרה</MButton>
                        </div>
                    </div>
                }
                else if (_addToCalendar)
                {
                    <p class="mpt-gcal-hint">האירוע ייווצר בתאריך ובשעות שנבחרו למעלה.</p>
                }
            </div>
        }

        @if (!string.IsNullOrEmpty(_error))
        {
            <p class="mpt-field-error" role="alert">@_error</p>
        }

        @if (_partialFailure)
        {
            @* The task IS saved. This block is why the footer can drop ביטול —
               a cancel here would read as "undo the task", the opposite of what
               happened. *@
            <p class="mpt-gcal-partial" role="status">המשימה נשמרה, אך לא נוספה ליומן Google.</p>
        }
    </text>;

    RenderFragment actions = @<text>
        @* Delete lives inside the editor, the same place TeamTaskEditModal puts
           it — a destructive action belongs with the thing it destroys, not on
           the row where a mis-click costs a task. Only on edit; there is nothing
           to delete while creating. *@
        @if (EditingTask is not null && !_partialFailure)
        {
            @if (_confirmDelete)
            {
                <span class="mpt-delete-confirm">למחוק את המשימה?</span>
                <MButton Variant="MButton.ButtonVariant.Secondary"
                         OnClick="@(() => _confirmDelete = false)" Disabled="@_saving">ביטול</MButton>
                <MButton Variant="MButton.ButtonVariant.Danger"
                         OnClick="DeleteAsync" Loading="@_saving" LoadingText="מוחקת…">מחיקה</MButton>
            }
            else
            {
                <MButton Variant="MButton.ButtonVariant.Danger"
                         OnClick="@(() => _confirmDelete = true)" Disabled="@_saving">מחיקה</MButton>
            }
        }

        @if (_partialFailure)
        {
            @* Retrying hits the same idempotent endpoint against the same stored
               event id, so it cannot produce a second event. *@
            <MButton Variant="MButton.ButtonVariant.Secondary" OnClick="CloseAsync" Disabled="@_calBusy">סגירה</MButton>
            <MButton Variant="MButton.ButtonVariant.Primary" OnClick="RetryCalendarAsync"
                     Loading="@_calBusy" LoadingText="מנסה שוב…">ניסיון נוסף</MButton>
        }
        else if (!_confirmDelete)
        {
            <MButton Variant="MButton.ButtonVariant.Secondary" OnClick="CloseAsync" Disabled="@_saving">ביטול</MButton>
            <MButton Variant="MButton.ButtonVariant.Primary"
                     OnClick="SaveAsync" Loading="@_saving" LoadingText="שומרת…"
                     Disabled="@(_saving || string.IsNullOrWhiteSpace(_formTitle))">שמירה</MButton>
        }
    </text>;
}

@if (Presentation == EditorPresentation.Inline)
{
    @*  The reference's create/edit card: a gradient hairline over an opaque
        fill, sitting in the page above the grid. Rendered only while open —
        an inline editor has no backdrop to hide behind. *@
    @if (IsOpen)
    {
        <div class="mpt-inline" role="group"
             aria-label="@(EditingTask is null ? "אירוע / משימה חדשים" : "עריכת פריט")">
            <p class="mpt-inline-title">@(EditingTask is null ? "אירוע / משימה חדשים" : "עריכת פריט")</p>

            <div class="mpt-inline-fields">
                @fields
            </div>

            <div class="mpt-inline-actions">
                @actions
            </div>
        </div>
    }
}
else
{
    <MModal IsOpen="@IsOpen" Size="@Size"
            Title="@(EditingTask is null ? "משימה חדשה" : "עריכת משימה")"
            OnClose="CloseAsync">
        <ChildContent>
            @fields
        </ChildContent>

        <FooterContent>
            @actions
        </FooterContent>
    </MModal>
}

@code {
    /// <summary>Which shell to draw. The FIELDS, the validation, the save order
    /// and the whole Google Calendar story are identical either way.</summary>
    public enum EditorPresentation
    {
        /// <summary>MModal — what /mentor/tasks has always opened. Unchanged.</summary>
        Modal,

        /// <summary>
        /// The finalized Calendar reference's gradient-bordered card, rendered
        /// in the page above the grid.
        ///
        /// <para>A second presentation rather than a second editor, for the
        /// same reason MentorRequestDetail grew one: this component is the only
        /// place in the product that knows how to talk to Google Calendar for a
        /// mentor task — the connect prompt, the idempotent schedule call, the
        /// confirm-before-removal, and the "saved, but not added" state. A
        /// hand-rolled inline form would have been a second copy of all four.</para>
        /// </summary>
        Inline
    }

    [Parameter] public EditorPresentation Presentation { get; set; } = EditorPresentation.Modal;

    /// <summary>
    /// How wide the Modal presentation draws. Ignored by Inline, which has no
    /// dialog to size.
    ///
    /// <para>Small (440px under `.motiva-final`) is the default and is what
    /// every task-list caller has always opened — /mentor/tasks, בית, the
    /// project page and /lecturer/tasks are unchanged by this parameter
    /// existing.</para>
    ///
    /// <para>A CALENDAR opens it Large (720px), the width the student
    /// calendar's own create modal settled on. A form reached by clicking a day
    /// is the screen's main act rather than a row's edit affordance, and the
    /// two short controls only sit side by side once there is room for them.
    /// The value is the shared shell's own token, not a number restated
    /// here.</para>
    /// </summary>
    [Parameter] public MModal.ModalSize Size { get; set; } = MModal.ModalSize.Small;

    [Parameter] public bool IsOpen { get; set; }

    /// <summary>Task to edit, or null to create.</summary>
    [Parameter] public PersonalTaskDto? EditingTask { get; set; }

    /// <summary>Projects this mentor may associate. Empty is valid — the select
    /// then offers only "ללא שיוך".</summary>
    [Parameter] public IReadOnlyList<MentorProjectSummaryDto> Projects { get; set; }
        = Array.Empty<MentorProjectSummaryDto>();

    /// <summary>Seeds תאריך יעד when CREATING. This is how the calendar hands
    /// over the day the mentor selected; the field stays editable, so the date
    /// is a starting point and never a decision the caller locks in.</summary>
    [Parameter] public DateTime? InitialDueDate { get; set; }

    /// <summary>Seeds שיוך לפרויקט when CREATING — the same "starting point,
    /// not a decision" contract as <see cref="InitialDueDate"/>: the select
    /// stays enabled and "ללא שיוך" remains choosable.
    ///
    /// <para>Added for the project workspace's קביעת פגישת הנחיה button, which
    /// opens this editor from inside one project and should not make the mentor
    /// re-pick the project they are already looking at. Ignored when editing an
    /// existing task, whose own association always wins.</para></summary>
    [Parameter] public int? InitialProjectId { get; set; }

    [Parameter] public EventCallback OnClose { get; set; }

    /// <summary>Raised after a successful create or update, with the resulting
    /// task. Callers refresh from this rather than re-implementing the save.</summary>
    [Parameter] public EventCallback<PersonalTaskDto> OnSaved { get; set; }

    /// <summary>Raised after a successful delete, with the removed id.</summary>
    [Parameter] public EventCallback<int> OnDeleted { get; set; }

    private string    _formTitle = "";
    private string?   _formDescription;
    private int       _formProjectId;
    private DateTime? _formDue;

    /// <summary>
    /// The optional schedule, as the "HH:mm" strings the time fields speak.
    /// Empty means date-only — never a default hour.
    ///
    /// <para>THREE VALID SHAPES, and the form only ever offers the next one:
    /// no time at all (a task due on a day); a start alone (due at an hour);
    /// or a start and an end (a scheduled block). A lone END is not a shape —
    /// it would be a duration with no beginning.</para>
    /// </summary>
    private string _formStart = "";
    private string _formEnd   = "";

    /// <summary>Whether the time step has been revealed. Distinct from "there
    /// is a time": the field is shown the moment it is asked for and stays
    /// shown while it is still empty, or it would vanish under the cursor.</summary>
    private bool _showTime;

    /// <summary>Whether the duration step has been revealed. Same distinction.</summary>
    private bool _showEnd;

    private bool    _saving;
    private bool    _confirmDelete;
    private string? _error;

    // ── Google Calendar ───────────────────────────────────────────────────────
    // Same grant, same event service and same UX pattern as TeamTaskEditModal.
    // Nothing about OAuth happens here: connecting hands off to the one
    // connect-url flow the settings page uses.

    /// <summary>Null until the real server status arrives. Connection state is
    /// never inferred locally — the browser leaves the app during consent, so
    /// only the server row knows whether a grant exists.</summary>
    private GoogleCalendarStatusDto? _gcalStatus;

    private bool _addToCalendar;
    private bool _calBusy;
    private bool _confirmRemove;
    private bool _partialFailure;

    /// <summary>Whether a Google event currently EXISTS for this task — the
    /// difference between "already in the calendar" (turning the toggle off
    /// deletes it, so ask first) and "about to be added" (turning it off just
    /// hides the hint).</summary>
    private bool _hasSchedule;

    /// <summary>The task id to sync against. Known up front on an edit; filled
    /// in after create, which is what lets "ניסיון נוסף" retry the calendar step
    /// alone without creating a second task.</summary>
    private int? _syncTaskId;

    /// <summary>
    /// The row the last successful save produced — the thing callers are handed
    /// through OnSaved.
    ///
    /// <para>Held rather than reported immediately because a save that commits
    /// the task and then fails at Google leaves the modal open on "ניסיון נוסף".
    /// Whichever way that ends — retry succeeds, or the mentor just closes — the
    /// caller must still learn the task exists, or the list behind the modal
    /// shows stale data for something that really is saved.</para>
    /// </summary>
    private PersonalTaskDto? _savedResult;

    // The open transition seeds the form. Re-seeding on every render would wipe
    // whatever the user has typed.
    private bool _wasOpen;

    protected override async Task OnParametersSetAsync()
    {
        if (IsOpen && !_wasOpen)
        {
            Seed();
            _wasOpen = true;
            await LoadCalendarStateAsync();
            StateHasChanged();
            return;
        }

        _wasOpen = IsOpen;
    }

    /// <summary>
    /// Connection state and this task's existing link, re-read on every open.
    ///
    /// <para>Not cached: the grant can be revoked from Google's side or from
    /// /settings at any moment, and a stale "connected" would offer a toggle
    /// that fails on save. The schedules endpoint returns nothing at all while
    /// the grant is disconnected, so the modal cannot show a sync it can no
    /// longer manage.</para>
    /// </summary>
    private async Task LoadCalendarStateAsync()
    {
        var statusTask    = GoogleCalendar.GetStatusAsync();
        var schedulesTask = GoogleCalendar.GetPersonalTaskSchedulesAsync();
        await Task.WhenAll(statusTask, schedulesTask);

        _gcalStatus = statusTask.Result ?? new GoogleCalendarStatusDto { IsConnected = false };

        if (EditingTask is null) return;

        var existing = schedulesTask.Result.FirstOrDefault(s => s.TaskId == EditingTask.Id);
        if (existing is null) return;

        // An already-synced task opens with the toggle ON, so saving without
        // touching anything patches the SAME event rather than creating a second
        // one. The times are NOT read back from the link: the task's own
        // StartTime/EndTime are the source of truth and are already on the form.
        _hasSchedule   = true;
        _addToCalendar = true;
    }

    /// <summary>
    /// Fills the form for the task being edited, or for a fresh one.
    ///
    /// <para>A task whose project the mentor no longer mentors arrives with
    /// ProjectId null — the server resolves association through ProjectMentors —
    /// so the select shows "ללא שיוך" and saving cannot silently re-attach it.</para>
    /// </summary>
    private void Seed()
    {
        _formTitle       = EditingTask?.Title ?? "";
        _formDescription = EditingTask?.Description;
        _formProjectId   = EditingTask?.ProjectId ?? (EditingTask is null ? InitialProjectId ?? 0 : 0);
        _formDue         = EditingTask?.DueDate ?? (EditingTask is null ? InitialDueDate : null);
        _formStart       = EditingTask?.StartTime ?? "";
        _formEnd         = EditingTask?.EndTime   ?? "";

        // A saved task reopens at the step it actually reached: a scheduled
        // block shows both fields, an hour-deadline shows one, a plain task
        // shows none. Nothing is disclosed that the task does not already use.
        _showTime        = !string.IsNullOrEmpty(_formStart);
        _showEnd         = !string.IsNullOrEmpty(_formEnd);
        _error           = null;
        _confirmDelete   = false;
        _saving          = false;

        // Cleared here and filled in by LoadCalendarStateAsync — the modal starts
        // from "nothing synced" and only claims otherwise once the server says so.
        _gcalStatus     = null;
        _addToCalendar  = false;
        _hasSchedule    = false;
        _calBusy        = false;
        _confirmRemove  = false;
        _partialFailure = false;
        _syncTaskId     = EditingTask?.Id;
        _savedResult    = null;
    }

    // ── The optional work block ───────────────────────────────────────────────

    private Task OnDueChangedAsync(DateTime? value)
    {
        _formDue = value;
        _error   = null;

        // Clearing the date un-asks everything that depended on it rather than
        // leaving hours stranded on no day at all.
        if (value is null) { _showTime = false; _showEnd = false; _formStart = ""; _formEnd = ""; }

        return Task.CompletedTask;
    }

    private Task OnStartChangedAsync(string value)
    {
        _formStart = value;
        _error     = null;
        return Task.CompletedTask;
    }

    private Task OnEndChangedAsync(string value)
    {
        _formEnd = value;
        _error   = null;
        return Task.CompletedTask;
    }

    private void ShowTime() { _showTime = true; _error = null; }

    private void ShowEnd()  { _showEnd  = true; _error = null; }

    /// <summary>
    /// Puts the task back to date-only in one action.
    ///
    /// <para>Refused while Google sync is on, because the event cannot exist
    /// without hours — the mentor is pointed at the toggle instead, which is
    /// the control that actually governs it and which asks before deleting
    /// anything out of their calendar.</para>
    /// </summary>
    private Task ClearTimesAsync()
    {
        if (_addToCalendar)
        {
            _error = "כדי להסיר את השעה יש לכבות תחילה את הסנכרון ליומן Google";
            return Task.CompletedTask;
        }

        _formStart = _formEnd = "";
        _showTime  = _showEnd = false;
        _error     = null;
        return Task.CompletedTask;
    }

    /// <summary>
    /// Which time fields must be filled before this can save.
    ///
    /// <para>A revealed-but-empty field is not an error on its own — the
    /// mentor can always back out with הסרת השעה. It becomes required once the
    /// END is in play (a duration needs both ends) or once Google sync is on
    /// (an event needs a start and a finish).</para>
    /// </summary>
    private bool TimesAreRequired => _addToCalendar || _showEnd;

    /// <summary>Hours need a day to sit on, and a Google event needs a date.</summary>
    private bool DateIsRequired =>
        _addToCalendar || !string.IsNullOrEmpty(_formStart) || !string.IsNullOrEmpty(_formEnd);

    private static string FieldClass(bool invalid) =>
        invalid ? "mpt-field mpt-field-invalid" : "mpt-field";

    /// <summary>
    /// Validates the work block before anything is written.
    ///
    /// <para>Mirrors the server rules exactly — both-or-neither, end after
    /// start, and a date to hang them on. Run client-side first so a typo puts
    /// the cursor back in the form instead of costing a round trip; the server
    /// re-checks regardless, because these endpoints are reachable without the
    /// UI.</para>
    /// </summary>
    private bool ValidateWorkBlock()
    {
        bool hasStart = !string.IsNullOrEmpty(_formStart);
        bool hasEnd   = !string.IsNullOrEmpty(_formEnd);

        // A Google event has a beginning and an end. Rather than refuse and
        // leave the mentor hunting for the missing field, the step is opened
        // for them and the message points at it.
        if (_addToCalendar && !hasEnd)
        {
            _showTime = _showEnd = true;
            _error = "אירוע ביומן Google צריך שעת התחלה ושעת סיום";
            return false;
        }

        if (hasEnd && !hasStart)
        {
            _error = "יש להזין שעת התחלה";
            return false;
        }

        if (hasStart && hasEnd)
        {
            var start = MotivaDates.ParseWallClock(_formStart);
            var end   = MotivaDates.ParseWallClock(_formEnd);

            if (start is null || end is null) { _error = "שעה לא תקינה"; return false; }

            if (end <= start)
            {
                _error = "שעת הסיום חייבת להיות אחרי שעת ההתחלה";
                return false;
            }
        }
        else if (hasStart && MotivaDates.ParseWallClock(_formStart) is null)
        {
            _error = "שעה לא תקינה";
            return false;
        }

        if (DateIsRequired && _formDue is null)
        {
            _error = _addToCalendar
                ? "יש לבחור תאריך יעד כדי להוסיף את המשימה ליומן Google"
                : "יש לבחור תאריך יעד כדי לקבוע שעה למשימה";
            return false;
        }

        return true;
    }

    private IReadOnlyList<MSelect.Option> ProjectOptions
    {
        get
        {
            var list = new List<MSelect.Option> { new MSelect.Option("0", "ללא שיוך") };
            list.AddRange(Projects.Select(p => new MSelect.Option(p.Id.ToString(), ProjectOptionLabel(p))));
            return list;
        }
    }

    private static string ProjectOptionLabel(MentorProjectSummaryDto p) =>
        string.IsNullOrWhiteSpace(p.TeamName) ? p.Title : $"{p.Title} — {p.TeamName}";

    private async Task CloseAsync()
    {
        if (_saving) return;
        _confirmDelete = false;

        // _partialFailure means the TASK was written and only Google failed. The
        // caller has not been told about it yet — it is told on the retry path —
        // so closing here must report the save rather than a plain dismissal,
        // otherwise the list behind the modal would quietly show stale data for
        // a task that really is saved.
        if (_savedResult is { } saved)
        {
            _partialFailure = false;
            _savedResult    = null;
            await OnSaved.InvokeAsync(saved);
            return;
        }

        await OnClose.InvokeAsync();
    }

    /// <summary>
    /// Save order is deliberate and is the whole failure story of this feature:
    ///
    ///   1. validate the task, including the work block
    ///   2. save the Motiva task  ← committed here, and never rolled back
    ///   3. only then talk to Google
    ///
    /// Step 1 runs before anything is written, so a bad time range just puts the
    /// cursor back in the form. Step 3 runs after the commit, so a Google outage
    /// costs the mentor a calendar event — never their task.
    /// </summary>
    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(_formTitle)) return;

        _error = null;
        if (!ValidateWorkBlock()) return;

        _saving = true;

        int?    projectId   = _formProjectId == 0 ? null : _formProjectId;
        string  title       = _formTitle.Trim();
        string? description = string.IsNullOrWhiteSpace(_formDescription) ? null : _formDescription.Trim();
        string? start       = string.IsNullOrEmpty(_formStart) ? null : _formStart;
        string? end         = string.IsNullOrEmpty(_formEnd)   ? null : _formEnd;

        if (EditingTask is { } editing)
        {
            var error = await PersonalTasks.UpdateAsync(editing.Id, new UpdatePersonalTaskRequest
            {
                Title = title, Description = description, DueDate = _formDue, ProjectId = projectId,
                StartTime = start, EndTime = end,
            });

            if (error is not null) { _saving = false; _error = error; return; }

            // Mirror onto the instance the caller handed us, using the SAME
            // authorized list the select offered — so a label can never name a
            // project this mentor lost access to.
            var proj = projectId is int pid ? Projects.FirstOrDefault(p => p.Id == pid) : null;

            editing.Title        = title;
            editing.Description  = description;
            editing.DueDate      = _formDue;
            editing.StartTime    = start;
            editing.EndTime      = end;
            editing.ProjectId    = proj?.Id;
            editing.ProjectTitle = proj?.Title;
            editing.TeamName     = proj?.TeamName;

            _syncTaskId  = editing.Id;
            _savedResult = editing;

            if (!await PushCalendarAsync()) { _saving = false; StateHasChanged(); return; }

            _saving      = false;
            _savedResult = null;
            await OnSaved.InvokeAsync(editing);
            return;
        }

        var (created, createError) = await PersonalTasks.CreateAsync(new CreatePersonalTaskRequest
        {
            Title = title, Description = description, DueDate = _formDue, ProjectId = projectId,
            StartTime = start, EndTime = end,
        });

        if (created is null)
        {
            _saving = false;
            _error = createError ?? "לא הצלחנו לשמור את המשימה. אפשר לנסות שוב.";
            return;
        }

        // The task exists now. Nothing below can undo it.
        _syncTaskId  = created.Id;
        _savedResult = created;

        if (!await PushCalendarAsync()) { _saving = false; StateHasChanged(); return; }

        _saving      = false;
        _savedResult = null;
        await OnSaved.InvokeAsync(created);
    }

    // ── Google Calendar ───────────────────────────────────────────────────────

    /// <summary>
    /// Sends the just-saved task to Google, when the toggle is on. True means
    /// "carry on and close" — including when there was nothing to do.
    ///
    /// <para>The request carries no payload: the server reads the title,
    /// description, date and hours off the row that was just written, so
    /// editing any of them and saving MOVES or RETITLES the same event (same
    /// link row, same Google event id, patched in place) instead of creating a
    /// second one.</para>
    /// </summary>
    private async Task<bool> PushCalendarAsync()
    {
        if (!_addToCalendar) return true;
        if (_syncTaskId is not int taskId) return true;

        var result = await GoogleCalendar.SchedulePersonalTaskAsync(taskId);

        if (result?.Success == true)
        {
            _partialFailure = false;
            _hasSchedule    = true;
            return true;
        }

        // The grant disappeared between opening the modal and saving. Say so
        // plainly rather than offering a retry that cannot succeed.
        if (result?.Outcome == CalendarScheduleOutcomes.NotConnected)
            _gcalStatus = new GoogleCalendarStatusDto { IsConnected = false };

        _partialFailure = true;
        return false;
    }

    private async Task RetryCalendarAsync()
    {
        _calBusy = true;
        StateHasChanged();

        bool ok = await PushCalendarAsync();
        _calBusy = false;

        if (!ok) { StateHasChanged(); return; }

        // The task was already saved before the first attempt; the caller is
        // told about it now that the calendar has caught up.
        var saved    = _savedResult;
        _savedResult = null;

        if (saved is not null) await OnSaved.InvokeAsync(saved);
        else                   await OnClose.InvokeAsync();
    }

    /// <summary>
    /// The toggle. Switching ON just arms the sync; switching OFF on a task that
    /// already has an event asks first, because that click would delete
    /// something out of the mentor's personal calendar.
    /// </summary>
    private void OnCalendarToggled(bool value)
    {
        // Toggling back on while the removal question is open is a change of
        // mind — the same as pressing ביטול.
        if (value && _confirmRemove) { _confirmRemove = false; return; }

        if (!value && _hasSchedule) { _confirmRemove = true; return; }

        _addToCalendar = value;
        _error         = null;

        // An event needs hours, so switching this on ASKS for them rather than
        // waiting for the save to complain. Switching it off reveals nothing
        // and hides nothing — whatever the task itself uses, it keeps.
        if (value) { _showTime = true; _showEnd = true; }
    }

    private async Task ConfirmRemoveAsync()
    {
        if (_syncTaskId is not int taskId) { _confirmRemove = false; return; }

        _calBusy = true;
        _error   = null;
        StateHasChanged();

        var result = await GoogleCalendar.UnschedulePersonalTaskAsync(taskId);
        _calBusy = false;

        if (result?.Success == true)
        {
            // The event is gone; the Motiva task is untouched and the modal
            // stays open for further editing.
            _confirmRemove = false;
            _addToCalendar = false;
            _hasSchedule   = false;
        }
        else
        {
            // Keep the link and the question open — the event is still in the
            // calendar, so the mentor must be able to try again.
            _error = "לא הצלחנו להסיר את האירוע מיומן Google כרגע. אפשר לנסות שוב.";
        }

        StateHasChanged();
    }

    private async Task ConnectCalendarAsync()
    {
        // No OAuth logic here — the same connect-url flow the settings page and
        // the team-task modal use. A second flow is exactly what this reuses.
        var url = await GoogleCalendar.GetConnectUrlAsync();

        if (url is not null) Nav.NavigateTo(url, forceLoad: true);
        else                 _error = "האינטגרציה עם Google Calendar עדיין לא הוגדרה במערכת.";
    }

    private async Task DeleteAsync()
    {
        if (EditingTask is not { } target) return;

        _saving = true;
        _error  = null;

        bool ok = await PersonalTasks.DeleteAsync(target.Id);
        _saving = false;

        if (!ok)
        {
            _error         = "לא הצלחנו למחוק את המשימה. אפשר לנסות שוב.";
            _confirmDelete = false;
            return;
        }

        _confirmDelete = false;
        await OnDeleted.InvokeAsync(target.Id);
    }
}
