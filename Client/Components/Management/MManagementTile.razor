@namespace AuthWithAdmin.Client.Components

@*
    MManagementTile — ONE destination on the Management hub.

    Visual source: design/design-system/Motiva Admin Home.dc.html — the row
    card its four sections are grids of: a 44px tinted icon chip, a title with
    an optional quiet count beside it, a one-line description under it, and a
    trailing arrow.

    WHY A COMPONENT
    The hub draws twenty-one of these and will draw more. Held as markup on the
    page it was twenty-one copies of the same eleven elements, which is what
    made "add a management area" a Razor edit rather than a data edit. The page
    now loops ManagementHubDefinitions over this.

    ANCHOR OR BUTTON — THE PAGE DOES NOT CHOOSE, THE DATA DOES
    A tile with an Href renders a real <a>, so middle-click, ⌘-click,
    open-in-new-tab, the status bar and Back all behave the way the browser's
    own navigation does. (The hub's previous rows were divs calling
    NavigationManager, which have none of that.) The four quick-edit panels
    open in place on the hub itself and have no URL, so those render a
    <button> — a link to nowhere would be a lie about what is going to happen.
    That is also why the two carry different trailing glyphs.
*@

@if (!string.IsNullOrWhiteSpace(Href))
{
    <a class="@RootClass" href="@Href">
        @Body
        <span class="mmt-go" aria-hidden="true">
            @* Points at the reading END — RTL, so this is "forward". *@
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M19 12H5"></path>
                <path d="m12 19-7-7 7-7"></path>
            </svg>
        </span>
    </a>
}
else
{
    <button type="button" class="@RootClass" @onclick="HandleClickAsync">
        @Body
        <span class="mmt-go mmt-go-open" aria-hidden="true">
            @* Opens below, on this page — a down chevron, not an arrow away. *@
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="m6 9 6 6 6-6"></path>
            </svg>
        </span>
    </button>
}

@code {
    /// <summary>The module's name.</summary>
    [Parameter, EditorRequired] public string Title { get; set; } = "";

    /// <summary>One line saying what the module holds. Always visible — several
    /// of these names do not explain themselves, and a tooltip would make the
    /// hub unreadable without a pointer. <c>title</c> is only the fallback for
    /// the narrow widths where the line has to ellipsise.</summary>
    [Parameter] public string? Description { get; set; }

    /// <summary>Raw SVG children (24×24 viewBox) for the icon chip.</summary>
    [Parameter] public string? IconMarkup { get; set; }

    /// <summary>Violet / blue / teal — the glyph's stroke. The chip's tint
    /// background is the same on every tile.</summary>
    [Parameter] public ManagementHubDefinitions.TileAccent Accent { get; set; }
        = ManagementHubDefinitions.TileAccent.Violet;

    /// <summary>Where the tile goes. Null renders a button instead — see the
    /// note at the top of this file.</summary>
    [Parameter] public string? Href { get; set; }

    /// <summary>Optional live figure shown beside the title, in the muted
    /// annotation weight the reference uses. Real data only — the hub never
    /// prints a placeholder number.</summary>
    [Parameter] public string? Count { get; set; }

    /// <summary>Raised by the button form only.</summary>
    [Parameter] public EventCallback OnClick { get; set; }

    [Parameter] public string? Class { get; set; }

    private string RootClass =>
        $"mmt mmt-{Accent.ToString().ToLowerInvariant()}"
        + (string.IsNullOrWhiteSpace(Class) ? "" : $" {Class}");

    private RenderFragment Body => @<text>
        @if (!string.IsNullOrWhiteSpace(IconMarkup))
        {
            <span class="mmt-icon" aria-hidden="true">
                <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    @((MarkupString)IconMarkup)
                </svg>
            </span>
        }
        <span class="mmt-text">
            <span class="mmt-title-row">
                <span class="mmt-title">@Title</span>
                @if (!string.IsNullOrWhiteSpace(Count))
                {
                    <span class="mmt-count">@Count</span>
                }
            </span>
            @if (!string.IsNullOrWhiteSpace(Description))
            {
                <span class="mmt-desc" title="@Description">@Description</span>
            }
        </span>
    </text>;

    private async Task HandleClickAsync()
    {
        if (OnClick.HasDelegate) await OnClick.InvokeAsync();
    }
}
