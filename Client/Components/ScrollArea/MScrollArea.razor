@namespace AuthWithAdmin.Client.Components

@*
    MScrollArea — the Master's fixed-height scroll container.

    Master: "Thin custom scrollbar (6px, low-contrast) — used inside
    fixed-height task/team panels."

    Exists so pages stop re-declaring ::-webkit-scrollbar rules per card
    (the prototype has .cardscroll and .teamscroll, two copies of the same
    treatment; the app has more).

    RTL note — REVERSED, Sept 2026. This component used to keep the
    inherited direction, so the scrollbar landed on the inline-end edge,
    which under this app's `direction: rtl` is the physical LEFT. The
    product decision is that every vertical scrollbar sits on the physical
    RIGHT, and by then three screens had each re-implemented the flip
    locally (.rqw-list in motiva-request-workspace.css, .pws-body on the
    workspace, .mt-primary ::deep .m-scroll on mentor tasks) — so the
    primitive was not preventing the hack, only excluding itself from it.

    The old objection was that the flip breaks direction inheritance for
    anything that is not a direct element child. That is still true, and it
    is the one constraint on using this component: PUT ELEMENTS IN IT, NOT
    BARE TEXT. Every caller already does — a bare text node inside a scroll
    region would be unstyleable anyway. Deeper subtrees are unaffected;
    they inherit rtl from the direct child that restores it.
*@

<div class="@RootClass"
     style="@StyleAttr"
     tabindex="@(Tabbable ? "0" : null)"
     role="@Role"
     aria-label="@AriaLabel">
    @ChildContent
</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>CSS length for the container's maximum height, e.g. "240px".
    /// The container scrolls once its content exceeds it. Passed through as an
    /// inline style because it is caller data (a panel's height), not a design
    /// token this component gets to decide.</summary>
    [Parameter] public string? MaxHeight { get; set; }

    /// <summary>CSS length for a fixed height, when the panel must reserve its
    /// space whether or not the content fills it.</summary>
    [Parameter] public string? Height { get; set; }

    /// <summary>Whether the scroll box is reachable by keyboard. On by default:
    /// a scrollable region that cannot be focused is unreachable for anyone not
    /// using a pointer (WCAG 2.1.1). Turn it off only when the container's
    /// content is itself fully focusable, which already provides the scroll.</summary>
    [Parameter] public bool Tabbable { get; set; } = true;

    /// <summary>Accessible name for the scrollable region. When supplied the
    /// box is exposed as a named region; without a name it stays a plain
    /// focusable box, since role="region" with no name announces nothing
    /// useful.</summary>
    [Parameter] public string? AriaLabel { get; set; }

    [Parameter] public string? Class { get; set; }

    private string? Role => string.IsNullOrWhiteSpace(AriaLabel) ? null : "region";

    private string? StyleAttr
    {
        get
        {
            var parts = new List<string>(2);
            if (!string.IsNullOrWhiteSpace(Height)) parts.Add($"height:{Height}");
            if (!string.IsNullOrWhiteSpace(MaxHeight)) parts.Add($"max-height:{MaxHeight}");
            return parts.Count == 0 ? null : string.Join(';', parts);
        }
    }

    private string RootClass =>
        "m-scroll" + (string.IsNullOrWhiteSpace(Class) ? "" : $" {Class}");
}
