@namespace AuthWithAdmin.Client.Components

@*
    MAccordionItem — one bounded management entity that edits in place.

    WHY THIS EXISTS
    The Management screens list entities whose detail is edited inline (a team's
    mentor assignment, a milestone's dates). Before this component the row was a
    bare `border-bottom` and the expanded content was appended straight onto the
    panel's white surface with only a hairline above it, so the open body did not
    read as belonging to the row that opened it.

    THE CONTRACT
    Head and body live inside ONE bounded surface with overflow:hidden, and the
    open tint is applied to the WHOLE item rather than only its head — that split
    was the specific reason the previous treatment looked like unrelated content
    inserted into the page.

    DENSITY
    The head is a 48px row, not a card. An administrator scanning 100 teams sees
    ~14 per viewport; a card-per-entity treatment shows ~6.

    RTL
    The chevron is a single downward glyph ROTATED 180deg when open, so it carries
    no direction and needs no mirroring. Everything else uses logical properties.
*@

<div class="@RootClass">
    <div class="m-acc-head">
        <button type="button"
                class="m-acc-toggle"
                aria-expanded="@(Open ? "true" : "false")"
                aria-label="@AriaLabel"
                disabled="@Disabled"
                @onclick="HandleToggleAsync">

            @if (Leading is not null)
            {
                <span class="m-acc-lead">@Leading</span>
            }

            <span class="m-acc-main">
                <span class="m-acc-primary">@Primary</span>
                @if (!string.IsNullOrWhiteSpace(Secondary))
                {
                    <span class="m-acc-secondary">@Secondary</span>
                }
            </span>

            @if (MetaContent is not null)
            {
                <span class="m-acc-meta">@MetaContent</span>
            }

            @if (Status is not null)
            {
                <span class="m-acc-status">@Status</span>
            }

            <span class="m-acc-chevron" aria-hidden="true">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="m6 9 6 6 6-6"></path>
                </svg>
            </span>
        </button>

        @* Actions sit BESIDE the toggle, never inside it — a button may not
           contain another button, and nesting them silently breaks the row. *@
        @if (Actions is not null)
        {
            <div class="m-acc-actions">@Actions</div>
        }
    </div>

    @if (Open)
    {
        <div class="m-acc-body">@ChildContent</div>
    }
</div>

@code {
    /// <summary>Whether the body is shown. The caller owns this state — the
    /// component never holds its own, so a page can enforce "one open at a
    /// time" (which every current caller does) without fighting it.</summary>
    [Parameter] public bool Open { get; set; }

    [Parameter] public EventCallback OnToggle { get; set; }

    /// <summary>Start slot — status dot, order badge, avatar, file glyph.</summary>
    [Parameter] public RenderFragment? Leading { get; set; }

    [Parameter, EditorRequired] public string Primary { get; set; } = "";

    /// <summary>The quiet supporting line under <see cref="Primary"/>.</summary>
    [Parameter] public string? Secondary { get; set; }

    /// <summary>Useful secondary information that belongs to the entity and
    /// should stay spatially near it — assigned mentors, a date range.
    ///
    /// <para>Named MetaContent, not Meta: Razor's HTML parser treats a
    /// &lt;Meta&gt; tag as the void element &lt;meta&gt; and self-closes it, so a
    /// &lt;/Meta&gt; end tag never matches and the whole component fails to
    /// parse.</para></summary>
    [Parameter] public RenderFragment? MetaContent { get; set; }

    /// <summary>Status badge / count tag slot.</summary>
    [Parameter] public RenderFragment? Status { get; set; }

    /// <summary>Trailing controls rendered beside the toggle.</summary>
    [Parameter] public RenderFragment? Actions { get; set; }

    /// <summary>The expanded content.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    [Parameter] public bool Disabled { get; set; }

    /// <summary>Accessible name for the toggle when <see cref="Primary"/> alone
    /// would not identify it.</summary>
    [Parameter] public string? AriaLabel { get; set; }

    [Parameter] public string? Class { get; set; }

    private string RootClass =>
        "m-acc"
        + (Open ? " m-acc-open" : "")
        + (Disabled ? " m-acc-disabled" : "")
        + (string.IsNullOrWhiteSpace(Class) ? "" : $" {Class}");

    private async Task HandleToggleAsync()
    {
        if (Disabled) return;
        if (OnToggle.HasDelegate) await OnToggle.InvokeAsync();
    }
}
