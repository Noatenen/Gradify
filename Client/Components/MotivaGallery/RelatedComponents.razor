@namespace AuthWithAdmin.Client.Components.MotivaGallery

@* Real navigation to other component pages in this gallery — the
   relationships passed in must reflect actual composition patterns
   already shown elsewhere (e.g. the hero showcase, MModal's FooterContent
   examples), never an invented pairing. *@

<nav class="related-components" aria-label="קומפוננטות קשורות">
    @for (var i = 0; i < Items.Count; i++)
    {
        var item = Items[i];
        <a href="@item.Route" class="related-chip">@item.Name</a>
        @if (i < Items.Count - 1)
        {
            <span class="related-arrow oi oi-chevron-left" aria-hidden="true"></span>
        }
    }
</nav>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<(string Name, string Route)> Items { get; set; } = Array.Empty<(string, string)>();
}
