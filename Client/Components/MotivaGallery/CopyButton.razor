@namespace AuthWithAdmin.Client.Components.MotivaGallery
@inject IJSRuntime JS

@* Reuses the existing window.gradify.copyToClipboard JS helper
   (Client/wwwroot/js/gradify-interop.js) — no new JavaScript is introduced. *@

<button type="button"
        class="copy-btn @(Compact ? "copy-btn-compact" : "") @(_copied ? "copy-btn-copied" : "")"
        aria-label="@(_copied ? "הועתק" : AriaLabel)"
        @onclick="CopyAsync">
    <span class="oi @(_copied ? "oi-check" : "oi-clipboard")" aria-hidden="true"></span>
</button>
<span class="copy-btn-announce" aria-live="polite">@(_copied ? "הועתק" : "")</span>

@code {
    [Parameter, EditorRequired] public string Value { get; set; } = "";
    [Parameter] public string AriaLabel { get; set; } = "העתקה";

    /// <summary>Smaller footprint for tight inline contexts (e.g. a
    /// TokenSwatch chip) vs. the default size used next to a code block's
    /// header bar.</summary>
    [Parameter] public bool Compact { get; set; }

    private bool _copied;

    private async Task CopyAsync()
    {
        var ok = await JS.InvokeAsync<bool>("gradify.copyToClipboard", Value);
        if (!ok) return;

        _copied = true;
        StateHasChanged();
        await Task.Delay(1300);
        _copied = false;
        StateHasChanged();
    }
}
