@namespace AuthWithAdmin.Client.Components.MotivaGallery

@* Shared page header for the component documentation pages — extracted in
   Phase 4.2 so the identical title/subtitle/purpose markup and CSS lives
   once instead of being copy-pasted across all five component pages. *@

<h1 class="doc-header-title">
    @Title
    @if (!string.IsNullOrWhiteSpace(TitleSub))
    {
        <span class="doc-header-sub">@TitleSub</span>
    }
</h1>
<p class="doc-header-purpose">@ChildContent</p>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter] public string? TitleSub { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
