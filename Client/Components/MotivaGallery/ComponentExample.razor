@namespace AuthWithAdmin.Client.Components.MotivaGallery

<div class="component-example @(Emphasis ? "component-example-emphasis" : "") @Class">
    @if (!string.IsNullOrWhiteSpace(Title))
    {
        <div class="component-example-label">@Title</div>
    }
    <div class="component-example-stage @(Center ? "component-example-center" : "")">
        @ChildContent
    </div>
</div>

@code {
    [Parameter] public string? Title { get; set; }
    [Parameter] public bool Center { get; set; } = true;

    /// <summary>Gives the stage a larger, elevated "spotlight" treatment —
    /// used by the Playground, where the preview should read as the star of
    /// the page rather than one demo among many.</summary>
    [Parameter] public bool Emphasis { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
