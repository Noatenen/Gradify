@namespace AuthWithAdmin.Client.Components.MotivaGallery
@using AuthWithAdmin.Client.Components.MotivaGallery

@* PreviewStyle must always be one or more CSS declarations that reference a
   --motiva-* custom property via var(...) — e.g. "background: var(--motiva-color-purple);"
   or "box-shadow: var(--motiva-shadow-lg);". This is how the gallery can show
   what a token currently resolves to without ever hardcoding the literal
   value here — the swatch is a live reflection of the token, not a second
   source of truth for it. *@
<div class="token-swatch">
    <div class="token-swatch-preview" style="@PreviewStyle" aria-hidden="true"></div>
    <div class="token-swatch-meta">
        <strong>@Name</strong>
        <span class="token-swatch-chip">
            <code>@TokenName</code>
            <CopyButton Value="@TokenName" AriaLabel="@($"העתקת {TokenName}")" Compact="true" />
        </span>
    </div>
</div>

@code {
    [Parameter] public string Name { get; set; } = "";
    [Parameter] public string TokenName { get; set; } = "";
    [Parameter] public string PreviewStyle { get; set; } = "";
}
