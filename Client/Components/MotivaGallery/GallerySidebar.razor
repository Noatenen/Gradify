@namespace AuthWithAdmin.Client.Components.MotivaGallery
@inject NavigationManager Nav

<aside class="gallery-sidebar">
    <div class="gallery-brand">
        <div class="gallery-brand-mark" aria-hidden="true"></div>
        <div class="gallery-brand-text">
            <strong>Motiva</strong>
            <span>Component Gallery</span>
        </div>
    </div>

    <div class="gallery-dev-flag">
        <MStatusBadge Variant="MStatusBadge.BadgeVariant.Warning" Icon="oi-warning">
            כלי פיתוח בלבד — Development only
        </MStatusBadge>
    </div>

    <div class="gallery-search">
        <span class="oi oi-magnifying-glass gallery-search-icon" aria-hidden="true"></span>
        <input type="search"
               class="gallery-search-input"
               placeholder="חיפוש ברכיבים ובתיעוד…"
               aria-label="חיפוש בגלריית Motiva"
               value="@_query"
               @oninput="OnSearchInput"
               @onkeydown="OnSearchKeyDown" />
        @if (!string.IsNullOrWhiteSpace(_query))
        {
            <button type="button" class="gallery-search-clear" aria-label="ניקוי חיפוש" @onclick="ClearSearch">
                <span class="oi oi-x" aria-hidden="true"></span>
            </button>
        }
    </div>

    <nav class="gallery-nav">
        @if (Matches(_topEntry))
        {
            <NavLink href="@_topEntry.Route" Match="NavLinkMatch.All" class="gallery-nav-link gallery-nav-top">@_topEntry.Label</NavLink>
        }

        @if (_foundationsVisible.Count > 0)
        {
            <div class="gallery-group-title">Foundations</div>
            <div class="gallery-subnav">
                @foreach (var item in _foundationsVisible)
                {
                    <a href="@item.Route">@item.Label</a>
                }
            </div>
        }

        @if (_componentsVisible.Count > 0)
        {
            <div class="gallery-group-title">Components</div>
            <div class="gallery-subnav">
                @foreach (var item in _componentsVisible)
                {
                    <NavLink class="gallery-subnav-link" href="@item.Route">@item.Label</NavLink>
                }
            </div>
        }

        @if (Matches(_playgroundEntry))
        {
            <NavLink href="@_playgroundEntry.Route" class="gallery-nav-link gallery-nav-top">@_playgroundEntry.Label</NavLink>
        }
        @if (Matches(_changelogEntry))
        {
            <NavLink href="@_changelogEntry.Route" class="gallery-nav-link gallery-nav-top">@_changelogEntry.Label</NavLink>
        }

        @if (string.IsNullOrWhiteSpace(_query))
        {
            <div class="gallery-group-title">Patterns &amp; Templates</div>
            <div class="gallery-subnav gallery-subnav-disabled" aria-disabled="true">
                <span>Patterns <em>— Coming later</em></span>
                <span>Templates <em>— Coming later</em></span>
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(_query) && !_hasAnyMatch)
        {
            <p class="gallery-search-empty" aria-live="polite">אין תוצאות עבור "@_query"</p>
        }
    </nav>
</aside>

@code {
    private sealed record NavEntry(string Label, string Route);

    private static readonly NavEntry _topEntry = new("מבוא · Getting Started", "/motiva");
    private static readonly NavEntry _playgroundEntry = new("Playground", "/motiva/playground");
    private static readonly NavEntry _changelogEntry = new("Changelog", "/motiva/changelog");

    private static readonly NavEntry[] _foundationsEntries =
    {
        new("Colors", "/motiva/foundations#colors"),
        new("Gradients", "/motiva/foundations#gradients"),
        new("Typography", "/motiva/foundations#typography"),
        new("Spacing", "/motiva/foundations#spacing"),
        new("Radius", "/motiva/foundations#radius"),
        new("Shadows", "/motiva/foundations#shadows"),
        new("Motion", "/motiva/foundations#motion"),
        new("Accessibility", "/motiva/foundations#accessibility"),
        new("RTL", "/motiva/foundations#rtl"),
    };

    private static readonly NavEntry[] _componentsEntries =
    {
        new("Button", "/motiva/components/button"),
        new("Card", "/motiva/components/card"),
        new("Status Badge", "/motiva/components/status-badge"),
        new("Progress Bar", "/motiva/components/progress-bar"),
        new("Modal", "/motiva/components/modal"),
    };

    private string _query = "";

    private List<NavEntry> _foundationsVisible = _foundationsEntries.ToList();
    private List<NavEntry> _componentsVisible = _componentsEntries.ToList();

    private bool _hasAnyMatch = true;

    private bool Matches(NavEntry e) =>
        string.IsNullOrWhiteSpace(_query) || e.Label.Contains(_query, StringComparison.OrdinalIgnoreCase);

    private void OnSearchInput(ChangeEventArgs e)
    {
        _query = e.Value?.ToString() ?? "";
        Refilter();
    }

    private void ClearSearch()
    {
        _query = "";
        Refilter();
    }

    private void Refilter()
    {
        _foundationsVisible = _foundationsEntries.Where(Matches).ToList();
        _componentsVisible = _componentsEntries.ToList().Where(Matches).ToList();
        _hasAnyMatch = Matches(_topEntry) || Matches(_playgroundEntry) || Matches(_changelogEntry)
                       || _foundationsVisible.Count > 0 || _componentsVisible.Count > 0;
    }

    private void OnSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            ClearSearch();
            return;
        }

        if (e.Key != "Enter") return;

        var first = FirstMatch();
        if (first is not null) Nav.NavigateTo(first.Route);
    }

    private NavEntry? FirstMatch()
    {
        if (Matches(_topEntry)) return _topEntry;
        var foundation = _foundationsEntries.FirstOrDefault(Matches);
        if (foundation is not null) return foundation;
        var component = _componentsEntries.FirstOrDefault(Matches);
        if (component is not null) return component;
        if (Matches(_playgroundEntry)) return _playgroundEntry;
        if (Matches(_changelogEntry)) return _changelogEntry;
        return null;
    }
}
