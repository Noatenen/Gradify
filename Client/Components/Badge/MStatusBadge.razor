@namespace AuthWithAdmin.Client.Components

@if (HasContent)
{
    <span class="@RootClass">
        @if (!string.IsNullOrWhiteSpace(Icon))
        {
            <span class="oi @Icon m-badge-icon" aria-hidden="true"></span>
        }
        <span class="m-badge-text">
            @if (ChildContent is not null)
            {
                @ChildContent
            }
            else
            {
                @Text
            }
        </span>
    </span>
}

@code {
    /// <summary>
    /// Canonical set (Motiva System Master): <c>Neutral</c> plus exactly three
    /// semantics — <c>Violet</c> (focus/action/in-progress), <c>Teal</c>
    /// (progress/completion), <c>Rose</c> (attention). The Master: "never
    /// introduce a fourth."
    ///
    /// <para><b>Legacy members.</b> <c>Info</c>, <c>Success</c>, <c>Warning</c>
    /// and <c>Danger</c> predate the Master and are still used by existing
    /// callers across every role, so they remain. Inside the
    /// <c>.motiva</c> scope they already resolve onto the permitted
    /// three (Phase 1 folded the tokens: info→violet, success→teal,
    /// warning/danger→rose), so they are visually correct today — they are
    /// simply named for the old system.</para>
    ///
    /// <para><b>Migration path.</b> New Student code uses the canonical four.
    /// Existing callers migrate Info→Violet, Success→Teal, Warning→Rose,
    /// Danger→Rose as their page is redesigned; the legacy members are removed
    /// only once no caller references them. New members are appended, never
    /// inserted, so no existing member's ordinal changes.</para>
    /// </summary>
    public enum BadgeVariant
    {
        Neutral,

        // ── Legacy (pre-Master) ────────────────────────────────
        Info,
        Success,
        Warning,
        Danger,

        // ── Canonical (Motiva System Master) ───────────────────
        Violet,
        Teal,
        Rose
    }

    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string? Text { get; set; }
    [Parameter] public BadgeVariant Variant { get; set; } = BadgeVariant.Neutral;

    /// <summary>Optional open-iconic modifier class, e.g. "oi-check" — matches
    /// the "oi @Icon" pattern already used across the app (AppSideNav,
    /// NotificationBell). The "oi" base class is added automatically.</summary>
    [Parameter] public string? Icon { get; set; }
    [Parameter] public string? Class { get; set; }

    // Color must always pair with visible text (MOTIVA_FOUNDATIONS.md). If a
    // caller forgets both Text and ChildContent, render nothing rather than an
    // empty colored pill with no accessible name.
    private bool HasContent => ChildContent is not null || !string.IsNullOrWhiteSpace(Text);

    private string RootClass =>
        $"m-badge m-badge-{Variant.ToString().ToLowerInvariant()}"
        + (string.IsNullOrWhiteSpace(Class) ? "" : $" {Class}");
}
