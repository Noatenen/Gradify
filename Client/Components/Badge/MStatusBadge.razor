@namespace AuthWithAdmin.Client.Components

@if (HasContent)
{
    <span class="@RootClass">
        @if (!string.IsNullOrWhiteSpace(Icon))
        {
            <span class="oi @Icon m-badge-icon" aria-hidden="true"></span>
        }
        <span class="m-badge-text">
            @if (ChildContent is not null)
            {
                @ChildContent
            }
            else
            {
                @Text
            }
        </span>
    </span>
}

@code {
    /// <summary>
    /// Canonical set (Motiva System Master): <c>Neutral</c> plus exactly three
    /// semantics — <c>Violet</c> (focus/action/in-progress), <c>Teal</c>
    /// (progress/completion), <c>Rose</c> (attention). The Master: "never
    /// introduce a fourth."
    ///
    /// <para><b>Legacy members.</b> <c>Info</c>, <c>Success</c>, <c>Warning</c>
    /// and <c>Danger</c> predate the Master and are still used by existing
    /// callers across every role, so they remain. Inside the
    /// <c>.motiva</c> scope they already resolve onto the permitted
    /// three (Phase 1 folded the tokens: info→violet, success→teal,
    /// warning/danger→rose), so they are visually correct today — they are
    /// simply named for the old system.</para>
    ///
    /// <para><b>Migration path.</b> New Student code uses the canonical four.
    /// Existing callers migrate Info→Violet, Success→Teal, Warning→Rose,
    /// Danger→Rose as their page is redesigned; the legacy members are removed
    /// only once no caller references them. New members are appended, never
    /// inserted, so no existing member's ordinal changes.</para>
    /// </summary>
    public enum BadgeVariant
    {
        Neutral,

        // ── Legacy (pre-Master) ────────────────────────────────
        Info,
        Success,
        Warning,
        Danger,

        // ── Canonical (Motiva System Master) ───────────────────
        Violet,
        Teal,
        Rose,

        /// <summary>
        /// The middle rung of a waiting-age ladder: past "just arrived" and
        /// not yet escalated. Drawn as a translucent sweep of the signature
        /// gradient with dark ink — the same treatment
        /// <c>.motiva-count</c> gives a count bubble.
        ///
        /// <para><b>Why a fourth semantic was needed.</b> Neutral and Rose can
        /// only say "fine" and "escalated", so an item one day from the
        /// product's attention threshold looked exactly like one that arrived
        /// this morning. This is the rung between them, and it exists because
        /// <see cref="MentorAttentionAge"/> already has three states while the
        /// badge had two.</para>
        ///
        /// <para>Appended, never inserted, so no existing member's ordinal
        /// moves.</para></summary>
        Approaching,

        /// <summary>
        /// The top rung of a WAITING ladder — something has been waiting long
        /// enough to want a person, and is still not late.
        ///
        /// <para><b>Why this is not Rose.</b> Rose means a real deadline has
        /// passed. A submission and a request have no deadline anywhere in
        /// their models (see MentorAttentionDto: "There is no SLA and no review
        /// deadline in this product"), so colouring a three-day-old request red
        /// asserts a fact the product does not hold. This carries the emphasis
        /// without the claim: the same brand tint as
        /// <see cref="Approaching"/> at a heavier alpha, plus a ring.</para>
        ///
        /// <para>Appended, never inserted.</para></summary>
        Attention
    }

    /// <summary>
    /// <c>Medium</c> — the default chip: the type tag on an attention item, a
    /// health chip, a status chip.
    ///
    /// <para><c>Small</c> — the TIME chip. The mentor dashboard draws a
    /// deadline, a waiting age or an overdue duration on a visibly smaller
    /// pill than a type tag, so that "45 ימים" reads as an annotation on the
    /// row rather than as a second label competing with it. Its metrics are
    /// transcribed from that screen's own `.mh-task-due` / `.mh-attn-time-late`
    /// — see the stylesheet beside this file.</para>
    /// </summary>
    public enum BadgeSize { Medium, Small }

    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string? Text { get; set; }
    [Parameter] public BadgeVariant Variant { get; set; } = BadgeVariant.Neutral;
    [Parameter] public BadgeSize Size { get; set; } = BadgeSize.Medium;

    /// <summary>Optional open-iconic modifier class, e.g. "oi-check" — matches
    /// the "oi @Icon" pattern already used across the app (AppSideNav,
    /// NotificationBell). The "oi" base class is added automatically.</summary>
    [Parameter] public string? Icon { get; set; }
    [Parameter] public string? Class { get; set; }

    // Color must always pair with visible text (MOTIVA_FOUNDATIONS.md). If a
    // caller forgets both Text and ChildContent, render nothing rather than an
    // empty colored pill with no accessible name.
    private bool HasContent => ChildContent is not null || !string.IsNullOrWhiteSpace(Text);

    private string RootClass =>
        $"m-badge m-badge-{Variant.ToString().ToLowerInvariant()}"
        // Medium adds no class at all, so every existing caller renders the
        // exact markup it did before this parameter existed.
        + (Size == BadgeSize.Small ? " m-badge-small" : "")
        + (string.IsNullOrWhiteSpace(Class) ? "" : $" {Class}");
}
