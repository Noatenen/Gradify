@namespace AuthWithAdmin.Client.Components

@*
    MStatusDot — the Master's 7px semantic dot.

    Master: "Three semantic colors only — violet / teal / rose — never
    introduce a fourth." Violet = active/in-progress, Teal = complete/
    on-track, Rose = attention/blocked. The enum has exactly those three
    members, so a fourth cannot be added by a caller.

    Two rendering modes, both accessible:
      • with Label  → dot + its label in the same semantic colour (the
        Master's inline status pattern). The dot is decorative; the label
        carries the meaning.
      • without Label → a bare dot, aria-hidden by default. It becomes an
        announced element only if the caller passes AriaLabel, i.e. only
        when the dot really is the sole carrier of a status.
*@

@if (HasLabel)
{
    <span class="@RootClass">
        <span class="m-dot" aria-hidden="true"></span>
        <span class="m-dot-label">@Label</span>
    </span>
}
else
{
    <span class="@RootClass"
          role="@(string.IsNullOrWhiteSpace(AriaLabel) ? null : "img")"
          aria-label="@AriaLabel"
          aria-hidden="@(string.IsNullOrWhiteSpace(AriaLabel) ? "true" : null)"></span>
}

@code {
    /// <summary>The Master's canonical semantic set. Deliberately closed.</summary>
    public enum DotTone { Violet, Teal, Rose }

    [Parameter] public DotTone Tone { get; set; } = DotTone.Violet;

    /// <summary>Optional visible text next to the dot, drawn in the same
    /// semantic colour. Preferred over <see cref="AriaLabel"/>: a visible
    /// label serves every user, not only screen-reader users.</summary>
    [Parameter] public string? Label { get; set; }

    /// <summary>Accessible name for a bare dot that carries meaning on its own
    /// (e.g. a status marker inside a dense row that has no room for text).
    /// Ignored when <see cref="Label"/> is set.</summary>
    [Parameter] public string? AriaLabel { get; set; }

    /// <summary>The Master's attention ring — a slow expanding halo used on
    /// the "requires attention" dot only. Never decorative. Fully disabled
    /// under prefers-reduced-motion.</summary>
    [Parameter] public bool Pulse { get; set; }

    [Parameter] public string? Class { get; set; }

    private bool HasLabel => !string.IsNullOrWhiteSpace(Label);

    private string ToneClass => $"m-dot-{Tone.ToString().ToLowerInvariant()}";

    private string RootClass =>
        (HasLabel ? "m-dot-row " : "m-dot ")
        + ToneClass
        + (Pulse ? " m-dot-pulse" : "")
        + (string.IsNullOrWhiteSpace(Class) ? "" : $" {Class}");
}
