@namespace AuthWithAdmin.Client.Components

<div class="@RootClass">
    @if (!string.IsNullOrWhiteSpace(Label) || ShowValue)
    {
        <div class="m-progress-header">
            @if (!string.IsNullOrWhiteSpace(Label))
            {
                <span class="m-progress-label">@Label</span>
            }
            @if (ShowValue)
            {
                <span class="m-progress-value-text">@Percent%</span>
            }
        </div>
    }
    @* Approved exception (per Phase 3 spec): the fill's width is data, not a
       design token, so it is expressed as a narrowly-scoped CSS custom
       property on this element rather than a literal inline style width or
       a generated per-percentage class. MProgressBar.razor.css reads it via
       width: var(--m-progress-percent). *@
    <div class="m-progress-track"
         role="progressbar"
         aria-valuemin="0"
         aria-valuemax="@SafeMax.ToString(System.Globalization.CultureInfo.InvariantCulture)"
         aria-valuenow="@SafeValue.ToString(System.Globalization.CultureInfo.InvariantCulture)"
         aria-label="@(string.IsNullOrWhiteSpace(AccessibleLabel) ? Label : AccessibleLabel)"
         style="--m-progress-percent: @(Percent.ToString(System.Globalization.CultureInfo.InvariantCulture))%">
        <div class="m-progress-fill"></div>
    </div>
</div>

@code {
    public enum ProgressSize { Small, Medium, Large }

    [Parameter] public double Value { get; set; }
    [Parameter] public double Max { get; set; } = 100;
    [Parameter] public string? Label { get; set; }
    [Parameter] public bool ShowValue { get; set; }
    [Parameter] public string? AccessibleLabel { get; set; }
    [Parameter] public ProgressSize Size { get; set; } = ProgressSize.Medium;
    [Parameter] public string? Class { get; set; }

    private double SafeMax => Max > 0 && !double.IsNaN(Max) && !double.IsInfinity(Max) ? Max : 100;

    private double SafeValue
    {
        get
        {
            if (double.IsNaN(Value) || double.IsInfinity(Value)) return 0;
            return Math.Clamp(Value, 0, SafeMax);
        }
    }

    private int Percent => (int)Math.Round(SafeValue / SafeMax * 100, MidpointRounding.AwayFromZero);

    private string RootClass =>
        $"m-progress m-progress-{Size.ToString().ToLowerInvariant()}"
        + (string.IsNullOrWhiteSpace(Class) ? "" : $" {Class}");
}
