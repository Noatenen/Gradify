@namespace AuthWithAdmin.Client.Components

@*
    StudentRegistrationLink — the student-facing assignment/registration form
    link, and the one control that hands it to somebody.

    WHY THIS IS A COMPONENT
    The same action is needed in two places: on the Management hub, beside
    "שיבוץ צוותים לפרויקטים", and later on the assignment screen itself. The URL
    is derived from the app's own base address, so a second caller writing
    `Nav.BaseUri + "/create-team"` for itself would be a second source of truth
    that can silently drift. Deriving it HERE means there is exactly one, and a
    caller only places the component.

    IT IS PRESENTATION, AND NOTHING MORE. No service, no state that outlives the
    component, no parameters a caller has to get right — the whole contract is
    "render this action wherever it belongs". Behaviour is the hub's previous
    copy handler, moved verbatim.
*@

@inject NavigationManager Nav
@inject IJSRuntime        JS

<div class="srl @Class">
    <span class="srl-label" title="@Url">@Label</span>

    <button type="button"
            class="srl-copy @(_copied ? "srl-copied" : "")"
            @onclick="CopyAsync"
            aria-label="@($"{Label} — העתקת קישור")">
        @if (_copied)
        {
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M20 6 9 17l-5-5"></path>
            </svg>
            <span>הועתק</span>
        }
        else
        {
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="9" y="9" width="13" height="13" rx="2"></rect>
                <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
            </svg>
            <span>העתקת לינק</span>
        }
    </button>
</div>

@code {
    /// <summary>What the link is called where it is shown. Defaulted rather than
    /// required, so the common case is a bare &lt;StudentRegistrationLink /&gt;.</summary>
    [Parameter] public string Label { get; set; } = "לינק טופס שיבוצים לסטודנטים";

    /// <summary>Positioning only — the caller owns where this sits, the
    /// component owns what it looks like.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>THE source of truth for the student form's address. Anything
    /// that needs this URL renders this component rather than rebuilding it.</summary>
    private string Url => Nav.BaseUri.TrimEnd('/') + "/create-team";

    private bool _copied;

    private async Task CopyAsync()
    {
        // Guarded: navigator.clipboard is undefined on a non-secure origin and
        // an unhandled interop throw surfaces as a Blazor error overlay.
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", Url);
            _copied = true;
        }
        catch
        {
            return;
        }

        StateHasChanged();
        await Task.Delay(2500);
        _copied = false;
    }
}
