@namespace AuthWithAdmin.Client.Pages.Planning

@*
    PlanningMonthGrid — the final Calendar's month view
    (Motiva Student Calendar final.dc.html, MONTH VIEW).

    Carried over at the reference's own values: a 7-column grid under a
    borderless day-name strip, 104px cells ruled on their block-end and
    inline-end only (the grid closes itself with a block-start + inline-start
    rule), neighbouring-month days on a 1.5% ink wash, today's cell on a 3.5%
    violet wash with its date as a violet pill, and a three-item cap with
    "+N נוספים" that expands the day in place.

    MCard is the reference's section surface — under .motiva-student it already
    resolves to rgba(255,255,255,.66) on a .85 white edge at r24 with the
    section shadow (MCard.razor.css §.motiva-student). Only the reference's
    18px/20px inner padding is added here, which is why the card keeps
    Padding="None".

    The reference's per-cell "+" add-hint is NOT carried over. It opened the
    event form, which has no backing table; a hover affordance that creates a
    team task on an arbitrary day would be a different promise than the one
    drawn.
*@

<MCard Padding="MCard.CardPadding.None">
    <div class="pl-month">

        <div class="pl-month-head">
            @foreach (var name in DayNames)
            {
                <div class="pl-month-dayname">@name</div>
            }
        </div>

        <div class="pl-month-body">
            @foreach (var cell in Cells)
            {
                var expanded = _expandedDay == cell.Date;
                var shown    = cell.InMonth && !expanded && cell.Items.Count > Cap
                    ? cell.Items.Take(Cap).ToList()
                    : cell.Items;
                var hidden   = cell.Items.Count - shown.Count;

                <div class="pl-daycell @(cell.InMonth ? "" : "pl-daycell-dim") @(cell.IsToday ? "pl-daycell-today" : "")">

                    @* ── Click-to-create ──
                       A real <button> filling the cell BEHIND its content, not an
                       @onclick on the cell div: it is focusable, reachable by Tab
                       and operable with Enter/Space for free, which a clickable
                       div would each have to re-implement.

                       Chips and the "+N" control sit above it in the stacking
                       order and stop propagation themselves, so a click on an
                       existing item opens that item and never creates.

                       In-month days only — a trailing cell belongs to a month the
                       grid is not showing, and seeding the form with it would put
                       the task somewhere the student cannot see it. *@
                    @if (cell.InMonth)
                    {
                        <button type="button" class="pl-daycell-add"
                                aria-label="@($"יצירת משימת צוות ל־{cell.Date:d.M.yyyy}")"
                                @onclick="() => OnCreateAt.InvokeAsync(new PlanningSlot(cell.Date))">
                        </button>
                    }

                    <span class="pl-daynum @(cell.IsToday ? "pl-daynum-today" : "")">@cell.Date.Day</span>

                    <div class="pl-daycell-items">
                        @foreach (var item in shown)
                        {
                            <PlanningItemChip Item="@item" OnOpen="OnOpenItem" />
                        }

                        @if (hidden > 0)
                        {
                            <button type="button" class="pl-more"
                                    @onclick="() => _expandedDay = cell.Date"
                                    @onclick:stopPropagation="true">
                                +@hidden נוספים
                            </button>
                        }
                        else if (expanded && cell.Items.Count > Cap)
                        {
                            <button type="button" class="pl-more"
                                    @onclick="() => _expandedDay = null"
                                    @onclick:stopPropagation="true">
                                הצג פחות
                            </button>
                        }
                    </div>
                </div>
            }
        </div>

    </div>
</MCard>

@code {
    /// <summary>Any date inside the month being shown.</summary>
    [Parameter, EditorRequired] public DateTime Anchor { get; set; }

    /// <summary>Already filtered by the page — this component never filters.</summary>
    [Parameter] public IReadOnlyList<PlanningItem> Items { get; set; } = Array.Empty<PlanningItem>();

    [Parameter] public EventCallback<PlanningItem> OnOpenItem { get; set; }

    /// <summary>Raised when the student clicks EMPTY space in a day cell. The
    /// page turns it into the existing create-task modal, seeded with the day.</summary>
    [Parameter] public EventCallback<PlanningSlot> OnCreateAt { get; set; }

    /// <summary>Three, the reference's own cap (`items.slice(0, 3)`), which its
    /// 104px cell is sized around.</summary>
    private const int Cap = 3;

    private DateTime? _expandedDay;

    private static readonly string[] DayNames =
        { "ראשון", "שני", "שלישי", "רביעי", "חמישי", "שישי", "שבת" };

    /// <summary>Reset the expanded day whenever the month changes — an expanded
    /// cell from August should not stay expanded after stepping to September.</summary>
    private DateTime _lastAnchorMonth;

    protected override void OnParametersSet()
    {
        var month = new DateTime(Anchor.Year, Anchor.Month, 1);
        if (month != _lastAnchorMonth)
        {
            _lastAnchorMonth = month;
            _expandedDay     = null;
        }
    }

    private sealed record Cell(DateTime Date, bool InMonth, bool IsToday, List<PlanningItem> Items);

    private List<Cell> Cells
    {
        get
        {
            var first = new DateTime(Anchor.Year, Anchor.Month, 1);

            // Sunday-first, matching the Design's ראשון…שבת header.
            // DayOfWeek.Sunday == 0, so the leading offset is the raw value.
            var gridStart = first.AddDays(-(int)first.DayOfWeek);

            // Whole weeks until the month is covered — 5 rows most months,
            // 6 when the month overflows. The Design draws 6; deriving it
            // avoids a permanently empty trailing row in shorter months.
            var last      = first.AddMonths(1).AddDays(-1);
            var gridEnd   = last.AddDays(6 - (int)last.DayOfWeek);
            var total     = (gridEnd - gridStart).Days + 1;

            var byDate = Items
                .GroupBy(i => i.Date)
                .ToDictionary(g => g.Key, g => g.OrderBy(i => i.IsDone)
                                                .ThenBy(i => (int)i.Kind)
                                                .ToList());

            var cells = new List<Cell>(total);
            for (int k = 0; k < total; k++)
            {
                var d = gridStart.AddDays(k);
                bool inMonth = d.Month == first.Month && d.Year == first.Year;
                cells.Add(new Cell(
                    d,
                    inMonth,
                    d.Date == DateTime.Today,
                    inMonth && byDate.TryGetValue(d.Date, out var list) ? list : new List<PlanningItem>()));
            }
            return cells;
        }
    }
}
