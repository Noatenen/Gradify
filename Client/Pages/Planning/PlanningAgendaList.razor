@namespace AuthWithAdmin.Client.Pages.Planning

@*
    PlanningAgendaList — the <768px presentation for Month and Week.

    Not a shrunken grid. Seven columns under ~110px cannot hold a Hebrew task
    title, and the alternative — reducing type below the System Master's
    values — is explicitly out of bounds. So the calendar becomes a list:
    same PlanningItems, same filters, same chips, ordered by date with named
    day headers.

    Days with nothing due are omitted entirely rather than rendered empty —
    on a phone, scrolling past blank days is the cost, not the quiet.
*@

<div class="pl-agenda">
    @if (Days.Count == 0)
    {
        <MEmptyState Title="@EmptyTitle" Description="@EmptyDescription" Live="true" />
    }
    else
    {
        @foreach (var day in Days)
        {
            <section class="pl-agenda-day @(day.IsToday ? "pl-agenda-day-today" : "")">
                <header class="pl-agenda-head">
                    <span class="pl-agenda-date">@day.Date.ToString("dd.MM")</span>
                    <span class="pl-agenda-name">@day.Label</span>
                    <span class="pl-agenda-count">@day.Items.Count</span>
                </header>
                <div class="pl-agenda-items">
                    @foreach (var item in day.Items)
                    {
                        <PlanningItemChip Item="@item" Relaxed="true" OnOpen="OnOpenItem" />
                    }
                </div>
            </section>
        }
    }
</div>

@code {
    /// <summary>Inclusive window start — the page passes the month or week span
    /// that the active view would have shown.</summary>
    [Parameter, EditorRequired] public DateTime RangeStart { get; set; }

    /// <summary>Inclusive window end.</summary>
    [Parameter, EditorRequired] public DateTime RangeEnd { get; set; }

    [Parameter] public IReadOnlyList<PlanningItem> Items { get; set; } = Array.Empty<PlanningItem>();

    [Parameter] public EventCallback<PlanningItem> OnOpenItem { get; set; }

    [Parameter] public string EmptyTitle       { get; set; } = "אין פריטים בתקופה הזו";
    [Parameter] public string EmptyDescription { get; set; } = "נסי לעבור לתקופה אחרת או לשנות את הסינון.";

    private static readonly string[] DayNames =
        { "יום ראשון", "יום שני", "יום שלישי", "יום רביעי", "יום חמישי", "יום שישי", "שבת" };

    private sealed record Day(DateTime Date, string Label, bool IsToday, List<PlanningItem> Items);

    private List<Day> Days =>
        Items
            .Where(i => i.Date >= RangeStart.Date && i.Date <= RangeEnd.Date)
            .GroupBy(i => i.Date)
            .OrderBy(g => g.Key)
            .Select(g => new Day(
                g.Key,
                LabelFor(g.Key),
                g.Key == DateTime.Today,
                g.OrderBy(i => i.IsDone).ThenBy(i => (int)i.Kind).ToList()))
            .ToList();

    private static string LabelFor(DateTime d) => (d - DateTime.Today).Days switch
    {
        0 => "היום",
        1 => "מחר",
        _ => DayNames[(int)d.DayOfWeek]
    };
}
