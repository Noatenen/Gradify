@namespace AuthWithAdmin.Client.Pages.Planning

@*
    PlanningItemChip — the Design's `.itemchip` (Motiva Calendar.dc.html:17–18).

    One chip shape shared by Month, Week and the mobile Agenda, so the five
    planning types read identically wherever they appear. The Design's chip is
    icon + truncated title on a type tint; Dense adds nothing, Relaxed adds the
    status line the Week view has room for.
*@

<button type="button"
        class="pl-chip pl-k-@PlanningKinds.Slug(Item.Kind) @(Item.IsDone ? "pl-chip-done" : "") @(Item.IsOverdue ? "pl-chip-overdue" : "") @(Relaxed ? "pl-chip-relaxed" : "")"
        style="@PlanningKinds.PaletteStyle(Item.Kind)"
        title="@Tooltip"
        @onclick="HandleClick"
        @onclick:stopPropagation="true">

    <svg class="pl-chip-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor"
         stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="@PlanningKinds.IconPath(Item.Kind)"></path>
    </svg>

    <span class="pl-chip-text">
        <span class="pl-chip-title">@Item.Title</span>
        @if (Relaxed)
        {
            <span class="pl-chip-meta">@PlanningKinds.Label(Item.Kind) · @Item.StatusLabel</span>
        }
    </span>

    @if (Item.IsDone)
    {
        <svg class="pl-chip-check" viewBox="0 0 24 24" fill="none" stroke="currentColor"
             stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12.5 9.5 17 19 7"></path>
        </svg>
    }
</button>

@code {
    [Parameter, EditorRequired] public PlanningItem Item { get; set; } = default!;

    /// <summary>Week view: two lines (title + type · status). Month: one line.
    /// The Design's month cell caps at 104px with two chips, which leaves no
    /// room for a second line — the Week column has the height to spare.</summary>
    [Parameter] public bool Relaxed { get; set; }

    [Parameter] public EventCallback<PlanningItem> OnOpen { get; set; }

    private string Tooltip =>
        $"{PlanningKinds.Label(Item.Kind)} · {Item.Title} · {Item.Date:dd.MM.yyyy} · {Item.StatusLabel}";

    private Task HandleClick() => OnOpen.InvokeAsync(Item);
}
