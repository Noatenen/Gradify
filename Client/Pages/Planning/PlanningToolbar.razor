@namespace AuthWithAdmin.Client.Pages.Planning

@*
    PlanningToolbar — the final Calendar's control cluster
    (Motiva Student Calendar final.dc.html, TITLE + CONTROLS).

    It renders into MPageHeader's Actions slot, which is what puts it on the
    title row beside יומן ותכנון exactly as the reference draws it, instead of
    on a strip of its own below the header.

    THE REFERENCE'S THREE GROUPS, IN ITS ORDER
      1. view tabs      pill group on a 4.5% ink track
      2. period cluster a translucent white pill holding
                        next · label · prev · divider · היום
                        — the label sits BETWEEN the arrows, which is the one
                        structural difference from the earlier board, where it
                        trailed them
      3. primary action the gradient CTA

    DEVIATIONS, each forced by real data or by the shipped student side:
      • A third tab, "ציר זמן". The reference has month/week only; the
        timeline is working Motiva functionality and removing it to match a
        static file would delete a view students use.
      • Timeline swaps prev/next for a scope switch (כל הפרויקט | חודש) —
        there is no "next project" to step to.
      • The CTA keeps MButton's own radius rather than the reference's pill.
        Every primary on the shipped student side is a radius-sm gradient
        (motiva-base.css, .motiva-cta); making the calendar the single page
        with a pill CTA would break the consistency that matters more here
        than the one value.
*@

<div class="pl-toolbar">

    @* ── 1. View tabs ── *@
    <div class="pl-seg" role="group" aria-label="תצוגה">
        @foreach (var v in AllViews)
        {
            <button type="button"
                    class="pl-seg-btn @(View == v ? "pl-seg-on" : "")"
                    aria-pressed="@(View == v)"
                    @onclick="() => OnViewChange.InvokeAsync(v)">
                @ViewLabel(v)
            </button>
        }
    </div>

    @* ── 2. Period cluster ──
       Reference order: next, label, prev. Under RTL that puts "forward in
       time" at the reading start, which is the direction the month advances. *@
    @if (ShowPeriodNav)
    {
        <div class="pl-period-cluster">
            <button type="button" class="pl-navbtn" aria-label="תקופה הבאה" @onclick="OnNext">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"
                     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="m15 6-6 6 6 6"></path>
                </svg>
            </button>

            <span class="pl-period" dir="ltr">@PeriodLabel</span>

            <button type="button" class="pl-navbtn" aria-label="תקופה קודמת" @onclick="OnPrev">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"
                     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="m9 6 6 6-6 6"></path>
                </svg>
            </button>

            <span class="pl-period-div" aria-hidden="true"></span>

            <button type="button" class="pl-todaybtn" @onclick="OnToday">היום</button>
        </div>
    }
    else
    {
        <div class="pl-period-cluster pl-period-cluster-static">
            <span class="pl-period" dir="ltr">@PeriodLabel</span>
        </div>
    }

    @* Scope switch, Timeline only. Carries a visible "טווח:" label because it
       sits beside the view switch, which already has a חודש button — two
       adjacent segmented groups sharing a word are unreadable without it. *@
    @if (View == PlanningView.Timeline)
    {
        <div class="pl-scope">
            <span class="pl-scope-label">טווח:</span>
            <div class="pl-seg pl-seg-quiet" role="group" aria-label="טווח ציר הזמן">
                <button type="button"
                        class="pl-seg-btn @(TimelineFullSpan ? "pl-seg-on" : "")"
                        aria-pressed="@TimelineFullSpan"
                        @onclick="() => OnTimelineScopeChange.InvokeAsync(true)">
                    כל הפרויקט
                </button>
                <button type="button"
                        class="pl-seg-btn @(!TimelineFullSpan ? "pl-seg-on" : "")"
                        aria-pressed="@(!TimelineFullSpan)"
                        @onclick="() => OnTimelineScopeChange.InvokeAsync(false)">
                    חודש בודד
                </button>
            </div>
        </div>
    }

    @* ── 3. Primary action ── *@
    <div class="pl-toolbar-end">
        <MButton Variant="MButton.ButtonVariant.Primary"
                 Size="MButton.ButtonSize.Small"
                 OnClick="OnNewTask">
            <span class="pl-plus" aria-hidden="true">+</span>משימת צוות חדשה
        </MButton>
    </div>
</div>

@code {
    [Parameter] public PlanningView    View                  { get; set; }
    [Parameter] public string          PeriodLabel           { get; set; } = "";
    [Parameter] public bool            TimelineFullSpan      { get; set; }

    [Parameter] public EventCallback<PlanningView> OnViewChange          { get; set; }
    [Parameter] public EventCallback<bool>         OnTimelineScopeChange { get; set; }
    [Parameter] public EventCallback               OnPrev                { get; set; }
    [Parameter] public EventCallback               OnNext                { get; set; }
    [Parameter] public EventCallback               OnToday               { get; set; }
    [Parameter] public EventCallback               OnNewTask             { get; set; }

    private static readonly PlanningView[] AllViews =
        { PlanningView.Month, PlanningView.Week, PlanningView.Timeline };

    /// <summary>Period stepping is meaningless when the Timeline is showing the
    /// whole project — there is no "next project".</summary>
    private bool ShowPeriodNav => View != PlanningView.Timeline || !TimelineFullSpan;

    private static string ViewLabel(PlanningView v) => v switch
    {
        PlanningView.Month => "חודש",
        PlanningView.Week  => "שבוע",
        _                  => "ציר זמן"
    };
}
