@namespace AuthWithAdmin.Client.Pages.Planning

@*
    PlanningFilterChips — the Design's filter row (Motiva Calendar.dc.html:137–141).

    Six chips now instead of five: פגישות is gone (no meetings data) and
    משימות מנחה + אישי are added (both backed by real, already-consumed data).

    The Design's chip semantics are preserved exactly: the ACTIVE chip is the
    white bordered one and the inactive chips carry the 4.5% ink fill — which
    reads backwards until you notice it is the Design's own inversion
    (Motiva Calendar.dc.html:671–674). Kept as drawn.
*@

<div class="pl-filters" role="group" aria-label="סינון לפי סוג">
    <div class="pl-filters-track">
        <button type="button"
                class="pl-fchip @(Active is null ? "pl-fchip-on" : "")"
                aria-pressed="@(Active is null)"
                @onclick="() => OnChange.InvokeAsync(null)">
            הכול
        </button>

        @foreach (var k in PlanningKinds.All)
        {
            var count = CountFor(k);
            <button type="button"
                    class="pl-fchip @(Active == k ? "pl-fchip-on" : "")"
                    style="@PlanningKinds.PaletteStyle(k)"
                    aria-pressed="@(Active == k)"
                    @onclick="() => Toggle(k)">
                <span class="pl-fdot" aria-hidden="true"></span>
                @PlanningKinds.FilterLabel(k)
                @if (count > 0)
                {
                    <span class="pl-fcount">@count</span>
                }
            </button>
        }
    </div>
</div>

@code {
    /// <summary>Null = הכול.</summary>
    [Parameter] public PlanningKind? Active { get; set; }

    /// <summary>Every item in the loaded dataset, unfiltered — the counts must
    /// not change as the filter changes, or the row becomes unreadable.</summary>
    [Parameter] public IReadOnlyList<PlanningItem> AllItems { get; set; } = Array.Empty<PlanningItem>();

    [Parameter] public EventCallback<PlanningKind?> OnChange { get; set; }

    private int CountFor(PlanningKind k)
    {
        int n = 0;
        foreach (var i in AllItems) if (i.Kind == k) n++;
        return n;
    }

    /// <summary>Pressing the active chip clears it — same toggle rule the Tasks
    /// page uses for its KPI filter.</summary>
    private Task Toggle(PlanningKind k) =>
        OnChange.InvokeAsync(Active == k ? null : k);
}
