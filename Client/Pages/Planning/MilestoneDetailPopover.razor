@namespace AuthWithAdmin.Client.Pages.Planning

@*
    MilestoneDetailPopover — what a milestone band opens.

    WHY NOT MilestoneDetailModal
    Client/Pages/Dashboard/MilestoneDetailModal.razor exists, but its contract
    is MilestoneSummaryDto — the dashboard's shape, carrying fields
    (task lists with their own status projections) that the planning payload
    does not produce. Adapting it would mean either changing its parameter
    type (it is used by the Dashboard, which is out of scope) or fabricating
    a MilestoneSummaryDto from partial data.

    So this is a small presentation-only surface over the Design's detail
    popover (Motiva Calendar.dc.html:300–334): a label/value grid, a note, and
    actions. Task rows delegate straight to the existing TaskDetailModal —
    task detail is never re-implemented here.
*@

<MModal IsOpen="@(Milestone is not null)"
        Title="@(Milestone?.Title ?? "")"
        Size="MModal.ModalSize.Small"
        OnClose="OnClose">

    @if (Milestone is not null)
    {
        <div class="pl-md">
            <span class="pl-md-badge pl-md-@StatusSlug">
                <span class="pl-md-dot"></span>@StatusLabel
            </span>

            <dl class="pl-md-rows">
                @if (Milestone.Start.HasValue)
                {
                    <div class="pl-md-row">
                        <dt>תאריך פתיחה</dt>
                        <dd>@Milestone.Start.Value.ToString("dd.MM.yyyy")</dd>
                    </div>
                }
                else
                {
                    @* Stated rather than hidden: an absent OpenDate is why this
                       milestone renders as a marker instead of a band, and the
                       student should be able to see that it is missing rather
                       than assume the timeline is wrong. *@
                    <div class="pl-md-row">
                        <dt>תאריך פתיחה</dt>
                        <dd class="pl-md-muted">לא הוגדר</dd>
                    </div>
                }

                @if (Milestone.Due.HasValue)
                {
                    <div class="pl-md-row">
                        <dt>תאריך יעד</dt>
                        <dd>@Milestone.Due.Value.ToString("dd.MM.yyyy")</dd>
                    </div>
                }

                <div class="pl-md-row">
                    <dt>התקדמות</dt>
                    <dd>@Milestone.DoneCount / @Milestone.TotalCount משימות · @Milestone.ProgressPct%</dd>
                </div>
            </dl>

            <MProgressBar Value="@Milestone.ProgressPct" />

            @if (Items.Count > 0)
            {
                <div class="pl-md-items">
                    <p class="pl-md-itemshead">משימות באבן הדרך</p>
                    @foreach (var item in Items)
                    {
                        <PlanningItemChip Item="@item" Relaxed="true" OnOpen="OnOpenItem" />
                    }
                </div>
            }
            else
            {
                <p class="pl-md-none">אין משימות משויכות בטווח המוצג.</p>
            }
        </div>
    }
</MModal>

@code {
    [Parameter] public PlanningMilestone? Milestone { get; set; }

    /// <summary>Items belonging to this milestone, already filtered by the page.</summary>
    [Parameter] public IReadOnlyList<PlanningItem> Items { get; set; } = Array.Empty<PlanningItem>();

    [Parameter] public EventCallback                OnClose    { get; set; }
    [Parameter] public EventCallback<PlanningItem>  OnOpenItem { get; set; }

    /// <summary>Same four labels the outgoing StudentMilestonesPage used —
    /// preserved so the vocabulary does not shift under the student.</summary>
    private string StatusLabel => Milestone?.Status switch
    {
        "Completed"  => "הושלם",
        "InProgress" => "פעיל",
        "Delayed"    => "באיחור",
        _            => "טרם נפתח"
    };

    private string StatusSlug => Milestone?.Status switch
    {
        "Completed"  => "done",
        "InProgress" => "active",
        "Delayed"    => "late",
        _            => "pending"
    };
}
