@namespace AuthWithAdmin.Client.Pages.Planning

@*
    PlanningWeekView — the final Calendar's week view
    (Motiva Student Calendar final.dc.html, WEEK VIEW).

    THE REFERENCE'S TWO BANDS, BOTH REAL HERE
    The reference splits a week into a כל היום strip and an 08:00–20:00 hour
    grid, and it decides between them on one question: does the item carry a
    start time? Motiva answers that question for real —

      • PersonalTaskDto carries an optional StartTime/EndTime work block
        ("when on that day do I plan to sit with it"), so a personal task with
        one is POSITIONED in the hour grid at its own hour.
      • Every other kind is date-only — a submission is due on a day, not at an
        hour — so it sits in the כל היום band, which is exactly what the
        reference does with its own untimed items.

    That is why the hour grid is drawn now and was not before: when this view
    was first built no Motiva row carried a time of day, and 13 empty rows
    would have implied a scheduling capability the product did not have. The
    band above it means nothing is hidden by the window either — see
    OutsideWindow.

    The DAY HEAD is the reference's verbatim: day name over the date, today's
    date as a 26px violet pill, a 52px gutter column holding the hour scale.
*@

<MCard Padding="MCard.CardPadding.None">
    <div class="pl-week">

        @* ── Day head ── *@
        <div class="pl-week-head">
            <span class="pl-week-gutter" aria-hidden="true"></span>
            @foreach (var col in Columns)
            {
                <div class="pl-week-headcell">
                    <span class="pl-week-dayname">@col.DayName</span>
                    <span class="pl-week-daynum @(col.IsToday ? "pl-week-daynum-today" : "")">@col.Date.Day</span>
                    @if (col.RelLabel is not null)
                    {
                        <span class="pl-week-rel">@col.RelLabel</span>
                    }
                </div>
            }
        </div>

        @* ── כל היום ──
           Everything without a positionable work block. The band always
           renders: it is where six of Motiva's seven dated things live, so
           hiding it when empty would make the week look broken on a quiet
           week rather than calm. *@
        <div class="pl-week-allday">
            <span class="pl-week-gutter pl-week-gutter-label">כל היום</span>
            @foreach (var col in Columns)
            {
                <div class="pl-week-allday-cell @(col.IsToday ? "pl-week-col-today" : "")">
                    @foreach (var item in col.AllDay)
                    {
                        <PlanningItemChip Item="@item" OnOpen="OnOpenItem" />
                    }
                </div>
            }
        </div>

        @* ── Hour grid ──
           The GRID CANNOT BE THE SCROLL BOX. Every vertical scrollbar in the
           app sits on the physical right, which under `direction: rtl` means
           flipping the scroll container to `direction: ltr` — and this
           container is a 7-column grid, so that flip reverses the days
           themselves (measured: the hour gutter jumps from the right edge to
           the left). The box around it takes the scroll and the flip; the
           grid restores `rtl` and is laid out exactly as before. *@
        <div class="pl-week-hoursbox">
        <div class="pl-week-hours">
            <div class="pl-week-gutter">
                @for (int h = HourStart; h < HourEnd; h++)
                {
                    <div class="pl-week-hourlabel">@HourLabel(h)</div>
                }
            </div>

            @foreach (var col in Columns)
            {
                <div class="pl-week-col @(col.IsToday ? "pl-week-col-today" : "")">
                    @* ── Click-to-create ──
                       Each hour row IS the button. Same reasoning as the Month
                       cell: a real <button> is focusable and Enter/Space-operable
                       without re-implementing either. Positioned event blocks sit
                       above these at z-index 2 and handle their own clicks, so an
                       existing task always opens and never creates. *@
                    @for (int h = HourStart; h < HourEnd; h++)
                    {
                        @* Both the slot and its label are built HERE, not inside
                           the lambda: Razor cannot parse an interpolated string
                           inside an event-handler expression. *@
                        var slot      = new PlanningSlot(col.Date, HourLabel(h));
                        var slotLabel = $"יצירת משימת צוות ליום {col.DayName} {col.Date:d.M} בשעה {HourLabel(h)}";
                        <button type="button" class="pl-week-hourline"
                                aria-label="@slotLabel"
                                @onclick="() => OnCreateAt.InvokeAsync(slot)">
                        </button>
                    }

                    @foreach (var block in col.Timed)
                    {
                        <button type="button"
                                class="pl-week-event @(block.Item.IsDone ? "pl-week-event-done" : "")"
                                style="@PlanningKinds.PaletteStyle(block.Item.Kind) top:@(block.Top)px; block-size:@(block.Height)px;"
                                title="@block.Tooltip"
                                @onclick="() => OnOpenItem.InvokeAsync(block.Item)">
                            <span class="pl-week-event-time" dir="ltr">@block.TimeLabel</span>
                            <span class="pl-week-event-title">@block.Item.Title</span>
                        </button>
                    }

                    @if (col.NowOffset is int nowTop)
                    {
                        <div class="pl-week-now" style="top:@(nowTop)px" aria-hidden="true">
                            <span class="pl-week-now-dot"></span>
                        </div>
                    }
                </div>
            }
        </div>
        </div>

    </div>
</MCard>

@code {
    /// <summary>Any date inside the week being shown.</summary>
    [Parameter, EditorRequired] public DateTime Anchor { get; set; }

    [Parameter] public IReadOnlyList<PlanningItem> Items { get; set; } = Array.Empty<PlanningItem>();

    [Parameter] public EventCallback<PlanningItem> OnOpenItem { get; set; }

    /// <summary>Raised when the student clicks an EMPTY hour slot. The page turns
    /// it into the existing create-task modal, seeded with that day and hour.</summary>
    [Parameter] public EventCallback<PlanningSlot> OnCreateAt { get; set; }

    /// <summary>
    /// The day the grid draws: 07:00 through 00:00.
    ///
    /// <para>The reference's window was 08:00–20:00. It no longer has to be a
    /// working-day slice: the grid scrolls inside its own box now
    /// (.pl-week-hoursbox), so the full evening costs the page no height at
    /// all — the rows below the fold are simply scrolled to.</para>
    ///
    /// <para><c>HourEnd</c> is the EXCLUSIVE bound of the row loop, so 25 draws
    /// rows 7…24 — eighteen of them, labelled 07:00 … 23:00, 00:00. The last
    /// label is midnight because <c>HourLabel</c> wraps at 24.</para>
    ///
    /// <para>The reference draws 56px an hour; 44px is the density this product
    /// needs. It is ONE value at every breakpoint on purpose — the block
    /// positions below are computed in C# and the hour rows are drawn in CSS,
    /// so a per-breakpoint height would desynchronise the two and float every
    /// block off its own slot.</para>
    /// </summary>
    private const int HourStart  = 7;
    private const int HourEnd    = 25;
    private const int HourHeight = 44;

    /// <summary>Floor for a block's height, so a 15-minute block is still
    /// readable rather than a sliver.</summary>
    private const int MinBlockHeight = 24;

    /// <summary>"08:00" — one formatter for the scale and the slot labels, so
    /// the hour a student reads is the hour the form is seeded with.
    ///
    /// <para>Wraps at 24 so the grid's last row reads 00:00 rather than the
    /// nonexistent 24:00.</para></summary>
    private static string HourLabel(int hour) => (hour % 24).ToString("00") + ":00";

    private static readonly string[] DayNames =
        { "ראשון", "שני", "שלישי", "רביעי", "חמישי", "שישי", "שבת" };

    /// <summary>Sunday-first, matching the Month header and the reference.</summary>
    public static DateTime StartOfWeek(DateTime d) => d.Date.AddDays(-(int)d.Date.DayOfWeek);

    /// <summary>A work block already resolved to pixels within the hour grid.</summary>
    private sealed record TimedBlock(PlanningItem Item, int Top, int Height, string TimeLabel, string Tooltip);

    private sealed record Col(
        DateTime Date, string DayName, bool IsToday, string? RelLabel,
        List<PlanningItem> AllDay, List<TimedBlock> Timed, int? NowOffset);

    /// <summary>
    /// True when a work block cannot be drawn inside the 07:00–00:00 window.
    ///
    /// <para>Such an item falls back to the כל היום band rather than being
    /// clamped to the window's edge: clamping would draw a 06:00 block at 07:00
    /// and quietly lie about when it is, while the band keeps it visible and
    /// its chip label still carries the real hour. With the window now running
    /// to midnight, only the small hours land here.</para>
    /// </summary>
    private static bool OutsideWindow(PlanningItem i) =>
        i.StartMinutes is not int m || m < HourStart * 60 || m > HourEnd * 60;

    private List<Col> Columns
    {
        get
        {
            var start = StartOfWeek(Anchor);

            var byDate = Items
                .GroupBy(i => i.Date)
                .ToDictionary(g => g.Key, g => g.OrderBy(i => i.IsDone)
                                                .ThenBy(i => i.StartMinutes ?? -1)
                                                .ThenBy(i => (int)i.Kind)
                                                .ToList());

            var now       = DateTime.Now;
            var nowMinute = now.Hour * 60 + now.Minute;

            var cols = new List<Col>(7);
            for (int k = 0; k < 7; k++)
            {
                var d    = start.AddDays(k);
                int diff = (d - DateTime.Today).Days;

                var all = byDate.TryGetValue(d, out var list) ? list : new List<PlanningItem>();

                var allDay = all.Where(i => !i.HasTime || OutsideWindow(i)).ToList();
                var timed  = all.Where(i => i.HasTime && !OutsideWindow(i))
                                .Select(ToBlock)
                                .ToList();

                bool isToday = d == DateTime.Today;
                int? nowOffset = isToday
                                 && nowMinute >= HourStart * 60
                                 && nowMinute <= HourEnd * 60
                    ? (nowMinute - HourStart * 60) * HourHeight / 60
                    : null;

                cols.Add(new Col(
                    d,
                    DayNames[(int)d.DayOfWeek],
                    isToday,
                    diff switch { 0 => "היום", 1 => "מחר", _ => null },
                    allDay,
                    timed,
                    nowOffset));
            }
            return cols;
        }
    }

    private static TimedBlock ToBlock(PlanningItem i)
    {
        int startMin = i.StartMinutes!.Value;
        int endMin   = i.EndMinutes ?? startMin;

        int top    = (startMin - HourStart * 60) * HourHeight / 60;
        int height = Math.Max((endMin - startMin) * HourHeight / 60, MinBlockHeight);

        // The reference insets the block a pixel top and bottom so consecutive
        // blocks read as two, not as one continuous fill.
        var label = string.IsNullOrWhiteSpace(i.EndTime) ? i.StartTime! : $"{i.StartTime}–{i.EndTime}";

        return new TimedBlock(
            i,
            top + 1,
            Math.Max(height - 2, MinBlockHeight),
            label,
            $"{PlanningKinds.Label(i.Kind)} · {i.Title} · {label} · {i.StatusLabel}");
    }
}
