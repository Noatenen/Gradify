@namespace AuthWithAdmin.Client.Pages.Student
@using AuthWithAdmin.Shared.AuthSharedModels
@using AuthWithAdmin.Client.Services
@using AuthWithAdmin.Client.Components
@inject IStudentProfileService ProfileService

@*
    StudentProfilePersonalCard — "פרטים אישיים"
    Visual source: Motiva Student Profile final.dc.html:67-101.

    The reference's card-level EDIT MODE replaces the previous build's
    per-field inline pencil: one "עריכה" action in the head swaps the whole
    field grid into its editable state and puts ביטול / שמירה in its place,
    and a successful write flashes the "הפרטים נשמרו" strip above the grid.

    THE WRITE ITSELF IS UNCHANGED. Same PUT /api/student/me through
    IStudentProfileService.UpdatePhoneAsync, same 20-character client guard
    mirroring StudentController's own, same Enter / Escape keys, same
    in-place update of the parent's Profile object so the page never
    disagrees with the server. Only the affordance around it is the
    reference's.

    ── WHY ONLY ONE FIELD BECOMES AN INPUT ──────────────────────────────────
    The reference makes "שם מלא" editable too. PUT /api/student/me updates
    users.Phone and nothing else — there is no endpoint, anywhere, that
    mutates a student's own FirstName / LastName — so a name input would be
    a control that silently discards what is typed into it. It is rendered
    read-only.

    The card used to close with the reference's own footnote — "השם, כתובת
    האימייל והשנה האקדמית נקבעים על ידי צוות התוכנית…". It is gone. Three of
    the four fields are plainly not editable (only טלפון becomes an input in
    edit mode), so the paragraph restated in fifty words what the controls
    already say, and it cost the page a screenful of height it needed for the
    four cards to sit in one viewport.

    Adding a name-update endpoint is a server + validation + audit change
    (the name is the identity every roster, notification and submission is
    attributed by), which is outside a visual migration. Reported, not
    invented.

    ── THE FOUR FIELDS ──────────────────────────────────────────────────────
    Every value is one the page already loaded via GET /api/student/me — no
    new request, nothing computed:

      * שם מלא        display only — no endpoint mutates it (above).
      * אימייל        display only. It is the login identity; the reference
                      makes the same call and says so in its footnote.
      * טלפון         the one editable value on the screen.
      * שנה אקדמית    display only, set by the course staff.

    The reference's fourth field is "תפקיד". The role is real, but the
    identity row above already states it — a read-only field repeating the
    line 40px above it is a field in appearance only. שנה אקדמית takes the
    slot instead, which is real data with nowhere else on the screen to be.

    Also on StudentProfileDto and deliberately absent: IdNumber (empty for
    every seeded user), and ProjectTitle / TeamName / ProjectNumber, which
    are project identity and are named in הצוות שלי.
*@

@* Solid, and the only Solid card on the page: the final design draws its
   ONE primary section opaque (#FDFDFE) against the translucent .66 fill
   every other section carries. Padding is None because the reference's own
   section inset (22px block-start / 24px inline / 24px block-end) differs
   from the shared card step, and the wrapper below applies it verbatim.

   MCard's own root cannot be reached from this component's scoped CSS, so
   every style below hangs off that wrapper. *@
<MCard Variant="MCard.CardVariant.Solid" Padding="MCard.CardPadding.None">
    <div class="spf-pd">

        <div class="spf-pd-head">
            <h2 class="spf-pd-title">פרטים אישיים</h2>
        </div>

        @* One live region for both outcomes, so a screen reader hears the
           result of a save exactly once whichever way it went. *@
        <div aria-live="polite">
            @if (_saved)
            {
                <p class="spf-pd-flash">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="m5 13 4 4L19 7"></path>
                    </svg>
                    הפרטים נשמרו
                </p>
            }
            else if (_error is not null)
            {
                <p class="spf-pd-flash spf-pd-flash-error">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <circle cx="12" cy="12" r="9"></circle>
                        <path d="M12 8v5M12 16.5v.01"></path>
                    </svg>
                    @_error
                </p>
            }
        </div>

        <div class="spf-pd-fields">

            <div class="spf-pd-field">
                <span class="spf-pd-label" id="spf-pd-name">שם מלא</span>
                <span class="spf-pd-value" aria-labelledby="spf-pd-name">@FullName</span>
            </div>

            <div class="spf-pd-field">
                <span class="spf-pd-label" id="spf-pd-email">אימייל</span>
                <span class="spf-pd-value spf-pd-ltr" aria-labelledby="spf-pd-email">@Profile.Email</span>
            </div>

            <div class="spf-pd-field">
                <span class="spf-pd-label" id="spf-pd-phone">טלפון</span>
                @if (_editing)
                {
                    <input class="spf-pd-input spf-pd-ltr"
                           type="tel"
                           maxlength="20"
                           placeholder="05x-xxxxxxx"
                           aria-labelledby="spf-pd-phone"
                           disabled="@_saving"
                           @bind="_phoneDraft"
                           @bind:event="oninput"
                           @onkeydown="HandleKeyDownAsync" />
                }
                else
                {
                    <span class="@PhoneValueClass" aria-labelledby="spf-pd-phone">@PhoneDisplay</span>
                }
            </div>

            <div class="spf-pd-field">
                <span class="spf-pd-label" id="spf-pd-year">שנה אקדמית</span>
                <span class="@YearValueClass" aria-labelledby="spf-pd-year">@YearDisplay</span>
            </div>

        </div>

        @* The card's action slot, at the bottom-left — the same place and the
           same rhythm as "לפרויקט שלי" in הצוות שלי. ONE slot, not two: the
           edit affordance and the ביטול / שמירה pair it turns into are the
           same control in two states, so they share a position. Splitting
           them would make the card's actions jump from the bottom of the
           card to the top the moment the student clicked עריכה. *@
        <div class="spf-pd-foot">
            @if (_editing)
            {
                <div class="spf-pd-actions">
                    <button type="button"
                            class="spf-pd-btn-ghost"
                            disabled="@_saving"
                            @onclick="CancelEdit">ביטול</button>

                    <button type="button"
                            class="spf-pd-btn-save motiva-cta"
                            disabled="@_saving"
                            @onclick="SaveAsync">
                        @if (_saving)
                        {
                            <span class="spf-pd-spinner" aria-hidden="true"></span>
                        }
                        <span>שמירה</span>
                    </button>
                </div>
            }
            else
            {
                <button type="button" class="spf-pd-btn-edit" @onclick="StartEdit">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M17 3a2.8 2.8 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"></path>
                    </svg>
                    <span>עריכה</span>
                </button>
            }
        </div>
    </div>
</MCard>

@code {
    /// <summary>The profile the page already loaded. Mutated in place on a
    /// successful save so the parent page and this card never disagree about
    /// the current phone number.</summary>
    [Parameter, EditorRequired] public StudentProfileDto Profile { get; set; } = default!;

    /// <summary>Raised after a successful write so the page can re-render.</summary>
    [Parameter] public EventCallback OnProfileChanged { get; set; }

    private bool   _editing;
    private bool   _saving;
    private bool   _saved;
    private string _phoneDraft = "";

    /// <summary>The message to show, or null for none. A string rather than a
    /// flag because the two ways a save can fail need different words: an
    /// over-long number was never sent, so telling the student the save failed
    /// would send them retrying an unchanged value.</summary>
    private string? _error;

    private string FullName => $"{Profile.FirstName} {Profile.LastName}".Trim();

    private bool   HasPhone       => !string.IsNullOrWhiteSpace(Profile.Phone);
    private string PhoneDisplay   => HasPhone ? Profile.Phone : "לא הוזן מספר";
    private string PhoneValueClass =>
        HasPhone ? "spf-pd-value spf-pd-ltr" : "spf-pd-value spf-pd-value-empty";

    private bool   HasYear        => !string.IsNullOrWhiteSpace(Profile.AcademicYear);
    private string YearDisplay    => HasYear ? Profile.AcademicYear : "—";
    private string YearValueClass =>
        HasYear ? "spf-pd-value" : "spf-pd-value spf-pd-value-empty";

    // ── Edit / save / cancel ─────────────────────────────────────────────

    private void StartEdit()
    {
        _phoneDraft = Profile.Phone ?? "";
        _editing    = true;
        _saved      = false;
        _error      = null;
    }

    private void CancelEdit()
    {
        // The draft is simply dropped — Profile.Phone was never touched, so
        // there is nothing to roll back.
        _editing = false;
        _error   = null;
    }

    private async Task HandleKeyDownAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")       await SaveAsync();
        else if (e.Key == "Escape") CancelEdit();
    }

    private async Task SaveAsync()
    {
        var phone = (_phoneDraft ?? "").Trim();

        // Mirrors the server's own guard (StudentController.UpdateMyProfile)
        // so an over-long value is caught before the round trip. The card
        // stays in edit mode so the value is still there to correct.
        if (phone.Length > 20)
        {
            _error = "מספר טלפון ארוך מדי — עד 20 תווים.";
            return;
        }

        _saving = true;
        _error  = null;

        var ok = await ProfileService.UpdatePhoneAsync(phone);

        _saving = false;

        if (!ok)
        {
            _error = "שמירת הפרטים נכשלה. נסי שנית.";
            return;
        }

        Profile.Phone = phone;
        _editing      = false;
        _saved        = true;

        if (OnProfileChanged.HasDelegate) await OnProfileChanged.InvokeAsync();

        _ = ClearSavedFlagAsync();
    }

    private async Task ClearSavedFlagAsync()
    {
        // The reference holds "הפרטים נשמרו" for 2.6s, then clears it.
        await Task.Delay(2600);
        _saved = false;
        await InvokeAsync(StateHasChanged);
    }
}
