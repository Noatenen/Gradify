@page "/student/catalog"
@layout AppLayout
@using AuthWithAdmin.Shared.AuthSharedModels
@using Microsoft.AspNetCore.Authorization
@inject HttpClient Http
@inject NavigationManager Nav
@attribute [Authorize(Roles = Roles.Student)]
@using AuthWithAdmin.Client.Services
@using AuthWithAdmin.Client.Shared
@inject IStudentStageService StageSvc

@*
    ── Project catalog (קטלוג פרויקטים) ─────────────────────────────────────
    The student's route. Everything the student SEES lives in
    StudentCatalogBoard; this page owns the three things that are true only for
    a signed-in student and must not be true for anyone previewing the screen:

      • the data          — api/student/catalog, Student-only
      • the favourites    — POST/DELETE api/student/favorites/{id}
      • the stage gate    — a team that has already submitted gets StudentWaiting
                            instead of an editable catalogue

    NOTHING IS CHOSEN HERE
    ──────────────────────
    The catalogue is browse-only. Ranking moved into the assignment form, and
    the sessionStorage store that used to carry three ids between the two
    screens is gone with it — see StudentCatalogBoard and StudentAssignmentPage
    for why one screen owning the decision is the point.

    Nothing about the browse surface changed when it was extracted: same
    toolbar, same rail, same cards, same quick view, same scoped stylesheet
    (moved with the markup it styles). See StudentCatalogBoard for why the
    lecturer's preview renders that component rather than a copy of it.
*@

@if (_stage == StudentStage.AwaitingAssignment)
{
    @* A team that has already submitted must not be handed an editable
       catalogue as though nothing happened. Rendered INSTEAD of the browse
       surface — not redirected to, because a redirect between two student
       routes that both guard on the same stage is how a loop starts. *@
    <StudentWaiting Submission="StageSvc.Submission"
                    FormStatus="StageSvc.FormStatus"
                    Projects="_projects" />
}
else
{
    <StudentCatalogBoard Projects="_projects"
                         FavoriteIds="_favoriteIds"
                         OnToggleFavorite="ToggleFavorite"
                         Loading="_loading"
                         LoadError="_loadError"
                         OnContinue="GoToAssignment" />
}

@code {

    private List<StudentCatalogProjectDto> _projects    = new();
    private readonly HashSet<int>          _favoriteIds = new();

    private bool _loading   = true;
    private bool _loadError = false;

    private StudentStage _stage = StudentStage.NeedsPreferences;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var result = await Http.GetFromJsonAsync<List<StudentCatalogProjectDto>>("api/student/catalog");
            _projects = result ?? new();
            foreach (var p in _projects.Where(p => p.IsFavorite))
                _favoriteIds.Add(p.Id);

            _stage = await StageSvc.ResolveAsync();
        }
        catch
        {
            _loadError = true;
        }
        finally
        {
            _loading = false;
        }
    }

    private void GoToAssignment() => Nav.NavigateTo("/" + PageRoutes.StudentAssignment);

    private async Task ToggleFavorite(StudentCatalogProjectDto project)
    {
        bool wasFavorite = _favoriteIds.Contains(project.Id);
        if (wasFavorite)
            _favoriteIds.Remove(project.Id);
        else
            _favoriteIds.Add(project.Id);

        try
        {
            if (wasFavorite)
                await Http.DeleteAsync($"api/student/favorites/{project.Id}");
            else
                await Http.PostAsync($"api/student/favorites/{project.Id}", null);
        }
        catch
        {
            if (wasFavorite) _favoriteIds.Add(project.Id);
            else             _favoriteIds.Remove(project.Id);
        }
    }
}
