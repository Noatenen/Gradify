@namespace AuthWithAdmin.Client.Pages.Student
@using AuthWithAdmin.Shared.AuthSharedModels
@using AuthWithAdmin.Client.Services
@using AuthWithAdmin.Client.Components
@inject IProjectContextService ProjectContext
@inject IJSRuntime JS

@*
    StudentProfileTeamCard — "הצוות שלי"
    Visual source: Motiva Student Profile final.dc.html:122-139.

    NO NEW DATA AND NO NEW ENDPOINT. The reference's TEAM array is four
    hard-coded prototype people; every row here comes from
    IProjectContextService, i.e. GET /api/projects/my-context, which:

      * the student shell already calls on every page, and
      * caches its result for the session (ProjectContextService._cached),

    so this card costs zero additional HTTP requests. The endpoint already
    returns the full roster to the calling student: StudentNames /
    StudentEmails and MentorNames / MentorEmails as parallel lists,
    populated by the GROUP_CONCAT subqueries in
    ProjectsController.GetMyContext.

    ── ROLE AND CONTACT ARE ONLY WHAT THE DATA SAYS ─────────────────────────
    The reference labels its people "ראשת צוות · את", "פיתוח", "מחקר ועיצוב".
    There is no per-member role on a team anywhere in the model — no lead
    flag, no discipline column — so the only two role words this card can
    write are the two the data actually distinguishes: "מנחה" for anyone in
    the mentor list, and "אני" for the signed-in student. A teammate gets no
    role word rather than an invented one.

    Contact is the EMAIL only, which is the one address the endpoint returns.
    Phone numbers are deliberately not shown even though users.Phone exists:
    a phone may only be published with the owner's consent, and no consent
    field exists anywhere to read (UserPreferences covers notifications,
    calendar, Slack and theme; MentorPreferences' PreferredChannel says how a
    mentor prefers to be reached, not that their number may be shown). The
    existing student-facing mentor projection, MentorProfileViewDto, carries
    Email and no Phone at all — the model's own answer, already written down.

    The copy control on each row is NOT in the reference and is kept from the
    previous build: it is a working affordance over data already on screen,
    and it goes quiet (opacity 0) until the row is hovered or the button
    itself is focused, so the card reads exactly as the reference draws it at
    rest.

    ── "לפרויקט שלי" ────────────────────────────────────────────────────────
    The reference's own footer action, and it now has a real destination:
    /project (ProjectWorkspacePage), the student project workspace. The
    previous build noted there was no student-safe project route to link to;
    there is one now, and this is it.
*@

<MCard Padding="MCard.CardPadding.None">
    <div class="spf-tm">
        <div class="spf-tm-head">
            <h2 class="spf-tm-title">הצוות שלי</h2>
            @if (Subtitle is not null)
            {
                <span class="spf-tm-subtitle">@Subtitle</span>
            }
        </div>

        @if (_loading)
        {
            <p class="spf-tm-note">טוענת פרטי צוות…</p>
        }
        else if (_ctx is null)
        {
            @* Not an error: a student who has not been placed yet. The
               endpoint returns null for exactly this case. *@
            <MEmptyState Title="עדיין לא שויכת לצוות"
                         Description="לאחר השיבוץ יופיעו כאן חברי הצוות והמנחים." />
        }
        else
        {
            @foreach (var person in People)
            {
                @PersonRow(person)
            }

            <a class="spf-tm-link" href="project">
                <span>לפרויקט שלי</span>
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="m15 6-6 6 6 6"></path>
                </svg>
            </a>
        }
    </div>
</MCard>

@code {
    /// <summary>The loaded profile. Used only to recognise the signed-in
    /// student inside the roster — the roster itself comes from the project
    /// context, not from here.</summary>
    [Parameter, EditorRequired] public StudentProfileDto Profile { get; set; } = default!;

    private ProjectContextDto? _ctx;
    private bool _loading = true;

    /// <summary>The address whose copy button is currently showing its
    /// confirmation tick. One at a time, keyed by the address itself — the
    /// same person can appear in only one row.</summary>
    private string? _copiedEmail;

    /// <summary>One roster row. <c>Role</c> is null for a teammate, which is
    /// the whole point — see the header note.</summary>
    private sealed record Person(string Name, string? Email, string? Role, bool IsMe);

    protected override async Task OnInitializedAsync()
    {
        _ctx     = await ProjectContext.GetAsync();
        _loading = false;
    }

    /// <summary>"צוות 15 · Gradify Platform". The team half repeats the
    /// shell's own expression (TeamName, falling back to
    /// "צוות {ProjectNumber}") so the two places naming this team never name
    /// it differently. Either half is dropped when empty, and the line
    /// disappears entirely rather than printing a bare separator.</summary>
    private string? Subtitle
    {
        get
        {
            if (_ctx is null) return null;

            var parts = new List<string>(2)
            {
                string.IsNullOrWhiteSpace(_ctx.TeamName)
                    ? $"צוות {_ctx.ProjectNumber}"
                    : _ctx.TeamName!,
            };

            if (!string.IsNullOrWhiteSpace(_ctx.ProjectTitle)) parts.Add(_ctx.ProjectTitle);

            return string.Join(" · ", parts);
        }
    }

    /// <summary>Students first, then mentors — the reference's own order, and
    /// the order the roster is read in.
    ///
    /// <para>Names and emails are parallel lists by the DTO's own contract, so
    /// the email is read by index and simply omitted if the lists ever
    /// disagree in length: a missing address must not shift every following
    /// person's email onto the wrong name.</para></summary>
    private List<Person> People
    {
        get
        {
            var people = new List<Person>();
            if (_ctx is null) return people;

            Append(_ctx.StudentNames, _ctx.StudentEmails, role: null);
            Append(_ctx.MentorNames,  _ctx.MentorEmails,  role: "מנחה");

            return people;

            void Append(List<string> names, List<string> emails, string? role)
            {
                if (names is null) return;

                for (var i = 0; i < names.Count; i++)
                {
                    var email = emails is not null && i < emails.Count ? emails[i] : null;
                    var isMe  = IsSignedInUser(email);

                    // Hebrew "אני" carries no grammatical gender, so it marks
                    // the row without assuming anything about the student.
                    people.Add(new Person(names[i], email, isMe ? "אני" : role, isMe));
                }
            }
        }
    }

    private RenderFragment PersonRow(Person p) => __builder =>
    {
        <div class="spf-tm-row">
            <span class="@(p.IsMe ? "spf-tm-chip spf-tm-chip-me" : "spf-tm-chip")"
                  aria-hidden="true">@InitialsOf(p.Name)</span>

            <div class="spf-tm-text">
                <p class="spf-tm-name">
                    @p.Name
                    @if (p.Role is not null)
                    {
                        <span class="spf-tm-role">@p.Role</span>
                    }
                </p>
                @if (!string.IsNullOrWhiteSpace(p.Email))
                {
                    <p class="spf-tm-contact">@p.Email</p>
                }
            </div>

            @if (!string.IsNullOrWhiteSpace(p.Email))
            {
                var email  = p.Email!;
                var copied = _copiedEmail == email;

                <button type="button"
                        class="@(copied ? "spf-tm-copy spf-tm-copy-done" : "spf-tm-copy")"
                        title="@(copied ? "הועתק" : "העתקת כתובת המייל")"
                        aria-label="@(copied ? $"כתובת המייל של {p.Name} הועתקה" : $"העתקת כתובת המייל של {p.Name}")"
                        @onclick="@(() => CopyEmailAsync(email))">
                    @if (copied)
                    {
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                             stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="m5 12.5 4.5 4.5L19 7.5"></path>
                        </svg>
                    }
                    else
                    {
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                             stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <rect x="9" y="9" width="12" height="12" rx="2"></rect>
                            <path d="M5 15V5a2 2 0 0 1 2-2h10"></path>
                        </svg>
                    }
                </button>
            }
        </div>
    };

    /// <summary>Copies one address, through the same
    /// <c>gradify.copyToClipboard</c> helper TeamQuickInfoPopover already uses
    /// for exactly these people — no second clipboard mechanism.
    ///
    /// <para>The tick only appears if the helper reports success, so the card
    /// never claims a copy the browser refused.</para></summary>
    private async Task CopyEmailAsync(string email)
    {
        if (string.IsNullOrWhiteSpace(email)) return;

        bool ok;
        try   { ok = await JS.InvokeAsync<bool>("gradify.copyToClipboard", email); }
        catch { ok = false; }

        if (!ok) return;

        _copiedEmail = email;
        _ = ClearCopiedAsync(email);
    }

    private async Task ClearCopiedAsync(string email)
    {
        await Task.Delay(2000);

        // Guard: a second copy may have moved the tick elsewhere while this
        // one was waiting, and clearing unconditionally would snap it off.
        if (_copiedEmail == email)
        {
            _copiedEmail = null;
            await InvokeAsync(StateHasChanged);
        }
    }

    /// <summary>Email is the match key, not the display name: two students on
    /// one team can share a name, and the address is the account identity.</summary>
    private bool IsSignedInUser(string? email) =>
        !string.IsNullOrWhiteSpace(email)
        && !string.IsNullOrWhiteSpace(Profile.Email)
        && string.Equals(email.Trim(), Profile.Email.Trim(), StringComparison.OrdinalIgnoreCase);

    /// <summary>First letter of the first two words — the roster arrives as
    /// one "First Last" string, so this cannot reuse the identity row's
    /// FirstName/LastName version.</summary>
    private static string InitialsOf(string fullName)
    {
        var words = (fullName ?? "").Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (words.Length == 0) return "?";
        return words.Length == 1
            ? words[0][..1]
            : $"{words[0][0]}{words[1][0]}";
    }
}
