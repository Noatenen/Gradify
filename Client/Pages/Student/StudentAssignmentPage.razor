@page "/student/assignment"
@layout AppLayout
@using AuthWithAdmin.Shared.AuthSharedModels
@using AuthWithAdmin.Client.Services
@using Microsoft.AspNetCore.Authorization
@inject IAssignmentService AssignmentSvc
@inject NavigationManager Nav
@attribute [Authorize(Roles = Roles.Student)]

@*
    ── Assignment form (טופס בחירת פרויקט) ──────────────────────────────────
    Migrated to the finalized Motiva student experience. The form itself —
    its five sections, validation, gate handling, edit mode and every
    IAssignmentService call — is untouched. What changed is the chrome:
    MPageHeader for the header, MCard per section, MStatusBadge for the
    per-section readiness pills, MToggle for the own-project switch,
    MSearchField for partner search, and MLoadingState / MEmptyState for
    the loading, error and gate-closed states.
*@

<div class="sap-header-bleed">
    <MPageHeader Variant="MPageHeader.HeaderVariant.Compact"
                 Class="sap-header"
                 Title="טופס בחירת פרויקט"
                 Subtitle="העדפות שיבוץ לפרויקט הגמר">
        <Actions>
            <button type="button"
                    class="sap-back-btn"
                    @onclick='() => Nav.NavigateTo("/" + PageRoutes.StudentCatalog)'>
                <span class="oi oi-chevron-right" aria-hidden="true"></span>
                חזרה לקטלוג
            </button>
        </Actions>
    </MPageHeader>
</div>

<div class="sap-page" dir="rtl">

    @if (_loading)
    {
        <MLoadingState Label="טוענת נתונים…" />
    }
    else if (_ctx is null)
    {
        <MEmptyState Live="true"
                     Title="שגיאה בטעינת הטופס"
                     Description="ייתכן שיש תקלת רשת זמנית. נסי לרענן את הדף." />
    }
    else if (_ctx.FormStatus is { CanSubmit: false } gate && _ctx.ExistingSubmission is null)
    {
        @* The gate is a resolved answer ("the form is closed"), not an error —
           MEmptyState is the finalized surface for exactly that. *@
        <MEmptyState Title="הטופס סגור להגשה"
                     Description="@gate.ClosedMessage" />
    }
    else if (!_editMode && _ctx.ExistingSubmission is not null)
    {
        <!-- ════════════════════════════════════════════════════════════
             SUMMARY VIEW — shown after submit or on return visit
             ════════════════════════════════════════════════════════════ -->

        @if (_justSubmitted)
        {
            <div class="sap-success-banner">
                <span class="oi oi-check" aria-hidden="true"></span>
                הטופס הוגש בהצלחה! ניתן לעדכן את ההגשה בכל עת לפני סגירת המועד.
            </div>
        }
        else
        {
            <div class="sap-info-banner">
                <span class="oi oi-info" aria-hidden="true"></span>
                הגשה מיום @FormatDate(_ctx.ExistingSubmission.SubmittedAt) — ניתן לעדכן עד סגירת המועד.
            </div>
        }
        @if (_ctx.FormStatus is { CanSubmit: false } locked)
        {
            <div class="sap-info-banner">
                <span class="oi oi-lock-locked" aria-hidden="true"></span>
                @locked.ClosedMessage
            </div>
        }

        <div class="sap-summary">

            <!-- Team -->
            <MCard Padding="MCard.CardPadding.Large" Class="sap-summary-section">
                <div class="sap-summary-section-head">
                    <span class="sap-summary-icon">👥</span>
                    <h2 class="sap-summary-title">צוות</h2>
                </div>
                <div class="sap-summary-members">
                    @foreach (var m in _ctx.TeamMembers)
                    {
                        <div class="sap-summary-member">
                            <div class="sap-summary-member-name">
                                <span class="oi oi-person" aria-hidden="true"></span>
                                <strong>@m.FullName</strong>
                                @if (m.UserId == _ctx.Me.Id)
                                {
                                    <span class="sap-chip-you">את</span>
                                }
                            </div>
                            @if (m.Strengths.Count > 0)
                            {
                                <div class="sap-summary-strengths">
                                    @foreach (var s in m.Strengths)
                                    {
                                        <span class="sap-summary-strength-tag">
                                            @GetStrengthIcon(s) @GetStrengthLabel(s)
                                        </span>
                                    }
                                </div>
                            }
                            else
                            {
                                <span class="sap-summary-none">לא צוינו חוזקות</span>
                            }
                        </div>
                    }
                </div>
            </MCard>

            <!-- Project preferences -->
            <MCard Padding="MCard.CardPadding.Large" Class="sap-summary-section">
                <div class="sap-summary-section-head">
                    <span class="sap-summary-icon">📋</span>
                    <h2 class="sap-summary-title">העדפות פרויקט</h2>
                </div>
                <div class="sap-summary-prefs">
                    @foreach (var pref in _ctx.ExistingSubmission.Preferences.OrderBy(p => p.Priority))
                    {
                        var proj = FindProject(pref.ProjectId);
                        <div class="sap-summary-pref-row">
                            <span class="sap-summary-pref-num">@pref.Priority</span>
                            <div class="sap-summary-pref-text">
                                <span class="sap-summary-pref-title">
                                    @if (proj is not null)
                                    { <text>#@proj.ProjectNumber — @proj.Title</text> }
                                    else
                                    { <text>פרויקט #@pref.ProjectId</text> }
                                </span>
                                @if (proj?.Description is { Length: > 0 } desc)
                                {
                                    <span class="sap-summary-pref-desc">@Truncate(desc, 100)</span>
                                }
                            </div>
                        </div>
                    }
                    @if (!_ctx.ExistingSubmission.Preferences.Any())
                    {
                        <span class="sap-summary-none">לא נבחרו פרויקטים</span>
                    }
                </div>
            </MCard>

            <!-- Own project -->
            <MCard Padding="MCard.CardPadding.Large" Class="sap-summary-section">
                <div class="sap-summary-section-head">
                    <span class="sap-summary-icon">💡</span>
                    <h2 class="sap-summary-title">פרויקט עצמאי</h2>
                </div>
                @if (_ctx.ExistingSubmission.HasOwnProject)
                {
                    <div class="sap-summary-own-yes">
                        <span class="sap-summary-own-badge">כן</span>
                        @if (!string.IsNullOrWhiteSpace(_ctx.ExistingSubmission.OwnProjectDescription))
                        {
                            <p class="sap-summary-own-text">@_ctx.ExistingSubmission.OwnProjectDescription</p>
                        }
                    </div>
                }
                else
                {
                    <span class="sap-summary-none">לא — נבחר מהקטלוג</span>
                }
            </MCard>

            <!-- Notes -->
            @if (!string.IsNullOrWhiteSpace(_ctx.ExistingSubmission.Notes))
            {
                <MCard Padding="MCard.CardPadding.Large" Class="sap-summary-section">
                    <div class="sap-summary-section-head">
                        <span class="sap-summary-icon">📝</span>
                        <h2 class="sap-summary-title">הערות נוספות</h2>
                    </div>
                    <p class="sap-summary-notes">@_ctx.ExistingSubmission.Notes</p>
                </MCard>
            }

        </div>

        <!-- Edit button — hidden when the form gate is closed -->
        @if (_ctx.FormStatus is null || _ctx.FormStatus.CanSubmit)
        {
            <div class="sap-summary-footer">
                <button class="sap-edit-btn" @onclick="EnterEditMode">
                    <span class="oi oi-pencil" aria-hidden="true"></span>
                    עדכון הגשה
                </button>
            </div>
        }
    }
    else
    {
        <!-- ════════════════════════════════════════════════════════════
             EDIT FORM
             ════════════════════════════════════════════════════════════ -->

        @if (!string.IsNullOrWhiteSpace(_ctx.FormStatus?.Instructions))
        {
            <div class="sap-info-banner">
                <span class="oi oi-info" aria-hidden="true"></span>
                @_ctx.FormStatus.Instructions
            </div>
        }

        @if (_ctx.ExistingSubmission is not null)
        {
            <div class="sap-edit-mode-banner">
                <span class="oi oi-pencil" aria-hidden="true"></span>
                עריכת הגשה קיימת — שמרי כדי לעדכן
                <button class="sap-cancel-edit-btn" @onclick="() => _editMode = false">ביטול</button>
            </div>
        }

        <div class="sap-form">

            <!-- ═══ SECTION 1 — Team ═══ -->
            <MCard Padding="MCard.CardPadding.Large" Class="sap-section">
                <div class="sap-section-head">
                    <span class="sap-section-num">1</span>
                    <div>
                        <h2 class="sap-section-title">צוות</h2>
                        <p class="sap-section-sub">
                            @if (_ctx.HasTeam) { <span>חברי הצוות שלך</span> }
                            else               { <span>בחרי שותפה אחת לצוות (חובה)</span> }
                        </p>
                    </div>
                    @if (_ctx.HasTeam || _selectedPartnerIds.Count == 1)
                    {
                        <MStatusBadge Variant="MStatusBadge.BadgeVariant.Teal"
                                      Text="@(_ctx.HasTeam ? "צוות מאושר" : "צוות מוכן")" />
                    }
                    else
                    {
                        <MStatusBadge Variant="MStatusBadge.BadgeVariant.Neutral" Text="דרושה שותפה" />
                    }
                </div>

                @if (_ctx.HasTeam)
                {
                    <div class="sap-member-list">
                        @foreach (var m in _ctx.TeamMembers)
                        {
                            <div class="sap-member-chip @(m.UserId == _ctx.Me.Id ? "sap-chip-me" : "")">
                                <span class="oi oi-person" aria-hidden="true"></span>
                                @m.FullName
                                @if (m.UserId == _ctx.Me.Id) { <span class="sap-chip-you">את</span> }
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="sap-team-preview">
                        <div class="sap-member-chip sap-chip-me">
                            <span class="oi oi-person" aria-hidden="true"></span>
                            @_ctx.Me.FullName
                            <span class="sap-chip-you">את</span>
                        </div>
                        @if (_selectedPartnerIds.Count == 1)
                        {
                            var pid     = _selectedPartnerIds.First();
                            var partner = _ctx.AvailableStudents.FirstOrDefault(s => s.Id == pid);
                            @if (partner is not null)
                            {
                                <span class="sap-team-plus">+</span>
                                <div class="sap-member-chip">
                                    <span class="oi oi-person" aria-hidden="true"></span>
                                    @partner.FullName
                                    <button class="sap-chip-remove" @onclick="() => RemovePartner(pid)">✕</button>
                                </div>
                            }
                        }
                        else
                        {
                            <span class="sap-team-plus sap-team-plus--empty">+ שותפה</span>
                        }
                    </div>

                    @if (_ctx.AvailableStudents.Count == 0)
                    {
                        <p class="sap-no-partners">אין סטודנטיות זמינות כרגע.</p>
                    }
                    else
                    {
                        <MSearchField @bind-Value="_partnerSearch"
                                      Class="sap-partner-search"
                                      Placeholder="חיפוש לפי שם…"
                                      AriaLabel="חיפוש שותפה לצוות" />
                        <div class="sap-partner-list">
                            @foreach (var s in FilteredPartners)
                            {
                                bool isSelected = _selectedPartnerIds.Contains(s.Id);
                                bool isDisabled = !isSelected && _selectedPartnerIds.Count >= 1;
                                <label class="sap-partner-row @(isSelected ? "sap-partner-row--selected" : "") @(isDisabled ? "sap-partner-row--disabled" : "")">
                                    <input type="checkbox" class="sap-partner-cb"
                                           checked="@isSelected" disabled="@isDisabled"
                                           @onchange="() => TogglePartner(s.Id)" />
                                    <span class="sap-partner-name">@s.FullName</span>
                                    @if (isSelected) { <span class="sap-chip-selected-tick">✓</span> }
                                </label>
                            }
                        </div>
                    }
                }
            </MCard>

            <!-- ═══ SECTION 2 — Strengths ═══
                 Title, help text and the option LABELS come from the real
                 Strengths FormBlock. The machine values behind those labels
                 (Technology / Design / ProjectManagement / Content) are what
                 gets written to StudentStrengths, and the server refuses to
                 change them — so an admin rewording "עיצוב" cannot alter what
                 SkillWeight() sees. -->
            <MCard Padding="MCard.CardPadding.Large" Class="sap-section">
                <div class="sap-section-head">
                    <span class="sap-section-num">2</span>
                    <div>
                        <h2 class="sap-section-title">
                            @StrengthsTitle
                            @if (StrengthsRequired) { <span class="sap-req" aria-label="שדה חובה">*</span> }
                        </h2>
                        <p class="sap-section-sub">@StrengthsHelp</p>
                    </div>
                </div>
                <div class="sap-strengths-grid-outer">
                    @foreach (var member in AllTeamMembers)
                    {
                        <div class="sap-strengths-member">
                            <div class="sap-strengths-member-name">
                                <span class="oi oi-person" aria-hidden="true"></span>
                                @member.FullName
                                @if (member.Id == _ctx.Me.Id) { <span class="sap-chip-you">את</span> }
                            </div>
                            <div class="sap-strengths-chips">
                                @foreach (var opt in StrengthChoices)
                                {
                                    var key   = opt.OptionValue;   // persisted — matching depends on it
                                    var label = opt.OptionLabel;   // displayed — admin-editable
                                    bool isChecked = _strengths.TryGetValue(member.Id, out var set) && set.Contains(key);
                                    <label class="sap-strength-chip @(isChecked ? "sap-strength-chip--active" : "")">
                                        <input type="checkbox" class="sap-hidden-cb" checked="@isChecked"
                                               @onchange="() => ToggleStrength(member.Id, key)" />
                                        <span class="sap-strength-icon">@StrengthIcon(key)</span>
                                        @label
                                    </label>
                                }
                            </div>
                        </div>
                    }
                </div>
            </MCard>

            <!-- ═══ SECTION 3 — Project preferences ═══ -->
            <MCard Padding="MCard.CardPadding.Large" Class="sap-section">
                <div class="sap-section-head">
                    <span class="sap-section-num">3</span>
                    @* Wording is the admin's; the three catalog-backed slots
                       below are not — they are the domain invariant the server
                       enforces on submit. *@
                    <div>
                        <h2 class="sap-section-title">
                            @PreferencesTitle
                            <span class="sap-req" aria-label="שדה חובה">*</span>
                        </h2>
                        <p class="sap-section-sub">@PreferencesHelp</p>
                    </div>
                    @if (_preferences.Count == 3)
                    { <MStatusBadge Variant="MStatusBadge.BadgeVariant.Teal" Text="מלא" /> }
                    else
                    { <MStatusBadge Variant="MStatusBadge.BadgeVariant.Neutral" Text="@($"{_preferences.Count} / 3 נבחרו")" /> }
                </div>
                <div class="sap-prefs-list">
                    @for (int i = 1; i <= 3; i++)
                    {
                        int priority   = i;
                        int currentVal = GetPreference(priority);
                        var chosen     = currentVal > 0 ? _ctx.Catalog.FirstOrDefault(p => p.Id == currentVal) : null;
                        <div class="sap-pref-block">
                            <div class="sap-pref-header">
                                <span class="sap-pref-num">@priority</span>
                                <span class="sap-pref-label">
                                    @(priority == 1 ? "עדיפות ראשונה" : priority == 2 ? "עדיפות שנייה" : "עדיפות שלישית")
                                </span>
                            </div>
                            <select class="sap-pref-select" value="@currentVal"
                                    @onchange="e => SetPreference(priority, ParseInt(e.Value?.ToString()))">
                                <option value="0">— בחירה —</option>
                                @foreach (var p in _ctx.Catalog)
                                {
                                    bool usedElsewhere = _preferences.Any(kv => kv.Key != priority && kv.Value == p.Id);
                                    <option value="@p.Id" disabled="@usedElsewhere">#@p.ProjectNumber — @p.Title</option>
                                }
                            </select>
                            @if (chosen is not null && !string.IsNullOrWhiteSpace(chosen.Description))
                            {
                                <p class="sap-pref-desc">@Truncate(chosen.Description, 120)</p>
                            }
                        </div>
                    }
                </div>
            </MCard>

            <!-- ═══ SECTION 4 — Own project ═══ -->
            <MCard Padding="MCard.CardPadding.Large" Class="sap-section">
                <div class="sap-section-head">
                    <span class="sap-section-num">4</span>
                    <div>
                        <h2 class="sap-section-title">פרויקט עצמאי</h2>
                        <p class="sap-section-sub">האם יש לכם רעיון לפרויקט משלכן? (אופציונלי)</p>
                    </div>
                </div>
                <div class="sap-own-toggle">
                    <MToggle @bind-Checked="_hasOwnProject"
                             AriaLabel="יש לנו רעיון לפרויקט עצמאי" />
                    <span class="sap-toggle-label">@(_hasOwnProject ? "כן, יש לנו רעיון" : "לא, נבחר מהקטלוג")</span>
                </div>
                @if (_hasOwnProject)
                {
                    <textarea class="sap-textarea"
                              placeholder="תארו את הרעיון — מטרה, קהל יעד, טכנולוגיה מתוכננת…"
                              rows="4"
                              @bind="_ownProjectDescription" @bind:event="oninput"></textarea>
                }
            </MCard>

            <!-- ═══ SECTION 5 — Notes ═══ -->
            <MCard Padding="MCard.CardPadding.Large" Class="sap-section">
                <div class="sap-section-head">
                    <span class="sap-section-num">5</span>
                    <div>
                        <h2 class="sap-section-title">
                            @NotesTitle
                            @if (NotesRequired) { <span class="sap-req" aria-label="שדה חובה">*</span> }
                        </h2>
                        <p class="sap-section-sub">@NotesHelp</p>
                    </div>
                </div>
                <textarea class="sap-textarea"
                          placeholder="הגבלות זמן, העדפות מיוחדות, שאלות…"
                          rows="3"
                          @bind="_notes" @bind:event="oninput"></textarea>
            </MCard>

            @* ═══ SECTION 6+ — Admin-configured questions ═══
               Everything the admin added to the assignment form beyond the
               three system blocks. Rendered here, inside the same form and the
               same submit, but persisted to FormSubmissions/FormAnswers rather
               than to the domain tables. The domain sections keep fixed
               positions because two of them (team, own project) have no
               FormBlock at all, so a fully block-driven page order is not
               expressible — these follow in their own SortOrder. *@
            @if (ExtraQuestions.Count > 0)
            {
                <MCard Padding="MCard.CardPadding.Large" Class="sap-section">
                    <div class="sap-section-head">
                        <span class="sap-section-num">6</span>
                        <div>
                            <h2 class="sap-section-title">שאלות נוספות</h2>
                            <p class="sap-section-sub">שאלות שהוגדרו על ידי צוות הקורס</p>
                        </div>
                    </div>

                    <div class="sap-extra-list">
                        @foreach (var q in ExtraQuestions)
                        {
                            var block = q;
                            var scale = block.RatingScale == 10 ? 10 : 5;

                            @if (FormBlockTypes.IsInformational(block.BlockType))
                            {
                                <div class="sap-extra-info">
                                    @if (!string.IsNullOrWhiteSpace(block.Title))
                                    {
                                        <h3 class="sap-extra-info-title">@block.Title</h3>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(block.HelperText))
                                    {
                                        <p class="sap-extra-info-text">@block.HelperText</p>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="sap-extra-q">
                                    <p class="sap-extra-q-title">
                                        <span>@block.Title</span>
                                        @if (block.IsRequired)
                                        {
                                            <span class="sap-req" aria-label="שאלת חובה">*</span>
                                        }
                                    </p>
                                    @if (!string.IsNullOrWhiteSpace(block.HelperText))
                                    {
                                        <p class="sap-extra-q-help">@block.HelperText</p>
                                    }

                                    @if (block.BlockType == FormBlockTypes.SingleChoice)
                                    {
                                        <div class="sap-extra-choices" role="radiogroup" aria-label="@block.Title">
                                            @foreach (var opt in block.Options)
                                            {
                                                var o = opt;
                                                var on = ExtraHasValue(block.Id, o.OptionValue);
                                                <label class="sap-extra-choice @(on ? "sap-extra-choice--on" : "")">
                                                    <input type="radio" name="@($"extra-{block.Id}")" checked="@on"
                                                           @onchange="() => ExtraPickSingle(block.Id, o.OptionValue)" />
                                                    <span>@o.OptionLabel</span>
                                                </label>
                                            }
                                        </div>
                                    }
                                    else if (block.BlockType == FormBlockTypes.MultiChoice)
                                    {
                                        <div class="sap-extra-choices" role="group" aria-label="@block.Title">
                                            @foreach (var opt in block.Options)
                                            {
                                                var o = opt;
                                                var on = ExtraHasValue(block.Id, o.OptionValue);
                                                <label class="sap-extra-choice @(on ? "sap-extra-choice--on" : "")">
                                                    <input type="checkbox" checked="@on"
                                                           @onchange="() => ExtraToggleMulti(block.Id, o.OptionValue)" />
                                                    <span>@o.OptionLabel</span>
                                                </label>
                                            }
                                        </div>
                                    }
                                    else if (block.BlockType == FormBlockTypes.Rating)
                                    {
                                        <div class="sap-extra-scale" role="group" aria-label="@block.Title">
                                            @for (int v = 1; v <= scale; v++)
                                            {
                                                var val = v;
                                                var on  = ExtraNumber(block.Id) == val;
                                                <button type="button"
                                                        class="sap-extra-scale-btn @(on ? "sap-extra-scale-btn--on" : "")"
                                                        aria-pressed="@(on ? "true" : "false")"
                                                        @onclick="() => ExtraSetNumber(block.Id, val)">@val</button>
                                            }
                                        </div>
                                        @if (!string.IsNullOrWhiteSpace(block.MinLabel) ||
                                             !string.IsNullOrWhiteSpace(block.MaxLabel))
                                        {
                                            <div class="sap-extra-scale-labels">
                                                <span>@block.MinLabel</span>
                                                <span>@block.MaxLabel</span>
                                            </div>
                                        }
                                    }
                                    else
                                    {
                                        <textarea class="sap-textarea" rows="3"
                                                  placeholder="כתבו את תשובתכם כאן"
                                                  value="@ExtraText(block.Id)"
                                                  @oninput="e => ExtraSetText(block.Id, e.Value?.ToString() ?? string.Empty)"></textarea>
                                    }
                                </div>
                            }
                        }
                    </div>
                </MCard>
            }

            <!-- ── Footer ── -->
            <div class="sap-footer">
                <div class="sap-validation-hints">
                    <span class="sap-hint @(TeamReady ? "sap-hint--ok" : "sap-hint--missing")">
                        @(TeamReady ? "✓" : "○") 2 חברות צוות
                    </span>
                    <span class="sap-hint @(_preferences.Count == 3 ? "sap-hint--ok" : "sap-hint--missing")">
                        @(_preferences.Count == 3 ? "✓" : "○") 3 פרויקטים נבחרו
                    </span>
                </div>
                @if (!string.IsNullOrEmpty(_submitError))
                {
                    <span class="sap-error-msg">⚠ @_submitError</span>
                }
                <button class="sap-submit-btn motiva-cta" @onclick="HandleSubmit"
                        disabled="@(_submitting || !CanSubmit)">
                    @if (_submitting)
                    {
                        <div class="sap-btn-spinner"></div>
                        <span>שולחת…</span>
                    }
                    else
                    {
                        <span class="oi oi-check" aria-hidden="true"></span>
                        <span>@(_ctx.ExistingSubmission is not null ? "שמירת עדכון" : "הגשת הטופס")</span>
                    }
                </button>
            </div>

        </div>
    }

</div>

@code {

    private static int    ParseInt(string? s) => int.TryParse(s, out var v) ? v : 0;
    private static string Truncate(string text, int max) => text.Length <= max ? text : text[..max] + "…";
    private static string FormatDate(string iso) => iso.Length >= 10 ? iso[..10] : iso;

    // ── Presentation from the real form ──────────────────────────────────────
    //
    // The labels used to live here as a static array, which is precisely why an
    // admin editing the Strengths block in the form editor changed nothing on
    // this page. They now come from the block. What stays hardcoded is only the
    // ICON, keyed by the MACHINE VALUE — a stable literal the server refuses to
    // let anyone rename — so a reworded label keeps its icon and an unknown
    // value simply gets none.
    private static readonly Dictionary<string, string> StrengthIcons = new()
    {
        ["Design"]            = "🎨",
        ["Content"]           = "✍",
        ["Technology"]        = "💻",
        ["ProjectManagement"] = "📋",
    };

    private static string StrengthIcon(string value) =>
        StrengthIcons.TryGetValue(value, out var icon) ? icon : "";

    private AssignmentFormLayoutDto? Layout => _ctx?.FormLayout;

    /// <summary>
    /// The strength choices as the admin configured them. Falls back to the
    /// four canonical values when no form row exists yet (legacy installs), so
    /// the page can never render an empty strengths section.
    /// </summary>
    private IReadOnlyList<FormBlockOptionDto> StrengthChoices
    {
        get
        {
            var opts = Layout?.Strengths?.Options;
            if (opts is { Count: > 0 }) return opts;

            return FormBlockKeys.ProtectedStrengthValues
                .Select(v => new FormBlockOptionDto { OptionValue = v, OptionLabel = v })
                .ToList();
        }
    }

    /// <summary>Block text with a fallback, so a blank field never blanks the page.</summary>
    private static string Text(string? value, string fallback) =>
        string.IsNullOrWhiteSpace(value) ? fallback : value!;

    private string StrengthsTitle    => Text(Layout?.Strengths?.Title,      "חוזקות הצוות");
    private string StrengthsHelp     => Text(Layout?.Strengths?.HelperText, "סמנו את תחומי הכישרון של כל חברת צוות");
    private bool   StrengthsRequired => Layout?.Strengths?.IsRequired ?? false;

    private string PreferencesTitle  => Text(Layout?.Preferences?.Title,      "העדפות פרויקט");
    private string PreferencesHelp   => Text(Layout?.Preferences?.HelperText, "בחרי 3 פרויקטים לפי סדר עדיפות (חובה)");

    private string NotesTitle        => Text(Layout?.Notes?.Title,      "הערות נוספות");
    private string NotesHelp         => Text(Layout?.Notes?.HelperText, "מידע נוסף לצוות הקורס (אופציונלי)");
    private bool   NotesRequired     => Layout?.Notes?.IsRequired ?? false;

    private List<FormBlockDto> ExtraQuestions => Layout?.ExtraQuestions ?? new();

    private string GetStrengthLabel(string key) =>
        StrengthChoices.FirstOrDefault(o => o.OptionValue == key)?.OptionLabel ?? key;

    private static string GetStrengthIcon(string key) => StrengthIcon(key);

    // ── Answers to the admin-added questions ─────────────────────────────────
    // Held separately from the domain state on purpose: these never touch
    // TeamProjectPreferences or StudentStrengths.
    private readonly Dictionary<int, List<string>> _extraChoices = new();
    private readonly Dictionary<int, string>       _extraTexts   = new();
    private readonly Dictionary<int, int>          _extraNumbers = new();

    private bool ExtraHasValue(int blockId, string value) =>
        _extraChoices.TryGetValue(blockId, out var list) && list.Contains(value);

    private void ExtraPickSingle(int blockId, string value) =>
        _extraChoices[blockId] = new List<string> { value };

    private void ExtraToggleMulti(int blockId, string value)
    {
        if (!_extraChoices.TryGetValue(blockId, out var list))
        {
            list = new List<string>();
            _extraChoices[blockId] = list;
        }
        if (!list.Remove(value)) list.Add(value);
    }

    private string ExtraText(int blockId)   => _extraTexts.TryGetValue(blockId, out var t) ? t : "";
    private void   ExtraSetText(int blockId, string v) => _extraTexts[blockId] = v;

    private int?   ExtraNumber(int blockId) => _extraNumbers.TryGetValue(blockId, out var n) ? n : null;
    private void   ExtraSetNumber(int blockId, int v)  => _extraNumbers[blockId] = v;

    /// <summary>Seeds the extra-question state from answers already submitted.</summary>
    private void HydrateExtraAnswers(ExistingAssignmentDto? existing)
    {
        _extraChoices.Clear();
        _extraTexts.Clear();
        _extraNumbers.Clear();

        if (existing is null) return;

        foreach (var a in existing.ExtraAnswers)
        {
            if (a.OptionValues.Count > 0)      _extraChoices[a.FormBlockId] = new List<string>(a.OptionValues);
            if (!string.IsNullOrEmpty(a.Text)) _extraTexts[a.FormBlockId]   = a.Text!;
            if (a.Number is not null)          _extraNumbers[a.FormBlockId] = a.Number.Value;
        }
    }

    /// <summary>
    /// The first unanswered required question, or null. The server validates
    /// too and is the authority; this exists so the student is told which
    /// question is missing before a round trip.
    /// </summary>
    private string? FirstMissingRequired()
    {
        if (StrengthsRequired && !_strengths.Any(kv => kv.Value.Count > 0))
            return $"יש לבחור לפחות תחום אחד ב\"{StrengthsTitle}\".";

        if (NotesRequired && string.IsNullOrWhiteSpace(_notes))
            return $"יש למלא את \"{NotesTitle}\".";

        foreach (var q in ExtraQuestions)
        {
            if (!q.IsRequired || FormBlockTypes.IsInformational(q.BlockType)) continue;

            bool answered =
                FormBlockTypes.IsRating(q.BlockType)   ? ExtraNumber(q.Id) is > 0 :
                FormBlockTypes.HasOptions(q.BlockType) ? _extraChoices.TryGetValue(q.Id, out var c) && c.Count > 0 :
                                                         !string.IsNullOrWhiteSpace(ExtraText(q.Id));

            if (!answered) return $"יש לענות על השאלה \"{q.Title}\".";
        }

        return null;
    }

    private List<FormAnswerInputDto> BuildExtraAnswers() =>
        ExtraQuestions
            .Where(q => !FormBlockTypes.IsInformational(q.BlockType))
            .Select(q => new FormAnswerInputDto
            {
                FormBlockId  = q.Id,
                OptionValues = _extraChoices.TryGetValue(q.Id, out var c) ? c : new List<string>(),
                Text         = _extraTexts.TryGetValue(q.Id, out var t) ? t : null,
                Number       = _extraNumbers.TryGetValue(q.Id, out var n) ? n : null
            })
            .ToList();

    private AssignmentCatalogItemDto? FindProject(int id) =>
        _ctx?.Catalog.FirstOrDefault(p => p.Id == id);

    // ── State ────────────────────────────────────────────────────────────────

    private AssignmentContextDto? _ctx;
    private bool   _loading       = true;
    private bool   _submitting    = false;
    private bool   _justSubmitted = false;   // true only immediately after this session's submit
    private bool   _editMode      = true;    // false = show summary; true = show editable form
    private string _submitError   = "";

    private readonly HashSet<int>                   _selectedPartnerIds = new();
    private string                                  _partnerSearch      = "";
    private readonly Dictionary<int, HashSet<string>> _strengths        = new();
    private readonly Dictionary<int, int>           _preferences        = new();
    private bool   _hasOwnProject        = false;
    private string _ownProjectDescription = "";
    private string _notes                = "";

    private bool TeamReady => _ctx?.HasTeam == true || _selectedPartnerIds.Count == 1;
    private bool CanSubmit => TeamReady && _preferences.Count == 3 && (_ctx?.FormStatus?.CanSubmit ?? true);

    private IEnumerable<StudentBasicDto> FilteredPartners =>
        _ctx?.AvailableStudents
            .Where(s => string.IsNullOrWhiteSpace(_partnerSearch) ||
                        s.FullName.Contains(_partnerSearch, StringComparison.OrdinalIgnoreCase))
        ?? Enumerable.Empty<StudentBasicDto>();

    private IEnumerable<(int Id, string FullName)> AllTeamMembers
    {
        get
        {
            if (_ctx is null) yield break;
            if (_ctx.HasTeam)
            {
                foreach (var m in _ctx.TeamMembers)
                    yield return (m.UserId, m.FullName);
            }
            else
            {
                yield return (_ctx.Me.Id, _ctx.Me.FullName);
                foreach (var pid in _selectedPartnerIds)
                {
                    var s = _ctx.AvailableStudents.FirstOrDefault(x => x.Id == pid);
                    if (s is not null) yield return (s.Id, s.FullName);
                }
            }
        }
    }

    // ── Lifecycle ────────────────────────────────────────────────────────────

    protected override async Task OnInitializedAsync()
    {
        _ctx     = await AssignmentSvc.GetContextAsync();
        _loading = false;

        if (_ctx?.ExistingSubmission is { } ex)
        {
            // Already submitted → open in summary view
            _editMode = false;
            PopulateFromSubmission(ex);
        }

        if (_ctx?.HasTeam == true)
            foreach (var m in _ctx.TeamMembers)
                _strengths[m.UserId] = new HashSet<string>(m.Strengths);
        else if (_ctx is not null)
            _strengths[_ctx.Me.Id] = new();
    }

    private void PopulateFromSubmission(ExistingAssignmentDto ex)
    {
        _hasOwnProject         = ex.HasOwnProject;
        _ownProjectDescription = ex.OwnProjectDescription;
        _notes                 = ex.Notes;
        _preferences.Clear();
        foreach (var pref in ex.Preferences)
            _preferences[pref.Priority] = pref.ProjectId;

        // Every load path funnels through here, so the admin-added questions
        // are restored wherever the domain answers are.
        HydrateExtraAnswers(ex);
    }

    private void EnterEditMode()
    {
        _submitError   = "";
        _justSubmitted = false;
        _editMode      = true;

        // Re-sync strengths from current team context in case they were updated
        if (_ctx?.HasTeam == true)
        {
            _strengths.Clear();
            foreach (var m in _ctx.TeamMembers)
                _strengths[m.UserId] = new HashSet<string>(m.Strengths);
        }

        HydrateExtraAnswers(_ctx?.ExistingSubmission);
    }

    // ── Partner / strength helpers ───────────────────────────────────────────

    private void TogglePartner(int studentId)
    {
        if (_selectedPartnerIds.Contains(studentId))
        {
            _selectedPartnerIds.Remove(studentId);
            _strengths.Remove(studentId);
        }
        else if (_selectedPartnerIds.Count < 1)
        {
            _selectedPartnerIds.Add(studentId);
            _strengths[studentId] = new();
        }
    }

    private void RemovePartner(int studentId)
    {
        _selectedPartnerIds.Remove(studentId);
        _strengths.Remove(studentId);
    }

    private void ToggleStrength(int userId, string strength)
    {
        if (!_strengths.ContainsKey(userId)) _strengths[userId] = new();
        if (!_strengths[userId].Remove(strength)) _strengths[userId].Add(strength);
    }

    private int  GetPreference(int priority) => _preferences.TryGetValue(priority, out var id) ? id : 0;
    private void SetPreference(int priority, int projectId)
    {
        if (projectId == 0) _preferences.Remove(priority);
        else                _preferences[priority] = projectId;
    }

    // ── Submit ───────────────────────────────────────────────────────────────

    private async Task HandleSubmit()
    {
        _submitError = "";

        if (!TeamReady)  { _submitError = "יש לבחור שותפה אחת לצוות לפני ההגשה";          return; }
        if (_preferences.Count < 3) { _submitError = "יש לבחור 3 פרויקטים לפני ההגשה"; return; }

        // Requirements the admin configured on the form. Checked here so the
        // student sees which question is missing; the server checks the same
        // things and is the authority.
        if (FirstMissingRequired() is { } missing) { _submitError = missing; return; }

        _submitting = true;

        var strengthsList = new List<StudentStrengthDto>();
        foreach (var (uid, set) in _strengths)
            foreach (var s in set)
                strengthsList.Add(new StudentStrengthDto { UserId = uid, Strength = s });

        var res = await AssignmentSvc.SubmitAsync(new SubmitAssignmentRequest
        {
            PartnerIds            = _selectedPartnerIds.ToList(),
            Strengths             = strengthsList,
            Preferences           = _preferences.Select(kv => new ProjectPreferenceDto { Priority = kv.Key, ProjectId = kv.Value }).ToList(),
            HasOwnProject         = _hasOwnProject,
            OwnProjectDescription = _ownProjectDescription,
            Notes                 = _notes,
            // Same request, one student action — but the server routes these to
            // FormAnswers rather than to the domain tables.
            ExtraAnswers          = BuildExtraAnswers()
        });

        _submitting = false;

        if (res.Ok)
        {
            // Reload context so summary has fresh data (team members + strengths + preferences)
            _ctx           = await AssignmentSvc.GetContextAsync();
            _justSubmitted = true;
            _editMode      = false;   // switch to summary view

            if (_ctx?.ExistingSubmission is { } ex)
                PopulateFromSubmission(ex);

            if (_ctx?.HasTeam == true)
            {
                _strengths.Clear();
                foreach (var m in _ctx.TeamMembers)
                    _strengths[m.UserId] = new HashSet<string>(m.Strengths);
            }
        }
        else
        {
            _submitError = string.IsNullOrWhiteSpace(res.Error)
                ? "שגיאה בהגשה. אנא נסי שנית."
                : res.Error!;
        }
    }
}
