@namespace AuthWithAdmin.Client.Pages.Student
@using AuthWithAdmin.Shared.AuthSharedModels
@using AuthWithAdmin.Client.Services
@using AuthWithAdmin.Client.Components
@inject INotificationPreferencesService NotificationPrefs

@*
    StudentProfileNotificationsCard — "העדפות"
    Visual source: Motiva Student Profile final.dc.html:104-115.

    The reference's preferences section is a flat list of switch rows with no
    group headings. That shape is reproduced, with one deliberate reduction:
    the reference gives every row a second, explanatory line under its title,
    and this card does not. Seven real preferences with seven descriptions
    read as a wall of small grey text and made the card twice the height of
    anything beside it; the titles already say what each switch does. Title +
    switch, one line per row.

    The CONTENT is not the reference's either: its four toggles are prototype
    state on a `prefs: { req, digest, remind, gsync }` object in the design
    file's own script, and three of the four have nothing in this product
    behind them.

    ── WHAT IS RENDERED ─────────────────────────────────────────────────────
    Exactly what GET /api/users/me/notification-preferences returns for the
    signed-in student, written back through PUT to the same endpoint. The
    server decides which types a student may receive at all
    (NotificationTypes.ForRoles → _studentTypes), so this card renders that
    list and nothing else — nothing invented, nothing disabled-and-decorative.

    Email only, which is what every one of these switches actually controls.
    Each item's InAppEnabled value is loaded and written back untouched, so
    this card cannot clobber the in-app preferences the staff settings page
    still edits.

    ── THE THREE REFERENCE TOGGLES THAT ARE NOT HERE ────────────────────────
    None of them is faked as a local-only switch, and none of them was added
    to the backend — each would be a real feature, not a preference:

      * "תזכורות לפני מפגשים" — a reminder an hour before a calendar event.
        There is no NotificationType for a meeting reminder and no scheduler
        that emits one; the only time-based jobs in the system are the
        due-soon / overdue sweeps over tasks and milestones.

      * "סיכום שבועי באימייל" — a periodic digest. A digest type DOES exist
        (NotificationTypes.MentorDailyDigest) and is deliberately mentor-only
        and DAILY: nothing generates a weekly student summary, so the switch
        would control nothing.

      * "סנכרון אירועים ליומן Google" — a per-user sync flag. The real
        integration is per-EVENT: a student schedules an individual task into
        their calendar (POST /api/google-calendar/tasks/{id}). The legacy
        UserPreferences.GoogleCalendarConnected column is not a sync
        preference either — it is a checkbox a user could tick without ever
        authorizing anything, which is exactly why GoogleCalendarStatusDto
        documents the OAuth grant as the source of truth instead. The real
        connection lives in שירותים מחוברים, one card down.

    Conversely the backend exposes types the reference did not draw (task
    assignment, overdue, assignment publication); those DO appear, because
    hiding a working preference would silently strand it.

    ── ORDER ───────────────────────────────────────────────────────────────
    Requests and tasks first (what the student has to act on), then
    submissions, milestones and assignments (what comes back to them). The
    map is keyed by the real NotificationTypes.Groups constants and is
    display-only: it adds no type, hides no type, and a type in a group it
    does not name still renders — it falls to the end rather than vanishing.
*@

<MCard Padding="MCard.CardPadding.None">
    <div class="spf-pr">
        <div class="spf-pr-head">
            <h2 class="spf-pr-title">העדפות</h2>

            <span class="spf-pr-status" aria-live="polite">
                @if (_saving)
                {
                    <span class="spf-pr-spinner" aria-hidden="true"></span>
                }
                else if (_saved)
                {
                    <span class="spf-pr-saved">נשמר</span>
                }
                else if (_saveError)
                {
                    <span class="spf-pr-failed">השמירה נכשלה</span>
                }
            </span>
        </div>

        @if (_loading)
        {
            <p class="spf-pr-note">טוענת העדפות…</p>
        }
        else if (_loadError)
        {
            <p class="spf-pr-note spf-pr-note-error">שגיאה בטעינת העדפות ההתראות.</p>
        }
        else if (_items.Count == 0)
        {
            <MEmptyState Title="אין העדפות להצגה"
                         Description="לא הוגדרו עבורך סוגי התראות במערכת." />
        }
        else
        {
            @foreach (var item in _items)
            {
                var captured = item;
                var label    = LabelFor(captured.NotificationType);

                <div class="spf-pr-row">
                    <p class="spf-pr-row-title">@label</p>

                    @* No Class here: a class passed to a child component
                       lands on that component's root, which carries ITS scope
                       id and no rule in this file can ever match. The toggle
                       is pushed to the row's end by the title taking the
                       remaining space instead. *@
                    <MToggle Checked="captured.EmailEnabled"
                             AriaLabel="@($"קבלת מייל — {label}")"
                             Disabled="_saving"
                             CheckedChanged="@(v => OnToggledAsync(captured, v))" />
                </div>
            }
        }
    </div>
</MCard>

@code {
    private NotificationPreferencesDto? _prefs;

    private bool _loading = true;
    private bool _loadError;
    private bool _saving;
    private bool _saved;
    private bool _saveError;

    /// <summary>The switches in display order — see the header note. Flat, as
    /// the reference draws them.</summary>
    private List<NotificationPreferenceItemDto> _items = new();

    /// <summary>Group order for the flat list. Presentation only; the
    /// backend's own five groups are untouched.</summary>
    private static readonly string[] GroupOrder =
    {
        NotificationTypes.Groups.Requests,
        NotificationTypes.Groups.Tasks,
        NotificationTypes.Groups.Submissions,
        NotificationTypes.Groups.Milestones,
        NotificationTypes.Groups.Assignments,
    };

    /// <summary>Student-voiced labels for the canonical NotificationTypes.
    ///
    /// <para>The shared <see cref="NotificationTypes.Label"/> strings are
    /// role-neutral ("שיוך משימה") because staff read the same list; the
    /// reference writes the student's copy in the first person about their own
    /// work. This map is presentation only — it is keyed by the real type
    /// constants, adds no types, and falls back to the shared label for
    /// anything it does not cover, so a future backend type still renders
    /// correctly here without a code change.</para></summary>
    private static readonly Dictionary<string, string> StudentLabels = new()
    {
        [NotificationTypes.RequestCommentAdded]        = "תגובה חדשה לבקשה",
        [NotificationTypes.RequestStatusChanged]       = "עדכון סטטוס בבקשה שלי",
        [NotificationTypes.TaskAssigned]               = "שיוך משימה חדשה",
        [NotificationTypes.TaskDueSoon]                = "משימה שמתקרבת למועד ההגשה",
        [NotificationTypes.TaskOverdue]                = "משימה שעברה את מועד ההגשה",
        [NotificationTypes.SubmissionFeedbackReceived] = "התקבל משוב על הגשה",
        [NotificationTypes.AssignmentPublished]        = "פרסום שיבוצים",
    };

    private static string LabelFor(string type) =>
        StudentLabels.TryGetValue(type, out var label) ? label : NotificationTypes.Label(type);

    protected override async Task OnInitializedAsync()
    {
        var prefs = await NotificationPrefs.GetMineAsync();

        if (prefs is null) _loadError = true;
        else
        {
            _prefs = prefs;
            Reorder();
        }

        _loading = false;
    }

    /// <summary>The server sends the group with each item; GroupOf is only the
    /// fallback for a payload that left it blank.</summary>
    private static string GroupKeyOf(NotificationPreferenceItemDto item) =>
        string.IsNullOrEmpty(item.Group)
            ? NotificationTypes.GroupOf(item.NotificationType)
            : item.Group;

    private void Reorder()
    {
        _items = new();
        if (_prefs is null) return;

        var ordered = new HashSet<string>(GroupOrder, StringComparer.Ordinal);

        foreach (var key in GroupOrder)
            _items.AddRange(_prefs.Items.Where(it => GroupKeyOf(it) == key));

        // A preference this map does not name is still a real, working
        // preference — it lands at the end rather than being silently
        // dropped, which is the same rule the card already applies to labels
        // it does not know (see LabelFor).
        _items.AddRange(_prefs.Items.Where(it => !ordered.Contains(GroupKeyOf(it))));
    }

    /// <summary>Optimistic per-toggle save — the reference's card has no save
    /// button, so the switch itself is the commit. The previous value is
    /// restored if the write fails, so the UI can never claim a preference
    /// was stored when it was not.</summary>
    private async Task OnToggledAsync(NotificationPreferenceItemDto item, bool value)
    {
        var previous = item.EmailEnabled;

        item.EmailEnabled = value;
        _saving    = true;
        _saved     = false;
        _saveError = false;

        // The endpoint upserts by (UserId, NotificationType), so sending the
        // full list is idempotent — and it carries every item's untouched
        // InAppEnabled straight back, which is what keeps the in-app
        // preferences this card does not show from being reset.
        var ok = await NotificationPrefs.SaveMineAsync(new SaveNotificationPreferencesRequest
        {
            Items = _prefs!.Items,
        });

        _saving = false;

        if (ok)
        {
            _saved = true;
            _ = ClearSavedFlagAsync();
        }
        else
        {
            item.EmailEnabled = previous;
            _saveError        = true;
        }
    }

    private async Task ClearSavedFlagAsync()
    {
        await Task.Delay(2200);
        _saved = false;
        await InvokeAsync(StateHasChanged);
    }
}
