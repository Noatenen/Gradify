@namespace AuthWithAdmin.Client.Pages.Student
@using AuthWithAdmin.Shared.AuthSharedModels
@using AuthWithAdmin.Client.Services
@using Microsoft.AspNetCore.Components.Forms
@inject IStudentProfileService ProfileService

@*
    StudentProfileIdentityHero — the final screen's identity row
    (Motiva Student Profile final.dc.html:52-58).

    NOT A CARD, and that is the change from the previous build. The final
    design does not give this band a surface, a wash or an edge: it is a
    64px avatar, an h1 and one muted line, sitting directly on the canvas
    between the nav bar and the content grid. The card it used to be was
    inherited from the older Motiva Profile board and is superseded.

    IDENTITY ONLY. The reference draws no field and no control here, and
    neither does this — the email/phone editors live in
    StudentProfilePersonalCard, where an editable value belongs.

    The one addition to the reference is the avatar's own upload / remove
    overlay. PUT and DELETE /api/student/me/avatar are real, working
    endpoints; the reference simply draws a static initials chip because
    its user is a prototype. Removing a working feature to match a
    prototype would be a regression, so the controls stay — invisible at
    rest, revealed on hover or keyboard focus, exactly the size of the
    chip the reference draws.

    The context line is real: the role label the app already computes
    (RoleService), and nothing else. It states no fact the product does not
    already state elsewhere, and it invents nothing — the reference's
    "מכינת עתיד, מחזור 2026" is demo copy with no column behind it.

    The team used to be appended here as "· צוות 15". It was removed: the
    team is named twice on this very screen already — הצוות שלי carries the
    project title, the team name and every member — so a third copy under
    the student's own name said nothing new and made the identity line read
    as a breadcrumb rather than as who this person is.
*@

<header class="spf-hero">

    @* ── Avatar ───────────────────────────────────────────────── *@
    <div class="spf-avatar-wrap">
        @if (!string.IsNullOrEmpty(Profile.ProfileImageUrl))
        {
            <img class="spf-avatar-img" src="@Profile.ProfileImageUrl" alt="" />
        }
        else
        {
            <div class="spf-avatar-initials" aria-hidden="true">@Initials</div>
        }

        <label class="spf-avatar-overlay" for="spf-avatar-input" title="החלפת תמונת פרופיל">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"></path>
                <circle cx="12" cy="13" r="4"></circle>
            </svg>
            <span class="spf-sr-only">החלפת תמונת פרופיל</span>
        </label>

        @* The wrapper does the hiding, not a class on InputFile itself:
           InputFile renders its own <input> root, which does not carry this
           component's CSS-isolation scope attribute, so a class passed to it
           would match no rule and the native "choose file" control would show
           up in the middle of the identity row. *@
        <div class="spf-avatar-input-wrap">
            <InputFile id="spf-avatar-input"
                       OnChange="HandleAvatarUploadAsync"
                       accept="image/jpeg,image/png,image/webp" />
        </div>

        @if (!string.IsNullOrEmpty(Profile.ProfileImageUrl))
        {
            <button type="button"
                    class="spf-avatar-remove"
                    title="הסרת תמונת פרופיל"
                    aria-label="הסרת תמונת פרופיל"
                    disabled="@_avatarBusy"
                    @onclick="RemoveAvatarAsync">
                <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M6 6l12 12M18 6 6 18"></path>
                </svg>
            </button>
        }

        @if (_avatarBusy)
        {
            <span class="spf-avatar-busy" aria-hidden="true"></span>
        }
    </div>

    @* ── Identity ─────────────────────────────────────────────── *@
    <div class="spf-hero-body">
        <h1 class="spf-hero-name">@FullName</h1>

        @if (IdentityLine is not null)
        {
            <p class="spf-hero-context">@IdentityLine</p>
        }

        @if (_avatarError is not null)
        {
            <p class="spf-hero-error" role="alert">@_avatarError</p>
        }
    </div>
</header>

@code {
    /// <summary>The loaded student profile. Mutated in place on a successful
    /// avatar write so the parent page and this row never disagree about the
    /// current image.</summary>
    [Parameter, EditorRequired] public StudentProfileDto Profile { get; set; } = default!;

    /// <summary>Raised after any successful write so the page can re-render.</summary>
    [Parameter] public EventCallback OnProfileChanged { get; set; }

    /// <summary>Cascades in from App.razor — the same instance SettingsPage
    /// used to decide this is a student at all. Read only for the role
    /// label.</summary>
    [CascadingParameter] private User? _user { get; set; }

    private const long MaxAvatarBytes = 3 * 1024 * 1024;

    private bool    _avatarBusy;
    private string? _avatarError;

    private string FullName => $"{Profile.FirstName} {Profile.LastName}".Trim();

    /// <summary>The role label alone, e.g. "סטודנט". Null — and the line is
    /// not rendered at all — when the cascade has not resolved a role yet, so
    /// the row shows a clean name rather than an empty caption.
    ///
    /// <para>The team is deliberately NOT part of this line: הצוות שלי on the
    /// same screen already names the project, the team and every member.</para></summary>
    private string? IdentityLine
    {
        get
        {
            var role = RoleService.GetRoleLabel(_user);
            return string.IsNullOrWhiteSpace(role) ? null : role;
        }
    }

    private string Initials
    {
        get
        {
            var first = Profile.FirstName?.Trim() ?? "";
            var last  = Profile.LastName?.Trim()  ?? "";
            if (first.Length == 0 && last.Length == 0) return "?";
            return (first.Length > 0 ? first[0].ToString() : "")
                 + (last.Length  > 0 ? last[0].ToString()  : "");
        }
    }

    // ── Avatar ───────────────────────────────────────────────────────────

    private async Task HandleAvatarUploadAsync(InputFileChangeEventArgs e)
    {
        var file = e.File;
        _avatarError = null;

        if (file.Size > MaxAvatarBytes)
        {
            _avatarError = "התמונה גדולה מדי. הגודל המרבי הוא 3MB.";
            return;
        }

        _avatarBusy = true;

        try
        {
            using var ms = new System.IO.MemoryStream();
            await file.OpenReadStream(maxAllowedSize: MaxAvatarBytes).CopyToAsync(ms);

            var base64 = Convert.ToBase64String(ms.ToArray());
            var ext    = System.IO.Path.GetExtension(file.Name).TrimStart('.').ToLowerInvariant();

            if (await ProfileService.UploadAvatarAsync(base64, ext))
            {
                // Re-read rather than guessing the URL: the server names the
                // stored file itself, so the response path is the only
                // authoritative source for it.
                var updated = await ProfileService.GetProfileAsync();
                if (updated is not null)
                {
                    Profile.ProfileImageUrl = updated.ProfileImageUrl;
                    if (OnProfileChanged.HasDelegate) await OnProfileChanged.InvokeAsync();
                }
            }
            else
            {
                _avatarError = "העלאת התמונה נכשלה. נסי שנית.";
            }
        }
        catch
        {
            _avatarError = "העלאת התמונה נכשלה. נסי שנית.";
        }
        finally
        {
            _avatarBusy = false;
        }
    }

    private async Task RemoveAvatarAsync()
    {
        _avatarBusy  = true;
        _avatarError = null;

        if (await ProfileService.RemoveAvatarAsync())
        {
            Profile.ProfileImageUrl = null;
            if (OnProfileChanged.HasDelegate) await OnProfileChanged.InvokeAsync();
        }
        else
        {
            _avatarError = "הסרת התמונה נכשלה. נסי שנית.";
        }

        _avatarBusy = false;
    }
}
