@namespace AuthWithAdmin.Client.Pages.Settings
@using AuthWithAdmin.Shared.AuthSharedModels
@using AuthWithAdmin.Client.Services

@*
    StaffProfileIdentityHero — the Lecturer / Mentor / Admin identity row.

    THE STUDENT'S ROW, WITH ONE THING TAKEN OUT. StudentProfileIdentityHero is
    the approved shape — a 64px chip, an h1 and one muted line, on the canvas
    with no surface of its own — and every number here is read from the same
    tokens in the same order, because the two screens are one screen with two
    audiences and must not be told apart by their identity row.

    ── WHY THIS IS NOT THE STUDENT COMPONENT RENDERED AGAIN ─────────────────
    Two reasons, and neither is visual:

      * THE PAYLOAD. StudentProfileIdentityHero takes a StudentProfileDto,
        which comes from /api/student/me — [Authorize(Roles = Student)]. A
        lecturer cannot call it. This row takes UserProfileDto, from
        /api/users/me, which every authenticated role can.

      * THE AVATAR IS NOT EDITABLE HERE, and that is a product gap rather than
        a design decision. PUT and DELETE /api/student/me/avatar are the only
        avatar endpoints in the system and they carry the Student role
        attribute, so the upload overlay the student's chip wears would 403 for
        every user this row serves. Rendering a control that cannot succeed is
        worse than rendering none, so the chip here is exactly what the design
        file draws: a plain gradient initials chip, or the stored image when
        the user already has one (an admin can set one through user
        management, and users.ProfileImagePath is read for every role).

        The legacy /settings screen had the same gap and expressed it the same
        way — its camera overlay was `_isStudent`-gated. Nothing regressed in
        this migration; what changed is that the gap is now stated where a
        reader will find it.

    The context line is the role label RoleService already computes, and
    nothing else — same rule as the student's, for the same reason: a second
    fact here would make the line read as a breadcrumb rather than as who this
    person is.
*@

<header class="stf-hero">

    @* ── Avatar ───────────────────────────────────────────────── *@
    <div class="stf-avatar-wrap">
        @if (!string.IsNullOrEmpty(Profile.ProfileImageUrl))
        {
            <img class="stf-avatar-img" src="@Profile.ProfileImageUrl" alt="" />
        }
        else
        {
            <div class="stf-avatar-initials" aria-hidden="true">@Initials</div>
        }
    </div>

    @* ── Identity ─────────────────────────────────────────────── *@
    <div class="stf-hero-body">
        <h1 class="stf-hero-name">@FullName</h1>

        @if (IdentityLine is not null)
        {
            <p class="stf-hero-context">@IdentityLine</p>
        }
    </div>
</header>

@code {
    /// <summary>The loaded profile, from GET /api/users/me. Mutated in place
    /// by the personal-details card on a successful save, so this row and that
    /// card can never disagree about the current name.</summary>
    [Parameter, EditorRequired] public UserProfileDto Profile { get; set; } = default!;

    /// <summary>Cascades in from App.razor. Read only for the role label —
    /// the same source SettingsPage used to decide this is not a student.</summary>
    [CascadingParameter] private User? _user { get; set; }

    private string FullName => $"{Profile.FirstName} {Profile.LastName}".Trim();

    /// <summary>The role label alone, e.g. "מרצה". Null — and the line is not
    /// rendered at all — while the cascade has not resolved a role yet, so the
    /// row shows a clean name rather than an empty caption.</summary>
    private string? IdentityLine
    {
        get
        {
            var role = RoleService.GetRoleLabel(_user);
            return string.IsNullOrWhiteSpace(role) ? null : role;
        }
    }

    private string Initials
    {
        get
        {
            var first = Profile.FirstName?.Trim() ?? "";
            var last  = Profile.LastName?.Trim()  ?? "";
            if (first.Length == 0 && last.Length == 0) return "?";
            return (first.Length > 0 ? first[0].ToString() : "")
                 + (last.Length  > 0 ? last[0].ToString()  : "");
        }
    }
}
