@namespace AuthWithAdmin.Client.Pages.Settings
@using AuthWithAdmin.Shared.AuthSharedModels
@using AuthWithAdmin.Client.Services
@using AuthWithAdmin.Client.Components
@inject IGoogleCalendarService GoogleCalendar
@inject NavigationManager Nav

@*
    ProfileIntegrationsCard — "שירותים מחוברים"

    ROLE-NEUTRAL, and that is why it no longer lives under Pages/Student.
    Nothing in it is a student's: it takes no parameter, reads
    /api/google-calendar/status — which is per-USER and gated by no role —
    and writes through the same connect / disconnect endpoints for whoever
    is signed in. The Lecturer and Mentor profile renders this exact
    component, so the two screens cannot drift apart.

    Moved and re-namespaced only. Not one line of markup, style or
    behaviour changed in that move, so the student screen renders exactly
    what it rendered before.
    Visual source: Motiva Student Profile final.dc.html:142-164.

    One row, and the reference draws exactly one too: Google Calendar.
    Slack is not brought over — its row on the staff settings page is
    unchanged and this epic is not the place to re-home it.

    ── THE STATE IS NEVER INFERRED ──────────────────────────────────────────
    The reference hard-codes `gConnected: true` and prints a prototype
    address. Nothing here does either. Consent happens on accounts.google.com
    with this app unloaded, so the only thing that knows whether a grant
    exists is GET /api/google-calendar/status — which is what this reads on
    mount and again after every disconnect. The connected line shows the
    Google account the grant belongs to only when the status response carries
    it; a grant made without the identity scopes says "מחובר" and no address,
    because the alternative is printing one the server did not send.

    The connect action mints a fresh authorization URL per click
    (GET /api/google-calendar/connect-url) — the URL carries a single-use
    state that expires in minutes, so it is never cached or reused — and the
    disconnect action revokes through DELETE /api/google-calendar/disconnect.
    Both are the existing endpoints; this card adds no integration logic of
    its own.

    Disconnecting touches nothing about the Motiva session: the same page,
    the same token, still signed in.
*@

<MCard Padding="MCard.CardPadding.None">
    <div class="spf-int">
        <h2 class="spf-int-title">שירותים מחוברים</h2>

        @if (_loading)
        {
            <p class="spf-int-note">טוענת חיבורים…</p>
        }
        else
        {
            <div class="spf-int-row">
                <span class="spf-int-icon" aria-hidden="true">
                    <svg width="18" height="18" viewBox="0 0 24 24">
                        <rect x="3" y="4" width="18" height="17" rx="3" fill="none" stroke="currentColor" stroke-width="1.8"></rect>
                        <path d="M3 9h18" stroke="currentColor" stroke-width="1.8"></path>
                        <path d="M8 2v4M16 2v4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
                        <rect class="spf-int-icon-mark" x="7.5" y="12.5" width="4" height="4" rx="1"></rect>
                    </svg>
                </span>

                <div class="spf-int-text">
                    <p class="spf-int-name">Google Calendar</p>

                    @if (IsConnected)
                    {
                        <p class="spf-int-status">
                            <span class="spf-int-dot spf-int-dot-on" aria-hidden="true"></span>
                            @if (string.IsNullOrWhiteSpace(_status!.GoogleEmail))
                            {
                                <span>מחובר</span>
                            }
                            else
                            {
                                <span class="spf-int-status-label">מחובר כ־</span>
                                <span class="spf-int-account">@_status.GoogleEmail</span>
                            }
                        </p>
                    }
                    else
                    {
                        <p class="spf-int-status spf-int-status-off">
                            <span class="spf-int-dot" aria-hidden="true"></span>
                            <span>לא מחובר — משימות הפרויקט לא יסונכרנו ליומן</span>
                        </p>
                    }
                </div>

                @if (IsConnected)
                {
                    <button type="button"
                            class="spf-int-btn-ghost"
                            disabled="@_busy"
                            @onclick="DisconnectAsync">
                        @if (_busy)
                        {
                            <span class="spf-int-spinner" aria-hidden="true"></span>
                        }
                        <span>ניתוק</span>
                    </button>
                }
                else
                {
                    <button type="button"
                            class="spf-int-btn-connect motiva-cta"
                            disabled="@_busy"
                            @onclick="ConnectAsync">
                        @if (_busy)
                        {
                            <span class="spf-int-spinner spf-int-spinner-on-fill" aria-hidden="true"></span>
                        }
                        <span>חיבור</span>
                    </button>
                }
            </div>

            @if (_error is not null)
            {
                <p class="spf-int-note spf-int-note-error" role="alert">@_error</p>
            }
            else if (_justConnected)
            {
                <p class="spf-int-note spf-int-note-ok">Google Calendar חובר בהצלחה.</p>
            }
        }
    </div>
</MCard>

@code {
    private GoogleCalendarStatusDto? _status;

    private bool    _loading = true;
    private bool    _busy;
    private bool    _justConnected;
    private string? _error;

    private bool IsConnected => _status?.IsConnected == true;

    /// <summary>Hebrew copy for each coarse failure flag the callback can put on
    /// the return URL. The server never puts a reason, a token or an exception
    /// text in a query string, so these five flags are the whole vocabulary.</summary>
    private static string? ErrorMessageFor(string query) => query switch
    {
        var q when q.Contains("gcalError=denied")    => "החיבור ליומן Google בוטל.",
        var q when q.Contains("gcalError=state")     => "בקשת החיבור פגה. נסי שנית.",
        var q when q.Contains("gcalError=norefresh") => "Google לא החזירה הרשאה קבועה. נסי שנית ואשרי את הבקשה.",
        var q when q.Contains("gcalError=config")    => "האינטגרציה עם Google Calendar עדיין לא הוגדרה במערכת.",
        var q when q.Contains("gcalError=")          => "שגיאה בחיבור ליומן Google. נסי שנית.",
        _                                            => null,
    };

    protected override async Task OnInitializedAsync()
    {
        var query      = new Uri(Nav.Uri).Query;
        _justConnected = query.Contains("gcalConnected=true");
        _error         = ErrorMessageFor(query);

        _status  = await GoogleCalendar.GetStatusAsync();
        _loading = false;
    }

    private async Task ConnectAsync()
    {
        _busy  = true;
        _error = null;

        // Minted per click: the URL carries a single-use state that expires in
        // minutes, so it is never cached or reused.
        var url = await GoogleCalendar.GetConnectUrlAsync();
        _busy = false;

        if (url is not null)
            Nav.NavigateTo(url, forceLoad: true);
        else
            _error = "האינטגרציה עם Google Calendar עדיין לא הוגדרה במערכת.";
    }

    private async Task DisconnectAsync()
    {
        _busy          = true;
        _error         = null;
        _justConnected = false;

        var ok = await GoogleCalendar.DisconnectAsync();

        // Re-read instead of assuming. Disconnecting touches nothing about the
        // Motiva session — the same page, the same token, still signed in.
        if (ok) _status = await GoogleCalendar.GetStatusAsync();
        else    _error  = "הניתוק נכשל. נסי שנית.";

        _busy = false;
    }
}
