@page "/settings"
@layout AppLayout
@using Microsoft.AspNetCore.Authorization
@using AuthWithAdmin.Client.Pages.Student
@attribute [Authorize]

@*
    SettingsPage — owns the /settings route and nothing else.

    The route is shared by two entirely separate experiences:

      Student            -> StudentProfilePage, the finalized Motiva
                            "הפרופיל שלי" screen.
      Mentor / Lecturer
      / Admin            -> StaffSettingsPage, the previous /settings page,
                            carried over unchanged.

    Splitting here rather than branching inside one component keeps the two
    apart at every level — markup, scoped CSS, lifecycle and API calls — so
    the student rebuild cannot regress the staff screen, and neither panel
    loads the other's data.

    The URL is deliberately unchanged. Students already reach it from the
    sidebar profile footer, Mentor and Admin from their "הגדרות" nav item,
    and every one of those entry points keeps working untouched.
*@

@if (_user is null)
{
    @* _user cascades in asynchronously from App.razor and is null on the
       first render. Rendering nothing here — rather than defaulting to one
       of the two panels — is what stops a student briefly mounting the staff
       page and firing its /api/users/me + mentor-preferences calls before
       auth state resolves. *@
}
else if (RoleService.IsStudent(_user))
{
    <StudentProfilePage />
}
else
{
    <StaffSettingsPage />
}

@code {
    [CascadingParameter] private User? _user { get; set; }
}
