@page "/motiva/foundations"
@layout MotivaGalleryLayout
@using AuthWithAdmin.Client.Components.MotivaGallery

<PageTitle>Motiva Gallery · Foundations</PageTitle>

<h1 class="foundations-title">Foundations</h1>
<p class="foundations-intro">
    כל הערכים הבאים מוצגים ישירות מתוך <code>--motiva-*</code> ב-
    <code>motiva-tokens.css</code>. אין כאן ערכים כתובים ידנית — כל דוגמה
    צורכת את הטוקן עצמו דרך <code>var(...)</code>, כך שהיא תמיד תואמת את מה
    שרץ בפועל, כולל במצב Dark Mode.
</p>

<GallerySection Id="colors" Title="Colors"
                Description="פלטת המותג, משטחי ניטרל, היררכיית טקסט, גבולות וצבעים סמנטיים.">
    <div class="foundations-color-sheet">
    <div class="foundations-color-group">
    <h3>Brand palette</h3>
    <div class="foundations-grid foundations-grid-4">
        <TokenSwatch Name="Purple" TokenName="--motiva-color-purple" PreviewStyle="background: var(--motiva-color-purple);" />
        <TokenSwatch Name="Indigo" TokenName="--motiva-color-indigo" PreviewStyle="background: var(--motiva-color-indigo);" />
        <TokenSwatch Name="Blue" TokenName="--motiva-color-blue" PreviewStyle="background: var(--motiva-color-blue);" />
        <TokenSwatch Name="Teal" TokenName="--motiva-color-teal" PreviewStyle="background: var(--motiva-color-teal);" />
    </div>
    </div>

    <div class="foundations-color-group">
    <h3>Neutral surfaces</h3>
    <div class="foundations-grid foundations-grid-5">
        <TokenSwatch Name="App background" TokenName="--motiva-surface-app-bg" PreviewStyle="background: var(--motiva-surface-app-bg);" />
        <TokenSwatch Name="Primary surface" TokenName="--motiva-surface-primary" PreviewStyle="background: var(--motiva-surface-primary);" />
        <TokenSwatch Name="Secondary surface" TokenName="--motiva-surface-secondary" PreviewStyle="background: var(--motiva-surface-secondary);" />
        <TokenSwatch Name="Elevated surface" TokenName="--motiva-surface-elevated" PreviewStyle="background: var(--motiva-surface-elevated); box-shadow: var(--motiva-shadow-md);" />
        <TokenSwatch Name="Hover surface" TokenName="--motiva-surface-hover" PreviewStyle="background: var(--motiva-surface-hover);" />
    </div>
    </div>

    <div class="foundations-color-group">
    <h3>Text hierarchy</h3>
    <div class="foundations-grid foundations-grid-3">
        <TokenSwatch Name="Primary text" TokenName="--motiva-text-primary" PreviewStyle="background: var(--motiva-surface-primary); color: var(--motiva-text-primary); display:flex; align-items:center; justify-content:center; font-weight:700;" />
        <TokenSwatch Name="Secondary text" TokenName="--motiva-text-secondary" PreviewStyle="background: var(--motiva-surface-primary); color: var(--motiva-text-secondary); display:flex; align-items:center; justify-content:center; font-weight:700;" />
        <TokenSwatch Name="Muted text" TokenName="--motiva-text-muted" PreviewStyle="background: var(--motiva-surface-primary); color: var(--motiva-text-muted); display:flex; align-items:center; justify-content:center; font-weight:700;" />
    </div>
    </div>

    <div class="foundations-color-group">
    <h3>Borders</h3>
    <div class="foundations-grid foundations-grid-2">
        <TokenSwatch Name="Subtle border" TokenName="--motiva-border-subtle" PreviewStyle="background: var(--motiva-surface-primary); border: 2px solid var(--motiva-border-subtle);" />
        <TokenSwatch Name="Strong border" TokenName="--motiva-border-strong" PreviewStyle="background: var(--motiva-surface-primary); border: 2px solid var(--motiva-border-strong);" />
    </div>
    </div>

    <div class="foundations-color-group">
    <h3>Semantic colors</h3>
    <div class="foundations-grid foundations-grid-4">
        <TokenSwatch Name="Info" TokenName="--motiva-color-info / -bg" PreviewStyle="background: var(--motiva-color-info-bg); color: var(--motiva-color-info); display:flex; align-items:center; justify-content:center; font-weight:700; border-radius: var(--motiva-radius-full);" />
        <TokenSwatch Name="Success" TokenName="--motiva-color-success / -bg" PreviewStyle="background: var(--motiva-color-success-bg); color: var(--motiva-color-success); display:flex; align-items:center; justify-content:center; font-weight:700; border-radius: var(--motiva-radius-full);" />
        <TokenSwatch Name="Warning" TokenName="--motiva-color-warning / -bg" PreviewStyle="background: var(--motiva-color-warning-bg); color: var(--motiva-color-warning); display:flex; align-items:center; justify-content:center; font-weight:700; border-radius: var(--motiva-radius-full);" />
        <TokenSwatch Name="Danger" TokenName="--motiva-color-danger / -bg" PreviewStyle="background: var(--motiva-color-danger-bg); color: var(--motiva-color-danger); display:flex; align-items:center; justify-content:center; font-weight:700; border-radius: var(--motiva-radius-full);" />
    </div>
    </div>

    <div class="foundations-color-group">
    <h3>Disabled &amp; focus</h3>
    <div class="foundations-grid foundations-grid-2">
        <TokenSwatch Name="Disabled" TokenName="--motiva-color-disabled-bg/-text/-border"
                     PreviewStyle="background: var(--motiva-color-disabled-bg); color: var(--motiva-color-disabled-text); border: 1px solid var(--motiva-color-disabled-border); display:flex; align-items:center; justify-content:center; font-weight:700;" />
        <TokenSwatch Name="Focus ring" TokenName="--motiva-color-focus-ring"
                     PreviewStyle="background: var(--motiva-surface-primary); outline: 3px solid var(--motiva-color-focus-ring); outline-offset: -3px;" />
    </div>
    </div>
    </div>
</GallerySection>

<GallerySection Id="gradients" Title="Gradients"
                Description="שני גרדיאנטים בלבד — כל אחד עם ייעוד ברור וגבולות שימוש מפורשים.">
    <div class="foundations-grid foundations-grid-2">
        <TokenSwatch Name="Signature gradient" TokenName="--motiva-gradient-signature" PreviewStyle="background: var(--motiva-gradient-signature);" />
        <TokenSwatch Name="Ambient gradient" TokenName="--motiva-gradient-ambient" PreviewStyle="background: var(--motiva-gradient-ambient);" />
    </div>
    <MCard Variant="MCard.CardVariant.Default">
        <h3>שימוש מאושר</h3>
        <ul>
            <li><strong>Signature</strong> — כפתור CTA ראשי (<code>MButton</code> Primary), פס התקדמות (<code>MProgressBar</code>), אלמנט מיתוג יחיד למסך (למשל לוגו).</li>
            <li><strong>Ambient</strong> — רקע Hero (<code>MCard</code> Ambient), רקע חלק שקוף במסכי כניסה.</li>
        </ul>
        <h3>איפה אסור להשתמש</h3>
        <ul>
            <li>טקסט גוף, גבולות, או כל דבר שצריך להישאר קריא בגודל קטן.</li>
            <li>אלמנטים חוזרים לכל שורה (טבלה, רשימה) — הגרדיאנט יקרא כרעש ולא כזהות מותג אם הוא מופיע יותר מפעם אחת במסך.</li>
            <li>משטח שכבר נושא צבע סמנטי (info/success/warning/danger) — צבע סמנטי מתקשר מצב, הגרדיאנט מתקשר מותג. לא לערבב בין השניים.</li>
            <li>מצבי Disabled — תמיד <code>--motiva-color-disabled-*</code>, לעולם לא הגרדיאנט מעומעם.</li>
        </ul>
    </MCard>
</GallerySection>

<GallerySection Id="typography" Title="Typography"
                Description="סולם כותרות, טקסט גוף ומשקלי גופן — כל שורה מציגה את הטוקן כפי שהוא מתפקד בפועל.">
    <div class="type-spec-sheet">
        @foreach (var t in _typeSpecs)
        {
            <div class="type-spec-row">
                <div class="type-spec-glyph" style="@t.Style" aria-hidden="true">Aa</div>
                <div class="type-spec-meta">
                    <strong>@t.Name</strong>
                    <code>@t.SizeVar</code>
                    <span class="type-spec-facts">@t.FactsLabel</span>
                </div>
                <p class="type-spec-example" style="@t.Style">@t.Example</p>
            </div>
        }
    </div>

    <div class="type-weight-row">
        <span>משקלים:</span>
        <span style="font-weight: var(--motiva-font-weight-regular);">Regular 400</span>
        <span style="font-weight: var(--motiva-font-weight-medium);">Medium 500</span>
        <span style="font-weight: var(--motiva-font-weight-semibold);">Semibold 600</span>
        <span style="font-weight: var(--motiva-font-weight-bold);">Bold 700</span>
    </div>
</GallerySection>

<GallerySection Id="spacing" Title="Spacing" Description="סולם הריווח — מ-xs ועד 2xl.">
    <div class="foundations-spacing-list">
        @foreach (var s in _spacing)
        {
            <div class="foundations-spacing-row">
                <span class="foundations-spacing-name">@s.Name</span>
                <span class="foundations-spacing-bar" style="width: var(@s.Var);"></span>
                <code>@s.Var</code>
            </div>
        }
    </div>
</GallerySection>

<GallerySection Id="radius" Title="Radius" Description="רדיוסי הפינות הזמינים, על משטחי דוגמה.">
    <div class="foundations-grid foundations-grid-4">
        <TokenSwatch Name="Small" TokenName="--motiva-radius-sm" PreviewStyle="background: var(--motiva-color-info-bg); border-radius: var(--motiva-radius-sm);" />
        <TokenSwatch Name="Medium" TokenName="--motiva-radius-md" PreviewStyle="background: var(--motiva-color-info-bg); border-radius: var(--motiva-radius-md);" />
        <TokenSwatch Name="Large" TokenName="--motiva-radius-lg" PreviewStyle="background: var(--motiva-color-info-bg); border-radius: var(--motiva-radius-lg);" />
        <TokenSwatch Name="Extra large" TokenName="--motiva-radius-xl" PreviewStyle="background: var(--motiva-color-info-bg); border-radius: var(--motiva-radius-xl);" />
    </div>
</GallerySection>

<GallerySection Id="shadows" Title="Shadows" Description="שלוש רמות הגבהה — כל אחת על כרטיס נפרד.">
    <div class="foundations-grid foundations-grid-3">
        <div class="foundations-shadow-card" style="box-shadow: var(--motiva-shadow-sm);">Soft <code>--motiva-shadow-sm</code></div>
        <div class="foundations-shadow-card" style="box-shadow: var(--motiva-shadow-md);">Raised <code>--motiva-shadow-md</code></div>
        <div class="foundations-shadow-card" style="box-shadow: var(--motiva-shadow-lg);">Hero <code>--motiva-shadow-lg</code></div>
    </div>
</GallerySection>

<GallerySection Id="motion" Title="Motion"
                Description="שלוש מהירויות מעבר. ההדגמות מופעלות ביד ואינן לולאה אינסופית; prefers-reduced-motion מכבד אוטומטית על ידי motiva-base.css.">
    <div class="foundations-grid foundations-grid-3">
        @foreach (var m in _motion)
        {
            <div class="foundations-motion-demo">
                <div class="foundations-motion-box @(_motionActive == m.Key ? "is-active" : "")"
                     style="transition-duration: var(@m.DurationVar);"></div>
                <MButton Variant="MButton.ButtonVariant.Secondary" Size="MButton.ButtonSize.Small" OnClick="() => TriggerMotion(m.Key)">
                    הפעלה — @m.Label
                </MButton>
                <code>@m.DurationVar</code>
            </div>
        }
    </div>
</GallerySection>

<GallerySection Id="accessibility" Title="Accessibility"
                Description="עקרונות הבסיס: פוקוס נראה, מצב מושבת, ניגודיות ומקלדת.">
    <div class="foundations-grid foundations-grid-2">
        <MCard Variant="MCard.CardVariant.Default">
            <h3>Focus-visible</h3>
            <p>לחצו Tab כדי להגיע לכפתור הבא — הטבעת נעשית דרך <code>--motiva-color-focus-ring</code>, ולא מוסתרת אף פעם.</p>
            <MButton Variant="MButton.ButtonVariant.Secondary">כפתור לדוגמה</MButton>
        </MCard>
        <MCard Variant="MCard.CardVariant.Default">
            <h3>Disabled state</h3>
            <p>מצב מושבת משתמש תמיד ב-<code>--motiva-color-disabled-*</code>, לא ב-opacity בלבד.</p>
            <MButton Variant="MButton.ButtonVariant.Secondary" Disabled="true">כפתור מושבת</MButton>
        </MCard>
    </div>
    <MCard Variant="MCard.CardVariant.Default">
        <h3>ניגודיות וצבע סמנטי</h3>
        <p>צבע לעולם אינו האות היחיד. כל תגית סטטוס (<code>MStatusBadge</code>) מציגה תמיד גם טקסט — אין מצב שבו רק הצבע מעביר משמעות.</p>
        <h3>ציפיות מקלדת</h3>
        <ul>
            <li><code>MButton</code> — <code>&lt;button&gt;</code> סמנטי, פועל עם Enter/Space מהדפדפן.</li>
            <li><code>MCard</code> (Interactive) — <code>role="button"</code> + Enter/Space מטופלים ידנית.</li>
            <li><code>MModal</code> — Escape תמיד סוגר; פוקוס עובר לדיאלוג בפתיחה (אין עדיין Focus Trap מלא).</li>
        </ul>
    </MCard>
</GallerySection>

<GallerySection Id="rtl" Title="RTL"
                Description="דוגמת פריסה קומפקטית, יישור אייקון/טקסט וריווח לוגי.">
    <MCard Variant="MCard.CardVariant.Default">
        <div class="foundations-rtl-row">
            <span class="oi oi-star" aria-hidden="true"></span>
            <span>פריט לדוגמה עם אייקון לפני הטקסט</span>
            <MStatusBadge Variant="MStatusBadge.BadgeVariant.Success" Text="פעיל" />
        </div>
        <p>
            הריווח בין האייקון, הטקסט והתגית הוא <code>gap</code> (לוגי מטבעו),
            לא <code>margin-left</code>/<code>margin-right</code> — לכן הסדר
            מתהפך נכון תחת <code>dir="rtl"</code> ללא כלל CSS נפרד.
        </p>
        <p>
            כל ה-CSS החדש בגלריה זו נכתב עם תכונות לוגיות
            (<code>margin-inline-start</code>, <code>inset-inline-end</code>,
            <code>border-inline-start</code>, <code>text-align: start</code>)
            במקום <code>left</code>/<code>right</code> פיזיים, מלבד שני חריגים
            מתועדים: כיוון קוד (<code>CodeBlock</code>, שנשאר LTR כי הוא קוד),
            וזוויות הגרדיאנטים העיטוריים שאושרו כך במפורש ב-
            <code>MOTIVA_FOUNDATIONS.md</code>.
        </p>
    </MCard>
</GallerySection>

@code {
    // FactsLabel states the token's *current* resolved value as plain
    // informational text (weight/size/line-height) — the actual rendering
    // below always uses the token via var(...) in Style, never a literal;
    // the label is documentation, not a second source of truth.
    private sealed record TypeSpec(string Name, string SizeVar, string WeightVar, string LineHeightVar, string FactsLabel, string Example)
    {
        public string Style => $"font-size: var({SizeVar}); font-weight: var({WeightVar}); line-height: var({LineHeightVar});";
    }

    private readonly TypeSpec[] _typeSpecs =
    {
        new("Display H1", "--motiva-font-size-h1", "--motiva-font-weight-bold", "--motiva-line-height-tight",
            "Bold · 32px · LH 1.15", "לא אוסף של מסכים. מערכת עיצוב אחת."),
        new("Section H2", "--motiva-font-size-h2", "--motiva-font-weight-bold", "--motiva-line-height-heading",
            "Bold · 28px · LH 1.3", "Foundations"),
        new("Card H3", "--motiva-font-size-h3", "--motiva-font-weight-semibold", "--motiva-line-height-heading",
            "Semibold · 24px · LH 1.3", "פיתוח אב־טיפוס"),
        new("Subtitle H4", "--motiva-font-size-h4", "--motiva-font-weight-semibold", "--motiva-line-height-heading",
            "Semibold · 20px · LH 1.3", "שלב נוכחי"),
        new("Body", "--motiva-font-size-body", "--motiva-font-weight-regular", "--motiva-line-height-body",
            "Regular · 20px · LH 1.55", "משפט לדוגמה שממחיש איך פסקה ארוכה יותר מתנהגת בעברית וב-RTL."),
        new("Secondary", "--motiva-font-size-sm", "--motiva-font-weight-regular", "--motiva-line-height-body",
            "Regular · 14px · LH 1.55", "טקסט משני לפרטים נוספים ולתיאורים קצרים."),
        new("Caption", "--motiva-font-size-caption", "--motiva-font-weight-bold", "--motiva-line-height-caption",
            "Bold · 11px · LH 1.4", "תווית זמן או מטא-דאטה, כמו בתוך MStatusBadge."),
    };

    private sealed record SpacingToken(string Name, string Var);
    private readonly SpacingToken[] _spacing =
    {
        new("xs", "--motiva-space-xs"),
        new("sm", "--motiva-space-sm"),
        new("md", "--motiva-space-md"),
        new("lg", "--motiva-space-lg"),
        new("xl", "--motiva-space-xl"),
        new("2xl", "--motiva-space-2xl"),
    };

    private sealed record MotionToken(string Key, string Label, string DurationVar);
    private readonly MotionToken[] _motion =
    {
        new("fast", "Fast", "--motiva-motion-duration-fast"),
        new("standard", "Standard", "--motiva-motion-duration-standard"),
        new("slow", "Slow", "--motiva-motion-duration-slow"),
    };

    private string? _motionActive;

    private async Task TriggerMotion(string key)
    {
        _motionActive = key;
        StateHasChanged();
        await Task.Delay(600);
        _motionActive = null;
        StateHasChanged();
    }
}
