@page "/motiva/components/student-primitives"
@layout MotivaGalleryLayout
@using AuthWithAdmin.Client.Components.MotivaGallery

<PageTitle>Motiva Gallery · Student Primitives</PageTitle>

<DocPageHeader Title="Student Primitives" TitleSub="Phase 3 · System Master">
    שמונה הפרימיטיבים המשותפים של ה-Motiva System Master:
    <code>MPageHeader</code>, <code>MKpiGrid</code>, <code>MKpiCard</code>,
    <code>MStatusDot</code>, <code>MStatusBadge</code> (הורחב),
    <code>MRowList</code>/<code>MRow</code>, <code>MEmptyState</code> ו-
    <code>MScrollArea</code>. אלה אבני הבניין שמסכי הסטודנט יצרכו בשלבים
    הבאים — אף מסך פרודקשן עדיין לא הועבר אליהם.
</DocPageHeader>

<GallerySection Id="scope" Title="למה כל הדוגמאות עטופות ב-motiva-student" Description="נקודה טכנית שחשוב להבין לפני שמסתכלים על הצבעים כאן.">
    <MCard Variant="MCard.CardVariant.Default">
        <p>
            ערכי ה-System Master (Heebo, סולם הטיפוגרפיה, רדיוס 18/14,
            הגרדיאנטים, ו-violet/teal/rose) חיים כולם בתוך ה-scope
            <code>.motiva-student</code> ב-<code>motiva-tokens.css</code> —
            כך Phase 1 מנע מהם לדלוף למנחה/מרצה/סגל/אדמין. הגלריה עצמה
            <strong>אינה</strong> בתוך ה-scope הזה, ולכן כל בלוק תצוגה בעמוד
            הזה עטוף ב-<code>&lt;div class="motiva-student"&gt;</code> — כדי
            שמה שרואים כאן יהיה בדיוק מה שיוצג בחוויית הסטודנט.
        </p>
        <p>
            בנוסף, כל טוקן שקיים רק ב-scope נקרא בקומפוננטות עם
            <code>var(--motiva-color-rose, var(--motiva-color-danger))</code>
            ודומיו, כך שהרכיבים לא "נשברים" אם מישהו ישתמש בהם מחוץ ל-scope.
        </p>
    </MCard>
</GallerySection>

<GallerySection Id="page-header" Title="MPageHeader" Description="Master: 'Two variants — hero-with-KPI and compact — same gradient formula, share one component with a compact prop.'">
    <ComponentExample Title="Compact — כותרת עמוד + שורת הקשר + שורת KPI" Center="false">
        <div class="motiva-student sp-stage sp-stage-bleed">
            <MPageHeader Variant="MPageHeader.HeaderVariant.Compact"
                         Title="המשימות שלי"
                         SubtitleContent="@_compactSubtitle">
                <MKpiGrid AriaLabel="סיכום משימות">
                    <MKpiCard Accent="MKpiCard.KpiAccent.Rose" Value="2" Label="דורש התייחסות">
                        <Icon><span class="oi oi-warning"></span></Icon>
                    </MKpiCard>
                    <MKpiCard Accent="MKpiCard.KpiAccent.Violet" Value="4" Label="להגשה השבוע">
                        <Icon><span class="oi oi-calendar"></span></Icon>
                    </MKpiCard>
                    <MKpiCard Accent="MKpiCard.KpiAccent.None" Value="18" Label="משימות צוות">
                        <Icon><span class="oi oi-people"></span></Icon>
                    </MKpiCard>
                    <MKpiCard Accent="MKpiCard.KpiAccent.Teal" Value="9" Label="הושלמו">
                        <Icon><span class="oi oi-check"></span></Icon>
                    </MKpiCard>
                </MKpiGrid>
            </MPageHeader>
        </div>
    </ComponentExample>

    <ComponentExample Title="Hero — ברכה שקטה + שורת מצב דו-צדדית" Center="false">
        <div class="motiva-student sp-stage sp-stage-bleed">
            <MPageHeader Variant="MPageHeader.HeaderVariant.Hero"
                         Title="בוקר טוב, נועה"
                         SubtitleContent="@_heroSubtitle">
                <div class="sp-hero-slot">
                    שקע התוכן (<code>ChildContent</code>) — כאן יישבו ה-stepper
                    של אבני הדרך או שורת ה-KPI. ל-MPageHeader אין דעה על מה
                    שנכנס אליו.
                </div>
            </MPageHeader>
        </div>
    </ComponentExample>

    <p class="doc-note">
        שתי הווריאציות מרנדרות <code>h1</code>. ב-Hero הכותרת מצוירת שקטה
        יותר (ink-2) כי היא ברכה ולא כותרת עמוד — אבל היא עדיין הכותרת
        הראשית של המסמך, כך שכל עמוד סטודנט מקבל <code>h1</code> אמיתי.
        ה-padding האופקי מגיע מ-<code>--motiva-content-padding-inline</code>
        שנקבע ב-Phase 2, ולכן הכותרת ותוכן העמוד לעולם לא יסטו זה מזה.
    </p>
</GallerySection>

<GallerySection Id="kpi" Title="MKpiGrid + MKpiCard" Description="Master: 'Stretches to fill content width; supports link, button, and pressed/filter states.'">
    <ComponentExample Title="ארבעה מצבים: לא-אינטראקטיבי · קישור · כפתור סינון · נבחר" Center="false">
        <div class="motiva-student sp-stage">
            <MKpiGrid>
                <MKpiCard Value="12" Label="ללא אינטראקציה" />
                <MKpiCard Accent="MKpiCard.KpiAccent.Violet" Value="4" Label="קישור לעוגן" Href="#kpi" />
                <MKpiCard Accent="MKpiCard.KpiAccent.Teal" Value="9" Label="מסנן (לחיץ)"
                          OnClick="ToggleDone" Pressed="_donePressed" />
                <MKpiCard Accent="MKpiCard.KpiAccent.Rose" Value="2" Label="מסנן נבחר"
                          OnClick="ToggleAttention" Pressed="_attentionPressed" />
            </MKpiGrid>
        </div>
    </ComponentExample>

    <ComponentExample Title="שלוש עמודות — Columns=3" Center="false">
        <div class="motiva-student sp-stage">
            <MKpiGrid Columns="3">
                <MKpiCard Accent="MKpiCard.KpiAccent.Violet" Value="7" Label="פתוחות" />
                <MKpiCard Accent="MKpiCard.KpiAccent.Teal" Value="3" Label="אושרו" />
                <MKpiCard Accent="MKpiCard.KpiAccent.Rose" Value="1" Label="באיחור" />
            </MKpiGrid>
        </div>
    </ComponentExample>

    <p class="doc-note">
        לחצו על שני הכרטיסים הימניים — <code>aria-pressed</code> מתחלף,
        וטבעת ה-<code>inset</code> מתעבה בגוון הכרטיס עצמו ללא זזת layout.
        הכרטיס הראשון הוא <code>&lt;div&gt;</code> ולכן אינו ממוקד ואינו
        נראה לחיץ; הכרטיסים האינטראקטיביים הם <code>&lt;a&gt;</code> או
        <code>&lt;button&gt;</code> אמיתיים.
    </p>
</GallerySection>

<GallerySection Id="status-dot" Title="MStatusDot" Description="Master: 'Three semantic colors only — violet / teal / rose — never introduce a fourth.'">
    <ComponentExample Title="עם תווית — הדפוס המומלץ">
        <div class="motiva-student sp-stage sp-stage-inline">
            <MStatusDot Tone="MStatusDot.DotTone.Violet" Label="בתהליך" />
            <MStatusDot Tone="MStatusDot.DotTone.Teal" Label="הושלם" />
            <MStatusDot Tone="MStatusDot.DotTone.Rose" Label="דורש תשומת לב" />
        </div>
    </ComponentExample>

    <ComponentExample Title="נקודה בלבד · נקודה עם טבעת התראה (Pulse)">
        <div class="motiva-student sp-stage sp-stage-inline">
            <MStatusDot Tone="MStatusDot.DotTone.Violet" />
            <MStatusDot Tone="MStatusDot.DotTone.Teal" />
            <MStatusDot Tone="MStatusDot.DotTone.Rose" AriaLabel="דורש תשומת לב" />
            <MStatusDot Tone="MStatusDot.DotTone.Rose" Pulse="true" AriaLabel="חריגה — דורש טיפול" />
        </div>
    </ComponentExample>

    <p class="doc-note">
        <code>enum DotTone</code> סגור בכוונה לשלושת הצבעים המותרים — אי אפשר
        להוסיף רביעי מבלי לגעת בקומפוננטה. נקודה ללא <code>Label</code> וללא
        <code>AriaLabel</code> היא <code>aria-hidden</code>; היא מקבלת שם נגיש
        רק כשהיא באמת נושאת את המשמעות לבדה. אנימציית ה-<code>Pulse</code>
        מבוטלת לחלוטין תחת <code>prefers-reduced-motion</code>.
    </p>
</GallerySection>

<GallerySection Id="status-badge" Title="MStatusBadge — הורחב, לא שוכפל" Description="הרכיב הקיים אומץ ל-Master במקום ליצור MStatusChip מקביל.">
    <ComponentExample Title="Canonical — הסט של ה-Master">
        <div class="motiva-student sp-stage sp-stage-inline">
            <MStatusBadge Variant="MStatusBadge.BadgeVariant.Neutral" Text="טיוטה" />
            <MStatusBadge Variant="MStatusBadge.BadgeVariant.Violet" Text="בבדיקת מנחה" />
            <MStatusBadge Variant="MStatusBadge.BadgeVariant.Teal" Text="אושר" />
            <MStatusBadge Variant="MStatusBadge.BadgeVariant.Rose" Text="נדרש תיקון" />
        </div>
    </ComponentExample>

    <ComponentExample Title="Legacy — עדיין נתמך, ונראה זהה בתוך ה-scope">
        <div class="motiva-student sp-stage sp-stage-inline">
            <MStatusBadge Variant="MStatusBadge.BadgeVariant.Info" Text="Info" />
            <MStatusBadge Variant="MStatusBadge.BadgeVariant.Success" Text="Success" />
            <MStatusBadge Variant="MStatusBadge.BadgeVariant.Warning" Text="Warning" />
            <MStatusBadge Variant="MStatusBadge.BadgeVariant.Danger" Text="Danger" />
        </div>
    </ComponentExample>

    <MCard Variant="MCard.CardVariant.Default">
        <h3>מסלול ההגירה</h3>
        <p>
            הערכים הישנים לא נמחקו — הם בשימוש היום בכל התפקידים (מנחה, מרצה,
            סגל, אדמין). Phase 1 כבר קיפל את הטוקנים שלהם על שלושת הצבעים
            המותרים בתוך <code>.motiva-student</code>, ולכן הם
            <strong>נכונים ויזואלית</strong> — רק שמם שייך למערכת הישנה.
        </p>
        <ul>
            <li><code>Info</code> → <code>Violet</code></li>
            <li><code>Success</code> → <code>Teal</code></li>
            <li><code>Warning</code> → <code>Rose</code></li>
            <li><code>Danger</code> → <code>Rose</code></li>
        </ul>
        <p>
            ההמרה מתבצעת לכל מסך בזמן שהוא מעוצב מחדש; הערכים הישנים יימחקו
            רק כשלא יישאר קורא אחד. הערכים החדשים נוספו <em>בסוף</em> ה-enum
            כדי שאף ordinal קיים לא יזוז.
        </p>
    </MCard>
</GallerySection>

<GallerySection Id="row-list" Title="MRowList + MRow" Description="Master: 'Motiva has no literal &lt;table&gt;; every list is .row — build once, no separate table component needed.'">
    <ComponentExample Title="רשימה גנרית — leading, meta, status, trailing, בחירה" Center="false">
        <div class="motiva-student sp-stage">
            <MCard Variant="MCard.CardVariant.Default">
                <MRowList AriaLabel="הגשות קרובות">
                    <MRow Primary="מסמך אפיון — גרסה סופית"
                          Secondary="אבן דרך: פיתוח אב־טיפוס"
                          Meta="03.08"
                          MetaTone="MRow.RowMetaTone.Rose">
                        <Leading><MStatusDot Tone="MStatusDot.DotTone.Rose" /></Leading>
                    </MRow>

                    <MRow Primary="פגישת סטטוס עם המנחה" Meta="12.08">
                        <Leading><MStatusDot Tone="MStatusDot.DotTone.Violet" /></Leading>
                    </MRow>

                    <MRow Primary="בדיקת נגישות למסך הראשי" Meta="14.08">
                        <Status><MStatusBadge Variant="MStatusBadge.BadgeVariant.Teal" Text="אושר" /></Status>
                    </MRow>

                    <MRow Primary="שורה לחיצה — נבחרת כרגע"
                          Secondary="נפתחת לפרטים; button אמיתי, לא div"
                          Selected="true"
                          OnClick="NoOp">
                        <Trailing><span class="oi oi-chevron-left" aria-hidden="true"></span></Trailing>
                    </MRow>
                </MRowList>
            </MCard>
        </div>
    </ComponentExample>

    <p class="doc-note">
        אין ב-<code>MRow</code> שום ידע על משימות, בקשות או דשבורד — הוא מקבל
        טקסט ראשי/משני ושקעים חופשיים (<code>Leading</code>,
        <code>Status</code>, <code>Meta</code>, <code>Trailing</code>).
        מיפוי סטטוס→צבע נשאר אצל הקורא, בדיוק כמו ב-<code>MStatusBadge</code>.
        <code>MetaTone</code> הוא הדפוס של ה-Master לתאריך באיחור (rose)
        לעומת תאריך רגיל (muted).
    </p>
</GallerySection>

<GallerySection Id="empty-state" Title="MEmptyState" Description="Master: 'One calm sentence + one supporting line — never an illustration.'">
    <ComponentExample Title="בסיסי · עם פעולה יחידה" Center="false">
        <div class="motiva-student sp-stage sp-stage-split">
            <MCard Variant="MCard.CardVariant.Default">
                <MEmptyState Title="אין התראות חדשות"
                             Description="כשתתקבל תגובה, משוב או הודעה חדשה, היא תופיע כאן." />
            </MCard>
            <MCard Variant="MCard.CardVariant.Default">
                <MEmptyState Title="אין תוצאות לסינון הזה"
                             Description="נסו להסיר אחד מהמסננים הפעילים."
                             Live="true">
                    <Action>
                        <MButton Variant="MButton.ButtonVariant.Secondary" Size="MButton.ButtonSize.Small">
                            ניקוי מסננים
                        </MButton>
                    </Action>
                </MEmptyState>
            </MCard>
        </div>
    </ComponentExample>

    <p class="doc-note">
        אין פרמטר <code>Icon</code>/<code>Illustration</code> — כלל ה-Master
        נאכף ב-API ולא מושאר לשיקול כל קורא. <code>Live="true"</code> מוסיף
        <code>role="status"</code>, ומיועד למצב ריק שנוצר <em>כתוצאה</em>
        מפעולת המשתמש (סינון), לא למצב ריק שקיים מהטעינה הראשונה.
    </p>
</GallerySection>

<GallerySection Id="scroll-area" Title="MScrollArea" Description="Master: 'Thin custom scrollbar (6px, low-contrast) — used inside fixed-height task/team panels.'">
    <ComponentExample Title="גובה קבוע בתוך כרטיס" Center="false">
        <div class="motiva-student sp-stage">
            <MCard Variant="MCard.CardVariant.Default" Title="משימות הצוות">
                <MScrollArea MaxHeight="180px" AriaLabel="רשימת משימות הצוות">
                    <MRowList>
                        @for (var i = 1; i <= 8; i++)
                        {
                            <MRow Primary="@($"פריט מספר {i} ברשימה הגוללת")"
                                  Meta="@($"{i + 9}.08")">
                                <Leading><MStatusDot Tone="MStatusDot.DotTone.Violet" /></Leading>
                            </MRow>
                        }
                    </MRowList>
                </MScrollArea>
            </MCard>
        </div>
    </ComponentExample>

    <p class="doc-note">
        המכל ממוקד במקלדת (<code>tabindex="0"</code>) כדי שניתן יהיה לגלול
        אותו בחיצים — אזור גלילה שאי אפשר למקד הוא בלתי-נגיש למי שאינו
        משתמש בעכבר (WCAG 2.1.1). <strong>סטייה מודעת מהאב-טיפוס:</strong>
        ה-Master כופה <code>direction:ltr</code> על תיבת הגלילה
        ו-<code>direction:rtl</code> חזרה על ילדיה רק כדי להזיז את הפס לצד
        ימין. זה שובר ירושת כיוון לכל מה שאינו ילד ישיר, ולכן לא הועתק —
        התיבה שומרת על הכיוון שהיא יורשת, והפס יושב בקצה ה-inline-start
        כמו בכל דפדפן.
    </p>
</GallerySection>

<GallerySection Id="accessibility" Title="Accessibility" Description="מה מובטח על ידי הפרימיטיבים עצמם.">
    <MCard Variant="MCard.CardVariant.Default">
        <ul>
            <li>אין אף <code>div</code> לחיץ. <code>MKpiCard</code> ו-<code>MRow</code> מרנדרים <code>&lt;a&gt;</code> כשיש <code>Href</code>, <code>&lt;button&gt;</code> כשיש <code>OnClick</code>, ו-<code>&lt;div&gt;</code> אינרטי אחרת — הפעלה במקלדת מגיעה מהאלמנט עצמו.</li>
            <li><code>aria-pressed</code> נפלט רק כאשר <code>Pressed</code> הוגדר, כלומר רק לכרטיסים שהם באמת toggle.</li>
            <li><code>focus-visible</code> נראה בכל רכיב אינטראקטיבי, בטוקן <code>--motiva-color-focus-ring</code>.</li>
            <li>צבע לעולם אינו לבדו: <code>MStatusDot</code> ללא תווית הוא <code>aria-hidden</code>, ו-<code>MStatusBadge</code> לא מרנדר כלום ללא טקסט.</li>
            <li><code>MScrollArea</code> ממוקד במקלדת; <code>role="region"</code> נוסף רק כשיש לו שם.</li>
            <li>כל האנימציות והמעברים מבוטלים תחת <code>prefers-reduced-motion: reduce</code>.</li>
            <li>RTL: לוגיקה מרחבית בלבד (<code>padding-inline</code>, <code>margin-inline-start</code>, <code>border-block-end</code>, <code>text-align: start</code>) — אין <code>left</code>/<code>right</code> באף רכיב.</li>
        </ul>
    </MCard>
</GallerySection>

<GallerySection Id="code" Title="Razor usage examples" Description="בדיוק כפי שייכתב בעמוד סטודנט אמיתי בשלב הבא.">
    <CodeBlock Code="@_code" />
</GallerySection>

<GallerySection Id="related" Title="Related Components" Description="רכיבים שמופיעים יחד עם הפרימיטיבים האלה.">
    <RelatedComponents Items="_related" />
</GallerySection>

@code {
    private bool _donePressed;
    private bool _attentionPressed = true;

    private void ToggleDone() => _donePressed = !_donePressed;
    private void ToggleAttention() => _attentionPressed = !_attentionPressed;

    // The row demo's click target is intentionally inert — the gallery
    // demonstrates the component's states, it does not navigate anywhere.
    private void NoOp() { }

    private readonly RenderFragment _compactSubtitle =
        @<text>אבן דרך נוכחית: <strong>פיתוח אב־טיפוס</strong> · יעד 12.08</text>;

    private readonly RenderFragment _heroSubtitle =
        @<div class="sp-hero-row">
            <span>אבן דרך נוכחית: פיתוח אב־טיפוס</span>
            <span>התקדמות כללית · 50%</span>
        </div>;

    private static readonly (string Name, string Route)[] _related =
    {
        ("Card", "/motiva/components/card"),
        ("Button", "/motiva/components/button"),
        ("Status Badge", "/motiva/components/status-badge"),
    };

    private readonly string _code =
        "<MPageHeader Variant=\"MPageHeader.HeaderVariant.Compact\"\n" +
        "             Title=\"המשימות שלי\"\n" +
        "             Subtitle=\"אבן דרך נוכחית: פיתוח אב־טיפוס\">\n" +
        "    <MKpiGrid AriaLabel=\"סיכום משימות\">\n" +
        "        <MKpiCard Accent=\"MKpiCard.KpiAccent.Rose\" Value=\"2\" Label=\"דורש התייחסות\" />\n" +
        "        <MKpiCard Accent=\"MKpiCard.KpiAccent.Violet\" Value=\"4\" Label=\"להגשה השבוע\"\n" +
        "                  OnClick=\"ToggleWeekFilter\" Pressed=\"_weekFilterOn\" />\n" +
        "    </MKpiGrid>\n" +
        "</MPageHeader>\n\n" +
        "<MScrollArea MaxHeight=\"240px\" AriaLabel=\"משימות הצוות\">\n" +
        "    <MRowList>\n" +
        "        <MRow Leading=\"@dot\" Primary=\"@task.Title\" Meta=\"@task.DueLabel\"\n" +
        "              MetaTone=\"MRow.RowMetaTone.Rose\" OnClick=\"() => Open(task)\" />\n" +
        "    </MRowList>\n" +
        "</MScrollArea>";
}
