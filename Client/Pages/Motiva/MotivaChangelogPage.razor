@page "/motiva/changelog"
@layout MotivaGalleryLayout
@using AuthWithAdmin.Client.Components.MotivaGallery

<DocPageHeader Title="Changelog">
    איך Motiva התפתחה, שלב אחר שלב. הגרסה המלאה, עם כל השינויים לפי קובץ,
    נמצאת ב-<code>design/design-system/CHANGELOG.md</code>.
</DocPageHeader>

<div class="changelog-timeline">
    @for (var i = 0; i < _entries.Length; i++)
    {
        var entry = _entries[i];
        <div class="changelog-entry @(entry.IsCurrent ? "changelog-entry-current" : "") @(i == _entries.Length - 1 ? "changelog-entry-last" : "")">
            <div class="changelog-rail">
                <span class="changelog-dot"><span class="oi @entry.Icon" aria-hidden="true"></span></span>
            </div>
            <div class="changelog-entry-body">
                <div class="changelog-entry-head">
                    <MStatusBadge Variant="entry.Variant" Text="@entry.Phase" />
                    <span class="changelog-date">@entry.Date</span>
                </div>
                <h3>@entry.Title</h3>
                <p>@entry.Description</p>
            </div>
        </div>
    }
</div>

@code {
    private sealed record Entry(
        string Icon,
        string Phase,
        MStatusBadge.BadgeVariant Variant,
        string Date,
        string Title,
        MarkupString Description,
        bool IsCurrent = false);

    private readonly Entry[] _entries =
    {
        new("oi-book", "Phase 4C · נוכחי", MStatusBadge.BadgeVariant.Info, "2026-08-07",
            "Student Knowledge Center",
            new MarkupString("""
                מרכז הידע (<code>/learning</code>) הועבר ל-Motiva ועבר ממקור
                נתונים ריק (<code>LearningMaterials</code>) ל-
                <code>ResourceFiles</code> האמיתי. ארכיטקטורת ה-Design נשמרה
