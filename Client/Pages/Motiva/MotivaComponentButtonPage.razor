@page "/motiva/components/button"
@layout MotivaGalleryLayout
@using AuthWithAdmin.Client.Components.MotivaGallery

<PageTitle>Motiva Gallery · Button</PageTitle>

<DocPageHeader Title="Button" TitleSub="MButton">
    כפתור משותף יחיד, המחליף 4+ סגנונות כפתור עצמאיים שנמצאו באפליקציה
    (<code>fm-btn</code>, <code>atm-btn</code>, <code>cy-add-btn</code>, ה-
    <code>.btn.btn-primary</code> הגולמי של Bootstrap ועוד). כל הדוגמאות
    בעמוד זה משתמשות ברכיב <code>MButton</code> האמיתי.
</DocPageHeader>

<GallerySection Id="anatomy" Title="Anatomy" Description="מה בונה כל כפתור מבפנים.">
    <MCard Variant="MCard.CardVariant.Default">
        <ul>
            <li>שורש: <code>&lt;button type="@@Type"&gt;</code> סמנטי — לעולם לא <code>div</code>.</li>
            <li>Spinner אופציונלי (<code>m-btn-spinner</code>) המוצג רק כאשר <code>Loading="true"</code>.</li>
            <li>תוכן: <code>ChildContent</code>, או <code>LoadingText</code> במקומו בזמן טעינה.</li>
        </ul>
    </MCard>
</GallerySection>

<GallerySection Id="variants" Title="Variants" Description="ארבעה סגנונות חזותיים — בחרו לפי משמעות הפעולה, לא לפי טעם אישי.">
    <ComponentExample Title="Primary · Secondary · Ghost · Danger">
        <MButton Variant="MButton.ButtonVariant.Primary">פעולה ראשית</MButton>
        <MButton Variant="MButton.ButtonVariant.Secondary">פעולה משנית</MButton>
        <MButton Variant="MButton.ButtonVariant.Ghost">Ghost</MButton>
        <MButton Variant="MButton.ButtonVariant.Danger">מחיקה</MButton>
    </ComponentExample>
    <CodeBlock Code="@_variantsCode" />
</GallerySection>

<GallerySection Id="sizes" Title="Sizes" Description="שלושה גבהים קבועים, תואמים לשאר פקדי הקלט של המערכת.">
    <ComponentExample Title="Small · Medium · Large">
        <MButton Size="MButton.ButtonSize.Small">Small</MButton>
        <MButton Size="MButton.ButtonSize.Medium">Medium</MButton>
        <MButton Size="MButton.ButtonSize.Large">Large</MButton>
    </ComponentExample>
</GallerySection>

<GallerySection Id="states" Title="States" Description="ברירת מחדל, מושבת, וטעינה — כולל תוכן ואייקונים בתוך הכפתור.">
    <ComponentExample Title="Default · Disabled · Loading (demo)">
        <MButton>Default</MButton>
        <MButton Disabled="true">Disabled</MButton>
        <MButton Loading="_demoLoading" LoadingText="שומר…" OnClick="RunLoadingDemoAsync">
            הפעלת Loading לרגע
        </MButton>
    </ComponentExample>
    <p class="doc-note">
        הכפתור השלישי הוא הדגמה בטוחה: לחיצה מדליקה <code>Loading="true"</code>
        למשך כשנייה אחת דרך קוד Blazor רגיל, ואז חוזרת אוטומטית — אין Loading
        אינסופי בגלריה הזו.
    </p>

    <ComponentExample Title="עם טקסט בלבד / עם אייקון קיים מהפרויקט">
        <MButton Variant="MButton.ButtonVariant.Primary">שמירה</MButton>
        <MButton Variant="MButton.ButtonVariant.Secondary">
            <span class="oi oi-plus" aria-hidden="true"></span>
            הוספה
        </MButton>
        <MButton Variant="MButton.ButtonVariant.Danger" AriaLabel="מחיקת פרויקט">
            <span class="oi oi-trash" aria-hidden="true"></span>
        </MButton>
    </ComponentExample>
    <p class="doc-note">
        הכפתור השלישי הוא דוגמת icon-only — שימו לב שהוא מקבל <code>AriaLabel</code>
        כי אין לו טקסט גלוי.
    </p>

    <ComponentExample Title="כפתורים בתוכן RTL">
        <MButton Variant="MButton.ButtonVariant.Secondary">
            <span class="oi oi-arrow-thick-right" aria-hidden="true"></span>
            חזרה
        </MButton>
        <MButton Variant="MButton.ButtonVariant.Primary">
            המשך
            <span class="oi oi-arrow-thick-left" aria-hidden="true"></span>
        </MButton>
    </ComponentExample>
    <p class="doc-note">
        הרווח בין האייקון לטקסט הוא <code>gap</code>, כך שסדר האייקון/טקסט
        מתהפך נכון תחת <code>dir="rtl"</code> ללא כל קוד נוסף.
    </p>
</GallerySection>

<GallerySection Id="accessibility" Title="Accessibility &amp; RTL notes" Description="מה כבר מטופל בשבילכם, ולמה זה עובד גם ב-RTL בלי קוד נוסף.">
    <MCard Variant="MCard.CardVariant.Default">
        <ul>
            <li><code>&lt;button&gt;</code> סמנטי — פועל עם Enter/Space מהדפדפן בלי שום קוד נוסף.</li>
            <li><code>Loading</code> מוסיף <code>aria-busy="true"</code> וגם <code>disabled</code> — מודיע לטכנולוגיה מסייעת וגם חוסם לחיצה כפולה.</li>
            <li><code>:focus-visible</code> מקבל טבעת מפורשת (<code>--motiva-color-focus-ring</code>) כי משטחי הגרדיאנט/הדנג׳ר הם משטחים מותאמים אישית — לחצו Tab כדי לראות אותה על הכפתורים למעלה.</li>
            <li>מצב מושבת משתמש ב-<code>--motiva-color-disabled-*</code>, לא ב-opacity בלבד.</li>
            <li>אין <code>left</code>/<code>right</code> קשיח — קצה הפתיחה של ה-spinner משתמש ב-<code>border-inline-end-color</code>.</li>
        </ul>
    </MCard>
</GallerySection>

<GallerySection Id="usage" Title="Usage guidance · Do / Don't" Description="כללים קצרים שחוסכים ניחוש בזמן פיתוח.">
    <div class="doc-do-dont">
        <MCard Variant="MCard.CardVariant.Default">
            <h3>Do</h3>
            <ul>
                <li>העבירו <code>AriaLabel</code> לכל כפתור שהתוכן הגלוי שלו הוא אייקון בלבד.</li>
                <li>תנו ל-<code>MButton</code> לחשב לבד את מצב ה-disabled/loading.</li>
            </ul>
        </MCard>
        <MCard Variant="MCard.CardVariant.Default">
            <h3>Don't</h3>
            <ul>
                <li>אל תעטפו <code>MButton</code> באלמנט לחיץ נוסף (למשל כרטיס עם onclick) — הוא כבר מטפל בלחיצה/מקלדת בעצמו.</li>
                <li>אל תשימו תוכן ברמת בלוק (כותרות, כרטיסים) בתוך <code>ChildContent</code>.</li>
            </ul>
        </MCard>
    </div>
</GallerySection>

<GallerySection Id="limitations" Title="Known limitations" Description="פערים ידועים, מתועדים במכוון ולא מוסתרים.">
    <MCard Variant="MCard.CardVariant.Default">
        <ul>
            <li><code>Loading</code> משתמש ב-<code>disabled</code> הטבעי, מה שיכול להזיז פוקוס אצל קוראי מסך מסוימים — נשקל במודע, לא תוקן בשלב זה (ראו <code>COMPONENT_REVIEW.md</code>).</li>
            <li><code>Type</code> הוא <code>string</code> רגיל, לא enum — סיכון נמוך כי הדפדפן מתייחס לערך ללא תלות ב-case.</li>
            <li><code>ButtonSize</code>, <code>ProgressSize</code> ו-<code>ModalSize</code> הם שלושה enum-ים כמעט זהים — כפילות ידועה, נדחתה בכוונה לשלב עתידי.</li>
        </ul>
    </MCard>
</GallerySection>

<GallerySection Id="related" Title="Related Components" Description="קומפוננטות שמופיעות יחד בדפוסי שימוש קיימים בגלריה.">
    <RelatedComponents Items="_related" />
</GallerySection>

@code {
    private static readonly (string Name, string Route)[] _related =
    {
        ("Card", "motiva/components/card"),
        ("Modal", "motiva/components/modal"),
    };

    private bool _demoLoading;

    private readonly string _variantsCode =
        "<MButton Variant=\"MButton.ButtonVariant.Primary\">פעולה ראשית</MButton>\n" +
        "<MButton Variant=\"MButton.ButtonVariant.Secondary\">פעולה משנית</MButton>\n" +
        "<MButton Variant=\"MButton.ButtonVariant.Ghost\">Ghost</MButton>\n" +
        "<MButton Variant=\"MButton.ButtonVariant.Danger\">מחיקה</MButton>";

    private async Task RunLoadingDemoAsync()
    {
        _demoLoading = true;
        StateHasChanged();
        await Task.Delay(1200);
        _demoLoading = false;
        StateHasChanged();
    }
}
