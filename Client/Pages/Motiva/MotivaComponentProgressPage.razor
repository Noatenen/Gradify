@page "/motiva/components/progress-bar"
@layout MotivaGalleryLayout
@using AuthWithAdmin.Client.Components.MotivaGallery

<DocPageHeader Title="Progress Bar" TitleSub="MProgressBar">
    מד התקדמות משותף יחיד, המחליף 7 מימושי <code>progress-bar</code>/
    <code>progress-fill</code>/<code>progress-track</code> עצמאיים. ממופה
    ישירות להתקדמות אבני דרך/משימות בדשבורד הסטודנט (יעד Phase 5).
</DocPageHeader>

<GallerySection Id="anatomy" Title="Anatomy" Description="כותרת, מסילה ומילוי — כולם נגזרים מ-Value אחד.">
    <MCard Variant="MCard.CardVariant.Default">
        <ul>
            <li>כותרת אופציונלית (<code>Label</code>) + אחוז מוצג אופציונלי (<code>ShowValue</code>).</li>
            <li>מסילה (<code>role="progressbar"</code>) עם <code>aria-valuemin/-max/-now</code> תמיד לפי הערך המהודק.</li>
            <li>מילוי — רוחבו נקבע דרך משתנה CSS מותאם אישית (<code>--m-progress-percent</code>), החריג המתועד היחיד ל"בלי inline style".</li>
        </ul>
    </MCard>
</GallerySection>

<GallerySection Id="values" Title="Values" Description="אותו מד, בכל נקודה על הסקאלה.">
    <ComponentExample Title="0% · 20% · 50% · 100%">
        <div class="progress-stack">
            <MProgressBar Value="0" ShowValue="true" Label="0%" />
            <MProgressBar Value="20" ShowValue="true" Label="20%" />
            <MProgressBar Value="50" ShowValue="true" Label="50%" />
            <MProgressBar Value="100" ShowValue="true" Label="100%" />
        </div>
    </ComponentExample>
</GallerySection>

<GallerySection Id="sizes" Title="Sizes" Description="עובי המסילה בלבד משתנה — הגובה של שאר הרכיב נשאר יציב.">
    <ComponentExample Title="Small · Medium · Large">
        <div class="progress-stack">
            <MProgressBar Value="64" Size="MProgressBar.ProgressSize.Small" Label="Small" ShowValue="true" />
            <MProgressBar Value="64" Size="MProgressBar.ProgressSize.Medium" Label="Medium" ShowValue="true" />
            <MProgressBar Value="64" Size="MProgressBar.ProgressSize.Large" Label="Large" ShowValue="true" />
        </div>
    </ComponentExample>
</GallerySection>

<GallerySection Id="edge-cases" Title="States &amp; edge cases" Description="קלט לא תקין נהדק בבטחה — לא קורס ולא נראה שבור.">
    <ComponentExample Title="עם תווית · בלי ערך גלוי · Value &gt; Max · Max = 0 · ערך עשרוני">
        <div class="progress-stack">
            <MProgressBar Value="42" Label="עם תווית" ShowValue="true" />
            <MProgressBar Value="42" Label="בלי אחוז גלוי (ShowValue=false)" />
            <MProgressBar Value="150" Max="100" Label="Value=150, Max=100 → מהודק ל-100%" ShowValue="true" />
            <MProgressBar Value="30" Max="0" Label="Max=0 → נופל בחזרה ל-100" ShowValue="true" />
            <MProgressBar Value="33.7" Label="ערך עשרוני 33.7 → מעוגל לתצוגה" ShowValue="true" />
        </div>
    </ComponentExample>
</GallerySection>

<GallerySection Id="interactive-demo" Title="הדגמה אינטראקטיבית" Description="עדכון חי, ללא רכיב קלט חדש.">
    <ComponentExample Title="גררו את המחוון — עדכון חי דרך state של Blazor">
        <div class="progress-live-demo">
            <input type="range" min="0" max="100" value="@_liveValue"
                   @oninput="OnLiveValueChanged" class="progress-range" />
            <span class="progress-live-value">@_liveValue</span>
            <MProgressBar Value="_liveValue" ShowValue="true" AccessibleLabel="התקדמות הדגמה חיה" />
        </div>
    </ComponentExample>
    <p class="doc-note">
        אין כאן רכיב <code>MInput</code> חדש — זהו <code>&lt;input type="range"&gt;</code>
        טבעי, לפי ההנחיה לא להוסיף רכיב קלט חדש בשלב זה.
    </p>
</GallerySection>

<GallerySection Id="accessibility" Title="Accessibility &amp; RTL notes" Description="הערכים שקוראי מסך שומעים תמיד תואמים למה שמוצג.">
    <MCard Variant="MCard.CardVariant.Default">
        <ul>
            <li><code>aria-valuenow</code>/<code>aria-valuemax</code> תמיד משקפים את הערך <em>המהודק</em>, לא את הקלט הגולמי.</li>
            <li><code>aria-label</code> נגזר מ-<code>AccessibleLabel</code>, ואם אינו קיים — מ-<code>Label</code>; אם אף אחד לא קיים, התכונה לא מוצגת כלל (לא <code>aria-label=""</code> ריק).</li>
            <li>המילוי גדל מקצה ההתחלה הלוגי — אין <code>left</code>/<code>right</code>/<code>transform: scaleX</code> — לכן הוא נכון אוטומטית תחת RTL.</li>
        </ul>
    </MCard>
</GallerySection>

<GallerySection Id="usage" Title="Usage guidance · Do / Don't" Description="כללים קצרים שחוסכים ניחוש בזמן פיתוח.">
    <div class="doc-do-dont">
        <MCard Variant="MCard.CardVariant.Default">
            <h3>Do</h3>
            <ul>
                <li>העבירו <code>Max</code> כשהמכנה אינו 100 (למשל ספירת משימות) — אל תחשבו אחוז בעצמכם.</li>
                <li>השתמשו ב-<code>AccessibleLabel</code> כאשר ה-<code>Label</code> הגלוי קצר/עיטורי.</li>
            </ul>
        </MCard>
        <MCard Variant="MCard.CardVariant.Default">
            <h3>Don't</h3>
            <ul>
                <li>אל תעטפו בעצמכם את הטקסט המוצג של <code>ShowValue</code> — הרכיב כבר מעצב ומעגל אותו באופן עקבי.</li>
            </ul>
        </MCard>
    </div>
</GallerySection>

<GallerySection Id="limitations" Title="Known limitations" Description="החריג היחיד ל-inline style בכל מערכת הקומפוננטות.">
    <MCard Variant="MCard.CardVariant.Default">
        <ul>
            <li>ה-inline style היחיד בכל מערכת הקומפוננטות: <code>style="--m-progress-percent: N%"</code> — משתנה CSS מוגדר-היקף, לא רוחב ליטרלי ולא class לכל אחוז.</li>
            <li>האחוז מעוגל למספר שלם הן במילוי החזותי והן בטקסט <code>ShowValue</code> — אין דיוק תת-אחוזי.</li>
        </ul>
    </MCard>
</GallerySection>

<GallerySection Id="code" Title="Razor usage examples" Description="בדיוק כפי שנכתב בקובץ .razor אמיתי.">
    <CodeBlock Code="@_code" />
</GallerySection>

<GallerySection Id="related" Title="Related Components" Description="קומפוננטות שמופיעות יחד בדפוסי שימוש קיימים בגלריה.">
    <RelatedComponents Items="_related" />
</GallerySection>

@code {
    private static readonly (string Name, string Route)[] _related =
    {
        ("Card", "motiva/components/card"),
        ("Status Badge", "motiva/components/status-badge"),
    };

    private double _liveValue = 45;

    private void OnLiveValueChanged(ChangeEventArgs e)
    {
        if (double.TryParse(e.Value?.ToString(), out var parsed))
        {
            _liveValue = parsed;
        }
    }

    private readonly string _code =
        "<MProgressBar Value=\"68\" Label=\"פיתוח אב־טיפוס\" ShowValue=\"true\" />\n\n" +
        "<MProgressBar Value=\"_completedTasks\" Max=\"_totalTasks\"\n" +
        "              AccessibleLabel=\"התקדמות משימות השבוע\"\n" +
        "              Size=\"MProgressBar.ProgressSize.Small\" />";
}
