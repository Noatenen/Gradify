@page "/motiva/components/card"
@layout MotivaGalleryLayout
@using AuthWithAdmin.Client.Components.MotivaGallery

<PageTitle>Motiva Gallery · Card</PageTitle>

<DocPageHeader Title="Card" TitleSub="MCard">
    משטח משותף יחיד, המחליף כ-15 מימושי "כרטיס" עצמאיים שנמצאו באפליקציה
    (<code>spp-card</code>, <code>im-card</code>, <code>psc-card</code> ועוד).
    הרכיב עם המינוף הגבוה ביותר, שכן כמעט כל מסך מבוסס כרטיסים.
</DocPageHeader>

<GallerySection Id="anatomy" Title="Anatomy" Description="Variant, Padding ו-Interactive קובעים את המשטח; כותרת אופציונלית (Icon/Title/Subtitle/TrailingContent) קובעת את הראש.">
    <MCard Variant="MCard.CardVariant.Default">
        <ul>
            <li>שורש: <code>&lt;div&gt;</code> (או <code>&lt;div role="button" tabindex="0"&gt;</code> כאשר <code>Interactive="true"</code>).</li>
            <li><code>Variant</code> קובע רק את המראה (Default/Elevated/Ambient) — עצמאי לגמרי מ-<code>Interactive</code>.</li>
            <li><code>Padding</code> קובע ריווח פנימי (Small/Medium/Large).</li>
            <li><code>Icon</code> / <code>Title</code> / <code>Subtitle</code> / <code>TrailingContent</code> — ראש כותרת אופציונלי; מופיע רק אם הועבר לפחות אחד מהם.</li>
            <li><code>ChildContent</code> — גוף הכרטיס, חופשי; ל-MCard אין דעה על רמת הכותרות שבתוכו.</li>
        </ul>
    </MCard>
</GallerySection>

<GallerySection Id="variants" Title="Visual variants" Description="Default, Elevated ו-Ambient — עצמאיים לחלוטין ממצב האינטראקטיביות.">
    <ComponentExample Title="Default · Elevated · Ambient">
        <MCard Variant="MCard.CardVariant.Default">
            <h3>Default</h3>
            <p>משטח רגיל, גבול עדין, צל רך.</p>
        </MCard>
        <MCard Variant="MCard.CardVariant.Elevated">
            <h3>Elevated</h3>
            <p>אותו משטח, צל מוגבה.</p>
        </MCard>
        <MCard Variant="MCard.CardVariant.Ambient">
            <h3>Ambient</h3>
            <p>רקע גרדיאנט Ambient — שמור לכרטיס Hero יחיד למסך.</p>
        </MCard>
    </ComponentExample>
</GallerySection>

<GallerySection Id="padding" Title="Padding" Description="ריווח פנימי קבוע — לא ערך חופשי.">
    <ComponentExample Title="Small · Medium · Large">
        <MCard Padding="MCard.CardPadding.Small">Small</MCard>
        <MCard Padding="MCard.CardPadding.Medium">Medium</MCard>
        <MCard Padding="MCard.CardPadding.Large">Large</MCard>
    </ComponentExample>
</GallerySection>

<GallerySection Id="header" Title="Header (Icon / Title / Subtitle / TrailingContent)" Description="ראש כותרת אופציונלי החוזר על עצמו כמעט בכל כרטיס בדשבורד — מופיע רק אם הועבר לפחות פרמטר אחד מהארבעה.">
    <ComponentExample Title="Body only — ללא כותרת (ברירת המחדל, ללא שינוי מהתנהגות קיימת)">
        <MCard Variant="MCard.CardVariant.Default">
            <p>כרטיס בלי אף אחד מפרמטרי הכותרת — אין <code>m-card-header</code> ב-DOM כלל, זהה לחלוטין להתנהגות הקודמת.</p>
        </MCard>
    </ComponentExample>

    <ComponentExample Title="Icon + Title">
        <MCard Title="הגשות קרובות">
            <Icon><span class="oi oi-calendar" aria-hidden="true"></span></Icon>
            <ChildContent>
                <p>תוכן הכרטיס ממשיך כרגיל מתחת לכותרת.</p>
            </ChildContent>
        </MCard>
    </ComponentExample>

    <ComponentExample Title="Icon + Title + TrailingContent">
        <MCard Title="דורש התייחסות">
            <Icon><span class="oi oi-bell" aria-hidden="true"></span></Icon>
            <TrailingContent><MStatusBadge Text="3" Variant="MStatusBadge.BadgeVariant.Neutral" /></TrailingContent>
            <ChildContent>
                <p>ה-TrailingContent מוצמד לקצה השורה (שמאל ב-RTL) ללא תלות ברוחב הכותרת.</p>
            </ChildContent>
        </MCard>
    </ComponentExample>

    <ComponentExample Title="Title + Subtitle (ללא Icon)">
        <MCard Title="פרטי הפרויקט" Subtitle="פרויקט 214 – מערכת ניהול מלאי">
            <p>Subtitle מוצג מתחת ל-Title בסגנון עמום וקטן יותר.</p>
        </MCard>
    </ComponentExample>

    <ComponentExample Title="Wrapping title — TrailingContent נשאר מיושר לשורה הראשונה">
        <div style="max-width: 320px">
            <MCard Title="כותרת ארוכה מאוד שאמורה להיעטף לשתי שורות בתוך כרטיס צר">
                <Icon><span class="oi oi-flag" aria-hidden="true"></span></Icon>
                <TrailingContent><MStatusBadge Text="חדש" Variant="MStatusBadge.BadgeVariant.Info" /></TrailingContent>
                <ChildContent>
                    <p>align-items: flex-start בשורת הכותרת שומר על ה-Icon וה-TrailingContent צמודים לשורה הראשונה, גם כשהכותרת נעטפת.</p>
                </ChildContent>
            </MCard>
        </div>
    </ComponentExample>
</GallerySection>

<GallerySection Id="interaction" Title="Interaction" Description="כרטיס יכול להיות משטח סטטי או יעד לחיץ מלא — נסו זאת ממש כאן.">
    <ComponentExample Title="Non-interactive">
        <MCard Variant="MCard.CardVariant.Default">
            <h3>כרטיס רגיל</h3>
            <p>לא לחיץ — אין <code>role="button"</code>, אין פוקוס.</p>
        </MCard>
    </ComponentExample>

    <ComponentExample Title="Interactive — נסו קליק, Enter או Space (הפוקוס על הכרטיס)">
        <div @onkeydown="HandleContainerKeyDown">
            <MCard Interactive="true" OnClick="HandleCardClick">
                <h3>כרטיס לחיץ</h3>
                <p>לחצו, או עברו אליו ב-Tab ולחצו Enter/Space.</p>
            </MCard>
        </div>
    </ComponentExample>
    <p class="doc-note">
        הופעל לאחרונה על ידי:
        <strong>@(_lastActivation ?? "— עדיין לא הופעל —")</strong>
    </p>

    <ComponentExample Title="Ambient + Interactive">
        <div @onkeydown="HandleContainerKeyDown">
            <MCard Variant="MCard.CardVariant.Ambient" Interactive="true" OnClick="HandleCardClick">
                <h3>כרטיס Hero לחיץ</h3>
                <p>שילוב של Variant ויזואלי עם Interactive — שני ממדים עצמאיים.</p>
            </MCard>
        </div>
    </ComponentExample>

    <p class="doc-note">
        שימו לב: אף דוגמת "כרטיס שלם לחיץ" כאן לא מכילה <code>&lt;button&gt;</code>
        מקונן — לפי ה-Do/Don't, לא לשלב פעולה כפולה (כרטיס לחיץ + כפתור פנימי לאותה פעולה).
    </p>
</GallerySection>

<GallerySection Id="accessibility" Title="Accessibility &amp; RTL notes" Description="מה קורה מאחורי הקלעים כש-Interactive מופעל.">
    <MCard Variant="MCard.CardVariant.Default">
        <ul>
            <li>כאשר <code>Interactive="true"</code>: <code>role="button"</code>, <code>tabindex="0"</code>, ומטפל גם ב-Enter/Space וגם בקליק.</li>
            <li>כאשר <code>Interactive="false"</code> (ברירת מחדל): <code>OnClick</code> אינו מחובר בכלל.</li>
            <li>אין <code>left</code>/<code>right</code> קשיח — ריווח פנימי הוא <code>padding</code> רגיל (סימטרי מטבעו), וזוויות הגרדיאנט ה-Ambient נשארות כפי שאושרו (עיטוריות, לא כיווניות).</li>
            <li>שורת הכותרת משתמשת ב-<code>gap</code> ו-<code>margin-inline-start: auto</code> בלבד (לא <code>left</code>/<code>right</code>) — ה-Icon נשאר בצד ההתחלה וה-TrailingContent בצד הסוף בכל כיווניות.</li>
            <li><code>Title</code> תמיד <code>h3</code> — אם נדרשת רמת כותרת אחרת מטעמי מבנה מסמך, יש לדלג על <code>Title</code> ולהוסיף כותרת עצמאית בתוך <code>ChildContent</code>.</li>
        </ul>
    </MCard>
</GallerySection>

<GallerySection Id="usage" Title="Usage guidance · Do / Don't" Description="כללים קצרים שחוסכים ניחוש בזמן פיתוח.">
    <div class="doc-do-dont">
        <MCard Variant="MCard.CardVariant.Default">
            <h3>Do</h3>
            <ul>
                <li>הגדירו <code>Interactive="true"</code> כאשר כל הכרטיס אמור להיות לחיץ.</li>
                <li>שמרו על <code>Ambient</code> לאלמנט Hero יחיד למסך.</li>
                <li>השתמשו ב-<code>Title</code>/<code>Subtitle</code> כשהכותרת היא טקסט פשוט — זה המקרה הנפוץ.</li>
                <li>השאירו כותרת מותאמת (רמת <code>h</code> שונה, פריסה מיוחדת) בתוך <code>ChildContent</code> — הראש האופציונלי הוא נוחות, לא חובה.</li>
            </ul>
        </MCard>
        <MCard Variant="MCard.CardVariant.Default">
            <h3>Don't</h3>
            <ul>
                <li>אל תעבירו <code>OnClick</code> בלי <code>Interactive="true"</code> — הקריאה תתעלם בשקט.</li>
                <li>אל תקננו כרטיס אינטראקטיבי נוסף, או כפתור שמכפיל את אותה פעולה.</li>
                <li>אל תשתמשו ב-<code>TrailingContent</code> כדי להבריח לשם פעולה עיקרית של הכרטיס — זה מיועד לתוכן קומפקטי (תג/כפתור משני), לא לפעולה שצריך להבליט.</li>
            </ul>
        </MCard>
    </div>
</GallerySection>

<GallerySection Id="limitations" Title="Known limitations" Description="פערים ידועים, מתועדים במכוון ולא מוסתרים.">
    <MCard Variant="MCard.CardVariant.Default">
        <ul>
            <li>לחיצת Space על כרטיס אינטראקטיבי אינה קוראת ל-<code>preventDefault()</code>, כך שהעמוד עשוי לגלול מעט — תואם התנהגות קיימת ב-<code>TaskMilestoneAccordion.razor</code>.</li>
            <li><code>OnClick</code> ללא <code>Interactive="true"</code> נכשל בשקט, ללא אזהרה — מתועד במקום להיפתר עם JS interop חדש.</li>
        </ul>
    </MCard>
</GallerySection>

<GallerySection Id="code" Title="Razor usage examples" Description="בדיוק כפי שנכתב בקובץ .razor אמיתי.">
    <CodeBlock Code="@_code" />
</GallerySection>

<GallerySection Id="related" Title="Related Components" Description="קומפוננטות שמופיעות יחד בדפוסי שימוש קיימים בגלריה.">
    <RelatedComponents Items="_related" />
</GallerySection>

@code {
    private static readonly (string Name, string Route)[] _related =
    {
        ("Button", "/motiva/components/button"),
        ("Status Badge", "/motiva/components/status-badge"),
        ("Progress Bar", "/motiva/components/progress-bar"),
    };

    private string? _lastActivation;

    private void HandleCardClick(MouseEventArgs e) => _lastActivation = "לחיצת עכבר (Click)";

    private void HandleContainerKeyDown(KeyboardEventArgs e)
    {
        // The keydown event bubbles from MCard's own focusable root div (which
        // already invokes OnClick for Enter/Space) up to this wrapper, so this
        // always resolves last and correctly overrides "Click" whenever the
        // activation was actually keyboard-driven.
        if (e.Key == "Enter") _lastActivation = "מקש Enter";
        else if (e.Key == " ") _lastActivation = "מקש Space";
    }

    private readonly string _code =
        "<MCard Variant=\"MCard.CardVariant.Default\">\n" +
        "    <h3>סיכום פרויקט</h3>\n" +
        "    <p>נותרו 2 מתוך 6 תוצרים.</p>\n" +
        "</MCard>\n\n" +
        "<MCard Variant=\"MCard.CardVariant.Ambient\" Interactive=\"true\" OnClick=\"OpenTaskDetail\">\n" +
        "    <h3>כרטיס Hero לחיץ</h3>\n" +
        "</MCard>\n\n" +
        "<!-- Header slot: Icon/TrailingContent are RenderFragment child tags,\n" +
        "     Title/Subtitle are plain string attributes -->\n" +
        "<MCard Title=\"דורש התייחסות\">\n" +
        "    <Icon><span class=\"oi oi-bell\" aria-hidden=\"true\"></span></Icon>\n" +
        "    <TrailingContent><MStatusBadge Text=\"3\" Variant=\"MStatusBadge.BadgeVariant.Neutral\" /></TrailingContent>\n" +
        "    <ChildContent>\n" +
        "        <p>...</p>\n" +
        "    </ChildContent>\n" +
        "</MCard>";
}
