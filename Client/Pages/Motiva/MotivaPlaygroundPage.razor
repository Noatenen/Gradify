@page "/motiva/playground"
@layout MotivaGalleryLayout
@using AuthWithAdmin.Client.Components.MotivaGallery
@using System.Text

<PageTitle>Motiva Gallery · Playground</PageTitle>

<DocPageHeader Title="Playground">
    בחרו קומפוננטה, שנו פרמטרים בזמן אמת, וראו קטע קוד Razor תואם. התצוגה
    המקדימה תמיד משתמשת ברכיב Motiva האמיתי — לא בהדמיה ויזואלית.
</DocPageHeader>

<div class="playground-picker">
    <MButton Size="MButton.ButtonSize.Small" Variant="@(_selected == PlaygroundComponent.Button ? MButton.ButtonVariant.Primary : MButton.ButtonVariant.Secondary)"
             OnClick="() => _selected = PlaygroundComponent.Button">Button</MButton>
    <MButton Size="MButton.ButtonSize.Small" Variant="@(_selected == PlaygroundComponent.Card ? MButton.ButtonVariant.Primary : MButton.ButtonVariant.Secondary)"
             OnClick="() => _selected = PlaygroundComponent.Card">Card</MButton>
    <MButton Size="MButton.ButtonSize.Small" Variant="@(_selected == PlaygroundComponent.StatusBadge ? MButton.ButtonVariant.Primary : MButton.ButtonVariant.Secondary)"
             OnClick="() => _selected = PlaygroundComponent.StatusBadge">Status Badge</MButton>
    <MButton Size="MButton.ButtonSize.Small" Variant="@(_selected == PlaygroundComponent.ProgressBar ? MButton.ButtonVariant.Primary : MButton.ButtonVariant.Secondary)"
             OnClick="() => _selected = PlaygroundComponent.ProgressBar">Progress Bar</MButton>
</div>

<div class="playground-layout">
    <div class="playground-controls">
        <span class="playground-controls-label">בקרות</span>
        @switch (_selected)
        {
            case PlaygroundComponent.Button:
                <fieldset class="playground-group">
                    <legend class="playground-group-label">מראה</legend>
                    <label>Variant
                        <select @bind="_btnVariant">
                            <option value="Primary">Primary</option>
                            <option value="Secondary">Secondary</option>
                            <option value="Ghost">Ghost</option>
                            <option value="Danger">Danger</option>
                        </select>
                    </label>
                    <label>Size
                        <select @bind="_btnSize">
                            <option value="Small">Small</option>
                            <option value="Medium">Medium</option>
                            <option value="Large">Large</option>
                        </select>
                    </label>
                </fieldset>
                <fieldset class="playground-group">
                    <legend class="playground-group-label">מצב</legend>
                    <label class="playground-checkbox">
                        <input type="checkbox" @bind="_btnDisabled" /> Disabled
                    </label>
                    <label class="playground-checkbox">
                        <input type="checkbox" @bind="_btnLoading" /> Loading
                    </label>
                </fieldset>
                <fieldset class="playground-group">
                    <legend class="playground-group-label">תוכן</legend>
                    <label>Label text
                        <input type="text" @bind="_btnLabel" @bind:event="oninput" maxlength="40" />
                    </label>
                </fieldset>
                break;

            case PlaygroundComponent.Card:
                <fieldset class="playground-group">
                    <legend class="playground-group-label">מראה</legend>
                    <label>Variant
                        <select @bind="_cardVariant">
                            <option value="Default">Default</option>
                            <option value="Elevated">Elevated</option>
                            <option value="Ambient">Ambient</option>
                        </select>
                    </label>
                    <label>Padding
                        <select @bind="_cardPadding">
                            <option value="Small">Small</option>
                            <option value="Medium">Medium</option>
                            <option value="Large">Large</option>
                        </select>
                    </label>
                </fieldset>
                <fieldset class="playground-group">
                    <legend class="playground-group-label">התנהגות</legend>
                    <label class="playground-checkbox">
                        <input type="checkbox" @bind="_cardInteractive" /> Interactive
                    </label>
                </fieldset>
                <fieldset class="playground-group">
                    <legend class="playground-group-label">תוכן</legend>
                    <label>Demo title
                        <input type="text" @bind="_cardTitle" @bind:event="oninput" maxlength="60" />
                    </label>
                    <label>Demo body
                        <input type="text" @bind="_cardBody" @bind:event="oninput" maxlength="120" />
                    </label>
                </fieldset>
                break;

            case PlaygroundComponent.StatusBadge:
                <fieldset class="playground-group">
                    <legend class="playground-group-label">מראה</legend>
                    <label>Variant
                        <select @bind="_badgeVariant">
                            <option value="Neutral">Neutral</option>
                            <option value="Info">Info</option>
                            <option value="Success">Success</option>
                            <option value="Warning">Warning</option>
                            <option value="Danger">Danger</option>
                        </select>
                    </label>
                    <label class="playground-checkbox">
                        <input type="checkbox" @bind="_badgeIcon" /> Icon (oi-star)
                    </label>
                </fieldset>
                <fieldset class="playground-group">
                    <legend class="playground-group-label">תוכן</legend>
                    <label>Text
                        <input type="text" @bind="_badgeText" @bind:event="oninput" maxlength="40" />
                    </label>
                </fieldset>
                break;

            case PlaygroundComponent.ProgressBar:
                <fieldset class="playground-group">
                    <legend class="playground-group-label">ערכים</legend>
                    <label>Value (@_progressValue)
                        <input type="range" min="-20" max="150" @bind="_progressValue" @bind:event="oninput" />
                    </label>
                    <label>Max
                        <input type="number" @bind="_progressMax" />
                    </label>
                </fieldset>
                <fieldset class="playground-group">
                    <legend class="playground-group-label">מראה</legend>
                    <label>Size
                        <select @bind="_progressSize">
                            <option value="Small">Small</option>
                            <option value="Medium">Medium</option>
                            <option value="Large">Large</option>
                        </select>
                    </label>
                    <label class="playground-checkbox">
                        <input type="checkbox" @bind="_progressShowValue" /> ShowValue
                    </label>
                </fieldset>
                <fieldset class="playground-group">
                    <legend class="playground-group-label">תוכן</legend>
                    <label>Label
                        <input type="text" @bind="_progressLabel" @bind:event="oninput" maxlength="40" />
                    </label>
                </fieldset>
                break;
        }
    </div>

    <div class="playground-preview">
        <ComponentExample Title="תצוגה חיה" Emphasis="true">
            @switch (_selected)
            {
                case PlaygroundComponent.Button:
                    <MButton Variant="BtnVariantEnum"
                             Size="BtnSizeEnum"
                             Disabled="_btnDisabled"
                             Loading="_btnLoading">
                        @(string.IsNullOrWhiteSpace(_btnLabel) ? "כפתור" : _btnLabel)
                    </MButton>
                    break;

                case PlaygroundComponent.Card:
                    <MCard Variant="CardVariantEnum"
                           Padding="CardPaddingEnum"
                           Interactive="_cardInteractive"
                           OnClick="() => _cardActivated = true">
                        <h3>@(string.IsNullOrWhiteSpace(_cardTitle) ? "כותרת" : _cardTitle)</h3>
                        <p>@(string.IsNullOrWhiteSpace(_cardBody) ? "תוכן" : _cardBody)</p>
                    </MCard>
                    @if (_cardInteractive && _cardActivated)
                    {
                        <p class="doc-note">הכרטיס הופעל.</p>
                    }
                    break;

                case PlaygroundComponent.StatusBadge:
                    <MStatusBadge Variant="BadgeVariantEnum"
                                  Text="@_badgeText"
                                  Icon="@(_badgeIcon ? "oi-star" : null)" />
                    break;

                case PlaygroundComponent.ProgressBar:
                    <MProgressBar Value="_progressValue" Max="_progressMax"
                                  Size="ProgressSizeEnum"
                                  ShowValue="_progressShowValue"
                                  Label="@_progressLabel" />
                    break;
            }
        </ComponentExample>

        <CodeBlock Label="קטע קוד שנוצר" Code="@GeneratedCode" />
    </div>
</div>

@code {
    private enum PlaygroundComponent { Button, Card, StatusBadge, ProgressBar }
    private PlaygroundComponent _selected = PlaygroundComponent.Button;

    // Generic Enum.Parse<T> calls can't be written inline inside a Razor
    // component attribute (the <T> reads as markup to the Razor parser), so
    // each dropdown's string state is resolved to its enum here instead.
    private MButton.ButtonVariant BtnVariantEnum => Enum.Parse<MButton.ButtonVariant>(_btnVariant);
    private MButton.ButtonSize BtnSizeEnum => Enum.Parse<MButton.ButtonSize>(_btnSize);
    private MCard.CardVariant CardVariantEnum => Enum.Parse<MCard.CardVariant>(_cardVariant);
    private MCard.CardPadding CardPaddingEnum => Enum.Parse<MCard.CardPadding>(_cardPadding);
    private MStatusBadge.BadgeVariant BadgeVariantEnum => Enum.Parse<MStatusBadge.BadgeVariant>(_badgeVariant);
    private MProgressBar.ProgressSize ProgressSizeEnum => Enum.Parse<MProgressBar.ProgressSize>(_progressSize);

    // Button state
    private string _btnVariant = "Primary";
    private string _btnSize = "Medium";
    private bool _btnDisabled;
    private bool _btnLoading;
    private string _btnLabel = "פעולה ראשית";

    // Card state
    private string _cardVariant = "Default";
    private string _cardPadding = "Medium";
    private bool _cardInteractive;
    private bool _cardActivated;
    private string _cardTitle = "כותרת כרטיס";
    private string _cardBody = "תוכן לדוגמה בכרטיס.";

    // Badge state
    private string _badgeVariant = "Info";
    private string _badgeText = "בבדיקה";
    private bool _badgeIcon;

    // Progress state
    private double _progressValue = 45;
    private double _progressMax = 100;
    private string _progressSize = "Medium";
    private bool _progressShowValue = true;
    private string _progressLabel = "התקדמות";

    // Only ever used to render inside the generated <pre><code> text (via
    // CodeBlock, which Razor HTML-encodes on output) — this escapes quotes so
    // the *displayed* Razor attribute value stays syntactically representative
    // of what a real .razor file would need, it is not executed as markup.
    private static string EscapeForAttribute(string? value) =>
        (value ?? "").Replace("&", "&amp;").Replace("\"", "&quot;").Replace("<", "&lt;").Replace(">", "&gt;");

    private string GeneratedCode => _selected switch
    {
        PlaygroundComponent.Button =>
            $"<MButton Variant=\"MButton.ButtonVariant.{_btnVariant}\"\n" +
            $"         Size=\"MButton.ButtonSize.{_btnSize}\"\n" +
            (_btnDisabled ? "         Disabled=\"true\"\n" : "") +
            (_btnLoading ? "         Loading=\"true\"\n" : "") +
            $"         OnClick=\"HandleClick\">\n" +
            $"    {EscapeForAttribute(_btnLabel)}\n" +
            "</MButton>",

        PlaygroundComponent.Card =>
            $"<MCard Variant=\"MCard.CardVariant.{_cardVariant}\"\n" +
            $"       Padding=\"MCard.CardPadding.{_cardPadding}\"" +
            (_cardInteractive ? "\n       Interactive=\"true\" OnClick=\"HandleClick\">" : ">") + "\n" +
            $"    <h3>{EscapeForAttribute(_cardTitle)}</h3>\n" +
            $"    <p>{EscapeForAttribute(_cardBody)}</p>\n" +
            "</MCard>",

        PlaygroundComponent.StatusBadge =>
            $"<MStatusBadge Variant=\"MStatusBadge.BadgeVariant.{_badgeVariant}\"" +
            (_badgeIcon ? " Icon=\"oi-star\"" : "") +
            $" Text=\"{EscapeForAttribute(_badgeText)}\" />",

        PlaygroundComponent.ProgressBar =>
            $"<MProgressBar Value=\"{_progressValue}\" Max=\"{_progressMax}\"\n" +
            $"              Size=\"MProgressBar.ProgressSize.{_progressSize}\"\n" +
            $"              ShowValue=\"{_progressShowValue.ToString().ToLowerInvariant()}\"\n" +
            $"              Label=\"{EscapeForAttribute(_progressLabel)}\" />",

        _ => ""
    };
}
