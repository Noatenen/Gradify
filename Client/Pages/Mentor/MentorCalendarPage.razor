@page "/mentor/calendar"
@layout AppLayout
@attribute [Authorize(Roles = Roles.Mentor + "," + Roles.Admin + "," + Roles.Staff)]
@namespace AuthWithAdmin.Client.Pages.Mentor
@using Microsoft.AspNetCore.Authorization
@using AuthWithAdmin.Client.Components
@using AuthWithAdmin.Client.Services
@using AuthWithAdmin.Shared.AuthSharedModels
@inject IMentorWorkspaceService Workspace
@inject IGoogleCalendarService GoogleCalendar
@inject NavigationManager Nav

@*
    ── יומן ותכנון — the mentor's CROSS-PROJECT planner ────────────────────
    UX / IA source:  design-reference/mentor-experience/project/
                     Motiva Mentor Calendar.dc.html
    Visual source:   the implemented student experience.
    Data source:     IMentorWorkspaceService.LoadAsync, composed by
                     BuildCalendarAsync — ONE snapshot, fetched here and handed
                     to the builder rather than loaded twice.

    NOT THE STUDENT PLANNER. /milestones is StudentPlanningPage, which is
    single-project by construction; a mentor needs several teams on one grid,
    and every entry here therefore names its project and team. Nothing in the
    mentor shell routes to /milestones any more.

    WHAT IS REAL
      אבני דרך         every milestone due date, from api/mentor/projects/{id}
      הגשות            dated IsSubmission tasks under those milestones
      ממתינות לבדיקה   pending submissions, dated by when they ARRIVED
      משימות אישיות    the mentor's own dated reminders

    WHAT IS MISSING, AND DELIBERATELY ABSENT RATHER THAN FAKED
      פגישות — the design's fifth type. Its own prototype hardcodes a MEETINGS
      array because no table stores a mentor-authored meeting: there is no
      events/meetings entity, no participants, no location, no start/end time.
      The design's "אירוע / פגישה חדשה" modal is unbuildable for the same
      reason. Closing this needs a MentorEvents table (mentor, project?, type,
      date, start/end, location/link, notes) plus CRUD — the single largest
      remaining gap in the mentor area.

    ONE CALL PER PROJECT. Milestone and deliverable dates live only in the
    per-project detail payload; no cross-project endpoint returns them
    (api/milestones/overview carries just the CURRENT milestone). The loader
    fans out concurrently, but a mentor with a large caseload pays for it — a
    cross-project dated-items endpoint would be the fix.
*@

<div class="mcal-header-bleed">
    @*  Title only. The subtitle it used to carry — "פגישות הנחיה, הגשות ואבני
        דרך של הצוותים — במקום אחד" — described the grid immediately below it,
        which says the same thing in colour: five named types in the legend, on
        every entry in every cell. It cost a line of height on a screen whose
        whole job is to fit six week rows, and MPageHeader simply drops the
        element when the parameter is absent. *@
    <MPageHeader Variant="MPageHeader.HeaderVariant.Compact"
                 Title="יומן"
                 Class="mcal-header">
        @*  The reference puts three controls on the title's baseline, in this
            order and at a 12px gap: the view switcher, ONE date unit that
            contains ‹ label › and היום behind a hairline, and the create CTA.

            What is gone from here: the project <select> and the event-type
            <select>. The reference draws neither — its only per-type affordance
            is the legend under the grid, which names the colours rather than
            filtering by them. Both are noted in the page header above. *@
        <Actions>
            @if (!_loading && !_failed)
            {
                <MFilterTabs Tabs="@ViewTabs"
                             ActiveKey="@_view.ToString()"
                             OnSelect="SelectView"
                             AriaLabel="תצוגה" />

                <div class="mcal-datenav">
                    @*  Previous sits at the reading start and points back;
                        next sits at the reading end and points forward. The
                        reference's own markup pairs its "הבא" handler with the
                        BACK glyph and places it first, which would put a
                        forward arrow at the reading start — an internal slip in
                        the mock rather than an instruction, so the glyphs keep
                        the positions every other RTL stepper in the product
                        gives them. *@
                    <button type="button" class="mcal-navbtn" aria-label="תקופה קודמת" @onclick="Prev">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                             stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="m9 6 6 6-6 6"></path>
                        </svg>
                    </button>

                    <span class="mcal-period" dir="ltr" aria-live="polite">@PeriodLabel</span>

                    <button type="button" class="mcal-navbtn" aria-label="תקופה הבאה" @onclick="Next">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                             stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="m15 6-6 6 6 6"></path>
                        </svg>
                    </button>

                    <span class="mcal-navsep" aria-hidden="true"></span>

                    <button type="button" class="mcal-today" @onclick="GoToday">היום</button>
                </div>

                <button type="button" class="mcal-create motiva-cta" @onclick="OpenCreate">
                    <span class="mcal-create-plus" aria-hidden="true">+</span>אירוע / משימה
                </button>
            }
        </Actions>
    </MPageHeader>
</div>

<div class="mcal-body">

    @*  ── Create / edit — A CENTRED DIALOG, not an inline card ─────────
        Identical to the lecturer calendar, which is the source of truth for
        this interaction: same component, same Modal presentation, same
        MModal.ModalSize.Large. There is no mentor variant of the shell.

        The reference drew editing as a gradient-bordered card ON the page and
        that is what this used to render (Presentation="Inline"). Opening it
        pushed the whole grid down the viewport, so the day just clicked was no
        longer where it had been clicked, and the form competed with the
        calendar for the same column instead of sitting over it.

        It is NOT a second editor either way. MentorPersonalTaskModal is the
        product's only mentor-task editor — it owns the fields, the validation,
        the save ORDER and the entire Google Calendar story (connect prompt,
        sync toggle, confirm-before-removal, and the "saved, but not added"
        partial failure). Only the SHELL changed: MModal, at radius-xl over the
        ink scrim, one continuous 28px pad, an 18px bold title with the close X
        opposite it, and ביטול beside the gradient primary in the footer.

        `Projects` is still this mentor's OWN scoped list — the same
        `_projects` the page already loads — so "פרויקט משויך" offers a mentor
        exactly what it offered before. Nothing about permissions, the endpoint
        or the payload changed. *@
    @if (!_loading && !_failed)
    {
        <MentorPersonalTaskModal IsOpen="@_taskModalOpen"
                                 Size="MModal.ModalSize.Large"
                                 EditingTask="@_editingTask"
                                 Projects="@_projects"
                                 InitialDueDate="@_newTaskDate"
                                 OnClose="CloseTaskModal"
                                 OnSaved="OnTaskSaved"
                                 OnDeleted="OnTaskDeleted" />
    }

    @if (_loading)
    {
        <div class="mcal-state" role="status" aria-live="polite">
            <span class="mcal-spinner" aria-hidden="true"></span>
            <span>טוענת את היומן…</span>
        </div>
    }
    else if (_failed)
    {
        @* Failure, not emptiness. Same MEmptyState treatment the rest of Motiva
           uses, with the retry wired to the one loading path — so the button
           cannot drift from what the page does on first render. *@
        <MEmptyState Title="לא הצלחנו לטעון את היומן"
                     Description="ייתכן שיש תקלת רשת זמנית.">
            <Action>
                <MButton Variant="MButton.ButtonVariant.Primary"
                         Size="MButton.ButtonSize.Small"
                         OnClick="RetryAsync">
                    נסי שוב
                </MButton>
            </Action>
        </MEmptyState>
    }
    else if (_events.Count == 0)
    {
        <MEmptyState Title="אין עדיין מועדים ביומן"
                     Description="אבני דרך, הגשות ומשימות אישיות עם תאריך יעד יופיעו כאן אוטומטית." />
    }
    else
    {
        <MCard Padding="MCard.CardPadding.None" Class="mcal-card">
            @if (_view == View.Month)
            {
                <div class="mcal-grid" role="grid" aria-label="@($"לוח חודשי — {PeriodLabel}")">
                    @foreach (var name in DayNames)
                    {
                        <div class="mcal-dayname" role="columnheader">@name</div>
                    }

                    @foreach (var day in MonthCells)
                    {
                        var d = day;
                        var items = EventsOn(d);
                        <div class="mcal-cell @(d.Month != _anchor.Month ? "mcal-cell-out" : "") @(d.Date == DateTime.Now.Date ? "mcal-cell-today" : "")"
                             role="gridcell">
                            @*  ── Click-to-create ──
                                THE WHOLE CELL is the target, not a "+" inside it.
                                A real <button> filling the cell behind its content:
                                focusable, Tab-reachable and Enter/Space-operable for
                                free, which an @onclick on the div would each have to
                                re-implement. The chips and "+N נוספים" are raised
                                above it, so clicking an existing entry opens that
                                entry and never creates.

                                In-month days only — a trailing cell belongs to a
                                month this grid is not showing, and seeding the form
                                with it would file the task out of sight. Same rule
                                the student planner already applies. *@
                            @if (d.Month == _anchor.Month)
                            {
                                <button type="button" class="mcal-cell-add"
                                        aria-label="@($"הוספת משימה ל{DayAndMonth(d)}")"
                                        @onclick="@(() => OpenNewTaskOn(d))"></button>
                            }
                            <div class="mcal-cell-head">
                                <span class="mcal-daynum">@d.Day</span>
                            </div>
                            @*  A LAYOUT WRAPPER, and nothing else — same three chips,
                                same order, same handlers. The row heights are now
                                divided from the viewport rather than summed from
                                their contents, so on a short screen a cell can be
                                handed less height than three chips need. This box
                                is the part that gives way: it clips, while
                                "+N נוספים" below it is pinned and always reachable.
                                Without it the cell would clip in source order and
                                the ONE control that opens the rest of the day would
                                be the first thing to disappear. *@
                            <div class="mcal-cell-items">
                                @foreach (var e in items.Take(3))
                                {
                                    var ev = e;
                                    <button type="button"
                                            class="mcal-item mcal-item-@MentorEventTypes.CssSuffix(ev.Type)"
                                            title="@($"{ev.Title} — {ev.Context}")"
                                            @onclick="@(() => _selected = ev)">
                                        <span class="mcal-dot mcal-dot-@MentorEventTypes.CssSuffix(ev.Type)" aria-hidden="true"></span>
                                        @* The reference prefixes a timed entry with its start hour.
                                           A dated entry gets no prefix rather than a placeholder. *@
                                        @if (ev.HasTime)
                                        {
                                            <span class="mcal-item-time" dir="ltr">@ev.Date.ToString("HH:mm")</span>
                                        }
                                        <span class="mcal-item-text">@ev.Title</span>
                                    </button>
                                }
                            </div>
                            @if (items.Count > 3)
                            {
                                <button type="button" class="mcal-more" @onclick="@(() => SelectDay(d))">
                                    +@(items.Count - 3) נוספים
                                </button>
                            }
                        </div>
                    }
                </div>
            }
            else
            {
                @* ── Week view ── a real week grid, not seven stacked cards.

                   Three bands share ONE column template (an hour gutter plus
                   seven equal day columns), so the day headers, the ללא שעה
                   band and every hour row line up without a single hard-coded
                   width. Under RTL the grid simply flows from the reading
                   edge — the gutter lands on the right and Sunday beside it —
                   which is why no rule here is direction-conditional.

                   NO INVENTED TIMES, exactly as in Day view. Everything this
                   build produces is dated, not timed, so it sits in the ללא
                   שעה band. The hour rows are drawn anyway: they are what
                   makes seven columns read as a week, and each cell is already
                   the correct (day, hour) slot for the moment HasTime entries
                   exist. *@
                var wkToday   = DateTime.Now.Date;
                var weekDays  = WeekDays.ToList();

                @* ONE shared axis across the seven columns, so a block at 09:00
                   on Sunday lines up with 09:00 on Thursday. The range is
                   computed from the WHOLE week for exactly that reason — a
                   per-day range would give each column its own ruler. *@
                var weekTimed = weekDays.SelectMany(d => EventsOn(d).Where(e => e.HasTime)).ToList();
                var weekHours = HourRange(weekTimed);

                <div class="mcal-wk" role="group" aria-label="@($"לוח שבועי — {PeriodLabel}")">

                    @* Compact day headers. The whole header selects its day —
                       the touch path to the add action, since a hover-revealed
                       control can never be reached by a finger. *@
                    <div class="mcal-wk-row mcal-wk-headrow">
                        <div class="mcal-wk-gutter" aria-hidden="true"></div>
                        @foreach (var day in weekDays)
                        {
                            var d = day;
                            <div class="mcal-wk-dayhead @(d == wkToday ? "mcal-wk-col-today" : "") @(_weekPick == d ? "mcal-wk-col-sel" : "")"
                                 @onclick="@(() => _weekPick = d)">
                                <span class="mcal-wk-dayname">@ShortDayNames[(int)d.DayOfWeek]</span>
                                <span class="mcal-wk-daynum">@d.Day</span>
                                <button type="button"
                                        class="mcal-add mcal-add-xs mcal-wk-add motiva-cta"
                                        title="הוספת משימה"
                                        aria-label="@($"הוספת משימה ל{DayAndMonth(d)}")"
                                        @onclick="@(() => OpenNewTaskOn(d))"
                                        @onclick:stopPropagation="true">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6"
                                         stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg>
                                </button>
                            </div>
                        }
                    </div>

                    @* ── ללא שעה ── where every current entry lives. *@
                    <div class="mcal-wk-row mcal-wk-alldayrow">
                        <div class="mcal-wk-gutter mcal-wk-alldaylabel">ללא שעה</div>
                        @foreach (var day in weekDays)
                        {
                            var d = day;
                            var dayAllDay = EventsOn(d).Where(e => !e.HasTime).ToList();
                            <div class="mcal-wk-alldaycell @(d == wkToday ? "mcal-wk-col-today" : "") @(_weekPick == d ? "mcal-wk-col-sel" : "")"
                                 @onclick="@(() => _weekPick = d)">
                                @foreach (var e in dayAllDay.Take(3))
                                {
                                    var ev = e;
                                    <button type="button"
                                            class="mcal-wk-chip mcal-wk-chip-@MentorEventTypes.CssSuffix(ev.Type)"
                                            title="@($"{ev.Title} — {ev.Context}")"
                                            aria-label="@($"פרטי {ev.Title}")"
                                            @onclick="@(() => _selected = ev)"
                                            @onclick:stopPropagation="true">
                                        <span class="mcal-dot mcal-dot-@MentorEventTypes.CssSuffix(ev.Type)" aria-hidden="true"></span>
                                        <span class="mcal-wk-chip-text">@ev.Title</span>
                                    </button>
                                }
                                @if (dayAllDay.Count > 3)
                                {
                                    <button type="button" class="mcal-wk-more"
                                            @onclick="@(() => SelectDay(d))"
                                            @onclick:stopPropagation="true">
                                        +@(dayAllDay.Count - 3) נוספים
                                    </button>
                                }
                            </div>
                        }
                    </div>

                    @* ── Hour rows ──
                       ONE grid rather than thirteen row-grids, for the same
                       reason Day view is: a block has to be able to occupy more
                       than one row. The column template is written out again
                       here (instead of reusing .mcal-wk-row) precisely because
                       this band owns rows as well as columns. *@
                    <div class="mcal-wk-hours">
                        @foreach (var (hour, index) in weekHours.Select((h, i) => (h, i)))
                        {
                            var h   = hour;
                            var row = index + 1;
                            <div class="mcal-wk-gutter mcal-wk-hourlabel" style="grid-row: @row">@h.ToString("00"):00</div>

                            @foreach (var (day, col) in weekDays.Select((d, i) => (d, i)))
                            {
                                var d = day;
                                <div class="mcal-wk-lane @(d == wkToday ? "mcal-wk-col-today" : "") @(_weekPick == d ? "mcal-wk-col-sel" : "") @(IsCurrentHour(d, h) ? "mcal-wk-slot-now" : "")"
                                     style="grid-row: @row; grid-column: @(col + 2)" aria-hidden="true"></div>
                            }
                        }

                        @foreach (var (day, col) in weekDays.Select((d, i) => (d, i)))
                        {
                            var d = day;
                            foreach (var group in EventsOn(d).Where(e => e.HasTime)
                                                             .GroupBy(e => e.Date.Hour)
                                                             .OrderBy(g => g.Key))
                            {
                                var rowStart = weekHours.IndexOf(group.Key) + 1;
                                if (rowStart <= 0) { continue; }

                                @* One row for the stack, per-block heights inside
                                   it — see the note on Day view's equivalent. *@
                                <div class="mcal-wk-stack"
                                     style="grid-row: @rowStart; grid-column: @(col + 2)">
                                    @foreach (var e in group)
                                    {
                                        var ev = e;
                                        <button type="button"
                                                class="mcal-wk-chip mcal-wk-chip-@MentorEventTypes.CssSuffix(ev.Type) mcal-wk-chip-timed @(ev.IsPointInTime ? "mcal-wk-chip-point" : "")"
                                                style="@(ev.IsPointInTime ? "" : $"height: calc(var(--mcal-wk-row-h) * {RowSpan(ev, weekHours)} - 4px)")"
                                                title="@($"{ev.TimeRange} · {ev.Title} — {ev.Context}")"
                                                aria-label="@($"פרטי {ev.Title}, {ev.TimeRange}")"
                                                @onclick="@(() => _selected = ev)">
                                            <span class="mcal-dot mcal-dot-@MentorEventTypes.CssSuffix(ev.Type)" aria-hidden="true"></span>
                                            <span class="mcal-wk-chip-text">@ev.Title</span>
                                        </button>
                                    }
                                </div>
                            }
                        }
                    </div>
                </div>
            }
        </MCard>
        @*  ── Legend ───────────────────────────────────────────────────
            The reference's own footer for the grid: the five colours named,
            and the meaning of the little calendar glyph that rides a synced
            entry. It replaced the "המועדים הקרובים" agenda card that used to
            sit here — the reference draws no agenda, and the legend is what it
            puts in that place. *@
        <div class="mcal-legend">
            @foreach (var t in MentorEventTypes.Ordered)
            {
                <span class="mcal-legend-item">
                    <span class="mcal-dot mcal-dot-@MentorEventTypes.CssSuffix(t)" aria-hidden="true"></span>
                    @MentorEventTypes.Label(t)
                </span>
            }

            <span class="mcal-legend-sync">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect x="3" y="4" width="18" height="18" rx="3"></rect>
                    <path d="M16 2v4M8 2v4M3 10h18"></path>
                </svg>
                = מסונכרן ליומן Google
            </span>
        </div>
    }
</div>

@* ── Entry detail ── *@
@*  ── Entry detail ────────────────────────────────────────────────────
    The reference opens an entry in a fixed drawer at the reading end, over a
    scrim, rather than in a centred modal. Not MModal: that primitive centres
    its dialog and owns its own sizing, and the reference's panel is a
    full-height rail pinned to the edge.

    The facts are unchanged — same values, same wording, same source. Only the
    box and the row rhythm are the reference's. *@
@if (_selected is MentorCalendarEvent sel)
{
    <div class="mcal-scrim" @onclick="@(() => _selected = null)"></div>

    <aside class="mcal-drawer" role="dialog" aria-modal="true" aria-label="@sel.Title">
        <div class="mcal-drawer-top">
            <span class="mcal-drawer-type mcal-drawer-type-@MentorEventTypes.CssSuffix(sel.Type)">
                @MentorEventTypes.Label(sel.Type)
            </span>
            <button type="button" class="mcal-drawer-close" title="סגירה" aria-label="סגירה"
                    @onclick="@(() => _selected = null)">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="2.2" stroke-linecap="round" aria-hidden="true">
                    <path d="M18 6 6 18M6 6l12 12"></path>
                </svg>
            </button>
        </div>

        <h2 class="mcal-drawer-title">@sel.Title</h2>

        <div class="mcal-drawer-facts">
            <div class="mcal-drawer-fact">
                <span class="mcal-drawer-k">תאריך</span>
                <span class="mcal-drawer-v">@FullDate(sel.Date)</span>
            </div>

            @if (sel.TimeRange is { Length: > 0 } range)
            {
                @* Only for an entry whose owner actually chose an hour. A
                   date-only entry has no row here rather than an empty one. *@
                <div class="mcal-drawer-fact">
                    <span class="mcal-drawer-k">שעות</span>
                    <span class="mcal-drawer-v" dir="ltr">@range</span>
                </div>
            }

            <div class="mcal-drawer-fact">
                <span class="mcal-drawer-k">שיוך</span>
                <span class="mcal-drawer-v">@sel.Context</span>
            </div>

            @if (sel.WaitingLabel is { Length: > 0 })
            {
                @* Reviews only — the shared waiting phrase, so this drawer says
                   exactly what the queue row and the digest say. *@
                <div class="mcal-drawer-fact">
                    <span class="mcal-drawer-k">מצב</span>
                    <span class="mcal-drawer-v mcal-drawer-v-attn">@sel.WaitingLabel</span>
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(sel.Detail))
            {
                <div class="mcal-drawer-fact">
                    <span class="mcal-drawer-k">פרטים</span>
                    <span class="mcal-drawer-v">@sel.Detail</span>
                </div>
            }

            @*  יומן Google — stated only for the entries that can BE synced.
                A milestone, a deliverable and a pending review are other
                people's records; the mentor has no Google event for them and a
                "לא מסונכרן" row against one would read as a broken switch
                rather than as a fact. *@
            @if (sel.IsEditable)
            {
                <div class="mcal-drawer-fact">
                    <span class="mcal-drawer-k">יומן Google</span>
                    <span class="@(IsSynced(sel) ? "mcal-drawer-sync-on" : "mcal-drawer-sync-off")">
                        @(IsSynced(sel) ? "✓ מסונכרן ליומן Google" : "לא מסונכרן")
                    </span>
                </div>
            }
        </div>

        @if (sel.IsEditable && IsSynced(sel))
        {
            <p class="mcal-drawer-note">
                שינוי תאריך או שעה כאן יעדכן את האירוע הקיים ביומן Google — לא ייווצר אירוע כפול.
            </p>
        }

        <div class="mcal-drawer-actions">
            @if (sel.IsEditable)
            {
                @* The mentor's own entry opens its editor — the shared one,
                   inline above the grid. *@
                <button type="button" class="mcal-drawer-edit" @onclick="@(() => OpenPersonalTask(sel))">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M17 3a2.8 2.8 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"></path>
                    </svg>
                    עריכה
                </button>
            }

            @if (sel.Href is { Length: > 0 })
            {
                <button type="button" class="mcal-drawer-go motiva-cta" @onclick="OpenSelected">
                    @(sel.ProjectId is null ? "למשימות שלי" : "לפרטי הצוות")
                </button>
            }
        </div>
    </aside>
}

@* ── Day detail, from "+N נוספים" ── *@
<MModal IsOpen="@(_selectedDay is not null)"
        Size="MModal.ModalSize.Medium"
        Title="@(_selectedDay is DateTime sd ? DayAndMonth(sd) : "")"
        OnClose="@(() => _selectedDay = null)">
    <ChildContent>
        @if (_selectedDay is not null)
        {
            <MRowList Inset="true" AriaLabel="מועדי היום">
                @foreach (var e in EventsOn(_selectedDay.Value))
                {
                    var ev = e;
                    <MRow OnClick="@(() => { _selectedDay = null; _selected = ev; })"
                          Primary="@ev.Title"
                          Secondary="@ev.Context"
                          Meta="@MentorEventTypes.Label(ev.Type)">
                        <Leading>
                            <span class="mcal-dot mcal-dot-@MentorEventTypes.CssSuffix(ev.Type)" aria-hidden="true"></span>
                        </Leading>
                    </MRow>
                }
            </MRowList>
        }
    </ChildContent>
    <FooterContent>
        @* Creating for the day the mentor already opened — the same shared
           editor, reached from month and week too, not only from Day view. *@
        @if (_selectedDay is DateTime addDay)
        {
            <button type="button" class="mcal-add motiva-cta"
                    title="הוספת משימה"
                    aria-label="@($"הוספת משימה ל{DayAndMonth(addDay)}")"
                    @onclick="@(() => OpenNewTaskOn(addDay))">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"
                     stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg>
            </button>
        }
        <MButton Variant="MButton.ButtonVariant.Secondary" OnClick="@(() => _selectedDay = null)">סגירה</MButton>
    </FooterContent>
</MModal>

@code {
    /// <summary>Month stays first, and stays the default — the mentor's question
    /// on opening this screen is "what is coming", not "what is today".</summary>
    /// <summary>Two views, which is what the reference draws. יום was a third
    /// tab this app had and the reference does not; its content is reachable
    /// through the week grid and the detail drawer.</summary>
    private enum View { Month, Week }

    /// <summary>
    /// The Hebrew date vocabulary, from the ONE place that owns it.
    ///
    /// <para>These used to be private arrays here. They moved to
    /// <see cref="MotivaDates"/> when the task editor grew a date picker that
    /// feeds this very grid: a picker that says "19 באוגוסט" while the calendar
    /// it writes to words the same day differently is two vocabularies for one
    /// product. Forwarders rather than a rename, so every call site on this page
    /// reads exactly as it did.</para>
    ///
    /// <para><b>Still not a CultureInfo</b>, for the reason MotivaDates
    /// documents: Blazor WASM ships sharded ICU data, and
    /// <c>new CultureInfo("he-IL")</c> throws outright in a browser whose
    /// language did not pull the Hebrew shard.</para>
    /// </summary>
    private static readonly string[] DayNames = MotivaDates.DayNames;

    /// <summary>Week-header abbreviations. A week column is far too narrow for
    /// "ראשון", and the single Hebrew letter is how every Hebrew calendar
    /// labels a column.</summary>
    private static readonly string[] ShortDayNames = MotivaDates.ShortDayNames;

    private static readonly string[] MonthNames = MotivaDates.MonthNames;

    /// <summary>"שני" — the weekday name.</summary>
    private static string DayName(DateTime d) => MotivaDates.DayName(d);

    /// <summary>"17 באוגוסט".</summary>
    private static string DayAndMonth(DateTime d) => MotivaDates.DayAndMonth(d);

    /// <summary>"שני, 17 באוגוסט 2026".</summary>
    private static string FullDate(DateTime d) => MotivaDates.FullDate(d);

    private IReadOnlyList<MentorCalendarEvent> _events = Array.Empty<MentorCalendarEvent>();
    private List<MentorProjectSummaryDto>      _projects = new();

    /// <summary>The mentor's own tasks from the same snapshot the events were
    /// built from. Kept so a personal-task entry can open its editor without a
    /// second fetch — and so it can only ever resolve to one of their own.</summary>
    private List<PersonalTaskDto>              _personalTasks = new();

    /// <summary>
    /// Ids of the mentor's personal tasks that Google has CONFIRMED an event
    /// for. Read from the same endpoint the editor reads — this page never
    /// decides what is synced, it only reports it.
    ///
    /// <para>IsScheduled, not merely "a link row exists": a link awaiting a
    /// retry after a Google failure comes back false, and the reference's
    /// "✓ מסונכרן" is a claim about the calendar, not about our own table.</para>
    /// </summary>
    private HashSet<int> _syncedTaskIds = new();
    private bool _loading = true;

    /// <summary>Load or compose failed. Distinct from "loaded and empty", which
    /// is a legitimate answer and keeps its own empty state.</summary>
    private bool _failed;

    private View             _view = View.Month;

    /// <summary>חודש · שבוע — the reference's segmented pill group, which is the
    /// same MFilterTabs object every other finished mentor screen uses.</summary>
    private IReadOnlyList<MFilterTabs.Tab> ViewTabs => new[]
    {
        new MFilterTabs.Tab(View.Month.ToString(), "חודש"),
        new MFilterTabs.Tab(View.Week.ToString(),  "שבוע"),
    };

    private void SelectView(string key)
    {
        if (Enum.TryParse<View>(key, out var v)) _view = v;
    }

    /// <summary>The header CTA. Seeds the editor with the day the calendar is
    /// already showing — see GlobalAddDate — and the date stays editable.</summary>
    private void OpenCreate() => OpenNewTaskOn(GlobalAddDate);
    private DateTime         _anchor = DateTime.Now.Date;

    private MentorCalendarEvent? _selected;
    private DateTime?            _selectedDay;

    /// <summary>The day a mentor tapped in Week view. It pins that column's +
    /// visible, which is the ONLY way the add action is reachable without a
    /// pointer — hover reveals it for a mouse, this reveals it for a finger.
    /// It selects a date and nothing else: no filtering, no navigation.</summary>
    private DateTime? _weekPick;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    /// <summary>
    /// The one loading path, shared by first render and by "נסי שוב".
    ///
    /// <para><b>ONE snapshot.</b> The page needs Projects for the filter chips
    /// and the calendar needs the same snapshot to compose from, so it is
    /// fetched once here and handed to BuildCalendarAsync. It used to be loaded
    /// twice — once here and again inside the calendar builder.</para>
    ///
    /// <para><b>The finally is the point.</b> Every underlying service already
    /// swallows transport errors, so the realistic failure is something later —
    /// a malformed payload, a null the composer did not expect. Whatever it is,
    /// _loading is cleared on the way out, so the page can end up loaded or
    /// failed but never stuck on the spinner.</para>
    /// </summary>
    private async Task LoadAsync()
    {
        _loading = true;
        _failed  = false;

        try
        {
            var snapshot   = await Workspace.LoadAsync();
            _projects      = snapshot.Projects.ToList();
            _personalTasks = snapshot.PersonalTasks.ToList();
            _events        = await Workspace.BuildCalendarAsync(snapshot);

            // Never fatal: the calendar is fully readable without knowing what
            // is in Google, so a failure here drops the sync badges and nothing
            // else. The service already swallows transport errors.
            _syncedTaskIds = (await GoogleCalendar.GetPersonalTaskSchedulesAsync())
                             .Where(x => x.IsScheduled)
                             .Select(x => x.TaskId)
                             .ToHashSet();
        }
        catch
        {
            // Nothing partial is kept: a half-built calendar would quietly
            // under-report a mentor's month, which is worse than saying so.
            _failed        = true;
            _events        = Array.Empty<MentorCalendarEvent>();
            _projects      = new();
            _personalTasks = new();
            _syncedTaskIds = new();
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task RetryAsync()
    {
        await LoadAsync();
        StateHasChanged();
    }

    // ── Row metadata ────────────────────────────────────────────────────

    /// <summary>
    /// The meta column.
    ///
    /// <para><b>A review is not a deadline, and this used to say it was.</b>
    /// ממתינות לבדיקה entries are dated by ARRIVAL — that is the only real date
    /// they have — so every one of them is in the past, and running them through
    /// DeadlineLabel rendered "באיחור 27 ימים" against a deadline that does not
    /// exist. They now carry the shared waiting phrase from the attention model
    /// instead, the same string the Tasks queue and the daily digest print.</para>
    ///
    /// <para>Milestones and dated deliverables DO have real due dates and keep
    /// deadline wording, including באיחור, which is true of them.</para>
    /// </summary>

    // ── Filtering ───────────────────────────────────────────────────────

    /// <summary>
    /// Every entry. This used to narrow by a type <select> and a project
    /// <select>; the reference draws neither — its only per-type affordance is
    /// the legend, which NAMES the colours rather than filtering by them — so
    /// both controls and both fields are gone.
    ///
    /// <para>Kept as a named seam rather than inlined: every grid reads through
    /// it, so a filter that comes back has exactly one place to come back to.</para>
    /// </summary>
    private IEnumerable<MentorCalendarEvent> Filtered => _events;

    private List<MentorCalendarEvent> EventsOn(DateTime day) =>
        Filtered.Where(e => e.Date.Date == day.Date).ToList();

    // ── Period navigation ───────────────────────────────────────────────

    /// <summary>The step matches the view: a month, a week, or a single day.</summary>

    private void Prev()   => _anchor = _view == View.Month ? _anchor.AddMonths(-1) : _anchor.AddDays(-7);
    private void Next()   => _anchor = _view == View.Month ? _anchor.AddMonths(1)  : _anchor.AddDays(7);
    private void GoToday() => _anchor = DateTime.Now.Date;

    private void SelectDay(DateTime d) => _selectedDay = d;

    /// <summary>
    /// The date the persistent + hands to the modal.
    ///
    /// <para>One rule, stated once: an explicitly picked day wins; otherwise
    /// today, when today is inside the period on screen; otherwise the first day
    /// of that period. So the button is never "create for some date you did not
    /// choose" — it is always the most specific date the calendar is currently
    /// showing, and the modal leaves it editable regardless.</para>
    ///
    /// <para>Only week carries an explicit pick (<c>_weekPick</c>), because only
    /// week has a selection gesture. In month, the per-cell + already IS the
    /// per-date action, so the toolbar button answers the period-level question
    /// instead of duplicating it.</para>
    /// </summary>
    private DateTime GlobalAddDate => _view switch
    {
        View.Week => _weekPick ?? DefaultWithin(WeekStart, WeekStart.AddDays(6)),
        _         => DefaultWithin(new DateTime(_anchor.Year, _anchor.Month, 1),
                                   new DateTime(_anchor.Year, _anchor.Month, 1).AddMonths(1).AddDays(-1)),
    };

    private static DateTime DefaultWithin(DateTime from, DateTime to)
    {
        var today = DateTime.Now.Date;
        return today >= from.Date && today <= to.Date ? today : from.Date;
    }

    /// <summary>
    /// The one date statement in the hero, shaped per view.
    ///
    ///   month  אוגוסט 2026
    ///   week   16–22 באוגוסט 2026   (or 30 באוגוסט – 5 בספטמבר 2026 across a month)
    ///   day    שלישי, 18 באוגוסט
    ///
    /// The year is dropped from the day label: someone paging a single day
    /// already knows which year they are in, and the segmented control beside
    /// it is where the eye goes next.
    /// </summary>
    private string PeriodLabel => _view switch
    {
        View.Month => $"{MonthNames[_anchor.Month - 1]} {_anchor.Year}",
        _          => WeekLabel,
    };

    private string WeekLabel
    {
        get
        {
            var from = WeekStart;
            var to   = WeekStart.AddDays(6);

            return from.Month == to.Month
                ? $"{from.Day}–{to.Day} ב{MonthNames[from.Month - 1]} {to.Year}"
                : $"{DayAndMonth(from)} – {DayAndMonth(to)} {to.Year}";
        }
    }

    /// <summary>Sunday-first, which is the Hebrew calendar week and what
    /// DayNames above is ordered by.</summary>
    private DateTime WeekStart => _anchor.AddDays(-(int)_anchor.DayOfWeek);

    private IEnumerable<DateTime> WeekDays =>
        Enumerable.Range(0, 7).Select(i => WeekStart.AddDays(i));

    /// <summary>Six weeks from the Sunday on or before the 1st — a fixed cell
    /// count keeps the grid from changing height as the month changes.</summary>
    private IEnumerable<DateTime> MonthCells
    {
        get
        {
            var first = new DateTime(_anchor.Year, _anchor.Month, 1);
            var start = first.AddDays(-(int)first.DayOfWeek);
            return Enumerable.Range(0, 42).Select(i => start.AddDays(i));
        }
    }

    private void OpenSelected()
    {
        var href = _selected?.Href;
        _selected = null;
        if (href is not null) Nav.NavigateTo(href);
    }

    // ── Personal tasks, created and edited in place ──────────────────────

    private bool             _taskModalOpen;
    private PersonalTaskDto? _editingTask;
    private DateTime?        _newTaskDate;

    /// <summary>The default working day the grid draws: 08:00–20:00, not 24
    /// rows. It keeps the grid scannable without scrolling past ten empty night
    /// hours.</summary>
    private const int DefaultFirstHour = 8;
    private const int DefaultLastHour  = 20;

    /// <summary>
    /// The hour rows to draw, given the timed entries that must fit on them.
    ///
    /// <para><b>The range widens; it never drops anything.</b> A block booked at
    /// 06:30, or one running to 22:00, extends the grid rather than being hidden
    /// off the top or bottom of it — a calendar that silently omits something
    /// the mentor scheduled is worse than a slightly taller calendar. The
    /// default window is the floor, so an ordinary day still reads 08:00–20:00
    /// and nothing moves.</para>
    ///
    /// <para>A list, not an enumerable: the grid needs IndexOf to turn an hour
    /// into a row number, and re-enumerating a lazy range once per block is
    /// waste for no gain.</para>
    /// </summary>
    private static List<int> HourRange(IReadOnlyCollection<MentorCalendarEvent> timed)
    {
        int first = DefaultFirstHour;
        int last  = DefaultLastHour;

        foreach (var e in timed)
        {
            first = Math.Min(first, e.Date.Hour);

            // The row an entry ENDS on is the hour containing its last minute:
            // 11:00 finishes the 10:00 row, while 11:15 spills into the 11:00
            // one. Subtracting a minute states that without a special case.
            // An entry with no end occupies only the hour it falls in.
            last = Math.Max(last, e.EndsAt is DateTime ends
                                      ? ends.AddMinutes(-1).Hour
                                      : e.Date.Hour);
        }

        return Enumerable.Range(first, Math.Max(1, last - first + 1)).ToList();
    }

    /// <summary>
    /// How many hour rows one block covers — its DURATION, expressed in the
    /// grid's own units rather than only in its label.
    ///
    /// <para>Clamped to what is actually drawn, so a block running past the last
    /// row stops at it instead of pushing phantom rows into the grid. A block
    /// with no stated end covers one row: null means "no duration was given",
    /// never "one hour".</para>
    /// </summary>
    private static int RowSpan(MentorCalendarEvent ev, List<int> hours)
    {
        if (ev.EndsAt is not DateTime ends) return 1;

        int startRow = hours.IndexOf(ev.Date.Hour);
        int endRow   = hours.IndexOf(ends.AddMinutes(-1).Hour);

        if (startRow < 0) return 1;
        if (endRow < startRow) endRow = hours.Count - 1;

        return Math.Max(1, endRow - startRow + 1);
    }

    private static bool IsCurrentHour(DateTime day, int hour) =>
        day.Date == DateTime.Now.Date && DateTime.Now.Hour == hour;

    /// <summary>"אין מועדים" / "מועד אחד" / "N מועדים" — the day heading's count.</summary>
    private static string CountLabel(int n) => n switch
    {
        0 => "אין מועדים",
        1 => "מועד אחד",
        _ => $"{n} מועדים",
    };

    /// <summary>Opens the shared editor for a NEW task on the given day. The
    /// date is a starting point the mentor can still change before saving.</summary>
    private void OpenNewTaskOn(DateTime day)
    {
        _selected      = null;
        _selectedDay   = null;
        _editingTask   = null;
        _newTaskDate   = day.Date;
        _taskModalOpen = true;
    }

    /// <summary>
    /// Opens the editor for the personal task behind a calendar entry.
    ///
    /// <para>The event id carries the row id ("pt-{id}"), and the task itself is
    /// found in the snapshot this page already loaded — so the calendar can only
    /// ever open one of this mentor's own tasks, and needs no extra fetch.</para>
    /// </summary>
    /// <summary>
    /// Whether this entry has a confirmed Google event.
    ///
    /// <para>Only the mentor's OWN entries can have one, and their id is
    /// <c>pt-{taskId}</c> — the same key BuildCalendarAsync mints. Anything
    /// else answers false, which is why the drawer only asks for the two types
    /// that can be synced at all.</para>
    /// </summary>
    private bool IsSynced(MentorCalendarEvent ev) =>
        ev.IsEditable
        && ev.Id.StartsWith("pt-", StringComparison.Ordinal)
        && int.TryParse(ev.Id.AsSpan(3), out var taskId)
        && _syncedTaskIds.Contains(taskId);

    private void OpenPersonalTask(MentorCalendarEvent ev)
    {
        // IsEditable, not a single type: a פגישה is the SAME PersonalTasks row
        // as a משימה אישית — it is simply one that carries a team and an hour —
        // so testing for one type alone made Edit silently no-op on every
        // meeting the mentor owns.
        if (!ev.IsEditable) return;
        if (!int.TryParse(ev.Id.StartsWith("pt-") ? ev.Id[3..] : "", out var taskId)) return;

        var task = _personalTasks.FirstOrDefault(t => t.Id == taskId);
        if (task is null) return;

        _selected      = null;
        _editingTask   = task;
        _newTaskDate   = null;
        _taskModalOpen = true;
    }

    private void CloseTaskModal()
    {
        _taskModalOpen = false;
        _editingTask   = null;
        _newTaskDate   = null;
    }

    /// <summary>A save changed the mentor's own tasks, so the calendar is rebuilt
    /// from a fresh snapshot — that is what makes the new item appear in day,
    /// week and month at once without a browser refresh.</summary>
    private async Task OnTaskSaved(PersonalTaskDto _)
    {
        _taskModalOpen = false;
        _editingTask   = null;
        _newTaskDate   = null;
        await LoadAsync();
    }

    private async Task OnTaskDeleted(int _)
    {
        _taskModalOpen = false;
        _editingTask   = null;
        _newTaskDate   = null;
        await LoadAsync();
    }
}
