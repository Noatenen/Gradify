@page "/mentor/tasks"
@layout AppLayout
@attribute [Authorize(Roles = Roles.Mentor + "," + Roles.Admin + "," + Roles.Staff)]
@namespace AuthWithAdmin.Client.Pages.Mentor
@using Microsoft.AspNetCore.Authorization
@using AuthWithAdmin.Client.Components
@using AuthWithAdmin.Client.Services
@using AuthWithAdmin.Shared.AuthSharedModels
@inject IMentorWorkspaceService Workspace
@inject IMentorProjectsService MentorService
@inject IPersonalTasksService PersonalTasks
@inject NavigationManager Nav
@implements IDisposable

@*
    ── המשימות שלי — the mentor's unified work queue ────────────────────────
    Visual source:   משימות 1/2/3.png in design/design-system/MotivaLecturerDesign.

    TWO-SURFACE LAYOUT
    RIGHT (wider, 1.85fr in RTL): work queue — flat scrollable list of all
    submissions and requests waiting on this mentor, with a segmented filter
    tab group (הכל / הגשות לבדיקה / בקשות) at the top of the panel.
    LEFT (narrower, 1fr in RTL): personal tasks — always visible, never
    filtered by the queue tabs.

    THREE STATES
    1. Default: flat queue list (type badge · timing · title · team context)
       plus personal tasks rail.
    2. Inline expansion: clicking a submission row expands it to show the
       student notes, the drive link, and two CTAs.
    3. Review modal: "לבדיקת ההגשה" from an expanded row opens a centred modal
       over a dimmed backdrop — the same approve/return flow as MentorSubmissionsPage.

    Request rows open MentorRequestModal directly on click (no inline expansion).

    DATA SOURCES (unchanged)
    הגשות לבדיקה  → _reviews    (IMentorWorkspaceService, Kind = Submission)
    בקשות          → _awaitingMe (IMentorWorkspaceService, Kind = Request)
    משימות אישיות  → _openPersonal / _donePersonal (IPersonalTasksService)
    Review context → IMentorProjectsService.GetSubmissionContextAsync (lazy, on expand)
*@

@* ── Review modal (State 3) ──────────────────────────────────────────────── *@
@if (_reviewModalCtx is not null)
{
    <div class="mt-modal-backdrop" @onclick="CloseReviewModal" aria-hidden="true"></div>
    <div class="mt-modal" role="dialog" aria-modal="true" aria-labelledby="mt-modal-title" dir="rtl">

        <div class="mt-modal-header">
            <span class="mt-modal-badge">הגשה לבדיקה</span>
            <button type="button" class="mt-modal-close"
                    @onclick="CloseReviewModal" aria-label="סגירה">×</button>
        </div>

        <h2 class="mt-modal-title" id="mt-modal-title">
            @_reviewModalCtx.TaskTitle
            @if (_reviewModalCtx.History.Count > 0)
            {
                <span class="mt-modal-version"> – גרסה @_reviewModalCtx.History[0].RoundNumber</span>
            }
        </h2>

        <p class="mt-modal-ctx">
            @if (!string.IsNullOrWhiteSpace(_reviewModalCtx.SubmittedBy))
            {
                <span>@_reviewModalCtx.SubmittedBy</span>
                <span class="mt-modal-ctx-sep"> · </span>
            }
            @if (!string.IsNullOrWhiteSpace(_expandedItem?.TeamName))
            {
                <span>@_expandedItem!.TeamName</span>
                <span class="mt-modal-ctx-sep"> · </span>
            }
            @if (!string.IsNullOrWhiteSpace(_expandedItem?.ProjectTitle))
            {
                <span>@_expandedItem!.ProjectTitle</span>
                <span class="mt-modal-ctx-sep"> · </span>
            }
            <span>@(_expandedItem?.WaitingLabel ?? "")</span>
        </p>

        @* Metadata row: version · submit date · previous round date *@
        <div class="mt-modal-meta">
            @if (_reviewModalCtx.History.Count > 0)
            {
                <span class="mt-modal-meta-item">גרסה @_reviewModalCtx.History[0].RoundNumber</span>
                <span class="mt-modal-meta-sep"> · </span>
                <span class="mt-modal-meta-item">
                    מועד הגשה
                    @_reviewModalCtx.SubmittedAt.ToLocalTime().ToString("HH:mm") ·
                    @_reviewModalCtx.SubmittedAt.ToLocalTime().ToString("dd.MM")
                </span>
            }
            @if (_reviewModalCtx.History.Count > 1)
            {
                <span class="mt-modal-meta-sep"> · </span>
                <span class="mt-modal-meta-item">
                    גרסה קודמת: גרסה @_reviewModalCtx.History[1].RoundNumber ·
                    @_reviewModalCtx.History[1].SubmittedAt.ToLocalTime().ToString("dd.MM")
                </span>
            }
        </div>

        @* Drive / resource link *@
        @if (!string.IsNullOrWhiteSpace(_reviewModalCtx.DriveUrl))
        {
            <div class="mt-modal-resource">
                <svg class="mt-modal-resource-icon" width="14" height="14" viewBox="0 0 24 24"
                     fill="none" stroke="currentColor" stroke-width="1.8"
                     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M13 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z"/>
                    <polyline points="13 2 13 9 20 9"/>
                </svg>
                <span class="mt-modal-resource-label">@_reviewModalCtx.TaskTitle</span>
                <a class="mt-modal-resource-open"
                   href="@_reviewModalCtx.DriveUrl"
                   target="_blank" rel="noopener noreferrer">פתיחה</a>
            </div>
        }

        @* Student notes *@
        @if (!string.IsNullOrWhiteSpace(_reviewModalCtx.Notes))
        {
            <div class="mt-modal-section">
                <p class="mt-modal-section-title">הערת המגיש</p>
                <p class="mt-modal-section-body">@_reviewModalCtx.Notes</p>
            </div>
        }

        @* Previous round mentor feedback *@
        @if (_reviewModalCtx.History.Count > 1 &&
             !string.IsNullOrWhiteSpace(_reviewModalCtx.History[1].MentorFeedback))
        {
            <div class="mt-modal-section mt-modal-prev-feedback">
                <p class="mt-modal-section-title">הערה מהסבב הקודם</p>
                <p class="mt-modal-section-body">@_reviewModalCtx.History[1].MentorFeedback</p>
            </div>
        }

        @* Mentor review *@
        <div class="mt-modal-section">
            <p class="mt-modal-section-title">הבדיקה שלך</p>
            <textarea class="mt-modal-textarea"
                      placeholder="כתבו משוב לצוות..."
                      @bind="_reviewModalFeedback"
                      @bind:event="oninput"
                      rows="4">
            </textarea>
            @if (!string.IsNullOrEmpty(_reviewModalFeedbackError))
            {
                <p class="mt-modal-field-error">@_reviewModalFeedbackError</p>
            }
        </div>

        @if (_reviewModalError)
        {
            <p class="mt-modal-error">אירעה שגיאה. נסה שנית.</p>
        }

        <div class="mt-modal-footer">
            <button type="button" class="motiva-cta mt-modal-approve"
                    @onclick='() => SubmitReviewAsync("Approved")'
                    disabled="@_reviewModalBusy">
                @if (_reviewModalBusy && _reviewModalPendingAction == "Approved")
                { <span>מאשר…</span> }
                else
                { <span>✓ אישור ההגשה</span> }
            </button>
            <button type="button" class="mt-modal-return"
                    @onclick='() => SubmitReviewAsync("Returned")'
                    disabled="@_reviewModalBusy">
                @if (_reviewModalBusy && _reviewModalPendingAction == "Returned")
                { <span>מחזיר…</span> }
                else
                { <span>החזרה לתיקון</span> }
            </button>
        </div>
    </div>
}

<div class="mt-header-bleed">
    <MPageHeader Variant="MPageHeader.HeaderVariant.Compact"
                 Title="המשימות שלי"
                 Subtitle="הגשות, בקשות ותזכורות אישיות שממתינות לפעולה שלך." />
</div>

<div class="mt-body">

    @if (_loading)
    {
        <MLoadingState Label="טוענת את המשימות…" />
    }
    else
    {
        @*
            ── THE WORKSPACE ────────────────────────────────────────────────
            Two columns, always both visible. In RTL the first column (1.85fr)
            is the WIDER one on the visual RIGHT — the work queue. The second
            (1fr) is the narrower rail on the LEFT — personal tasks.
        *@
        <div id="task-sections" class="mt-workspace">

            @* ── RIGHT / WIDER: Work queue with segmented filter ─── *@
            <div class="mt-primary">
                <MCard Padding="MCard.CardPadding.None" Fill="true">
                    <div class="mt-panel">

                        @* Segmented filter tabs — inside the panel, not in
                           the page header. The header carries only the title. *@
                        <div class="mt-panel-head">
                            <div class="mt-queue-tabs" role="tablist" aria-label="סינון תור העבודה">
                                <button type="button"
                                        class="mt-qtab @(_queueTab == "" ? "mt-qtab-active" : "")"
                                        role="tab"
                                        aria-selected="@(_queueTab == "" ? "true" : "false")"
                                        @onclick='() => _queueTab = ""'>
                                    הכל
                                    @if (IncomingCount > 0)
                                    {
                                        <span class="mt-qtab-count motiva-count">@IncomingCount</span>
                                    }
                                </button>
                                <button type="button"
                                        class="mt-qtab @(_queueTab == "reviews" ? "mt-qtab-active" : "")"
                                        role="tab"
                                        aria-selected="@(_queueTab == "reviews" ? "true" : "false")"
                                        @onclick='() => _queueTab = "reviews"'>
                                    הגשות לבדיקה
                                    @if (_reviews.Count > 0)
                                    {
                                        <span class="mt-qtab-count motiva-count">@_reviews.Count</span>
                                    }
                                </button>
                                <button type="button"
                                        class="mt-qtab @(_queueTab == "requests" ? "mt-qtab-active" : "")"
                                        role="tab"
                                        aria-selected="@(_queueTab == "requests" ? "true" : "false")"
                                        @onclick='() => _queueTab = "requests"'>
                                    בקשות
                                    @if (_awaitingMe.Count > 0)
                                    {
                                        <span class="mt-qtab-count motiva-count">@_awaitingMe.Count</span>
                                    }
                                </button>
                            </div>
                        </div>

                        <MScrollArea Tabbable="false">
                            @if (FilteredQueue.Count == 0)
                            {
                                <MEmptyState Title="אין פריטים כרגע."
                                             Description="הגשות ובקשות שממתינות לפעולתך יופיעו כאן."
                                             Live="true" />
                            }
                            else
                            {
                                @foreach (var item in FilteredQueue)
                                {
                                    var isSubmission = item.Kind == MentorAttentionKind.Submission;
                                    var isExpanded   = _expandedItemId == item.EntityId;

                                    <div class="mt-qitem @(isExpanded ? "mt-qitem-open" : "")">

                                        @* Collapsed row — always visible *@
                                        <button type="button"
                                                class="mt-qitem-row"
                                                @onclick="() => ToggleQueueItem(item)"
                                                aria-expanded="@(isExpanded && isSubmission ? "true" : "false")"
                                                aria-label="@RowAriaLabel(item, item.Title)">

                                            <span class="mt-qitem-top">
                                                <span class="mt-qbadge @(isSubmission ? "mt-qbadge-sub" : "mt-qbadge-req")">
                                                    @(isSubmission ? "הגשה לבדיקה" : "בקשה")
                                                </span>
                                                <span class="mt-qitem-timing @AgeClass(item)">@StateLabel(item)</span>
                                            </span>

                                            <strong class="mt-qitem-title">@item.Title</strong>

                                            <span class="mt-qitem-ctx">
                                                @if (!string.IsNullOrWhiteSpace(item.TeamName))
                                                {
                                                    <span>@item.TeamName</span>
                                                    @if (!string.IsNullOrWhiteSpace(item.ProjectTitle))
                                                    {
                                                        <span class="mt-qitem-ctx-sep"> · </span>
                                                        <span>@item.ProjectTitle</span>
                                                    }
                                                }
                                                else if (!string.IsNullOrWhiteSpace(item.ProjectTitle))
                                                {
                                                    <span>@item.ProjectTitle</span>
                                                }
                                            </span>

                                            @* Chevron — only for submission rows that expand inline.
                                               Request rows carry no chevron: they open a modal directly. *@
                                            @if (isSubmission)
                                            {
                                                <span class="mt-qitem-chevron @(isExpanded ? "mt-qitem-chevron-open" : "")"
                                                      aria-hidden="true">
                                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                                         stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                                        <path d="m6 9 6 6 6-6"></path>
                                                    </svg>
                                                </span>
                                            }
                                        </button>

                                        @* Inline expansion (State 2) — submissions only *@
                                        @if (isExpanded && isSubmission)
                                        {
                                            <div class="mt-qitem-body">
                                                @if (_loadingExpansion)
                                                {
                                                    <span class="mt-qitem-loading">טוען פרטי הגשה…</span>
                                                }
                                                else if (_expandedCtx is not null)
                                                {
                                                    @if (!string.IsNullOrWhiteSpace(_expandedCtx.Notes))
                                                    {
                                                        <p class="mt-qitem-notes">@_expandedCtx.Notes</p>
                                                    }

                                                    @if (!string.IsNullOrWhiteSpace(_expandedCtx.DriveUrl))
                                                    {
                                                        <a class="mt-qitem-resource"
                                                           href="@_expandedCtx.DriveUrl"
                                                           target="_blank"
                                                           rel="noopener noreferrer">
                                                            <svg class="mt-qitem-resource-icon" width="14" height="14"
                                                                 viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                                                 stroke-width="1.8" stroke-linecap="round"
                                                                 stroke-linejoin="round" aria-hidden="true">
                                                                <path d="M13 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z"/>
                                                                <polyline points="13 2 13 9 20 9"/>
                                                            </svg>
                                                            <span class="mt-qitem-resource-label">
                                                                קישור ל'@_expandedCtx.TaskTitle'
                                                            </span>
                                                        </a>
                                                    }

                                                    <div class="mt-qitem-actions">
                                                        <button type="button"
                                                                class="motiva-cta mt-qitem-review"
                                                                @onclick="OpenReviewModal">
                                                            לבדיקת ההגשה
                                                        </button>
                                                        @if (item.ProjectId.HasValue)
                                                        {
                                                            <a class="mt-qitem-project"
                                                               href="/mentor/projects/@item.ProjectId">
                                                                למרחב הפרויקט
                                                            </a>
                                                        }
                                                    </div>
                                                }
                                            </div>
                                        }
                                    </div>
                                }
                            }
                        </MScrollArea>
                    </div>
                </MCard>
            </div>

            @* ── LEFT / NARROWER: Personal tasks rail ─────────── *@
            <div class="mt-rail">
                <MCard Padding="MCard.CardPadding.None" Fill="true">
                    <div id="personal" class="mt-panel">

                        <div class="mt-panel-head">
                            <p class="mt-panel-title">משימות אישיות</p>
                            <span class="mt-panel-count">· @_openPersonal.Count</span>
                            @if (Counts.PersonalTasksOverdue > 0)
                            {
                                <span class="mt-overdue">@Counts.PersonalTasksOverdue באיחור</span>
                            }
                            <button type="button" class="mt-add motiva-cta" @onclick="OpenNewTask">
                                <span class="mt-add-glyph" aria-hidden="true">+</span>
                                <span>משימה אישית</span>
                            </button>
                        </div>

                        <MScrollArea Tabbable="false">
                            @if (_visiblePersonal.Count == 0)
                            {
                                <MEmptyState Title="אין משימות אישיות כרגע."
                                             Description="תזכורות שתוסיף/י לעצמך יופיעו כאן."
                                             Live="true" />
                            }
                            else
                            {
                                @foreach (var t in _visiblePersonal)
                                {
                                    var id       = t.Id;
                                    var captured = t;
                                    <div class="mt-row @(t.IsDone ? "mt-row-done" : "")"
                                         role="button" tabindex="0"
                                         @onclick="@(() => OpenEditTask(captured))"
                                         aria-label="@($"עריכת \"{t.Title}\"")">

                                        <span class="mt-check @(t.IsDone ? "mt-check-on" : "")"
                                              role="checkbox" tabindex="0"
                                              aria-checked="@(t.IsDone ? "true" : "false")"
                                              aria-label="@($"סימון \"{t.Title}\" כהושלמה")"
                                              @onclick="@(() => ToggleTaskAsync(id))"
                                              @onclick:stopPropagation="true">
                                            @if (t.IsDone)
                                            {
                                                <span class="mt-check-mark" aria-hidden="true">✓</span>
                                            }
                                        </span>

                                        <span class="mt-row-title">@t.Title</span>

                                        @if (!string.IsNullOrWhiteSpace(PersonalTeamLabel(t)))
                                        {
                                            <span class="mt-row-meta">@PersonalTeamLabel(t)</span>
                                        }

                                        @if (MentorTime.DeadlineLabel(t.DueDate) is { Length: > 0 } due)
                                        {
                                            <span class="mt-row-due @(!t.IsDone && MentorTime.IsOverdue(t.DueDate) ? "mt-row-due-late" : "")">@due</span>
                                        }
                                    </div>
                                }
                            }

                            <button type="button" class="mt-addrow" @onclick="OpenNewTask">
                                <span class="mt-addrow-glyph" aria-hidden="true">+</span>
                                <span>הוספת משימה אישית</span>
                            </button>
                        </MScrollArea>

                        @if (_openPersonal.Count > PersonalCollapsedCount || _donePersonal.Count > 0)
                        {
                            <div class="mt-expand">
                                <button type="button" class="mt-expand-btn" @onclick="TogglePersonalExpanded">
                                    @(_personalExpanded ? "הצג פחות" : "הצג הכל")
                                </button>
                            </div>
                        }
                    </div>
                </MCard>
            </div>

        </div>
    }
</div>

@* ── Request details modal ── *@
<MentorRequestModal RequestId="@_openRequestId"
                    WaitingLabel="@OpenRequestWaitingLabel"
                    OnClose="@(() => _openRequestId = null)"
                    OnChanged="ReloadAsync" />

@* ── New / edit personal task ── *@
<MentorPersonalTaskModal IsOpen="@_taskModalOpen"
                         EditingTask="@_editingTask"
                         Projects="@_ws.Projects"
                         OnClose="CloseTaskModal"
                         OnSaved="OnTaskSaved"
                         OnDeleted="OnTaskDeleted" />

@code {
    private const int PersonalCollapsedCount = 6;

    // ── Data ────────────────────────────────────────────────────────────────
    private MentorWorkspace _ws = MentorWorkspace.Empty;
    private bool _loading = true;

    private IReadOnlyList<MentorAttentionItemDto> _reviews    = Array.Empty<MentorAttentionItemDto>();
    private IReadOnlyList<MentorAttentionItemDto> _awaitingMe = Array.Empty<MentorAttentionItemDto>();
    private List<PersonalTaskDto>            _openPersonal    = new();
    private List<PersonalTaskDto>            _donePersonal    = new();
    private List<PersonalTaskDto>            _visiblePersonal = new();

    private MentorAttentionCountsDto Counts => _ws.Attention.Counts;

    // ── Queue filter ────────────────────────────────────────────────────────
    /// <summary>"" = הכל | "reviews" = הגשות לבדיקה | "requests" = בקשות</summary>
    private string _queueTab = "";

    private int IncomingCount => _reviews.Count + _awaitingMe.Count;

    private IReadOnlyList<MentorAttentionItemDto> FilteredQueue =>
        _queueTab switch
        {
            "reviews"  => _reviews,
            "requests" => _awaitingMe,
            _          => (IReadOnlyList<MentorAttentionItemDto>)
                          _reviews.Concat(_awaitingMe).ToList(),
        };

    // ── Inline expansion (State 2) ──────────────────────────────────────────
    private int?                        _expandedItemId;
    private MentorAttentionItemDto?     _expandedItem;
    private bool                        _loadingExpansion;
    private MentorSubmissionContextDto? _expandedCtx;

    // ── Review modal (State 3) ──────────────────────────────────────────────
    private MentorSubmissionContextDto? _reviewModalCtx;
    private bool                        _reviewModalBusy;
    private string                      _reviewModalPendingAction = "";
    private string                      _reviewModalFeedback      = "";
    private bool                        _reviewModalError;
    private string                      _reviewModalFeedbackError = "";

    // ── Request modal ───────────────────────────────────────────────────────
    private int? _openRequestId;

    private string? OpenRequestWaitingLabel =>
        _openRequestId is int id
            ? _awaitingMe.FirstOrDefault(r => r.EntityId == id)?.WaitingLabel
            : null;

    // ── Personal tasks ──────────────────────────────────────────────────────
    private bool           _personalExpanded;
    private int?           _togglingId;
    private bool           _taskModalOpen;
    private PersonalTaskDto? _editingTask;

    // ── Lifecycle ───────────────────────────────────────────────────────────

    protected override async Task OnInitializedAsync()
    {
        Nav.LocationChanged += OnLocationChanged;
        ApplyFocusFromQuery();
        await ReloadAsync();
        OpenTaskFromQuery();
    }

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;

    /// <summary>בית deep-links here with ?focus= to pre-select a queue tab.
    /// Blazor reuses this component across navigations, so we re-read on
    /// LocationChanged as well as on init.</summary>
    private void OnLocationChanged(object? sender,
        Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        ApplyFocusFromQuery();
        InvokeAsync(StateHasChanged);
    }

    private string? QueryValue(string key)
    {
        var query = new Uri(Nav.Uri).Query.TrimStart('?');
        foreach (var pair in query.Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var eq = pair.IndexOf('=');
            if (eq <= 0) continue;
            if (!pair.AsSpan(0, eq).Equals(key, StringComparison.OrdinalIgnoreCase)) continue;
            return Uri.UnescapeDataString(pair[(eq + 1)..]);
        }
        return null;
    }

    private void ApplyFocusFromQuery() =>
        _queueTab = (QueryValue("focus") ?? "").ToLowerInvariant() switch
        {
            "reviews"  => "reviews",
            "requests" => "requests",
            _          => "",
        };

    /// <summary>Calendar links here with ?editTask={id}.</summary>
    private void OpenTaskFromQuery()
    {
        if (!int.TryParse(QueryValue("editTask"), out var wantedId)) return;
        var task = _openPersonal.Concat(_donePersonal).FirstOrDefault(t => t.Id == wantedId);
        if (task is null) return;
        OpenEditTask(task);
    }

    private async Task ReloadAsync()
    {
        _loading = true;
        _ws = await Workspace.LoadAsync();

        _reviews    = _ws.Reviews;
        _awaitingMe = _ws.AwaitingMe;

        SplitPersonal(_ws.PersonalTasks);
        _loading = false;
    }

    // ── Queue interaction ────────────────────────────────────────────────────

    /// <summary>
    /// Submission rows toggle inline expansion; request rows open the modal.
    /// </summary>
    private async Task ToggleQueueItem(MentorAttentionItemDto item)
    {
        if (item.Kind != MentorAttentionKind.Submission)
        {
            _openRequestId = item.EntityId;
            return;
        }

        // Collapse if already expanded.
        if (_expandedItemId == item.EntityId)
        {
            _expandedItemId = null;
            _expandedItem   = null;
            _expandedCtx    = null;
            return;
        }

        // Expand and lazily load submission context.
        _expandedItemId   = item.EntityId;
        _expandedItem     = item;
        _expandedCtx      = null;
        _loadingExpansion = true;
        StateHasChanged();

        _expandedCtx      = await MentorService.GetSubmissionContextAsync(item.EntityId);
        _loadingExpansion = false;
    }

    // ── Review modal ─────────────────────────────────────────────────────────

    private void OpenReviewModal()
    {
        if (_expandedCtx is null) return;
        _reviewModalCtx          = _expandedCtx;
        _reviewModalFeedback     = "";
        _reviewModalError        = false;
        _reviewModalFeedbackError = "";
        _reviewModalPendingAction = "";
    }

    private void CloseReviewModal()
    {
        _reviewModalCtx          = null;
        _reviewModalFeedback     = "";
        _reviewModalError        = false;
        _reviewModalFeedbackError = "";
        _reviewModalBusy         = false;
        _reviewModalPendingAction = "";
    }

    private async Task SubmitReviewAsync(string action)
    {
        if (_reviewModalCtx is null || _reviewModalBusy) return;

        if (action == "Returned" && string.IsNullOrWhiteSpace(_reviewModalFeedback))
        {
            _reviewModalFeedbackError = "יש להזין הערת מנחה לפני החזרת ההגשה לתיקון";
            return;
        }

        _reviewModalBusy         = true;
        _reviewModalPendingAction = action;
        _reviewModalError        = false;
        _reviewModalFeedbackError = "";
        StateHasChanged();

        var sid = _reviewModalCtx.SubmissionId;
        bool ok = await MentorService.ReviewSubmissionAsync(sid, action, _reviewModalFeedback);
        _reviewModalBusy = false;

        if (ok)
        {
            // Remove the reviewed item from the queue.
            _reviews = _reviews.Where(r => r.EntityId != sid).ToList();
            CloseReviewModal();
            _expandedItemId = null;
            _expandedItem   = null;
            _expandedCtx    = null;
        }
        else
        {
            _reviewModalError = true;
        }
    }

    // ── Personal tasks ────────────────────────────────────────────────────────

    private void SplitPersonal(IEnumerable<PersonalTaskDto> all)
    {
        _openPersonal = all.Where(t => !t.IsDone)
                           .OrderBy(t => t.DueDate ?? DateTime.MaxValue)
                           .ToList();
        _donePersonal = all.Where(t => t.IsDone)
                           .OrderByDescending(t => t.CreatedAt)
                           .ToList();
        RebuildVisiblePersonal();
    }

    private void TogglePersonalExpanded()
    {
        _personalExpanded = !_personalExpanded;
        RebuildVisiblePersonal();
    }

    private void RebuildVisiblePersonal() =>
        _visiblePersonal = _personalExpanded
            ? _openPersonal.Concat(_donePersonal).ToList()
            : _openPersonal.Take(PersonalCollapsedCount).ToList();

    private async Task ToggleTaskAsync(int id)
    {
        _togglingId = id;
        var ok = await PersonalTasks.ToggleAsync(id);
        _togglingId = null;

        if (!ok) return;

        var all = _openPersonal.Concat(_donePersonal).ToList();
        var hit = all.FirstOrDefault(t => t.Id == id);
        if (hit is not null) hit.IsDone = !hit.IsDone;
        SplitPersonal(all);
    }

    private void OpenNewTask()
    {
        _editingTask   = null;
        _taskModalOpen = true;
    }

    private void OpenEditTask(PersonalTaskDto task)
    {
        _editingTask   = task;
        _taskModalOpen = true;
    }

    private void CloseTaskModal()
    {
        _taskModalOpen = false;
        _editingTask   = null;
    }

    private void OnTaskSaved(PersonalTaskDto saved)
    {
        var all = _openPersonal.Concat(_donePersonal).ToList();
        if (!all.Any(t => t.Id == saved.Id)) all.Add(saved);
        SplitPersonal(all);
        _taskModalOpen = false;
        _editingTask   = null;
    }

    private void OnTaskDeleted(int deletedId)
    {
        SplitPersonal(_openPersonal.Concat(_donePersonal).Where(t => t.Id != deletedId));
        _taskModalOpen = false;
        _editingTask   = null;
    }

    // ── Row helpers ───────────────────────────────────────────────────────────

    private static string AgeClass(MentorAttentionItemDto i) =>
        i.Age == MentorAttentionAge.NeedsAttention
            ? "mt-status-open"
            : "mt-status-quiet";

    private static string TeamLabel(MentorAttentionItemDto i) =>
        !string.IsNullOrWhiteSpace(i.TeamName)      ? i.TeamName!
        : !string.IsNullOrWhiteSpace(i.ProjectTitle) ? i.ProjectTitle!
        : "";

    private static string PersonalTeamLabel(PersonalTaskDto t) =>
        !string.IsNullOrWhiteSpace(t.TeamName)      ? t.TeamName!
        : !string.IsNullOrWhiteSpace(t.ProjectTitle) ? t.ProjectTitle!
        : "";

    private static string StateLabel(MentorAttentionItemDto i) =>
        MentorAging.ShortLabel(i.WaitingDays);

    private static string RowAriaLabel(MentorAttentionItemDto i, string action)
    {
        var state = MentorAging.StateLabel(i.Age);
        return state is null ? action : $"{state} — {action}";
    }
}