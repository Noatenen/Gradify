@namespace AuthWithAdmin.Client.Pages.Mentor
@using AuthWithAdmin.Client.Components

@*
    MentorRequestModal — the modal presentation of a request, used by
    המשימות שלי where the design opens a request without leaving the queue.

    A shell and nothing else: every fact, the history and the recommendation
    form live in MentorRequestDetail, which בקשות renders inline instead. The
    two screens therefore cannot drift, and the product's only mentor write
    exists exactly once.
*@

<MModal IsOpen="@(RequestId is > 0)"
        Size="MModal.ModalSize.Medium"
        Title="בקשה"
        OnClose="OnClose"
        Class="mrqm">
    <ChildContent>
        @if (RequestId is > 0)
        {
            <MentorRequestDetail @ref="_detail"
                                 RequestId="@RequestId.Value"
                                 ShowActions="false"
                                 WaitingLabel="@WaitingLabel"
                                 OnChanged="HandleChangedAsync" />
        }
    </ChildContent>

    <FooterContent>
        <MButton Variant="MButton.ButtonVariant.Secondary" OnClick="OnClose">סגירה</MButton>
        @if (_detail?.CanSubmit == true || _detail?.IsSubmitting == true)
        {
            <MButton Variant="MButton.ButtonVariant.Primary"
                     OnClick="@(() => _detail!.SubmitRecommendationAsync())"
                     Loading="@_detail!.IsSubmitting"
                     LoadingText="שולחת…"
                     Disabled="@(!_detail.CanSubmit)">
                שליחת המלצה
            </MButton>
        }
    </FooterContent>
</MModal>

@code {
    /// <summary>The request to show. 0 or null closes the modal.</summary>
    [Parameter] public int? RequestId { get; set; }

    [Parameter] public EventCallback OnClose { get; set; }

    /// <summary>Waiting phrase from the shared attention model, forwarded to the
    /// detail so the modal and the row it opened from cannot word the same
    /// request differently.</summary>
    [Parameter] public string? WaitingLabel { get; set; }

    /// <summary>Raised after a recommendation is accepted, so the host page can
    /// reload its counts.</summary>
    [Parameter] public EventCallback OnChanged { get; set; }

    private MentorRequestDetail? _detail;

    private async Task HandleChangedAsync()
    {
        await OnChanged.InvokeAsync();
        await OnClose.InvokeAsync();
    }
}
