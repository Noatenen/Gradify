@page "/mentor/projects/{Id:int}"
@layout AppLayout
@attribute [Authorize(Roles = Roles.Mentor + "," + Roles.Admin + "," + Roles.Staff)]
@namespace AuthWithAdmin.Client.Pages.Mentor
@using Microsoft.AspNetCore.Authorization
@using AuthWithAdmin.Client.Components
@using AuthWithAdmin.Client.Services
@using AuthWithAdmin.Shared.AuthSharedModels
@inject IMentorProjectsService MentorService
@inject IRoadmapStagesService RoadmapService
@inject IMentorWorkspaceService Workspace
@inject NavigationManager Nav

@*
    ── מרחב הפרויקט ─────────────────────────────────────────────────────────
    VISUAL SOURCE OF TRUTH:  Motiva Mentor Project.dc.html (Claude Design).
                             Header, the four overview tiles, the stage strip,
                             the attention/work pair at 1 : 1.35, and the
                             meetings/activity pair are all that file's.
    ONE REAL PROJECT.        The reference ships five demo teams behind a
                             `?team=` prop. Not one of them is rendered here:
                             the route parameter names a real project and the
                             server refuses it unless this user is in
                             ProjectMentors for it (MentorController
                             GetProjectDetail → Forbid), which is why an
                             unauthorised id resolves to null and this page
                             says so instead of drawing anything.

    WHERE EVERY BLOCK'S DATA COMES FROM — all existing endpoints, no new ones:
      header / members / milestones / tasks / pending submissions
                        GET api/mentor/projects/{id}
      stage + % + next  GET api/roadmap-stages/projects/{id}/progress
                        (Overdue ?? Upcoming — the same precedence ציר
                        התקדמות uses), falling back to the project's own
                        milestone list when a cycle has no stages configured
      attention         the shared mentor snapshot, filtered to this project
      requests          the same snapshot's request list, filtered likewise
      dates + meetings  MentorWorkspaceService.BuildCalendarAsync over a
                        snapshot narrowed to this project — the mentor
                        calendar's own composer, not a second copy of it

    THE ACTIVITY CARD IS DELIBERATELY NARROW. The reference draws five kinds of
    activity line including "אבן דרך הושלמה" and "משימת צוות חדשה נוספה". This
    product has no activity log and no project-scoped feed: Notifications carry
    no ProjectId, milestones store no completion timestamp and a task stores no
    created-at. So the card states only what a real column can date — a request
    opened or last updated, a submission received, a guidance meeting held —
    and says plainly when there is nothing rather than inventing a history.

    THE VERSION COLUMN IS NOT DRAWN, for the same reason: MentorTaskDto carries
    the latest submission's STATUS but no round number, and the round count
    lives one call deeper, inside the review drawer that already shows it.

    THE REVIEW DRAWER BELOW IS UNCHANGED. It is the real review flow —
    GET api/mentor/submissions/{id}/context and
    PATCH api/task-submissions/{id}/mentor-review — including its round
    history, its files and its return-requires-a-note rule. Nothing about it
    was restyled or re-implemented for this pass; the workspace simply opens
    it, and so does the ?submissionId= deep link the calendar sends.
*@

<!-- ══ Review drawer backdrop ════════════════════════════════════════════════ -->
@if (_reviewCtx is not null)
{
    <div class="mpd-backdrop" @onclick="CloseDrawer"></div>
    <div class="mpd-drawer">

        <!-- Drawer header -->
        <div class="mpd-drawer-header">
            <div class="mpd-drawer-header-row">
                <div>
                    <div class="mpd-drawer-milestone">@_reviewCtx.MilestoneTitle</div>
                    <div class="mpd-drawer-title">@_reviewCtx.TaskTitle</div>
                </div>
                <button class="mpd-drawer-close" @onclick="CloseDrawer" title="סגירה">
                    <span class="oi oi-x" aria-hidden="true"></span>
                </button>
            </div>
            <div class="mpd-drawer-meta">
                <div class="mpd-drawer-meta-item">
                    <span class="oi oi-person" aria-hidden="true"></span>
                    @_reviewCtx.SubmittedBy
                </div>
                <div class="mpd-drawer-meta-item">
                    <span class="oi oi-clock" aria-hidden="true"></span>
                    @_reviewCtx.SubmittedAt.IsraelFormat()
                </div>
            </div>
            <!-- Current mentor status badge -->
            <div class="mpd-drawer-status-row">
                <span class="mpd-drawer-status-badge @DrawerMentorStatusClass(_reviewCtx.MentorStatus)">
                    @DrawerMentorStatusLabel(_reviewCtx.MentorStatus)
                </span>
            </div>
        </div>

        <!-- Drawer body -->
        <div class="mpd-drawer-body">

            @if (_reviewLoading)
            {
                <div class="mpd-drawer-loading">
                    <div class="mpd-drawer-spinner"></div>
                    <span>טוען פרטי הגשה…</span>
                </div>
            }
            else
            {
                <!-- Task description -->
                @if (!string.IsNullOrWhiteSpace(_reviewCtx.TaskDescription))
                {
                    <div class="mpd-drawer-section">
                        <div class="mpd-drawer-section-title">תיאור המשימה</div>
                        <div class="mpd-drawer-text">@_reviewCtx.TaskDescription</div>
                    </div>
                }

                <!-- Student notes -->
                @if (!string.IsNullOrWhiteSpace(_reviewCtx.Notes))
                {
                    <div class="mpd-drawer-section">
                        <div class="mpd-drawer-section-title">הערות הסטודנט</div>
                        <div class="mpd-drawer-text mpd-drawer-notes">@_reviewCtx.Notes</div>
                    </div>
                }

                <!-- Files -->
                <div class="mpd-drawer-section">
                    <div class="mpd-drawer-section-title">
                        קבצים מצורפים
                        <span class="mpd-drawer-file-count">@_reviewCtx.Files.Count</span>
                    </div>
                    @if (_reviewCtx.Files.Count == 0)
                    {
                        <div class="mpd-drawer-empty">לא צורפו קבצים להגשה זו</div>
                    }
                    else
                    {
                        <div class="mpd-drawer-file-list">
                            @foreach (var f in _reviewCtx.Files)
                            {
                                <div class="mpd-drawer-file-item">
                                    <span class="oi @FileIcon(f.ContentType) mpd-drawer-file-icon" aria-hidden="true"></span>
                                    <div class="mpd-drawer-file-info">
                                        <span class="mpd-drawer-file-name">@f.OriginalFileName</span>
                                        <span class="mpd-drawer-file-size">@FormatSize(f.SizeBytes)</span>
                                    </div>
                                    <a class="mpd-drawer-file-dl"
                                       href="/submissions/@f.StoredFileName"
                                       download="@f.OriginalFileName"
                                       title="הורדה">
                                        <span class="oi oi-cloud-download" aria-hidden="true"></span>
                                    </a>
                                </div>
                            }
                        </div>
                    }
                </div>

                <!-- Submission history — accordion per round, oldest first -->
                @if (_reviewCtx.History.Count > 0)
                {
                    <div class="mpd-drawer-section">
                        <div class="mpd-drawer-section-title">
                            היסטוריית הגשות
                            <span class="mpd-drawer-file-count">@_reviewCtx.History.Count סבבים</span>
                        </div>
                        <div class="mpd-drawer-history">
                            @foreach (var round in _reviewCtx.History)
                            {
                                bool isCurrent  = round.SubmissionId == _reviewCtx.SubmissionId;
                                bool isExpanded = _expandedRounds.Contains(round.SubmissionId);

                                <div class="mpd-history-round @(isCurrent ? "mpd-history-current" : "")">

                                    <!-- Round accordion header -->
                                    <button class="mpd-history-round-btn"
                                            @onclick="() => ToggleRound(round.SubmissionId)">
                                        <div class="mpd-history-round-start">
                                            <span class="mpd-history-round-num">סבב @round.RoundNumber</span>
                                            @if (isCurrent)
                                            {
                                                <span class="mpd-history-current-tag">נוכחי</span>
                                            }
                                            <span class="mpd-history-date">@round.SubmittedAt.IsraelFormat("dd/MM/yy HH:mm")</span>
                                        </div>
                                        <div class="mpd-history-round-end">
                                            <span class="mpd-history-mentor-badge mpd-hbadge-@round.MentorStatus.ToLower()">
                                                @DrawerMentorStatusLabel(round.MentorStatus)
                                            </span>
                                            <span class="oi @(isExpanded ? "oi-chevron-top" : "oi-chevron-bottom") mpd-history-chevron"
                                                  aria-hidden="true"></span>
                                        </div>
                                    </button>

                                    <!-- Round detail (expanded) -->
                                    @if (isExpanded)
                                    {
                                        <div class="mpd-history-round-body">

                                            @if (!string.IsNullOrWhiteSpace(round.Notes))
                                            {
                                                <div class="mpd-history-block">
                                                    <span class="mpd-history-block-label">הערות סטודנט</span>
                                                    <div class="mpd-history-note-text">@round.Notes</div>
                                                </div>
                                            }

                                            @if (round.Files.Count > 0)
                                            {
                                                <div class="mpd-history-block">
                                                    <span class="mpd-history-block-label">קבצים (@round.Files.Count)</span>
                                                    <div class="mpd-drawer-file-list">
                                                        @foreach (var f in round.Files)
                                                        {
                                                            <div class="mpd-drawer-file-item">
                                                                <span class="oi @FileIcon(f.ContentType) mpd-drawer-file-icon" aria-hidden="true"></span>
                                                                <div class="mpd-drawer-file-info">
                                                                    <span class="mpd-drawer-file-name">@f.OriginalFileName</span>
                                                                    <span class="mpd-drawer-file-size">@FormatSize(f.SizeBytes)</span>
                                                                </div>
                                                                <a class="mpd-drawer-file-dl"
                                                                   href="/submissions/@f.StoredFileName"
                                                                   download="@f.OriginalFileName"
                                                                   title="הורדה">
                                                                    <span class="oi oi-cloud-download" aria-hidden="true"></span>
                                                                </a>
                                                            </div>
                                                        }
                                                    </div>
                                                </div>
                                            }

                                            @if (!string.IsNullOrWhiteSpace(round.MentorFeedback))
                                            {
                                                <div class="mpd-history-feedback mpd-feedback-mentor">
                                                    <div class="mpd-history-feedback-header">
                                                        <span class="oi oi-person" aria-hidden="true"></span>
                                                        <strong>פידבק מנחה</strong>
                                                        @if (round.MentorReviewedAt.HasValue)
                                                        {
                                                            <span class="mpd-history-review-date">
                                                                @round.MentorReviewedAt.IsraelFormat("dd/MM/yy HH:mm")
                                                            </span>
                                                        }
                                                    </div>
                                                    <p class="mpd-history-feedback-text">@round.MentorFeedback</p>
                                                </div>
                                            }

                                            @if (!string.IsNullOrWhiteSpace(round.ReviewerFeedback))
                                            {
                                                <div class="mpd-history-feedback mpd-feedback-reviewer">
                                                    <div class="mpd-history-feedback-header">
                                                        <span class="oi oi-comment-square" aria-hidden="true"></span>
                                                        <strong>פידבק מרצה</strong>
                                                    </div>
                                                    <p class="mpd-history-feedback-text">@round.ReviewerFeedback</p>
                                                </div>
                                            }

                                        </div>
                                    }

                                </div>
                            }
                        </div>
                    </div>
                }

                <!-- Review actions (only when status is still Pending) -->
                @if (_reviewCtx.MentorStatus == "Pending")
                {
                    <div class="mpd-drawer-section mpd-drawer-review-section">
                        <div class="mpd-drawer-section-title">סקירת מנחה</div>

                        <div class="mpd-review-feedback-wrap">
                            <label class="mpd-review-feedback-label">פידבק (נדרש בעת החזרה לתיקון)</label>
                            <textarea class="mpd-review-feedback"
                                      rows="3"
                                      placeholder="הוסף הערות או הסברים לסטודנט…"
                                      value="@_reviewFeedback"
                                      @oninput="@((ChangeEventArgs e) => { _reviewFeedback = e.Value?.ToString() ?? string.Empty; if (_feedbackError.Length > 0) _feedbackError = string.Empty; })"
                                      disabled="@_reviewing">
                            </textarea>
                        </div>

                        @if (!string.IsNullOrEmpty(_feedbackError))
                        {
                            <div class="mpd-review-error">
                                <span class="oi oi-warning" aria-hidden="true"></span>
                                @_feedbackError
                            </div>
                        }
                        @if (_reviewError)
                        {
                            <div class="mpd-review-error">
                                <span class="oi oi-warning" aria-hidden="true"></span>
                                שגיאה בשמירה. נסה שנית.
                            </div>
                        }

                        <div class="mpd-review-actions">
                            <button class="mpd-btn-approve"
                                    @onclick='() => SubmitReviewAsync("Approved")'
                                    disabled="@_reviewing">
                                @if (_reviewing && _pendingAction == "Approved")
                                {
                                    <span class="mpd-btn-spinner"></span>
                                }
                                else
                                {
                                    <span class="oi oi-circle-check" aria-hidden="true"></span>
                                }
                                <span>אשר הגשה</span>
                            </button>
                            <button class="mpd-btn-return"
                                    @onclick='() => SubmitReviewAsync("Returned")'
                                    disabled="@_reviewing">
                                @if (_reviewing && _pendingAction == "Returned")
                                {
                                    <span class="mpd-btn-spinner"></span>
                                }
                                else
                                {
                                    <span class="oi oi-loop-circular" aria-hidden="true"></span>
                                }
                                <span>החזר לתיקון</span>
                            </button>
                        </div>
                    </div>
                }
                else
                {
                    <!-- Already reviewed — show what was decided -->
                    <div class="mpd-drawer-section">
                        <div class="mpd-drawer-section-title">החלטת המנחה</div>
                        <div class="mpd-review-done-banner mpd-review-done-@(_reviewCtx.MentorStatus.ToLower())">
                            <span class="oi @(_reviewCtx.MentorStatus == "Approved" ? "oi-circle-check" : "oi-loop-circular")" aria-hidden="true"></span>
                            @DrawerMentorStatusLabel(_reviewCtx.MentorStatus)
                            @if (!string.IsNullOrWhiteSpace(_reviewCtx.MentorFeedback))
                            {
                                <span class="mpd-review-done-feedback">— @_reviewCtx.MentorFeedback</span>
                            }
                        </div>
                    </div>
                }
            }
        </div>
    </div>
}


<div class="mpw-page">

    @* ── Back to פרויקטים בהנחייתי ─────────────────────────────────────── *@
    <a class="mpw-back" href="/mentor/projects">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor"
             stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M9 6l6 6-6 6"></path>
        </svg>
        פרויקטים בהנחייתי
    </a>

    @if (_isLoading)
    {
        <MLoadingState Label="טוענת את מרחב הפרויקט…" />
    }
    else if (_detail is null)
    {
        <MEmptyState Live="true"
                     Title="הפרויקט לא נמצא או שאינך מנחה שלו"
                     Description="מרחב הפרויקט נפתח רק למנחה שמשויך אליו בפועל.">
            <Action>
                <MButton Variant="MButton.ButtonVariant.Secondary"
                         OnClick="@(() => Nav.NavigateTo("/mentor/projects"))">
                    חזרה לפרויקטים בהנחייתי
                </MButton>
            </Action>
        </MEmptyState>
    }
    else
    {
        @* ── Header ─────────────────────────────────────────────────────── *@
        <header class="mpw-head">
            <div class="mpw-id">
                <div class="mpw-title-row">
                    <h1 class="mpw-title">@_detail.Title</h1>
                    <MStatusBadge Variant="@MentorProjectSignals.HealthVariant(Signal)"
                                  Text="@MentorProjectSignals.HealthLabel(Signal)" />
                </div>
                <p class="mpw-sub">@_detail.TeamName · שלב נוכחי: @StageName</p>
            </div>

            <div class="mpw-head-end">
                <div class="mpw-progress">
                    <div class="mpw-progress-top">
                        <span class="mpw-progress-pct">@_detail.MilestoneProgressPct%</span>
                        <span class="mpw-progress-label">התקדמות כוללת</span>
                    </div>
                    <MProgressBar Value="@_detail.MilestoneProgressPct"
                                  Size="MProgressBar.ProgressSize.Small"
                                  AccessibleLabel="@($"התקדמות אבני הדרך: {_detail.MilestoneProgressPct}%")" />
                </div>

                @if (_detail.TeamMembers.Count > 0)
                {
                    <div class="mpw-members">
                        @foreach (var m in _detail.TeamMembers)
                        {
                            <span class="mpw-member" title="@($"{m.FullName} · {m.Email}")">
                                <span class="mpw-member-initials" aria-hidden="true">@Initials(m.FullName)</span>
                                @m.FullName
                            </span>
                        }
                    </div>
                }
            </div>
        </header>

        @* ── Four overview tiles ────────────────────────────────────────── *@
        <div class="mpw-tiles">
            @foreach (var tile in Tiles)
            {
                var t = tile;
                if (t.Href is { Length: > 0 })
                {
                    <a class="mpw-tile" href="@t.Href">
                        <span class="mpw-tile-label">@t.Label</span>
                        <span class="mpw-tile-value">@t.Value</span>
                        <span class="mpw-tile-meta @t.MetaClass">@t.Meta</span>
                    </a>
                }
                else
                {
                    <div class="mpw-tile mpw-tile-static">
                        <span class="mpw-tile-label">@t.Label</span>
                        <span class="mpw-tile-value">@t.Value</span>
                        <span class="mpw-tile-meta @t.MetaClass">@t.Meta</span>
                    </div>
                }
            }
        </div>

        @* ── Milestone roadmap ──────────────────────────────────────────── *@
        <section class="mpw-card mpw-roadmap" aria-labelledby="mpw-roadmap-h">
            <div class="mpw-card-head">
                <h2 class="mpw-card-title" id="mpw-roadmap-h">מסלול אבני הדרך</h2>
                <span class="mpw-card-note">@RoadmapSummary</span>
            </div>

            @if (StageCells.Count == 0)
            {
                <p class="mpw-empty">לא הוגדרו אבני דרך לפרויקט זה.</p>
            }
            else
            {
                <ol class="mpw-stages" style="--mpw-stage-count:@StageCells.Count">
                    @foreach (var cell in StageCells)
                    {
                        var c = cell;
                        <li class="mpw-stage @StageClass(c)">
                            <span class="mpw-stage-track" aria-hidden="true"></span>
                            <span class="mpw-stage-name">
                                <span class="mpw-stage-dot" aria-hidden="true"></span>
                                <span class="mpw-stage-text" title="@c.Name">@c.Name</span>
                            </span>
                            <span class="mpw-stage-date">@c.Date</span>
                        </li>
                    }
                </ol>
            }
        </section>

        <div class="mpw-split mpw-split-work">

            @* ── דורש את תשומת לבך ──────────────────────────────────────── *@
            <section class="mpw-card mpw-attn" aria-labelledby="mpw-attn-h">
                <div class="mpw-card-head">
                    <h2 class="mpw-card-title" id="mpw-attn-h">דורש את תשומת לבך</h2>
                    <span class="mpw-count @(_attention.Count > 0 ? "mpw-count-live" : "")">@_attention.Count</span>
                </div>

                @if (_attention.Count == 0)
                {
                    <p class="mpw-empty">אין פריטים שממתינים לך בפרויקט זה</p>
                }
                else
                {
                    <div class="mpw-rows">
                        @* Each row opens IN PLACE — a submission in this page's own
                           review drawer, a request in the בקשות tab below, a personal
                           task in the shared editor. They used to be links to
                           item.Href, which for a request left the workspace entirely
                           and for a submission re-navigated this same route with
                           ?submissionId= on it just to open a drawer already mounted
                           here. See OpenAttentionItem. *@
                        @foreach (var item in _attention)
                        {
                            var a = item;
                            <button type="button" class="mpw-attn-row"
                                    @onclick="@(() => OpenAttentionItemAsync(a))"
                                    aria-label="@($"פתיחת {a.Title}")">
                                <MStatusBadge Variant="@MentorAttentionRows.TypeVariant(a)"
                                              Text="@MentorAttentionRows.TypeLabel(a)" />
                                <span class="mpw-attn-main">
                                    <span class="mpw-attn-title" title="@a.Title">@a.Title</span>
                                    <span class="mpw-attn-sub">@AttentionSub(a)</span>
                                </span>
                                <span class="mpw-attn-time @(MentorAttentionRows.IsEscalated(a) ? "mpw-late" : "")">
                                    @MentorAttentionRows.TimeLabel(a)
                                </span>
                            </button>
                        }
                    </div>
                }
            </section>

            @* ── הגשות / בקשות / משימות ─────────────────────────────────── *@
            <section class="mpw-card mpw-work" aria-labelledby="mpw-work-h">
                <h2 class="mpw-sr-only" id="mpw-work-h">הגשות, בקשות ומשימות</h2>

                <div class="mpw-card-head mpw-work-head">
                    <MFilterTabs Tabs="@WorkTabs"
                                 ActiveKey="@_tab"
                                 OnSelect="SelectTab"
                                 AriaLabel="מעבר בין הגשות, בקשות ומשימות" />
                    <a class="mpw-all-link" href="@TabAllHref">@TabAllLabel</a>
                </div>

                @if (_tab == TabSubs)
                {
                    @if (Submissions.Count == 0)
                    {
                        <p class="mpw-empty">אין משימות הגשה בפרויקט זה</p>
                    }
                    else
                    {
                        <div class="mpw-rows">
                            @foreach (var row in Submissions)
                            {
                                var s = row;
                                <div class="mpw-sub-row">
                                    <span class="mpw-row-title" title="@s.Title">@s.Title</span>
                                    <span class="mpw-row-meta" title="@s.Milestone">@s.Milestone</span>
                                    <span class="mpw-row-state @s.StateClass" title="@s.State">@s.State</span>
                                    @if (s.SubmissionId is int subId)
                                    {
                                        <button type="button" class="mpw-cta motiva-cta"
                                                @onclick="@(() => OpenReviewDrawer(subId))">
                                            לבדיקה
                                        </button>
                                    }
                                    else
                                    {
                                        <span class="mpw-cta-quiet">@s.Trailing</span>
                                    }
                                </div>
                            }
                        </div>
                    }
                }
                else if (_tab == TabReqs)
                {
                    @if (_requests.Count == 0)
                    {
                        <p class="mpw-empty">אין בקשות בפרויקט זה</p>
                    }
                    else
                    {
                        <div class="mpw-rows">
                            @foreach (var request in _requests)
                            {
                                var r = request;
                                var bucket = MentorRequestBuckets.Of(r.Status);
                                var open = _expandedRequestId == r.Id;

                                <div class="mpw-req @(open ? "mpw-req-open" : "")">
                                    <button type="button" class="mpw-req-row"
                                            aria-expanded="@(open ? "true" : "false")"
                                            @onclick="@(() => ToggleRequest(r.Id))">
                                        <span class="mpw-row-title" title="@r.Title">@r.Title</span>
                                        <span class="mpw-row-meta">@r.CreatedAt.ToLocalTime().ToString("dd.MM")</span>
                                        <span class="mpw-row-state @RequestStateClass(bucket)">
                                            @MentorRequestBuckets.RowLabel(bucket)
                                        </span>
                                        <span class="@(MentorRequestBuckets.IsActionable(r.Status) ? "mpw-cta motiva-cta" : "mpw-cta-quiet")">
                                            @(MentorRequestBuckets.IsActionable(r.Status) ? "להמלצה" : open ? "סגירה" : "לבקשה")
                                        </span>
                                    </button>

                                    @if (open)
                                    {
                                        @* The real request flow, embedded — the same component
                                           the בקשות inbox expands, with the same MarkRead and
                                           the same one recommendation POST. *@
                                        <div class="mpw-req-detail">
                                            <MentorRequestDetail RequestId="@r.Id"
                                                                 Layout="MentorRequestDetail.DetailLayout.Inline"
                                                                 ShowHeader="false"
                                                                 WaitingLabel="@WaitingLabelFor(r.Id)"
                                                                 OnChanged="ReloadAsync" />
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }
                }
                else
                {
                    @if (WorkTasks.Count == 0)
                    {
                        <p class="mpw-empty">אין משימות פתוחות בפרויקט זה</p>
                    }
                    else
                    {
                        <div class="mpw-rows">
                            @foreach (var task in WorkTasks)
                            {
                                var k = task;
                                if (k.Task is PersonalTaskDto own)
                                {
                                    <button type="button" class="mpw-task-row"
                                            @onclick="@(() => OpenTask(own))"
                                            aria-label="@($"עריכת {k.Title}")">
                                        <span class="mpw-owner @(k.IsMine ? "mpw-owner-mine" : "")">@(k.IsMine ? "שלי" : "צוות")</span>
                                        <span class="mpw-row-title" title="@k.Title">@k.Title</span>
                                        <span class="mpw-row-meta" title="@k.Assignee">@k.Assignee</span>
                                        <span class="mpw-row-due @(k.Overdue ? "mpw-late" : "")">@k.Due</span>
                                        <span class="mpw-row-state @k.StateClass">@k.State</span>
                                    </button>
                                }
                                else
                                {
                                    <div class="mpw-task-row">
                                        <span class="mpw-owner @(k.IsMine ? "mpw-owner-mine" : "")">@(k.IsMine ? "שלי" : "צוות")</span>
                                        <span class="mpw-row-title" title="@k.Title">@k.Title</span>
                                        <span class="mpw-row-meta" title="@k.Assignee">@k.Assignee</span>
                                        <span class="mpw-row-due @(k.Overdue ? "mpw-late" : "")">@k.Due</span>
                                        <span class="mpw-row-state @k.StateClass">@k.State</span>
                                    </div>
                                }
                            }
                        </div>
                    }
                }
            </section>
        </div>

        <div class="mpw-split mpw-split-bottom">

            @* ── פגישות ומועדים ─────────────────────────────────────────── *@
            <section class="mpw-card mpw-dates" aria-labelledby="mpw-dates-h">
                <div class="mpw-card-head">
                    <h2 class="mpw-card-title" id="mpw-dates-h">פגישות ומועדים</h2>
                    @* The mentor calendar is cross-project by design — it carries
                       no project filter to deep-link into — so this is the plain
                       route rather than a parameter the page would ignore. *@
                    <a class="mpw-all-link" href="@MentorLinks.Calendar">ליומן ותכנון</a>
                </div>

                @if (UpcomingDates.Count == 0)
                {
                    <p class="mpw-empty">אין מועדים קרובים בפרויקט זה</p>
                }
                else
                {
                    <div class="mpw-rows">
                        @foreach (var ev in UpcomingDates)
                        {
                            var e = ev;
                            <button type="button" class="mpw-date-row"
                                    @onclick="@(() => OpenEventAsync(e))"
                                    aria-label="@($"פתיחת {e.Title}")">
                                <span class="mpw-date-box @(e.Date.Date == DateTime.Today ? "mpw-date-today" : "")">
                                    <span class="mpw-date-day">@e.Date.ToString("dd")</span>
                                    <span class="mpw-date-month">@MotivaDates.ShortMonth(e.Date)</span>
                                </span>
                                <span class="mpw-date-main">
                                    <span class="mpw-row-title" title="@e.Title">@e.Title</span>
                                    <span class="mpw-attn-sub">@MentorEventTypes.Label(e.Type)</span>
                                </span>
                                <span class="mpw-date-time">@(e.TimeRange ?? "")</span>
                            </button>
                        }
                    </div>
                }

                <div class="mpw-dates-foot">
                    <button type="button" class="mpw-schedule motiva-cta" @onclick="OpenScheduler">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                             stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M12 5v14M5 12h14"></path>
                        </svg>
                        קביעת פגישת הנחיה
                    </button>
                    <span class="mpw-card-note">@LastMeetingLabel</span>
                </div>
            </section>

            @* ── פעילות אחרונה ──────────────────────────────────────────── *@
            <section class="mpw-card mpw-activity" aria-labelledby="mpw-activity-h">
                <div class="mpw-card-head">
                    <h2 class="mpw-card-title" id="mpw-activity-h">פעילות אחרונה</h2>
                </div>

                @if (Activity.Count == 0)
                {
                    <p class="mpw-empty">
                        אין פעילות מתועדת בפרויקט זה.
                        <span class="mpw-empty-note">
                            המערכת מתעדת מועדים של בקשות, הגשות ופגישות הנחיה בלבד.
                        </span>
                    </p>
                }
                else
                {
                    <div class="mpw-rows">
                        @foreach (var entry in Activity)
                        {
                            var v = entry;
                            <button type="button" class="mpw-act-row"
                                    @onclick="@(() => OpenActivityAsync(v))"
                                    aria-label="@($"פתיחת {v.Text}")">
                                <span class="mpw-act-dot @v.ToneClass" aria-hidden="true"></span>
                                <span class="mpw-act-main">
                                    <span class="mpw-act-text" title="@v.Text">@v.Text</span>
                                    <span class="mpw-attn-sub">@v.Meta</span>
                                </span>
                            </button>
                        }
                    </div>
                }
            </section>
        </div>
    }
</div>

@* ── קביעת פגישת הנחיה / עריכת משימה אישית ────────────────────────────────
    The mentor calendar's own editor, opened here with this project already
    chosen. Not a second create flow: same component, same POST, same Google
    sync — the only thing this page supplies is the project the mentor is
    already looking at, and the select stays editable.

    It EDITS as well as creates now, so a personal task on this page — in
    דורש את תשומת לבך, in the משימות tab, in the activity list — opens its
    editor here instead of sending the mentor to /mentor/tasks?editTask= to
    meet the very same modal on another screen. *@
@if (_summary is not null)
{
    <MentorPersonalTaskModal IsOpen="@(_scheduleOpen || _editingTask is not null)"
                             EditingTask="@_editingTask"
                             Projects="@(new[] { _summary })"
                             InitialProjectId="@Id"
                             OnClose="CloseTaskModal"
                             OnSaved="OnMeetingSavedAsync"
                             OnDeleted="@(_ => OnTaskRemovedAsync())" />
}

@code {
    [Parameter] public int Id { get; set; }

    // ── Loaded payloads ─────────────────────────────────────────────────────
    private MentorProjectDetailDto?    _detail;
    private ProjectRoadmapProgressDto? _roadmap;
    private MentorWorkspace            _ws = MentorWorkspace.Empty;
    private IReadOnlyList<MentorCalendarEvent> _events = Array.Empty<MentorCalendarEvent>();
    private bool _isLoading = true;

    // ── Projections onto THIS project ───────────────────────────────────────
    // Every one of these is a filter over a snapshot the whole mentor
    // experience already shares. Nothing is re-fetched per section and nothing
    // is recomputed — an item waiting here is the same row, with the same
    // wording and the same age, that בית and המשימות שלי draw.
    private MentorProjectSummaryDto?         _summary;
    private List<MentorAttentionItemDto>     _attention = new();
    private List<ProjectRequestRowDto>       _requests  = new();
    private List<PersonalTaskDto>            _personal  = new();

    // ── Local UI state ──────────────────────────────────────────────────────
    private const string TabSubs  = "subs";
    private const string TabReqs  = "reqs";
    private const string TabTasks = "tasks";

    private string _tab = TabSubs;
    private int?   _expandedRequestId;
    private bool   _scheduleOpen;

    /// <summary>The personal task being edited in the shared modal, or null.
    /// Separate from <see cref="_scheduleOpen"/> because that one CREATES a
    /// meeting on this project and this one opens an existing row.</summary>
    private PersonalTaskDto? _editingTask;

    // ── Review drawer state (unchanged) ─────────────────────────────────────
    private MentorSubmissionContextDto? _reviewCtx;
    private bool                        _reviewLoading;
    private bool                        _reviewing;
    private bool                        _reviewError;
    /// <summary>Validation-specific error shown when "Return" is clicked
    /// without a non-empty feedback note. Cleared on any feedback edit.</summary>
    private string                      _feedbackError  = "";
    private string                      _reviewFeedback = "";
    private string                      _pendingAction  = "";
    private readonly HashSet<int>       _expandedRounds = new();

    private void ToggleRound(int submissionId)
    {
        if (!_expandedRounds.Remove(submissionId))
            _expandedRounds.Add(submissionId);
    }

    // ── Load ────────────────────────────────────────────────────────────────

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();

        // ?tab= — the reference's own deep link, so a link can land on בקשות.
        var tab = QueryValue("tab");
        if (tab is TabSubs or TabReqs or TabTasks) _tab = tab;

        // ?submissionId= — the calendar's Review deep link.
        //
        // Opened only AFTER the project detail resolved, because a null _detail
        // means this mentor is not authorized for this project and nothing here
        // should open. GetSubmissionContextAsync is itself mentor-scoped
        // server-side, so a crafted submission id from another project answers
        // null and the drawer simply does not appear — this parameter grants no
        // access of its own, it only saves a click on a page already allowed.
        if (_detail is not null && int.TryParse(QueryValue("submissionId"), out var deepLinkSubmissionId))
            await OpenReviewDrawer(deepLinkSubmissionId);

        // ?requestId= — the same courtesy for a request notification.
        if (_detail is not null && int.TryParse(QueryValue("requestId"), out var deepLinkRequestId)
            && _requests.Any(r => r.Id == deepLinkRequestId))
        {
            _tab = TabReqs;
            _expandedRequestId = deepLinkRequestId;
        }
    }

    private async Task LoadAsync()
    {
        _isLoading = true;

        // Three independent round-trips, concurrently. The snapshot is the one
        // every mentor screen shares; the other two are this project's own.
        var detailTask  = MentorService.GetProjectDetailAsync(Id);
        var roadmapTask = RoadmapService.GetProjectProgressAsync(Id);
        var wsTask      = Workspace.LoadAsync();
        await Task.WhenAll(detailTask, roadmapTask, wsTask);

        _detail  = await detailTask;
        _roadmap = await roadmapTask;
        _ws      = await wsTask;

        _summary   = _ws.Projects.FirstOrDefault(p => p.Id == Id);
        _attention = _ws.Attention.Items.Where(i => i.ProjectId == Id).ToList();
        _requests  = _ws.Requests.Where(r => r.ProjectId == Id)
                                 .OrderByDescending(r => r.UpdatedAt)
                                 .ToList();
        _personal  = _ws.PersonalTasks.Where(t => t.ProjectId == Id).ToList();

        _isLoading = false;

        if (_detail is not null) await BuildDatesAsync();
    }

    /// <summary>
    /// The dated view of this project — meetings, milestones, deliverables and
    /// arrived reviews.
    ///
    /// <para>Built by the MENTOR CALENDAR'S OWN composer over a snapshot
    /// narrowed to this project, rather than by a per-section rule here. That is
    /// what makes "פגישה" mean the same thing on both screens: a mentor entry
    /// that has both a team and an hour, and nothing else. The detail payload is
    /// handed over so the composer does not fetch it a second time.</para>
    /// </summary>
    private async Task BuildDatesAsync()
    {
        var scoped = new MentorWorkspace(
            new MentorAttentionDto
            {
                Counts        = _ws.Attention.Counts,
                Items         = _attention,
                AsOfLocalDate = _ws.Attention.AsOfLocalDate,
            },
            _summary is null ? Array.Empty<MentorProjectSummaryDto>() : new[] { _summary },
            _requests,
            _personal);

        _events = await Workspace.BuildCalendarAsync(scoped, new[] { _detail! });
    }

    /// <summary>A recommendation was accepted or a meeting was saved, so counts
    /// and dates have moved — reload rather than patching rows by hand.</summary>
    private async Task ReloadAsync()
    {
        _expandedRequestId = null;
        await LoadAsync();
        StateHasChanged();
    }

    // ── Header, tiles and stage ─────────────────────────────────────────────

    /// <summary>The project's single attention signal — the SAME vocabulary
    /// פרויקטים בהנחייתי sorts and colours its list by, read off the same three
    /// facts, so the row there and the chip here can never disagree.</summary>
    private MentorProjectSignal Signal => MentorProjectSignals.Of(
        milestoneOverdue: MentorTime.IsOverdue(NextDue),
        pendingReviews:   _attention.Count(i => i.Kind == MentorAttentionKind.Submission),
        openRequests:     _ws.OpenRequestsFor(Id));

    private StageProgressDto? CurrentStage =>
        _roadmap?.Stages.FirstOrDefault(s => s.Status == RoadmapStageStatuses.Current);

    /// <summary>The first milestone the team has not finished — the fallback for
    /// every "current / next" question when a cycle has no roadmap stages
    /// configured, and the same row the projects list falls back to.</summary>
    private MentorMilestoneDto? FirstOpenMilestone =>
        _detail?.Milestones.FirstOrDefault(m => m.Status is not ("Completed" or "Done"));

    private string StageName =>
        CurrentStage?.Name
        ?? FirstOpenMilestone?.Title
        ?? "טרם החל";

    /// <summary>Overdue outranks upcoming — the same precedence ציר התקדמות
    /// renders, so the two screens name the same milestone as "the next one".</summary>
    private UpcomingMilestoneDto? NextMilestone => _roadmap?.Overdue ?? _roadmap?.Upcoming;

    private string? NextTitle => NextMilestone?.Title ?? FirstOpenMilestone?.Title;

    private DateTime? NextDue =>
        NextMilestone is not null ? NextMilestone.DueDate : FirstOpenMilestone?.DueDate;

    private MentorCalendarEvent? NextMeeting =>
        _events.FirstOrDefault(e => e.Type == MentorEventType.Meeting
                                    && e.Date >= DateTime.Now.Date);

    private sealed record Tile(string Label, string Value, string Meta, string MetaClass, string? Href);

    private IReadOnlyList<Tile> Tiles
    {
        get
        {
            var pct = _detail?.MilestoneProgressPct ?? 0;

            var nextMeta = NextDue is null
                ? "לא נקבע מועד"
                : MentorTime.IsOverdue(NextDue)
                    ? $"המועד עבר · {NextDue:dd.MM}"
                    : $"עד {NextDue:dd.MM}";

            var meeting = NextMeeting;

            return new[]
            {
                // No href: the strip that answers this tile is the next section
                // down, and a link that scrolls one card is not a destination.
                new Tile("שלב נוכחי", StageName, $"{pct}% מאבני הדרך הושלמו",
                         "mpw-tile-violet", null),

                new Tile("אבן דרך הבאה", NextTitle ?? "אין אבן דרך פעילה", nextMeta,
                         MentorTime.IsOverdue(NextDue) ? "mpw-late" : "", MentorLinks.Calendar),

                new Tile("פגישה קרובה",
                         meeting?.Title ?? "לא נקבעה פגישה",
                         meeting is null
                             ? "אפשר לקבוע פגישת הנחיה"
                             : $"{MotivaDates.DayAndMonth(meeting.Date)}{(meeting.TimeRange is { Length: > 0 } tr ? $" · {tr}" : "")}",
                         meeting is null ? "" : "mpw-tile-blue",
                         MentorLinks.Calendar),

                new Tile("סטטוס הפרויקט",
                         MentorProjectSignals.Label(Signal),
                         _attention.Count == 0
                             ? "לא נדרשת פעולה"
                             : _attention.Count == 1 ? "פריט אחד ממתין לך" : $"{_attention.Count} פריטים ממתינים לך",
                         _attention.Count == 0 ? "mpw-tile-teal" : "mpw-late",
                         MentorLinks.Tasks),
            };
        }
    }

    // ── Milestone roadmap ───────────────────────────────────────────────────

    private sealed record StageCell(string Name, string Date, bool Done, bool Current, bool Late);

    /// <summary>
    /// The strip, from whichever source the cycle actually has.
    ///
    /// <para>Roadmap stages when they are configured — that is what the
    /// reference draws and what ציר התקדמות already renders. When a cycle has
    /// none, the project's own milestone list carries the identical shape
    /// (a name, a completion state and a date), so the strip degrades to real
    /// milestones instead of disappearing.</para>
    /// </summary>
    private IReadOnlyList<StageCell> StageCells
    {
        get
        {
            var today = DateTime.Today;

            if (_roadmap is { Stages.Count: > 0 })
            {
                return _roadmap.Stages
                    .OrderBy(s => s.DisplayOrder)
                    .Select(s =>
                    {
                        bool done    = s.Status == RoadmapStageStatuses.Completed;
                        bool current = s.Status == RoadmapStageStatuses.Current;

                        // A stage's own SuggestedEndDate first; when a cycle left
                        // it blank — which is the common case in practice — the
                        // last due date among the milestones BOUND to that stage
                        // is the same fact from the other side, and it is already
                        // in this payload. Without the fallback the strip printed
                        // an em dash beside a tile that said the deadline had
                        // passed, which is the two halves of one screen
                        // disagreeing.
                        DateTime? end = s.SuggestedEndDate
                            ?? s.Milestones.Where(m => m.DueDate is not null)
                                           .Max(m => m.DueDate);

                        bool late = current && end is DateTime d && d.Date < today;

                        // "הושלם" carries no date: nothing stores the day a stage
                        // was actually finished, and dating it with the plan would
                        // state something untrue.
                        var text =
                            done                              ? "הושלם"
                            : end is not DateTime endDate      ? "—"
                            : late                             ? $"באיחור מ־{endDate:dd.MM}"
                            :                                    $"עד {endDate:dd.MM}";

                        return new StageCell(s.Name, text, done, current, late);
                    })
                    .ToList();
            }

            return (_detail?.Milestones ?? new List<MentorMilestoneDto>())
                .OrderBy(m => m.OrderIndex)
                .Select(m =>
                {
                    bool done    = m.Status is "Completed" or "Done";
                    bool current = !done && m.ProjectMilestoneId == FirstOpenMilestone?.ProjectMilestoneId;
                    bool late    = !done && MentorTime.IsOverdue(m.DueDate);

                    var text =
                        done                              ? "הושלם"
                        : m.DueDate is not DateTime due    ? "—"
                        : late                             ? $"באיחור מ־{due:dd.MM}"
                        :                                    $"עד {due:dd.MM}";

                    return new StageCell(m.Title, text, done, current, late);
                })
                .ToList();
        }
    }

    private static string StageClass(StageCell c) =>
        c.Late    ? "mpw-stage-late"
        : c.Current ? "mpw-stage-current"
        : c.Done    ? "mpw-stage-done"
        :             "mpw-stage-future";

    private string RoadmapSummary
    {
        get
        {
            var cells = StageCells;
            if (cells.Count == 0) return "";

            var idx  = cells.ToList().FindIndex(c => c.Current);
            var late = cells.Count(c => c.Late);

            var position = idx >= 0 ? $"שלב {idx + 1} מתוך {cells.Count}" : $"{cells.Count} שלבים";
            return late > 0 ? $"אבן דרך באיחור · {position}" : position;
        }
    }

    // ── Attention ───────────────────────────────────────────────────────────

    /// <summary>The row's second line: where the item sits and who put it there.
    /// Falls back to the shared waiting sentence when the item carries
    /// neither — never to an empty line.</summary>
    private static string AttentionSub(MentorAttentionItemDto i)
    {
        var parts = new List<string>();
        if (!string.IsNullOrWhiteSpace(i.MilestoneTitle)) parts.Add($"אבן דרך: {i.MilestoneTitle}");
        if (!string.IsNullOrWhiteSpace(i.ActorName))      parts.Add(i.ActorName!);

        if (parts.Count == 0 && !string.IsNullOrWhiteSpace(i.WaitingLabel))
            parts.Add(i.WaitingLabel);

        return string.Join(" · ", parts);
    }

    /// <summary>The shared waiting phrase for one request, when it is currently
    /// on this mentor. Null hides the chip inside MentorRequestDetail, which is
    /// correct for a request the lecturer or the team is holding.</summary>
    private string? WaitingLabelFor(int requestId) =>
        _attention.FirstOrDefault(i => i.Kind == MentorAttentionKind.Request
                                       && i.EntityId == requestId)?.WaitingLabel;

    // ── Work tabs ───────────────────────────────────────────────────────────

    private IReadOnlyList<MFilterTabs.Tab> WorkTabs => new[]
    {
        new MFilterTabs.Tab(TabSubs,  "הגשות",  Submissions.Count(s => s.SubmissionId is not null)),
        new MFilterTabs.Tab(TabReqs,  "בקשות",  _requests.Count(r => MentorRequestBuckets.IsActionable(r.Status))),
        new MFilterTabs.Tab(TabTasks, "משימות", WorkTasks.Count(t => t.Overdue)),
    };

    private void SelectTab(string key)
    {
        _tab = key;
        _expandedRequestId = null;
    }

    private string TabAllHref => _tab switch
    {
        TabReqs => MentorLinks.RequestsInbox,
        TabSubs => MentorLinks.Reviews,
        _       => MentorLinks.Tasks,
    };

    private string TabAllLabel => _tab switch
    {
        TabReqs => "לכל הבקשות",
        TabSubs => "לכל ההגשות הממתינות",
        _       => "לכל המשימות שלי",
    };

    private void ToggleRequest(int requestId) =>
        _expandedRequestId = _expandedRequestId == requestId ? null : requestId;

    private static string RequestStateClass(MentorRequestBucket b) => b switch
    {
        MentorRequestBucket.AwaitingMentor => "mpw-late",
        MentorRequestBucket.Closed         => "mpw-state-teal",
        _                                  => "mpw-state-quiet",
    };

    private sealed record SubRow(
        string Title, string Milestone, string State, string StateClass,
        int? SubmissionId, string Trailing);

    /// <summary>
    /// Every deliverable on the project, newest need first.
    ///
    /// <para>The rows are the project's own submission TASKS, and the review id
    /// is attached from <c>PendingSubmissions</c> — the only place a submission
    /// id reaches this page. A task with no pending round therefore carries no
    /// button, which is honest: its history lives one call deeper, inside the
    /// drawer, and there is no id here to open it with.</para>
    /// </summary>
    private IReadOnlyList<SubRow> Submissions
    {
        get
        {
            if (_detail is null) return Array.Empty<SubRow>();

            var pending = _detail.PendingSubmissions.ToDictionary(s => s.TaskId, s => s.SubmissionId);

            return _detail.Milestones
                .OrderBy(m => m.OrderIndex)
                .SelectMany(m => m.Tasks.Where(t => t.IsSubmission).Select(t => (Milestone: m, Task: t)))
                .Select(x =>
                {
                    var t  = x.Task;
                    int? id = pending.TryGetValue(t.Id, out var subId) ? subId : null;

                    var (state, cls) =
                        id is not null                    ? ("ממתין לבדיקה שלך", "mpw-late")
                        : t.LatestMentorStatus == "Approved" ? ("נבדק ואושר", "mpw-state-teal")
                        : t.LatestMentorStatus == "Returned" ? ("הוחזר לתיקון", "mpw-state-violet")
                        : t.LatestSubmissionStatus is not null ? ("הוגש", "mpw-state-blue")
                        : t.IsOverdue                        ? ("טרם הוגש · באיחור", "mpw-late")
                        :                                      ("טרם הוגש", "mpw-state-quiet");

                    return new SubRow(t.Title, x.Milestone.Title, state, cls, id, "—");
                })
                // Anything waiting on the mentor first; the rest keep milestone order.
                .OrderBy(r => r.SubmissionId is null ? 1 : 0)
                .ToList();
        }
    }

    /// <summary><paramref name="Task"/> is the mentor's own personal task when
    /// the row is one, and null for a team task. It replaced an
    /// <c>Href</c> to /mentor/tasks?editTask=: the row now opens the shared
    /// editor over this workspace rather than navigating to המשימות שלי to open
    /// the same modal there. A team task stays unclickable — this page has no
    /// editor for one.</summary>
    private sealed record WorkTaskRow(
        bool IsMine, string Title, string Assignee, string Due, bool Overdue,
        string State, string StateClass, PersonalTaskDto? Task);

    /// <summary>
    /// The open work on this project, from both sides of it: the team's own
    /// tasks (from the project payload) and the mentor's personal tasks
    /// associated with it (from the shared snapshot). Overdue first, then by
    /// deadline — a mentor scanning this wants the slipping row at the top.
    /// </summary>
    private IReadOnlyList<WorkTaskRow> WorkTasks
    {
        get
        {
            var rows = new List<WorkTaskRow>();

            if (_detail is not null)
            {
                foreach (var t in _detail.Milestones
                             .SelectMany(m => m.Tasks)
                             .Where(t => t.Status is not ("Done" or "Completed" or "ApprovedForSubmission")))
                {
                    rows.Add(new WorkTaskRow(
                        IsMine:     false,
                        Title:      t.Title,
                        Assignee:   string.IsNullOrWhiteSpace(t.AssignedToName) ? "—" : t.AssignedToName,
                        Due:        DueLabel(t.DueDate),
                        Overdue:    t.IsOverdue,
                        State:      TaskStatusLabel(t),
                        StateClass: TaskStateClass(t),
                        Task:       null));
                }
            }

            foreach (var t in _personal.Where(t => !t.IsDone))
            {
                bool overdue = MentorTime.IsOverdue(t.DueDate);
                rows.Add(new WorkTaskRow(
                    IsMine:     true,
                    Title:      t.Title,
                    Assignee:   "משימה שלך",
                    Due:        DueLabel(t.DueDate),
                    Overdue:    overdue,
                    State:      overdue ? "באיחור" : "פתוחה",
                    StateClass: overdue ? "mpw-late" : "mpw-state-quiet",
                    // The mentor's own task opens its editor — the same shared
                    // modal the calendar and המשימות שלי open, mounted here.
                    Task:       t));
            }

            return rows
                .OrderByDescending(r => r.Overdue)
                .ThenBy(r => r.Due == "—" ? 1 : 0)
                .ToList();
        }
    }

    private static string DueLabel(DateTime? due)
    {
        if (due is null) return "—";
        var d = due.Value.ToLocalTime().Date;
        if (d == DateTime.Today)            return "היום";
        if (d == DateTime.Today.AddDays(1)) return "מחר";
        return d.ToString("dd.MM");
    }

    private static string TaskStateClass(MentorTaskDto t)
    {
        if (t.IsOverdue) return "mpw-late";

        return t.Status switch
        {
            "SubmittedToMentor" or "RevisionSubmitted" => "mpw-state-blue",
            "ReturnedForRevision"                      => "mpw-state-violet",
            "InProgress"                               => "mpw-state-blue",
            _                                          => "mpw-state-quiet",
        };
    }

    // ── Dates and meetings ──────────────────────────────────────────────────

    private IReadOnlyList<MentorCalendarEvent> UpcomingDates =>
        _events.Where(e => e.Date.Date >= DateTime.Today).Take(5).ToList();

    /// <summary>
    /// The last guidance meeting that actually happened.
    ///
    /// <para>Read straight from the project's personal tasks rather than from
    /// the composed calendar, because that composer deliberately drops COMPLETED
    /// entries — right for a planner, wrong for "when did we last meet". Same
    /// definition of a meeting either way: a project entry with an hour someone
    /// chose.</para>
    /// </summary>
    private string LastMeetingLabel
    {
        get
        {
            var last = _personal
                .Where(t => t.DueDate is DateTime d && d.Date < DateTime.Today
                            && MotivaDates.ParseWallClock(t.StartTime) is not null)
                .OrderByDescending(t => t.DueDate!.Value)
                .FirstOrDefault();

            return last is null
                ? "טרם התקיימה פגישת הנחיה"
                : $"פגישה אחרונה: {last.DueDate!.Value:dd.MM} · {last.Title}";
        }
    }

