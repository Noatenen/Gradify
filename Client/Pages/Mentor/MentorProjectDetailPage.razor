    // ── Opening an entity, in place ─────────────────────────────────────────
    //
    // THE RULE, AND WHY THIS PAGE OBEYS IT TOO. A click on an entity inside an
    // overview list INSPECTS it where the reader already is; only an explicit
    // CTA navigates. This screen is a destination, but its lists are overviews
    // of the same four kinds — and every one of them used to be an href that
    // moved the mentor somewhere else in order to open a panel. The submission
    // case was the plainest: the row re-navigated THIS route with
    // ?submissionId= on it, remounting the page to open a drawer that was
    // already there.
    //
    // Nothing about the destinations changed. Every one of them is still
    // reachable, from the CTA inside whatever this opens.

    /// <summary>One attention row, opened in whichever surface owns its kind.</summary>
    private async Task OpenAttentionItemAsync(MentorAttentionItemDto item)
    {
        switch (item.Kind)
        {
            case MentorAttentionKind.Submission:
                await OpenReviewDrawer(item.EntityId);
                break;

            // The בקשות tab already embeds the real request flow — the same
            // MentorRequestDetail the inbox expands, with the same one POST.
            case MentorAttentionKind.Request when _requests.Any(r => r.Id == item.EntityId):
                _tab = TabReqs;
                _expandedRequestId = item.EntityId;
                break;

            case MentorAttentionKind.PersonalTask
                 when _personal.FirstOrDefault(t => t.Id == item.EntityId) is { } own:
                OpenTask(own);
                break;

            // A kind this page has no surface for keeps the link it always had.
            default:
                Nav.NavigateTo(item.Href);
                break;
        }
    }

    /// <summary>
    /// One פגישות ומועדים row.
    ///
    /// <para>A meeting or a personal task opens the shared editor here, and a
    /// review opens this page's own drawer — both used to leave the workspace
    /// to reach the very same panel. A milestone or a dated deliverable has no
    /// entity to open and its old link pointed at THIS page, so it stays put
    /// rather than pretending to do something.</para></summary>
    private async Task OpenEventAsync(MentorCalendarEvent e)
    {
        if (e.Type == MentorEventType.Review)
        {
            await OpenReviewDrawer(e.EntityId);
            return;
        }

        if (e.Type is MentorEventType.PersonalTask or MentorEventType.Meeting
            && _personal.FirstOrDefault(t => t.Id == e.EntityId) is { } own)
        {
            OpenTask(own);
        }
    }

    /// <summary>One activity row. Same routing as an attention row, on the
    /// entity the entry was built from; Href is the fallback for an entry this
    /// page cannot open itself.</summary>
    private async Task OpenActivityAsync(ActivityRow row)
    {
        if (row.Kind is MentorAttentionKind kind)
        {
            await OpenAttentionItemAsync(new MentorAttentionItemDto
            {
                Kind     = kind,
                EntityId = row.EntityId,
                Href     = row.Href,
            });
            return;
        }

        Nav.NavigateTo(row.Href);
    }

