    // ── Recent activity ─────────────────────────────────────────────────────

    /// <summary><paramref name="Kind"/> and <paramref name="EntityId"/> are
    /// what the row actually points AT, so clicking it can open that entity in
    /// place through the same routing an attention row uses.
    /// <paramref name="Href"/> stays as the fallback destination for a row this
    /// page has no surface for, and as the CTA a popup then offers.</summary>
    private sealed record ActivityRow(
        DateTime When, string Text, string Meta, string Href, string ToneClass,
        MentorAttentionKind? Kind = null, int EntityId = 0);

    /// <summary>
    /// Only what a real column can date.
    ///
    /// <para>Four sources, and the product has no fifth: a request's CreatedAt
    /// and its UpdatedAt, a pending submission's SubmittedAt, and a past
    /// guidance meeting's own date. Milestone completion, task creation and
    /// review decisions are all invisible here — nothing stores when they
    /// happened at project scope — so they are absent rather than guessed.</para>
    /// </summary>
    private IReadOnlyList<ActivityRow> Activity
    {
        get
        {
            var rows = new List<ActivityRow>();

            foreach (var r in _requests)
            {
                var href = $"{MentorLinks.RequestsInbox}?requestId={r.Id}";

                rows.Add(new ActivityRow(
                    r.CreatedAt, $"בקשה נפתחה — {r.Title}",
                    string.IsNullOrWhiteSpace(r.CreatedByName)
                        ? r.CreatedAt.ToLocalTime().ToString("dd.MM")
                        : $"{r.CreatedByName} · {r.CreatedAt.ToLocalTime():dd.MM}",
                    href, "mpw-dot-violet", MentorAttentionKind.Request, r.Id));

                // Only when something actually moved after it was filed.
                if (r.UpdatedAt.Date != r.CreatedAt.Date || r.UpdatedAt > r.CreatedAt.AddMinutes(1))
                {
                    rows.Add(new ActivityRow(
                        r.UpdatedAt, $"עדכון בבקשה — {r.Title}",
                        $"{MentorRequestBuckets.RowLabel(MentorRequestBuckets.Of(r.Status))} · {r.UpdatedAt.ToLocalTime():dd.MM}",
                        href, "mpw-dot-grey", MentorAttentionKind.Request, r.Id));
                }
            }

            if (_detail is not null)
            {
                foreach (var s in _detail.PendingSubmissions)
                {
                    // The attention model already owns the deep link to this
                    // submission's review drawer; the queue is the fallback for a
                    // row that is somehow not in attention.
                    var href = _attention
                        .FirstOrDefault(i => i.Kind == MentorAttentionKind.Submission
                                             && i.EntityId == s.SubmissionId)?.Href;

                    rows.Add(new ActivityRow(
                        s.SubmittedAt, $"הגשה התקבלה — {s.TaskTitle}",
                        $"{s.SubmittedBy} · {s.SubmittedAt.ToLocalTime():dd.MM}",
                        string.IsNullOrWhiteSpace(href) ? MentorLinks.Reviews : href!,
                        "mpw-dot-blue", MentorAttentionKind.Submission, s.SubmissionId));
                }
            }

            foreach (var t in _personal.Where(t => t.DueDate is DateTime d && d.Date < DateTime.Today
                                                   && MotivaDates.ParseWallClock(t.StartTime) is not null))
            {
                rows.Add(new ActivityRow(
                    t.DueDate!.Value, $"פגישת הנחיה התקיימה — {t.Title}",
                    $"{t.DueDate.Value:dd.MM} · {t.StartTime}",
                    MentorLinks.PersonalTask(t.Id), "mpw-dot-teal",
                    MentorAttentionKind.PersonalTask, t.Id));
            }

            return rows.OrderByDescending(r => r.When).Take(6).ToList();
        }
    }

    // ── Review drawer: open / close / submit (unchanged flow) ───────────────

    /// <summary>One query value by name, or null. Mirrors the reader
    /// MentorTasksPage uses for its own deep link — one shape, no parser
    /// dependency this project does not already carry.</summary>
    private string? QueryValue(string key)
    {
        var query = new Uri(Nav.Uri).Query.TrimStart('?');

        foreach (var pair in query.Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var eq = pair.IndexOf('=');
            if (eq <= 0) continue;
            if (!pair.AsSpan(0, eq).Equals(key, StringComparison.OrdinalIgnoreCase)) continue;
            return Uri.UnescapeDataString(pair[(eq + 1)..]);
        }

        return null;
    }

    private async Task OpenReviewDrawer(int submissionId)
    {
        _reviewCtx      = null;
        _reviewFeedback = "";
        _reviewError    = false;
        _feedbackError  = "";
        _reviewLoading  = true;
        StateHasChanged();

        _reviewCtx     = await MentorService.GetSubmissionContextAsync(submissionId);
        _reviewLoading = false;

        // Auto-expand the current round in history
        _expandedRounds.Clear();
        if (_reviewCtx is not null)
            _expandedRounds.Add(_reviewCtx.SubmissionId);

        StateHasChanged();
    }

    private void CloseDrawer()
    {
        _reviewCtx      = null;
        _reviewFeedback = "";
        _reviewError    = false;
        _feedbackError  = "";
    }

    private async Task SubmitReviewAsync(string action)
    {
        if (_reviewCtx is null || _reviewing) return;

        // Validation: returning for correction requires a non-empty note.
        // Backend enforces the same rule with the identical Hebrew message —
        // this branch just avoids the round-trip when we can see it locally.
        if (action == "Returned" && string.IsNullOrWhiteSpace(_reviewFeedback))
        {
            _feedbackError = "יש להזין הערת מנחה לפני החזרת ההגשה לתיקון";
            StateHasChanged();
            return;
        }

        _reviewing     = true;
        _pendingAction = action;
        _reviewError   = false;
        _feedbackError = "";
        StateHasChanged();

        bool ok = await MentorService.ReviewSubmissionAsync(
            _reviewCtx.SubmissionId, action, _reviewFeedback);

        _reviewing = false;

        if (ok)
        {
            // Optimistically update the drawer, then reload — the decision moves
            // the item out of attention, off the tiles and out of the הגשות
            // badge, and every one of those is derived rather than stored here.
            _reviewCtx.MentorStatus   = action;
            _reviewCtx.MentorFeedback = string.IsNullOrWhiteSpace(_reviewFeedback) ? null : _reviewFeedback;

            await LoadAsync();
        }
        else
        {
            _reviewError = true;
        }

        StateHasChanged();
    }

    // ── Display helpers ─────────────────────────────────────────────────────

    private static string Initials(string? text)
    {
        var parts = (text ?? "").Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 0) return "?";
        return parts.Length == 1 ? parts[0][..1] : $"{parts[0][..1]}{parts[1][..1]}";
    }

    private static string TaskStatusLabel(MentorTaskDto task)
    {
        if (task.IsSubmission && task.LatestMentorStatus == "Pending"
            && task.Status == "ReturnedForRevision")
            return "הוגש מחדש";

        return task.Status switch
        {
            "Open"                  => "פתוח",
            "InProgress"            => "בביצוע",
            "SubmittedToMentor"     => "הוגש למנחה",
            "ReturnedForRevision"   => "הוחזר לתיקון",
            "RevisionSubmitted"     => "תיקון הוגש",
            "ApprovedForSubmission" => "אושר להגשה",
            "Done" or "Completed"   => "הושלם",
            _                       => task.Status,
        };
    }

    private static string DrawerMentorStatusClass(string s) => s switch
    {
        "Approved" => "mpd-badge-approved",
        "Returned" => "mpd-badge-returned",
        _          => "mpd-badge-pending",
    };

    private static string DrawerMentorStatusLabel(string s) => s switch
    {
        "Approved" => "אושר",
        "Returned" => "הוחזר לתיקון",
        _          => "ממתין לאישורך",
    };

    private static string FileIcon(string contentType)
    {
        if (contentType.StartsWith("image/"))   return "oi-image";
        if (contentType == "application/pdf")   return "oi-document";
        if (contentType.Contains("word"))       return "oi-document";
        if (contentType.Contains("zip") || contentType.Contains("compressed")) return "oi-layers";
        return "oi-file";
    }

    private static string FormatSize(long bytes)
    {
        if (bytes < 1024)           return $"{bytes} B";
        if (bytes < 1024 * 1024)    return $"{bytes / 1024.0:F1} KB";
        return $"{bytes / (1024.0 * 1024):F1} MB";
    }
