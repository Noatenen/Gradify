@namespace AuthWithAdmin.Client.Pages.Mentor
@using AuthWithAdmin.Client.Components
@using AuthWithAdmin.Client.Services
@using AuthWithAdmin.Shared.AuthSharedModels
@inject IProjectRequestsService RequestsService

@*
    MentorRequestDetail — everything there is to say about one request, and the
    one place a mentor can act on it.

    ONE IMPLEMENTATION, TWO SURFACES
    המשימות שלי opens a request in a modal; בקשות expands it inline in the row.
    Those are two presentations of identical content, so the content lives here
    and the two callers supply only the chrome:

        MentorRequestModal   → MModal shell around this
        MentorRequestsPage   → renders this inside the expanded accordion row

    Without this split the recommendation form — the only mentor write in the
    product — would exist twice, which is exactly how two copies of a business
    rule start to disagree.

    THE ORDER OF THE SCREEN, AND WHY
    A mentor opens a request to answer three questions in this order:

        1. WHAT is this?          → the compact identity header
        2. WHAT do I need to know? → מה מבקשים? + the type-specific facts
        3. WHAT do I do now?       → החלטת המנחה, the emphasised surface
        (…and only then the audit trail, which is reference, not reading.)

    This replaced a <dl> "record view": project / requester / team / status /
    waiting rendered as five label-value rows, above two paragraphs holding the
    SAME sentence twice, with the decision buried under all of it. Four of those
    five rows are already on the row this expands from, and the two paragraphs
    are one database value copied into two columns — see the notes on
    Explanation and SecondaryReason below. Nothing unique was dropped; the
    duplicates were.

    WHAT A MENTOR CAN ACTUALLY DO — unchanged
    Extension requests in PendingMentorRecommendation get the REAL mentor stage:
    ממליץ / לא ממליץ plus an internal note, posted to
    POST /api/project-requests/{id}/mentor-recommendation. The mentor advises;
    the lecturer decides. Everything else is read-only, because /handle is
    [Authorize(Admin,Staff)] and /reply requires team membership — there is no
    decision a mentor could post, and a button that 403s is worse than no button.
*@

@if (_loading)
{
    <div class="mrd-state" role="status" aria-live="polite">
        <span class="mrd-spinner" aria-hidden="true"></span>
        <span>טוענת את הבקשה…</span>
    </div>
}
else if (_detail is null)
{
    <MEmptyState Live="true"
                 Title="לא הצלחנו לטעון את הבקשה"
                 Description="ייתכן שיש תקלת רשת זמנית." />
}
else
{
    <div class="mrd">

        @*  ── 1. WHAT IS THIS ──────────────────────────────────────────────
            Identity, once, and only where it is not already on screen:
            בקשות expands this under a row that already carries the type badge,
            the title, "פרויקט · צוות · מגיש" and the waiting phrase, and passes
            ShowHeader="false". The modal has only the word "בקשה" above it, so
            there it renders. Same component, no duplicated line either way. *@
        @if (ShowHeader)
        {
            <header class="mrd-id">
                <div class="mrd-id-line">
                    <MStatusBadge Text="@RequestTypes.Label(_detail.RequestType)" />
                    <MStatusDot Tone="@MentorRequestBuckets.Tone(Bucket)"
                                Label="@MentorRequestBuckets.RowLabel(Bucket)" />
                    @if (WaitingLabel is { Length: > 0 })
                    {
                        @* Secondary, and a chip rather than a row: how long it
                           has waited qualifies the status, it is not a fact of
                           its own rank. *@
                        <span class="mrd-id-wait">@WaitingLabel</span>
                    }
                </div>

                <h3 class="mrd-id-title">@_detail.Title</h3>

                @if (ContextLine is { Length: > 0 })
                {
                    <p class="mrd-id-context">@ContextLine</p>
                }
            </header>
        }

        @* ── 2. WHAT DO I NEED TO KNOW ───────────────────────────────────── *@

        @if (Explanation is { Length: > 0 })
        {
            <section class="mrd-sec">
                <p class="mrd-label">מה מבקשים?</p>
                <p class="mrd-text">@Explanation</p>
            </section>
        }

        @if (SecondaryReason is { Length: > 0 })
        {
            @* Reached only when the two columns genuinely hold two different
               texts — see SecondaryReason. For everything the app itself
               created they are identical and this never renders. *@
            <section class="mrd-sec">
                <p class="mrd-label">נימוק נוסף מהצוות</p>
                <p class="mrd-text">@SecondaryReason</p>
            </section>
        }

        @*  Request-type-specific facts, rendered semantically.

            An extension is a DATE MOVE, so it reads as one: the two dates side
            by side with the size of the move between them, instead of three
            label-value rows a mentor has to subtract in their head. Only the
            fields this request actually has are drawn — no "—" placeholders.

            Another request type reaching this component renders no block at
            all rather than an empty frame; Extension is the only type that
            carries side-data today. *@
        @if (_detail.Extension is { } ext)
        {
            <section class="mrd-sec">
                <div class="mrd-shift">
                    @if (ext.CurrentDueDate is not null)
                    {
                        <div class="mrd-shift-side">
                            <span class="mrd-shift-k">מועד נוכחי</span>
                            <span class="mrd-shift-v">@DateText(ext.CurrentDueDate)</span>
                        </div>
                        @* RTL: the first item sits on the right, so the move
                           reads right-to-left and the arrow points with it. *@
                        <span class="mrd-shift-arrow" aria-hidden="true">←</span>
                    }

                    <div class="mrd-shift-side mrd-shift-to">
                        <span class="mrd-shift-k">מועד מבוקש</span>
                        <span class="mrd-shift-v">@DateText(ext.RequestedDueDate)</span>
                    </div>

                    @if (ShiftLabel is { Length: > 0 })
                    {
                        <span class="mrd-shift-delta">@ShiftLabel</span>
                    }
                </div>

                @if (ExtensionTarget is { Length: > 0 })
                {
                    <p class="mrd-shift-target">יעד: @ExtensionTarget</p>
                }
            </section>
        }

        @* ── 3. WHAT DO I DO NOW ─────────────────────────────────────────────
             The only emphasised surface in the expanded area — the Motiva
             gradient hairline, used here for the reason it exists: this is the
             thing the mentor came to do. It sits ABOVE the history, which used
             to push it off the bottom of a tall record view. *@
        @if (IsRecommendationStage)
        {
            <section class="mrd-act">
                <div class="mrd-act-inner">
                    <p class="mrd-act-title">החלטת המנחה</p>
                    <p class="mrd-act-hint">
                        ההמלצה וההערה מועברות למרצה בלבד — ההחלטה הסופית היא שלו.
                    </p>

                    <div class="mrd-choice" role="radiogroup" aria-label="המלצה">
                        <button type="button"
                                class="mrd-choice-btn @(_recommendation == ExtensionDecisionStatuses.Recommended ? "mrd-choice-on" : "")"
                                role="radio"
                                aria-checked="@(_recommendation == ExtensionDecisionStatuses.Recommended)"
                                disabled="@_submitting"
                                @onclick="@(() => _recommendation = ExtensionDecisionStatuses.Recommended)">
                            <span class="mrd-choice-mark" aria-hidden="true">
                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                     stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="m5 13 4.5 4.5L19 7"></path>
                                </svg>
                            </span>
                            ממליץ
                        </button>
                        <button type="button"
                                class="mrd-choice-btn @(_recommendation == ExtensionDecisionStatuses.NotRecommended ? "mrd-choice-off" : "")"
                                role="radio"
                                aria-checked="@(_recommendation == ExtensionDecisionStatuses.NotRecommended)"
                                disabled="@_submitting"
                                @onclick="@(() => _recommendation = ExtensionDecisionStatuses.NotRecommended)">
                            <span class="mrd-choice-mark" aria-hidden="true">
                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                     stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M6 6l12 12M18 6 6 18"></path>
                                </svg>
                            </span>
                            לא ממליץ
                        </button>
                    </div>

                    <label class="mrd-notes-label" for="@NotesFieldId">הערה למרצה (אופציונלי)</label>
                    <textarea id="@NotesFieldId" class="mrd-notes" rows="2" maxlength="2000"
                              placeholder="מה חשוב שהמרצה יידע לפני ההחלטה?"
                              disabled="@_submitting"
                              @bind="_notes"></textarea>

                    @if (!string.IsNullOrEmpty(_error))
                    {
                        <p class="mrd-error" role="alert">@_error</p>
                    }

                    @if (ShowActions)
                    {
                        @* Wording states what the button does to the request:
                           the recommendation is saved and the status moves to
                           PendingLecturerDecision. The modal's footer carries
                           the identical label. *@
                        <div class="mrd-actions">
                            <MButton Variant="MButton.ButtonVariant.Primary"
                                     OnClick="SubmitRecommendationAsync"
                                     Loading="@_submitting"
                                     LoadingText="שולחת…"
                                     Disabled="@(_submitting || string.IsNullOrEmpty(_recommendation))">
                                שליחת ההמלצה למרצה
                            </MButton>
                        </div>
                    }
                </div>
            </section>
        }
        else if (RecordedDecision is { Length: > 0 })
        {
            @*  The same section, after the fact. What the mentor recommended is
                stored on the extension row and shown nowhere else in the
                product — the audit event deliberately logs only the status
                change, never the recommendation or the private note — so
                without this the mentor cannot see what they themselves said. *@
            <section class="mrd-act mrd-act-done">
                <div class="mrd-act-inner">
                    <p class="mrd-act-title">החלטת המנחה</p>

                    <div class="mrd-done-line">
                        <MStatusBadge Text="@ExtensionDecisionStatuses.Label(RecordedDecision)"
                                      Variant="@RecordedDecisionVariant" />
                        @if (RecordedByLine is { Length: > 0 })
                        {
                            <span class="mrd-done-meta">@RecordedByLine</span>
                        }
                    </div>

                    @if (_detail.Extension?.MentorNotes is { Length: > 0 } note)
                    {
                        <p class="mrd-text mrd-done-note">@note</p>
                    }

                    <p class="mrd-act-hint">@ReadOnlyExplanation</p>
                </div>
            </section>
        }
        else
        {
            <p class="mrd-readonly">@ReadOnlyExplanation</p>
        }

        @* ── 4. Reference, not reading — quietest block, and last. ── *@
        @if (_detail.Events.Count > 0)
        {
            <section class="mrd-sec">
                <p class="mrd-label">היסטוריה</p>
                <ul class="mrd-history">
                    @foreach (var e in _detail.Events.OrderBy(x => x.CreatedAt).Take(8))
                    {
                        <li class="mrd-history-row">
                            <span class="mrd-history-when">@e.CreatedAt.ToLocalTime().ToString("dd.MM")</span>
                            <span class="mrd-history-what">@EventLine(e)</span>
                        </li>
                    }
                </ul>
            </section>
        }
    </div>
}

@code {
    [Parameter, EditorRequired] public int RequestId { get; set; }

    /// <summary>Raised after the server accepts a recommendation, so the host
    /// can reload its counts — the request has just left "מחכות לתגובתך".</summary>
    [Parameter] public EventCallback OnChanged { get; set; }

    /// <summary>The compact identity header — badges, title, context line. The
    /// modal shows it; the accordion row does not, because the row it expands
    /// from already carries every one of those values.</summary>
    [Parameter] public bool ShowHeader { get; set; } = true;

    /// <summary>Whether this component renders its own submit button. False in
    /// the modal, whose footer owns the actions.</summary>
    [Parameter] public bool ShowActions { get; set; } = true;

    /// <summary>
    /// The waiting phrase for this request, from the shared attention model.
    ///
    /// <para>Passed in rather than derived. This component used to compute it
    /// from CreatedAt itself, which meant a request could be worded here one way
    /// and in the queue behind it another. The host already holds the attention
    /// item, so it supplies the string; null simply hides the chip, which is
    /// correct for any request not currently waiting on the mentor.</para>
    /// </summary>
    [Parameter] public string? WaitingLabel { get; set; }

    private ProjectRequestDetailDto? _detail;
    private int?    _loadedId;
    private bool    _loading;
    private bool    _submitting;
    private string? _recommendation;
    private string  _notes = "";
    private string? _error;

    /// <summary>True once a choice is picked — lets a host footer enable its own
    /// submit button.</summary>
    public bool CanSubmit => IsRecommendationStage && !string.IsNullOrEmpty(_recommendation) && !_submitting;
    public bool IsSubmitting => _submitting;

    /// <summary>Ties the note's label to its textarea. Derived from the request
    /// id so the two surfaces cannot mint the same id for different requests.</summary>
    private string NotesFieldId => $"mrd-notes-{RequestId}";

    private MentorRequestBucket Bucket =>
        MentorRequestBuckets.Of(_detail?.Status ?? RequestStatuses.New);

    private bool IsRecommendationStage =>
        _detail is not null && _detail.Status == RequestStatuses.PendingMentorRecommendation;

    private string ReadOnlyExplanation => Bucket switch
    {
        MentorRequestBucket.WithLecturer => "הבקשה נמצאת אצל המרצה. אין פעולה שנדרשת ממך בשלב הזה.",
        MentorRequestBucket.AwaitingTeam => "הבקשה הוחזרה לצוות והיא ממתינה להשלמת פרטים מהסטודנטים.",
        MentorRequestBucket.Closed       => "הבקשה טופלה ונסגרה.",
        _                                => "אין פעולה שנדרשת ממך בבקשה הזו כרגע.",
    };

    // ── Identity ────────────────────────────────────────────────────────────

    /// <summary>"פרויקט · צוות · מגיש/ת הבקשה" — the same three values, in the
    /// same order and the same separator, that the queue row states as its
    /// second line. One line instead of three label-value rows.</summary>
    private string ContextLine =>
        _detail is null ? "" : string.Join(" · ", new[]
        {
            _detail.ProjectTitle,
            _detail.TeamName,
            _detail.CreatedByName,
        }.Where(s => !string.IsNullOrWhiteSpace(s)));

    // ── The student's explanation, exactly once ─────────────────────────────

    /// <summary>
    /// What the team wrote.
    ///
    /// <para>For an extension filed through the app these are the SAME words in
    /// two columns: the create endpoint writes
    /// <c>ProjectRequestExtensions.Reason = ProjectRequests.Description</c>.
    /// The screen used to print both, under two different headings, so a single
    /// sentence appeared twice. This prefers the parent Description and falls
    /// back to Reason for a row that only has the latter.</para>
    /// </summary>
    private string? Explanation =>
        Clean(_detail?.Description) ?? Clean(_detail?.Extension?.Reason);

    /// <summary>The extension's Reason ONLY when it is genuinely a second text —
    /// a legacy or imported row whose two columns diverged. Identical values
    /// (the normal case) render once, as Explanation.</summary>
    private string? SecondaryReason
    {
        get
        {
            var description = Clean(_detail?.Description);
            var reason      = Clean(_detail?.Extension?.Reason);

            if (description is null || reason is null) return null;
            return string.Equals(description, reason, StringComparison.Ordinal) ? null : reason;
        }
    }

    private static string? Clean(string? value) =>
        string.IsNullOrWhiteSpace(value) ? null : value.Trim();

    // ── Extension facts ─────────────────────────────────────────────────────

    private string? ExtensionTarget =>
        _detail?.Extension is null ? null
        : !string.IsNullOrWhiteSpace(_detail.Extension.TaskTitle)      ? _detail.Extension.TaskTitle
        : !string.IsNullOrWhiteSpace(_detail.Extension.MilestoneTitle) ? _detail.Extension.MilestoneTitle
        : null;

    /// <summary>A due date is a date the student picked, not an instant — so it
    /// is printed as stored, with no timezone conversion.</summary>
    private static string DateText(DateTime? value) =>
        value?.ToString("dd.MM.yyyy") ?? "—";

    /// <summary>How big the move is, in words — the subtraction the mentor
    /// would otherwise do in their head. Null when there is nothing to compare
    /// against, or when the two dates are the same day.</summary>
    private string? ShiftLabel
    {
        get
        {
            var ext = _detail?.Extension;
            if (ext?.CurrentDueDate is null) return null;

            int days = (int)(ext.RequestedDueDate.Date - ext.CurrentDueDate.Value.Date).TotalDays;

            return days switch
            {
                0   => null,
                > 0 => $"דחייה של {DaysPhrase(days)}",
                _   => $"הקדמה של {DaysPhrase(-days)}",
            };
        }
    }

    /// <summary>The same day-count idiom MentorTime uses everywhere else —
    /// "יום" / "יומיים" / "N ימים".</summary>
    private static string DaysPhrase(int days) => days switch
    {
        1 => "יום",
        2 => "יומיים",
        _ => $"{days} ימים",
    };

    // ── The recommendation already on record ────────────────────────────────

    /// <summary>The mentor's stored recommendation, or null while none has been
    /// made. Pending is "not decided", not a decision.</summary>
    private string? RecordedDecision
    {
        get
        {
            var decision = _detail?.Extension?.MentorDecision;
            return string.IsNullOrWhiteSpace(decision)
                   || decision == ExtensionDecisionStatuses.Pending
                       ? null
                       : decision;
        }
    }

    private MStatusBadge.BadgeVariant RecordedDecisionVariant => RecordedDecision switch
    {
        ExtensionDecisionStatuses.Recommended or ExtensionDecisionStatuses.Approved
            => MStatusBadge.BadgeVariant.Teal,
        ExtensionDecisionStatuses.NotRecommended or ExtensionDecisionStatuses.Rejected
            => MStatusBadge.BadgeVariant.Rose,
        _   => MStatusBadge.BadgeVariant.Violet,
    };

    /// <summary>"מי · מתי" for the recorded recommendation. Either half may be
    /// missing on an older row, so the line is joined from whatever exists.</summary>
    private string RecordedByLine
    {
        get
        {
            var ext = _detail?.Extension;
            if (ext is null) return "";

            return string.Join(" · ", new[]
            {
                Clean(ext.MentorDecidedByName),
                ext.MentorDecidedAt is null ? null : ext.MentorDecidedAt.IsraelFormat("dd.MM.yyyy"),
            }.Where(s => !string.IsNullOrWhiteSpace(s)));
        }
    }

    // ── Load / act — unchanged behaviour ────────────────────────────────────

    protected override async Task OnParametersSetAsync()
    {
        if (RequestId <= 0) { Reset(); return; }
        if (_loadedId == RequestId) return;

        _loading = true;
        _loadedId = RequestId;
        StateHasChanged();

        _detail = await RequestsService.GetByIdAsync(RequestId);

        // Preserve the legacy screen's behaviour: opening a request clears its
        // unread marker. Fire-and-forget, exactly as the old drawer did — the
        // read receipt must never block the detail from rendering.
        _ = RequestsService.MarkReadAsync(RequestId);

        _recommendation = null;
        _notes = "";
        _error = null;
        _loading = false;
    }

    private void Reset()
    {
        _detail = null; _loadedId = null;
        _recommendation = null; _notes = ""; _error = null;
    }

    /// <summary>Callable by a host that owns the submit button (the modal).</summary>
    public async Task SubmitRecommendationAsync()
    {
        if (_detail is null || string.IsNullOrEmpty(_recommendation)) return;

        _submitting = true;
        _error = null;
        StateHasChanged();

        var err = await RequestsService.SubmitMentorRecommendationAsync(
            _detail.Id,
            new MentorRecommendationRequest
            {
                Recommendation = _recommendation,
                Notes          = string.IsNullOrWhiteSpace(_notes) ? null : _notes.Trim(),
            });

        _submitting = false;

        if (err is not null) { _error = err; return; }

        await OnChanged.InvokeAsync();
    }

    private static string EventLine(ProjectRequestEventDto e)
    {
        if (!string.IsNullOrWhiteSpace(e.Content)) return $"{e.UserName}: {e.Content}";
        if (!string.IsNullOrWhiteSpace(e.NewValue))
            return string.IsNullOrWhiteSpace(e.OldValue)
                ? $"{e.UserName} — {e.NewValue}"
                : $"{e.UserName} — {e.OldValue} ← {e.NewValue}";
        return e.UserName;
    }
}
