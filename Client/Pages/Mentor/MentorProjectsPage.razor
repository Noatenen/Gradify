@page "/mentor/projects"
@layout AppLayout
@attribute [Authorize(Roles = Roles.Mentor + "," + Roles.Admin + "," + Roles.Staff)]
@namespace AuthWithAdmin.Client.Pages.Mentor
@using Microsoft.AspNetCore.Authorization
@using AuthWithAdmin.Client.Components
@using AuthWithAdmin.Client.Services
@using AuthWithAdmin.Shared.AuthSharedModels
@inject IMentorWorkspaceService Workspace
@inject IRoadmapStagesService Roadmap

@*
    ── פרויקטים בהנחייתי ────────────────────────────────────────────────────
    VISUAL SOURCE OF TRUTH:  Motiva Mentor Teams.dc.html (Claude Design).
                             The title row, the pill filter track, the single
                             translucent list card, the five-column row and the
                             380px detail rail are all that file's.
    Data sources:            GET api/mentor/projects — already scoped by
                             ProjectMentors, i.e. the projects this mentor is
                             actually assigned to supervise — plus the shared
                             mentor snapshot (attention, requests, personal
                             tasks) and GET api/roadmap-stages/mentor/
                             projects-progress for the stage and the next
                             milestone.

    THE NAME IS THE SEMANTICS. The reference titles this screen "הצוותים שלי"
    and the previous implementation called it "הפרויקטים שלי". Both read as
    ownership; the list is neither. It is the set of projects where this user
    sits in ProjectMentors — the ones they SUPERVISE — so the screen, the nav
    item and every link into it now say פרויקטים בהנחייתי. Nothing about the
    query changed: that scoping was already the server's, and no demo team is
    ever rendered.

    FILTERING BY ATTENTION, NOT BY HEALTH — the one substantive departure from
    the screen this replaces, and it is a data fact rather than a taste.
    Projects.HealthStatus is never written by this application (the mentor Home
    card stopped reading it for exactly this reason), so the four KPI cards that
    used to be the filter put every project in במסלול and left the other two
    permanently empty. The reference filters by what is waiting on the mentor,
    and every one of those states is read off a column the product maintains: a
    milestone due date, the pending mentor-review count, and the project's open
    requests. See MentorProjectSignal.

    FIVE TABS, AND NO "באיחור" TAB. The reference's own filter set is
    הכל · דורש תשומת לב · הגשה לבדיקה · בקשה פתוחה · מתקדם כרגיל. A late
    milestone is a signal without a tab of its own; it is counted by, and
    reachable through, דורש תשומת לב. Kept as drawn rather than "improved",
    since the brief makes the file the source of truth for the control set.

    ORDERING IS PART OF THE DESIGN: worst signal first, then nearest deadline.
    A mentor opens this screen to find the project that needs them.

    THE ROW OPENS THE DRAWER, NOT THE PROJECT. The reference's compact rail is
    the summary; מרחב הפרויקט (/mentor/projects/{id}) is one button inside it,
    unchanged, along with the real routes to the submission review, the request
    thread and the calendar.
*@

<div class="mpj-header-bleed">
    <MPageHeader Variant="MPageHeader.HeaderVariant.Compact"
                 Title="פרויקטים בהנחייתי"
                 Subtitle="@SubtitleText"
                 Class="mpj-header">
        <Actions>
            @if (!_loading && _rows.Count > 0)
            {
                <MSearchField @bind-Value="_query"
                              MaxWidth="260px"
                              Placeholder="חיפוש פרויקט או צוות…"
                              AriaLabel="חיפוש בפרויקטים בהנחייתי"
                              Class="mpj-search" />
            }
        </Actions>
    </MPageHeader>
</div>

<div class="mpj-body">

    @if (_loading)
    {
        <MLoadingState Label="טוענת פרויקטים…" />
    }
    else if (_rows.Count == 0)
    {
        <MEmptyState Title="לא משויכים אליך פרויקטים כרגע"
                     Description="כשתשויך/י להנחיית צוות, הפרויקט שלו יופיע כאן." />
    }
    else
    {
        <MCard Padding="MCard.CardPadding.None">
            <div class="mpj-card">

                <div class="mpj-controls">
                    <MFilterTabs Tabs="@FilterTabs"
                                 ActiveKey="@_filter"
                                 OnSelect="SelectFilter"
                                 AriaLabel="סינון פרויקטים לפי מצב" />
                    <span class="mpj-count">@CountLabel</span>
                </div>

                @if (Filtered.Count == 0)
                {
                    <p class="mpj-empty">
                        לא נמצאו פרויקטים תואמים ·
                        <button type="button" class="mpj-clear" @onclick="ClearFilters">ניקוי חיפוש וסינון</button>
                    </p>
                }
                else
                {
                    <MRowList AriaLabel="פרויקטים בהנחייתי" Class="mpj-rows">
                        @foreach (var row in Filtered)
                        {
                            var r = row;

                            <MRow OnClick="@(() => Open(r))"
                                  Class="mpj-row"
                                  Selected="@(_selected?.Project.Id == r.Project.Id)"
                                  AriaLabel="@($"פתיחת פרטי {r.TeamLabel} — {MentorProjectSignals.Label(r.Signal)}")">
                                <Leading>
                                    <MStatusDot Tone="@MentorProjectSignals.Tone(r.Signal)"
                                                AriaLabel="@MentorProjectSignals.Label(r.Signal)" />
                                </Leading>

                                <ChildContent>
                                    <span class="mpj-id">
                                        <span class="mpj-name">@r.TeamLabel</span>
                                        <span class="mpj-project">@r.ProjectLabel</span>
                                    </span>

                                    <span class="mpj-stage-cell">
                                        <span class="mpj-stage">@r.Stage</span>
                                    </span>

                                    <span class="mpj-milestone" title="@r.Milestone">@r.Milestone</span>

                                    <span class="mpj-note @NoteClass(r.Signal)" title="@r.Note">@r.Note</span>
                                </ChildContent>

                                <Trailing>
                                    <span class="mpj-chevron" aria-hidden="true">
                                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                             stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M15 6l-6 6 6 6"></path>
                                        </svg>
                                    </span>
                                </Trailing>
                            </MRow>
                        }
                    </MRowList>
                }
            </div>
        </MCard>
    }
</div>

@*  ── Detail rail ──────────────────────────────────────────────────────────
    The reference's compact drawer: a 380px panel pinned to the reading end
    over a scrim, not a centred modal. Same geometry the יומן drawer already
    uses, so the two mentor drawers are one object. *@
@if (_selected is Row sel)
{
    <div class="mpj-scrim" @onclick="Close"></div>

    <aside class="mpj-drawer" role="dialog" aria-modal="true" aria-label="@sel.TeamLabel">

        <div class="mpj-drawer-top">
            <span class="mpj-drawer-stage">@sel.Stage</span>

            @if (sel.Signal != MentorProjectSignal.None)
            {
                <span class="mpj-drawer-alert @NoteClass(sel.Signal)">
                    <span class="mpj-drawer-alert-dot" aria-hidden="true"></span>
                    @MentorProjectSignals.Label(sel.Signal)
                </span>
            }

            <button type="button" class="mpj-drawer-close" title="סגירה" aria-label="סגירה" @onclick="Close">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="2.2" stroke-linecap="round" aria-hidden="true">
                    <path d="M18 6 6 18M6 6l12 12"></path>
                </svg>
            </button>
        </div>

        <h2 class="mpj-drawer-title">@sel.TeamLabel</h2>
        <p class="mpj-drawer-sub">@sel.DrawerSubtitle</p>

        @if (sel.Members.Count > 0)
        {
            <div class="mpj-members">
                @foreach (var m in sel.Members)
                {
                    <span class="mpj-member">
                        <span class="mpj-member-initials" aria-hidden="true">@Initials(m)</span>
                        @m
                    </span>
                }
            </div>
        }

        <div class="mpj-facts">

            <div class="mpj-fact">
                <span class="mpj-fact-k">שלב נוכחי</span>
                <span class="mpj-fact-v mpj-fact-v-stage">@sel.Stage · @sel.StagePct%</span>
            </div>

            <div class="mpj-fact">
                <span class="mpj-fact-k">אבן דרך הבאה</span>
                <span class="mpj-fact-v">@sel.Milestone</span>
            </div>

            <div class="mpj-fact">
                <span class="mpj-fact-k">פגישה קרובה</span>
                <span class="mpj-fact-v">@(sel.MeetingLabel ?? "לא נקבעה פגישה קרובה")</span>
            </div>

            @*  Only the submissions genuinely sitting with this mentor. The
                waiting phrase is the attention model's own, so the drawer, the
                queue on המשימות שלי and the daily digest say the same thing. *@
            @if (sel.PendingReviews.Count > 0)
            {
                var review = sel.PendingReviews[0];
                <div class="mpj-fact">
                    <span class="mpj-fact-k">הגשה לבדיקה</span>
                    <span class="mpj-fact-v mpj-fact-stack">
                        <a class="mpj-fact-link" href="@review.Href">@review.Title</a>
                        <span class="mpj-fact-note">
                            @review.WaitingLabel@(sel.PendingReviews.Count > 1
                                ? $" · ועוד {sel.PendingReviews.Count - 1} ממתינות" : "")
                        </span>
                    </span>
                </div>
            }

            @if (sel.OpenRequests.Count > 0)
            {
                var req = sel.OpenRequests[0];
                <div class="mpj-fact">
                    <span class="mpj-fact-k">בקשה פתוחה</span>
                    <span class="mpj-fact-v mpj-fact-stack">
                        <a class="mpj-fact-link" href="@RequestHref(req)">@RequestLabel(req)</a>
                        <span class="mpj-fact-note">
                            @MentorRequestBuckets.RowLabel(MentorRequestBuckets.Of(req.Status))@(sel.OpenRequests.Count > 1
                                ? $" · ועוד {sel.OpenRequests.Count - 1} פתוחות" : "")
                        </span>
                    </span>
                </div>
            }
        </div>

        @*  Two destinations, both existing routes. The primary is whatever this
            project is waiting for — the submission's own review drawer, the
            request's own thread, or the project workspace when nothing is
            queued. *@
        <div class="mpj-drawer-actions">
            <a class="mpj-drawer-alt" href="@SecondaryHref(sel)">@SecondaryLabel(sel)</a>
            <a class="mpj-drawer-go motiva-cta" href="@PrimaryHref(sel)">
                @PrimaryLabel(sel)
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M15 6l-6 6 6 6"></path>
                </svg>
            </a>
        </div>
    </aside>
}

@code {
    /// <summary>?filter= — one of the tab keys. Written by
    /// <see cref="MentorLinks.Projects(MentorProjectSignal?)"/> and normalised
    /// through the same vocabulary, so an unknown value shows everything rather
    /// than blanking the list.</summary>
    [SupplyParameterFromQuery(Name = "filter")]
    public string? FilterParam { get; set; }

    /// <summary>?project= — opens that project's rail straight away. The
    /// reference's own <c>?team=</c> deep link, keyed by the real project id.</summary>
    [SupplyParameterFromQuery(Name = "project")]
    public int? ProjectParam { get; set; }

    /// <summary>The query values already applied. Re-applying only on a CHANGE
    /// is what lets the tabs stay a live filter: picking one must not be undone
    /// by the next render, and arriving with a new ?filter= must not be ignored
    /// because the component was reused.</summary>
    private string? _appliedFilterParam;
    private int?    _appliedProjectParam;

    private MentorWorkspace _ws = MentorWorkspace.Empty;
    private List<Row> _rows = new();
    private bool _loading = true;

    private string _query  = "";
    private string _filter = MentorProjectSignals.FilterAll;
    private Row?   _selected;

    /// <summary>Everything one row of this screen draws, resolved once at load
    /// rather than per render — the signal, the phrases and the two lists the
    /// rail reads are each derived from three sources, and recomputing them
    /// inside the markup would run them on every keystroke in the search box.</summary>
    private sealed record Row(
        MentorProjectSummaryDto              Project,
        MentorProjectSignal                  Signal,
        string                               TeamLabel,
        string                               ProjectLabel,
        string                               DrawerSubtitle,
        string                               Stage,
        int                                  StagePct,
        string                               Milestone,
        string                               Note,
        string?                              MeetingLabel,
        IReadOnlyList<string>                Members,
        IReadOnlyList<MentorAttentionItemDto> PendingReviews,
        IReadOnlyList<ProjectRequestRowDto>   OpenRequests,
        DateTime?                            NextDue,
        string                               SearchText);

    protected override void OnParametersSet()
    {
        if (FilterParam != _appliedFilterParam)
        {
            _appliedFilterParam = FilterParam;
            _filter = MentorProjectSignals.Normalize(FilterParam);
        }

        if (ProjectParam != _appliedProjectParam)
        {
            _appliedProjectParam = ProjectParam;
            ApplyProjectDeepLink();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        // Two independent round-trips, concurrently: the snapshot the whole
        // mentor experience shares, and the roadmap progress that owns the
        // stage and the next milestone. Sequential awaits here would make the
        // page cost the sum rather than the slower of the two.
        var snapshotTask = Workspace.LoadAsync();
        var roadmapTask  = Roadmap.GetMentorProjectsProgressAsync();
        await Task.WhenAll(snapshotTask, roadmapTask);

        _ws = await snapshotTask;

        // Null means the roadmap call failed or the mentor's cycle has no
        // stages configured. Every field it feeds has a fallback from the
        // project summary, so the page degrades to slightly less precise
        // wording instead of to an error.
        var roadmap = (await roadmapTask ?? new List<MentorRoadmapEntryDto>())
            .GroupBy(e => e.ProjectId)
            .ToDictionary(g => g.Key, g => g.First().Progress);

        _rows = _ws.Projects
                   .Select(p => BuildRow(p, roadmap.GetValueOrDefault(p.Id)))
                   .OrderBy(r => MentorProjectSignals.Priority(r.Signal))
                   .ThenBy(r => r.NextDue ?? DateTime.MaxValue)
                   .ToList();

        _loading = false;
        ApplyProjectDeepLink();
    }

    // ── Row construction ────────────────────────────────────────────────────

    private Row BuildRow(MentorProjectSummaryDto p, ProjectRoadmapProgressDto? progress)
    {
        var stage = progress?.Stages.FirstOrDefault(s => s.Status == RoadmapStageStatuses.Current);

        //  The next milestone the team owes. The roadmap answers it precisely —
        //  an overdue one outranks an upcoming one, exactly as ציר התקדמות
        //  renders it — and the project summary's own "first incomplete
        //  milestone" is the fallback when no stages are configured.
        var next = progress?.Overdue ?? progress?.Upcoming;
        var nextTitle = next?.Title ?? p.CurrentMilestoneTitle;
        var nextDue   = next is not null ? next.DueDate : p.CurrentMilestoneDueDate;

        var pendingReviews = _ws.Reviews.Where(i => i.ProjectId == p.Id).ToList();
        var openRequests   = _ws.Requests
            .Where(r => r.ProjectId == p.Id
                        && r.Status is not (RequestStatuses.Resolved or RequestStatuses.Closed))
            .OrderByDescending(r => r.UpdatedAt)
            .ToList();

        var signal = MentorProjectSignals.Of(
            milestoneOverdue: MentorTime.IsOverdue(nextDue),
            pendingReviews:   pendingReviews.Count,
            openRequests:     openRequests.Count);

        var team    = string.IsNullOrWhiteSpace(p.TeamName) ? p.Title : p.TeamName;
        var sameName = string.Equals(team, p.Title, StringComparison.Ordinal);

        var members = (p.StudentNames ?? "")
            .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .ToList();

        return new Row(
            Project:        p,
            Signal:         signal,
            TeamLabel:      team,
            ProjectLabel:   sameName ? p.ProjectType : p.Title,
            DrawerSubtitle: sameName ? p.ProjectType : $"פרויקט: {p.Title}",
            Stage:          stage?.Name
                            ?? (string.IsNullOrWhiteSpace(p.CurrentMilestoneTitle)
                                    ? "טרם החל" : p.CurrentMilestoneTitle!),
            StagePct:       stage?.ProgressPct ?? p.MilestoneProgressPct,
            Milestone:      MilestoneLine(nextTitle, nextDue),
            Note:           MentorProjectSignals.Note(signal, nextDue, pendingReviews.Count, openRequests),
            MeetingLabel:   NextMeetingLabel(p.Id),
            Members:        members,
            PendingReviews: pendingReviews,
            OpenRequests:   openRequests,
            NextDue:        nextDue,
            SearchText:     $"{p.TeamName} {p.Title} {p.StudentNames} {stage?.Name} {nextTitle}");
    }

    private static string MilestoneLine(string? title, DateTime? due)
    {
        if (string.IsNullOrWhiteSpace(title)) return "אין אבן דרך פעילה";

        var deadline = MentorTime.DeadlineLabel(due);
        return deadline is null ? title! : $"{title} · {deadline}";
    }

    /// <summary>
    /// The team's next scheduled meeting, off the mentor's own personal tasks.
    ///
    /// <para>Same rule <see cref="MentorWorkspaceService.BuildCalendarAsync"/>
    /// uses to call an entry a meeting rather than a reminder: a project
    /// association AND an hour someone actually chose. Reading it here rather
    /// than fetching anything new is what keeps this screen at two round-trips —
    /// and it means the rail can never name a meeting the יומן does not draw.</para>
    /// </summary>
    private string? NextMeetingLabel(int projectId)
    {
        var today = DateTime.Now.Date;

        var next = _ws.PersonalTasks
            .Where(t => !t.IsDone
                        && t.ProjectId == projectId
                        && t.DueDate is DateTime d && d.Date >= today
                        && MotivaDates.ParseWallClock(t.StartTime) is not null)
            .OrderBy(t => t.DueDate!.Value.Date)
            .ThenBy(t => MotivaDates.ParseWallClock(t.StartTime)!.Value)
            .FirstOrDefault();

        if (next is null) return null;

        var at = MotivaDates.FormatWallClock(MotivaDates.ParseWallClock(next.StartTime)!.Value);
        return $"{MotivaDates.DayAndMonth(next.DueDate!.Value)} · {at} · {next.Title}";
    }

    // ── Filtering ───────────────────────────────────────────────────────────

    private IReadOnlyList<MFilterTabs.Tab> FilterTabs => new[]
    {
        new MFilterTabs.Tab(MentorProjectSignals.FilterAll, "הכל"),
        new MFilterTabs.Tab(MentorProjectSignals.FilterAttention, "דורש תשומת לב",
                            _rows.Count(r => r.Signal != MentorProjectSignal.None)),
        new MFilterTabs.Tab(MentorProjectSignals.Slug(MentorProjectSignal.Submission), "הגשה לבדיקה"),
        new MFilterTabs.Tab(MentorProjectSignals.Slug(MentorProjectSignal.Request), "בקשה פתוחה"),
        new MFilterTabs.Tab(MentorProjectSignals.FilterOk, "מתקדם כרגיל"),
    };

    private List<Row> Filtered
    {
        get
        {
            var q = _query.Trim();
            return _rows
                .Where(r => MentorProjectSignals.Matches(r.Signal, _filter))
                .Where(r => q.Length == 0
                            || r.SearchText.Contains(q, StringComparison.OrdinalIgnoreCase))
                .ToList();
        }
    }

    private void SelectFilter(string key)
    {
        _filter = MentorProjectSignals.Normalize(key);

        // A rail left open on a project the new filter hides would be a panel
        // with no row behind it.
        if (_selected is Row s && !MentorProjectSignals.Matches(s.Signal, _filter)) _selected = null;
    }

    private void ClearFilters()
    {
        _filter = MentorProjectSignals.FilterAll;
        _query  = "";
    }

    private string SubtitleText => _rows.Count switch
    {
        0 => "כאן יופיעו הפרויקטים שבהנחייתך.",
        1 => "התקדמות, הגשות ובקשות של הפרויקט שבהנחייתך.",
        _ => "התקדמות, הגשות ובקשות של הפרויקטים שבהנחייתך.",
    };

    private string CountLabel =>
        Filtered.Count == _rows.Count
            ? $"{_rows.Count} פרויקטים"
            : $"{Filtered.Count} מתוך {_rows.Count} פרויקטים";

    // ── The rail ────────────────────────────────────────────────────────────

    private void Open(Row r) => _selected = r;
    private void Close()     => _selected = null;

    private void ApplyProjectDeepLink()
    {
        if (_loading || ProjectParam is not int id) return;

        var row = _rows.FirstOrDefault(r => r.Project.Id == id);
        if (row is null) return;

        // The deep link has to bring its own tab with it, or it opens a rail
        // over a list the project is filtered out of.
        if (!MentorProjectSignals.Matches(row.Signal, _filter))
            _filter = MentorProjectSignals.FilterAll;

        _selected = row;
    }

    private static string NoteClass(MentorProjectSignal s) => s switch
    {
        MentorProjectSignal.Request => "mpj-tone-violet",
        MentorProjectSignal.None    => "mpj-tone-quiet",
        _                           => "mpj-tone-rose",
    };

    private static string RequestHref(ProjectRequestRowDto r) =>
        $"{MentorLinks.RequestsInbox}?requestId={r.Id}";

    /// <summary>The request's own title, and deliberately NOT prefixed with
    /// its type.
    ///
    /// <para>Two reasons, both observed on live rows: a team names the request
    /// after its type anyway ("בקשת דחייה להגשת Wireframes…"), so the prefix
    /// read as a stutter; and the database carries RequestType values outside
    /// the Shared constant list (e.g. "ScopeChange"), which
    /// <c>RequestTypes.Label</c> passes through verbatim — putting a raw
    /// English identifier at the head of a Hebrew line. The bucket phrase
    /// under the link already says what the mentor needs to know about it,
    /// and בקשות itself states the type.</para></summary>
    private static string RequestLabel(ProjectRequestRowDto r) => r.Title;

    /// <summary>מרחב הפרויקט — the existing per-project route, unchanged.</summary>
    private static string ProjectHref(Row r) => $"/mentor/projects/{r.Project.Id}";

    /// <summary>True when the project has something specific queued that the
    /// primary button should open instead of the project workspace.</summary>
    private static bool HasQueuedItem(Row r) =>
        (r.Signal == MentorProjectSignal.Submission && r.PendingReviews.Count > 0)
        || (r.Signal == MentorProjectSignal.Request && r.OpenRequests.Count > 0);

    private static string PrimaryHref(Row r) =>
        !HasQueuedItem(r)                             ? ProjectHref(r)
        : r.Signal == MentorProjectSignal.Submission  ? r.PendingReviews[0].Href
        :                                               RequestHref(r.OpenRequests[0]);

    private static string PrimaryLabel(Row r) =>
        !HasQueuedItem(r)                             ? "למרחב הפרויקט"
        : r.Signal == MentorProjectSignal.Submission  ? "לבדיקת ההגשה"
        :                                               "לבקשה";

    /// <summary>The secondary button never repeats the primary one: when the
    /// primary already opens the project workspace it offers the calendar
    /// instead.</summary>
    private static string SecondaryHref(Row r) =>
        HasQueuedItem(r) ? ProjectHref(r) : MentorLinks.Calendar;

    private static string SecondaryLabel(Row r) =>
        HasQueuedItem(r) ? "מרחב הפרויקט" : "יומן ותכנון";

    private static string Initials(string? text)
    {
        var parts = (text ?? "").Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 0) return "?";
        return parts.Length == 1
            ? parts[0][..1]
            : $"{parts[0][..1]}{parts[1][..1]}";
    }
}
