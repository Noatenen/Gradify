@page "/mentor/projects"
@layout AppLayout
@attribute [Authorize(Roles = Roles.Mentor + "," + Roles.Admin + "," + Roles.Staff)]
@namespace AuthWithAdmin.Client.Pages.Mentor
@using Microsoft.AspNetCore.Authorization
@using AuthWithAdmin.Client.Components
@using AuthWithAdmin.Client.Services
@using AuthWithAdmin.Shared.AuthSharedModels
@inject IMentorWorkspaceService Workspace

@*
    ── הפרויקטים שלי ───────────────────────────────────────────────────────
    UX / IA source:  design-reference/mentor-experience/project/
                     Motiva Mentor Projects.dc.html
    Visual source:   the implemented student experience.
    Data source:     GET api/mentor/projects, plus the request list from the
                     same snapshot for the per-project open-request count.

    ROWS, NOT CARDS — and this is the design's own argument, not a style
    preference: "המנחה סוקר עשרות פרויקטים במקביל ומחפש דפוסי סיכון … סדר קבוע
    של אלמנטים מאפשר סריקה אנכית מהירה". The legacy screen was a grid of large
    cards, which is the right shape when each item is considered on its own and
    the wrong one when the task is comparison. One continuous surface replaces
    it, and the status is a word plus a dot in the three permitted semantics —
    never a coloured badge.

    ORDERING IS PART OF THE DESIGN. Worst health first, then nearest deadline.
    A mentor opens this page to find the project that needs them, so the page
    must not make them hunt for it.

    KPI ROW INSTEAD OF THE DESIGN'S FILTER PILLS — a deliberate substitution.
    The design filters with four pills; this uses four MKpiCards carrying the
    same four options. Reasons: the counts are the "overview area" this screen
    otherwise lacks, the mentor sees the health distribution without reading
    the list, and it is the same filter-KPI interaction the finalized student
    Requests screen already teaches. Same vocabulary, same three colours, one
    more piece of real information.
*@

<div class="mp-header-bleed">
    <MPageHeader Variant="MPageHeader.HeaderVariant.Compact"
                 Title="הפרויקטים שלי"
                 Subtitle="@SubtitleText">
        @if (!_loading && _all.Count > 0)
        {
            <div class="mp-controls">
                <MSearchField @bind-Value="_query"
                              MaxWidth="320px"
                              Placeholder="חיפוש פרויקט, צוות או סטודנט…"
                              AriaLabel="חיפוש בפרויקטים שלי" />

                <MKpiGrid Columns="4" AriaLabel="מצב הפרויקטים ומסננים">
                    <MKpiCard Value="@_all.Count.ToString()"
                              Label="סך הפרויקטים"
                              Pressed="@(_healthFilter is null)"
                              OnClick="@(() => SetHealth(null))"
                              AriaLabel="@($"{_all.Count} פרויקטים — הצגת הכל")">
                        <Icon><MentorGlyph Kind="MentorGlyph.GlyphKind.Projects" /></Icon>
                    </MKpiCard>
                    @foreach (var h in AllHealthStates)
                    {
                        var state = h;
                        <MKpiCard Accent="@MentorHealthStates.Accent(state)"
                                  Value="@CountOf(state).ToString()"
                                  Label="@MentorHealthStates.CountLabel(state)"
                                  Pressed="@(_healthFilter == state)"
                                  OnClick="@(() => SetHealth(state))"
                                  AriaLabel="@($"{CountOf(state)} פרויקטים {MentorHealthStates.CountLabel(state)} — סינון")">
                            <Icon><MentorGlyph Kind="@MentorGlyph.For(state)" /></Icon>
                        </MKpiCard>
                    }
                </MKpiGrid>
            </div>
        }
    </MPageHeader>
</div>

<div class="mp-body">

    @if (_loading)
    {
        <div class="mp-state" role="status" aria-live="polite">
            <span class="mp-spinner" aria-hidden="true"></span>
            <span>טוענת פרויקטים…</span>
        </div>
    }
    else if (_all.Count == 0)
    {
        <MEmptyState Title="לא משויכים אליך פרויקטים כרגע"
                     Description="כשתשויך/י להנחיית צוות, הפרויקט שלו יופיע כאן." />
    }
    else
    {
        <MCard Variant="MCard.CardVariant.AmbientEdge" Padding="MCard.CardPadding.None">
            @if (Filtered.Count == 0)
            {
                <MEmptyState Title="אין פרויקטים תואמים לסינון."
                             Description="אפשר לנקות את החיפוש או לבחור מצב אחר."
                             Class="mp-empty">
                    <Action>
                        <MButton Variant="MButton.ButtonVariant.Secondary" OnClick="ClearFilters">
                            ניקוי הסינון
                        </MButton>
                    </Action>
                </MEmptyState>
            }
            else
            {
                <MRowList Inset="true" AriaLabel="הפרויקטים שלי">
                    @foreach (var p in Filtered)
                    {
                        var health = MentorHealthStates.Of(p.HealthStatus);
                        <MRow Href="@($"/mentor/projects/{p.Id}")"
                              AriaLabel="@($"פתיחת מרחב הפרויקט {p.Title}")">
                            <Leading>
                                <span class="mp-avatar" aria-hidden="true">@Initials(p.Title)</span>
                            </Leading>

                            <PrimaryContent>
                                <span class="mp-title">@p.Title</span>
                                @if (!string.IsNullOrWhiteSpace(p.TeamName))
                                {
                                    <span class="mp-team">— @p.TeamName</span>
                                }
                            </PrimaryContent>

                            <SecondaryContent>
                                <span class="mp-meta">@MilestoneLine(p)</span>
                                @if (SignalLine(p) is { Length: > 0 } signals)
                                {
                                    <span class="mp-signals">@signals</span>
                                }
                            </SecondaryContent>

                            <Status>
                                <div class="mp-status">
                                    <MStatusDot Tone="@MentorHealthStates.Tone(health)"
                                                Label="@MentorHealthStates.Label(health)" />
                                    @if (p.MilestoneProgressPct > 0)
                                    {
                                        <div class="mp-progress">
                                            @* MProgressBar names its screen-reader label
                                               AccessibleLabel, not AriaLabel — it is not a
                                               passthrough attribute. *@
                                            <MProgressBar Value="@p.MilestoneProgressPct"
                                                          Size="MProgressBar.ProgressSize.Small"
                                                          AccessibleLabel="@($"התקדמות אבן הדרך: {p.MilestoneProgressPct}%")" />
                                        </div>
                                    }
                                </div>
                            </Status>
                        </MRow>
                    }
                </MRowList>
            }
        </MCard>
    }
</div>

@code {
    private MentorWorkspace _ws = MentorWorkspace.Empty;
    private List<MentorProjectSummaryDto> _all = new();
    private bool _loading = true;

    private string _query = "";
    private MentorHealth? _healthFilter;

    private static readonly MentorHealth[] AllHealthStates =
        { MentorHealth.OnTrack, MentorHealth.Attention, MentorHealth.AtRisk };

    protected override async Task OnInitializedAsync()
    {
        _ws = await Workspace.LoadAsync();

        // Worst first, then soonest deadline — see the file header.
        _all = _ws.Projects
                  .OrderBy(p => MentorHealthStates.Severity(MentorHealthStates.Of(p.HealthStatus)))
                  .ThenBy(p => p.CurrentMilestoneDueDate ?? DateTime.MaxValue)
                  .ToList();

        _loading = false;
    }

    private string SubtitleText => _all.Count switch
    {
        0 => "כאן יופיעו הצוותים שבהנחייתך.",
        1 => "פרויקט אחד בהנחייתך — לפי דחיפות.",
        _ => $"{_all.Count} פרויקטים בהנחייתך — מסודרים לפי דחיפות.",
    };

    private int CountOf(MentorHealth h) =>
        _all.Count(p => MentorHealthStates.Of(p.HealthStatus) == h);

    private void SetHealth(MentorHealth? h) => _healthFilter = h;

    private void ClearFilters()
    {
        _healthFilter = null;
        _query = "";
    }

    /// <summary>Search covers the three things a mentor actually recalls a
    /// project by: its name, its team, and the students on it.</summary>
    private List<MentorProjectSummaryDto> Filtered
    {
        get
        {
            var q = _query.Trim();
            return _all
                .Where(p => _healthFilter is null
                            || MentorHealthStates.Of(p.HealthStatus) == _healthFilter)
                .Where(p => q.Length == 0
                            || (p.Title ?? "").Contains(q, StringComparison.OrdinalIgnoreCase)
                            || (p.TeamName ?? "").Contains(q, StringComparison.OrdinalIgnoreCase)
                            || (p.StudentNames ?? "").Contains(q, StringComparison.OrdinalIgnoreCase))
                .ToList();
        }
    }

    /// <summary>Line two: where the team is in the process.</summary>
    private static string MilestoneLine(MentorProjectSummaryDto p)
    {
        var parts = new List<string>();

        parts.Add(string.IsNullOrWhiteSpace(p.CurrentMilestoneTitle)
            ? "אין אבן דרך פעילה"
            : $"אבן דרך: {p.CurrentMilestoneTitle}");

        var deadline = MentorTime.DeadlineLabel(p.CurrentMilestoneDueDate);
        if (deadline is not null) parts.Add(deadline);

        if (p.StudentCount > 0)
            parts.Add(p.StudentCount == 1 ? "סטודנט אחד" : $"{p.StudentCount} סטודנטים");

        return string.Join(" · ", parts);
    }

    /// <summary>
    /// Line three: what is queued on this project right now.
    ///
    /// <para>The design's third line reads "פעילות אחרונה: … · פעולה נדרשת: …
    /// · בעלים כרגע: …". None of those three has a backing field — there is no
    /// last-activity timestamp, no next-action string and no current-owner
    /// column on a project — so this line carries the real counts instead of
    /// inventing them, and renders nothing at all when there is nothing
    /// queued.</para>
    /// </summary>
    private string SignalLine(MentorProjectSummaryDto p)
    {
        var signals = new List<string>();
        if (p.PendingMentorReview > 0) signals.Add($"{p.PendingMentorReview} הגשות לבדיקתך");
        if (p.OverdueTasks > 0)        signals.Add($"{p.OverdueTasks} משימות באיחור");

        var open = _ws.OpenRequestsFor(p.Id);
        if (open > 0) signals.Add($"{open} בקשות פתוחות");

        return string.Join(" · ", signals);
    }

    private static string Initials(string? text)
    {
        var t = (text ?? "").Trim();
        return t.Length == 0 ? "?" : t.Length == 1 ? t : t[..2];
    }
}
