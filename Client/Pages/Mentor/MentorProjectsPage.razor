@page "/mentor/projects"
@layout AppLayout
@attribute [Authorize(Roles = Roles.Mentor + "," + Roles.Admin + "," + Roles.Staff)]
@namespace AuthWithAdmin.Client.Pages.Mentor
@using Microsoft.AspNetCore.Authorization
@using AuthWithAdmin.Client.Components
@using AuthWithAdmin.Client.Services
@using AuthWithAdmin.Shared.AuthSharedModels
@inject IMentorWorkspaceService Workspace
@inject IRoadmapStagesService Roadmap

@*
    ── פרויקטים בהנחייתי ────────────────────────────────────────────────────
    VISUAL SOURCE OF TRUTH:  Motiva Mentor Teams.dc.html (Claude Design).
                             The title row, the pill filter track, the single
                             translucent list card, the five-column row and the
                             380px detail rail are all that file's.
    Data sources:            GET api/mentor/projects — already scoped by
                             ProjectMentors, i.e. the projects this mentor is
                             actually assigned to supervise — plus the shared
                             mentor snapshot (attention, requests, personal
                             tasks) and GET api/roadmap-stages/mentor/
                             projects-progress for the stage and the next
                             milestone.

    THE NAME IS THE SEMANTICS. The reference titles this screen "הצוותים שלי"
    and the previous implementation called it "הפרויקטים שלי". Both read as
    ownership; the list is neither. It is the set of projects where this user
    sits in ProjectMentors — the ones they SUPERVISE — so the screen, the nav
    item and every link into it now say פרויקטים בהנחייתי. Nothing about the
    query changed: that scoping was already the server's, and no demo team is
    ever rendered.

    FILTERING BY ATTENTION, NOT BY HEALTH — the one substantive departure from
    the screen this replaces, and it is a data fact rather than a taste.
    Projects.HealthStatus is never written by this application (the mentor Home
    card stopped reading it for exactly this reason), so the four KPI cards that
    used to be the filter put every project in במסלול and left the other two
    permanently empty. The reference filters by what is waiting on the mentor,
    and every one of those states is read off a column the product maintains: a
    milestone due date, the pending mentor-review count, and the project's open
    requests. See MentorProjectSignal.

    FIVE TABS, AND NO "באיחור" TAB. The reference's own filter set is
    הכל · דורש תשומת לב · הגשה לבדיקה · בקשה פתוחה · מתקדם כרגיל. A late
    milestone is a signal without a tab of its own; it is counted by, and
    reachable through, דורש תשומת לב. Kept as drawn rather than "improved",
    since the brief makes the file the source of truth for the control set.

    ORDERING IS PART OF THE DESIGN: worst signal first, then nearest deadline.
    A mentor opens this screen to find the project that needs them.

    THE ROW OPENS THE DRAWER, NOT THE PROJECT. The reference's compact rail is
    the summary; מרחב הפרויקט (/mentor/projects/{id}) is one button inside it,
    unchanged, along with the real routes to the submission review, the request
    thread and the calendar.
*@

<div class="mpj-header-bleed">
    <MPageHeader Variant="MPageHeader.HeaderVariant.Compact"
                 Title="פרויקטים בהנחייתי"
                 Subtitle="@SubtitleText"
                 Class="mpj-header">
        <Actions>
            @if (!_loading && _rows.Count > 0)
            {
                <MSearchField @bind-Value="_query"
                              MaxWidth="260px"
                              Placeholder="חיפוש פרויקט או צוות…"
                              AriaLabel="חיפוש בפרויקטים בהנחייתי"
                              Class="mpj-search" />
            }
        </Actions>
    </MPageHeader>
</div>

<div class="mpj-body">

    @if (_loading)
    {
        <MLoadingState Label="טוענת פרויקטים…" />
    }
    else if (_rows.Count == 0)
    {
        <MEmptyState Title="לא משויכים אליך פרויקטים כרגע"
                     Description="כשתשויך/י להנחיית צוות, הפרויקט שלו יופיע כאן." />
    }
    else
    {
        <MCard Padding="MCard.CardPadding.None">
            <div class="mpj-card">

                <div class="mpj-controls">
                    <MFilterTabs Tabs="@FilterTabs"
                                 ActiveKey="@_filter"
                                 OnSelect="SelectFilter"
                                 AriaLabel="סינון פרויקטים לפי מצב" />
                    <span class="mpj-count">@CountLabel</span>
                </div>

                @if (Filtered.Count == 0)
                {
                    <p class="mpj-empty">
                        לא נמצאו פרויקטים תואמים ·
                        <button type="button" class="mpj-clear" @onclick="ClearFilters">ניקוי חיפוש וסינון</button>
                    </p>
                }
                else
                {
                    <MRowList AriaLabel="פרויקטים בהנחייתי" Class="mpj-rows">
                        @foreach (var row in Filtered)
                        {
                            var r = row;

                            <MRow OnClick="@(() => Open(r))"
                                  Class="mpj-row"
                                  Selected="@(_selected?.Project.Id == r.Project.Id)"
                                  AriaLabel="@($"פתיחת פרטי {r.TeamLabel} — {MentorProjectSignals.Label(r.Signal)}")">
                                <Leading>
                                    <MStatusDot Tone="@MentorProjectSignals.Tone(r.Signal)"
                                                AriaLabel="@MentorProjectSignals.Label(r.Signal)" />
                                </Leading>

                                <ChildContent>
                                    <span class="mpj-id">
                                        <span class="mpj-name">@r.TeamLabel</span>
                                        <span class="mpj-project">@r.ProjectLabel</span>
                                    </span>

                                    <span class="mpj-stage-cell">
                                        <span class="mpj-stage">@r.Stage</span>
                                    </span>

                                    <span class="mpj-milestone" title="@r.Milestone">@r.Milestone</span>

                                    <span class="mpj-note @NoteClass(r.Signal)" title="@r.Note">@r.Note</span>
                                </ChildContent>

                                <Trailing>
                                    <span class="mpj-chevron" aria-hidden="true">
                                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                             stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M15 6l-6 6 6 6"></path>
                                        </svg>
                                    </span>
                                </Trailing>
                            </MRow>
                        }
                    </MRowList>
                }
            </div>
        </MCard>
    }
</div>

@*  ── Quick View ───────────────────────────────────────────────────────────
    The shared panel, not this page's own markup any more. Every other mentor
    overview — בית, המשימות שלי, מרחב הפרויקט — now opens the SAME component
    over the SAME facts, which is what stops a team reading one way here and
    another way there. See MentorProjectQuickView. *@
<MentorProjectQuickView Card="@_selected" OnClose="Close" />

@code {
    /// <summary>?filter= — one of the tab keys. Written by
    /// <see cref="MentorLinks.Projects(MentorProjectSignal?)"/> and normalised
    /// through the same vocabulary, so an unknown value shows everything rather
    /// than blanking the list.</summary>
    [SupplyParameterFromQuery(Name = "filter")]
    public string? FilterParam { get; set; }

    /// <summary>?project= — opens that project's rail straight away. The
    /// reference's own <c>?team=</c> deep link, keyed by the real project id.</summary>
    [SupplyParameterFromQuery(Name = "project")]
    public int? ProjectParam { get; set; }

    /// <summary>The query values already applied. Re-applying only on a CHANGE
    /// is what lets the tabs stay a live filter: picking one must not be undone
    /// by the next render, and arriving with a new ?filter= must not be ignored
    /// because the component was reused.</summary>
    private string? _appliedFilterParam;
    private int?    _appliedProjectParam;

    private MentorWorkspace _ws = MentorWorkspace.Empty;
    private List<MentorProjectCard> _rows = new();
    private bool _loading = true;

    private string _query  = "";
    private string _filter = MentorProjectSignals.FilterAll;
    private MentorProjectCard? _selected;

    protected override void OnParametersSet()
    {
        if (FilterParam != _appliedFilterParam)
        {
            _appliedFilterParam = FilterParam;
            _filter = MentorProjectSignals.Normalize(FilterParam);
        }

        if (ProjectParam != _appliedProjectParam)
        {
            _appliedProjectParam = ProjectParam;
            ApplyProjectDeepLink();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        // Two independent round-trips, concurrently: the snapshot the whole
        // mentor experience shares, and the roadmap progress that owns the
        // stage and the next milestone. Sequential awaits here would make the
        // page cost the sum rather than the slower of the two.
        var snapshotTask = Workspace.LoadAsync();
        var roadmapTask  = Roadmap.GetMentorProjectsProgressAsync();
        await Task.WhenAll(snapshotTask, roadmapTask);

        _ws = await snapshotTask;

        // Null means the roadmap call failed or the mentor's cycle has no
        // stages configured. Every field it feeds has a fallback from the
        // project summary, so the page degrades to slightly less precise
        // wording instead of to an error.
        var roadmap = (await roadmapTask ?? new List<MentorRoadmapEntryDto>())
            .GroupBy(e => e.ProjectId)
            .ToDictionary(g => g.Key, g => g.First().Progress);

        _rows = _ws.Projects
                   .Select(p => MentorProjectCard.Build(_ws, p, roadmap.GetValueOrDefault(p.Id)))
                   .OrderBy(r => MentorProjectSignals.Priority(r.Signal))
                   .ThenBy(r => r.NextDue ?? DateTime.MaxValue)
                   .ToList();

        _loading = false;
        ApplyProjectDeepLink();
    }

    // ── Filtering ───────────────────────────────────────────────────────────

    private IReadOnlyList<MFilterTabs.Tab> FilterTabs => new[]
    {
        new MFilterTabs.Tab(MentorProjectSignals.FilterAll, "הכל"),
        new MFilterTabs.Tab(MentorProjectSignals.FilterAttention, "דורש תשומת לב",
                            _rows.Count(r => r.Signal != MentorProjectSignal.None)),
        new MFilterTabs.Tab(MentorProjectSignals.Slug(MentorProjectSignal.Submission), "הגשה לבדיקה"),
        new MFilterTabs.Tab(MentorProjectSignals.Slug(MentorProjectSignal.Request), "בקשה פתוחה"),
        new MFilterTabs.Tab(MentorProjectSignals.FilterOk, "מתקדם כרגיל"),
    };

    private List<MentorProjectCard> Filtered
    {
        get
        {
            var q = _query.Trim();
            return _rows
                .Where(r => MentorProjectSignals.Matches(r.Signal, _filter))
                .Where(r => q.Length == 0
                            || r.SearchText.Contains(q, StringComparison.OrdinalIgnoreCase))
                .ToList();
        }
    }

    private void SelectFilter(string key)
    {
        _filter = MentorProjectSignals.Normalize(key);

        // A rail left open on a project the new filter hides would be a panel
        // with no row behind it.
        if (_selected is MentorProjectCard s && !MentorProjectSignals.Matches(s.Signal, _filter)) _selected = null;
    }

    private void ClearFilters()
    {
        _filter = MentorProjectSignals.FilterAll;
        _query  = "";
    }

    private string SubtitleText => _rows.Count switch
    {
        0 => "כאן יופיעו הפרויקטים שבהנחייתך.",
        1 => "התקדמות, הגשות ובקשות של הפרויקט שבהנחייתך.",
        _ => "התקדמות, הגשות ובקשות של הפרויקטים שבהנחייתך.",
    };

    private string CountLabel =>
        Filtered.Count == _rows.Count
            ? $"{_rows.Count} פרויקטים"
            : $"{Filtered.Count} מתוך {_rows.Count} פרויקטים";

    // ── The rail ────────────────────────────────────────────────────────────

    private void Open(MentorProjectCard r) => _selected = r;
    private void Close()     => _selected = null;

    private void ApplyProjectDeepLink()
    {
        if (_loading || ProjectParam is not int id) return;

        var row = _rows.FirstOrDefault(r => r.Project.Id == id);
        if (row is null) return;

        // The deep link has to bring its own tab with it, or it opens a rail
        // over a list the project is filtered out of.
        if (!MentorProjectSignals.Matches(row.Signal, _filter))
            _filter = MentorProjectSignals.FilterAll;

        _selected = row;
    }

    private static string NoteClass(MentorProjectSignal s) => s switch
    {
        MentorProjectSignal.Request => "mpj-tone-violet",
        MentorProjectSignal.None    => "mpj-tone-quiet",
        _                           => "mpj-tone-rose",
    };
}
