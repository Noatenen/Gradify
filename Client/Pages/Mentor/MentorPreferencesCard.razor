@using AuthWithAdmin.Client.Services
@using AuthWithAdmin.Shared.AuthSharedModels
@inject IMentorPreferencesService MentorPrefs

@*
    Mentor Preferences card — embedded on /settings.

    The chrome (spp-card / spp-card-header / spp-card-title / spp-card-subtitle
    / spp-fields / spp-field / spp-btn-edit / spp-btn-save / spp-btn-ghost) is
    reused verbatim from the host page so this card matches Personal Details
    and Notification Preferences exactly. The only component-scoped classes
    (mp-*) are form-internal layout primitives used inside edit mode.

    States:
      • view (default) — read-only summary using spp-fields rows.
      • view + empty   — single muted paragraph + small CTA.
      • edit           — full structured form, with spp-btn-save/ghost actions.
*@

<div class="spp-card motiva-panel">

    <div class="spp-card-header">
        <div class="spp-card-title">
            <span class="oi oi-people" aria-hidden="true"></span>
            העדפות מנחה
        </div>
        @if (!_loading && !_loadError && _model is not null && !_editing && !IsEmpty)
        {
            <button class="spp-btn-edit" @onclick="StartEdit">
                <span class="oi oi-pencil" aria-hidden="true"></span>
                עריכה
            </button>
        }
    </div>
    <p class="spp-card-subtitle">יישור ציפיות מול הסטודנטים והמרצים</p>

    @if (_loading)
    {
        <div class="spp-loading-row">
            <span class="spp-spinner-sm"></span> טוען…
        </div>
    }
    else if (_loadError || _model is null)
    {
        <p class="spp-inline-error">שגיאה בטעינת ההעדפות. נסה לרענן את הדף.</p>
    }
    else if (!_editing)
    {
        @* ── VIEW MODE ─────────────────────────────────────────────── *@
        @if (IsEmpty)
        {
            <div class="spp-fields">
                <div class="spp-field spp-field-edit">
                    <span class="spp-field-label">העדפות מנחה</span>
                    <div class="spp-field-edit-row">
                        <span class="spp-field-val">—</span>
                        <button class="spp-btn-edit" @onclick="StartEdit">
                            <span class="oi oi-pencil" aria-hidden="true"></span>
                            הגדרת העדפות מנחה
                        </button>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="spp-fields">
                @if (Has(_model.RoleDescription))
                {
                    <div class="spp-field"><span class="spp-field-label">תיאור התפקיד</span>
                        <span class="spp-field-val">@_model.RoleDescription</span></div>
                }
                @if (Has(_model.InvolvementLevel))
                {
                    <div class="spp-field"><span class="spp-field-label">רמת מעורבות</span>
                        <span class="spp-field-val">@MentorInvolvementLevels.Label(_model.InvolvementLevel!)</span></div>
                }
                @if (Has(_model.PreferredChannel))
                {
                    <div class="spp-field"><span class="spp-field-label">ערוץ מועדף</span>
                        <span class="spp-field-val">@ChannelLine()</span></div>
                }
                @if (Has(_model.ExpectedResponseTime))
                {
                    <div class="spp-field"><span class="spp-field-label">זמן מענה</span>
                        <span class="spp-field-val">@MentorResponseTimes.Label(_model.ExpectedResponseTime!)</span></div>
                }
                @if (Has(_model.CommunicationFrequency))
                {
                    <div class="spp-field"><span class="spp-field-label">תדירות תקשורת</span>
                        <span class="spp-field-val">@MentorCommunicationFrequencies.Label(_model.CommunicationFrequency!)</span></div>
                }
                <div class="spp-field"><span class="spp-field-label">עדכונים תקופתיים</span>
                    <span class="spp-field-val">@(_model.RequirePeriodicUpdates ? "כן" : "לא")</span></div>
                @if (_model.RequirePeriodicUpdates && Has(_model.UpdateFrequency))
                {
                    <div class="spp-field"><span class="spp-field-label">תדירות עדכון</span>
                        <span class="spp-field-val">@(_model.UpdateFrequency == "weekly" ? "שבועית" : "דו־שבועית")</span></div>
                }
                @if (_model.RequirePeriodicUpdates && _model.UpdateContent.Count > 0)
                {
                    <div class="spp-field"><span class="spp-field-label">תוכן העדכון</span>
                        <span class="spp-field-val">@JoinLabels(_model.UpdateContent, MentorUpdateContentTokens.Label)</span></div>
                }
                @if (Has(_model.ClientInteractionFrequency))
                {
                    <div class="spp-field"><span class="spp-field-label">תדירות מול לקוח</span>
                        <span class="spp-field-val">@ClientFreqLine()</span></div>
                }
                @if (Has(_model.MentorInClientInteraction))
                {
                    <div class="spp-field"><span class="spp-field-label">מעורבות מנחה בלקוח</span>
                        <span class="spp-field-val">@MentorClientInvolvementOptions.Label(_model.MentorInClientInteraction!)</span></div>
                }
                @if (Has(_model.SubmissionLeadTime))
                {
                    <div class="spp-field"><span class="spp-field-label">הקדמה לפני הגשה</span>
                        <span class="spp-field-val">@LeadTimeLine()</span></div>
                }
                @if (_model.ReviewIterations is int ri)
                {
                    <div class="spp-field"><span class="spp-field-label">מספר איטרציות</span>
                        <span class="spp-field-val">@(ri == 3 ? "3+" : ri.ToString())</span></div>
                }
                @if (Has(_model.FeedbackType))
                {
                    <div class="spp-field"><span class="spp-field-label">סוג משוב</span>
                        <span class="spp-field-val">@MentorFeedbackTypes.Label(_model.FeedbackType!)</span></div>
                }
                @if (_model.DecisionInvolvement.Count > 0)
                {
                    <div class="spp-field"><span class="spp-field-label">מעורבות בהחלטות</span>
                        <span class="spp-field-val">@JoinLabels(_model.DecisionInvolvement, MentorDecisionInvolvementTokens.Label)</span></div>
                }
                @if (Has(_model.QualityDescription))
                {
                    <div class="spp-field"><span class="spp-field-label">ציפיות איכות</span>
                        <span class="spp-field-val">@_model.QualityDescription</span></div>
                }
                @if (_model.QualityFocusAreas.Count > 0)
                {
                    <div class="spp-field"><span class="spp-field-label">תחומי דגש</span>
                        <span class="spp-field-val">@JoinLabels(_model.QualityFocusAreas, MentorQualityFocusTokens.Label)</span></div>
                }
                @if (Has(_model.RedLines))
                {
                    <div class="spp-field"><span class="spp-field-label">קווים אדומים</span>
                        <span class="spp-field-val">@_model.RedLines</span></div>
                }
                @if (Has(_model.AvailableTimes))
                {
                    <div class="spp-field"><span class="spp-field-label">שעות זמינות</span>
                        <span class="spp-field-val">@_model.AvailableTimes</span></div>
                }
                @if (Has(_model.MeetingFormat))
                {
                    <div class="spp-field"><span class="spp-field-label">פורמט פגישה</span>
                        <span class="spp-field-val">@MentorMeetingFormats.Label(_model.MeetingFormat!)</span></div>
                }
                @if (Has(_model.SchedulingMethod))
                {
                    <div class="spp-field"><span class="spp-field-label">תיאום פגישות</span>
                        <span class="spp-field-val">@MentorSchedulingMethods.Label(_model.SchedulingMethod!)</span></div>
                }
                @if (_model.PreferenceEvents.Count > 0)
                {
                    <div class="spp-field"><span class="spp-field-label">אירועים בסיכום</span>
                        <span class="spp-field-val">@JoinLabels(_model.PreferenceEvents, MentorEventTokens.Label)</span></div>
                }
                @if (Has(_model.PreferenceFrequency))
                {
                    <div class="spp-field"><span class="spp-field-label">תדירות סיכום</span>
                        <span class="spp-field-val">@MentorDigestFrequencies.Label(_model.PreferenceFrequency!)</span></div>
                }
            </div>

            @if (!string.IsNullOrEmpty(_saveOk))
            {
                <p class="spp-inline-success">
                    <span class="oi oi-circle-check" aria-hidden="true"></span>
                    @_saveOk
                </p>
            }
        }
    }
    else
    {
        @* ── EDIT MODE — full structured form ────────────────────── *@
        <div class="mp-sections">

            @* 1. Mentorship style *@
            <section class="mp-section">
                <h4 class="mp-section-title">סגנון הנחיה</h4>
                <label class="mp-label">תיאור התפקיד</label>
                <textarea class="mp-textarea" rows="2" maxlength="2000"
                          placeholder="כמה משפטים שמסבירים איך אתה רואה את תפקידך…"
                          @bind="_model.RoleDescription"></textarea>

                <label class="mp-label">רמת מעורבות</label>
                <div class="mp-radio-row">
                    @foreach (var v in new[] { MentorInvolvementLevels.Low, MentorInvolvementLevels.Medium, MentorInvolvementLevels.High })
                    {
                        <label class="mp-radio">
                            <input type="radio" name="mp-involvement"
                                   value="@v"
                                   checked="@(_model.InvolvementLevel == v)"
                                   @onchange="() => _model.InvolvementLevel = v" />
                            <span>@MentorInvolvementLevels.Label(v)</span>
                        </label>
                    }
                </div>
            </section>

            @* 2. Communication preferences *@
            <section class="mp-section">
                <h4 class="mp-section-title">העדפות תקשורת</h4>

                <label class="mp-label">ערוץ מועדף</label>
                <div class="mp-radio-row">
                    @foreach (var v in new[] { MentorChannels.Email, MentorChannels.WhatsApp, MentorChannels.Slack, MentorChannels.Other })
                    {
                        <label class="mp-radio">
                            <input type="radio" name="mp-channel"
                                   value="@v"
                                   checked="@(_model.PreferredChannel == v)"
                                   @onchange="() => _model.PreferredChannel = v" />
                            <span>@MentorChannels.Label(v)</span>
                        </label>
                    }
                </div>
                @if (_model.PreferredChannel == MentorChannels.Other)
                {
                    <input class="mp-input"
                           type="text"
                           maxlength="200"
                           placeholder="פרט ערוץ אחר"
                           @bind="_model.PreferredChannelOther" />
                }

                <label class="mp-label">זמן מענה צפוי</label>
                <div class="mp-radio-row">
                    @foreach (var v in new[] { MentorResponseTimes.TwentyFourHours, MentorResponseTimes.OneToThreeDays, MentorResponseTimes.Week })
                    {
                        <label class="mp-radio">
                            <input type="radio" name="mp-response-time"
                                   value="@v"
                                   checked="@(_model.ExpectedResponseTime == v)"
                                   @onchange="() => _model.ExpectedResponseTime = v" />
                            <span>@MentorResponseTimes.Label(v)</span>
                        </label>
                    }
                </div>

                <label class="mp-label">תדירות תקשורת</label>
                <div class="mp-radio-row">
                    @foreach (var v in new[] { MentorCommunicationFrequencies.Weekly, MentorCommunicationFrequencies.Biweekly, MentorCommunicationFrequencies.AsNeeded })
                    {
                        <label class="mp-radio">
                            <input type="radio" name="mp-comm-freq"
                                   value="@v"
                                   checked="@(_model.CommunicationFrequency == v)"
                                   @onchange="() => _model.CommunicationFrequency = v" />
                            <span>@MentorCommunicationFrequencies.Label(v)</span>
                        </label>
                    }
                </div>
            </section>

            @* 3. Student updates *@
            <section class="mp-section">
                <h4 class="mp-section-title">עדכוני סטודנט</h4>

                <label class="mp-checkbox">
                    <input type="checkbox" @bind="_model.RequirePeriodicUpdates" />
                    <span>אני דורש עדכונים תקופתיים</span>
                </label>

                @if (_model.RequirePeriodicUpdates)
                {
                    <label class="mp-label">תדירות העדכון</label>
                    <div class="mp-radio-row">
                        @foreach (var v in new[] { "weekly", "biweekly" })
                        {
                            <label class="mp-radio">
                                <input type="radio" name="mp-update-freq"
                                       value="@v"
                                       checked="@(_model.UpdateFrequency == v)"
                                       @onchange="() => _model.UpdateFrequency = v" />
                                <span>@(v == "weekly" ? "שבועית" : "דו־שבועית")</span>
                            </label>
                        }
                    </div>

                    <label class="mp-label">תוכן העדכון</label>
                    <div class="mp-radio-row">
                        @foreach (var v in new[] { MentorUpdateContentTokens.Progress, MentorUpdateContentTokens.Plans, MentorUpdateContentTokens.Blockers })
                        {
                            <label class="mp-checkbox">
                                <input type="checkbox"
                                       checked="@_model.UpdateContent.Contains(v)"
                                       @onchange="@(e => ToggleToken(_model.UpdateContent, v, e))" />
                                <span>@MentorUpdateContentTokens.Label(v)</span>
                            </label>
                        }
                    </div>
                }
            </section>

            @* 4. Client interaction *@
            <section class="mp-section">
                <h4 class="mp-section-title">אינטראקציה עם לקוח</h4>

                <label class="mp-label">תדירות פגישות לקוח</label>
                <div class="mp-radio-row">
                    @foreach (var v in new[] { "monthly", "biweekly", "custom" })
                    {
                        <label class="mp-radio">
                            <input type="radio" name="mp-client-freq"
                                   value="@v"
                                   checked="@(_model.ClientInteractionFrequency == v)"
                                   @onchange="() => _model.ClientInteractionFrequency = v" />
                            <span>@(v == "monthly" ? "חודשית" : v == "biweekly" ? "דו־שבועית" : "מותאם אישית")</span>
                        </label>
                    }
                </div>
                @if (_model.ClientInteractionFrequency == "custom")
                {
                    <input class="mp-input"
                           type="text"
                           maxlength="200"
                           placeholder="פרט תדירות מותאמת"
                           @bind="_model.ClientInteractionFrequencyCustom" />
                }

                <label class="mp-label">מעורבות מנחה בפגישות לקוח</label>
                <div class="mp-radio-row">
                    @foreach (var v in new[] { MentorClientInvolvementOptions.Yes, MentorClientInvolvementOptions.No, MentorClientInvolvementOptions.KeyMilestones })
                    {
                        <label class="mp-radio">
                            <input type="radio" name="mp-client-involve"
                                   value="@v"
                                   checked="@(_model.MentorInClientInteraction == v)"
                                   @onchange="() => _model.MentorInClientInteraction = v" />
                            <span>@MentorClientInvolvementOptions.Label(v)</span>
                        </label>
                    }
                </div>
            </section>

            @* 5. Submission & feedback *@
            <section class="mp-section">
                <h4 class="mp-section-title">הגשה ומשוב</h4>

                <label class="mp-label">זמן הקדמה הנדרש לפני הגשה</label>
                <div class="mp-radio-row">
                    @foreach (var v in new[] { "2d", "3to5d", "custom" })
                    {
                        <label class="mp-radio">
                            <input type="radio" name="mp-lead-time"
                                   value="@v"
                                   checked="@(_model.SubmissionLeadTime == v)"
                                   @onchange="() => _model.SubmissionLeadTime = v" />
                            <span>@(v == "2d" ? "יומיים" : v == "3to5d" ? "3–5 ימים" : "מותאם אישית")</span>
                        </label>
                    }
                </div>
                @if (_model.SubmissionLeadTime == "custom")
                {
                    <input class="mp-input"
                           type="text"
                           maxlength="200"
                           placeholder="פרט זמן הקדמה אחר"
                           @bind="_model.SubmissionLeadTimeCustom" />
                }

                <label class="mp-label">מספר איטרציות משוב</label>
                <div class="mp-radio-row">
                    @foreach (var v in new[] { 1, 2, 3 })
                    {
                        <label class="mp-radio">
                            <input type="radio" name="mp-iter"
                                   value="@v"
                                   checked="@(_model.ReviewIterations == v)"
                                   @onchange="() => _model.ReviewIterations = v" />
                            <span>@(v == 3 ? "3+" : v.ToString())</span>
                        </label>
                    }
                </div>

                <label class="mp-label">סוג משוב</label>
                <div class="mp-radio-row">
                    @foreach (var v in new[] { MentorFeedbackTypes.Written, MentorFeedbackTypes.Verbal, MentorFeedbackTypes.Both })
                    {
                        <label class="mp-radio">
                            <input type="radio" name="mp-feedback-type"
                                   value="@v"
                                   checked="@(_model.FeedbackType == v)"
                                   @onchange="() => _model.FeedbackType = v" />
                            <span>@MentorFeedbackTypes.Label(v)</span>
                        </label>
                    }
                </div>
            </section>

            @* 6. Decision involvement *@
            <section class="mp-section">
                <h4 class="mp-section-title">מעורבות בקבלת החלטות</h4>
                <label class="mp-label">מתי להיות מעורב</label>
                <div class="mp-radio-row">
                    @foreach (var v in new[] { MentorDecisionInvolvementTokens.Major, MentorDecisionInvolvementTokens.Milestones, MentorDecisionInvolvementTokens.Ongoing })
                    {
                        <label class="mp-checkbox">
                            <input type="checkbox"
                                   checked="@_model.DecisionInvolvement.Contains(v)"
                                   @onchange="@(e => ToggleToken(_model.DecisionInvolvement, v, e))" />
                            <span>@MentorDecisionInvolvementTokens.Label(v)</span>
                        </label>
                    }
                </div>
            </section>

            @* 7. Quality expectations *@
            <section class="mp-section">
                <h4 class="mp-section-title">ציפיות איכות</h4>
                <label class="mp-label">תיאור</label>
                <textarea class="mp-textarea" rows="2" maxlength="2000"
                          placeholder="מה חשוב לך בעבודה של הסטודנטים…"
                          @bind="_model.QualityDescription"></textarea>

                <label class="mp-label">תחומי דגש</label>
                <div class="mp-radio-row">
                    @foreach (var v in new[] { MentorQualityFocusTokens.UX, MentorQualityFocusTokens.Technical, MentorQualityFocusTokens.Pedagogical, MentorQualityFocusTokens.Research })
                    {
                        <label class="mp-checkbox">
                            <input type="checkbox"
                                   checked="@_model.QualityFocusAreas.Contains(v)"
                                   @onchange="@(e => ToggleToken(_model.QualityFocusAreas, v, e))" />
                            <span>@MentorQualityFocusTokens.Label(v)</span>
                        </label>
                    }
                </div>
            </section>

            @* 8. Red lines *@
            <section class="mp-section">
                <h4 class="mp-section-title">קווים אדומים</h4>
                <textarea class="mp-textarea" rows="3" maxlength="2000"
                          placeholder="כללים לא־פתוחים למשא ומתן (למשל גניבת מקור, אי־השתתפות במפגשים)…"
                          @bind="_model.RedLines"></textarea>
            </section>

            @* 9. Availability *@
            <section class="mp-section">
                <h4 class="mp-section-title">זמינות</h4>

                <label class="mp-label">שעות זמינות</label>
                <input class="mp-input"
                       type="text"
                       maxlength="200"
                       placeholder="לדוגמה: ימים א/ג 16:00–19:00"
                       @bind="_model.AvailableTimes" />

                <label class="mp-label">פורמט פגישה</label>
                <div class="mp-radio-row">
                    @foreach (var v in new[] { MentorMeetingFormats.Online, MentorMeetingFormats.InPerson, MentorMeetingFormats.Both })
                    {
                        <label class="mp-radio">
                            <input type="radio" name="mp-meet-format"
                                   value="@v"
                                   checked="@(_model.MeetingFormat == v)"
                                   @onchange="() => _model.MeetingFormat = v" />
                            <span>@MentorMeetingFormats.Label(v)</span>
                        </label>
                    }
                </div>

                <label class="mp-label">שיטת תיאום פגישות</label>
                <div class="mp-radio-row">
                    @foreach (var v in new[] { MentorSchedulingMethods.Student, MentorSchedulingMethods.Fixed })
                    {
                        <label class="mp-radio">
                            <input type="radio" name="mp-sched-method"
                                   value="@v"
                                   checked="@(_model.SchedulingMethod == v)"
                                   @onchange="() => _model.SchedulingMethod = v" />
                            <span>@MentorSchedulingMethods.Label(v)</span>
                        </label>
                    }
                </div>
            </section>

            @* 10. Notification preferences (digest) *@
            <section class="mp-section">
                <h4 class="mp-section-title">העדפות סיכום התראות</h4>

                <label class="mp-label">סוגי אירועים</label>
                <div class="mp-radio-row">
                    @foreach (var v in new[] { MentorEventTokens.NewSubmission, MentorEventTokens.Delays, MentorEventTokens.NoResponse })
                    {
                        <label class="mp-checkbox">
                            <input type="checkbox"
                                   checked="@_model.PreferenceEvents.Contains(v)"
                                   @onchange="@(e => ToggleToken(_model.PreferenceEvents, v, e))" />
                            <span>@MentorEventTokens.Label(v)</span>
                        </label>
                    }
                </div>

                <label class="mp-label">תדירות</label>
                <div class="mp-radio-row">
                    @foreach (var v in new[] { MentorDigestFrequencies.Immediate, MentorDigestFrequencies.Daily, MentorDigestFrequencies.Weekly })
                    {
                        <label class="mp-radio">
                            <input type="radio" name="mp-digest-freq"
                                   value="@v"
                                   checked="@(_model.PreferenceFrequency == v)"
                                   @onchange="() => _model.PreferenceFrequency = v" />
                            <span>@MentorDigestFrequencies.Label(v)</span>
                        </label>
                    }
                </div>
            </section>
        </div>

        <div class="mp-actions">
            @if (!string.IsNullOrEmpty(_saveError))
            {
                <span class="spp-inline-error">@_saveError</span>
            }
            <button class="spp-btn-ghost"
                    @onclick="CancelEdit"
                    disabled="@_saving">
                ביטול
            </button>
            <button class="spp-btn-save"
                    disabled="@_saving"
                    @onclick="SaveAsync">
                @if (_saving) { <span class="spp-spinner-sm"></span> }
                else          { <span class="oi oi-check" aria-hidden="true"></span> }
                שמירת העדפות
            </button>
        </div>
    }
</div>

@code {
    private MentorPreferencesDto? _model;
    /// <summary>Snapshot taken when the user enters edit mode, restored on cancel.</summary>
    private MentorPreferencesDto? _snapshot;
    private bool   _loading   = true;
    private bool   _loadError;
    private bool   _editing;
    private bool   _saving;
    private string _saveOk    = "";
    private string _saveError = "";

    protected override async Task OnInitializedAsync()
    {
        var loaded = await MentorPrefs.GetMineAsync();
        _loadError = loaded is null;
        _model     = loaded ?? new MentorPreferencesDto();
        _loading   = false;
    }

    private void StartEdit()
    {
        _snapshot  = Clone(_model);
        _saveOk    = "";
        _saveError = "";
        _editing   = true;
    }

    private void CancelEdit()
    {
        if (_snapshot is not null) _model = _snapshot;
        _snapshot  = null;
        _saveError = "";
        _editing   = false;
    }

    private void ToggleToken(List<string> list, string token, ChangeEventArgs e)
    {
        bool on = e.Value is bool b && b;
        if (on) { if (!list.Contains(token)) list.Add(token); }
        else    { list.Remove(token); }
        _saveOk    = "";
        _saveError = "";
    }

    private async Task SaveAsync()
    {
        if (_model is null) return;
        _saving    = true;
        _saveOk    = "";
        _saveError = "";

        var err = await MentorPrefs.SaveMineAsync(_model);
        _saving = false;

        if (err is null)
        {
            _saveOk   = "ההעדפות נשמרו בהצלחה";
            _snapshot = null;
            _editing  = false;
        }
        else
        {
            _saveError = err;
        }
    }

    // ── View-mode helpers ─────────────────────────────────────────────────────

    private bool IsEmpty
    {
        get
        {
            if (_model is null) return true;
            return !Has(_model.RoleDescription)
                && !Has(_model.InvolvementLevel)
                && !Has(_model.PreferredChannel)
                && !Has(_model.ExpectedResponseTime)
                && !Has(_model.CommunicationFrequency)
                && !_model.RequirePeriodicUpdates
                && _model.UpdateContent.Count == 0
                && !Has(_model.ClientInteractionFrequency)
                && !Has(_model.MentorInClientInteraction)
                && !Has(_model.SubmissionLeadTime)
                && _model.ReviewIterations is null
                && !Has(_model.FeedbackType)
                && _model.DecisionInvolvement.Count == 0
                && !Has(_model.QualityDescription)
                && _model.QualityFocusAreas.Count == 0
                && !Has(_model.RedLines)
                && !Has(_model.AvailableTimes)
                && !Has(_model.MeetingFormat)
                && !Has(_model.SchedulingMethod)
                && _model.PreferenceEvents.Count == 0
                && !Has(_model.PreferenceFrequency);
        }
    }

    private static bool Has(string? s) => !string.IsNullOrWhiteSpace(s);

    private static string JoinLabels(List<string> tokens, Func<string, string> label)
        => string.Join(", ", tokens.Select(label));

    private string ChannelLine()
    {
        if (_model is null || !Has(_model.PreferredChannel)) return "";
        var label = MentorChannels.Label(_model.PreferredChannel!);
        return _model.PreferredChannel == MentorChannels.Other && Has(_model.PreferredChannelOther)
            ? $"{label} ({_model.PreferredChannelOther})"
            : label;
    }

    private string ClientFreqLine()
    {
        if (_model is null || !Has(_model.ClientInteractionFrequency)) return "";
        return _model.ClientInteractionFrequency switch
        {
            "monthly"  => "חודשית",
            "biweekly" => "דו־שבועית",
            "custom"   => Has(_model.ClientInteractionFrequencyCustom)
                          ? $"מותאם אישית ({_model.ClientInteractionFrequencyCustom})"
                          : "מותאם אישית",
            _          => _model.ClientInteractionFrequency!,
        };
    }

    private string LeadTimeLine()
    {
        if (_model is null || !Has(_model.SubmissionLeadTime)) return "";
        return _model.SubmissionLeadTime switch
        {
            "2d"     => "יומיים",
            "3to5d"  => "3–5 ימים",
            "custom" => Has(_model.SubmissionLeadTimeCustom)
                        ? $"מותאם אישית ({_model.SubmissionLeadTimeCustom})"
                        : "מותאם אישית",
            _        => _model.SubmissionLeadTime!,
        };
    }

    private static MentorPreferencesDto? Clone(MentorPreferencesDto? src)
    {
        if (src is null) return null;
        return new MentorPreferencesDto
        {
            RoleDescription                  = src.RoleDescription,
            InvolvementLevel                 = src.InvolvementLevel,
            PreferredChannel                 = src.PreferredChannel,
            PreferredChannelOther            = src.PreferredChannelOther,
            ExpectedResponseTime             = src.ExpectedResponseTime,
            CommunicationFrequency           = src.CommunicationFrequency,
            RequirePeriodicUpdates           = src.RequirePeriodicUpdates,
            UpdateFrequency                  = src.UpdateFrequency,
            UpdateContent                    = new List<string>(src.UpdateContent),
            ClientInteractionFrequency       = src.ClientInteractionFrequency,
            ClientInteractionFrequencyCustom = src.ClientInteractionFrequencyCustom,
            MentorInClientInteraction        = src.MentorInClientInteraction,
            SubmissionLeadTime               = src.SubmissionLeadTime,
            SubmissionLeadTimeCustom         = src.SubmissionLeadTimeCustom,
            ReviewIterations                 = src.ReviewIterations,
            FeedbackType                     = src.FeedbackType,
            DecisionInvolvement              = new List<string>(src.DecisionInvolvement),
            QualityDescription               = src.QualityDescription,
            QualityFocusAreas                = new List<string>(src.QualityFocusAreas),
            RedLines                         = src.RedLines,
            AvailableTimes                   = src.AvailableTimes,
            MeetingFormat                    = src.MeetingFormat,
            SchedulingMethod                 = src.SchedulingMethod,
            PreferenceEvents                 = new List<string>(src.PreferenceEvents),
            PreferenceFrequency              = src.PreferenceFrequency,
        };
    }
}
