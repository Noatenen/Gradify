@page "/mentor-requests"
@layout AppLayout
@attribute [Authorize(Roles = Roles.Mentor + "," + Roles.Admin + "," + Roles.Staff)]
@namespace AuthWithAdmin.Client.Pages.Mentor
@using Microsoft.AspNetCore.Authorization
@using AuthWithAdmin.Client.Components
@using AuthWithAdmin.Client.Services
@using AuthWithAdmin.Shared.AuthSharedModels
@inject IProjectRequestsService RequestsService

@*
    ── בקשות — the mentor's request queue ──────────────────────────────────
    UX / IA source:  design-reference/mentor-experience/project/
                     Motiva Mentor Requests.dc.html
    Visual source:   the implemented student experience — MPageHeader Compact,
                     MKpiGrid/MKpiCard as filters, MCard AmbientEdge,
                     MRowList Inset, and the 16/48 section rhythm from the
                     Phase A polish pass.
    Data source:     GET api/project-requests — already scoped server-side to
                     the caller's own projects for a mentor-only user.

    WHAT REPLACED WHAT
    The legacy screen was a filter bar, a table and a hand-rolled side drawer.
    The drawer is gone and the four responsibility groups the design specifies
    replace the table. The drawer's one real capability — the extension
    recommendation — moved into MentorRequestDetail, shared with המשימות שלי,
    so the product's only mentor write exists exactly once.

    CARRIED OVER FROM THE LEGACY SCREEN, because they are functionality and
    not decoration:
      * the ?requestId= deep link a request notification arrives on, which now
        expands that row instead of opening a drawer;
      * search across title / project / number / requester;
      * MarkRead on open (inside MentorRequestDetail).

    THE KPI ROW IS THE FILTER, not a statistics strip: each card selects its
    own group, shows a pressed ring while active, and clears when clicked again.

    "טופלו" IS COLLAPSED BY DEFAULT — the design's own behaviour
    (`const collapsible = g.key === 'closed'`). It is history and must not push
    live work below the fold.
*@

<div class="mrq-header-bleed">
    <MPageHeader Variant="MPageHeader.HeaderVariant.Compact"
                 Title="בקשות"
                 Subtitle="כאן עוקבים אחר בקשות מהצוותים שלך — מה ממתין לך, מה עבר למרצה ומה כבר טופל.">
        @if (!_loading && !_loadError && _all.Count > 0)
        {
            <div class="mrq-controls">
                <MSearchField @bind-Value="_query"
                              MaxWidth="320px"
                              Placeholder="חיפוש בקשה, פרויקט או סטודנט…"
                              AriaLabel="חיפוש בבקשות" />

                <MKpiGrid Columns="4" AriaLabel="סיכום בקשות ומסננים">
                    @foreach (var b in MentorRequestBuckets.Ordered)
                    {
                        var bucket = b;
                        <MKpiCard Accent="@KpiAccentFor(bucket)"
                                  Value="@CountOf(bucket).ToString()"
                                  Label="@MentorRequestBuckets.GroupLabel(bucket)"
                                  Pressed="@(_bucketFilter == bucket)"
                                  OnClick="@(() => ToggleBucket(bucket))"
                                  AriaLabel="@($"{CountOf(bucket)} {MentorRequestBuckets.GroupLabel(bucket)} — סינון")">
                            <Icon><MentorGlyph Kind="@GlyphFor(bucket)" /></Icon>
                        </MKpiCard>
                    }
                </MKpiGrid>

                @if (_bucketFilter is not null)
                {
                    <div class="mrq-filter-chip">
                        <span>מציג: @MentorRequestBuckets.GroupLabel(_bucketFilter.Value)</span>
                        <button type="button" class="mrq-filter-clear" @onclick="ClearBucket">נקה ✕</button>
                    </div>
                }
            </div>
        }
    </MPageHeader>
</div>

<div class="mrq-body">

    @if (_loading)
    {
        <div class="mrq-state" role="status" aria-live="polite">
            <span class="mrq-spinner" aria-hidden="true"></span>
            <span>טוענת בקשות…</span>
        </div>
    }
    else if (_loadError)
    {
        <MEmptyState Live="true"
                     Title="לא הצלחנו לטעון את הבקשות"
                     Description="ייתכן שיש תקלת רשת זמנית. אפשר לנסות שוב.">
            <Action>
                <MButton Variant="MButton.ButtonVariant.Secondary" OnClick="LoadAsync">נסי שוב</MButton>
            </Action>
        </MEmptyState>
    }
    else if (_all.Count == 0)
    {
        <MEmptyState Title="אין בקשות בפרויקטים שלך"
                     Description="כשצוות יגיש בקשה, היא תופיע כאן." />
    }
    else
    {
        @* ── Request-type filter — a NEUTRAL axis.
             These pills say WHAT a request is; the KPI row above says WHO has
             to act. The design is explicit about keeping the two apart
             ("סוג הבקשה מסומן בתגית ניטרלית קטנה — לא צבע"), which is why
             there is no semantic colour and no CTA gradient here. ── *@
        <div class="mrq-types" role="group" aria-label="סינון לפי סוג בקשה">
            <button type="button"
                    class="mrq-type @(_typeFilter is null ? "mrq-type-on" : "")"
                    aria-pressed="@(_typeFilter is null)"
                    @onclick="@(() => SetType(null))">
                הכל
            </button>
            @foreach (var t in AvailableTypes)
            {
                var type = t;
                <button type="button"
                        class="mrq-type @(_typeFilter == type ? "mrq-type-on" : "")"
                        aria-pressed="@(_typeFilter == type)"
                        @onclick="@(() => SetType(_typeFilter == type ? null : type))">
                    @RequestTypes.Label(type)
                </button>
            }
        </div>

        @if (VisibleGroups.Sum(g => g.Items.Count) == 0)
        {
            <MEmptyState Title="אין בקשות תואמות לסינון."
                         Description="אפשר לנקות את הסינון ולראות את כל הבקשות.">
                <Action>
                    <MButton Variant="MButton.ButtonVariant.Secondary" OnClick="ClearAllFilters">
                        ניקוי הסינון
                    </MButton>
                </Action>
            </MEmptyState>
        }
        else
        {
            @foreach (var group in VisibleGroups)
            {
                var g = group;
                @* MSectionHeading exposes exactly one named slot, so an @if
                   cannot wrap <Trailing> — the fragment is chosen here and
                   passed as null when the group is not collapsible. *@
                @* Already inside a code block (@foreach), so this is a plain
                   C# statement — an "@{" here would be a nested switch. *@
                RenderFragment? groupTrailing = g.Collapsible
                        ? @<button type="button" class="mrq-collapse"
                                   aria-expanded="@_closedOpen"
                                   @onclick="@(() => _closedOpen = !_closedOpen)">
                               @(_closedOpen ? "הסתרה" : "הצגה")
                           </button>
                        : null;

                <section class="mrq-section">
                    <MSectionHeading Text="@MentorRequestBuckets.GroupLabel(g.Bucket)"
                                     Count="@g.Items.Count.ToString()"
                                     Trailing="@groupTrailing" />

                    @if (!g.Collapsible || _closedOpen)
                    {
                        <MCard Variant="MCard.CardVariant.AmbientEdge" Padding="MCard.CardPadding.None">
                            @if (g.Items.Count == 0)
                            {
                                <MEmptyState Title="אין בקשות בקבוצה זו." Class="mrq-empty" />
                            }
                            else
                            {
                                <MRowList Inset="true" AriaLabel="@MentorRequestBuckets.GroupLabel(g.Bucket)">
                                    @foreach (var r in g.Items)
                                    {
                                        var req = r;
                                        var isOpen = _expandedId == req.Id;

                                        <MRow OnClick="@(() => Toggle(req.Id))"
                                              Selected="@isOpen"
                                              Primary="@req.Title"
                                              Secondary="@RowContext(req)"
                                              Meta="@SlaLabel(req)"
                                              MetaTone="@SlaTone(req)"
                                              AriaLabel="@($"{(isOpen ? "סגירת" : "פתיחת")} הבקשה {req.Title}")">
                                            <Leading>
                                                <MStatusBadge Text="@RequestTypes.Label(req.RequestType)" />
                                            </Leading>
                                            <Trailing>
                                                <span class="mrq-chevron @(isOpen ? "mrq-chevron-open" : "")" aria-hidden="true">
                                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                                         stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                        <path d="m6 9 6 6 6-6"></path>
                                                    </svg>
                                                </span>
                                            </Trailing>
                                        </MRow>

                                        @if (isOpen)
                                        {
                                            <div class="mrq-detail">
                                                <MentorRequestDetail RequestId="@req.Id"
                                                                     ShowHeader="false"
                                                                     OnChanged="OnRequestChangedAsync" />
                                            </div>
                                        }
                                    }
                                </MRowList>
                            }
                        </MCard>
                    }
                </section>
            }
        }
    }
</div>

@code {
    /// <summary>Deep link a request notification arrives on. The legacy screen
    /// opened the drawer for it; this expands its row instead.</summary>
    [SupplyParameterFromQuery(Name = "requestId")]
    public int? DeepLinkRequestId { get; set; }

    private List<ProjectRequestRowDto> _all = new();
    private bool _loading = true;
    private bool _loadError;

    private string               _query = "";
    private MentorRequestBucket? _bucketFilter;
    private string?              _typeFilter;
    private int?                 _expandedId;
    private bool                 _closedOpen;   // "טופלו" starts collapsed, per the design

    private sealed record Group(MentorRequestBucket Bucket, List<ProjectRequestRowDto> Items, bool Collapsible);

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();

        if (DeepLinkRequestId is int id && _all.Any(r => r.Id == id))
        {
            _expandedId = id;
            // A closed request reached from a notification must still open, so
            // the collapsed group has to give way for it.
            if (MentorRequestBuckets.Of(_all.First(r => r.Id == id).Status) == MentorRequestBucket.Closed)
                _closedOpen = true;
        }
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _loadError = false;

        var rows = await RequestsService.GetAllAsync();
        if (rows is null) { _loadError = true; _loading = false; return; }

        // Newest activity first, the ordering the legacy inbox used.
        _all = rows.OrderByDescending(r => r.UpdatedAt).ToList();
        _loading = false;
    }

    /// <summary>A recommendation was accepted, so the request has changed
    /// bucket — reload rather than patching one row's status by hand.</summary>
    private async Task OnRequestChangedAsync()
    {
        _expandedId = null;
        await LoadAsync();
    }

    private void Toggle(int id) => _expandedId = _expandedId == id ? null : id;

    private void ToggleBucket(MentorRequestBucket b)
    {
        _bucketFilter = _bucketFilter == b ? null : b;
        _expandedId = null;
        // Selecting "טופלו" from the KPI row must actually reveal it, or the
        // filter would appear to do nothing at all.
        if (_bucketFilter == MentorRequestBucket.Closed) _closedOpen = true;
    }

    private void ClearBucket() => _bucketFilter = null;

    private void SetType(string? t)
    {
        _typeFilter = t;
        _expandedId = null;
    }

    private void ClearAllFilters()
    {
        _bucketFilter = null;
        _typeFilter   = null;
        _query        = "";
    }

    // ── Derived ─────────────────────────────────────────────────────────

    /// <summary>Search + type are applied BEFORE the counts, so the KPI numbers
    /// always describe what the list below is actually showing.</summary>
    private IEnumerable<ProjectRequestRowDto> Narrowed
    {
        get
        {
            var q = _query.Trim();
            return _all
                .Where(r => _typeFilter is null || r.RequestType == _typeFilter)
                .Where(r => q.Length == 0
                         || r.Title.Contains(q, StringComparison.OrdinalIgnoreCase)
                         || r.ProjectTitle.Contains(q, StringComparison.OrdinalIgnoreCase)
                         || r.ProjectNumber.ToString().Contains(q)
                         || r.CreatedByName.Contains(q, StringComparison.OrdinalIgnoreCase));
        }
    }

    private int CountOf(MentorRequestBucket b) =>
        Narrowed.Count(r => MentorRequestBuckets.Of(r.Status) == b);

    /// <summary>Only the types that actually occur in this mentor's requests —
    /// a pill for a type no team ever files is a dead control.</summary>
    private List<string> AvailableTypes =>
        RequestTypes.All.Where(t => _all.Any(r => r.RequestType == t)).ToList();

    private List<Group> VisibleGroups =>
        MentorRequestBuckets.Ordered
            .Where(b => _bucketFilter is null || _bucketFilter == b)
            .Select(b => new Group(
                b,
                Narrowed.Where(r => MentorRequestBuckets.Of(r.Status) == b).ToList(),
                Collapsible: b == MentorRequestBucket.Closed))
            .ToList();

    // ── Row presentation ────────────────────────────────────────────────

    /// <summary>Project + team + requester — every calendar/row surface in the
    /// mentor area has to say which team it belongs to.</summary>
    private static string RowContext(ProjectRequestRowDto r) =>
        string.Join(" · ", new[] { r.ProjectTitle, r.TeamName, r.CreatedByName }
            .Where(s => !string.IsNullOrWhiteSpace(s)));

    /// <summary>Ageing, written from the mentor's side. Only a request actually
    /// waiting on them gets a "how long you have held it" reading; everything
    /// else reports when it last moved.</summary>
    private static string SlaLabel(ProjectRequestRowDto r) =>
        MentorRequestBuckets.Of(r.Status) == MentorRequestBucket.AwaitingMentor
            ? MentorTime.WaitingLabel(r.CreatedAt)
            : $"עודכנה {MentorTime.AgoLabel(r.UpdatedAt)}";

    /// <summary>Rose past three days, and only for the ones the mentor is
    /// holding — the design escalates exactly that case.</summary>
    private static MRow.RowMetaTone SlaTone(ProjectRequestRowDto r) =>
        MentorRequestBuckets.Of(r.Status) == MentorRequestBucket.AwaitingMentor
        && MentorTime.DaysSince(r.CreatedAt) >= 3
            ? MRow.RowMetaTone.Rose
            : MRow.RowMetaTone.Default;

    /// <summary>KPI accents. Amber for "waiting on you" is the presentation hue
    /// the finalized student Requests screen already uses for the same idea;
    /// the row-level status colour stays on the Master's violet/teal/rose via
    /// MStatusDot. Presentation and semantics remain separate.</summary>
    private static MKpiCard.KpiAccent KpiAccentFor(MentorRequestBucket b) => b switch
    {
        MentorRequestBucket.AwaitingMentor => MKpiCard.KpiAccent.Amber,
        MentorRequestBucket.WithLecturer   => MKpiCard.KpiAccent.Violet,
        MentorRequestBucket.AwaitingTeam   => MKpiCard.KpiAccent.Periwinkle,
        _                                  => MKpiCard.KpiAccent.Teal,
    };

    private static MentorGlyph.GlyphKind GlyphFor(MentorRequestBucket b) => b switch
    {
        MentorRequestBucket.AwaitingMentor => MentorGlyph.GlyphKind.Request,
        MentorRequestBucket.WithLecturer   => MentorGlyph.GlyphKind.Review,
        MentorRequestBucket.AwaitingTeam   => MentorGlyph.GlyphKind.Personal,
        _                                  => MentorGlyph.GlyphKind.OnTrack,
    };
}
