@namespace AuthWithAdmin.Client.Pages.Mentor

@*
    MentorGlyph — the mentor screens' KPI-chip icon family, in one place.

    The same three pages need the same seven marks, and the student precedent
    (RequestsKpiRow) inlines its SVGs per card. Inlining works for one row; it
    does not work for seven marks across three files, where the fourth copy is
    where the stroke width quietly drifts. Size, stroke, caps and joins are set
    HERE, once — which is exactly the guarantee NavIcons gives the rail.

    15px on a 24px grid at 1.6 stroke: the values RequestsKpiRow already uses,
    so a mentor KPI chip and a student KPI chip are the same optical weight.
*@

<svg class="m-glyph" viewBox="0 0 24 24" fill="none" stroke="currentColor"
     stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    @switch (Kind)
    {
        case GlyphKind.Review:            // a document under review
            <path d="M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
            <path d="M14 3v5h5"></path>
            break;

        case GlyphKind.Request:           // speech bubble — a conversation
            <path d="M20 6.5v8a2 2 0 0 1-2 2H9l-4 3.5V6.5a2 2 0 0 1 2-2h11a2 2 0 0 1 2 2z"></path>
            break;

        case GlyphKind.Personal:          // a wall calendar
            <rect x="4" y="5" width="16" height="15" rx="2"></rect>
            <path d="M4 10h16M8 3v4M16 3v4"></path>
            break;

        case GlyphKind.Overdue:           // a clock past its hour
            <circle cx="12" cy="12" r="9"></circle>
            <path d="M12 7.5V12l3 2"></path>
            break;

        case GlyphKind.OnTrack:           // a ticked circle
            <circle cx="12" cy="12" r="9"></circle>
            <path d="m8.5 12.5 2.2 2.2 4.8-4.8"></path>
            break;

        case GlyphKind.Attention:         // an exclamation in a circle
            <circle cx="12" cy="12" r="9"></circle>
            <path d="M12 8v4.5M12 16h.01"></path>
            break;

        case GlyphKind.AtRisk:            // an exclamation in a triangle
            <path d="M10.3 3.9 2.7 17a2 2 0 0 0 1.7 3h15.2a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z"></path>
            <path d="M12 9v4M12 17h.01"></path>
            break;

        case GlyphKind.Projects:          // stacked layers — the whole portfolio
            <path d="M12.8 2.2a2 2 0 0 0-1.6 0L2.6 6.1a1 1 0 0 0 0 1.8l8.6 3.9a2 2 0 0 0 1.6 0l8.6-3.9a1 1 0 0 0 0-1.8Z"></path>
            <path d="m6.1 12.5-3.5 1.6a1 1 0 0 0 0 1.8l8.6 3.9a2 2 0 0 0 1.6 0l8.6-3.9a1 1 0 0 0 0-1.8l-3.5-1.6"></path>
            break;
    }
</svg>

@code {
    public enum GlyphKind
    {
        Review,
        Request,
        Personal,
        Overdue,
        OnTrack,
        Attention,
        AtRisk,
        Projects,
    }

    [Parameter, EditorRequired] public GlyphKind Kind { get; set; }

    /// <summary>The glyph for a project-health state, so a caller iterating the
    /// three states never has to re-map them to marks by hand.</summary>
    public static GlyphKind For(MentorHealth h) => h switch
    {
        MentorHealth.OnTrack   => GlyphKind.OnTrack,
        MentorHealth.Attention => GlyphKind.Attention,
        _                      => GlyphKind.AtRisk,
    };
}
