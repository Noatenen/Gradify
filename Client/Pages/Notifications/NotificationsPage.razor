@page "/notifications"
@layout AppLayout
@using Microsoft.AspNetCore.Authorization
@using AuthWithAdmin.Shared.AuthSharedModels
@attribute [Authorize(Roles = Roles.Student)]

@*
    Placeholder page for "התראות ועדכונים".

    The nav entry and route exist now so the future information architecture
    is in place, but the real notification list/read-state UI is deferred to
    a later sprint. The existing NotificationBell dropdown remains the live
    notifications surface in the meantime.
*@

<div class="ntf-page" dir="rtl">

    <MPageHeaderCard Title="התראות ועדכונים"
                     Subtitle="מרכז ההתראות המלא בפיתוח — בינתיים ניתן לצפות בהתראות דרך פעמון ההתראות">
        <Leading>
            <div class="ntf-header-icon">
                <span class="oi oi-bell" aria-hidden="true"></span>
            </div>
        </Leading>
    </MPageHeaderCard>

    <div class="ntf-state">
        <span class="oi oi-clock" aria-hidden="true"></span>
        <p>הדף נמצא בפיתוח ויאפשר בקרוב לצפות בכל ההתראות והעדכונים במקום אחד.</p>
    </div>

</div>