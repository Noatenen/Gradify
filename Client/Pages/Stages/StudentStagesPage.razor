@page "/project-stages"
@layout AppLayout
@using Microsoft.AspNetCore.Authorization
@using AuthWithAdmin.Shared.AuthSharedModels
@using AuthWithAdmin.Client.Services
@using AuthWithAdmin.Client.Pages.Tasks
@attribute [Authorize]

@*
    StudentStagesPage — "שלבי הפרויקט"

    Answers ONE question: "Where are we in the project journey?" —
    distinct from the Dashboard (health) and My Tasks (what to do now).

    Sprint-1 / Epic 3 scope: read-only journey view. Stage cards are
    intentionally NOT clickable yet (Epic 4 hasn't built the Stage
    Workspace they'd open). Milestones-within-a-stage are labeled
    "תוצרים" (Deliverables) here — the one screen where that display-only
    terminology applies, per the approved scoping decision.
*@

@if (_isLoading)
{
    <div class="sts-loading">
        <div class="sts-spinner"></div>
        <span>טוענת שלבי פרויקט…</span>
    </div>
}
else if (_loadError)
{
    <div class="sts-state-msg sts-error">
        <span class="oi oi-warning" aria-hidden="true"></span>
        <p>אירעה שגיאה בטעינת שלבי הפרויקט. נסי לרענן את הדף.</p>
    </div>
}
else if (_progress is null || _progress.ProjectId == 0)
{
    <div class="sts-state-msg">
        <span class="oi oi-info" aria-hidden="true"></span>
        <p>לא שויכת לפרויקט עדיין. פני למנחה שלך להשמת הצוות.</p>
    </div>
}
else
{
    <div class="sts-page">

        <div class="sts-header">
            <h1 class="sts-page-title">שלבי הפרויקט</h1>
        </div>

        <CurrentProgressStrip Context="@_projectCtx" />

        @if (_progress.Stages.Count == 0)
        {
            <div class="sts-state-msg">
                <span class="oi oi-map" aria-hidden="true"></span>
                <p>שלבי המתודולוגיה טרם הוגדרו למחזור הנוכחי. פני למרצה/מנחה שלך לפרטים.</p>
            </div>
        }
        else
        {
            <StageJourneyCard Stages="@_progress.Stages" OverallProjectProgressPct="@_progress.OverallProjectProgressPct" />
        }

    </div>
}

@code {
    [Inject] private IRoadmapStagesService  StagesService  { get; set; } = default!;
    [Inject] private IProjectContextService ProjectContext { get; set; } = default!;

    private ProjectRoadmapProgressDto? _progress;
    private ProjectContextDto?         _projectCtx;
    private bool _isLoading = true;
    private bool _loadError = false;

    protected override async Task OnInitializedAsync()
    {
        var contextTask = ProjectContext.GetAsync();

        _progress  = await StagesService.GetMyProgressAsync();
        _loadError = _progress is null;
        _isLoading = false;

        _projectCtx = await contextTask;
    }
}