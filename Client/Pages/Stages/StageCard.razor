@using AuthWithAdmin.Shared.AuthSharedModels

@*
    StageCard — COMPACT representation of one stage (used for every stage
    EXCEPT the current one, which StageJourneyCard renders in full detail
    inline). Deliberately non-clickable in Epic 3 — no hover/cursor
    affordance implying interactivity.

    Shows enough to answer "what happened / what's coming" at a glance —
    name, status, deliverable count — without duplicating the full
    deliverable list, which only the current stage gets.
*@

<div class="stc-row stc-status-@StatusClass(Stage.Status)">
    <span class="stc-order">@Order</span>
    <span class="oi @StatusIcon(Stage.Status) stc-row-icon" aria-hidden="true"></span>
    <span class="stc-row-title">@Stage.Name</span>
    <span class="stc-status-badge stc-badge-@StatusClass(Stage.Status)">
        @StatusLabel(Stage.Status)
    </span>
    @if (Stage.LinkedMilestoneCount > 0)
    {
        <span class="stc-row-count">@Stage.CompletedMilestoneCount/@Stage.LinkedMilestoneCount תוצרים</span>
    }
    else
    {
        <span class="stc-row-count stc-row-count-empty">אין תוצרים משויכים</span>
    }
</div>

@code {
    [Parameter, EditorRequired] public StageProgressDto Stage { get; set; } = default!;
    [Parameter] public int Order { get; set; }

    private static string StatusClass(string s) => s switch
    {
        RoadmapStageStatuses.Completed => "completed",
        RoadmapStageStatuses.Current   => "current",
        RoadmapStageStatuses.Future    => "future",
        _                               => "notapplicable",
    };

    private static string StatusLabel(string s) => RoadmapStageStatuses.Label(s);

    private static string StatusIcon(string s) => s switch
    {
        RoadmapStageStatuses.Completed => "oi-circle-check",
        RoadmapStageStatuses.Current   => "oi-media-record",
        _                               => "oi-media-record",
    };
}
