@*
    ── בקשות מרצה — Lecturer Request Queue (Split Workspace) ─────────────────
    Visual source:  design/design-system/MotivaLecturerDesign/
                    Motiva Lecturer Requests New.dc.html
                    בקשות מרצה 308 חדש.pdf
                    בקשות מרצה 308.png

    LAYOUT — the shared request workspace (`rqw-*`,
    Client/wwwroot/css/motiva-request-workspace.css), the same skeleton and now
    the same ROW ANATOMY and RECORD HEAD the student and mentor queues draw:
      RIGHT — the queue, scrolling inside itself with its scrollbar on the
              physical right edge
              • the buckets as MFilterTabs  (להחלטתך / בטיפול מנחה / טופלו)
              • the shared request-type dropdown
              • rows: title + type chip on one line, state + requester below
      LEFT  — the selected request's record and the decision workspace

    THE VISUAL PASS CHANGED NO BUCKET, NO COUNT AND NO POST. The tab keys, the
    BucketOf mapping, StatusClass, RowTimeLabel and every branch of
    SubmitDecision below are exactly what they were; what moved is which
    stylesheet paints them. A lecturer still cannot OPEN a request — only a
    student can, which is why this screen has no create action and must not
    grow one.

    TABS / BUCKETS
    ──────────────
      להחלטתך  → PendingLecturerDecision + New + InProgress + WaitingForStaff + NeedsInfo
      בטיפול מנחה → PendingMentorRecommendation
      טופלו    → Resolved + Closed

    DECISION FLOW  (unchanged from previous implementation)
    ─────────────
    Extension at PendingLecturerDecision:
        SubmitExtensionDecisionAsync(id, {Stage=Lecturer, Decision=Approved/Rejected})
    "החזרה להשלמה" → HandleAsync(id, {NewStatus=NeedsInfo})
    General requests:
        אישור   → HandleAsync(id, {NewStatus=Resolved})
        דחייה   → HandleAsync(id, {NewStatus=Closed})
        החזרה   → HandleAsync(id, {NewStatus=NeedsInfo})
*@

@page "/management/requests"
@layout AppLayout
@attribute [Authorize(Roles = Roles.Admin + "," + Roles.Staff)]
@namespace AuthWithAdmin.Client.Pages.Management.Requests
@using Microsoft.AspNetCore.Authorization
@using AuthWithAdmin.Client.Services
@using AuthWithAdmin.Shared.AuthSharedModels

@inject IProjectRequestsService RequestsService
@inject IRequestTypesService RequestTypesService
@inject IJSRuntime JS

<div class="lrq-page rqw-page" dir="rtl">

    <!-- ══════════════════════════════════════════════════════════════
         PAGE HEADER  (full-width, above split)
         ══════════════════════════════════════════════════════════════ -->
    <div class="rqw-header">

        <h1 class="rqw-title">בקשות</h1>

    </div>

    @if (_loading)
    {
        <MLoadingState Label="טוענת בקשות…" />
    }
    else if (_loadError)
    {
        <MEmptyState Live="true"
                     Title="אירעה שגיאה בטעינת הבקשות"
                     Description="ייתכן שיש תקלת רשת זמנית. אפשר לנסות שוב.">
            <Action>
                <MButton Variant="MButton.ButtonVariant.Secondary" OnClick="ReloadAsync">נסו שוב</MButton>
            </Action>
        </MEmptyState>
    }
    else
    {
        <!-- ══════════════════════════════════════════════════════════════
             SPLIT WORKSPACE
             In RTL flex-row: first child (sidebar) → RIGHT edge
                               second child (main)  → fills remaining LEFT space
             ══════════════════════════════════════════════════════════════ -->
        <div class="rqw-split">

            <!-- ── SIDEBAR — right panel ─────────────────────────────── -->
            <aside class="rqw-sidebar">

                @*  THE QUEUE'S TWO CONTROLS, in the shared filter bar the
                    student and mentor queues use: the buckets as MFilterTabs —
                    the finished design's pill track, with the count riding the
                    tab it belongs to — and the type dropdown under it.

                    This replaced a hand-rolled `.lrq-seg`: a grey track with a
                    raised white chip, which ran the identical open/select logic
                    but read as a different control on a screen that is meant to
                    be the same feature. The tab KEYS are unchanged
                    ("decision" / "mentor" / "done") and so is SetTab, so no
                    bucket, count or query moved with the control.  *@
                <div class="rqw-filters">

                    <MFilterTabs Tabs="@FilterTabs"
                                 ActiveKey="@_activeTab"
                                 OnSelect="SetTab"
                                 AriaLabel="סינון בקשות לפי מצב" />

                    <div class="lrq-type-wrap rqw-type-wrap">
                        <button type="button"
                                class="rqw-type-btn @(!string.IsNullOrEmpty(_selectedType) ? "rqw-type-btn-active" : "")"
                                aria-haspopup="listbox"
                                aria-expanded="@(_typeMenuOpen ? "true" : "false")"
                                aria-label="סינון לפי סוג בקשה"
                                @onclick="ToggleTypeMenu">
                            <span class="rqw-type-label-text">סוג בקשה</span>
                            <span class="rqw-type-val-text">@(!string.IsNullOrEmpty(_selectedType) ? TypeLabel(_selectedType) : "הכל")</span>
                            <span class="rqw-type-caret @(_typeMenuOpen ? "rqw-type-caret-open" : "")" aria-hidden="true">
                                <svg width="10" height="10" viewBox="0 0 24 24" fill="none"
                                     stroke="currentColor" stroke-width="2.5"
                                     stroke-linecap="round" stroke-linejoin="round">
                                    <path d="m6 9 6 6 6-6"/>
                                </svg>
                            </span>
                        </button>

                        @if (_typeMenuOpen)
                        {
                            <div class="rqw-type-backdrop" @onclick="CloseTypeMenu"></div>
                            <div class="rqw-type-panel" role="listbox" aria-label="סוג בקשה">
                                <button type="button"
                                        class="rqw-type-opt @(string.IsNullOrEmpty(_selectedType) ? "rqw-type-opt-on" : "")"
                                        role="option"
                                        aria-selected="@(string.IsNullOrEmpty(_selectedType) ? "true" : "false")"
                                        @onclick='@(() => PickType(""))'>
                                    <span class="rqw-type-opt-label">הכל</span>
                                    @if (string.IsNullOrEmpty(_selectedType))
                                    {
                                        <svg class="rqw-type-check" width="12" height="12" viewBox="0 0 24 24" fill="none"
                                             stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="m5 12.5 4.5 4.5L19 7"/>
                                        </svg>
                                    }
                                </button>
                                @foreach (var type in AvailableTypes)
                                {
                                    var t = type;
                                    var on = _selectedType == t;
                                    <button type="button"
                                            class="rqw-type-opt @(on ? "rqw-type-opt-on" : "")"
                                            role="option"
                                            aria-selected="@(on ? "true" : "false")"
                                            @onclick='@(() => PickType(t))'>
                                        <span class="rqw-type-opt-label">@TypeLabel(t)</span>
                                        @if (on)
                                        {
                                            <svg class="rqw-type-check" width="12" height="12" viewBox="0 0 24 24" fill="none"
                                                 stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round">
                                                <path d="m5 12.5 4.5 4.5L19 7"/>
                                            </svg>
                                        }
                                    </button>
                                }
                            </div>
                        }
                    </div>
                </div>@* rqw-filters *@

                @*  The scrolling queue. `.rqw-list` is the scroll box and is
                    flipped to LTR so its scrollbar renders on the physical
                    RIGHT edge; `.rqw-list-inner` puts the content back to RTL,
                    so nothing about a row moves. The listbox role rides the
                    inner element, which is the one that actually owns the
                    options.  *@
                <div class="rqw-list">
                  <div class="rqw-list-inner" role="listbox" aria-label="רשימת בקשות">
                    @{
                        var visibleItems = VisibleItems;
                    }
                    @if (visibleItems.Count == 0)
                    {
                        <p class="rqw-list-empty">אין בקשות תואמות לסינון הנוכחי</p>
                    }
                    else
                    {
                        @foreach (var r in visibleItems)
                        {
                            var req = r;
                            var isSelected = _expandedId == req.Id;
                            <button type="button"
                                    class="rqw-row @(isSelected ? "rqw-row-selected" : "")"
                                    role="option"
                                    aria-selected="@(isSelected)"
                                    aria-label="@req.Title"
                                    @onclick='@(() => SelectRequest(req.Id))'>

                                @*  ── HEAD LINE — the shared row anatomy ──
                                    The title flexes and ellipses in place, the
                                    request type is pinned to the far LEFT.
                                    Identical to the student and mentor queues:
                                    a request row is one object across the
                                    product.

                                    It was three lines, with the type chip and
                                    the waiting phrase on a line of their own
                                    above the title. Folding the chip up onto the
                                    title line is what pays for the row saying
                                    the same in less height.

                                    NO UNREAD DOT HERE, unlike the student queue.
                                    On this screen it was a violet dot on very
                                    nearly every row — a lecturer has not "read"
                                    most of a cohort's requests — so it stopped
                                    marking anything and became decoration
                                    leading every title. The signal itself is not
                                    lost where it is actionable: in the
                                    להחלטתך bucket RowTimeLabel below says
                                    "עדכון חדש" in words. In the other two
                                    buckets the row is not the lecturer's move
                                    at all — "אצל המנחה" and "טופל · 12.03" are
                                    what matters there, and an unread marker on
                                    them only competed with them.  *@
                                <div class="rqw-row-head">
                                    <span class="rqw-row-title">@req.Title</span>
                                    <span class="rqw-row-type">@TypeLabel(req.RequestType)</span>
                                </div>

                                @*  ── META — WHOSE request this is, and nothing
                                    else.

                                    THE ITEM IS THE TEAM, not the person who
                                    typed the request. A lecturer reads this
                                    queue by team: the decision is about a team's
                                    deadline, the note goes to the team, and the
                                    same team files several requests through
                                    whichever member happens to be at a keyboard.
                                    Naming the member made two rows about one
                                    team look like two unrelated matters. The
                                    submitter is still on the record — see the
                                    head's "נפתחה … על ידי …" — where it is
                                    detail rather than identity.

                                    NO STATE SENTENCE HERE ANY MORE. The row used
                                    to lead with RowTimeLabel in the bucket's own
                                    colour — "ממתינה להחלטתך" in rose,
                                    "עדכון חדש" and "עודכנה 15.07" in violet. On
                                    a queue that is ALREADY filtered to one
                                    bucket by the pills above it, that sentence
                                    told the reader what the selected tab had
                                    just told them, in the loudest ink on the
                                    row, once per row. The state is not gone: it
                                    is on the record's own badge
                                    (`rqw-ws-state-…`, painted by StateTone),
                                    where it is read once, about the one request
                                    the lecturer has actually opened.

                                    RowTimeLabel, StatusClass, StateTone and the
                                    buckets behind them are untouched — this is
                                    which of them the ROW draws, not what any of
                                    them answers.  *@
                                <div class="rqw-row-meta">
                                    <span class="rqw-row-sub">@TeamIdentity(req)</span>
                                </div>

                            </button>
                        }
                    }
                  </div>@* rqw-list-inner *@
                </div>@* rqw-list *@

            </aside>

            <!-- ── MAIN WORKSPACE — left panel ──────────────────────── -->
            <main class="rqw-main">

                @if (_expandedId is null)
                {
                    <!-- No selection — neutral empty state -->
                    <div class="rqw-empty">
                        <div class="rqw-empty-icon" aria-hidden="true">
                            <svg width="40" height="40" viewBox="0 0 24 24" fill="none"
                                 stroke="currentColor" stroke-width="1.3"
                                 stroke-linecap="round" stroke-linejoin="round">
                                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                                <polyline points="14 2 14 8 20 8"/>
                                <line x1="16" y1="13" x2="8" y2="13"/>
                                <line x1="16" y1="17" x2="8" y2="17"/>
                                <polyline points="10 9 9 9 8 9"/>
                            </svg>
                        </div>
                        <p class="rqw-empty-title">בחרו בקשה כדי לצפות בפרטים</p>
                        <p class="rqw-empty-sub">פרטי הבקשה יוצגו כאן לאחר הבחירה</p>
                    </div>
                }
                else
                {
                    var selectedRow = _all.FirstOrDefault(x => x.Id == _expandedId);
                    var detail      = _details.TryGetValue(_expandedId.Value, out var d) ? d : null;
                    var isLoadingDetail = _loadingDetails.Contains(_expandedId.Value);

                    @if (selectedRow is null)
                    {
                        <div class="rqw-empty">
                            <p class="rqw-empty-title">הבקשה לא נמצאה</p>
                        </div>
                    }
                    else
                    {
                        var r = selectedRow;

                        <div class="rqw-card" id="request-@r.Id">

                            @if (isLoadingDetail && detail is null)
                            {
                                <div class="lrq-detail-loading">
                                    <MLoadingState Label="טוענת פרטי בקשה…" />
                                </div>
                            }
                            else
                            {
                                <!-- ── WORKSPACE HEADER ── -->
                                @*  ── RECORD HEADER ─────────────────────────
                                    TWO CHILDREN ON ONE ROW, not a stack. The
                                    identity keeps the reading end — the RIGHT,
                                    under dir=rtl — and the badges take the
                                    opposite corner, the upper LEFT.

                                    The badges used to sit ABOVE the title, which
                                    is the one thing that made this record read
                                    as a different object from the student's. The
                                    title now comes first in the DOM as well as
                                    visually, which is the order a screen reader
                                    should meet them in anyway. Nothing inside
                                    either group is reordered and no badge means
                                    anything new.  *@
                                <div class="rqw-ws-head">
                                    <div class="rqw-ws-ident">
                                        <h2 class="rqw-ws-title">@r.Title</h2>
                                        @*  THE IDENTITY SLOT IS THE TEAM.
                                            `rqw-meta-strong` is the record's
                                            "who is this about" position — the
                                            student's own record puts the
                                            handling role there — and on this
                                            screen the answer is the team, for
                                            the same reason the row says it.

                                            The submitter has not been removed,
                                            it has been DEMOTED: it now finishes
                                            the opening-date item as
                                            "נפתחה 05.09.2026 · על ידי יעל כהן",
                                            which is the shape the student
                                            record already uses for the same
                                            fact (RequestBuckets.OpenedByLabel).
                                            It reads as provenance there instead
                                            of as the subject of the request.  *@
                                        @{ var identity = TeamIdentity(r); }
                                        <p class="rqw-ws-submeta">
                                            <span class="rqw-meta-strong">@identity</span>
                                            @*  The project is a SECOND item only
                                                when it is not already the first:
                                                where the team has no name of its
                                                own, TeamIdentity has already
                                                fallen back to the project title
                                                and printing it again produced
                                                the same words twice on one
                                                line.  *@
                                            @if (!string.IsNullOrWhiteSpace(r.ProjectTitle)
                                                 && !string.Equals(r.ProjectTitle, identity, StringComparison.Ordinal))
                                            {
                                                <span class="rqw-meta-sep" aria-hidden="true">·</span>
                                                <span>@r.ProjectTitle</span>
                                            }
                                            @if (r.CreatedAt != default)
                                            {
                                                <span class="rqw-meta-sep" aria-hidden="true">·</span>
                                                <span>נפתחה @r.CreatedAt.ToString("dd.MM.yyyy")</span>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(r.CreatedByName))
                                            {
                                                <span class="rqw-meta-sep" aria-hidden="true">·</span>
                                                <span>על ידי @r.CreatedByName</span>
                                            }
                                        </p>
                                    </div>
                                    <div class="rqw-ws-badges">
                                        <span class="rqw-type-pill">@TypeLabel(r.RequestType)</span>
                                        @*  The SAME sentence and the SAME four
                                            statuses the row carries, in the
                                            workspace's shared colour roles.
                                            StateTone is a fold of StatusClass,
                                            not a second mapping — "אצל המנחה"
                                            stays neutral grey and never takes
                                            the attention rose, because a request
                                            with the mentor is not the lecturer's
                                            move.  *@
                                        <span class="rqw-ws-state rqw-ws-state-@StateTone(r)">@RowTimeLabel(r)</span>
                                    </div>
                                </div>

                                <!-- ── WORKSPACE BODY ── -->
                                <div class="rqw-ws-body">

                                    <!-- Description -->
                                    @if (!string.IsNullOrWhiteSpace(detail?.Description))
                                    {
                                        <div class="rqw-ws-section">
                                            <p class="rqw-ws-section-label">תיאור הבקשה</p>
                                            <p class="rqw-desc">@detail.Description</p>
                                        </div>
                                    }

                                    <!-- Extension: deadline dates comparison -->
                                    @if (detail?.RequestType == RequestTypes.Extension && detail.Extension is { } ext)
                                    {
                                        <div class="rqw-ws-section">
                                            <p class="rqw-ws-section-label">מועדי הגשה</p>
                                            <div class="rqw-dates-wrap">
                                                <div class="rqw-dates" aria-label="מועדי הגשה">
                                                    <div class="rqw-date-col">
                                                        <span class="rqw-date-val">@ExtDate(ext.CurrentDueDate)</span>
                                                        <span class="rqw-date-lbl">מועד נוכחי</span>
                                                    </div>
                                                    <span class="rqw-date-arrow" aria-hidden="true">←</span>
                                                    <div class="rqw-date-col">
                                                        <span class="rqw-date-val rqw-date-val-req">@ExtDate(ext.RequestedDueDate)</span>
                                                        <span class="rqw-date-lbl rqw-date-lbl-req">מועד מבוקש</span>
                                                    </div>
                                                </div>
                                            </div>
                                            @if (!string.IsNullOrWhiteSpace(ext.TaskTitle) || !string.IsNullOrWhiteSpace(ext.MilestoneTitle))
                                            {
                                                <p class="rqw-ext-target">יעד: @(ext.TaskTitle ?? ext.MilestoneTitle)</p>
                                            }
                                        </div>
                                    }

                                    <!-- Attachments -->
                                    @if (detail?.Attachments?.Count > 0)
                                    {
                                        <div class="rqw-files">
                                            @foreach (var att in detail.Attachments)
                                            {
                                                <a class="rqw-file"
                                                   href="request-attachments/@att.StoredFileName"
                                                   target="_blank" rel="noopener noreferrer">
                                                    📎 @att.OriginalFileName
                                                </a>
                                            }
                                        </div>
                                    }
                                    else if (detail is null && r.AttachmentCount > 0)
                                    {
                                        <p class="rqw-attach-count">📎 @r.AttachmentCount @(r.AttachmentCount == 1 ? "קובץ מצורף" : "קבצים מצורפים")</p>
                                    }

                                    <!-- Mentor recommendation panel -->
                                    @if (detail?.Extension is { } mentorExt &&
                                         !string.IsNullOrEmpty(mentorExt.MentorDecision) &&
                                         mentorExt.MentorDecision != ExtensionDecisionStatuses.Pending)
                                    {
                                        <div class="lrq-mentor-rec">
                                            <div class="lrq-mentor-rec-head">
                                                <span class="lrq-mentor-rec-label">המלצת המנחה</span>
                                                <span class="lrq-mentor-rec-decision lrq-mentor-dec-@mentorExt.MentorDecision.ToLower()">
                                                    @ExtensionDecisionStatuses.Label(mentorExt.MentorDecision)
                                                </span>
                                                @if (!string.IsNullOrWhiteSpace(mentorExt.MentorDecidedByName))
                                                {
                                                    <span class="lrq-mentor-rec-by">@mentorExt.MentorDecidedByName</span>
                                                }
                                            </div>
                                            @if (!string.IsNullOrWhiteSpace(mentorExt.MentorNotes))
                                            {
                                                <p class="lrq-mentor-rec-note">@mentorExt.MentorNotes</p>
                                            }
                                        </div>
                                    }

                                    <!-- Decision area -->
                                    @{
                                        var isDoneReq       = r.Status is RequestStatuses.Resolved or RequestStatuses.Closed;
                                        var isMentorPending = r.Status == RequestStatuses.PendingMentorRecommendation;
                                        var currentChoice   = _decisionChoice.TryGetValue(r.Id, out var ch) ? ch : "";
                                        var currentNote     = _decisionNote.TryGetValue(r.Id, out var n) ? n : "";
                                        var isSubmitting    = _submitting.Contains(r.Id);
                                        var submitError     = _submitErrors.TryGetValue(r.Id, out var e) ? e : null;
                                    }

                                    @if (isDoneReq)
                                    {
                                        <!-- ── RESOLVED / CLOSED: show final status only ── -->
                                        var lecDec      = detail?.Extension?.LecturerDecision;
                                        var finalStatus = RequestStatuses.Label(r.Status);
                                        <div class="lrq-decision-done">
                                            <span class="lrq-decision-done-label">סטטוס:</span>
                                            <span class="lrq-decision-done-val">@finalStatus</span>
                                            @if (!string.IsNullOrWhiteSpace(lecDec)
                                                 && lecDec != ExtensionDecisionStatuses.NotRequired
                                                 && lecDec != ExtensionDecisionStatuses.Pending)
                                            {
                                                <span class="lrq-decision-done-dec">@ExtensionDecisionStatuses.Label(lecDec)</span>
                                            }
                                        </div>
                                    }
                                    else if (isMentorPending)
                                    {
                                        <!-- ── WAITING FOR MENTOR: no lecturer action yet ── -->
                                        <div class="lrq-decision-waiting">
                                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                                 stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                                <circle cx="12" cy="12" r="10"/>
                                                <path d="M12 6v6l4 2"/>
                                            </svg>
                                            <span>הבקשה ממתינה להמלצת המנחה. ההחלטה שלך תיפתח לאחר קבלת ההמלצה.</span>
                                        </div>
                                    }
                                    else
                                    {
                                        <!-- ── ACTIVE DECISION FORM ── -->
                                        <div class="lrq-decision">
                                            <p class="lrq-decision-title">החלטה</p>

                                            <div class="lrq-choices" role="radiogroup" aria-label="בחר החלטה">
                                                <button type="button"
                                                        class="lrq-choice @(currentChoice == "approved" ? "lrq-choice-approved" : "")"
                                                        role="radio"
                                                        aria-checked="@(currentChoice == "approved")"
                                                        disabled="@isSubmitting"
                                                        @onclick='@(() => SetChoice(r.Id, "approved"))'>
                                                    <span class="lrq-choice-mark" aria-hidden="true">
                                                        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                                             stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                                                            <path d="m5 13 4.5 4.5L19 7"/>
                                                        </svg>
                                                    </span>
                                                    אישור
                                                </button>
                                                <button type="button"
                                                        class="lrq-choice @(currentChoice == "rejected" ? "lrq-choice-rejected" : "")"
                                                        role="radio"
                                                        aria-checked="@(currentChoice == "rejected")"
                                                        disabled="@isSubmitting"
                                                        @onclick='@(() => SetChoice(r.Id, "rejected"))'>
                                                    <span class="lrq-choice-mark" aria-hidden="true">
                                                        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                                             stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                                                            <path d="M18 6 6 18M6 6l12 12"/>
                                                        </svg>
                                                    </span>
                                                    דחייה
                                                </button>
                                                <button type="button"
                                                        class="lrq-choice @(currentChoice == "return" ? "lrq-choice-return" : "")"
                                                        role="radio"
                                                        aria-checked="@(currentChoice == "return")"
                                                        disabled="@isSubmitting"
                                                        @onclick='@(() => SetChoice(r.Id, "return"))'>
                                                    <span class="lrq-choice-mark" aria-hidden="true">
                                                        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                                             stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                                                            <path d="M9 14 4 9l5-5M4 9h11a4 4 0 0 1 0 8h-1"/>
                                                        </svg>
                                                    </span>
                                                    החזרה להשלמה
                                                </button>
                                            </div>

                                            <div class="lrq-decision-note-wrap">
                                                <label class="lrq-decision-note-lbl" for="lrq-note-@r.Id">הערה לצוות (אופציונלי)</label>
                                                <textarea id="lrq-note-@r.Id"
                                                          class="lrq-decision-note"
                                                          rows="2"
                                                          maxlength="2000"
                                                          placeholder="הסבר קצר לצוות…"
                                                          disabled="@isSubmitting"
                                                          value="@currentNote"
                                                          @oninput='@(e => SetNote(r.Id, e.Value?.ToString() ?? ""))'></textarea>
                                            </div>

                                            @if (submitError is not null)
                                            {
                                                <p class="lrq-decision-error" role="alert">@submitError</p>
                                            }

                                            <div class="lrq-decision-actions">
                                                <button type="button"
                                                        class="lrq-send-btn motiva-cta"
                                                        disabled="@(isSubmitting || string.IsNullOrEmpty(currentChoice))"
                                                        @onclick='@(() => SubmitDecision(r.Id, r.RequestType, r.Status))'>
                                                    @if (isSubmitting)
                                                    {
                                                        <span class="lrq-send-spinner" aria-hidden="true"></span>
                                                    }
                                                    שליחת ההחלטה
                                                </button>
                                            </div>
                                        </div>
                                    }

                                    <!-- Request history (collapsed by default) -->
                                    @{
                                        var histEvents = detail?.Events ?? new();
                                        var histOpen   = _historyOpen.Contains(r.Id);
                                    }
                                    @if (histEvents.Count > 0)
                                    {
                                        <div class="rqw-ws-footer">
                                            <button type="button"
                                                    class="rqw-hist-btn"
                                                    aria-expanded="@(histOpen ? "true" : "false")"
                                                    @onclick='@(() => ToggleHistory(r.Id))'>
                                                <span>היסטוריה · @histEvents.Count @(histEvents.Count == 1 ? "עדכון" : "עדכונים")</span>
                                                <span class="rqw-hist-caret @(histOpen ? "rqw-hist-caret-open" : "")" aria-hidden="true">
                                                    <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                                         stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                                        <path d="m6 9 6 6 6-6"/>
                                                    </svg>
                                                </span>
                                            </button>
                                        </div>

                                        @if (histOpen)
                                        {
                                            <div class="rqw-hist-items">
                                                @foreach (var evt in histEvents.OrderBy(x => x.CreatedAt))
                                                {
                                                    <div class="rqw-hist-item">
                                                        <span class="rqw-hist-dot" aria-hidden="true"></span>
                                                        <div class="rqw-hist-content">
                                                            <p class="rqw-hist-text">@HistLine(evt)</p>
                                                            @if (evt.EventType == RequestEventTypes.Comment && evt.Attachments.Count > 0)
                                                            {
                                                                <div class="rqw-files">
                                                                    @foreach (var att in evt.Attachments)
                                                                    {
                                                                        <a class="rqw-file"
                                                                           href="request-attachments/@att.StoredFileName"
                                                                           target="_blank" rel="noopener noreferrer">
                                                                            📎 @att.OriginalFileName
                                                                        </a>
                                                                    }
                                                                </div>
                                                            }
                                                        </div>
                                                    </div>
                                                }
                                            </div>
                                        }
                                    }

                                </div>@* rqw-ws-body *@
                            }
                        </div>@* rqw-card *@
                    }
                }

            </main>

        </div>@* rqw-split *@
    }

</div>@* rqw-page *@

@code {
    // ── Deep-link support ─────────────────────────────────────────────────────
    /// <summary>Navigating from the dashboard attention list passes the
    /// request id as ?open=N so it is selected automatically on arrival.</summary>
    [Parameter, SupplyParameterFromQuery(Name = "open")]
    public int? OpenRequestId { get; set; }

    // ── State ─────────────────────────────────────────────────────────────────

    private List<ProjectRequestRowDto> _all = new();
    private readonly Dictionary<int, ProjectRequestDetailDto?> _details       = new();
    private readonly HashSet<int>                               _loadingDetails = new();
    private bool _loading   = true;
    private bool _loadError;

    /// <summary>The currently selected (workspace-shown) request id.</summary>
    private int? _expandedId;

    // Filter
    private string _activeTab     = "decision";   // default: להחלטתך
    private string _selectedType  = "";
    private bool   _typeMenuOpen;

    // Decision form state
    private readonly Dictionary<int, string>  _decisionChoice = new();
    private readonly Dictionary<int, string>  _decisionNote   = new();
    private readonly HashSet<int>             _submitting     = new();
    private readonly Dictionary<int, string?> _submitErrors   = new();

    // History toggle
    private readonly HashSet<int> _historyOpen = new();

    // Scroll-to-anchor after deep-link expand
    private bool _scrollPending;

    // Request type name cache from RequestTypesService
    private Dictionary<string, string> _typeNames = new();

    // ── Lifecycle ─────────────────────────────────────────────────────────────

    protected override async Task OnInitializedAsync()
    {
        var rowsTask  = RequestsService.GetAllAsync();
        var typesTask = RequestTypesService.GetActiveAsync();

        var rows  = await rowsTask;
        var types = await typesTask;

        _loadError = rows is null;
        _all = rows?.OrderByDescending(r => r.UpdatedAt).ToList() ?? new();

        _typeNames = types is null
            ? new()
            : types.Where(t => !string.IsNullOrWhiteSpace(t.Code))
                   .GroupBy(t => t.Code)
                   .ToDictionary(g => g.Key, g => g.First().Name);

        _loading = false;

        // Handle deep-link (?open=N): find the request, switch to its tab, select it.
        if (OpenRequestId is int reqId && _all.Any(r => r.Id == reqId))
        {
            var targetRow = _all.First(r => r.Id == reqId);
            _activeTab = BucketOf(targetRow.Status);

            await SelectRequest(reqId);
            _scrollPending = true;
        }

        // NO auto-selection on a plain page load. The queue opens with nothing
        // chosen and the workspace shows its empty state; only an explicit
        // click (or the ?open=N deep-link above) selects a request.
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_scrollPending && OpenRequestId is int reqId)
        {
            _scrollPending = false;
            await JS.InvokeVoidAsync("gradify.scrollToAnchor", $"request-{reqId}");
        }
    }

    private async Task LoadAsync()
    {
        var rows = await RequestsService.GetAllAsync();
        _loadError = rows is null;
        _all = rows?.OrderByDescending(r => r.UpdatedAt).ToList() ?? new();
    }

    // ── Select request (loads detail, marks read) ─────────────────────────────

    private async Task SelectRequest(int id)
    {
        // Toggle off if already selected
        if (_expandedId == id)
        {
            _expandedId = null;
            return;
        }

        _expandedId = id;

        if (!_details.ContainsKey(id))
        {
            _loadingDetails.Add(id);
            StateHasChanged();

            var detail = await RequestsService.GetByIdAsync(id);
            _details[id] = detail;
            _loadingDetails.Remove(id);

            // Fire-and-forget read receipt — clears the unread indicator
            _ = RequestsService.MarkReadAsync(id);

            var row = _all.FirstOrDefault(r => r.Id == id);
            if (row is not null) row.HasUnread = false;
        }
    }

    // ── Decision form ──────────────────────────────────────────────────────────

    private void SetChoice(int id, string choice)
    {
        _decisionChoice[id] = _decisionChoice.TryGetValue(id, out var c) && c == choice ? "" : choice;
        _submitErrors.Remove(id);
    }

    private void SetNote(int id, string note) => _decisionNote[id] = note;

    private async Task SubmitDecision(int id, string requestType, string currentStatus)
    {
        if (!_decisionChoice.TryGetValue(id, out var choice) || string.IsNullOrEmpty(choice)) return;

        _submitting.Add(id);
        _submitErrors.Remove(id);
        StateHasChanged();

        var note = _decisionNote.TryGetValue(id, out var n) ? n.Trim() : null;
        if (string.IsNullOrEmpty(note)) note = null;

        string? error = null;

        bool isExtensionDecision = requestType == RequestTypes.Extension
            && currentStatus == RequestStatuses.PendingLecturerDecision;

        if (choice == "return")
        {
            error = await RequestsService.HandleAsync(id, new HandleProjectRequestRequest
            {
                NewStatus = RequestStatuses.NeedsInfo,
                NewPriority = RequestPriorities.Normal,
                Comment = note,
            });
        }
        else if (isExtensionDecision)
        {
            var extDecision = choice == "approved"
                ? ExtensionDecisionStatuses.Approved
                : ExtensionDecisionStatuses.Rejected;

            error = await RequestsService.SubmitExtensionDecisionAsync(id, new ExtensionDecisionRequest
            {
                Stage    = "Lecturer",
                Decision = extDecision,
                Notes    = note,
            });
        }
        else
        {
            var newStatus = choice == "approved"
                ? RequestStatuses.Resolved
                : RequestStatuses.Closed;

            error = await RequestsService.HandleAsync(id, new HandleProjectRequestRequest
            {
                NewStatus   = newStatus,
                NewPriority = RequestPriorities.Normal,
                Comment     = note,
            });
        }

        _submitting.Remove(id);

        if (error is not null)
        {
            _submitErrors[id] = error.Trim('"', ' ');
            StateHasChanged();
            return;
        }

        // Success: clear local state for the acted-upon request
        _decisionChoice.Remove(id);
        _decisionNote.Remove(id);
        _details.Remove(id);
        _expandedId = null;

        await LoadAsync();

        // Auto-select the first request in the current visible list, if any
        var next = VisibleItems;
        if (next.Count > 0)
            await SelectRequest(next[0].Id);

        StateHasChanged();
    }

    // ── History toggle ────────────────────────────────────────────────────────

    private void ToggleHistory(int id)
    {
        if (!_historyOpen.Remove(id))
            _historyOpen.Add(id);
    }

    // ── Tab / type filter ─────────────────────────────────────────────────────

    private void SetTab(string tab)
    {
        _activeTab  = tab;
        // Switching bucket drops the selection and returns the workspace to
        // its empty state — the reader picks the next request themselves.
        _expandedId = null;
    }

    private void ToggleTypeMenu() => _typeMenuOpen = !_typeMenuOpen;
    private void CloseTypeMenu()  => _typeMenuOpen = false;

    private void PickType(string type)
    {
        _selectedType = type;
        _typeMenuOpen = false;
        // Re-filtering drops the selection for the same reason SetTab does.
        _expandedId   = null;
    }

    // ── Filter tabs ───────────────────────────────────────────────────────────

    /// <summary>
    /// להחלטתך · בטיפול מנחה · טופלו — the lecturer's three buckets, in the
    /// shared MFilterTabs track the student and mentor queues use.
    ///
    /// <para>The keys are the ones <see cref="SetTab"/> and
    /// <see cref="VisibleItems"/> have always switched on, so replacing the
    /// segmented control moved no bucket and no query. The counts are the same
    /// three properties the old badges read, and "טופלו" still carries none —
    /// a history bucket's size is not a number anyone acts on.</para>
    /// </summary>
    private IReadOnlyList<MFilterTabs.Tab> FilterTabs => new[]
    {
        new MFilterTabs.Tab("decision", "להחלטתך",    DecisionCount),
        new MFilterTabs.Tab("mentor",   "בטיפול מנחה", MentorCount),
        new MFilterTabs.Tab("done",     "טופלו"),
    };

    /// <summary>Re-reads the queue after a failed load. Separate from
    /// <see cref="LoadAsync"/> only because the empty state's retry has to clear
    /// the error flag and put the spinner back.</summary>
    private async Task ReloadAsync()
    {
        _loading   = true;
        _loadError = false;
        StateHasChanged();

        await LoadAsync();
        _loading = false;
    }

    // ── Bucket / status logic ─────────────────────────────────────────────────

    private static string BucketOf(string status) => status switch
    {
        RequestStatuses.PendingMentorRecommendation => "mentor",
        RequestStatuses.Resolved or RequestStatuses.Closed => "done",
        _ => "decision",
    };

    private static string StatusClass(ProjectRequestRowDto r) =>
        r.Status is RequestStatuses.New
                 or RequestStatuses.WaitingForStaff
                 or RequestStatuses.PendingLecturerDecision
            ? "attention"
            : BucketOf(r.Status);

    /// <summary>
    /// The record header's status badge, in the shared workspace's colour roles
    /// (`rqw-ws-state-*`). A FOLD of <see cref="StatusClass"/>, not a second
    /// mapping — it renames the four values that class already produces onto
    /// the roles the three request queues share.
    ///
    /// <para>"בטיפול מנחה" stays NEUTRAL and never takes the attention rose: a
    /// request waiting on the mentor is not the lecturer's move, and rose is
    /// reserved on every one of these screens for the request that is.</para>
    /// </summary>
    private static string StateTone(ProjectRequestRowDto r) => StatusClass(r) switch
    {
        "attention" => "attention",
        "mentor"    => "neutral",
        "done"      => "done",
        _           => "brand",
    };

    // When a specific request type is selected the three tab counts represent
    // only that type. "הכל" (empty _selectedType) restores the global totals.
    // The active status tab never affects the other tabs' numbers — each
    // counter is derived from all requests (or all of the selected type),
    // not from the already-filtered visible list.
    private IEnumerable<ProjectRequestRowDto> TypeFilteredAll =>
        string.IsNullOrEmpty(_selectedType)
            ? _all
            : _all.Where(r => r.RequestType == _selectedType);

    private int DecisionCount =>
        TypeFilteredAll.Count(r => BucketOf(r.Status) == "decision");

    private int MentorCount =>
        TypeFilteredAll.Count(r => BucketOf(r.Status) == "mentor");

    private int DoneCount =>
        TypeFilteredAll.Count(r => BucketOf(r.Status) == "done");

    // ── Visible items (flat list for the sidebar) ─────────────────────────────

    private List<ProjectRequestRowDto> VisibleItems
    {
        get
        {
            var byType = string.IsNullOrEmpty(_selectedType)
                ? _all
                : _all.Where(r => r.RequestType == _selectedType).ToList();

            return _activeTab switch
            {
                "decision" => byType.Where(r => BucketOf(r.Status) == "decision").ToList(),
                "mentor"   => byType.Where(r => BucketOf(r.Status) == "mentor").ToList(),
                "done"     => byType.Where(r => BucketOf(r.Status) == "done").ToList(),
                _          => byType,  // "all" — only used internally (deep-link compat)
            };
        }
    }

    // ── Types ─────────────────────────────────────────────────────────────────

    private string TypeLabel(string code) =>
        _typeNames.TryGetValue(code, out var name) && !string.IsNullOrWhiteSpace(name)
            ? name
            : RequestTypes.Label(code);

    private List<string> AvailableTypes =>
        RequestTypes.All
            .Where(t => _all.Any(r => r.RequestType == t))
            .ToList();

    // ── Row presentation ──────────────────────────────────────────────────────

    /// <summary>
    /// WHOSE REQUEST THIS IS, on a screen that reviews teams.
    ///
    /// <para>The lecturer's unit of work is the team: the decision lands on the
    /// team's deadline, the note is addressed to the team, and any member of it
    /// may have typed the request. So the queue and the record both name the
    /// TEAM where the student's own workspace names the handling role — the
    /// submitter is provenance and lives further down the record.</para>
    ///
    /// <para>Falls back to the project, which is the same team said another
    /// way, and only then to an em dash. TeamName is already on
    /// <see cref="ProjectRequestRowDto"/> and already filled by
    /// ProjectRequestsController.GetAll (<c>t.TeamName</c>), so this needed no
    /// endpoint, DTO or query change.</para>
    /// </summary>
    private static string TeamIdentity(ProjectRequestRowDto r) =>
        !string.IsNullOrWhiteSpace(r.TeamName)     ? r.TeamName!
      : !string.IsNullOrWhiteSpace(r.ProjectTitle) ? r.ProjectTitle
      :                                              "—";

    private string RowTimeLabel(ProjectRequestRowDto r) => BucketOf(r.Status) switch
    {
        "decision" when r.Status == RequestStatuses.PendingLecturerDecision
            => "ממתינה להחלטתך",
        "decision"
            => r.HasUnread ? "עדכון חדש" : $"עודכנה {r.UpdatedAt:dd.MM}",
        "mentor"
            => "אצל המנחה",
        "done"
            => $"טופל · {r.UpdatedAt:dd.MM}",
        _ => $"{r.UpdatedAt:dd.MM}",
    };

    // ── History line helper ───────────────────────────────────────────────────

    private static string HistLine(ProjectRequestEventDto e) => e.EventType switch
    {
        RequestEventTypes.Comment =>
            !string.IsNullOrWhiteSpace(e.Content)
                ? $"{e.UserName} · {e.CreatedAt:dd.MM · HH:mm} — {e.Content}"
                : $"{e.UserName} · {e.CreatedAt:dd.MM · HH:mm}",
        RequestEventTypes.StatusChange =>
            $"{e.UserName} · סטטוס שונה ל: {e.NewValue} · {e.CreatedAt:dd.MM}",
        _ =>
            $"{e.UserName} · {e.CreatedAt:dd.MM}",
    };

    // ── Extension date helpers ────────────────────────────────────────────────

    private static string ExtDate(DateTime? dt) => dt?.ToString("dd.MM.yyyy") ?? "—";
    private static string ExtDate(DateTime dt)  => dt.ToString("dd.MM.yyyy");
}