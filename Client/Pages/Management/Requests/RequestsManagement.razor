@*
    ── בקשות — Lecturer Request Queue ──────────────────────────────────────
    Visual source:  design/design-system/MotivaLecturerDesign/
                    Motiva Lecturer Requests.dc.html
                    בקשות מרצה 268.pdf

    ARCHITECTURE
    ─────────────
    This page is the lecturer/staff equivalent of MentorRequestsPage.
    It replaces the legacy table+modal view with the Motiva accordion design
    that mirrors the finalized Student and Mentor request screens.

    TABS
    ────
      הכל              → all requests
      להחלטתך (N)     → PendingLecturerDecision + New + InProgress + WaitingForStaff
                          badge shows the count
      בטיפול מנחה     → PendingMentorRecommendation
      טופלו           → Resolved + Closed

    DECISION FLOW
    ─────────────
    Extension requests at PendingLecturerDecision:
        SubmitExtensionDecisionAsync(id, {Stage=Lecturer, Decision=Approved/Rejected})
        "החזרה להשלמה" → HandleAsync(id, {NewStatus=NeedsInfo})

    All other requests (New / InProgress / WaitingForStaff):
        אישור     → HandleAsync(id, {NewStatus=Resolved})
        דחייה     → HandleAsync(id, {NewStatus=Closed})
        החזרה     → HandleAsync(id, {NewStatus=NeedsInfo})
*@

@page "/management/requests"
@layout AppLayout
@attribute [Authorize(Roles = Roles.Admin + "," + Roles.Staff)]
@namespace AuthWithAdmin.Client.Pages.Management.Requests
@using Microsoft.AspNetCore.Authorization
@using AuthWithAdmin.Client.Services
@using AuthWithAdmin.Shared.AuthSharedModels

@inject IProjectRequestsService RequestsService
@inject IRequestTypesService RequestTypesService

<div class="lrq-page" dir="rtl">

    <!-- ── Title row — same structure as Teams / Submissions pages ── -->
    <div class="lrq-title-row">
        <div class="lrq-title-block">
            <h1 class="lrq-h1">בקשות</h1>
        </div>

        @if (!_loading)
        {
            <div class="lrq-tabbar">
                <!-- Status tabs -->
                <nav class="lrq-tabs" aria-label="סינון לפי סטטוס">
                    <button type="button"
                            class="@TabClass("all")"
                            aria-pressed="@(_activeTab == "all")"
                            @onclick="@(() => SetTab("all"))">
                        הכל
                    </button>
                    <button type="button"
                            class="@TabClass("decision")"
                            aria-pressed="@(_activeTab == "decision")"
                            @onclick="@(() => SetTab("decision"))">
                        ממתינות להחלטתך
                        @if (DecisionCount > 0)
                        {
                            <span class="lrq-tab-badge" aria-label="@DecisionCount בקשות ממתינות">@DecisionCount</span>
                        }
                    </button>
                    <button type="button"
                            class="@TabClass("mentor")"
                            aria-pressed="@(_activeTab == "mentor")"
                            @onclick="@(() => SetTab("mentor"))">
                        בטיפול מנחה
                    </button>
                    <button type="button"
                            class="@TabClass("done")"
                            aria-pressed="@(_activeTab == "done")"
                            @onclick="@(() => SetTab("done"))">
                        טופלו
                    </button>
                </nav>

                @if (AvailableTypes.Count > 0)
                {
                    <span class="lrq-tabbar-sep" aria-hidden="true"></span>

                    <div class="lrq-type-wrap">
                        <button type="button"
                                class="lrq-type-btn @(!string.IsNullOrEmpty(_selectedType) ? "lrq-type-btn-active" : "")"
                                @onclick="ToggleTypeMenu">
                            @(!string.IsNullOrEmpty(_selectedType) ? TypeLabel(_selectedType) : "סוג בקשה")
                            <span class="lrq-type-caret @(_typeMenuOpen ? "lrq-type-caret-open" : "")">▾</span>
                        </button>

                        @if (_typeMenuOpen)
                        {
                            <div class="lrq-type-backdrop" @onclick="CloseTypeMenu"></div>
                            <div class="lrq-type-panel">
                                @{
                                    var allOpt = ("", "הכל");
                                    var allOn = string.IsNullOrEmpty(_selectedType);
                                }
                                <button type="button" class="lrq-type-opt @(allOn ? "lrq-type-opt-on" : "")"
                                        @onclick="@(() => PickType(""))">
                                    <span class="lrq-type-opt-label">הכל</span>
                                    @if (allOn)
                                    {
                                        <svg class="lrq-type-check" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#6D28F5" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="m5 12.5 4.5 4.5L19 7"/>
                                        </svg>
                                    }
                                </button>
                                @foreach (var type in AvailableTypes)
                                {
                                    var t = type;
                                    var on = _selectedType == t;
                                    <button type="button" class="lrq-type-opt @(on ? "lrq-type-opt-on" : "")"
                                            @onclick="@(() => PickType(t))">
                                        <span class="lrq-type-opt-label">@TypeLabel(t)</span>
                                        @if (on)
                                        {
                                            <svg class="lrq-type-check" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#6D28F5" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round">
                                                <path d="m5 12.5 4.5 4.5L19 7"/>
                                            </svg>
                                        }
                                    </button>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        }
    </div>

    <!-- ── Body ── -->
    @if (_loading)
    {
        <div class="lrq-loading" role="status">
            <span class="lrq-spinner" aria-hidden="true"></span>
            <span>טוענת בקשות…</span>
        </div>
    }
    else if (_loadError)
    {
        <MEmptyState Title="אירעה שגיאה בטעינת הבקשות" Description="נסה לרענן את הדף." />
    }
    else
    {

        @if (_all.Count == 0)
        {
            <MEmptyState Title="אין בקשות במערכת" Description="כשסטודנטים יגישו בקשות הן יופיעו כאן." />
        }
        else
        {
            var groups = VisibleGroups;
            var totalVisible = groups.Sum(g => g.Items.Count);

            @if (totalVisible == 0)
            {
                <MEmptyState Title="אין בקשות שתואמות לסינון הנוכחי"
                             Description="אפשר לשנות את הסינון כדי לראות בקשות נוספות."
                             Live="true">
                    <Action>
                        <MButton Variant="MButton.ButtonVariant.Secondary" OnClick="ClearFilters">
                            הצגת כל הבקשות
                        </MButton>
                    </Action>
                </MEmptyState>
            }
            else
            {
                <div class="lrq-groups">
                    @foreach (var group in groups)
                    {
                        var g = group;
                        var isDone = g.Bucket == "done";

                        @if (!isDone || _doneOpen || g.Items.Count == 0)
                        {
                            <!-- Group container -->
                            <div class="lrq-group lrq-group-@g.Bucket">

                                <!-- Group header -->
                                <div class="lrq-group-head">
                                    <span class="lrq-group-label">@g.Label</span>
                                    @if (g.Items.Count > 0)
                                    {
                                        <span class="lrq-group-count">@g.Items.Count @(g.Items.Count == 1 ? "בקשה" : "בקשות")</span>
                                    }
                                    @if (isDone && _doneOpen)
                                    {
                                        <button type="button" class="lrq-done-toggle" @onclick="@(() => _doneOpen = false)">
                                            הסתר
                                        </button>
                                    }
                                </div>

                                @if (g.Items.Count == 0)
                                {
                                    <p class="lrq-group-empty">אין בקשות בקבוצה זו</p>
                                }
                                else
                                {
                                    @foreach (var row in g.Items)
                                    {
                                        var r = row;
                                        var isOpen = _expandedId == r.Id;
                                        var detail = _details.TryGetValue(r.Id, out var d) ? d : null;

                                        <div class="lrq-row-wrap @(isOpen ? "lrq-row-wrap-open" : "")">

                                            @if (!isOpen)
                                            {
                                                <!-- ── COLLAPSED ROW ── -->
                                                <div class="lrq-row"
                                                     role="button"
                                                     tabindex="0"
                                                     aria-expanded="false"
                                                     aria-label="@($"פתיחת הבקשה: {r.Title}")"
                                                     @onclick="@(() => Toggle(r.Id))"
                                                     @onkeydown="@(e => { if (e.Key == "Enter" || e.Key == " ") Toggle(r.Id); })">

                                                    <div class="lrq-row-right">
                                                        <span class="lrq-dot lrq-dot-@BucketOf(r.Status)" aria-hidden="true"></span>
                                                        <div class="lrq-row-text">
                                                            <div class="lrq-row-titlerow">
                                                                @if (r.HasUnread)
                                                                {
                                                                    <span class="lrq-unread" title="עדכון חדש שלא נקרא" aria-label="עדכון חדש"></span>
                                                                }
                                                                <strong class="lrq-row-title">@r.Title</strong>
                                                            </div>
                                                            <span class="lrq-row-sub">@RowSubLine(r)</span>
                                                        </div>
                                                    </div>

                                                    <div class="lrq-row-left">
                                                        <span class="lrq-row-time lrq-row-time-@BucketOf(r.Status)">@RowTimeLabel(r)</span>
                                                        <span class="lrq-chevron" aria-hidden="true">
                                                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                                                 stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
                                                                <path d="m6 9 6 6 6-6"/>
                                                            </svg>
                                                        </span>
                                                    </div>
                                                </div>
                                            }
                                            else
                                            {
                                                <!-- ── EXPANDED CARD ── -->
                                                <div class="lrq-card" role="region" aria-label="@r.Title">

                                                    @if (detail is null && _loadingDetails.Contains(r.Id))
                                                    {
                                                        <div class="lrq-detail-loading" role="status">
                                                            <span class="lrq-spinner" aria-hidden="true"></span>
                                                            <span>טוענת פרטי בקשה…</span>
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        @* 1. CARD HEADER: title + meta + close *@
                                                        <div class="lrq-card-head">
                                                            <div class="lrq-card-htext">
                                                                <h2 class="lrq-card-title">@r.Title</h2>
                                                                <p class="lrq-card-meta">
                                                                    <span class="lrq-type-pill">@TypeLabel(r.RequestType)</span>
                                                                    <span class="lrq-meta-sep">·</span>
                                                                    <span class="lrq-meta-requester">@r.CreatedByName</span>
                                                                    @if (!string.IsNullOrWhiteSpace(r.TeamName))
                                                                    {
                                                                        <span class="lrq-meta-sep">·</span>
                                                                        <span class="lrq-meta-team">@r.TeamName</span>
                                                                    }
                                                                    @if (!string.IsNullOrWhiteSpace(r.ProjectTitle))
                                                                    {
                                                                        <span class="lrq-meta-sep">·</span>
                                                                        <span class="lrq-meta-project">@r.ProjectTitle</span>
                                                                    }
                                                                </p>
                                                            </div>
                                                            <button type="button"
                                                                    class="lrq-card-close"
                                                                    aria-label="סגירה"
                                                                    @onclick="@(() => Toggle(r.Id))">
                                                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                                                     stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                                                    <path d="m18 15-6-6-6 6"/>
                                                                </svg>
                                                            </button>
                                                        </div>

                                                        <div class="lrq-card-body">

                                                            @* 3. EXPLANATION *@
                                                            @{
                                                                var explanation = detail?.Description ?? r.Title;
                                                            }
                                                            @if (!string.IsNullOrWhiteSpace(detail?.Description))
                                                            {
                                                                <p class="lrq-desc">@detail.Description</p>
                                                            }

                                                            @* 4. CONTEXTUAL INFO: DEADLINE DATES (Extension) *@
                                                            @if (detail?.RequestType == RequestTypes.Extension && detail.Extension is { } ext)
                                                            {
                                                                <div class="lrq-dates-wrap">
                                                                    <div class="lrq-dates" aria-label="מועדי הגשה">
                                                                        <div class="lrq-date-col">
                                                                            <span class="lrq-date-val">@ExtDate(ext.CurrentDueDate)</span>
                                                                            <span class="lrq-date-lbl">מועד נוכחי</span>
                                                                        </div>
                                                                        <span class="lrq-date-arrow" aria-hidden="true">←</span>
                                                                        <div class="lrq-date-col">
                                                                            <span class="lrq-date-val lrq-date-val-req">@ExtDate(ext.RequestedDueDate)</span>
                                                                            <span class="lrq-date-lbl lrq-date-lbl-req">מועד מבוקש</span>
                                                                        </div>
                                                                    </div>
                                                                </div>

                                                                @if (!string.IsNullOrWhiteSpace(ext.TaskTitle) || !string.IsNullOrWhiteSpace(ext.MilestoneTitle))
                                                                {
                                                                    <p class="lrq-ext-target">
                                                                        יעד: @(ext.TaskTitle ?? ext.MilestoneTitle)
                                                                    </p>
                                                                }
                                                            }

                                                            @* 4b. Attachments count *@
                                                            @if ((detail?.Attachments?.Count ?? r.AttachmentCount) > 0)
                                                            {
                                                                var cnt = detail?.Attachments?.Count ?? r.AttachmentCount;
                                                                <p class="lrq-attach-count">📎 @cnt @(cnt == 1 ? "קובץ מצורף" : "קבצים מצורפים")</p>
                                                            }

                                                            @* 5. MENTOR RECOMMENDATION PANEL *@
                                                            @if (detail?.Extension is { } mentorExt &&
                                                                 !string.IsNullOrEmpty(mentorExt.MentorDecision) &&
                                                                 mentorExt.MentorDecision != ExtensionDecisionStatuses.Pending)
                                                            {
                                                                <div class="lrq-mentor-rec">
                                                                    <div class="lrq-mentor-rec-head">
                                                                        <span class="lrq-mentor-rec-label">המלצת המנחה</span>
                                                                        <span class="lrq-mentor-rec-decision lrq-mentor-dec-@mentorExt.MentorDecision.ToLower()">
                                                                            @ExtensionDecisionStatuses.Label(mentorExt.MentorDecision)
                                                                        </span>
                                                                        @if (!string.IsNullOrWhiteSpace(mentorExt.MentorDecidedByName))
                                                                        {
                                                                            <span class="lrq-mentor-rec-by">@mentorExt.MentorDecidedByName</span>
                                                                        }
                                                                    </div>
                                                                    @if (!string.IsNullOrWhiteSpace(mentorExt.MentorNotes))
                                                                    {
                                                                        <p class="lrq-mentor-rec-note">@mentorExt.MentorNotes</p>
                                                                    }
                                                                </div>
                                                            }

                                                            @* 6. LECTURER DECISION AREA *@
                                                            @{
                                                                var isDoneReq = r.Status is RequestStatuses.Resolved or RequestStatuses.Closed;
                                                                var isMentorPending = r.Status == RequestStatuses.PendingMentorRecommendation;
                                                                var currentChoice = _decisionChoice.TryGetValue(r.Id, out var ch) ? ch : "";
                                                                var currentNote = _decisionNote.TryGetValue(r.Id, out var n) ? n : "";
                                                                var isSubmitting = _submitting.Contains(r.Id);
                                                                var submitError = _submitErrors.TryGetValue(r.Id, out var e) ? e : null;
                                                            }

                                                            @if (isDoneReq)
                                                            {
                                                                @* Show the recorded decision *@
                                                                var lecDec = detail?.Extension?.LecturerDecision;
                                                                var finalStatus = RequestStatuses.Label(r.Status);
                                                                <div class="lrq-decision-done">
                                                                    <span class="lrq-decision-done-label">סטטוס:</span>
                                                                    <span class="lrq-decision-done-val lrq-status-@r.Status.ToLower()">@finalStatus</span>
                                                                    @if (!string.IsNullOrWhiteSpace(lecDec) && lecDec != ExtensionDecisionStatuses.NotRequired && lecDec != ExtensionDecisionStatuses.Pending)
                                                                    {
                                                                        <span class="lrq-decision-done-dec">@ExtensionDecisionStatuses.Label(lecDec)</span>
                                                                    }
                                                                </div>
                                                            }
                                                            else if (isMentorPending)
                                                            {
                                                                <div class="lrq-decision-waiting">
                                                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                                                         stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                                                        <circle cx="12" cy="12" r="10"/>
                                                                        <path d="M12 6v6l4 2"/>
                                                                    </svg>
                                                                    <span>הבקשה ממתינה להמלצת המנחה. ההחלטה שלך תיפתח לאחר קבלת ההמלצה.</span>
                                                                </div>
                                                            }
                                                            else
                                                            {
                                                                @* Active decision form *@
                                                                <div class="lrq-decision">
                                                                    <p class="lrq-decision-title">החלטה</p>

                                                                    @* Decision option pills *@
                                                                    <div class="lrq-choices" role="radiogroup" aria-label="בחר החלטה">
                                                                        <button type="button"
                                                                                class="lrq-choice @(currentChoice == "approved" ? "lrq-choice-approved" : "")"
                                                                                role="radio"
                                                                                aria-checked="@(currentChoice == "approved")"
                                                                                disabled="@isSubmitting"
                                                                                @onclick="@(() => SetChoice(r.Id, "approved"))">
                                                                            <span class="lrq-choice-mark" aria-hidden="true">
                                                                                <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                                                                     stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                                                                                    <path d="m5 13 4.5 4.5L19 7"/>
                                                                                </svg>
                                                                            </span>
                                                                            אישור
                                                                        </button>
                                                                        <button type="button"
                                                                                class="lrq-choice @(currentChoice == "rejected" ? "lrq-choice-rejected" : "")"
                                                                                role="radio"
                                                                                aria-checked="@(currentChoice == "rejected")"
                                                                                disabled="@isSubmitting"
                                                                                @onclick="@(() => SetChoice(r.Id, "rejected"))">
                                                                            <span class="lrq-choice-mark" aria-hidden="true">
                                                                                <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                                                                     stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                                                                                    <path d="M18 6 6 18M6 6l12 12"/>
                                                                                </svg>
                                                                            </span>
                                                                            דחייה
                                                                        </button>
                                                                        <button type="button"
                                                                                class="lrq-choice @(currentChoice == "return" ? "lrq-choice-return" : "")"
                                                                                role="radio"
                                                                                aria-checked="@(currentChoice == "return")"
                                                                                disabled="@isSubmitting"
                                                                                @onclick="@(() => SetChoice(r.Id, "return"))">
                                                                            <span class="lrq-choice-mark" aria-hidden="true">
                                                                                <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                                                                     stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                                                                                    <path d="M9 14 4 9l5-5M4 9h11a4 4 0 0 1 0 8h-1"/>
                                                                                </svg>
                                                                            </span>
                                                                            החזרה להשלמה
                                                                        </button>
                                                                    </div>

                                                                    @* Optional note to team *@
                                                                    <div class="lrq-decision-note-wrap">
                                                                        <label class="lrq-decision-note-lbl" for="lrq-note-@r.Id">הערה לצוות (אופציונלי)</label>
                                                                        <textarea id="lrq-note-@r.Id"
                                                                                  class="lrq-decision-note"
                                                                                  rows="2"
                                                                                  maxlength="2000"
                                                                                  placeholder="הסבר קצר לצוות…"
                                                                                  disabled="@isSubmitting"
                                                                                  value="@currentNote"
                                                                                  @oninput="@(e => SetNote(r.Id, e.Value?.ToString() ?? ""))"></textarea>
                                                                    </div>

                                                                    @if (submitError is not null)
                                                                    {
                                                                        <p class="lrq-decision-error" role="alert">@submitError</p>
                                                                    }

                                                                    @* Gradient CTA *@
                                                                    <div class="lrq-decision-actions">
                                                                        <button type="button"
                                                                                class="lrq-send-btn"
                                                                                disabled="@(isSubmitting || string.IsNullOrEmpty(currentChoice))"
                                                                                @onclick="@(() => SubmitDecision(r.Id, r.RequestType, r.Status))">
                                                                            @if (isSubmitting)
                                                                            {
                                                                                <span class="lrq-send-spinner" aria-hidden="true"></span>
                                                                            }
                                                                            שליחת ההחלטה
                                                                        </button>
                                                                    </div>
                                                                </div>
                                                            }

                                                            @* 7. REQUEST HISTORY — collapsed by default *@
                                                            @{
                                                                var histEvents = detail?.Events ?? new();
                                                                var histOpen = _historyOpen.Contains(r.Id);
                                                            }
                                                            @if (histEvents.Count > 0)
                                                            {
                                                                <div class="lrq-hist-bar">
                                                                    <button type="button"
                                                                            class="lrq-hist-btn"
                                                                            aria-expanded="@(histOpen ? "true" : "false")"
                                                                            @onclick="@(() => ToggleHistory(r.Id))">
                                                                        <span>היסטוריה · @histEvents.Count @(histEvents.Count == 1 ? "עדכון" : "עדכונים")</span>
                                                                        <span class="lrq-hist-caret @(histOpen ? "lrq-hist-caret-open" : "")" aria-hidden="true">
                                                                            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                                                                 stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                                                                <path d="m6 9 6 6 6-6"/>
                                                                            </svg>
                                                                        </span>
                                                                    </button>
                                                                </div>

                                                                @if (histOpen)
                                                                {
                                                                    <div class="lrq-hist-items">
                                                                        @foreach (var evt in histEvents.OrderBy(x => x.CreatedAt))
                                                                        {
                                                                            <div class="lrq-hist-item">
                                                                                <span class="lrq-hist-dot" aria-hidden="true"></span>
                                                                                <div class="lrq-hist-content">
                                                                                    <p class="lrq-hist-text">@HistLine(evt)</p>
                                                                                    @if (evt.EventType == RequestEventTypes.Comment && evt.Attachments.Count > 0)
                                                                                    {
                                                                                        <div class="lrq-hist-files">
                                                                                            @foreach (var att in evt.Attachments)
                                                                                            {
                                                                                                <a class="lrq-hist-file"
                                                                                                   href="/request-attachments/@att.StoredFileName"
                                                                                                   target="_blank" rel="noopener noreferrer">
                                                                                                    📎 @att.OriginalFileName
                                                                                                </a>
                                                                                            }
                                                                                        </div>
                                                                                    }
                                                                                </div>
                                                                            </div>
                                                                        }
                                                                    </div>
                                                                }
                                                            }

                                                        </div>@* lrq-card-body *@
                                                    }
                                                </div>@* lrq-card *@
                                            }

                                        </div>@* lrq-row-wrap *@
                                    }
                                }

                            </div>@* lrq-group *@
                        }

                        @* "טופלו" toggle — shows only when done group is collapsed *@
                        @if (isDone && g.Items.Count > 0 && !_doneOpen)
                        {
                            <div class="lrq-done-toggle-wrap">
                                <div class="lrq-group lrq-group-done">
                                    <div class="lrq-group-head">
                                        <span class="lrq-group-label">@g.Label</span>
                                        <span class="lrq-group-count">@g.Items.Count @(g.Items.Count == 1 ? "בקשה" : "בקשות")</span>
                                        <button type="button" class="lrq-done-toggle" @onclick="@(() => _doneOpen = true)">
                                            הצגה
                                        </button>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                </div>
