@*
    ── מחזורים אקדמיים (Admin Academic Cycles) ──────────────────────────────
    Route:  /management/cycles  — reached from the ניהול hub.

    Visual source:
        design/design-system/Motiva Admin Cycle Detail.dc.html  (the detail
        screen; this list is its parent and adopts the same language)
        Client/Pages/Management/Users/UsersManagement.razor     (the finished
        Admin list this page is brought into line with)

    WHAT CHANGED, AND WHY
    ─────────────────────
    Everything here is the same data and the same business actions as before.
    What was replaced is the presentation: the page was on the legacy --g-*
    ramp with an inline form panel, `oi` icons and a hand-rolled <table>. It now
    renders content-only on the Admin canvas shell, uses MDataTable/MSearchField/
    MConfirmDialog like every other finished Management screen, and puts the
    add/edit form in a modal — the shape the reference draws.

    COLUMNS ARE REAL, AND FEWER
    ───────────────────────────
    • DROPPED "מחזור נוכחי" as its own ✓ column. The נוכחי tag beside the name
      already says it, and a column that is empty on every row but one is a
      column of dashes.
    • DROPPED "נוצר". CreatedAt is real but answers nothing an admin acts on.
    • DROPPED the per-row "החל תבניות" button. It is not gone — it moved to the
      Cycle Program actions on the detail screen, which is where the reference
      deliberately places it and where the milestones it applies actually live.
    • ProjectCount is the API's own number (projects with milestones in the
      cycle, via AcademicYearMilestones → ProjectMilestones). Unchanged.

    THE CURRENT CYCLE IS MARKED, NOT SPOTLIT
    ────────────────────────────────────────
    One brand-edged נוכחי tag next to the name — the same --motiva-tag-brand-
    surface every other brand tag in the product uses. No tinted row, no second
    accent: at most one row in the table is current, and the eye finds a single
    tag without help.
*@

@page "/management/cycles"
@layout AppLayout
@attribute [Authorize(Roles = Roles.Admin)]
@using AuthWithAdmin.Client.Services
@using AuthWithAdmin.Shared.AuthSharedModels
@inject NavigationManager Nav
@inject IManagementService ManagementService

@* ══════════════════════════════════════════
     ADD / EDIT CYCLE MODAL
     Fields follow the reference's Edit Cycle modal — name, start, end,
     "מחזור נוכחי" — plus "מחזור פעיל", which the reference has no toggle for
     but SaveAcademicYearRequest.IsActive really carries and the previous form
     really exposed. Dropping it to match a prototype would remove a working
     capability.
     ══════════════════════════════════════════ *@
@if (_showForm)
{
    <div class="cy-modal-overlay" @onclick="CancelForm">
        <div class="cy-modal-box" @onclick:stopPropagation="true" role="dialog" aria-modal="true">
            <div class="cy-modal-header">
                <span class="cy-modal-glyph" aria-hidden="true">
                    <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="4" width="18" height="18" rx="2" />
                        <path d="M16 2v4M8 2v4M3 10h18" />
                    </svg>
                </span>
                <div class="cy-modal-titles">
                    <div class="cy-modal-title">@(_editingId == 0 ? "מחזור חדש" : "עריכת מחזור")</div>
                    <div class="cy-modal-subtitle">
                        @(_editingId == 0 ? "הגדרת מחזור אקדמי חדש במערכת" : _formName)
                    </div>
                </div>
                <button type="button" class="cy-modal-close" @onclick="CancelForm" aria-label="סגירה">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="2.2" stroke-linecap="round" aria-hidden="true">
                        <path d="M18 6 6 18M6 6l12 12" />
                    </svg>
                </button>
            </div>

            <div class="cy-modal-body">
                <div class="cy-form-field">
                    <label class="cy-form-label" for="cy-name">שם מחזור <span class="cy-req">*</span></label>
                    <input id="cy-name" class="cy-form-input" @bind="_formName"
                           placeholder="לדוגמה: 2026-2027" maxlength="50" />
                </div>

                <div class="cy-form-row">
                    <div class="cy-form-field">
                        <label class="cy-form-label" for="cy-start">תאריך התחלה</label>
                        <input id="cy-start" type="date" class="cy-form-input"
                               @bind="_formStart" @bind:format="yyyy-MM-dd" />
                    </div>
                    <div class="cy-form-field">
                        <label class="cy-form-label" for="cy-end">תאריך סיום</label>
                        <input id="cy-end" type="date" class="cy-form-input"
                               @bind="_formEnd" @bind:format="yyyy-MM-dd" />
                    </div>
                </div>

                @* Closed / Archived cycles are immutable server-side
                   (ManagementController rejects the PUT), so the toggles are
                   disabled rather than left to fail on save. *@
                <div class="cy-switch-row">
                    <div class="cy-switch-copy">
                        <span class="cy-switch-title">מחזור נוכחי</span>
                        <span class="cy-switch-note">המחזור המוצג כברירת מחדל במערכת</span>
                    </div>
                    <MToggle Checked="_formIsCurrent"
                             CheckedChanged="@(v => _formIsCurrent = v)"
                             Disabled="@_lifecycleLocked"
                             AriaLabel="מחזור נוכחי" />
                </div>

                <div class="cy-switch-row">
                    <div class="cy-switch-copy">
                        <span class="cy-switch-title">מחזור פעיל</span>
                        <span class="cy-switch-note">מחזור לא פעיל נשמר במערכת אך אינו זמין לשיבוץ</span>
                    </div>
                    <MToggle Checked="_formIsActive"
                             CheckedChanged="@(v => _formIsActive = v)"
                             Disabled="@_lifecycleLocked"
                             AriaLabel="מחזור פעיל" />
                </div>

                @if (_lifecycleLocked)
                {
                    <div class="cy-form-note">
                        לא ניתן לשנות סטטוס של מחזור @(_editingStatus == "Closed" ? "סגור" : "בארכיון")
                    </div>
                }
                else if (_formIsCurrent)
                {
                    <div class="cy-form-note">כל שאר המחזורים יוגדרו כ"לא נוכחי"</div>
                }

                @if (!string.IsNullOrEmpty(_formError))
                {
                    <div class="cy-form-error" role="alert">@_formError</div>
                }
            </div>

            <div class="cy-modal-footer">
                <button type="button" class="cy-btn-ghost" @onclick="CancelForm" disabled="@_formSaving">ביטול</button>
                <button type="button" class="cy-btn-primary motiva-cta" @onclick="SubmitForm" disabled="@_formSaving">
                    @if (_formSaving) { <span class="cy-spinner" aria-hidden="true"></span> }
                    @(_editingId == 0 ? "הוספה" : "שמירה")
                </button>
            </div>
        </div>
    </div>
}

@* Close / Archive — the two destructive lifecycle actions, on the shared dialog. *@
<MConfirmDialog IsOpen="@(_confirmAction != ConfirmAction.None)"
                Title="@(_confirmAction == ConfirmAction.Close ? "סגירת מחזור" : "העברה לארכיון")"
                Tone="@(_confirmAction == ConfirmAction.Archive ? MConfirmDialog.ConfirmTone.Danger : MConfirmDialog.ConfirmTone.Primary)"
                ConfirmText="@(_confirmAction == ConfirmAction.Close ? "סגור מחזור" : "העבר לארכיון")"
                Busy="_confirmBusy"
                Error="@_confirmError"
                OnConfirm="ExecuteConfirm"
                OnCancel="CancelConfirm">
    @if (_confirmAction == ConfirmAction.Close)
    {
        <span>האם לסגור את המחזור <strong>@_confirmYearName</strong>? המחזור יוסר מהתצוגה הפעילה ותוכניתו תינעל לעריכה.</span>
    }
    else
    {
        <span>האם להעביר את המחזור <strong>@_confirmYearName</strong> לארכיון? פעולה זו קשה לביטול.</span>
    }
</MConfirmDialog>

@{
    // Materialized once per render — the summary, the result line, the empty
    // state and the rows must all read the same filtered list.
    var rows = FilteredYears.ToList();
}

<div class="cy-page" dir="rtl" @onclick="CloseAllMenus">

    @* ══ Header ═══════════════════════════════════════════════════════════ *@
    <header class="cy-head">
        <div class="cy-head-title">
            <h1 class="cy-h1">מחזורים אקדמיים</h1>
            @if (!_loading)
            {
                <p class="cy-summary">@SummaryLine</p>
            }
        </div>

        <div class="cy-head-actions" @onclick:stopPropagation="true">
            <button type="button" class="cy-btn-primary cy-btn-primary--lg motiva-cta" @onclick="OpenAddForm">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="2.4" stroke-linecap="round" aria-hidden="true">
                    <path d="M12 5v14M5 12h14" />
                </svg>
                מחזור חדש
            </button>
        </div>
    </header>

    @* Surfaced only when the admin arrived via the "ניהול שלבי תוכנית"
       management card. Kept from the previous version — the card still links
       here with ?focus=stages and would otherwise land on a page with no
       obvious next click. *@
    @if (_focusStages)
    {
        <div class="cy-focus-banner">
            <span class="cy-focus-title">ניהול שלבי תוכנית</span>
            <span class="cy-focus-body">
                בחרו מחזור ולחצו על <strong>שלבי תוכנית</strong> בתפריט השורה כדי להגדיר שלבים, תאריכים וקישור אבני דרך.
            </span>
        </div>
    }

    @* ══ Toolbar ══════════════════════════════════════════════════════════ *@
    <div class="cy-toolbar" @onclick:stopPropagation="true">
        <MSearchField Value="@_searchQuery"
                      ValueChanged="OnSearchChanged"
                      Placeholder="חיפוש לפי שם מחזור"
                      AriaLabel="חיפוש מחזורים"
                      Class="cy-search" />

        @foreach (var f in BuildFilters())
        {
            var key = f.Key;
            var open = _openFilter == key;

            <div class="cy-filter">
                <button type="button"
                        class="cy-filter-btn @(f.IsActive ? "cy-filter-btn--on" : "")"
                        @onclick="@(() => ToggleFilter(key))"
                        aria-haspopup="listbox" aria-expanded="@(open ? "true" : "false")">
                    <span class="cy-filter-name">@f.Name</span>
                    <span class="cy-filter-value">@f.CurrentLabel</span>
                    <svg class="cy-filter-chev @(open ? "cy-filter-chev--open" : "")"
                         width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="m6 9 6 6 6-6" />
                    </svg>
                </button>

                @if (open)
                {
                    <div class="cy-menu cy-menu--filter" role="listbox" aria-label="@f.Name">
                        @foreach (var o in f.Options)
                        {
                            var val = o.Value;
                            var selected = o.Value == f.CurrentValue;
                            <button type="button"
                                    class="cy-menu-item @(selected ? "cy-menu-item--on" : "")"
                                    role="option" aria-selected="@(selected ? "true" : "false")"
                                    @onclick="@(() => PickFilter(key, val))">
                                <span class="cy-menu-item-label">@o.Label</span>
                                @if (selected)
                                {
                                    <svg class="cy-menu-check" width="12" height="12" viewBox="0 0 24 24" fill="none"
                                         stroke="currentColor" stroke-width="2.6" stroke-linecap="round"
                                         stroke-linejoin="round" aria-hidden="true">
                                        <path d="m5 12.5 4.5 4.5L19 7" />
                                    </svg>
                                }
                            </button>
                        }
                    </div>
                }
            </div>
        }

        @if (HasActiveFilters)
        {
            <button type="button" class="cy-clear" @onclick="ClearFilters">ניקוי סינון</button>
        }

        @if (!_loading)
        {
            <span class="cy-result">@ResultLine(rows.Count)</span>
        }
    </div>

    @* ══ The table ════════════════════════════════════════════════════════ *@
    <MDataTable TItem="AcademicYearDto"
                Items="rows"
                Loading="_loading"
                LoadingText="טוען מחזורים…"
                ColumnCount="6"
                MinWidth="820px"
                Class="cy-table">

        <Columns>
            @* Name carries no width: under table-layout:fixed the five sized
               columns are honoured exactly and the name takes the remainder. *@
            <col />
            <col class="cy-col-date" />
            <col class="cy-col-date" />
            <col class="cy-col-status" />
            <col class="cy-col-projects" />
            <col class="cy-col-actions" />
        </Columns>

        <HeaderContent>
            <th scope="col">שם מחזור</th>
            <th scope="col">תאריך התחלה</th>
            <th scope="col">תאריך סיום</th>
            <th scope="col">סטטוס</th>
            <th scope="col">פרויקטים</th>
            <th scope="col"><span class="cy-sr">פעולות</span></th>
        </HeaderContent>

        <EmptyContent>
            @if (_loadError)
            {
                <MEmptyState Title="שגיאה בטעינת המחזורים"
                             Description="רעננו את הדף או נסו שוב מאוחר יותר"
                             Live="true" />
            }
            else
            {
                <MEmptyState Title="לא נמצאו מחזורים"
                             Description="נסו לשנות את החיפוש או הסינון"
                             Live="true" />
            }
        </EmptyContent>

        <RowTemplate Context="yr">
            @{
                var menuOpen = _openRowMenuId == yr.Id;
                var locked   = yr.Status is "Closed" or "Archived";
            }
            <tr class="@(menuOpen ? "m-dt-row-active" : "")">

                @* The name is the way in. A button, not a row-wide click
                   handler: the row also holds a kebab, and a nested
                   interactive region inside a clickable row is a keyboard
                   trap. *@
                <td class="cy-cell-identity">
                    <span class="cy-identity">
                        <button type="button" class="cy-name-link"
                                @onclick="@(() => OpenCycle(yr.Id))"
                                @onclick:stopPropagation="true"
                                title="@($"פתיחת מחזור {yr.Name}")">@yr.Name</button>
                        @if (yr.IsCurrent)
                        {
                            <span class="cy-current-tag">נוכחי</span>
                        }
                    </span>
                </td>

                <td class="cy-cell-quiet">@yr.StartDate.ToString("dd.MM.yyyy")</td>
                <td class="cy-cell-quiet">@yr.EndDate.ToString("dd.MM.yyyy")</td>

                @* Dot + text, not a filled pill — the same status treatment the
                   Users table uses, so the two Admin lists read as one product. *@
                <td>
                    <span class="cy-status cy-status--@yr.Status.ToLowerInvariant()">
                        <span class="cy-status-dot" aria-hidden="true"></span>
                        @StatusLabel(yr.Status)
                    </span>
                </td>

                <td class="cy-cell-quiet cy-cell-num">
                    @if (yr.ProjectCount > 0)
                    {
                        @yr.ProjectCount
                    }
                    else
                    {
                        <span class="cy-dash">—</span>
                    }
                </td>

                <td class="cy-cell-actions" @onclick:stopPropagation="true">
                    <div class="cy-actions">
                        <button type="button"
                                class="cy-kebab @(menuOpen ? "cy-kebab--on" : "")"
                                @onclick="@(() => ToggleRowMenu(yr.Id))"
                                aria-haspopup="true" aria-expanded="@(menuOpen ? "true" : "false")"
                                title="פעולות" aria-label="@($"פעולות עבור {yr.Name}")">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                                <circle cx="12" cy="5" r="1.7" />
                                <circle cx="12" cy="12" r="1.7" />
                                <circle cx="12" cy="19" r="1.7" />
                            </svg>
                        </button>

                        @if (menuOpen)
                        {
                            <div class="cy-menu cy-menu--row" role="menu">
                                <button type="button" class="cy-menu-item" role="menuitem"
                                        @onclick="@(() => OpenCycle(yr.Id))">
                                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                         stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <path d="M22 12h-4l-3 9L9 3l-3 9H2" />
                                    </svg>
                                    תוכנית המחזור
                                </button>

                                <button type="button" class="cy-menu-item" role="menuitem"
                                        @onclick="@(() => Nav.NavigateTo($"/management/cycles/{yr.Id}/stages"))">
                                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                         stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <path d="M3 3v18h18" /><path d="m7 14 3-3 3 3 5-5" />
                                    </svg>
                                    שלבי תוכנית
                                </button>

                                <button type="button" class="cy-menu-item" role="menuitem"
                                        @onclick="@(() => OpenEditForm(yr))">
                                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                         stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <path d="M17 3a2.8 2.8 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z" />
                                    </svg>
                                    עריכת פרטים
                                </button>

                                @if (!yr.IsCurrent && yr.Status == "Active")
                                {
                                    <button type="button" class="cy-menu-item" role="menuitem"
                                            @onclick="@(() => SetCurrent(yr))">
                                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                             stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                            <path d="m12 3 2.7 5.7 6.3.9-4.5 4.4 1 6.2-5.5-2.9-5.5 2.9 1-6.2L3 9.6l6.3-.9Z" />
                                        </svg>
                                        הגדרה כמחזור נוכחי
                                    </button>
                                }

                                @if (yr.Status is "Active" or "Inactive")
                                {
                                    <button type="button" class="cy-menu-item" role="menuitem"
                                            @onclick="@(() => ToggleActive(yr))">
                                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                             stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                            <circle cx="12" cy="12" r="9" />
                                            @if (yr.IsActive)
                                            {
                                                <path d="M5.6 5.6 18.4 18.4" />
                                            }
                                            else
                                            {
                                                <path d="m8.5 12.2 2.4 2.4 4.6-4.9" />
                                            }
                                        </svg>
                                        @(yr.IsActive ? "השבתת מחזור" : "הפעלת מחזור")
                                    </button>
                                }

                                @if (!locked)
                                {
                                    <div class="cy-menu-sep"></div>
                                    <button type="button" class="cy-menu-item cy-menu-item--warn" role="menuitem"
                                            @onclick="@(() => RequestClose(yr))">
                                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                             stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                            <rect x="3" y="11" width="18" height="10" rx="2" />
                                            <path d="M7 11V7a5 5 0 0 1 10 0v4" />
                                        </svg>
                                        סגירת מחזור
                                    </button>
                                }

                                @if (yr.Status == "Closed")
                                {
                                    <div class="cy-menu-sep"></div>
                                    <button type="button" class="cy-menu-item cy-menu-item--danger" role="menuitem"
                                            @onclick="@(() => RequestArchive(yr))">
                                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                             stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                            <rect x="3" y="4" width="18" height="5" rx="1.5" />
                                            <path d="M5 9v9a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V9M10 13h4" />
                                        </svg>
                                        העברה לארכיון
                                    </button>
                                }

                                @* NO "מחיקת מחזור". There is no delete endpoint
                                   for an academic year, and there should not be
                                   one drawn here: Projects.AcademicYearId,
                                   Teams, RoadmapStages and every
                                   AcademicYearMilestones row hang off a cycle.
                                   סגירה and ארכוב are the product's retirement
                                   path and they preserve all of it. *@
                            </div>
                        }
                    </div>
                </td>
            </tr>
        </RowTemplate>
    </MDataTable>
</div>

@code {

    // ─────────────────────────────────────────────────
    //  Data — one unpaged load, unchanged from before
    // ─────────────────────────────────────────────────
    private List<AcademicYearDto> _allYears = new();
    private bool _loading   = true;
    private bool _loadError = false;

    /// <summary>True when the admin arrived via the "ניהול שלבי תוכנית"
    /// management card (?focus=stages).</summary>
    [SupplyParameterFromQuery(Name = "focus")]
    public string? FocusParam { get; set; }

    private bool _focusStages => string.Equals(FocusParam, "stages", StringComparison.OrdinalIgnoreCase);

    protected override async Task OnInitializedAsync()
    {
        await Reload();
        _loading = false;
    }

    private async Task Reload()
    {
        var years  = await ManagementService.GetAcademicYearsAsync();
        _loadError = years is null;
        _allYears  = years ?? _allYears;
    }

    private void OpenCycle(int id)
    {
        CloseAllMenus();
        Nav.NavigateTo($"/management/cycles/{id}");
    }

    // ─────────────────────────────────────────────────
    //  Summary lines
    // ─────────────────────────────────────────────────
    private string SummaryLine
    {
        get
        {
            if (_loadError) return "שגיאה בטעינת הנתונים";
            if (_allYears.Count == 0) return "אין מחזורים במערכת";

            var current = _allYears.FirstOrDefault(y => y.IsCurrent);
            var total   = $"{_allYears.Count} מחזורים";
            return current is null ? total : $"{total} · נוכחי: {current.Name}";
        }
    }

    private string ResultLine(int shown) =>
        HasActiveFilters || !string.IsNullOrWhiteSpace(_searchQuery)
            ? $"מוצגים {shown} מתוך {_allYears.Count}"
            : $"{shown} מחזורים";

    // ─────────────────────────────────────────────────
    //  Search + filters — client-side over the loaded list
    // ─────────────────────────────────────────────────
    private string _searchQuery   = "";
    private string _filterStatus  = "";
    private string _filterCurrent = "";
    private string? _openFilter;

    private void OnSearchChanged(string value)
    {
        _searchQuery = value ?? "";
        _openFilter  = null;
    }

    private bool HasActiveFilters =>
        !string.IsNullOrEmpty(_filterStatus) || !string.IsNullOrEmpty(_filterCurrent);

    private IEnumerable<AcademicYearDto> FilteredYears => _allYears
        .Where(y => string.IsNullOrEmpty(_searchQuery)
                    || y.Name.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase))
        .Where(y => string.IsNullOrEmpty(_filterStatus) || y.Status == _filterStatus)
        .Where(y => _filterCurrent switch
        {
            "current"    =>  y.IsCurrent,
            "notcurrent" => !y.IsCurrent,
            _            => true,
        });

    private record FilterOption(string Value, string Label);

    private record FilterSpec(string Key, string Name, string CurrentValue,
                              string CurrentLabel, bool IsActive, List<FilterOption> Options);

    private List<FilterSpec> BuildFilters()
    {
        var statusOptions = new List<FilterOption>
        {
            new("",         "הכל"),
            new("Active",   "פעיל"),
            new("Inactive", "לא פעיל"),
            new("Closed",   "סגור"),
            new("Archived", "בארכיון"),
        };

        var currentOptions = new List<FilterOption>
        {
            new("",           "הכל"),
            new("current",    "נוכחי בלבד"),
            new("notcurrent", "לא נוכחי"),
        };

        return new List<FilterSpec>
        {
            new("status", "סטטוס", _filterStatus,
                statusOptions.First(o => o.Value == _filterStatus).Label,
                !string.IsNullOrEmpty(_filterStatus), statusOptions),

            new("current", "מחזור", _filterCurrent,
                currentOptions.First(o => o.Value == _filterCurrent).Label,
                !string.IsNullOrEmpty(_filterCurrent), currentOptions),
        };
    }

    private void ToggleFilter(string key)
    {
        _openFilter    = _openFilter == key ? null : key;
        _openRowMenuId = -1;
    }

    private void PickFilter(string key, string value)
    {
        if (key == "status")  _filterStatus  = value;
        if (key == "current") _filterCurrent = value;
        _openFilter = null;
    }

    private void ClearFilters()
    {
        _filterStatus  = "";
        _filterCurrent = "";
        _openFilter    = null;
    }

    // ─────────────────────────────────────────────────
    //  Menus
    // ─────────────────────────────────────────────────
    private int _openRowMenuId = -1;

    private void ToggleRowMenu(int id)
    {
        _openRowMenuId = _openRowMenuId == id ? -1 : id;
        _openFilter    = null;
    }

    private void CloseAllMenus()
    {
        _openRowMenuId = -1;
        _openFilter    = null;
    }

    // ─────────────────────────────────────────────────
    //  Add / Edit modal
    // ─────────────────────────────────────────────────
    private bool     _showForm      = false;
    private bool     _formSaving    = false;
    private int      _editingId     = 0;
    private string   _editingStatus = "";
    private string   _formName      = "";
    private DateTime _formStart     = DateTime.Today;
    private DateTime _formEnd       = DateTime.Today.AddMonths(10);
    private bool     _formIsActive  = true;
    private bool     _formIsCurrent = false;
    private string   _formError     = "";

    private bool _lifecycleLocked => _editingStatus is "Closed" or "Archived";

    private void OpenAddForm()
    {
        _editingId     = 0;
        _editingStatus = "";
        _formName      = "";
        _formStart     = DateTime.Today;
        _formEnd       = DateTime.Today.AddMonths(10);
        _formIsActive  = true;
        _formIsCurrent = false;
        _formError     = "";
        _showForm      = true;
        CloseAllMenus();
    }

    private void OpenEditForm(AcademicYearDto yr)
    {
        CloseAllMenus();
        _editingId     = yr.Id;
        _editingStatus = yr.Status;
        _formName      = yr.Name;
        _formStart     = yr.StartDate;
        _formEnd       = yr.EndDate;
        _formIsActive  = yr.IsActive;
        _formIsCurrent = yr.IsCurrent;
        _formError     = "";
        _showForm      = true;
    }

    private void CancelForm()
    {
        if (_formSaving) return;
        _showForm  = false;
        _formError = "";
    }

    private async Task SubmitForm()
    {
        _formError = "";

        if (string.IsNullOrWhiteSpace(_formName)) { _formError = "שם המחזור הוא שדה חובה"; return; }
        if (_formEnd <= _formStart)               { _formError = "תאריך סיום חייב להיות אחרי תאריך ההתחלה"; return; }

        _formSaving = true;

        var req = new SaveAcademicYearRequest
        {
            Name      = _formName.Trim(),
            StartDate = _formStart,
            EndDate   = _formEnd,
            IsActive  = _formIsActive,
            IsCurrent = _formIsCurrent,
        };

        bool ok = _editingId == 0
            ? await ManagementService.CreateAcademicYearAsync(req)
            : await ManagementService.UpdateAcademicYearAsync(_editingId, req);

        _formSaving = false;

        if (!ok) { _formError = "שגיאה בשמירה. נסו שנית."; return; }

        _showForm = false;
        _loading  = true;
        await Reload();
        _loading  = false;
    }

    // ─────────────────────────────────────────────────
    //  Row actions
    // ─────────────────────────────────────────────────
    private async Task SetCurrent(AcademicYearDto yr)
    {
        CloseAllMenus();
        if (await ManagementService.SetCurrentYearAsync(yr.Id))
        {
            // Mirrors the server: set-current clears IsCurrent everywhere and
            // activates the target. Reloading would also work, but the list is
            // already correct with two field writes.
            foreach (var y in _allYears) y.IsCurrent = false;
            yr.IsCurrent = true;
            yr.IsActive  = true;
            yr.Status    = "Active";
        }
    }

    private async Task ToggleActive(AcademicYearDto yr)
    {
        CloseAllMenus();
        if (await ManagementService.ToggleYearActiveAsync(yr.Id))
        {
            yr.IsActive = !yr.IsActive;
            yr.Status   = yr.IsActive ? "Active" : "Inactive";
        }
    }

    // ─────────────────────────────────────────────────
    //  Close / Archive confirmations
    // ─────────────────────────────────────────────────
    private enum ConfirmAction { None, Close, Archive }

    private ConfirmAction _confirmAction   = ConfirmAction.None;
    private int           _confirmYearId;
    private string        _confirmYearName = "";
    private bool          _confirmBusy;
    private string?       _confirmError;

    private void RequestClose(AcademicYearDto yr)
    {
        CloseAllMenus();
        _confirmAction   = ConfirmAction.Close;
        _confirmYearId   = yr.Id;
        _confirmYearName = yr.Name;
        _confirmError    = null;
    }

    private void RequestArchive(AcademicYearDto yr)
    {
        CloseAllMenus();
        _confirmAction   = ConfirmAction.Archive;
        _confirmYearId   = yr.Id;
        _confirmYearName = yr.Name;
        _confirmError    = null;
    }

    private void CancelConfirm()
    {
        if (_confirmBusy) return;
        _confirmAction = ConfirmAction.None;
        _confirmError  = null;
    }

    private async Task ExecuteConfirm()
    {
        _confirmBusy  = true;
        _confirmError = null;

        bool ok = _confirmAction == ConfirmAction.Close
            ? await ManagementService.CloseYearAsync(_confirmYearId)
            : await ManagementService.ArchiveYearAsync(_confirmYearId);

        _confirmBusy = false;

        if (!ok)
        {
            _confirmError = "הפעולה נכשלה. נסו שנית.";
            return;
        }

        _confirmAction = ConfirmAction.None;
        _loading = true;
        await Reload();
        _loading = false;
    }

    // ─────────────────────────────────────────────────
    //  Display helpers
    // ─────────────────────────────────────────────────
    private static string StatusLabel(string status) => status switch
    {
        "Active"   => "פעיל",
        "Inactive" => "לא פעיל",
        "Closed"   => "סגור",
        "Archived" => "בארכיון",
        _          => status,
    };
}
