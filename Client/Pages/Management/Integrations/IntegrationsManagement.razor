@page "/management/integrations"
@layout AppLayout
@attribute [Authorize(Roles = Roles.Admin + "," + Roles.Staff)]
@using AuthWithAdmin.Client.Services
@using AuthWithAdmin.Shared.AuthSharedModels
@inject IIntegrationSettingsService IntegrationService
@inject IAirtableIntegrationService AirtableService
@inject NavigationManager Nav

<div class="im-page">

    <!-- ══ Top bar ══════════════════════════════════════════════════════════ -->
    <div class="im-topbar">
        <div class="im-topbar-start">
            <button class="im-back-btn" @onclick='() => Nav.NavigateTo("/management")' title="חזרה לניהול">
                <span class="oi oi-chevron-right" aria-hidden="true"></span>
            </button>
            <div>
                <div class="im-breadcrumb">ניהול</div>
                <h1 class="im-title">אינטגרציות</h1>
            </div>
        </div>
    </div>

    <!-- ══ Content ══════════════════════════════════════════════════════════ -->
    @if (_isLoading)
    {
        <div class="im-loading">
            <div class="im-spinner"></div>
            <span>טוענת הגדרות…</span>
        </div>
    }
    else
    {
        @*  ──────────────────────────────────────────────────────────────
            Layout grouped by purpose so admins can scan the page without
            scrolling through Slack's long OAuth form before seeing the
            other integrations.

              אינטגרציות אקדמיות — Airtable + צוות החדשנות (webhook)
              אינטגרציות חיצוניות — Slack + טפסים חיצוניים

            Slack's OAuth form is collapsed by default behind a <details>
            block so its card matches the height of the others. Editing
            still happens inline — admins expand the block to update
            credentials, no second page or modal needed.
            ────────────────────────────────────────────────────────────── *@

        <section class="im-section">
            <div class="im-section-head">
                <h2 class="im-section-title">אינטגרציות אקדמיות</h2>
                <span class="im-section-sub">מקורות נתונים אקדמיים — קטלוג פרויקטים והעברת סטטוסים מצוות החדשנות</span>
            </div>
            <div class="im-grid">

                <!-- ── Airtable card ─────────────────────────────────────────── -->
                <div class="im-card">
                    <div class="im-card-header">
                        <div class="im-card-icon im-icon-airtable">
                            <span class="oi oi-spreadsheet" aria-hidden="true"></span>
                        </div>
                        <div class="im-card-title-wrap">
                            <h2 class="im-card-title">Airtable</h2>
                            <span class="im-card-sub">ייבוא הצעות פרויקט, מנטורים ומיפויי שדות לפי מחזור אקדמי</span>
                        </div>
                        @if (_airtableLoading)
                        {
                            <span class="im-status-badge im-badge-off">טוען…</span>
                        }
                        else
                        {
                            <span class="im-status-badge @(_airtableActiveCount > 0 ? "im-badge-on" : "im-badge-off")">
                                @(_airtableActiveCount > 0 ? "פעיל" : "לא הוגדר")
                            </span>
                        }
                    </div>

                    <div class="im-form">
                        @if (!_airtableLoading)
                        {
                            <div class="im-airtable-summary">
                                <div class="im-airtable-summary-row">
                                    <span class="im-airtable-label">תצורות מוגדרות</span>
                                    <strong>@_airtableTotalCount</strong>
                                </div>
                                <div class="im-airtable-summary-row">
                                    <span class="im-airtable-label">תצורה פעילה</span>
                                    <strong>@(_airtableActiveCount > 0 ? "כן" : "אין")</strong>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(_airtableLatestImport))
                                {
                                    <div class="im-airtable-summary-row">
                                        <span class="im-airtable-label">ייבוא אחרון</span>
                                        <strong>@_airtableLatestImport</strong>
                                    </div>
                                }
                            </div>
                        }
                        @* Three first-class actions: ניהול הגדרות / היסטוריית
                           ייבוא / ייבוא כעת. See the per-button tooltips. *@
                        <div class="im-actions im-actions--three">
                            <button class="im-btn-secondary"
                                    @onclick='() => Nav.NavigateTo("/management/integrations/airtable")'
                                    title="צפייה ועריכה של הגדרות אינטגרציית Airtable">
                                <span class="oi oi-pencil" aria-hidden="true"></span>
                                <span>ניהול הגדרות</span>
                            </button>
                            <button class="im-btn-secondary im-btn-history"
                                    @onclick='() => Nav.NavigateTo("/management/integrations/airtable?openHistoryForActive=1")'
                                    title="צפייה ביומן הייבואים האחרונים">
                                <span class="oi oi-clock" aria-hidden="true"></span>
                                <span>היסטוריית ייבוא</span>
                            </button>
                            <button class="im-btn-save"
                                    disabled="@(_airtableActiveCount == 0)"
                                    title="@(_airtableActiveCount == 0
                                        ? "אין אינטגרציה פעילה. יש להגדיר ולהפעיל אינטגרציה לפני ייבוא."
                                        : "פתיחת תצוגה מקדימה לייבוא — לא תתבצע כתיבה למסד עד אישור")"
                                    @onclick='() => Nav.NavigateTo("/management/integrations/airtable?triggerPreviewForActive=1")'>
                                <span class="oi oi-cloud-download" aria-hidden="true"></span>
                                <span>ייבוא כעת</span>
                            </button>
                        </div>
                    </div>
                </div>

                <!-- ── Innovation webhook (Airtable → status pushes) ──────────── -->
                <div class="im-card">
                    <div class="im-card-header">
                        <div class="im-card-icon im-icon-webhook">
                            <span class="oi oi-transfer" aria-hidden="true"></span>
                        </div>
                        <div class="im-card-title-wrap">
                            <h2 class="im-card-title">אינטגרציית צוות החדשנות</h2>
                            <span class="im-card-sub">webhook עדכוני סטטוס מ-Airtable: מיפוי שדות, מיפוי סטטוסים, תצוגת payload לדוגמה</span>
                        </div>
                        <span class="im-status-badge im-badge-info">DB-managed</span>
                    </div>
                    <div class="im-form">
                        <div class="im-actions">
                            <button class="im-btn-save" @onclick='() => Nav.NavigateTo("/management/innovation-integration")'>
                                <span class="oi oi-pencil" aria-hidden="true"></span>
                                <span>ניהול webhook + מיפויים</span>
                            </button>
                        </div>
                    </div>
                </div>

            </div>
        </section>

        <section class="im-section">
            <div class="im-section-head">
                <h2 class="im-section-title">אינטגרציות חיצוניות</h2>
                <span class="im-section-sub">הודעות לסטודנטים וטפסים חיצוניים — שירותי-צד-שלישי משלימים</span>
            </div>
            <div class="im-grid">

            <!-- ── Slack card ─────────────────────────────────────────────── -->
            <div class="im-card">
                <div class="im-card-header">
                    <div class="im-card-icon im-icon-slack">
                        <span class="oi oi-chat" aria-hidden="true"></span>
                    </div>
                    <div class="im-card-title-wrap">
                        <h2 class="im-card-title">Slack</h2>
                        <span class="im-card-sub">OAuth v2 — מאפשר לסטודנטים לחבר את חשבון ה-Slack שלהם</span>
                    </div>
                    <div class="im-status-badge @(_slack.IsEnabled ? "im-badge-on" : "im-badge-off")">
                        @(_slack.IsEnabled ? "פעיל" : "מושבת")
                    </div>
                </div>

                @* OAuth credentials are admin-set-once. Collapsed by default
                   so the card height matches the other three; admins expand
                   when they actually need to update ClientId/Secret. *@
                <details class="im-collapsible">
                    <summary class="im-collapsible-summary">
                        <span class="oi oi-cog" aria-hidden="true"></span>
                        <span>הגדרות OAuth ופרטי חיבור</span>
                        <span class="im-collapsible-hint">
                            @if (_slackHasSecret)
                            {
                                <span><span class="oi oi-lock-locked" aria-hidden="true"></span> סוד מוגדר</span>
                            }
                            else
                            {
                                <span>לא הוגדר</span>
                            }
                        </span>
                    </summary>

                    <div class="im-form">
                        <!-- Client ID -->
                        <div class="im-field">
                            <label class="im-label">Client ID <span class="im-required">*</span></label>
                            <input type="text"
                                   class="im-input"
                                   @bind="_slack.ClientId"
                                   placeholder="xxxxxxxxxxxxxxxxxxxxxxxx"
                                   maxlength="200"
                                   disabled="@_isSaving" />
                            <span class="im-hint">מזהה האפליקציה מדף Basic Information ב-Slack API</span>
                        </div>

                        <!-- Client Secret -->
                        <div class="im-field">
                            <label class="im-label">
                                Client Secret
                                @if (_slackHasSecret && string.IsNullOrEmpty(_slackSecretInput))
                                {
                                    <span class="im-secret-set">
                                        <span class="oi oi-lock-locked" aria-hidden="true"></span>
                                        מוגדר — השאר ריק לשמירת הסוד הנוכחי
                                    </span>
                                }
                            </label>
                            <input type="password"
                                   class="im-input"
                                   @bind="_slackSecretInput"
                                   placeholder="@(_slackHasSecret ? "••••••••••••••• (שמור קיים)" : "הכנס Client Secret")"
                                   maxlength="200"
                                   disabled="@_isSaving" />
                            <span class="im-hint">הסוד לא מוצג לאחר שמירה ולא נשלח ללקוח</span>
                        </div>

                        <!-- Redirect URI -->
                        <div class="im-field">
                            <label class="im-label">Redirect URI <span class="im-required">*</span></label>
                            <input type="text"
                                   class="im-input im-input-ltr"
                                   @bind="_slack.RedirectUri"
                                   placeholder="https://yourdomain.com/api/slack/callback"
                                   maxlength="500"
                                   disabled="@_isSaving" />
                            <span class="im-hint">חייב להיות זהה ל-Redirect URL שהוגדר ב-Slack API</span>
                        </div>

                        <!-- Scopes (optional) -->
                        <div class="im-field">
                            <label class="im-label">Bot Scopes <span class="im-optional">(אופציונלי)</span></label>
                            <input type="text"
                                   class="im-input im-input-ltr"
                                   @bind="_slack.Scopes"
                                   placeholder="chat:write"
                                   maxlength="500"
                                   disabled="@_isSaving" />
                            <span class="im-hint">הרשאות Slack מופרדות בפסיקים — ברירת מחדל: chat:write</span>
                        </div>

                        <!-- Enable / Disable -->
                        <div class="im-field im-field-toggle">
                            <span class="im-label">הפעלת אינטגרציה</span>
                            <button class="im-toggle @(_slack.IsEnabled ? "im-toggle-on" : "")"
                                    @onclick="ToggleSlackEnabled"
                                    disabled="@_isSaving">
                                <span class="im-toggle-thumb"></span>
                            </button>
                        </div>

                        <!-- Actions -->
                        <div class="im-actions">
                            @if (_saveError)
                            {
                                <span class="im-msg-error">
                                    <span class="oi oi-warning" aria-hidden="true"></span>
                                    שגיאה בשמירה. בדקי את הפרטים ונסי שנית.
                                </span>
                            }
                            @if (_saveSuccess)
                            {
                                <span class="im-msg-ok">
                                    <span class="oi oi-circle-check" aria-hidden="true"></span>
                                    ההגדרות נשמרו
                                </span>
                            }
                            <button class="im-btn-save" @onclick="SaveSlackAsync" disabled="@_isSaving">
                                @if (_isSaving)
                                {
                                    <div class="im-spinner-sm"></div>
                                    <span>שומר…</span>
                                }
                                else
                                {
                                    <span class="oi oi-check" aria-hidden="true"></span>
                                    <span>שמירת הגדרות</span>
                                }
                            </button>
                        </div>
                    </div>
                </details>
            </div>

            <!-- ── External Forms card ────────────────────────────────────── -->
            @* Configuration surface for Innovation-team iframe forms shown
               to students (per-cycle visibility, soft-delete audit). Lives
               in the External section because — unlike Airtable's project
               catalogue feed — these are third-party form URLs without
               structured payload semantics. *@
            <div class="im-card">
                <div class="im-card-header">
                    <div class="im-card-icon im-icon-forms">
                        <span class="oi oi-clipboard" aria-hidden="true"></span>
                    </div>
                    <div class="im-card-title-wrap">
                        <h2 class="im-card-title">טפסים חיצוניים</h2>
                        <span class="im-card-sub">טפסי iframe של צוות החדשנות — שיוך לפי מחזור והפעלה / השבתה</span>
                    </div>
                    <span class="im-status-badge im-badge-info">DB-managed</span>
                </div>
                <div class="im-form">
                    <div class="im-actions">
                        <button class="im-btn-save" @onclick='() => Nav.NavigateTo("/management/external-forms")'>
                            <span class="oi oi-pencil" aria-hidden="true"></span>
                            <span>ניהול טפסים חיצוניים</span>
                        </button>
                    </div>
                </div>
            </div>

            </div>
        </section>

    }

</div>

@code {
    private IntegrationSettingsDto _slack         = new() { Provider = "Slack" };
    private string                 _slackSecretInput = "";
    private bool                   _slackHasSecret   = false;

    private bool _isLoading   = true;
    private bool _isSaving    = false;
    private bool _saveError   = false;
    private bool _saveSuccess = false;

    private bool   _airtableLoading      = true;
    private int    _airtableTotalCount   = 0;
    private int    _airtableActiveCount  = 0;
    /// <summary>Friendly "most-recent import" date string surfaced on the
    /// hub tile so admins notice the history exists without drilling in.
    /// Empty when nothing has been imported yet.</summary>
    private string _airtableLatestImport = "";

    protected override async Task OnInitializedAsync()
    {
        var settings = await IntegrationService.GetSlackSettingsAsync();
        if (settings is not null)
        {
            _slack        = settings;
            _slackHasSecret = settings.HasSecret;
        }
        _isLoading = false;

        var configs = await AirtableService.GetAllAsync();
        _airtableTotalCount  = configs?.Count ?? 0;
        _airtableActiveCount = configs?.Count(c => c.IsActive) ?? 0;

        // Pick the freshest LastImportAt across all configs. Falls back to
        // empty if no config has ever been imported. The hub tile uses this
        // to decide whether to show the "ייבוא אחרון" line + history shortcut.
        var latest = configs?
            .Where(c => !string.IsNullOrWhiteSpace(c.LastImportAt))
            .Select(c => c.LastImportAt!)
            .OrderByDescending(s => s)   // ISO-formatted "yyyy-MM-dd HH:mm:ss" sorts lexicographically
            .FirstOrDefault();
        if (!string.IsNullOrWhiteSpace(latest)
            && DateTime.TryParse(latest, out var parsed))
        {
            _airtableLatestImport = parsed.ToLocalTime().ToString("dd/MM/yyyy HH:mm");
        }

        _airtableLoading = false;
    }

    private void ToggleSlackEnabled() => _slack.IsEnabled = !_slack.IsEnabled;

    private async Task SaveSlackAsync()
    {
        _isSaving    = true;
        _saveError   = false;
        _saveSuccess = false;
        StateHasChanged();

        var req = new UpdateIntegrationSettingsRequest
        {
            ClientId     = _slack.ClientId?.Trim()    ?? "",
            ClientSecret = _slackSecretInput?.Trim()  ?? "",
            RedirectUri  = _slack.RedirectUri?.Trim() ?? "",
            Scopes       = _slack.Scopes?.Trim()      ?? "",
            IsEnabled    = _slack.IsEnabled,
        };

        bool ok = await IntegrationService.UpdateSlackSettingsAsync(req);
        _isSaving = false;

        if (ok)
        {
            _saveSuccess    = true;
            _slackHasSecret = _slackHasSecret || !string.IsNullOrEmpty(_slackSecretInput);
            _slackSecretInput = "";
            _ = AutoClearAsync(() => _saveSuccess = false, 3000);
        }
        else
        {
            _saveError = true;
        }

        StateHasChanged();
    }

    private async Task AutoClearAsync(Action clear, int delayMs)
    {
        await Task.Delay(delayMs);
        clear();
        StateHasChanged();
    }
}
