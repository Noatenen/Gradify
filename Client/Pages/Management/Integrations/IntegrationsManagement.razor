@*
    ── אינטגרציות (Admin integrations landing) ──────────────────────────────
    Route:  /management/integrations  — reached from the ניהול hub
            (group "הגדרות"), and it is the ONLY entry point to Slack,
            Airtable, the innovation webhook and the external-forms screen.

    Visual source:
        Client/Pages/Management/Milestones/MilestonesManagement.razor
        Client/Pages/Management/Cycles/CyclesManagement.razor
    — the finished Admin screens. Same header rhythm, strip, section
    headings, card border/radius and button language.

    WHAT THIS PAGE IS
    ─────────────────
    A landing page over the four integrations that actually exist. Two of
    them own real state this page can show:

      • Slack     — IntegrationSettings row: IsEnabled, HasSecret. Editable
                    inline; the OAuth credentials stay collapsed because
                    they are set once and then left alone.
      • Airtable  — AirtableConfigs: how many exist, how many are active,
                    and the freshest LastImportAt across them.

    The other two — the innovation webhook and the external forms — have no
    connection handshake anywhere in the product, so their tile says what it
    honestly can ("מנוהל במסד הנתונים") and hands off to its own screen. No
    invented "connected" state.

    WHAT CHANGED IN THIS PASS — PRESENTATION ONLY
    ─────────────────────────────────────────────
    Cards, badges, form controls and buttons adopted the Motiva Admin
    language, and the two section headings became MSectionHeading. Every
    route, request, payload and piece of state is untouched.
*@

@page "/management/integrations"
@layout AppLayout
@attribute [Authorize(Roles = Roles.Admin + "," + Roles.Staff)]
@using AuthWithAdmin.Client.Services
@using AuthWithAdmin.Shared.AuthSharedModels
@inject IIntegrationSettingsService IntegrationService
@inject IAirtableIntegrationService AirtableService
@inject NavigationManager Nav

<div class="im-page" dir="rtl">

    @* ══ Header ═══════════════════════════════════════════════════════════ *@
    <header class="im-head">
        <div class="im-head-main">
            <button type="button" class="im-crumb" @onclick='() => Nav.NavigateTo("/management")'>
                ניהול
                <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="m15 18-6-6 6-6" />
                </svg>
            </button>

            <div class="im-head-line">
                <h1 class="im-h1">אינטגרציות</h1>
                <p class="im-subtitle">השירותים החיצוניים המחוברים למערכת</p>
            </div>
        </div>
    </header>

    @* ══ Info strip ═══════════════════════════════════════════════════════ *@
    <div class="im-strip">
        <span class="im-strip-glyph" aria-hidden="true">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="9" /><path d="M12 16v-4" /><path d="M12 8h.01" />
            </svg>
        </span>
        <p class="im-strip-text">
            אינטגרציות אקדמיות מזינות את קטלוג הפרויקטים ואת עדכוני הסטטוס.
            אינטגרציות חיצוניות משלימות הודעות וטפסים — כל אחת מנוהלת במסך שלה.
        </p>
    </div>

    @if (_isLoading)
    {
        <MLoadingState Label="טוען הגדרות…" />
    }
    else
    {
        @* ══ אינטגרציות אקדמיות ═══════════════════════════════════════════ *@
        <MSectionHeading Text="אינטגרציות אקדמיות" Class="im-section-heading" />
        <p class="im-section-sub">מקורות נתונים אקדמיים — קטלוג פרויקטים והעברת סטטוסים מצוות החדשנות</p>

        <div class="im-grid">

            @* ── Airtable ───────────────────────────────────────────────── *@
            <section class="im-card">
                <div class="im-card-head">
                    <span class="im-card-glyph" aria-hidden="true">
                        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                             stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="3" y="4" width="18" height="16" rx="2" />
                            <path d="M3 10h18M9 10v10" />
                        </svg>
                    </span>
                    <div class="im-card-titles">
                        <h3 class="im-card-title">Airtable</h3>
                        <p class="im-card-sub">ייבוא הצעות פרויקט, מנטורים ומיפויי שדות לפי מחזור אקדמי</p>
                    </div>
                    @if (_airtableLoading)
                    {
                        <span class="im-status im-status--off"><span class="im-status-dot" aria-hidden="true"></span>טוען…</span>
                    }
                    else
                    {
                        <span class="im-status @(_airtableActiveCount > 0 ? "im-status--on" : "im-status--off")">
                            <span class="im-status-dot" aria-hidden="true"></span>
                            @(_airtableActiveCount > 0 ? "פעיל" : "לא הוגדר")
                        </span>
                    }
                </div>

                @if (!_airtableLoading)
                {
                    <dl class="im-facts">
                        <div class="im-fact">
                            <dt>תצורות מוגדרות</dt>
                            <dd>@_airtableTotalCount</dd>
                        </div>
                        <div class="im-fact">
                            <dt>תצורה פעילה</dt>
                            <dd>@(_airtableActiveCount > 0 ? "כן" : "אין")</dd>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(_airtableLatestImport))
                        {
                            <div class="im-fact">
                                <dt>ייבוא אחרון</dt>
                                <dd>@_airtableLatestImport</dd>
                            </div>
                        }
                    </dl>
                }

                @* Three first-class actions: ניהול הגדרות / היסטוריית ייבוא /
                   ייבוא כעת. All three land on the Airtable screen with the
                   query string it already understands. *@
                <div class="im-card-actions">
                    <button type="button" class="im-btn-secondary"
                            @onclick='() => Nav.NavigateTo("/management/integrations/airtable")'
                            title="צפייה ועריכה של הגדרות אינטגרציית Airtable">
                        ניהול הגדרות
                    </button>
                    <button type="button" class="im-btn-secondary"
                            @onclick='() => Nav.NavigateTo("/management/integrations/airtable?openHistoryForActive=1")'
                            title="צפייה ביומן הייבואים האחרונים">
                        היסטוריית ייבוא
                    </button>
                    <button type="button" class="im-btn-primary motiva-cta"
                            disabled="@(_airtableActiveCount == 0)"
                            title="@(_airtableActiveCount == 0
                                ? "אין אינטגרציה פעילה. יש להגדיר ולהפעיל אינטגרציה לפני ייבוא."
                                : "פתיחת תצוגה מקדימה לייבוא — לא תתבצע כתיבה למסד עד אישור")"
                            @onclick='() => Nav.NavigateTo("/management/integrations/airtable?triggerPreviewForActive=1")'>
                        ייבוא כעת
                    </button>
                </div>
            </section>

            @* ── Innovation webhook (Airtable → status pushes) ──────────── *@
            <section class="im-card">
                <div class="im-card-head">
                    <span class="im-card-glyph" aria-hidden="true">
                        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                             stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M4 8h11l-3-3M20 16H9l3 3" />
                        </svg>
                    </span>
                    <div class="im-card-titles">
                        <h3 class="im-card-title">אינטגרציית צוות החדשנות</h3>
                        <p class="im-card-sub">webhook עדכוני סטטוס מ-Airtable: מיפוי שדות, מיפוי סטטוסים ותצוגת payload לדוגמה</p>
                    </div>
                    <span class="im-tag">מנוהל במסד הנתונים</span>
                </div>

                <div class="im-card-actions">
                    <button type="button" class="im-btn-secondary"
                            @onclick='() => Nav.NavigateTo("/management/innovation-integration")'>
                        ניהול webhook ומיפויים
                    </button>
                </div>
            </section>
        </div>

        @* ══ אינטגרציות חיצוניות ══════════════════════════════════════════ *@
        <MSectionHeading Text="אינטגרציות חיצוניות" Class="im-section-heading" />
        <p class="im-section-sub">הודעות לסטודנטים וטפסים חיצוניים — שירותי צד שלישי משלימים</p>

        <div class="im-grid">

            @* ── Slack ──────────────────────────────────────────────────── *@
            <section class="im-card">
                <div class="im-card-head">
                    <span class="im-card-glyph" aria-hidden="true">
                        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                             stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M21 12a8 8 0 0 1-11.6 7.1L4 20l1-4.4A8 8 0 1 1 21 12Z" />
                        </svg>
                    </span>
                    <div class="im-card-titles">
                        <h3 class="im-card-title">Slack</h3>
                        <p class="im-card-sub">OAuth v2 — מאפשר לסטודנטים לחבר את חשבון ה-Slack שלהם</p>
                    </div>
                    <span class="im-status @(_slack.IsEnabled ? "im-status--on" : "im-status--off")">
                        <span class="im-status-dot" aria-hidden="true"></span>
                        @(_slack.IsEnabled ? "פעיל" : "מושבת")
                    </span>
                </div>

                @* OAuth credentials are admin-set-once. Collapsed by default so
                   the card matches the height of the others; admins expand it
                   when they actually need to update ClientId/Secret. *@
                <details class="im-collapse">
                    <summary class="im-collapse-summary">
                        <svg class="im-collapse-chev" width="12" height="12" viewBox="0 0 24 24" fill="none"
                             stroke="currentColor" stroke-width="2.2" stroke-linecap="round"
                             stroke-linejoin="round" aria-hidden="true">
                            <path d="m6 9 6 6 6-6" />
                        </svg>
                        <span class="im-collapse-label">הגדרות OAuth ופרטי חיבור</span>
                        <span class="im-collapse-hint">@(_slackHasSecret ? "סוד מוגדר" : "לא הוגדר")</span>
                    </summary>

                    <div class="im-form">
                        <div class="im-field">
                            <label class="im-label" for="im-slack-id">Client ID <span class="im-req">*</span></label>
                            <input id="im-slack-id" class="im-input im-input--ltr" dir="ltr"
                                   @bind="_slack.ClientId"
                                   placeholder="xxxxxxxxxxxxxxxxxxxxxxxx"
                                   maxlength="200" disabled="@_isSaving" />
                            <span class="im-hint">מזהה האפליקציה מדף Basic Information ב-Slack API</span>
                        </div>

                        <div class="im-field">
                            <label class="im-label" for="im-slack-secret">Client Secret</label>
                            <input id="im-slack-secret" type="password" class="im-input im-input--ltr" dir="ltr"
                                   @bind="_slackSecretInput"
                                   placeholder="@(_slackHasSecret ? "••••••••••••••• (שמור קיים)" : "הכנס Client Secret")"
                                   maxlength="200" disabled="@_isSaving" />
                            <span class="im-hint">
                                @if (_slackHasSecret && string.IsNullOrEmpty(_slackSecretInput))
                                {
                                    <span>מוגדר — השאירו ריק כדי לשמור את הסוד הנוכחי. </span>
                                }
                                הסוד אינו מוצג לאחר שמירה ואינו נשלח ללקוח
                            </span>
                        </div>

                        <div class="im-field">
                            <label class="im-label" for="im-slack-redirect">Redirect URI <span class="im-req">*</span></label>
                            <input id="im-slack-redirect" class="im-input im-input--ltr" dir="ltr"
                                   @bind="_slack.RedirectUri"
                                   placeholder="https://yourdomain.com/api/slack/callback"
                                   maxlength="500" disabled="@_isSaving" />
                            <span class="im-hint">חייב להיות זהה ל-Redirect URL שהוגדר ב-Slack API</span>
                        </div>

                        <div class="im-field">
                            <label class="im-label" for="im-slack-scopes">Bot Scopes <span class="im-optional">(אופציונלי)</span></label>
                            <input id="im-slack-scopes" class="im-input im-input--ltr" dir="ltr"
                                   @bind="_slack.Scopes"
                                   placeholder="chat:write"
                                   maxlength="500" disabled="@_isSaving" />
                            <span class="im-hint">הרשאות Slack מופרדות בפסיקים — ברירת מחדל: chat:write</span>
                        </div>

                        <div class="im-switch-row">
                            <div class="im-switch-copy">
                                <span class="im-switch-title">הפעלת אינטגרציה</span>
                                <span class="im-switch-note">כשמושבת, סטודנטים לא יוכלו לחבר חשבון Slack</span>
                            </div>
                            <MToggle Checked="_slack.IsEnabled"
                                     CheckedChanged="@(v => _slack.IsEnabled = v)"
                                     Disabled="_isSaving"
                                     AriaLabel="הפעלת אינטגרציית Slack" />
                        </div>

                        <div class="im-card-actions">
                            @if (_saveError)
                            {
                                <span class="im-msg im-msg--err">שגיאה בשמירה. בדקו את הפרטים ונסו שנית.</span>
                            }
                            @if (_saveSuccess)
                            {
                                <span class="im-msg im-msg--ok">ההגדרות נשמרו</span>
                            }
                            <button type="button" class="im-btn-primary motiva-cta"
                                    @onclick="SaveSlackAsync" disabled="@_isSaving">
                                @(_isSaving ? "שומר…" : "שמירת הגדרות")
                            </button>
                        </div>
                    </div>
                </details>
            </section>

            @* ── External forms ─────────────────────────────────────────── *@
            @* Configuration surface for Innovation-team iframe forms shown to
               students (per-cycle visibility, soft-delete audit). External
               rather than academic because — unlike Airtable's project
               catalogue feed — these are third-party form URLs without
               structured payload semantics. *@
            <section class="im-card">
                <div class="im-card-head">
                    <span class="im-card-glyph" aria-hidden="true">
                        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                             stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="5" y="3" width="14" height="18" rx="2" />
                            <path d="M9 8h6M9 12h6M9 16h3" />
                        </svg>
                    </span>
                    <div class="im-card-titles">
                        <h3 class="im-card-title">טפסים חיצוניים</h3>
                        <p class="im-card-sub">טפסי iframe של צוות החדשנות — שיוך לפי מחזור והפעלה או השבתה</p>
                    </div>
                    <span class="im-tag">מנוהל במסד הנתונים</span>
                </div>

                <div class="im-card-actions">
                    <button type="button" class="im-btn-secondary"
                            @onclick='() => Nav.NavigateTo("/management/external-forms")'>
                        ניהול טפסים חיצוניים
                    </button>
                </div>
            </section>
        </div>
    }
</div>

@code {
    private IntegrationSettingsDto _slack            = new() { Provider = "Slack" };
    private string                 _slackSecretInput = "";
    private bool                   _slackHasSecret   = false;

    private bool _isLoading   = true;
    private bool _isSaving    = false;
    private bool _saveError   = false;
    private bool _saveSuccess = false;

    private bool   _airtableLoading      = true;
    private int    _airtableTotalCount   = 0;
    private int    _airtableActiveCount  = 0;
    /// <summary>Friendly "most-recent import" date string surfaced on the
    /// hub tile so admins notice the history exists without drilling in.
    /// Empty when nothing has been imported yet.</summary>
    private string _airtableLatestImport = "";

    protected override async Task OnInitializedAsync()
    {
        var settings = await IntegrationService.GetSlackSettingsAsync();
        if (settings is not null)
        {
            _slack        = settings;
            _slackHasSecret = settings.HasSecret;
        }
        _isLoading = false;

        var configs = await AirtableService.GetAllAsync();
        _airtableTotalCount  = configs?.Count ?? 0;
        _airtableActiveCount = configs?.Count(c => c.IsActive) ?? 0;

        // Pick the freshest LastImportAt across all configs. Falls back to
        // empty if no config has ever been imported. The card uses this to
        // decide whether to show the "ייבוא אחרון" line at all.
        var latest = configs?
            .Where(c => !string.IsNullOrWhiteSpace(c.LastImportAt))
            .Select(c => c.LastImportAt!)
            .OrderByDescending(s => s)   // ISO-formatted "yyyy-MM-dd HH:mm:ss" sorts lexicographically
            .FirstOrDefault();
        if (!string.IsNullOrWhiteSpace(latest)
            && DateTime.TryParse(latest, out var parsed))
        {
            _airtableLatestImport = parsed.ToLocalTime().ToString("dd/MM/yyyy HH:mm");
        }

        _airtableLoading = false;
    }

    private async Task SaveSlackAsync()
    {
        _isSaving    = true;
        _saveError   = false;
        _saveSuccess = false;
        StateHasChanged();

        var req = new UpdateIntegrationSettingsRequest
        {
            ClientId     = _slack.ClientId?.Trim()    ?? "",
            ClientSecret = _slackSecretInput?.Trim()  ?? "",
            RedirectUri  = _slack.RedirectUri?.Trim() ?? "",
            Scopes       = _slack.Scopes?.Trim()      ?? "",
            IsEnabled    = _slack.IsEnabled,
        };

        bool ok = await IntegrationService.UpdateSlackSettingsAsync(req);
        _isSaving = false;

        if (ok)
        {
            _saveSuccess    = true;
            _slackHasSecret = _slackHasSecret || !string.IsNullOrEmpty(_slackSecretInput);
            _slackSecretInput = "";
            _ = AutoClearAsync(() => _saveSuccess = false, 3000);
        }
        else
        {
            _saveError = true;
        }

        StateHasChanged();
    }

    private async Task AutoClearAsync(Action clear, int delayMs)
    {
        await Task.Delay(delayMs);
        clear();
        StateHasChanged();
    }
}
