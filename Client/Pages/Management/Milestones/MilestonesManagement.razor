@*
    ── ניהול אבני דרך (Admin Milestone Template library) ────────────────────
    Route:  /management/milestones  — reached from the ניהול hub.

    Visual source:
        design/design-system/Motiva Admin Milestones.dc.html
        Client/Pages/Management/Users/UsersManagement.razor      (the finished
        Admin list this page is brought into line with)

    WHAT THIS PAGE IS
    ─────────────────
    The GLOBAL, reusable milestone TEMPLATE library — MilestoneTemplates rows.
    It is not a cycle's program and not a project's progress. The hierarchy:

        MilestoneTemplates          ← this page
          → AcademicYearMilestones  ← /management/cycles/{id}
            → ProjectMilestones     ← per project

    A template carries no dates of its own beyond DEFAULTS; each cycle sets its
    own. Editing a template's title or type is felt immediately by every cycle
    and project that uses it, because AcademicYearMilestones stores neither and
    reads both through the FK. That is the existing contract, not something this
    screen introduced — which is exactly why deleting an in-use template is
    refused rather than allowed to strip the name off live student roadmaps.

    WHERE THE REAL MODEL DIFFERS FROM THE PROTOTYPE
    ──────────────────────────────────────────────
    • A "משימות" COLUMN THE PROTOTYPE DOES NOT DRAW. TaskTemplateCount is real
      and it is the Milestone → Task half of the hierarchy; the Task Templates
      page carries the mirror column. Without it the relationship is invisible
      until you open a modal.
    • ASSOCIATION CHANGES SAVE IMMEDIATELY, and the panel says so. They are
      PATCHes against the task template, not fields of this form — staging them
      until Save would mean a failed association could look like a saved one.
    • THE TASK PANEL IS EDIT-ONLY. A template that has not been created yet has
      no id to attach anything to, so in create mode the panel explains that
      instead of collecting associations it cannot persist.
    • DETACH IS NOT DELETE. ✕ sets the task template's MilestoneTemplateId to
      null and it lands in the unassigned pool on the Task Templates page. It is
      never removed from the library, and no project task is touched.
*@

@page "/management/milestones"
@layout AppLayout
@attribute [Authorize(Roles = Roles.Admin + "," + Roles.Staff)]
@using AuthWithAdmin.Client.Services
@using AuthWithAdmin.Shared.AuthSharedModels
@inject NavigationManager Nav
@inject IMilestoneManagementService MilestoneService
@inject ITaskManagementService TaskService

@* ══════════════════════════════════════════
     CREATE / EDIT MILESTONE TEMPLATE MODAL
     ══════════════════════════════════════════ *@
@if (_modalOpen)
{
    <div class="ms-modal-overlay" @onclick="CloseModal">
        <div class="ms-modal-box ms-modal-box--lg" @onclick:stopPropagation="true" role="dialog" aria-modal="true">

            <div class="ms-modal-header">
                <span class="ms-modal-glyph" aria-hidden="true">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M22 12h-4l-3 9L9 3l-3 9H2" />
                    </svg>
                </span>
                <div class="ms-modal-titles">
                    <div class="ms-modal-title">@(_editId == 0 ? "אבן דרך חדשה" : "עריכת אבן דרך")</div>
                    <div class="ms-modal-subtitle">תבנית אבן דרך לשימוש חוזר</div>
                </div>
                <button type="button" class="ms-modal-close" @onclick="CloseModal" aria-label="סגירה">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="2.2" stroke-linecap="round" aria-hidden="true">
                        <path d="M18 6 6 18M6 6l12 12" />
                    </svg>
                </button>
            </div>

            <div class="ms-modal-body">

                <p class="ms-form-section">פרטים בסיסיים</p>

                <div class="ms-form-grid ms-form-grid--name">
                    <div class="ms-form-field">
                        <label class="ms-form-label" for="ms-f-name">שם אבן הדרך <span class="ms-req">*</span></label>
                        <input id="ms-f-name" class="ms-form-input" @bind="_fName"
                               placeholder="לדוגמה: אפיון ועיצוב" maxlength="120" />
                    </div>
                    <div class="ms-form-field">
                        <label class="ms-form-label" for="ms-f-order">מספר סדר</label>
                        <input id="ms-f-order" type="number" min="0" class="ms-form-input ms-form-input--num"
                               @bind="_fOrder" />
                    </div>
                </div>

                <div class="ms-form-field">
                    <label class="ms-form-label" for="ms-f-desc">תיאור</label>
                    <textarea id="ms-f-desc" class="ms-form-textarea" @bind="_fDescription"
                              placeholder="תיאור קצר של אבן הדרך ומטרתה" rows="3"></textarea>
                </div>

                <p class="ms-form-section">רלוונטיות</p>
                <span class="ms-form-label">רלוונטי לסוג פרויקט</span>

                @* Three real values — exactly what MilestoneTemplates.ProjectTypeId
                   stores: NULL = both, 1 = Technological, 2 = Methodological. *@
                <div class="ms-choice-grid">
                    @foreach (var choice in TypeChoices)
                    {
                        var val = choice.Value;
                        var on  = _fProjectTypeId == val;
                        <button type="button"
                                class="ms-choice @(on ? "ms-choice--on" : "")"
                                @onclick="@(() => _fProjectTypeId = val)"
                                aria-pressed="@(on ? "true" : "false")">
                            <span class="ms-choice-dot ms-choice-dot--@choice.Tone" aria-hidden="true"></span>
                            <span class="ms-choice-label">@choice.Label</span>
                        </button>
                    }
                </div>

                <p class="ms-form-section">הגדרות</p>

                <div class="ms-form-grid">
                    <div class="ms-switch-row">
                        <div class="ms-switch-copy">
                            <span class="ms-switch-title">חובה</span>
                            <span class="ms-switch-note">אבן דרך זו נדרשת בכל פרויקט רלוונטי</span>
                        </div>
                        <MToggle Checked="_fRequired"
                                 CheckedChanged="@(v => _fRequired = v)"
                                 AriaLabel="אבן דרך חובה" />
                    </div>

                    <div class="ms-switch-row">
                        <div class="ms-switch-copy">
                            <span class="ms-switch-title">פעיל</span>
                            <span class="ms-switch-note">זמין לשיוך למחזורים חדשים</span>
                        </div>
                        <MToggle Checked="_fActive"
                                 CheckedChanged="@(v => _fActive = v)"
                                 AriaLabel="אבן דרך פעילה" />
                    </div>
                </div>

                @* ══ Associated task templates ══════════════════════════════ *@
                <div class="ms-assoc-head">
                    <p class="ms-form-section ms-form-section--inline">
                        משימות משויכות
                        @if (_assocTasks.Count > 0)
                        {
                            <span class="ms-assoc-count">(@_assocTasks.Count)</span>
                        }
                    </p>
                    <button type="button" class="ms-link" @onclick="GoToTaskTemplates">
                        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                             stroke-width="2.4" stroke-linecap="round" aria-hidden="true">
                            <path d="M12 5v14M5 12h14" />
                        </svg>
                        משימה חדשה
                    </button>
                </div>

                @if (_editId == 0)
                {
                    @* No id yet, so nothing can be attached to anything. Saying so
                       beats collecting associations this screen cannot persist. *@
                    <p class="ms-assoc-empty">ניתן לשייך תבניות משימה לאחר שמירת אבן הדרך</p>
                }
                else
                {
                    @if (_assocTasks.Count > 0)
                    {
                        <div class="ms-assoc-list">
                            @foreach (var t in _assocTasks)
                            {
                                var task = t;
                                <div class="ms-assoc-row">
                                    <span class="ms-assoc-name" title="@task.Title">@task.Title</span>
                                    @if (task.IsSubmission)
                                    {
                                        <span class="ms-assoc-flag" title="משימת הגשה">
                                            <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                                 stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
                                                <path d="m17 8-5-5-5 5" /><path d="M12 3v12" />
                                            </svg>
                                            הגשה
                                        </span>
                                    }
                                    @if (!task.IsActive)
                                    {
                                        <span class="ms-assoc-muted">לא פעיל</span>
                                    }
                                    <button type="button" class="ms-assoc-remove"
                                            @onclick="@(() => DetachTask(task))"
                                            disabled="@_assocBusy"
                                            title="הסרת שיוך" aria-label="@($"הסרת השיוך של {task.Title}")">
                                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                             stroke-width="2.4" stroke-linecap="round" aria-hidden="true">
                                            <path d="M18 6 6 18M6 6l12 12" />
                                        </svg>
                                    </button>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="ms-assoc-empty">אין משימות משויכות לאבן דרך זו</p>
                    }

                    <div class="ms-assoc-picker">
                        <div class="ms-assoc-search">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                 stroke-width="2" stroke-linecap="round" aria-hidden="true">
                                <circle cx="11" cy="11" r="7" /><path d="m20 20-3.6-3.6" />
                            </svg>
                            <input class="ms-assoc-input" @bind="_taskQuery" @bind:event="oninput"
                                   @onfocus="@(() => _taskPickerOpen = true)"
                                   placeholder="חיפוש והוספת תבנית משימה קיימת" />
                        </div>

                        @if (_taskPickerOpen)
                        {
                            <div class="ms-assoc-menu" role="listbox">
                                @{ var options = AttachableTasks().ToList(); }
                                @if (options.Count == 0)
                                {
                                    <p class="ms-assoc-menu-empty">אין תבניות משימה זמינות להוספה</p>
                                }
                                else
                                {
                                    @foreach (var o in options)
                                    {
                                        var opt = o;
                                        <button type="button" class="ms-assoc-option" role="option"
                                                @onclick="@(() => AttachTask(opt))" disabled="@_assocBusy">
                                            <span class="ms-assoc-option-name">@opt.Title</span>
                                            @* Where it is now. Attaching a task that already belongs to
                                               another milestone MOVES it, so the admin is told before
                                               the click, not after. *@
                                            @if (opt.MilestoneTemplateId is null)
                                            {
                                                <span class="ms-assoc-option-note">לא משויך</span>
                                            }
                                            else
                                            {
                                                <span class="ms-assoc-option-note ms-assoc-option-note--move">
                                                    יועבר מ־@opt.MilestoneTitle
                                                </span>
                                            }
                                        </button>
                                    }
                                }
                            </div>
                        }
                    </div>

                    <p class="ms-assoc-hint">שינויי שיוך נשמרים מיד ואינם משפיעים על משימות שכבר נוצרו בפרויקטים</p>

                    @if (!string.IsNullOrEmpty(_assocError))
                    {
                        <div class="ms-form-error" role="alert">@_assocError</div>
                    }
                }

                <p class="ms-form-section">
                    תאריכי ברירת מחדל <span class="ms-form-section-note">(רשות)</span>
                </p>

                <div class="ms-form-grid">
                    <div class="ms-form-field">
                        <label class="ms-form-label" for="ms-f-start">תאריך התחלה</label>
                        <input id="ms-f-start" type="date" class="ms-form-input"
                               @bind="_fOpenDate" @bind:format="yyyy-MM-dd" />
                    </div>
                    <div class="ms-form-field">
                        <label class="ms-form-label" for="ms-f-due">תאריך יעד</label>
                        <input id="ms-f-due" type="date" class="ms-form-input"
                               @bind="_fDueDate" @bind:format="yyyy-MM-dd" />
                    </div>
                </div>

                <p class="ms-form-note">
                    תאריכים אלו הם ברירת מחדל בלבד — כל מחזור קובע את התאריכים שלו בעת שיוך אבן הדרך.
                </p>

                @if (!string.IsNullOrEmpty(_formError))
                {
                    <div class="ms-form-error" role="alert">@_formError</div>
                }
            </div>

            <div class="ms-modal-footer">
                <span class="ms-footer-note">שדות המסומנים ב־<span class="ms-req">*</span> הם חובה</span>
                <div class="ms-footer-actions">
                    <button type="button" class="ms-btn-ghost" @onclick="CloseModal" disabled="@_saving">ביטול</button>
                    <button type="button" class="ms-btn-primary motiva-cta" @onclick="SaveTemplate" disabled="@_saving">
                        @if (_saving) { <span class="ms-spinner" aria-hidden="true"></span> }
                        שמירה
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@* Delete. The server refuses when a cycle or project depends on the template,
   so the dialog states the dependency up front and the confirm is rose. *@
<MConfirmDialog IsOpen="_deleteOpen"
                Title="מחיקת תבנית אבן דרך"
                Tone="MConfirmDialog.ConfirmTone.Danger"
                ConfirmText="מחיקה"
                Busy="_deleteBusy"
                Error="@_deleteError"
                OnConfirm="ExecuteDelete"
                OnCancel="@(() => { if (!_deleteBusy) { _deleteOpen = false; _deleteError = null; } })">
    @if (_deleteTarget is not null)
    {
        @if (!_deleteTarget.CanDelete)
        {
            <span>
                התבנית <strong>@_deleteTarget.Title</strong> בשימוש
                @if (_deleteTarget.CycleUsageCount > 0)
                {
                    <text>ב־<strong>@_deleteTarget.CycleUsageCount</strong> מחזורים</text>
                }
                @if (_deleteTarget.CycleUsageCount > 0 && _deleteTarget.ProjectMilestoneCount > 0)
                {
                    <text> ו־</text>
                }
                @if (_deleteTarget.ProjectMilestoneCount > 0)
                {
                    <text><strong>@_deleteTarget.ProjectMilestoneCount</strong> אבני דרך בפרויקטים</text>
                }
                <text>, ולכן לא ניתן למחוק אותה — המחיקה הייתה משאירה את המחזורים והפרויקטים ללא שם וסוג. ניתן להשבית אותה במקום זאת.</text>
            </span>
        }
        else
        {
            <span>
                למחוק את התבנית <strong>@_deleteTarget.Title</strong>?
                @if (_deleteTarget.TaskTemplateCount > 0)
                {
                    <text>
                        <strong>@_deleteTarget.TaskTemplateCount</strong> תבניות המשימה המשויכות אליה יישמרו
                        בספרייה ויעברו למצב "לא משויך".
                    </text>
                }
                <text> פעולה זו אינה ניתנת לביטול.</text>
            </span>
        }
    }
</MConfirmDialog>

@{
    // Materialized once per render — the summary, the result line, the empty
    // state and the rows must all read the same filtered list.
    var rows = FilteredTemplates.ToList();
}

<div class="ms-page" dir="rtl" @onclick="CloseAllMenus">

    @* ══ Header ═══════════════════════════════════════════════════════════ *@
    <header class="ms-head">
        <div class="ms-head-main">
            <MAdminBack />
            <div class="ms-head-line">
                <h1 class="ms-h1">ניהול אבני דרך</h1>
                <MInfoTip Text="ספריית תבניות אבני הדרך של המערכת. תבניות לשימוש חוזר — כל אבן דרך רלוונטית לפרויקטים טכנולוגיים, מתודולוגיים או לשניהם, וניתן לשייך אותה למחזורים אקדמיים בהמשך." />

                @* Three separate bordered pills used to sit in a strip under
                   this header — three containers for three facts about one
                   page. One container now, on the header line, where the rest
                   of the Admin area keeps its page metadata. *@
                @if (!_loading && !_loadError)
                {
                    <MSummaryTag Metrics="SummaryMetrics" />
                }
            </div>
        </div>

        <div class="ms-head-actions" @onclick:stopPropagation="true">
            <button type="button" class="ms-btn-primary ms-btn-primary--lg motiva-cta" @onclick="OpenCreate">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="2.4" stroke-linecap="round" aria-hidden="true">
                    <path d="M12 5v14M5 12h14" />
                </svg>
                אבן דרך חדשה
            </button>
        </div>
    </header>

    @* ══ Toolbar ══════════════════════════════════════════════════════════ *@
    <div class="ms-toolbar" @onclick:stopPropagation="true">
        <MSearchField Value="@_searchQuery"
                      ValueChanged="OnSearchChanged"
                      Placeholder="חיפוש לפי שם אבן דרך"
                      AriaLabel="חיפוש אבני דרך"
                      Class="ms-search" />

        @foreach (var f in BuildFilters())
        {
            var key = f.Key;
            var open = _openFilter == key;

            <div class="ms-filter">
                <button type="button"
                        class="ms-filter-btn @(f.IsActive ? "ms-filter-btn--on" : "")"
                        @onclick="@(() => ToggleFilter(key))"
                        aria-haspopup="listbox" aria-expanded="@(open ? "true" : "false")">
                    <span class="ms-filter-name">@f.Name</span>
                    <span class="ms-filter-value">@f.CurrentLabel</span>
                    <svg class="ms-filter-chev @(open ? "ms-filter-chev--open" : "")"
                         width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="m6 9 6 6 6-6" />
                    </svg>
                </button>

                @if (open)
                {
                    <div class="ms-menu ms-menu--filter" role="listbox" aria-label="@f.Name">
                        @foreach (var o in f.Options)
                        {
                            var val = o.Value;
                            var selected = o.Value == f.CurrentValue;
                            <button type="button"
                                    class="ms-menu-item @(selected ? "ms-menu-item--on" : "")"
                                    role="option" aria-selected="@(selected ? "true" : "false")"
                                    @onclick="@(() => PickFilter(key, val))">
                                <span class="ms-menu-item-label">@o.Label</span>
                                @if (selected)
                                {
                                    <svg class="ms-menu-check" width="12" height="12" viewBox="0 0 24 24" fill="none"
                                         stroke="currentColor" stroke-width="2.6" stroke-linecap="round"
                                         stroke-linejoin="round" aria-hidden="true">
                                        <path d="m5 12.5 4.5 4.5L19 7" />
                                    </svg>
                                }
                            </button>
                        }
                    </div>
                }
            </div>
        }

        @if (HasActiveFilters)
        {
            <button type="button" class="ms-clear" @onclick="ClearFilters">ניקוי סינון</button>
        }

        @if (!_loading)
        {
            <span class="ms-result">@ResultLine(rows.Count)</span>
        }
    </div>

    @* ══ The table ════════════════════════════════════════════════════════ *@
    <MDataTable TItem="MilestoneTemplateDto"
                Items="rows"
                Loading="_loading"
                LoadingText="טוען אבני דרך…"
                ColumnCount="8"
                MinWidth="940px"
                Class="ms-table">

        <Columns>
            <col class="ms-col-num" />
            <col />
            <col class="ms-col-type" />
            <col class="ms-col-dates" />
            <col class="ms-col-tasks" />
            <col class="ms-col-req" />
            <col class="ms-col-status" />
            <col class="ms-col-actions" />
        </Columns>

        <HeaderContent>
            <th scope="col">#</th>
            <th scope="col">אבן דרך</th>
            <th scope="col">רלוונטי ל־</th>
            <th scope="col">תאריכים</th>
            <th scope="col">משימות</th>
            <th scope="col">חובה</th>
            <th scope="col">סטטוס</th>
            <th scope="col"><span class="ms-sr">פעולות</span></th>
        </HeaderContent>

        <EmptyContent>
            @if (_loadError)
            {
                <MEmptyState Title="שגיאה בטעינת אבני הדרך"
                             Description="רעננו את הדף או נסו שוב מאוחר יותר"
                             Live="true" />
            }
            else
            {
                <MEmptyState Title="לא נמצאו אבני דרך"
                             Description="נסו לשנות את החיפוש או הסינון"
                             Live="true" />
            }
        </EmptyContent>

        <RowTemplate Context="m">
            @{
                var menuOpen = _openRowMenuId == m.Id;
            }
            <tr class="@(menuOpen ? "m-dt-row-active" : "") @(m.IsActive ? "" : "ms-row--off")">

                <td><span class="ms-num">@m.OrderIndex.ToString("00")</span></td>

                <td class="ms-cell-name">
                    <span class="ms-name" title="@m.Title">@m.Title</span>
                    @if (!string.IsNullOrWhiteSpace(m.Description))
                    {
                        <span class="ms-desc" title="@m.Description">@m.Description</span>
                    }
                </td>

                <td>
                    <span class="ms-type ms-type--@ToneFor(m.ProjectTypeId)">
                        <span class="ms-type-dot" aria-hidden="true"></span>@m.Applicability
                    </span>
                </td>

                <td class="ms-cell-dates @(HasDates(m) ? "" : "ms-cell-empty")">@DateRange(m)</td>

                @* The Milestone → Task half of the hierarchy. The Task Templates
                   page carries the mirror column. *@
                <td class="ms-cell-num @(m.TaskTemplateCount == 0 ? "ms-cell-empty" : "")">
                    @(m.TaskTemplateCount == 0 ? "—" : m.TaskTemplateCount.ToString())
                </td>

                <td>
                    @if (m.IsRequired)
                    {
                        <span class="ms-req-yes">
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                 stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M12 2v20M2 12h20" />
                            </svg>
                            חובה
                        </span>
                    }
                    else
                    {
                        <span class="ms-req-no">רשות</span>
                    }
                </td>

                <td>
                    <span class="ms-status @(m.IsActive ? "ms-status--on" : "ms-status--off")">
                        <span class="ms-status-dot" aria-hidden="true"></span>
                        @(m.IsActive ? "פעיל" : "לא פעיל")
                    </span>
                </td>

                <td class="ms-cell-actions" @onclick:stopPropagation="true">
                    <div class="ms-actions">
                        <button type="button"
                                class="ms-kebab @(menuOpen ? "ms-kebab--on" : "")"
                                @onclick="@(() => ToggleRowMenu(m.Id))"
                                aria-haspopup="true" aria-expanded="@(menuOpen ? "true" : "false")"
                                title="פעולות" aria-label="@($"פעולות עבור {m.Title}")">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                                <circle cx="12" cy="5" r="1.7" />
                                <circle cx="12" cy="12" r="1.7" />
                                <circle cx="12" cy="19" r="1.7" />
                            </svg>
                        </button>

                        @if (menuOpen)
                        {
                            <div class="ms-menu ms-menu--row" role="menu">
                                <button type="button" class="ms-menu-item" role="menuitem"
                                        @onclick="@(() => OpenEdit(m))">
                                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                         stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <path d="M17 3a2.8 2.8 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z" />
                                    </svg>
                                    עריכת אבן דרך
                                </button>

                                <button type="button" class="ms-menu-item" role="menuitem"
                                        @onclick="@(() => DuplicateTemplate(m))" disabled="@_busy">
                                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                         stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <rect x="9" y="9" width="12" height="12" rx="2" />
                                        <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
                                    </svg>
                                    שכפול
                                </button>

                                <button type="button" class="ms-menu-item" role="menuitem"
                                        @onclick="@(() => ToggleActive(m))">
                                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                         stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <circle cx="12" cy="12" r="9" />
                                        @if (m.IsActive)
                                        {
                                            <path d="M5.6 5.6 18.4 18.4" />
                                        }
                                        else
                                        {
                                            <path d="m8.5 12.2 2.4 2.4 4.6-4.9" />
                                        }
                                    </svg>
                                    @(m.IsActive ? "השבתה" : "הפעלה")
                                </button>

                                <div class="ms-menu-sep"></div>

                                @* Always present, never silently absent — but a
                                   template in use says so on its own row instead
                                   of failing after the click. *@
                                <button type="button" class="ms-menu-item ms-menu-item--danger" role="menuitem"
                                        @onclick="@(() => RequestDelete(m))">
                                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                         stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <path d="M3 6h18" />
                                        <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6" />
                                        <path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" />
                                    </svg>
                                    מחיקה
                                    @if (!m.CanDelete)
                                    {
                                        <span class="ms-menu-item-note">בשימוש</span>
                                    }
                                </button>
                            </div>
                        }
                    </div>
                </td>
            </tr>
        </RowTemplate>
    </MDataTable>
</div>

@code {

    // ─────────────────────────────────────────────────
    //  Data — one unpaged load of each library
    // ─────────────────────────────────────────────────
    private List<MilestoneTemplateDto> _all       = new();
    private List<TaskTemplateDto>      _allTasks  = new();
    private bool _loading   = true;
    private bool _loadError = false;
    private bool _busy      = false;

    /// <summary>The header's summary tag. The SAME three expressions the
    /// three stat pills evaluated — nothing is counted differently, they are
    /// just metrics in one container now.</summary>
    private IReadOnlyList<MSummaryTag.Metric> SummaryMetrics => new[]
    {
        new MSummaryTag.Metric(_all.Count.ToString(), "סה\"כ אבני דרך"),
        new MSummaryTag.Metric(_all.Count(m => m.IsActive).ToString(), "פעילות"),
        new MSummaryTag.Metric(_all.Count(m => m.IsRequired).ToString(), "חובה"),
    };

    protected override async Task OnInitializedAsync()
    {
        await ReloadAsync();
        _loading = false;
    }

    private async Task ReloadAsync()
    {
        var templates = await MilestoneService.GetTemplatesAsync();
        _loadError = templates is null;
        _all       = templates ?? _all;

        // The task library is loaded here rather than lazily inside the modal:
        // the association picker needs it the moment the modal opens, and a
        // second round-trip at that point would make the panel flash empty.
        _allTasks  = await TaskService.GetTemplatesAsync() ?? new();
    }

    // ─────────────────────────────────────────────────
    //  Search + filters — client-side over the loaded list
    // ─────────────────────────────────────────────────
    private string  _searchQuery = "";
    private string  _filterType  = "";
    private string  _filterStatus = "";
    private string? _openFilter;

    private void OnSearchChanged(string value)
    {
        _searchQuery = value ?? "";
        _openFilter  = null;
    }

    private bool HasActiveFilters =>
        !string.IsNullOrEmpty(_filterType) || !string.IsNullOrEmpty(_filterStatus);

    private IEnumerable<MilestoneTemplateDto> FilteredTemplates => _all
        .Where(m => string.IsNullOrEmpty(_searchQuery)
                    || m.Title.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase)
                    || (m.Description ?? "").Contains(_searchQuery, StringComparison.OrdinalIgnoreCase))
        .Where(m => _filterType switch
        {
            // "Relevant to technological" includes the shared (null) templates —
            // those really do apply to technological projects. Filtering to the
            // exact column value would hide most of the library.
            "1"    => m.ProjectTypeId is null or 1,
            "2"    => m.ProjectTypeId is null or 2,
            "both" => m.ProjectTypeId is null,
            _      => true,
        })
        .Where(m => _filterStatus switch
        {
            "active"   => m.IsActive,
            "inactive" => !m.IsActive,
            _          => true,
        })
        .OrderBy(m => m.OrderIndex).ThenBy(m => m.Id);

    private record FilterOption(string Value, string Label);

    private record FilterSpec(string Key, string Name, string CurrentValue,
                              string CurrentLabel, bool IsActive, List<FilterOption> Options);

    private List<FilterSpec> BuildFilters()
    {
        var typeOptions = new List<FilterOption>
        {
            new("",     "הכל"),
            new("1",    "טכנולוגי"),
            new("2",    "מתודולוגי"),
            new("both", "שניהם"),
        };

        var statusOptions = new List<FilterOption>
        {
            new("",         "הכל"),
            new("active",   "פעיל"),
            new("inactive", "לא פעיל"),
        };

        return new List<FilterSpec>
        {
            new("type", "רלוונטיות", _filterType,
                typeOptions.First(o => o.Value == _filterType).Label,
                !string.IsNullOrEmpty(_filterType), typeOptions),

            new("status", "סטטוס", _filterStatus,
                statusOptions.First(o => o.Value == _filterStatus).Label,
                !string.IsNullOrEmpty(_filterStatus), statusOptions),
        };
    }

    private void ToggleFilter(string key)
    {
        _openFilter    = _openFilter == key ? null : key;
        _openRowMenuId = -1;
    }

    private void PickFilter(string key, string value)
    {
        if (key == "type")   _filterType   = value;
        if (key == "status") _filterStatus = value;
        _openFilter = null;
    }

    private void ClearFilters()
    {
        _filterType   = "";
        _filterStatus = "";
        _openFilter   = null;
    }

    private string ResultLine(int shown) =>
        HasActiveFilters || !string.IsNullOrWhiteSpace(_searchQuery)
            ? $"מציג {shown} מתוך {_all.Count}"
            : $"מציג את כל {_all.Count} אבני הדרך";

    // ─────────────────────────────────────────────────
    //  Menus
    // ─────────────────────────────────────────────────
    private int _openRowMenuId = -1;

    private void ToggleRowMenu(int id)
    {
        _openRowMenuId = _openRowMenuId == id ? -1 : id;
        _openFilter    = null;
    }

    private void CloseAllMenus()
    {
        _openRowMenuId  = -1;
        _openFilter     = null;
        _taskPickerOpen = false;
    }

    // ─────────────────────────────────────────────────
    //  Display helpers
    // ─────────────────────────────────────────────────
    private record TypeChoice(int? Value, string Label, string Tone);

    /// <summary>The three values ProjectTypeId can hold. Not a server lookup:
    /// ProjectTypes has exactly these two rows plus the NULL "both" case, and
    /// the controller resolves the same three labels.</summary>
    private static readonly TypeChoice[] TypeChoices =
    {
        new(1,    "טכנולוגי",  "tech"),
        new(2,    "מתודולוגי", "method"),
        new(null, "שניהם",     "both"),
    };

    private static string ToneFor(int? projectTypeId) => projectTypeId switch
    {
        1 => "tech",
        2 => "method",
        _ => "both",
    };

    private static bool HasDates(MilestoneTemplateDto m) => m.OpenDate is not null || m.DueDate is not null;

    private static string DateRange(MilestoneTemplateDto m)
    {
        string? open = m.OpenDate?.ToString("dd.MM.yy");
        string? due  = m.DueDate?.ToString("dd.MM.yy");

        if (open is not null && due is not null) return $"{open} – {due}";
        if (due  is not null)                    return $"עד {due}";
        if (open is not null)                    return $"מ־{open}";
        return "—";
    }

    // ─────────────────────────────────────────────────
    //  Create / edit modal
    // ─────────────────────────────────────────────────
    private bool      _modalOpen;
    private bool      _saving;
    private int       _editId;          // 0 = create
    private string    _fName        = "";
    private string    _fDescription = "";
    private int       _fOrder       = 1;
    private int?      _fProjectTypeId;
    private bool      _fRequired    = true;
    private bool      _fActive      = true;
    private DateTime? _fOpenDate;
    private DateTime? _fDueDate;
    private string    _formError    = "";

    private void OpenCreate()
    {
        CloseAllMenus();

        _editId         = 0;
        _fName          = "";
        _fDescription   = "";
        _fOrder         = (_all.Count == 0 ? 0 : _all.Max(m => m.OrderIndex)) + 1;
        _fProjectTypeId = null;
        _fRequired      = true;
        _fActive        = true;
        _fOpenDate      = null;
        _fDueDate       = null;
        _formError      = "";
        _assocError     = "";
        _taskQuery      = "";
        _modalOpen      = true;
    }

    private void OpenEdit(MilestoneTemplateDto m)
    {
        CloseAllMenus();

        _editId         = m.Id;
        _fName          = m.Title;
        _fDescription   = m.Description ?? "";
        _fOrder         = m.OrderIndex;
        _fProjectTypeId = m.ProjectTypeId;
        _fRequired      = m.IsRequired;
        _fActive        = m.IsActive;
        _fOpenDate      = m.OpenDate;
        _fDueDate       = m.DueDate;
        _formError      = "";
        _assocError     = "";
        _taskQuery      = "";
        _modalOpen      = true;
    }

    private void CloseModal()
    {
        if (_saving) return;
        _modalOpen      = false;
        _taskPickerOpen = false;
        _formError      = "";
    }

    private async Task SaveTemplate()
    {
        _formError = "";

        if (string.IsNullOrWhiteSpace(_fName)) { _formError = "שם אבן הדרך הוא שדה חובה"; return; }
        if (_fOrder < 0)                       { _formError = "מספר סדר חייב להיות אפס או יותר"; return; }

        if (_fOpenDate is not null && _fDueDate is not null && _fDueDate < _fOpenDate)
        {
            _formError = "תאריך היעד חייב להיות אחרי תאריך ההתחלה";
            return;
        }

        _saving = true;

        var req = new SaveMilestoneTemplateRequest
        {
            Title         = _fName.Trim(),
            Description   = string.IsNullOrWhiteSpace(_fDescription) ? null : _fDescription.Trim(),
            OrderIndex    = _fOrder,
            IsRequired    = _fRequired,
            IsActive      = _fActive,
            ProjectTypeId = _fProjectTypeId,
            OpenDate      = _fOpenDate,
            DueDate       = _fDueDate,
            CloseDate     = null,
        };

        var error = _editId == 0
            ? await MilestoneService.CreateTemplateAsync(req)
            : await MilestoneService.UpdateTemplateAsync(_editId, req);

        _saving = false;

        if (error is not null) { _formError = error; return; }

        _modalOpen = false;
        await ReloadAsync();
    }

    // ─────────────────────────────────────────────────
    //  Row actions
    // ─────────────────────────────────────────────────
    private async Task ToggleActive(MilestoneTemplateDto m)
    {
        CloseAllMenus();
        if (await MilestoneService.ToggleActiveAsync(m.Id))
            m.IsActive = !m.IsActive;
    }

    private async Task DuplicateTemplate(MilestoneTemplateDto m)
    {
        CloseAllMenus();
        _busy = true;

        var (_, error) = await MilestoneService.DuplicateTemplateAsync(m.Id);

        _busy = false;
        if (error is not null) return;

        await ReloadAsync();
    }

    // ─────────────────────────────────────────────────
    //  Delete
    // ─────────────────────────────────────────────────
    private bool                    _deleteOpen;
    private bool                    _deleteBusy;
    private string?                 _deleteError;
    private MilestoneTemplateDto?   _deleteTarget;

    private void RequestDelete(MilestoneTemplateDto m)
    {
        CloseAllMenus();
        _deleteTarget = m;
        _deleteError  = null;
        _deleteOpen   = true;
    }

    private async Task ExecuteDelete()
    {
        if (_deleteTarget is null) return;

        _deleteBusy  = true;
        _deleteError = null;

        var error = await MilestoneService.DeleteTemplateAsync(_deleteTarget.Id);

        _deleteBusy = false;

        if (error is not null)
        {
            // The server's own sentence — it names the cycles and project
            // milestones holding the template.
            _deleteError = error;
            return;
        }

        _deleteOpen   = false;
        _deleteTarget = null;
        await ReloadAsync();
    }

    // ─────────────────────────────────────────────────
    //  Milestone ↔ task-template associations
    //
    //  Every change here is a PATCH against the TASK template, applied
    //  immediately. The relation is stored on the task side
    //  (TaskTemplates.MilestoneTemplateId) and this panel is a view onto it —
    //  it does not own a copy of the list.
    // ─────────────────────────────────────────────────
    private string _taskQuery      = "";
    private bool   _taskPickerOpen = false;
    private bool   _assocBusy      = false;
    private string _assocError     = "";

    /// <summary>Task templates currently attached to the milestone being edited.
    /// Derived from the loaded library, never a separate list.</summary>
    private List<TaskTemplateDto> _assocTasks => _allTasks
        .Where(t => t.MilestoneTemplateId == _editId)
        .OrderBy(t => t.StartDate).ThenBy(t => t.Id)
        .ToList();

    /// <summary>
    /// Everything attachable: the unassigned pool plus templates belonging to a
    /// different milestone. The latter are offered because moving a task between
    /// milestones is a real editorial act — but the option says where it will
    /// come from, so the move is never a surprise.
    /// </summary>
    private IEnumerable<TaskTemplateDto> AttachableTasks()
    {
        var q = _taskQuery.Trim();

        return _allTasks
            .Where(t => t.MilestoneTemplateId != _editId)
            .Where(t => string.IsNullOrEmpty(q)
                        || t.Title.Contains(q, StringComparison.OrdinalIgnoreCase))
            .OrderBy(t => t.MilestoneTemplateId is null ? 0 : 1)   // unassigned first
            .ThenBy(t => t.Title)
            .Take(20);
    }

    private async Task AttachTask(TaskTemplateDto t)
    {
        _assocBusy  = true;
        _assocError = "";

        var error = await TaskService.SetMilestoneAsync(t.Id, _editId);

        _assocBusy = false;

        if (error is not null) { _assocError = error; return; }

        _taskQuery      = "";
        _taskPickerOpen = false;
        await ReloadAsync();
    }

    private async Task DetachTask(TaskTemplateDto t)
    {
        _assocBusy  = true;
        _assocError = "";

        var error = await TaskService.SetMilestoneAsync(t.Id, null);

        _assocBusy = false;

        if (error is not null) { _assocError = error; return; }

        await ReloadAsync();
    }

    private void GoToTaskTemplates() => Nav.NavigateTo("management/tasks");
}
