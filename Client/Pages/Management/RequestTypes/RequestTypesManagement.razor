@page "/management/request-types"
@layout AppLayout
@attribute [Authorize(Roles = $"{Roles.Admin},{Roles.Staff}")]
@using AuthWithAdmin.Shared.AuthSharedModels
@inject NavigationManager Nav

@*
    Request Type Management — configuration-only screen for the structure
    and behaviour of student request types. Operational request handling
    lives at the side-nav "בקשות" item (/management/requests).

    This is a placeholder created on 2026-05-21 as part of the nav
    reorganisation. The full editor (field-builder UI, role-binding,
    status configuration, internal-notes toggle, etc.) lands in a follow-up
    feature — the placeholder simply states intent and links back so the
    page is reachable from the management area without leaving a 404.
*@

<div class="rtm-page" dir="rtl">

    <!-- Top bar -->
    <div class="rtm-topbar">
        <div class="rtm-topbar-start">
            <button class="rtm-back-btn"
                    @onclick="@(() => Nav.NavigateTo("/management"))"
                    title="חזרה לניהול">
                <span class="oi oi-chevron-right" aria-hidden="true"></span>
            </button>
            <div>
                <div class="rtm-breadcrumb">ניהול</div>
                <h1 class="rtm-title">ניהול סוגי בקשות</h1>
            </div>
        </div>
    </div>

    <!-- Coming-soon notice -->
    <div class="rtm-soon-card">
        <span class="oi oi-clock rtm-soon-icon" aria-hidden="true"></span>
        <div>
            <h2 class="rtm-soon-title">המסך נמצא בפיתוח</h2>
            <p class="rtm-soon-body">
                ניהול תפעולי של בקשות סטודנטים נשאר בלשונית "בקשות" בתפריט הצד.
                כאן יתווסף בעתיד עורך תצורה ייעודי לסוגי הבקשות עצמם.
            </p>
        </div>
    </div>

    <!-- Planned configuration sections -->
    <div class="rtm-grid">
        <article class="rtm-section">
            <h3 class="rtm-section-title">
                <span class="oi oi-list-rich" aria-hidden="true"></span>
                סוגי בקשות
            </h3>
            <ul class="rtm-section-list">
                <li>הוספת סוג בקשה חדש</li>
                <li>עריכת סוג בקשה קיים</li>
                <li>הפעלה / השבתה של סוג בקשה</li>
            </ul>
        </article>

        <article class="rtm-section">
            <h3 class="rtm-section-title">
                <span class="oi oi-clipboard" aria-hidden="true"></span>
                שדות בטופס הבקשה
            </h3>
            <ul class="rtm-section-list">
                <li>טקסט קצר / טקסט ארוך</li>
                <li>תאריך</li>
                <li>העלאת קובץ</li>
                <li>רשימה נפתחת (Select)</li>
                <li>תיבת סימון (Checkbox)</li>
                <li>סימון "חובה / אופציונלי" לכל שדה</li>
            </ul>
        </article>

        <article class="rtm-section">
            <h3 class="rtm-section-title">
                <span class="oi oi-tag" aria-hidden="true"></span>
                סטטוסים והרשאות
            </h3>
            <ul class="rtm-section-list">
                <li>הגדרת הסטטוסים האפשריים לכל סוג בקשה</li>
                <li>מי רשאי לטפל בסוג בקשה זה</li>
                <li>הפעלת הערות פנימיות (מנחה ↔ מרצה)</li>
                <li>הגדרת אילו תגובות הסטודנט רואה — סופיות בלבד או הכל</li>
            </ul>
        </article>
    </div>
</div>