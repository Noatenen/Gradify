@*
    ── ניהול המערכת (Admin Management hub) ──────────────────────────────────
    Route:  /management/admin  — the configuration-only admin area.

    NOT to be confused with /management (LecturerManagementPage), which is the
    lecturer's four-category operational page. This one is Admin-only and holds
    the 13 configuration destinations.

    Visual reference:
        Pages/Management/LecturerManagementPage.razor  (the sibling ניהול page)

    SHELL
    ─────
    Same title-row pattern as the other finished pages (38px / 700 / −0.035em),
    on the regular canvas background — no MPageHeader gradient, matching the
    sibling page. The student-registration link sits at the end of the title
    row so it stops competing with the page title for the first line.

    The card grid itself lives in ManagementCardsGrid.
*@

@*  SUPERSEDED 2026-09-01.
    This page and its ManagementCardsGrid / ManagementTopBar children were the
    separate Admin hub. Management is now ONE experience served by
    LecturerManagementPage (routes: /management and /management/admin), so this
    page no longer declares a route. The files are kept rather than deleted;
    nothing references them.
*@
@layout AppLayout
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = Roles.Admin)]

@inject NavigationManager Nav
@inject IJSRuntime         JS

<div class="mgh-page" dir="rtl">

    <!-- ══ Title row ══════════════════════════════════════════════════════════ -->
    <div class="mgh-title-row">
        <div class="mgh-title-block">
            <h1 class="mgh-h1">ניהול המערכת</h1>
            <p class="mgh-subtitle">הגדרות, תבניות ואינטגרציות של סביבת פרויקט הגמר</p>
        </div>

        <!-- Student registration link -->
        <div class="mgh-reg">
            <div class="mgh-reg-text">
                <span class="mgh-reg-label">לינק הרשמה לסטודנטים</span>
                <span class="mgh-reg-url" dir="ltr" title="@_registrationUrl">@_registrationUrl</span>
            </div>
            <button type="button" class="mgh-reg-btn" @onclick="CopyLink">
                @if (_copied)
                {
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M20 6 9 17l-5-5"></path>
                    </svg>
                    <span>הועתק</span>
                }
                else
                {
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <rect x="9" y="9" width="13" height="13" rx="2"></rect>
                        <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
                    </svg>
                    <span>העתקת קישור</span>
                }
            </button>
        </div>
    </div>

    <ManagementCardsGrid />
</div>

@code {
    private bool   _copied;
    private string _registrationUrl => Nav.BaseUri.TrimEnd('/') + "/create-team";

    private async Task CopyLink()
    {
        // Guarded: navigator.clipboard is undefined on a non-secure origin, and an
        // unhandled interop throw would surface as a Blazor error overlay.
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", _registrationUrl);
            _copied = true;
        }
        catch
        {
            return;
        }

        StateHasChanged();
        await Task.Delay(2500);
        _copied = false;
    }
}
