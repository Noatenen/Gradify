@*
    ── טפסים חיצוניים (Admin external-form links) ────────────────────────────
    Route:  /management/external-forms
    Parent: /management/integrations — this screen is reached ONLY from the
            "אינטגרציות חיצוניות" section of that page, so the back arrow
            names it. Sending a nested screen straight to /management would
            skip the level the user actually came from.

    Visual source:
        Client/Pages/Management/Integrations/IntegrationsManagement.razor
        Client/Pages/Management/Forms/FormsManagement.razor
    — the finished Admin screens. Same header rhythm (MAdminBack + h1 +
    MInfoTip, no permanent subtitle), the same list toolbar that carries the
    filter and the create action, the same tag / status / button language.

    WHAT IS REAL HERE
    ─────────────────
    Every row is a row of ExternalForms via GET /api/external-forms. The forms
    themselves live in the Innovation Team's systems; this page stores a
    pointer (IframeUrl) plus label and lifecycle metadata, nothing more. No
    field on the card is derived or invented — name, description, type, cycle,
    active flag and URL are all persisted columns.

    THIS PASS WAS PRESENTATION ONLY
    ───────────────────────────────
    Routes, endpoints, the save/toggle/delete calls, the cycle filter's
    semantics ("" = all, "0" = global, otherwise an AcademicYearId) and the
    two-stage load (a years failure is a warning, a forms failure is an error)
    are unchanged from the legacy version of this file.
*@

@page "/management/external-forms"
@layout AppLayout
@attribute [Authorize(Roles = $"{Roles.Admin},{Roles.Staff}")]
@using AuthWithAdmin.Shared.AuthSharedModels
@using System.Net.Http.Json
@inject HttpClient Http
@inject NavigationManager Nav

@* ══ EDITOR MODAL ════════════════════════════════════════════════════════ *@
@* MModal rather than the page's own overlay: one dialog shell across
   Management, and it already owns the scrim, the escape key and the focus
   trap this page used to go without. *@
<MModal IsOpen="_editor is not null"
        Title="@(_editorId is null ? "טופס חדש" : "עריכת טופס")"
        Size="MModal.ModalSize.Medium"
        OnClose="CloseEditor">
    <ChildContent>
        @if (_editor is not null)
        {
            <div class="exf-form">
                @if (!string.IsNullOrWhiteSpace(_editorError))
                {
                    <div class="exf-form-error" role="alert">@_editorError</div>
                }

                <label class="exf-field">
                    <span class="exf-label">שם הטופס <span class="exf-req">*</span></span>
                    <input class="exf-input" @bind="_editor.Name" maxlength="160"
                           placeholder="לדוגמה: בקשה לצוות חדשנות" />
                </label>

                <label class="exf-field">
                    <span class="exf-label">תיאור קצר</span>
                    <textarea class="exf-textarea" rows="2" @bind="_editor.Description"
                              placeholder="תיאור שיוצג לסטודנטים"></textarea>
                </label>

                <label class="exf-field">
                    <span class="exf-label">קטגוריה / סוג</span>
                    <input class="exf-input" @bind="_editor.FormType"
                           placeholder="לדוגמה: InnovationRequest" />
                </label>

                <label class="exf-field">
                    <span class="exf-label">קישור לטופס חיצוני <span class="exf-req">*</span></span>
                    @* Isolated, not merely dir="ltr": a Latin URL inside a
                       Hebrew page reorders the line around it otherwise. *@
                    <input class="exf-input exf-input--ltr" dir="ltr"
                           @bind="_editor.IframeUrl" placeholder="https://…" />
                    <span class="exf-hint">הטופס נפתח לסטודנטים בלשונית חדשה במערכת של צוות החדשנות</span>
                </label>

                <label class="exf-field">
                    <span class="exf-label">מחזור אקדמי</span>
                    <MSelectField Options="@EditorYearOptions"
                                  @bind-Value="_editorYearStr"
                                  AriaLabel="מחזור אקדמי"
                                  Class="exf-input" />
                </label>

                <div class="exf-switch-row">
                    <span class="exf-switch-copy">
                        <span class="exf-switch-title">טופס פעיל</span>
                        <span class="exf-switch-note">כשהטופס פעיל הוא מוצג לסטודנטים</span>
                    </span>
                    <MToggle Checked="_editor.IsActive"
                             CheckedChanged="@(v => _editor.IsActive = v)"
                             AriaLabel="טופס פעיל" />
                </div>
            </div>
        }
    </ChildContent>
    <FooterContent>
        <button type="button" class="exf-btn-ghost" @onclick="CloseEditor" disabled="@_saving">ביטול</button>
        <button type="button" class="exf-btn-primary motiva-cta" @onclick="SaveEditor" disabled="@_saving">
            @if (_saving)
            {
                <span class="exf-spinner" aria-hidden="true"></span>
            }
            @(_saving ? "שומר…" : "שמירה")
        </button>
    </FooterContent>
</MModal>

@{
    // Materialized once per render so the count and the rows read the same list.
    var rows = Filtered;
}

<div class="exf-page" dir="rtl" @onclick="CloseMenus">

    @* ══ Header ═══════════════════════════════════════════════════════════ *@
    <header class="exf-head">
        <div class="exf-head-main">
            <MAdminBack Href="/management/integrations" Label="אינטגרציות" />

            <div class="exf-head-line">
                <h1 class="exf-h1">טפסים חיצוניים</h1>
                <MInfoTip Text="קישורים לטפסים שמנוהלים במערכות צוות החדשנות — המערכת שומרת את הקישור ואת מצב הפרסום בלבד" />
            </div>
        </div>
    </header>

    @if (!string.IsNullOrEmpty(_toast))
    {
        <div class="exf-toast @(_toastError ? "exf-toast--error" : "")" role="status">@_toast</div>
    }

    @if (_loadError)
    {
        @* An error, not an empty list — the two must not look alike. *@
        <div class="exf-state exf-state--error" role="alert">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="10" /><path d="M12 8v4M12 16h.01" />
            </svg>
            <span>שגיאה בטעינת הטפסים.</span>
            <button type="button" class="exf-retry" @onclick="LoadAsync">ניסיון חוזר</button>
        </div>
    }
    else
    {
        @* Non-fatal: the forms loaded but the cycle list did not, so the
           filter and the editor's cycle picker are empty. Said once, quietly. *@
        @if (!_loading && !string.IsNullOrEmpty(_loadWarning))
        {
            <div class="exf-note" role="status">@_loadWarning</div>
        }

        @* ══ Toolbar ══════════════════════════════════════════════════════
           The cycle filter and "טופס חדש" both act on THIS list, so they sit
           on the list's own control row immediately above it rather than
           floating up in the page header. *@
        <div class="exf-toolbar" @onclick:stopPropagation="true">
            <div class="exf-filter">
                <button type="button"
                        class="exf-filter-btn @(_yearFilter.Length > 0 ? "exf-filter-btn--on" : "")"
                        @onclick="ToggleFilterMenu"
                        aria-haspopup="listbox" aria-expanded="@(_filterOpen ? "true" : "false")">
                    <span class="exf-filter-name">מחזור</span>
                    <span class="exf-filter-value">@YearFilterLabel</span>
                    <svg class="exf-filter-chev @(_filterOpen ? "exf-filter-chev--open" : "")"
                         width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="m6 9 6 6 6-6" />
                    </svg>
                </button>

                @if (_filterOpen)
                {
                    <div class="exf-menu exf-menu--filter" role="listbox" aria-label="מחזור">
                        @foreach (var o in YearFilterOptions)
                        {
                            var val = o.Value;
                            var selected = val == _yearFilter;
                            <button type="button"
                                    class="exf-menu-item @(selected ? "exf-menu-item--on" : "")"
                                    role="option" aria-selected="@(selected ? "true" : "false")"
                                    @onclick="@(() => PickYearFilter(val))">
                                <span class="exf-menu-item-label">@o.Label</span>
                                @if (selected)
                                {
                                    <svg class="exf-menu-check" width="12" height="12" viewBox="0 0 24 24"
                                         fill="none" stroke="currentColor" stroke-width="2.6"
                                         stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <path d="m5 12.5 4.5 4.5L19 7" />
                                    </svg>
                                }
                            </button>
                        }
                    </div>
                }
            </div>

            @if (_yearFilter.Length > 0)
            {
                <button type="button" class="exf-clear" @onclick="ClearFilter">ניקוי סינון</button>
            }

            <div class="exf-toolbar-end">
                @if (!_loading)
                {
                    <span class="exf-result">@ResultLine(rows.Count)</span>
                }

                <button type="button" class="exf-btn-primary motiva-cta" @onclick="OpenNew">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="2.4" stroke-linecap="round" aria-hidden="true">
                        <path d="M12 5v14M5 12h14" />
                    </svg>
                    טופס חדש
                </button>
            </div>
        </div>

        @* ══ List ═════════════════════════════════════════════════════════ *@
        @if (_loading)
        {
            <MLoadingState Label="טוען טפסים…" />
        }
        else if (rows.Count == 0)
        {
            @* Two different emptinesses. "No forms at all" invites the first
               one; "the filter matched nothing" offers the way out of it. *@
            <MEmptyState Title="@(_forms.Count == 0 ? "אין טפסים חיצוניים" : "אין טפסים תואמים")"
                         Description="@(_forms.Count == 0
                             ? "טופס חיצוני הוא קישור לטופס שמנוהל אצל צוות החדשנות. הוסיפו את הראשון כדי שיוצג לסטודנטים."
                             : "לא נמצאו טפסים במחזור שנבחר.")"
                         Live="@(_forms.Count > 0)">
                <Action>
                    @if (_forms.Count == 0)
                    {
                        <button type="button" class="exf-btn-primary motiva-cta" @onclick="OpenNew">
                            יצירת טופס ראשון
                        </button>
                    }
                    else
                    {
                        <button type="button" class="exf-btn-ghost" @onclick="ClearFilter">ניקוי סינון</button>
                    }
                </Action>
            </MEmptyState>
        }
        else
        {
            <div class="exf-list">
                @foreach (var f in rows)
                {
                    <article class="exf-item @(f.IsActive ? "" : "exf-item--off")">

                        @* Row 1 — identity: what this form is, and whether it
                           is live. *@
                        <div class="exf-item-head">
                            <button type="button" class="exf-name" @onclick="@(() => OpenEdit(f))">
                                <span class="exf-name-text">@f.Name</span>
                            </button>

                            @if (!string.IsNullOrWhiteSpace(f.FormType))
                            {
                                <span class="exf-tag exf-tag--type">@f.FormType</span>
                            }

                            @if (f.AcademicYearId is not null && !string.IsNullOrWhiteSpace(f.AcademicYearName))
                            {
                                <span class="exf-tag">מחזור @f.AcademicYearName</span>
                            }
                            else
                            {
                                <span class="exf-tag exf-tag--global">גלובלי</span>
                            }

                            <span class="exf-status @(f.IsActive ? "exf-status--on" : "exf-status--off")">
                                <span class="exf-status-dot" aria-hidden="true"></span>
                                @(f.IsActive ? "פעיל" : "מושבת")
                            </span>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(f.Description))
                        {
                            <p class="exf-item-desc">@f.Description</p>
                        }

                        @* Row 2 — the pointer and the actions on it. The URL is
                           the card's quietest line by design: it is an address,
                           not the form's identity. It ellipses on screen and
                           carries the full value in title=, and the anchor
                           still opens the real thing. *@
                        <div class="exf-item-foot">
                            <a class="exf-url" href="@f.IframeUrl" target="_blank" rel="noopener"
                               dir="ltr" title="@f.IframeUrl">
                                <svg class="exf-url-ico" width="13" height="13" viewBox="0 0 24 24" fill="none"
                                     stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                     stroke-linejoin="round" aria-hidden="true">
                                    <path d="M10 13a5 5 0 0 0 7.5.5l3-3a5 5 0 0 0-7-7l-1.7 1.7" />
                                    <path d="M14 11a5 5 0 0 0-7.5-.5l-3 3a5 5 0 0 0 7 7l1.7-1.7" />
                                </svg>
                                <span class="exf-url-text">@f.IframeUrl</span>
                            </a>

                            <div class="exf-item-actions">
                                <button type="button" class="exf-btn-secondary exf-btn-secondary--sm"
                                        @onclick="@(() => OpenEdit(f))">עריכה</button>

                                @* Enable/disable is a lifecycle switch, not a
                                   destruction — neutral, same weight as edit. *@
                                <button type="button" class="exf-btn-secondary exf-btn-secondary--sm"
                                        disabled="@_busyIds.Contains(f.Id)"
                                        @onclick="@(() => ToggleActive(f))">
                                    @(f.IsActive ? "השבתה" : "הפעלה")
                                </button>

                                @* The only destructive control on the page, and
                                   the only rose. *@
                                <button type="button" class="exf-btn-danger exf-btn-danger--sm"
                                        disabled="@_busyIds.Contains(f.Id)"
                                        @onclick="@(() => Delete(f))">מחיקה</button>
                            </div>
                        </div>
                    </article>
                }
            </div>
        }
    }
</div>

@code {
    private List<ExternalFormDto> _forms = new();
    private List<AcademicYearDto> _years = new();
    private bool _loading = true;
    private bool _loadError = false;
    /// <summary>Optional secondary message — set when the years list failed
    /// but the main forms list succeeded, so we still render the page.</summary>
    private string _loadWarning = "";

    private string _yearFilter = "";
    private bool   _filterOpen = false;

    private string _toast = "";
    private bool   _toastError = false;
    private readonly HashSet<int> _busyIds = new();

    // Editor state
    private ExternalFormSaveRequest? _editor;
    private int? _editorId;
    private string _editorYearStr = "";

    /// <summary>The editor's cycle dropdown. Same values and labels the native
    /// &lt;select&gt; produced — "" for global, otherwise the AcademicYearId as a
    /// string, with the current cycle suffixed "(נוכחי)".</summary>
    private IReadOnlyList<MSelect.Option> EditorYearOptions =>
        new[] { new MSelect.Option("", "ללא מחזור (גלובלי)") }
        .Concat(_years.Select(y => new MSelect.Option(
            y.Id.ToString(), y.Name + (y.IsCurrent ? " (נוכחי)" : ""))))
        .ToArray();
    private string _editorError = "";
    private bool _saving = false;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        // Load the two lists independently — a failure on the years list
        // (different controller / different auth) must not break the page.
        // Only a failure on the primary forms list is a real error.
        _loading     = true;
        _loadError   = false;
        _loadWarning = "";

        try
        {
            var forms = await Http.GetFromJsonAsync<List<ExternalFormDto>>("api/external-forms");
            _forms = forms ?? new();
        }
        catch (Exception ex)
        {
            _loadError = true;
            _loadWarning = ex.Message;
            _loading = false;
            return;
        }

        try
        {
            var years = await Http.GetFromJsonAsync<List<AcademicYearDto>>("api/management/academic-years");
            _years = years ?? new();
        }
        catch
        {
            // Forms list still renders; the year filter and the year picker
            // in the editor just won't be populated.
            _years = new();
            _loadWarning = "טעינת רשימת המחזורים נכשלה — סינון לפי מחזור אינו זמין כרגע.";
        }

        _loading = false;
    }

    // ── Filter ───────────────────────────────────────────────────────────────
    // Unchanged semantics: "" = every form, "0" = the global ones (no cycle),
    // anything else = an AcademicYearId.

    private List<ExternalFormDto> Filtered
    {
        get
        {
            if (string.IsNullOrEmpty(_yearFilter)) return _forms;
            if (_yearFilter == "0") return _forms.Where(f => f.AcademicYearId is null).ToList();
            if (int.TryParse(_yearFilter, out var yid))
                return _forms.Where(f => f.AcademicYearId == yid).ToList();
            return _forms;
        }
    }

    private sealed record FilterOption(string Value, string Label);

    private List<FilterOption> YearFilterOptions
    {
        get
        {
            // "גלובלי" rather than the editor's fuller "ללא מחזור (גלובלי)":
            // this label is also what the PILL prints beside its own "מחזור"
            // caption, where the long form reads "מחזור · ללא מחזור (גלובלי)".
            // It is the same word the card's own tag uses for these forms, so
            // the filter and the list speak one vocabulary.
            var list = new List<FilterOption>
            {
                new("",  "כל המחזורים"),
                new("0", "גלובלי"),
            };
            list.AddRange(_years.Select(y => new FilterOption(y.Id.ToString(), y.Name)));
            return list;
        }
    }

    private string YearFilterLabel =>
        YearFilterOptions.FirstOrDefault(o => o.Value == _yearFilter)?.Label ?? "כל המחזורים";

    private void ToggleFilterMenu() => _filterOpen = !_filterOpen;

    private void PickYearFilter(string value)
    {
        _yearFilter = value;
        _filterOpen = false;
    }

    private void ClearFilter()
    {
        _yearFilter = "";
        _filterOpen = false;
    }

    private void CloseMenus() => _filterOpen = false;

    private static string ResultLine(int n) => n switch
    {
        0 => "אין תוצאות",
        1 => "טופס אחד",
        _ => $"{n} טפסים",
    };

    // ── Editor ───────────────────────────────────────────────────────────────

    private void OpenNew()
    {
        _filterOpen = false;
        _editorId = null;
        _editor = new ExternalFormSaveRequest { IsActive = true };
        // Default to the current academic cycle so admins don't have to
        // pick a year every time. They can still flip back to "Global"
        // ("ללא מחזור") if the form is evergreen.
        var currentCycle = _years.FirstOrDefault(y => y.IsCurrent);
        _editorYearStr   = currentCycle is null ? "" : currentCycle.Id.ToString();
        _editorError = "";
    }

    private void OpenEdit(ExternalFormDto f)
    {
        _filterOpen = false;
        _editorId = f.Id;
        _editor = new ExternalFormSaveRequest
        {
            Name           = f.Name,
            Description    = f.Description,
            FormType       = f.FormType,
            IframeUrl      = f.IframeUrl,
            IsActive       = f.IsActive,
            AcademicYearId = f.AcademicYearId,
        };
        _editorYearStr = f.AcademicYearId?.ToString() ?? "";
        _editorError = "";
    }

    private void CloseEditor()
    {
        _editor = null;
        _editorId = null;
        _saving = false;
    }

    private async Task SaveEditor()
    {
        if (_editor is null) return;
        if (string.IsNullOrWhiteSpace(_editor.Name))      { _editorError = "שם הטופס חובה";    return; }
        if (string.IsNullOrWhiteSpace(_editor.IframeUrl)) { _editorError = "קישור לטופס חיצוני הוא שדה חובה"; return; }

        _editor.AcademicYearId = int.TryParse(_editorYearStr, out var yid) && yid > 0 ? yid : null;

        _saving = true;
        _editorError = "";
        try
        {
            HttpResponseMessage resp;
            if (_editorId is null)
                resp = await Http.PostAsJsonAsync("api/external-forms", _editor);
            else
                resp = await Http.PutAsJsonAsync($"api/external-forms/{_editorId}", _editor);

            if (!resp.IsSuccessStatusCode)
            {
                _editorError = await resp.Content.ReadAsStringAsync() is { } body && !string.IsNullOrWhiteSpace(body)
                    ? body.Trim('"')
                    : "שגיאה בשמירת הטופס";
                _saving = false;
                return;
            }

            await ReloadAsync();
            ShowToast(_editorId is null ? "הטופס נוצר" : "הטופס עודכן", false);
            CloseEditor();
        }
        catch
        {
            _editorError = "שגיאת תקשורת";
            _saving = false;
        }
    }

    private async Task ToggleActive(ExternalFormDto f)
    {
        if (_busyIds.Contains(f.Id)) return;
        _busyIds.Add(f.Id);
        try
        {
            var resp = await Http.PostAsync($"api/external-forms/{f.Id}/toggle", null);
            if (resp.IsSuccessStatusCode)
            {
                f.IsActive = !f.IsActive;
                ShowToast(f.IsActive ? "הטופס הופעל" : "הטופס הושבת", false);
            }
            else
            {
                ShowToast("פעולה נכשלה", true);
            }
        }
        catch
        {
            ShowToast("שגיאת תקשורת", true);
        }
        finally
        {
            _busyIds.Remove(f.Id);
        }
    }

    private async Task Delete(ExternalFormDto f)
    {
        if (_busyIds.Contains(f.Id)) return;
        _busyIds.Add(f.Id);
        try
        {
            var resp = await Http.DeleteAsync($"api/external-forms/{f.Id}");
            if (resp.IsSuccessStatusCode)
            {
                _forms.Remove(f);
                ShowToast("הטופס נמחק", false);
            }
            else
            {
                ShowToast("המחיקה נכשלה", true);
            }
        }
        catch
        {
            ShowToast("שגיאת תקשורת", true);
        }
        finally
        {
            _busyIds.Remove(f.Id);
        }
    }

    private async Task ReloadAsync()
    {
        try
        {
            var list = await Http.GetFromJsonAsync<List<ExternalFormDto>>("api/external-forms");
            _forms = list ?? new();
        }
        catch { /* leave existing list intact */ }
    }

    private void ShowToast(string msg, bool isError)
    {
        _toast = msg;
        _toastError = isError;
        _ = HideToastSoon();
    }

    private async Task HideToastSoon()
    {
        await Task.Delay(2500);
        _toast = "";
        StateHasChanged();
    }
}
