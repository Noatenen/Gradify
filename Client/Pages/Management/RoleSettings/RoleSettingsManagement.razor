@*
    ── הרשאות לפי תפקיד (Admin role-feature matrix) ─────────────────────────
    Route:  /management/role-settings  — reached from the ניהול hub
            (group "הגדרות").

    Visual source:
        Client/Pages/Management/Milestones/MilestonesManagement.razor
        Client/Pages/Management/Users/UsersManagement.razor
    — the finished Admin list screens. Same header rhythm, strip, MDataTable
    treatment and button language, applied to a matrix instead of a list.

    WHAT THIS PAGE IS
    ─────────────────
    The RoleSettings feature-flag matrix behind /api/role-settings: one row
    per role, one column per flag in RoleFeatures.All. It is deliberately
    NOT the key-based Permissions/RolePermissions system — the two coexist,
    and this screen is the only way to reach these flags, which
    ManagementHubDefinitions itself reads through RequiresFlag.

    Saving is PER ROLE, because the API is PUT /api/role-settings/{roleName}
    — one row, one request. A single "save everything" button would have to
    fan out into five independent requests that can half-fail, so the row
    keeps its own action and its own dirty state.

    WHAT CHANGED IN THIS PASS — PRESENTATION ONLY
    ─────────────────────────────────────────────
    The matrix moved onto MDataTable, the checkboxes and role chips adopted
    the Motiva controls, and the two families of flag (ניהול / שימוש) are
    separated by a hairline so the grid can be scanned. Toggle, dirty
    tracking, save payload and error handling are untouched.
*@

@page "/management/role-settings"
@layout AppLayout
@attribute [Authorize(Roles = Roles.Admin)]
@using AuthWithAdmin.Client.Services
@using AuthWithAdmin.Shared.AuthSharedModels
@inject NavigationManager Nav
@inject IRoleSettingsManagementService RoleSettingsService

<div class="rs-page" dir="rtl">

    @* ══ Header ═══════════════════════════════════════════════════════════ *@
    <header class="rs-head">
        <div class="rs-head-main">
            <button type="button" class="rs-crumb" @onclick="@(() => Nav.NavigateTo("/management"))">
                ניהול
                <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="m15 18-6-6 6-6" />
                </svg>
            </button>

            <div class="rs-head-line">
                <h1 class="rs-h1">הרשאות לפי תפקיד</h1>
                <p class="rs-subtitle">מה מותר לכל תפקיד במערכת</p>
            </div>
        </div>

        @if (!_loading && !_loadError && _dirtyRoles.Count > 0)
        {
            <div class="rs-head-actions">
                <span class="rs-dirty-note">
                    <span class="rs-dirty-dot" aria-hidden="true"></span>
                    @DirtyLine
                </span>
            </div>
        }
    </header>

    @* ══ Info strip ═══════════════════════════════════════════════════════ *@
    <div class="rs-strip">
        <div class="rs-strip-copy">
            <span class="rs-strip-glyph" aria-hidden="true">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="9" /><path d="M12 16v-4" /><path d="M12 8h.01" />
                </svg>
            </span>
            <p class="rs-strip-text">
                כל שורה היא תפקיד, כל עמודה יכולת. השמירה מתבצעת לכל תפקיד בנפרד —
                שינויים נכנסים לתוקף עבור משתמשים חדשים מיד, ומשתמשים קיימים ירעננו את הדף.
            </p>
        </div>

        @if (!_loading && !_loadError)
        {
            <div class="rs-stats">
                <span class="rs-stat">
                    <span class="rs-stat-dot rs-stat-dot--roles" aria-hidden="true"></span>
                    <span class="rs-stat-value">@_rows.Count</span>
                    <span class="rs-stat-label">תפקידים</span>
                </span>
                <span class="rs-stat">
                    <span class="rs-stat-dot rs-stat-dot--flags" aria-hidden="true"></span>
                    <span class="rs-stat-value">@RoleFeatures.All.Count</span>
                    <span class="rs-stat-label">יכולות</span>
                </span>
            </div>
        }
    </div>

    @* ══ The matrix ═══════════════════════════════════════════════════════ *@
    <MDataTable TItem="RoleSettingsDto"
                Items="_rows"
                Loading="_loading"
                LoadingText="טוען הרשאות…"
                ColumnCount="11"
                MinWidth="1080px"
                Class="rs-table">

        <Columns>
            <col class="rs-col-role" />
            <col class="rs-col-flag" />
            <col class="rs-col-flag" />
            <col class="rs-col-flag" />
            <col class="rs-col-flag" />
            <col class="rs-col-flag" />
            <col class="rs-col-flag" />
            <col class="rs-col-flag" />
            <col class="rs-col-flag" />
            <col class="rs-col-flag" />
            <col class="rs-col-actions" />
        </Columns>

        <HeaderContent>
            <th scope="col" class="rs-th-role">תפקיד</th>
            @* The five ניהול flags, then the four שימוש flags. The band change
               is drawn by rs-th-flag--band / rs-cell-flag--band below. *@
            <th scope="col" class="rs-th-flag" title="@RoleFeatures.CanManageRequests">@RoleFeatures.Label(RoleFeatures.CanManageRequests)</th>
            <th scope="col" class="rs-th-flag" title="@RoleFeatures.CanManageMilestones">@RoleFeatures.Label(RoleFeatures.CanManageMilestones)</th>
            <th scope="col" class="rs-th-flag" title="@RoleFeatures.CanManageAssignments">@RoleFeatures.Label(RoleFeatures.CanManageAssignments)</th>
            <th scope="col" class="rs-th-flag" title="@RoleFeatures.CanManageUsers">@RoleFeatures.Label(RoleFeatures.CanManageUsers)</th>
            <th scope="col" class="rs-th-flag" title="@RoleFeatures.CanManageAirtable">@RoleFeatures.Label(RoleFeatures.CanManageAirtable)</th>
            <th scope="col" class="rs-th-flag rs-th-flag--band" title="@RoleFeatures.CanOpenRequests">@RoleFeatures.Label(RoleFeatures.CanOpenRequests)</th>
            <th scope="col" class="rs-th-flag" title="@RoleFeatures.CanViewTasks">@RoleFeatures.Label(RoleFeatures.CanViewTasks)</th>
            <th scope="col" class="rs-th-flag" title="@RoleFeatures.CanSubmitTasks">@RoleFeatures.Label(RoleFeatures.CanSubmitTasks)</th>
            <th scope="col" class="rs-th-flag" title="@RoleFeatures.CanViewLecturerDashboard">@RoleFeatures.Label(RoleFeatures.CanViewLecturerDashboard)</th>
            <th scope="col" class="rs-th-actions"><span class="rs-sr">שמירה</span></th>
        </HeaderContent>

        <EmptyContent>
            @if (_loadError)
            {
                <MEmptyState Title="שגיאה בטעינת ההרשאות"
                             Description="רעננו את הדף או נסו שוב מאוחר יותר"
                             Live="true" />
            }
            else
            {
                <MEmptyState Title="לא הוגדרו תפקידים"
                             Description="אין שורות הרשאה להצגה"
                             Live="true" />
            }
        </EmptyContent>

        <RowTemplate Context="row">
            @{
                var dirty  = _dirtyRoles.Contains(row.RoleName);
                var saving = _savingRoles.Contains(row.RoleName);
            }
            <tr class="@(dirty ? "rs-row--dirty" : "")">

                <td class="rs-cell-role">
                    <span class="rs-role rs-role--@row.RoleName.ToLowerInvariant()">@RoleLabel(row.RoleName)</span>
                    @if (dirty)
                    {
                        <span class="rs-unsaved">לא נשמר</span>
                    }
                </td>

                <td class="rs-cell-flag">
                    <input type="checkbox" class="rs-check"
                           aria-label="@($"{RoleFeatures.Label(RoleFeatures.CanManageRequests)} — {RoleLabel(row.RoleName)}")"
                           checked="@row.CanManageRequests"
                           @onchange="@(e => Toggle(row, RoleFeatures.CanManageRequests, e))" />
                </td>
                <td class="rs-cell-flag">
                    <input type="checkbox" class="rs-check"
                           aria-label="@($"{RoleFeatures.Label(RoleFeatures.CanManageMilestones)} — {RoleLabel(row.RoleName)}")"
                           checked="@row.CanManageMilestones"
                           @onchange="@(e => Toggle(row, RoleFeatures.CanManageMilestones, e))" />
                </td>
                <td class="rs-cell-flag">
                    <input type="checkbox" class="rs-check"
                           aria-label="@($"{RoleFeatures.Label(RoleFeatures.CanManageAssignments)} — {RoleLabel(row.RoleName)}")"
                           checked="@row.CanManageAssignments"
                           @onchange="@(e => Toggle(row, RoleFeatures.CanManageAssignments, e))" />
                </td>
                <td class="rs-cell-flag">
                    <input type="checkbox" class="rs-check"
                           aria-label="@($"{RoleFeatures.Label(RoleFeatures.CanManageUsers)} — {RoleLabel(row.RoleName)}")"
                           checked="@row.CanManageUsers"
                           @onchange="@(e => Toggle(row, RoleFeatures.CanManageUsers, e))" />
                </td>
                <td class="rs-cell-flag">
                    <input type="checkbox" class="rs-check"
                           aria-label="@($"{RoleFeatures.Label(RoleFeatures.CanManageAirtable)} — {RoleLabel(row.RoleName)}")"
                           checked="@row.CanManageAirtable"
                           @onchange="@(e => Toggle(row, RoleFeatures.CanManageAirtable, e))" />
                </td>

                <td class="rs-cell-flag rs-cell-flag--band">
                    <input type="checkbox" class="rs-check"
                           aria-label="@($"{RoleFeatures.Label(RoleFeatures.CanOpenRequests)} — {RoleLabel(row.RoleName)}")"
                           checked="@row.CanOpenRequests"
                           @onchange="@(e => Toggle(row, RoleFeatures.CanOpenRequests, e))" />
                </td>
                <td class="rs-cell-flag">
                    <input type="checkbox" class="rs-check"
                           aria-label="@($"{RoleFeatures.Label(RoleFeatures.CanViewTasks)} — {RoleLabel(row.RoleName)}")"
                           checked="@row.CanViewTasks"
                           @onchange="@(e => Toggle(row, RoleFeatures.CanViewTasks, e))" />
                </td>
                <td class="rs-cell-flag">
                    <input type="checkbox" class="rs-check"
                           aria-label="@($"{RoleFeatures.Label(RoleFeatures.CanSubmitTasks)} — {RoleLabel(row.RoleName)}")"
                           checked="@row.CanSubmitTasks"
                           @onchange="@(e => Toggle(row, RoleFeatures.CanSubmitTasks, e))" />
                </td>
                <td class="rs-cell-flag">
                    <input type="checkbox" class="rs-check"
                           aria-label="@($"{RoleFeatures.Label(RoleFeatures.CanViewLecturerDashboard)} — {RoleLabel(row.RoleName)}")"
                           checked="@row.CanViewLecturerDashboard"
                           @onchange="@(e => Toggle(row, RoleFeatures.CanViewLecturerDashboard, e))" />
                </td>

                <td class="rs-cell-actions">
                    <button type="button"
                            class="rs-save @(dirty ? "rs-save--on motiva-cta" : "rs-save--off")"
                            disabled="@(!dirty || saving)"
                            @onclick="@(() => SaveRow(row))">
                        @(saving ? "שומר…" : "שמירה")
                    </button>
                </td>
            </tr>
        </RowTemplate>
    </MDataTable>

    @if (!string.IsNullOrEmpty(_saveError))
    {
        <p class="rs-error" role="alert">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="9" /><path d="M12 8v5" /><path d="M12 16h.01" />
            </svg>
            @_saveError
        </p>
    }

    @* The two families the columns are grouped into. A legend rather than a
       second header row: MDataTable renders exactly one <tr> in its head. *@
    @if (!_loading && !_loadError)
    {
        <p class="rs-legend">
            <span class="rs-legend-item"><span class="rs-legend-dot rs-legend-dot--manage" aria-hidden="true"></span>חמש העמודות הראשונות — יכולות ניהול</span>
            <span class="rs-legend-item"><span class="rs-legend-dot rs-legend-dot--use" aria-hidden="true"></span>ארבע האחרונות — יכולות שימוש יומיומיות</span>
        </p>
    }
</div>

@code {
    private List<RoleSettingsDto> _rows = new();
    private bool _loading   = true;
    private bool _loadError;
    private string _saveError = "";

    // Track which rows have unsaved edits, and which are mid-save.
    private readonly HashSet<string> _dirtyRoles  = new();
    private readonly HashSet<string> _savingRoles = new();

    protected override async Task OnInitializedAsync()
    {
        var result = await RoleSettingsService.GetAllAsync();
        _loadError = result is null;
        _rows      = result ?? new();
        _loading   = false;
    }

    private string DirtyLine => _dirtyRoles.Count == 1
        ? "שינוי שלא נשמר בתפקיד אחד"
        : $"שינויים שלא נשמרו ב-{_dirtyRoles.Count} תפקידים";

    private void Toggle(RoleSettingsDto row, string flag, ChangeEventArgs e)
    {
        bool value = e.Value is bool b && b;
        switch (flag)
        {
            case RoleFeatures.CanManageRequests:        row.CanManageRequests        = value; break;
            case RoleFeatures.CanManageMilestones:      row.CanManageMilestones      = value; break;
            case RoleFeatures.CanManageAssignments:     row.CanManageAssignments     = value; break;
            case RoleFeatures.CanManageUsers:           row.CanManageUsers           = value; break;
            case RoleFeatures.CanManageAirtable:        row.CanManageAirtable        = value; break;
            case RoleFeatures.CanOpenRequests:          row.CanOpenRequests          = value; break;
            case RoleFeatures.CanViewTasks:             row.CanViewTasks             = value; break;
            case RoleFeatures.CanSubmitTasks:           row.CanSubmitTasks           = value; break;
            case RoleFeatures.CanViewLecturerDashboard: row.CanViewLecturerDashboard = value; break;
        }
        _dirtyRoles.Add(row.RoleName);
        _saveError = "";
    }

    private async Task SaveRow(RoleSettingsDto row)
    {
        _saveError = "";
        _savingRoles.Add(row.RoleName);

        var ok = await RoleSettingsService.SaveAsync(row.RoleName, new SaveRoleSettingsRequest
        {
            CanManageRequests        = row.CanManageRequests,
            CanManageMilestones      = row.CanManageMilestones,
            CanManageAssignments     = row.CanManageAssignments,
            CanManageUsers           = row.CanManageUsers,
            CanManageAirtable        = row.CanManageAirtable,
            CanOpenRequests          = row.CanOpenRequests,
            CanViewTasks             = row.CanViewTasks,
            CanSubmitTasks           = row.CanSubmitTasks,
            CanViewLecturerDashboard = row.CanViewLecturerDashboard,
        });

        _savingRoles.Remove(row.RoleName);

        if (!ok)
        {
            _saveError = $"שמירת ההרשאות עבור {RoleLabel(row.RoleName)} נכשלה.";
            return;
        }

        _dirtyRoles.Remove(row.RoleName);
        row.UpdatedAt = DateTime.Now;
    }

    private static string RoleLabel(string roleName) => roleName switch
    {
        "Admin"   => "מנהל",
        "Staff"   => "מרצה",
        "Mentor"  => "מנחה",
        "Student" => "סטודנט",
        "User"    => "משתמש",
        _         => roleName,
    };
}
