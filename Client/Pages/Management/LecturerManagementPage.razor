@*
    ── ניהול (Lecturer Management) ──────────────────────────────────────────
    Route:  /management  — the "ניהול" nav item in the Lecturer/Staff shell.

    Visual reference:
        Motiva Lecturer Management.dc.html
        design/design-system/MotivaLecturerDesign/ניהול מרצה 268.pdf

    OVERVIEW STATE
    ──────────────
    2×2 grid of four management category cards. Each card navigates into its
    category detail view without leaving the page.

    CATEGORY DETAIL STATES
    ──────────────────────
    1. צוותים ושיוכים   — compact team rows with inline mentor assignment
    2. אבני דרך ומועדים — milestone rows with inline date editing
    3. ניהול משאבים     — resource rows with project-type visibility toggles
    4. הרשאות והגדרות   — role feature-flag matrix with toggle switches

    SHELL
    ─────
    Same title-row pattern as the other Lecturer pages (38 px / 700 / −0.035 em).
    No MPageHeader gradient — sits on the regular page background.
*@

@page "/management"
@* Compatibility: /management/admin was a second, competing hub with the same
   13 modules. It now resolves to this one Management experience so the two
   cannot drift apart. Existing links and bookmarks keep working. *@
@page "/management/admin"
@layout AppLayout
@attribute [Authorize(Roles = Roles.Admin + "," + Roles.Staff)]
@namespace AuthWithAdmin.Client.Pages.Management
@using Microsoft.AspNetCore.Authorization
@using AuthWithAdmin.Client.Components
@using AuthWithAdmin.Client.Services
@using AuthWithAdmin.Shared.AuthSharedModels
@using Microsoft.AspNetCore.Components.Authorization

@inject IDashboardOverviewService        DashboardService
@inject IMilestoneManagementService      MilestoneService
@inject IResourceFilesService            ResourceFilesService
@inject IRoleSettingsManagementService   RoleSettingsService
@inject IProjectMentorsService           MentorsService
@inject NavigationManager                Nav
@inject AuthenticationStateProvider      AuthState

<div class="lmg-page" dir="rtl">

    <!-- ══ Title row ══════════════════════════════════════════════════════════ -->
    <div class="lmg-title-row">
        <div class="lmg-title-block">
            @if (_activeSection is not null)
            {
                <button type="button" class="lmg-back" @onclick="GoBack">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="m9 18 6-6-6-6"></path>
                    </svg>
                    חזרה לניהול
                </button>
            }
            <h1 class="lmg-h1">ניהול</h1>
            @* The overview carries NO subtitle — the six category heads below
               already say what the page holds, and a sentence repeating them
               only pushes the first card down. A category keeps its own line,
               which says something the title does not. *@
            @if (_activeSection is not null)
            {
                <p class="lmg-subtitle">@SectionSubtitle(_activeSection)</p>
            }
        </div>

    </div>

    <!-- ══ Loading ════════════════════════════════════════════════════════════ -->
    @if (_loading)
    {
        <div class="lmg-loading" role="status" aria-live="polite">
            <span class="lmg-spinner" aria-hidden="true"></span>
            <span>טוענת נתוני ניהול…</span>
        </div>
    }
    else
    {
        <!-- ══ Overview — six grouped management surfaces ═══════════════════ -->
        @*  Each group is ONE bounded Motiva surface (MCard, the shared section
            card: translucent .66 white, white hairline, radius-lg, shadow-md)
            holding a head and its own module rows, so the six management areas
            read as areas rather than as six lists of loose text.

            The gradient glyph is the group head's — one per card, which is the
            product-wide rule for the mark. Row glyphs are the same paint server
            with no chip behind them; a filled violet block per row is the
            treatment the finished screens do not use. *@
        @if (_activeSection is null)
        {
            // ONE card template, rendered by both columns, so the two stacks
            // cannot drift apart. slot.Order is the group's LOGICAL index — see
            // the note on the narrow breakpoint in the stylesheet.
            RenderFragment<GroupSlot> groupCard = slot =>
        @<MCard Padding="MCard.CardPadding.None" Class="@($"lmg-group-card lmg-o{slot.Order}")">
            <section class="lmg-group" aria-labelledby="@slot.Group.Id">
                <div class="lmg-group-head">
                    <span class="lmg-group-icon motiva-ico-gradient" aria-hidden="true">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
                             stroke="url(#motivaIconGradient)" stroke-width="1.9"
                             stroke-linecap="round" stroke-linejoin="round">
                            @((MarkupString)slot.Group.IconPaths)
                        </svg>
                    </span>
                    <h2 class="lmg-group-title" id="@slot.Group.Id">@slot.Group.Title</h2>
                </div>

                <div class="lmg-mods">
                    @foreach (var item in slot.Group.Items)
                    {
                        var it = item;
                        <button type="button" class="lmg-mod" @onclick="() => ActivateItem(it)">
                            <span class="lmg-mod-text">
                                <span class="lmg-mod-title">@it.Title</span>
                                @* One line, muted, always visible — several of these
                                   module names do not explain themselves, and a
                                   tooltip would make the page unreadable without a
                                   pointer. `title` is the fallback for the narrow
                                   widths where the line has to ellipsise, not the
                                   way the description is meant to be read. *@
                                <span class="lmg-mod-desc" title="@it.Description">@it.Description</span>
                            </span>

                            @if (!string.IsNullOrWhiteSpace(it.Count))
                            {
                                <span class="motiva-tag lmg-mod-tag">@it.Count</span>
                            }

                            <span class="lmg-mod-chevron" aria-hidden="true">
                                @if (it.SectionKey is not null)
                                {
                                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                         stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="m6 9 6 6 6-6"></path>
                                    </svg>
                                }
                                else
                                {
                                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                         stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="m15 6-6 6 6 6"></path>
                                    </svg>
                                }
                            </span>
                        </button>

                        @if (it.AssignmentLink)
                        {
                            @* The student assignment form belongs to THIS module,
                               not to the page — it used to be a full-width bar at
                               the foot of the hub, which said it was a global
                               Management utility. Nested under its own row instead.
                               The component owns the URL and the copy behaviour, so
                               the assignment screen can render the same action from
                               the same source. *@
                            <StudentRegistrationLink Class="lmg-mod-action" />
                        }
                    }
                </div>
            </section>
        </MCard>;

            var columns = SplitColumns();

            <div class="lmg-groups">
                @*  TWO INDEPENDENT COLUMNS, not a two-track grid. A grid aligns
                    the cards by row, so a short group leaves a hole under itself
                    while it waits for the taller group beside it. Each column
                    here stacks only its own groups. *@
                <div class="lmg-cols">
                    <div class="lmg-col">
                        @foreach (var slot in columns.A) { @groupCard(slot) }
                    </div>
                    <div class="lmg-col">
                        @foreach (var slot in columns.B) { @groupCard(slot) }
                    </div>
                </div>

            </div>
        }

        <!-- ══ צוותים ושיוכים ════════════════════════════════════════════════ -->
        @if (_activeSection == "teams")
        {
            <section class="lmg-panel" aria-labelledby="lmg-teams-title">
                <div class="lmg-panel-head">
                    <h2 class="lmg-panel-title" id="lmg-teams-title">צוותים ושיוכים</h2>
                    <span class="motiva-tag lmg-head-tag">@_projects.Count צוותים</span>
                    <span class="lmg-head-note">שינוי שיוך מנחה לפרויקט</span>
                </div>

                @if (_projects.Count == 0)
                {
                    <p class="lmg-empty-msg">אין פרויקטים פעילים כרגע.</p>
                }
                else
                {
                    <div class="lmg-acc-list">
                        @foreach (var proj in _projects)
                        {
                            var p = proj;
                            bool isEditing = _editingProjectId == p.ProjectId;
                            // Hoisted: an interpolated string inside a double-quoted
                            // Razor attribute ends the attribute at its own quote.
                            var teamName = p.TeamName ?? p.ProjectTitle;
                            var teamSub  = $"פרויקט {p.ProjectNumber} · {p.ProjectTitle}";
                            var teamAria = $"שיוך מנחים — {teamName}";
                            <MAccordionItem Open="@isEditing"
                                            OnToggle="@(() => ToggleEditTeam(p.ProjectId))"
                                            Primary="@teamName"
                                            Secondary="@teamSub"
                                            AriaLabel="@teamAria">
                                <Leading>
                                    <span class="lmg-dot" style="background:@HealthDot(p.HealthBucket)" aria-hidden="true"></span>
                                </Leading>
                                <MetaContent>
                                    @if (!string.IsNullOrWhiteSpace(p.MentorNames))
                                    {
                                        <span class="lmg-avatar" aria-hidden="true">@TwoInitials(p.MentorNames)</span>
                                    }
                                    <span class="lmg-mentor-name">@(p.MentorNames ?? "ללא מנחה")</span>
                                </MetaContent>
                                <ChildContent>
                                    <div class="lmg-expand-inner lmg-expand-teams">
                                        @if (_editLoading)
                                        {
                                            <span class="lmg-edit-loading" role="status">טוענת מנחים…</span>
                                        }
                                        else
                                        {
                                            <!-- Current mentors -->
                                            @if (_editCurrentMentors.Count > 0)
                                            {
                                                <div class="lmg-mentor-current">
                                                    <span class="lmg-expand-label">מנחים נוכחיים</span>
                                                    <div class="lmg-chips-row">
                                                        @foreach (var m in _editCurrentMentors)
                                                        {
                                                            var mentor = m;
                                                            <span class="lmg-mentor-chip">
                                                                <span class="lmg-chip-avatar" aria-hidden="true">@TwoInitials(mentor.FullName)</span>
                                                                @mentor.FullName
                                                                <button type="button"
                                                                        class="lmg-chip-remove"
                                                                        @onclick="() => RemoveMentorAsync(p.ProjectId, mentor.UserId)"
                                                                        aria-label="הסרת @mentor.FullName">
                                                                    <svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true">
                                                                        <path d="M18 6 6 18M6 6l12 12"></path>
                                                                    </svg>
                                                                </button>
                                                            </span>
                                                        }
                                                    </div>
                                                </div>
                                            }

                                            <!-- Candidate list -->
                                            <div class="lmg-mentor-add">
                                                <span class="lmg-expand-label">הוספת מנחה</span>
                                                @if (_editCandidates.Count == 0)
                                                {
                                                    <span class="lmg-expand-empty">אין מנחים זמינים להוספה.</span>
                                                }
                                                else
                                                {
                                                    <div class="lmg-candidates">
                                                        @foreach (var cand in _editCandidates)
                                                        {
                                                            var cd = cand;
                                                            <button type="button"
                                                                    class="lmg-candidate"
                                                                    @onclick="() => AddMentorAsync(p.ProjectId, cd.UserId)">
                                                                <span class="lmg-cand-avatar" aria-hidden="true">@TwoInitials(cd.FullName)</span>
                                                                <span class="lmg-cand-name">@cd.FullName</span>
                                                                <span class="lmg-cand-role">@cd.Roles</span>
                                                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="lmg-cand-plus" aria-hidden="true">
                                                                    <path d="M12 5v14M5 12h14"></path>
                                                                </svg>
                                                            </button>
                                                        }
                                                    </div>
                                                }
                                            </div>
                                        }
                                    </div>
                                </ChildContent>
                            </MAccordionItem>
                        }
                    </div>
                }
            </section>
        }

        <!-- ══ אבני דרך ומועדים ══════════════════════════════════════════════ -->
        @if (_activeSection == "milestones")
        {
            <section class="lmg-panel" aria-labelledby="lmg-ms-title">
                <div class="lmg-panel-head">
                    <h2 class="lmg-panel-title" id="lmg-ms-title">אבני דרך ומועדים</h2>
                    <span class="motiva-tag lmg-head-tag">@_milestones.Count אבני דרך</span>
                    <span class="lmg-head-note">שינוי תאריך מעדכן את לוח השנה ואת ההתראות</span>
                </div>

                @if (_milestones.Count == 0)
                {
                    <p class="lmg-empty-msg">אין תבניות אבני דרך מוגדרות.</p>
                }
                else
                {
                    <div class="lmg-acc-list">
                        @foreach (var ms in _milestones.OrderBy(m => m.OrderIndex))
                        {
                            var m = ms;
                            bool isEditing = _editingMilestoneId == m.Id;
                            var status = MilestoneStatus(m);
                            var msAria = $"עריכת מועדים — {m.Title}";
                            <MAccordionItem Open="@isEditing"
                                            OnToggle="@(() => ToggleEditMilestone(m))"
                                            Primary="@m.Title"
                                            Secondary="@m.Applicability"
                                            AriaLabel="@msAria">
                                <Leading>
                                    <span class="lmg-ms-index" aria-hidden="true">@m.OrderIndex</span>
                                </Leading>
                                <MetaContent>
                                    <span class="lmg-date-range">@DateRange(m)</span>
                                </MetaContent>
                                <Status>
                                    <span class="lmg-status-pill lmg-s-@status.Key">@status.Label</span>
                                </Status>
                                <ChildContent>
                                    <div class="lmg-expand-inner lmg-expand-ms">
                                        <div class="lmg-date-fields">
                                            <label class="lmg-date-field">
                                                <span class="lmg-field-label">פתיחה</span>
                                                <input type="date" class="lmg-date-input"
                                                       value="@_editOpenDate"
                                                       @onchange="e => _editOpenDate = e.Value?.ToString() ?? _editOpenDate" />
                                            </label>
                                            <label class="lmg-date-field">
                                                <span class="lmg-field-label">מועד הגשה</span>
                                                <input type="date" class="lmg-date-input"
                                                       value="@_editDueDate"
                                                       @onchange="e => _editDueDate = e.Value?.ToString() ?? _editDueDate" />
                                            </label>
                                            <label class="lmg-date-field">
                                                <span class="lmg-field-label">סגירה</span>
                                                <input type="date" class="lmg-date-input"
                                                       value="@_editCloseDate"
                                                       @onchange="e => _editCloseDate = e.Value?.ToString() ?? _editCloseDate" />
                                            </label>
                                        </div>
                                        <div class="lmg-expand-actions">
                                            <button type="button"
                                                    class="lmg-save-btn motiva-cta"
                                                    disabled="@_msSaving"
                                                    @onclick="() => SaveMilestoneDatesAsync(m)">
                                                @(_msSaving ? "שומר…" : "שמירה")
                                            </button>
                                            @if (!string.IsNullOrWhiteSpace(_msError))
                                            {
                                                <span class="lmg-error-msg" role="alert">@_msError</span>
                                            }
                                        </div>
                                    </div>
                                </ChildContent>
                            </MAccordionItem>
                        }
                    </div>
                }
            </section>
        }

        <!-- ══ ניהול משאבים ══════════════════════════════════════════════════ -->
        @if (_activeSection == "resources")
        {
            <section class="lmg-panel" aria-labelledby="lmg-res-title">
                <div class="lmg-panel-head">
                    <h2 class="lmg-panel-title" id="lmg-res-title">ניהול משאבים</h2>
                    <span class="motiva-tag lmg-head-tag">@_resources.Count קבצים</span>
                    <a class="lmg-add-link" href="/management/resources">
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                             stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M12 5v14M5 12h14"></path>
                        </svg>
                        הוספת משאב
                    </a>
                </div>

                @if (_resources.Count == 0)
                {
                    <p class="lmg-empty-msg">
                        אין משאבים בספרייה.
                        <a href="/management/resources" class="lmg-empty-link">הוספה ראשונה ↗</a>
                    </p>
                }
                else
                {
                    <div class="lmg-res-header" aria-hidden="true">
                        <span class="lmg-res-col-main">שם המשאב</span>
                        <span class="lmg-res-col-toggle">טכנולוגי</span>
                        <span class="lmg-res-col-toggle">מתודולוגי</span>
                    </div>
                    <div class="lmg-rows" role="list">
                        @foreach (var res in _resources)
                        {
                            var r = res;
                            <div class="lmg-row lmg-res-row" role="listitem">
                                <span class="lmg-res-icon" aria-hidden="true">
                                    @((MarkupString)ResourceIcon(r))
                                </span>
                                <div class="lmg-row-text">
                                    <span class="lmg-row-name">@FileTitle(r.FileName)</span>
                                    <span class="lmg-row-sub">@ResourceTypeLabel(r)</span>
                                </div>
                                <div class="lmg-toggle-cell">
                                    <button type="button"
                                            role="switch"
                                            aria-checked="@r.ForTechnological.ToString().ToLowerInvariant()"
                                            class="lmg-toggle @(r.ForTechnological ? "lmg-toggle-on" : "")"
                                            @onclick="() => ToggleResAsync(r, tech: true)">
                                        <span class="lmg-toggle-thumb"></span>
                                    </button>
                                </div>
                                <div class="lmg-toggle-cell">
                                    <button type="button"
                                            role="switch"
                                            aria-checked="@r.ForMethodological.ToString().ToLowerInvariant()"
                                            class="lmg-toggle @(r.ForMethodological ? "lmg-toggle-on" : "")"
                                            @onclick="() => ToggleResAsync(r, tech: false)">
                                        <span class="lmg-toggle-thumb"></span>
                                    </button>
                                </div>
                            </div>
                        }
                    </div>
                }
            </section>
        }

        <!-- ══ הרשאות והגדרות ════════════════════════════════════════════════ -->
        @if (_activeSection == "settings")
        {
            <section class="lmg-panel" aria-labelledby="lmg-set-title">
                <div class="lmg-panel-head">
                    <h2 class="lmg-panel-title" id="lmg-set-title">הרשאות והגדרות</h2>
                    <span class="lmg-head-note">שינויים נכנסים לתוקף מיידית</span>
                </div>

                @if (_roleSettings.Count == 0)
                {
                    <p class="lmg-empty-msg">לא נמצאו הגדרות הרשאות.</p>
                }
                else
                {
                    @foreach (var role in _roleSettings)
                    {
                        var rs = role;
                        <div class="lmg-settings-group">
                            <div class="lmg-settings-group-label">@RoleDisplayName(rs.RoleName)</div>
                            @foreach (var flag in SettingFlags)
                            {
                                var f = flag;
                                bool isOn = GetFlag(rs, f);
                                <div class="lmg-setting-row">
                                    <div class="lmg-setting-text">
                                        <span class="lmg-setting-name">@RoleFeatures.Label(f)</span>
                                        <span class="lmg-setting-desc">@SettingDescription(f)</span>
                                    </div>
                                    <button type="button"
                                            role="switch"
                                            aria-checked="@isOn.ToString().ToLowerInvariant()"
                                            class="lmg-toggle @(isOn ? "lmg-toggle-on" : "")"
                                            @onclick="() => ToggleSettingAsync(rs, f)">
                                        <span class="lmg-toggle-thumb"></span>
                                    </button>
                                </div>
                            }
                        </div>
                    }
                }
            </section>
        }
    }

</div>

@code {
    // ── State ─────────────────────────────────────────────────────────────────
    private bool    _loading       = true;
    private string? _activeSection;           // null = overview

    // Teams
    private List<DashboardProjectRowDto> _projects           = new();
    private int?                         _editingProjectId;
    private bool                         _editLoading;
    private List<ProjectMentorDto>       _editCurrentMentors = new();
    private List<MentorCandidateDto>     _editCandidates     = new();

    // Milestones
    private List<MilestoneTemplateDto>   _milestones         = new();
    private int?                         _editingMilestoneId;
    private string                       _editOpenDate       = "";
    private string                       _editDueDate        = "";
    private string                       _editCloseDate      = "";
    private bool                         _msSaving;
    private string                       _msError            = "";

    // Resources
    private List<ResourceFileDto>        _resources          = new();

    // Settings
    private List<RoleSettingsDto>        _roleSettings       = new();

    // Module visibility (UI only — see the note above BuildGroups)
    private List<RoleSettingsDto>        _allRoleSettings    = new();
    private bool                         _isCourseStaff;

    // ── Constant flag list for the settings section ────────────────────────
    private static readonly string[] SettingFlags =
    {
        RoleFeatures.CanOpenRequests,
        RoleFeatures.CanViewTasks,
        RoleFeatures.CanSubmitTasks,
        RoleFeatures.CanManageAssignments,
        RoleFeatures.CanManageMilestones,
    };

    // ── Lifecycle ──────────────────────────────────────────────────────────
    protected override async Task OnInitializedAsync() => await LoadAllAsync();

    private async Task LoadAllAsync()
    {
        _loading = true;

        var tDash     = DashboardService.GetAsync("lecturer");
        var tMs       = MilestoneService.GetTemplatesAsync();
        var tRes      = ResourceFilesService.GetAllAsync();
        var tSettings = RoleSettingsService.GetAllAsync();

        await Task.WhenAll(tDash, tMs, tRes, tSettings);

        _projects     = tDash.Result?.Projects ?? new();
        _milestones   = tMs.Result             ?? new();
        _resources    = tRes.Result            ?? new();
        // The settings SECTION still shows only Student/Mentor, exactly as before.
        // The unfiltered rows are kept separately because module visibility reads
        // the Admin / Staff rows — see CanSee().
        _allRoleSettings = tSettings.Result ?? new();
        _roleSettings = _allRoleSettings
            .Where(r => r.RoleName is "Student" or "Mentor")
            .OrderBy(r => r.RoleName == "Student" ? 0 : 1)
            .ToList();

        var auth = await AuthState.GetAuthenticationStateAsync();
        _isCourseStaff = auth.User.IsInRole(Roles.Staff);

        _loading = false;
    }

    // ── Module groups (the overview) ───────────────────────────────────────
    //
    // VISIBILITY IS UI / IA ONLY.
    // Server authorization is deliberately untouched here and is BROADER than
    // what this list shows: AuthRepository.CreateToken issues an Admin role
    // claim to every Staff user (the Staff => Admin invariant, also enforced by
    // triggers in DatabaseMigrator), so every module below remains reachable by
    // URL for course staff. Hiding a row is an information-architecture
    // decision, NOT a security boundary. Enforcing these flags server-side is a
    // separate permissions-hardening task.
    //
    // The flag VALUES are not invented here — they are the seeded RoleSettings
    // rows (Admin: CanManageUsers=1, CanManageAirtable=1; Staff: both 0). If an
    // administrator flips Staff's flag on the "הרשאות לפי תפקיד" screen, the
    // module appears. Nothing about Admin-vs-Staff is hardcoded.

    /// <summary>A module row. <c>IconPaths</c> is gone with the row glyphs —
    /// the gradient mark is the category head's alone now, so 21 of them on one
    /// screen made the hub read as an icon menu.
    ///
    /// <para><c>AssignmentLink</c> is presentation, not permission: it says the
    /// student assignment-form action is rendered under this row.</para></summary>
    private record ModuleItem(string Title, string Description,
                              string? Route          = null,
                              string? SectionKey     = null,
                              string? Count          = null,
                              string? RequiresFlag   = null,
                              bool    AssignmentLink = false);

    /// <summary>IconPaths is the group head's gradient glyph — presentation
    /// only. The Id, Title and Items of every group are unchanged.</summary>
