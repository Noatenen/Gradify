    private void OpenSection(string key)
    {
        _activeSection      = key;
        _editingProjectId   = null;
        _editingMilestoneId = null;
        _msError            = "";
    }

    private void GoBack()
    {
        _activeSection      = null;
        _editingProjectId   = null;
        _editingMilestoneId = null;
        _msError            = "";
    }

