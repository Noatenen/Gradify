    // ── Teams ──────────────────────────────────────────────────────────────
    private async Task ToggleEditTeam(int projectId)
    {
        if (_editingProjectId == projectId) { _editingProjectId = null; return; }

        _editingProjectId   = projectId;
        _editLoading        = true;
        _editCurrentMentors = new();
        _editCandidates     = new();

        var (mentors, candidates) = (
            await MentorsService.GetMentorsAsync(projectId),
            await MentorsService.GetCandidatesAsync(projectId));

        _editCurrentMentors = mentors    ?? new();
        _editCandidates     = candidates ?? new();
        _editLoading        = false;
    }

    private async Task AddMentorAsync(int projectId, int userId)
    {
        if (!await MentorsService.AddMentorAsync(projectId, userId)) return;
        await RefreshMentorEditAsync(projectId);
        await RefreshProjectsAsync();
    }

    private async Task RemoveMentorAsync(int projectId, int userId)
    {
        if (!await MentorsService.RemoveMentorAsync(projectId, userId)) return;
        await RefreshMentorEditAsync(projectId);
        await RefreshProjectsAsync();
    }

    private async Task RefreshMentorEditAsync(int projectId)
    {
        _editCurrentMentors = await MentorsService.GetMentorsAsync(projectId)    ?? _editCurrentMentors;
        _editCandidates     = await MentorsService.GetCandidatesAsync(projectId)  ?? _editCandidates;
    }

    private async Task RefreshProjectsAsync()
    {
        var dash = await DashboardService.GetAsync("lecturer");
        if (dash is not null) _projects = dash.Projects;
    }

    // ── Milestones ─────────────────────────────────────────────────────────
    private void ToggleEditMilestone(MilestoneTemplateDto m)
    {
        if (_editingMilestoneId == m.Id) { _editingMilestoneId = null; return; }

        _editingMilestoneId = m.Id;
        _editOpenDate  = m.OpenDate?.ToString("yyyy-MM-dd")  ?? "";
        _editDueDate   = m.DueDate?.ToString("yyyy-MM-dd")   ?? "";
        _editCloseDate = m.CloseDate?.ToString("yyyy-MM-dd") ?? "";
        _msError = "";
    }

    private async Task SaveMilestoneDatesAsync(MilestoneTemplateDto m)
    {
        _msSaving = true;
        _msError  = "";

        var req = new SaveMilestoneTemplateRequest
        {
            Title         = m.Title,
            Description   = m.Description,
            OrderIndex    = m.OrderIndex,
            IsRequired    = m.IsRequired,
            IsActive      = m.IsActive,
            ProjectTypeId = m.ProjectTypeId,
            OpenDate      = string.IsNullOrWhiteSpace(_editOpenDate)  ? null : DateTime.Parse(_editOpenDate),
            DueDate       = string.IsNullOrWhiteSpace(_editDueDate)   ? null : DateTime.Parse(_editDueDate),
            CloseDate     = string.IsNullOrWhiteSpace(_editCloseDate) ? null : DateTime.Parse(_editCloseDate),
        };

        var err = await MilestoneService.UpdateTemplateAsync(m.Id, req);
        if (err is null)
        {
            m.OpenDate  = req.OpenDate;
            m.DueDate   = req.DueDate;
            m.CloseDate = req.CloseDate;
            _editingMilestoneId = null;
        }
        else
        {
            _msError = err;
        }

        _msSaving = false;
    }

    // ── Resources ──────────────────────────────────────────────────────────
    private async Task ToggleResAsync(ResourceFileDto r, bool tech)
    {
        if (tech) r.ForTechnological  = !r.ForTechnological;
        else      r.ForMethodological = !r.ForMethodological;

        var ok = await ResourceFilesService.UpdateAsync(r.Id, new UpdateResourceFileRequest
        {
            ItemType          = r.ItemType,
            FileName          = r.FileName,
            Description       = r.Description,
            MilestoneId       = r.MilestoneId,
            TaskId            = r.TaskId,
            ForTechnological  = r.ForTechnological,
            ForMethodological = r.ForMethodological,
            VideoUrl          = r.VideoUrl,
        });

        if (!ok)
        {
            // Rollback on failure
            if (tech) r.ForTechnological  = !r.ForTechnological;
            else      r.ForMethodological = !r.ForMethodological;
        }
    }

    // ── Settings ───────────────────────────────────────────────────────────
    private async Task ToggleSettingAsync(RoleSettingsDto rs, string flag)
    {
        SetFlag(rs, flag, !GetFlag(rs, flag));

        var req = new SaveRoleSettingsRequest
        {
            CanManageRequests        = rs.CanManageRequests,
            CanManageMilestones      = rs.CanManageMilestones,
            CanManageAssignments     = rs.CanManageAssignments,
            CanManageUsers           = rs.CanManageUsers,
            CanManageAirtable        = rs.CanManageAirtable,
            CanOpenRequests          = rs.CanOpenRequests,
            CanViewTasks             = rs.CanViewTasks,
            CanSubmitTasks           = rs.CanSubmitTasks,
            CanViewLecturerDashboard = rs.CanViewLecturerDashboard,
        };

        if (!await RoleSettingsService.SaveAsync(rs.RoleName, req))
            SetFlag(rs, flag, !GetFlag(rs, flag)); // rollback
    }

    private bool GetFlag(RoleSettingsDto rs, string flag) => flag switch
    {
        RoleFeatures.CanManageRequests        => rs.CanManageRequests,
        RoleFeatures.CanManageMilestones      => rs.CanManageMilestones,
        RoleFeatures.CanManageAssignments     => rs.CanManageAssignments,
        RoleFeatures.CanManageUsers           => rs.CanManageUsers,
        RoleFeatures.CanManageAirtable        => rs.CanManageAirtable,
        RoleFeatures.CanOpenRequests          => rs.CanOpenRequests,
        RoleFeatures.CanViewTasks             => rs.CanViewTasks,
        RoleFeatures.CanSubmitTasks           => rs.CanSubmitTasks,
        RoleFeatures.CanViewLecturerDashboard => rs.CanViewLecturerDashboard,
        _                                     => false,
    };

    private static void SetFlag(RoleSettingsDto rs, string flag, bool v)
    {
        switch (flag)
        {
            case RoleFeatures.CanManageRequests:        rs.CanManageRequests        = v; break;
            case RoleFeatures.CanManageMilestones:      rs.CanManageMilestones      = v; break;
            case RoleFeatures.CanManageAssignments:     rs.CanManageAssignments     = v; break;
            case RoleFeatures.CanManageUsers:           rs.CanManageUsers           = v; break;
            case RoleFeatures.CanManageAirtable:        rs.CanManageAirtable        = v; break;
            case RoleFeatures.CanOpenRequests:          rs.CanOpenRequests          = v; break;
            case RoleFeatures.CanViewTasks:             rs.CanViewTasks             = v; break;
            case RoleFeatures.CanSubmitTasks:           rs.CanSubmitTasks           = v; break;
            case RoleFeatures.CanViewLecturerDashboard: rs.CanViewLecturerDashboard = v; break;
        }
    }

