    /// <summary>One group placed in one of the two overview columns, carrying
    /// the LOGICAL index it had in <see cref="BuildGroups"/> so the narrow
    /// breakpoint can put the six cards back into declaration order with
    /// `order` after the column wrappers stop generating boxes.</summary>
    private record GroupSlot(ModuleGroup Group, int Order);

    // Card geometry, in px, for the column split below. Measured off the
    // rendered hub, not guessed: a card is one head plus one row per module,
    // every row is the same height, and the assignment-link action adds one
    // nested strip. They only have to be right RELATIVE to each other — the
    // split compares two sums, it never positions anything.
    private const int HeadPx    = 68;
    private const int RowPx     = 53;
    private const int ActionPx  = 50;
    private const int ColumnGap = 18;

    private static int GroupHeight(ModuleGroup g) =>
        HeadPx
        + g.Items.Length * RowPx
        + g.Items.Count(i => i.AssignmentLink) * ActionPx;

    /// <summary>Splits the visible groups across the overview's two columns so
    /// their COLLAPSED HEIGHTS come out as close as they can.
    ///
    /// <para>LAYOUT ONLY. Which groups exist, what is in them and the order they
    /// are declared in are all untouched; this chooses nothing but which of two
    /// stacks a card renders into.</para>
    ///
    /// <para>EXHAUSTIVE, not greedy, and not array order. Greedy left
    /// מערכת ואינטגרציות — the shortest card in the set — alone at the foot of
    /// one column with a taller card beside it, which is the dead corner this
    /// pass is removing; array order is worse again. Six groups is 64
    /// assignments, so the best one is simply found rather than approximated,
    /// and it stays the best if a permission flag hides a module or a whole
    /// group. Deterministic, evaluated once per render, no measurement.</para>
    ///
    /// <para>Groups keep their declared order WITHIN a column: the mask is
    /// walked in order, so a column is always a subsequence of BuildGroups.</para></summary>
    private (List<GroupSlot> A, List<GroupSlot> B) SplitColumns()
    {
        var groups  = VisibleGroups().ToList();
        var heights = groups.Select(GroupHeight).ToArray();

        // Bit i set = group i goes to column B. Bit 0 is pinned clear so each
        // split is considered once rather than twice as its own mirror, which
        // also fixes which side the first group lands on.
        var best      = 0;
        var bestScore = int.MaxValue;

        for (var mask = 0; mask < (1 << Math.Max(groups.Count - 1, 0)); mask++)
        {
            var candidate = mask << 1;
            int hA = 0, hB = 0, nA = 0, nB = 0;

            for (var i = 0; i < groups.Count; i++)
            {
                if ((candidate & (1 << i)) == 0) { hA += heights[i]; nA++; }
                else                             { hB += heights[i]; nB++; }
            }

            // The gaps are part of a column's height, and a column with more
            // cards carries more of them.
            hA += ColumnGap * Math.Max(nA - 1, 0);
            hB += ColumnGap * Math.Max(nB - 1, 0);

            // Tie-break on the count difference, so two splits that balance
            // equally well pick the one that does not pile cards on one side.
            var score = Math.Abs(hA - hB) * 100 + Math.Abs(nA - nB);

            if (score < bestScore) { bestScore = score; best = candidate; }
        }

        var a = new List<GroupSlot>();
        var b = new List<GroupSlot>();

        for (var i = 0; i < groups.Count; i++)
        {
            var slot = new GroupSlot(groups[i], i);
            if ((best & (1 << i)) == 0) a.Add(slot); else b.Add(slot);
        }

        return (a, b);
    }

    private IEnumerable<ModuleGroup> VisibleGroups() =>
        BuildGroups()
            .Select(g => g with { Items = g.Items.Where(i => CanSee(i.RequiresFlag)).ToArray() })
            .Where(g => g.Items.Length > 0);

    /// <summary>UI visibility only — see the note above BuildGroups.
    ///
    /// <para>Reads the seeded flag of the role the viewer actually holds.
    /// "GET api/role-settings/me" cannot be used for this: it aggregates with
    /// MAX() over the caller's UserRoles rows, and the Staff => Admin trigger
    /// writes an Admin row for every Staff user — so its union always reports
    /// Admin's flags and would make this check a no-op.</para>
    ///
    /// <para>Fails OPEN when the rows are unavailable: the server permits the
    /// module regardless, so hiding it on a transient fetch error would remove a
    /// capability the user genuinely has.</para></summary>
    private bool CanSee(string? flag)
    {
        if (string.IsNullOrWhiteSpace(flag)) return true;

        var roleName = _isCourseStaff ? Roles.Staff : Roles.Admin;
        var row = _allRoleSettings.FirstOrDefault(
            r => string.Equals(r.RoleName, roleName, StringComparison.OrdinalIgnoreCase));

        return row is null || GetFlag(row, flag);
    }

    private void ActivateItem(ModuleItem item)
    {
        if (item.SectionKey is not null) { OpenSection(item.SectionKey); return; }
        if (!string.IsNullOrWhiteSpace(item.Route)) Nav.NavigateTo(item.Route);
    }

    /// <summary>Teams count plus how many already have a mentor — the second
    /// half is the fact an administrator actually scans this row for.</summary>
    private string TeamsCountLabel()
    {
        var withMentor = _projects.Count(p => !string.IsNullOrWhiteSpace(p.MentorNames));
        return $"{_projects.Count} צוותים · {withMentor} עם מנחה";
    }
    private string MilestonesCountLabel() => $"{_milestones.Count} אבני דרך";
    private string ResourcesCountLabel()  => $"{_resources.Count} קבצים";

