    private void OpenSection(string key)
    {
        _activeSection      = key;
        _editingProjectId   = null;
        _editingMilestoneId = null;
        _msError            = "";
    }

    private void GoBack()
    {
        _activeSection      = null;
        _editingProjectId   = null;
        _editingMilestoneId = null;
        _msError            = "";
    }

    /// <summary>The line under the page title. The hub's own sentence comes
    /// from the reference; a panel replaces it with what that panel does, so
    /// the line always describes what is actually on screen.</summary>
    private string PageSubtitle => _activeSection is null
        ? "כל כלי הניהול וההגדרות של המערכת במקום אחד"
        : SectionSubtitle(_activeSection);

    private static string SectionSubtitle(string section) => section switch
    {
        "teams"      => "שינוי שיוך מנחים לפרויקטים",
        "milestones" => "עדכון תאריכים ומועדי הגשה",
        "resources"  => "ניהול נגישות חומרי לימוד",
        "settings"   => "הרשאות לפי תפקיד",
