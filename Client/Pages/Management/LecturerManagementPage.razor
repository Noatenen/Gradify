    private static string HealthDot(string? bucket) => bucket switch
    {
        "Healthy"   => "#10B981",
        "Attention" => "#F59E0B",
        "AtRisk"    => "#EF4444",
        _           => "#B4B0C0",
    };

    /// <summary>First initials of the first and last word in a name string.</summary>
    private static string TwoInitials(string name)
    {
        var parts = name.Split(new[] { ',', ' ' }, StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 0) return "?";
        var a = parts[0].Length > 0 ? parts[0][..1] : "";
        var b = parts.Length > 1 && parts[^1].Length > 0 ? parts[^1][..1] : "";
        return (a + b) is { Length: > 0 } s ? s : "?";
    }

    private static string DateRange(MilestoneTemplateDto m)
    {
        if (m.OpenDate is null && m.DueDate is null) return "ללא תאריכים";
        var open = m.OpenDate?.ToString("dd.MM.yy") ?? "—";
        var due  = m.DueDate?.ToString("dd.MM.yy")  ?? "—";
        return $"{open} – {due}";
    }

    private static (string Key, string Label) MilestoneStatus(MilestoneTemplateDto m)
    {
        var now = DateTime.Today;
        if (!m.IsActive) return ("planned", "מתוכננת");
        if (m.CloseDate.HasValue && m.CloseDate < now) return ("done", "הסתיימה");
        if (m.OpenDate.HasValue && m.OpenDate <= now
            && (!m.DueDate.HasValue || m.DueDate >= now)) return ("current", "נוכחית");
        if (m.DueDate.HasValue && m.DueDate < now) return ("done", "הסתיימה");
        if (m.OpenDate.HasValue && m.OpenDate > now) return ("next", "הבאה");
        return ("active", "פעילה");
    }

    private static string FileTitle(string fileName) =>
        System.IO.Path.GetFileNameWithoutExtension(fileName) is { Length: > 0 } t ? t : fileName;

    private static string ResourceIcon(ResourceFileDto r)
    {
        if (r.ItemType == "Video")
            return """<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"><polygon points="5 3 19 12 5 21 5 3"/></svg>""";
        return """<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>""";
    }

    private static string ResourceTypeLabel(ResourceFileDto r)
    {
        if (r.ItemType == "Video") return "סרטון";
        var ext = System.IO.Path.GetExtension(r.FileName).TrimStart('.').ToUpperInvariant();
        return string.IsNullOrEmpty(ext) ? "קובץ" : ext;
    }

