@page "/management/forms"
@layout AppLayout
@attribute [Authorize(Roles = Roles.Admin)]
@using AuthWithAdmin.Client.Services
@using AuthWithAdmin.Shared.AuthSharedModels
@inject NavigationManager Nav
@inject IFormsManagementService FormsService
@inject IManagementService ManagementService

<div class="fm-page">

    <!-- Top bar -->
    <div class="fm-topbar">
        <div class="fm-topbar-start">
            <button class="fm-back-btn" @onclick="@(() => Nav.NavigateTo("/management"))" title="חזרה לניהול">
                <span class="oi oi-chevron-right" aria-hidden="true"></span>
            </button>
            <div>
                <div class="fm-breadcrumb">ניהול</div>
                <h1 class="fm-title">טפסים</h1>
            </div>
        </div>
        <div class="fm-topbar-end">
            <button class="fm-btn fm-btn-primary"
                    @onclick="@(() => Nav.NavigateTo("/management/forms/new"))">
                <span class="oi oi-plus" aria-hidden="true"></span>
                טופס חדש
            </button>
        </div>
    </div>

    @if (_loading)
    {
        <div class="fm-state">טוען טפסים…</div>
    }
    else if (_loadError)
    {
        <div class="fm-state fm-state-error">
            <span class="oi oi-warning" aria-hidden="true"></span>
            שגיאה בטעינת הטפסים. נסו לרענן את הדף.
        </div>
    }
    else if (_forms.Count == 0)
    {
        <div class="fm-state">
            לא נמצאו טפסים.
        </div>
    }
    else
    {
        @if (!string.IsNullOrEmpty(_actionMessage))
        {
            <div class="fm-toast @(_actionError ? "fm-toast-error" : "")">@_actionMessage</div>
        }

        <div class="fm-list">
            @foreach (var f in _forms)
            {
                <article class="fm-card">
                    <div class="fm-card-head">
                        <div class="fm-card-head-main">
                            <h2 class="fm-card-title">@f.Name</h2>
                            @if (!string.IsNullOrWhiteSpace(f.AcademicYear))
                            {
                                <span class="fm-card-year">מחזור @f.AcademicYear</span>
                            }
                        </div>
                        <span class="fm-status @StatusClass(f.Status)">@StatusLabel(f.Status)</span>
                    </div>

                    <div class="fm-card-meta">
                        <div class="fm-meta-item">
                            <span class="fm-meta-label">פתיחה</span>
                            <span class="fm-meta-value">@FormatDateOrEmpty(f.OpensAt)</span>
                        </div>
                        <div class="fm-meta-item">
                            <span class="fm-meta-label">סגירה</span>
                            <span class="fm-meta-value">@FormatDateOrEmpty(f.ClosesAt)</span>
                        </div>
                        <div class="fm-meta-item">
                            <span class="fm-meta-label">הגשות</span>
                            <span class="fm-meta-value">@f.SubmissionCount</span>
                        </div>
                    </div>

                    <div class="fm-card-actions">
                        <button class="fm-btn fm-btn-primary"
                                @onclick="@(() => Nav.NavigateTo($"/management/forms/{f.Id}"))">
                            <span class="oi oi-pencil" aria-hidden="true"></span>
                            עריכה
                        </button>
                        <button class="fm-btn fm-btn-secondary"
                                disabled="@_busyIds.Contains(f.Id)"
                                @onclick="@(() => ToggleOpen(f))">
                            <span class="oi @(f.IsOpen ? "oi-lock-locked" : "oi-lock-unlocked")" aria-hidden="true"></span>
                            @(f.IsOpen ? "סגור טופס" : "פתח טופס")
                        </button>
                        <button class="fm-btn fm-btn-secondary"
                                @onclick="@(() => Nav.NavigateTo("/assignments"))">
                            <span class="oi oi-document" aria-hidden="true"></span>
                            צפייה בהגשות
                        </button>
                        <button class="fm-btn fm-btn-secondary"
                                @onclick="@(() => OpenDuplicateModal(f))">
                            <span class="oi oi-layers" aria-hidden="true"></span>
                            שכפול טופס
                        </button>
                    </div>
                </article>
            }
        </div>
    }
</div>

@* ── Duplicate-form modal ──────────────────────────────────────────────────── *@
@if (_dupSource is not null)
{
    <div class="fm-dup-backdrop" @onclick="CloseDuplicateModal"></div>
    <div class="fm-dup-modal" dir="rtl" @onclick:stopPropagation="true">
        <div class="fm-dup-header">
            <div class="fm-dup-title">שכפול טופס</div>
            <button class="fm-dup-close" @onclick="CloseDuplicateModal" title="סגירה">
                <span class="oi oi-x" aria-hidden="true"></span>
            </button>
        </div>

        <div class="fm-dup-body">
            <p class="fm-dup-source">
                שכפול הטופס: <strong>@_dupSource.Name</strong> (מחזור @_dupSource.AcademicYear)
            </p>

            <div class="fm-dup-field">
                <label class="fm-dup-label">שם הטופס החדש <span class="fm-dup-required">*</span></label>
                <input class="fm-dup-input @(_dupTouched && string.IsNullOrWhiteSpace(_dupNewName) ? "fm-dup-input-error" : "")"
                       maxlength="200"
                       @bind="_dupNewName" @bind:event="oninput"
                       disabled="@_dupSubmitting" />
            </div>

            <div class="fm-dup-field">
                <label class="fm-dup-label">מחזור / שנה אקדמית <span class="fm-dup-required">*</span></label>
                <MSelectField Options="@_yearOptions"
                              Value="@_dupYearIdRaw"
                              ValueChanged="@(v => _dupYearIdRaw = v)"
                              Disabled="@_dupSubmitting"
                              Class="@("fm-dup-input" + (_dupTouched && _dupYearId == 0 ? " fm-dup-input-error" : ""))" />
            </div>

            <div class="fm-dup-field">
                <label class="fm-dup-label">סטטוס התחלתי</label>
                <MSelectField Options="@_statusOptions"
                              @bind-Value="@_dupInitialStatus"
                              Disabled="@_dupSubmitting"
                              Class="fm-dup-input" />
            </div>

            <div class="fm-dup-hint">
                <span class="oi oi-info" aria-hidden="true"></span>
                השכפול יעתיק את מבנה הטופס בלבד, ללא הגשות קיימות.
            </div>

            @if (!string.IsNullOrEmpty(_dupError))
            {
                <div class="fm-dup-error">
                    <span class="oi oi-warning" aria-hidden="true"></span>
                    @_dupError
                </div>
            }
        </div>

        <div class="fm-dup-footer">
            <button class="fm-btn fm-btn-secondary"
                    @onclick="CloseDuplicateModal"
                    disabled="@_dupSubmitting">
                ביטול
            </button>
            <button class="fm-btn fm-btn-primary"
                    @onclick="SubmitDuplicate"
                    disabled="@_dupSubmitting">
                @if (_dupSubmitting) { <span class="fm-dup-spinner"></span> }
                else                  { <span class="oi oi-check" aria-hidden="true"></span> }
                שכפל
            </button>
        </div>
    </div>
}

@code {
    private IReadOnlyList<MSelect.Option> _yearOptions =>
        new[] { new MSelect.Option("0", "— בחר מחזור —") }
            .Concat(_years.Select(y => new MSelect.Option(y.Id.ToString(), y.Name)))
            .ToArray();

    private static readonly IReadOnlyList<MSelect.Option> _statusOptions = new[]
    {
        new MSelect.Option(FormStatuses.Draft,  "טיוטה"),
        new MSelect.Option(FormStatuses.Open,   "פתוח"),
        new MSelect.Option(FormStatuses.Closed, "סגור"),
    };

    private List<FormListItemDto> _forms = new();
    private bool _loading = true;
    private bool _loadError;
    private readonly HashSet<int> _busyIds = new();
    private string? _actionMessage;
    private bool    _actionError;

    // ── Duplicate-modal state ─────────────────────────────────────────────
    private List<AcademicYearDto> _years = new();
    private FormListItemDto?      _dupSource;
    private string                _dupNewName       = "";
    private string                _dupYearIdRaw     = "0";  // bound to the <select>
    private string                _dupInitialStatus = FormStatuses.Draft;
    private bool                  _dupTouched;
    private bool                  _dupSubmitting;
    private string?               _dupError;

    private int _dupYearId =>
        int.TryParse(_dupYearIdRaw, out var v) ? v : 0;

    protected override async Task OnInitializedAsync()
    {
        await Reload();
        // Academic-year list is loaded once for the duplicate modal — cheap,
        // and gives the lecturer a real dropdown without a roundtrip on click.
        _years = (await ManagementService.GetAcademicYearsAsync()) ?? new();
    }

    private async Task Reload()
    {
        _loading = true; _loadError = false;
        var data = await FormsService.GetFormsAsync();
        if (data is null) _loadError = true;
        else _forms = data;
        _loading = false;
    }

    // ── Duplicate-form handlers ───────────────────────────────────────────
    private void OpenDuplicateModal(FormListItemDto src)
    {
        _dupSource        = src;
        _dupNewName       = src.Name + " (עותק)";
        _dupYearIdRaw     = "0";
        _dupInitialStatus = FormStatuses.Draft;
        _dupTouched       = false;
        _dupError         = null;
    }

    private void CloseDuplicateModal()
    {
        if (_dupSubmitting) return;
        _dupSource    = null;
        _dupError     = null;
        _dupTouched   = false;
    }

    private async Task SubmitDuplicate()
    {
        if (_dupSource is null) return;
        _dupTouched = true;
        _dupError   = null;

        if (string.IsNullOrWhiteSpace(_dupNewName))
        {
            _dupError = "שם הטופס החדש הוא שדה חובה";
            return;
        }
        if (_dupYearId <= 0)
        {
            _dupError = "יש לבחור מחזור / שנה אקדמית";
            return;
        }

        _dupSubmitting = true;
        var (newId, err) = await FormsService.DuplicateFormAsync(_dupSource.Id,
            new DuplicateFormRequest
            {
                NewName        = _dupNewName.Trim(),
                AcademicYearId = _dupYearId,
                InitialStatus  = _dupInitialStatus,
            });
        _dupSubmitting = false;

        if (newId is null)
        {
            _dupError = err ?? "שגיאה בשכפול הטופס";
            return;
        }

        // Success — close modal, refresh the list, surface a toast-style banner
        var sourceName = _dupSource.Name;
        _dupSource = null;
        await Reload();
        _actionError   = false;
        _actionMessage = $"הטופס שוכפל בהצלחה ({sourceName} → \"{_dupNewName.Trim()}\").";
    }

    private async Task ToggleOpen(FormListItemDto f)
    {
        _busyIds.Add(f.Id);
        var ok = await FormsService.ToggleOpenAsync(f.Id);
        _busyIds.Remove(f.Id);
        if (ok)
        {
            _actionError = false;
            _actionMessage = f.IsOpen ? "הטופס נסגר" : "הטופס נפתח";
            await Reload();
        }
        else
        {
            _actionError = true;
            _actionMessage = "פעולת השינוי נכשלה.";
        }
    }

    private static string StatusLabel(string status) => status switch
    {
        FormStatuses.Draft  => "טיוטה",
        FormStatuses.Open   => "פתוח",
        FormStatuses.Closed => "סגור",
        _                   => status
    };

    private static string StatusClass(string status) => status switch
    {
        FormStatuses.Open   => "fm-status-open",
        FormStatuses.Closed => "fm-status-closed",
        _                   => "fm-status-draft"
    };

    private static string FormatDateOrEmpty(string? raw)
    {
        if (string.IsNullOrWhiteSpace(raw)) return "—";
        if (DateTime.TryParse(raw, out var dt)) return dt.IsraelFormat();
        return raw;
    }
}
