    private void OpenAddForm()
    {
        _editingId          = 0;
        _formNumber         = 0;
        _formTitle          = "";
        _formTypeId         = 0;
        _formYearId         = _academicYears.FirstOrDefault(y => y.IsCurrent)?.Id ?? 0;
        _formPriority       = "";
        _formDescription    = "";
        _formOrgName        = "";
        _formTargetAudience = "";
        _formContactPerson  = "";
        _formContactRole    = "";
        _formGoals          = "";
        _formSourceType     = "Manual";
        _formStatus         = "Available";
        _formInternalNotes  = "";
        _formError          = "";
        _formSaving         = false;
        _showForm           = true;
        CloseAllMenus();
