    private async Task ToggleAvailability(CatalogProjectListDto p)
    {
        CloseAllMenus();
        var ok = await CatalogService.ToggleAvailabilityAsync(p.Id);
        if (ok)
            p.Status = p.Status == "Available" ? "Unavailable" : "Available";
    }

    // ─────────────────────────────────────────────────
    //  Display helpers
    // ─────────────────────────────────────────────────

    /// <summary>Every status the catalog can actually hold, not only the two it
    /// writes: the assignment flow puts "Active" / "InProgress" on a project,
    /// and a row carrying one used to render its raw English value.</summary>
    private static string StatusLabel(string? status) => status switch
    {
        "Available"   => "זמין לשיוך",
        "Unavailable" => "לא זמין",
        "Active"      => "פעיל",
        "InProgress"  => "בתהליך",
        "Archived"    => "בארכיון",
        null or ""    => "—",
        _             => status,
    };

    /// <summary>Teal for available, rose for withdrawn, neutral for everything
    /// the assignment flow wrote — those describe a project already in motion,
    /// which is a different axis from "may a team pick this up".</summary>
    private static string StatusToneClass(string? status) => status switch
    {
        "Available"   => "pc-status--on",
        "Unavailable" => "pc-status--off",
        _             => "pc-status--other",
    };

    private static string SourceLabel(string? source) =>
        source == "Airtable" ? "Airtable" : "ידני";

    private static string SourceToneClass(string? source) =>
        source == "Airtable" ? "pc-tag--airtable" : "pc-tag--manual";

    private static string PriorityLabel(string? priority) => priority switch
    {
        "Low"    => "נמוכה",
        "Medium" => "בינונית",
        "High"   => "גבוהה",
        _        => priority ?? "",
    };

    private static string AssignedToDisplay(string? firstName, int teamSize) =>
        teamSize switch
        {
            0 => "מוקצה",
            1 => firstName ?? "מוקצה",
            _ => $"{firstName ?? "מוקצה"} +{teamSize - 1}",
        };

    /// <summary>An em dash says "not recorded" where an empty cell just looks
    /// like a rendering bug.</summary>
    private static string Dash(string? value) =>
        string.IsNullOrWhiteSpace(value) ? "—" : value;

    private static string? NullIfEmpty(string? s) =>
        string.IsNullOrWhiteSpace(s) ? null : s.Trim();

    /// <summary>The catalog endpoints return their errors as a JSON string
    /// literal, so the quotes travel with the message.</summary>
    private static string CleanError(string raw) =>
        raw.Trim('"', ' ', '\n', '\r');
}
