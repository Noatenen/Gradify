    //  Header / toolbar copy — counted, never stated
    // ─────────────────────────────────────────────────
    /// <summary>The header's summary tag. Same two counts as before, split
    /// into metrics so the tag can rule between them instead of printing a
    /// middle dot — the arithmetic is untouched.</summary>
    private IReadOnlyList<MSummaryTag.Metric> SummaryMetrics
    {
        get
        {
            var total      = _allProjects.Count;
            var unassigned = _allProjects.Count(p => !p.IsAssigned);
            return new[]
            {
                new MSummaryTag.Metric(total.ToString(), "פרויקטים"),
                new MSummaryTag.Metric(unassigned.ToString(), "לא מוקצים"),
            };
        }
    }

    private string ResultLine(int shown) =>
        shown == _allProjects.Count
            ? $"מציג את כל {_allProjects.Count} הפרויקטים"
            : $"מציג {shown} מתוך {_allProjects.Count}";

