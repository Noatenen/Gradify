@*
    ── ManagementCardsGrid ──────────────────────────────────────────────────
    The 13 configuration destinations of /management/admin, grouped into four
    named sections so the page answers "what am I configuring?" rather than
    presenting one undifferentiated wall of cards.

    Routes, titles and descriptions are UNCHANGED from the pre-redesign list —
    only the grouping, the surface and the icons are new.

    SURFACE
    ───────
    MCard (Interactive + Fill) is the shared Motiva card, so this grid inherits
    the finished design's section surface and its hover treatment (fill
    brightens toward opaque; the final screens carry no transform) rather than
    re-declaring a card of its own.

    ICONS
    ─────
    Inline SVG stroked with url(#motivaIconGradient) — the single paint server
    defined once in AppLayout. One gradient glyph per card and nowhere else on
    the page, so the accent stays an accent.
*@

<div class="mgh-groups">
    @foreach (var group in _groups)
    {
        <section class="mgh-group" aria-labelledby="@group.Id">
            <MSectionHeading Text="@group.Title" LabelId="@group.Id" />

            <div class="mgh-grid">
                @foreach (var card in group.Cards)
                {
                    var c = card;
                    <MCard Interactive="true"
                           Fill="true"
                           Padding="MCard.CardPadding.Large"
                           Class="mgh-card"
                           OnClick="@(() => Nav.NavigateTo(c.Route))">
                        <div class="mgh-card-top">
                            <span class="mgh-card-icon motiva-ico-gradient" aria-hidden="true">
                                <svg width="19" height="19" viewBox="0 0 24 24" fill="none"
                                     stroke="url(#motivaIconGradient)" stroke-width="1.9"
                                     stroke-linecap="round" stroke-linejoin="round">
                                    @foreach (var d in c.Paths)
                                    {
                                        <path d="@d"></path>
                                    }
                                </svg>
                            </span>
                            <span class="mgh-card-chevron" aria-hidden="true">
                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                     stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="m15 6-6 6 6 6"></path>
                                </svg>
                            </span>
                        </div>
                        <h2 class="mgh-card-title">@c.Title</h2>
                        <p class="mgh-card-desc">@c.Description</p>
                    </MCard>
                }
            </div>
        </section>
    }
</div>

@code {
