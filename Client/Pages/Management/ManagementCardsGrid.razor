@inject NavigationManager Nav
@inject IJSRuntime JS

<div class="cards-wrapper">

    <!-- ══ Registration link widget ══════════════════════════════════════════ -->
    <div class="reg-link-bar">
        <div class="reg-link-info">
            <span class="reg-link-label">לינק הרשמה לסטודנטים</span>
            <span class="reg-link-url">@_registrationUrl</span>
        </div>
        <div class="reg-link-actions">
            <button class="reg-link-btn" @onclick="CopyLink">
                @if (_copied)
                {
                    <span class="reg-link-check">✓</span>
                    <span>הקישור הועתק ללוח</span>
                }
                else
                {
                    <span>העתק קישור</span>
                }
            </button>
        </div>
    </div>

    <div class="cards-grid">
        @foreach (var card in _cards)
        {
            <button class="mgmt-card" @onclick="@(() => Nav.NavigateTo(card.Route))" title="@card.Title">
                <div class="mgmt-card-icon-wrap">
                    <span class="oi @card.Icon" aria-hidden="true"></span>
                </div>
                <div class="mgmt-card-content">
                    <div class="mgmt-card-title">@card.Title</div>
                    <div class="mgmt-card-desc">@card.Description</div>
                </div>
                <span class="oi oi-chevron-left mgmt-card-arrow" aria-hidden="true"></span>
            </button>
        }
    </div>
</div>

@code {
    private bool   _copied = false;
    private string _registrationUrl => Nav.BaseUri.TrimEnd('/') + "/create-team";

    private async Task CopyLink()
    {
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", _registrationUrl);
        _copied = true;
        StateHasChanged();
        await Task.Delay(2500);
        _copied = false;
    }

    private record ManagementCard(string Icon, string Title, string Description, string Route);

    // ── Configuration-only area (restructured 2026-05-21) ───────────────────
    // Operational cards that lecturers use daily were moved to the side nav:
    //   • שיבוצים           → /assignments
    //   • חומרי עזר          → /resource-files
    //   • בקשות (operational) → /management/requests (now a side-nav item)
    //   • אישורי מנחה       → /management/pending-mentor-approvals (side-nav item)
    // Their pages still exist at the same URLs so deep links survive.
    // Two new configuration cards replace them here: request-type structure
    // and pending-approval reminder/escalation settings.
    private readonly List<ManagementCard> _cards = new()
    {
        new("oi-people",       "משתמשים",                 "ניהול סטודנטים, מנחים ומרצים",                                "/management/users"),
        new("oi-list",         "קטלוג פרויקטים",          "הצעות פרויקט, זמינות ושיוך למחזור",                            "/management/catalog"),
        new("oi-briefcase",    "פרויקטים פעילים",         "הגדרות פרויקטים מוקצים, צוותות וסטטוסים",                      "/management/projects"),
        new("oi-calendar",     "מחזורים",                 "הגדרת מחזורים אקדמיים, פתיחה וסגירת מחזורים",                 "/management/cycles"),
        new("oi-flag",         "תבניות אבני דרך",          "תבניות אבני דרך ושיוך לסוגי פרויקטים",                         "/management/milestones"),
        new("oi-check",        "תבניות משימות",            "תבניות משימות וקישורן לאבני דרך",                              "/management/tasks"),
        new("oi-clipboard",    "טפסים",                   "ניהול טפסי שיבוץ, מועדי פתיחה/סגירה ובלוקים מותאמים",         "/management/forms"),
        new("oi-external-link","טפסים חיצוניים",          "ניהול קישורי טפסי צוות החדשנות לפי מחזור",                     "/management/external-forms"),
        new("oi-transfer",     "אינטגרציית צוות החדשנות","הגדרת endpoint, מיפוי שדות ומיפוי סטטוסים לעדכונים מאיירטייבל", "/management/innovation-integration"),
        new("oi-tags",         "ניהול סוגי בקשות",         "סוגי בקשות, שדות בטופס, סטטוסים וכללי הרשאה",                 "/management/request-types"),
        new("oi-shield",       "הגדרות אישורי מנחה",       "ספי תזכורת, ערוצי שליחה, תדירות והרשאת עקיפה למרצה",          "/management/pending-approval-settings"),
        new("oi-shield",       "הרשאות לפי תפקיד",         "הפעלה/השבתה של הרשאות לפי תפקיד במערכת",                     "/management/role-settings"),
        new("oi-link-intact",  "אינטגרציות כלליות",        "הגדרת Slack ואינטגרציות חיצוניות נוספות",                      "/management/integrations"),
        new("oi-cog",          "הגדרות מערכת",            "הגדרות כלליות, התראות, לוגים והרשאות",                         "/management/settings"),
    };
}
