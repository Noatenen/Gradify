@namespace AuthWithAdmin.Client.Pages.Management.Deliverables

@*
    An ordered, editable list of one-line strings — the דרישות and לתשומת לבכם
    bullets a student reads under a deliverable.

    ONE COMPONENT FOR BOTH because they are the same object: a list the lecturer
    adds to, edits, reorders and removes from. They differ only in their heading
    and their placeholder, which are parameters. Two near-identical editors would
    be two places for the reorder logic to drift.

    Order is MOVED, never typed: the caller's List<string> is mutated in place
    and saved whole, so a bullet's position is only ever what the list shows.
*@

<div class="dlv-lines">
    <span class="dlv-label">@Label</span>

    @if (Lines.Count == 0)
    {
        <p class="dlv-lines-empty">עדיין לא נוספו פריטים.</p>
    }

    @for (var i = 0; i < Lines.Count; i++)
    {
        var index = i;
        <div class="dlv-line">
            <span class="dlv-line-num" aria-hidden="true">@(index + 1)</span>

            <input class="dlv-line-input"
                   placeholder="@Placeholder"
                   value="@Lines[index]"
                   @oninput="@(e => Lines[index] = e.Value?.ToString() ?? string.Empty)" />

            <div class="dlv-line-actions">
                <button type="button" class="dlv-line-btn" title="הזזה למעלה"
                        aria-label="@($"הזזת פריט {index + 1} למעלה")"
                        disabled="@(index == 0)" @onclick="() => Move(index, -1)">↑</button>
                <button type="button" class="dlv-line-btn" title="הזזה למטה"
                        aria-label="@($"הזזת פריט {index + 1} למטה")"
                        disabled="@(index == Lines.Count - 1)" @onclick="() => Move(index, 1)">↓</button>
                <button type="button" class="dlv-line-btn dlv-line-btn-del" title="הסרה"
                        aria-label="@($"הסרת פריט {index + 1}")"
                        @onclick="() => Remove(index)">×</button>
            </div>
        </div>
    }

    <button type="button" class="dlv-line-add" @onclick="Add">+ @AddLabel</button>
</div>

@code {
    /// <summary>The caller's list, mutated in place — this editor owns the order
    /// while the modal is open and the caller saves the whole list.</summary>
    [Parameter, EditorRequired] public List<string> Lines { get; set; } = new();

    [Parameter, EditorRequired] public string Label       { get; set; } = "";
    [Parameter, EditorRequired] public string AddLabel    { get; set; } = "";
    [Parameter] public string Placeholder { get; set; } = "";

    private void Add() => Lines.Add("");

    private void Remove(int index)
    {
        if (index >= 0 && index < Lines.Count) Lines.RemoveAt(index);
    }

    private void Move(int index, int delta)
    {
        var target = index + delta;
        if (index < 0 || target < 0 || target >= Lines.Count) return;
        (Lines[index], Lines[target]) = (Lines[target], Lines[index]);
    }
}
