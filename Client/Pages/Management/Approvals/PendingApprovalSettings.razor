@*
    ── הגדרות אישורי מנחה (Admin approval settings) ─────────────────────────
    Route:  /management/pending-approval-settings  — reached from the ניהול
            hub (group "הגדרות").

    Visual source:
        Client/Pages/Management/Milestones/MilestonesManagement.razor
        Client/Pages/Management/Cycles/CycleDetailPage.razor
    — the finished Admin screens. Same header rhythm, strip, card
    border/radius, switch-row recipe, form controls and button language.

    WHAT THIS PAGE IS
    ─────────────────
    Operational configuration for the pending mentor-approvals queue —
    reminders, escalation, lecturer override capability and automations.
    Persisted as a singleton row at /api/management/pending-approval-settings
    (GET any signed-in user, PUT Admin/Staff).

    The OPERATIONAL queue lives at /management/pending-mentor-approvals; this
    page is config-only, which is why its one navigational action opens that
    queue rather than duplicating it.

    WHAT CHANGED IN THIS PASS — PRESENTATION ONLY
    ─────────────────────────────────────────────
    • The eight sections became compact Motiva cards: a small heading pair
      instead of an icon-and-title header, and setting rows at control
      height instead of stacked blocks.
    • Hand-rolled switches became MToggle; the radios and recipient chips
      keep their native inputs (and therefore their keyboard semantics)
      under a Motiva skin.
    • Save / discard moved into the page header, replacing the sticky bottom
      bar — one action row, at the top, like every other Admin screen.
    Every field, threshold rule, request and payload is untouched.
*@

@page "/management/pending-approval-settings"
@layout AppLayout
@attribute [Authorize(Roles = $"{Roles.Admin},{Roles.Staff}")]
@using AuthWithAdmin.Shared.AuthSharedModels
@using System.Net.Http.Json
@inject NavigationManager Nav
@inject HttpClient Http

<div class="pas-page" dir="rtl">

    @* ══ Header ═══════════════════════════════════════════════════════════ *@
    <header class="pas-head">
        <div class="pas-head-main">
            <button type="button" class="pas-crumb" @onclick="@(() => Nav.NavigateTo("/management"))">
                ניהול
                <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="m15 18-6-6 6-6" />
                </svg>
            </button>

            <div class="pas-head-line">
                <h1 class="pas-h1">הגדרות אישורי מנחה</h1>
                <p class="pas-subtitle">כללי תזכורת, אסקלציה ואוטומציות לתור אישורי המנחה</p>
            </div>
        </div>

        <div class="pas-head-actions">
            <button type="button" class="pas-btn-secondary"
                    @onclick="@(() => Nav.NavigateTo("/management/pending-mentor-approvals"))"
                    title="מעבר לתור המבצעי">
                פתיחת תור האישורים
            </button>

            @if (!_loading && !_loadError && _dto is not null)
            {
                <button type="button" class="pas-btn-ghost" @onclick="ReloadAsync" disabled="@_saving">
                    ביטול שינויים
                </button>
                <button type="button" class="pas-btn-primary motiva-cta"
                        @onclick="SaveAsync"
                        disabled="@(_saving || !ThresholdsAreOrdered)">
                    @(_saving ? "שומר…" : "שמירה")
                </button>
            }
        </div>
    </header>

    @if (_loading)
    {
        <MLoadingState Label="טוען הגדרות…" />
    }
    else if (_loadError || _dto is null)
    {
        <MEmptyState Title="שגיאה בטעינת ההגדרות"
                     Description="רעננו את הדף או נסו שוב מאוחר יותר"
                     Live="true" />
    }
    else
    {
        @* ══ Info strip ═══════════════════════════════════════════════════ *@
        <div class="pas-strip">
            <div class="pas-strip-copy">
                <span class="pas-strip-glyph" aria-hidden="true">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="9" /><path d="M12 16v-4" /><path d="M12 8h.01" />
                    </svg>
                </span>
                <p class="pas-strip-text">
                    ההגדרות חלות על כל ההגשות הממתינות לאישור מנחה. התרחיש בתחתית הדף מציג
                    את ההשפעה המשולבת שלהן.
                </p>
            </div>

            <span class="pas-meta">
                @if (_dto.UpdatedAt.HasValue)
                {
                    <span>עודכן לאחרונה: @_dto.UpdatedAt.IsraelFormat()</span>
                    @if (!string.IsNullOrWhiteSpace(_dto.UpdatedByName))
                    {
                        <span class="pas-meta-by">· ע״י @_dto.UpdatedByName</span>
                    }
                }
                else
                {
                    <span class="pas-meta-by">טרם נשמר</span>
                }
            </span>
        </div>

        @if (!string.IsNullOrEmpty(_toast))
        {
            <div class="pas-toast @(_toastError ? "pas-toast--err" : "pas-toast--ok")" role="status">@_toast</div>
        }

        @* The seven setting cards pack into balanced columns rather than a
           grid: their heights differ by several rows of toggles, and a grid
           would leave a column-wide hole beside the shortest card. *@
        <div class="pas-columns">

            @* 1 ── Response-time rules ───────────────────────────────────── *@
            <section class="pas-card">
                <div class="pas-card-head">
                    <h2 class="pas-card-title">סף תגובה</h2>
                    <p class="pas-card-desc">
                        לאחר כמה ימים ללא תגובה מהמנחה המערכת תגיב, בכל אחת משלוש רמות החומרה.
                    </p>
                </div>

                <div class="pas-days">
                    <label class="pas-day">
                        <span class="pas-day-label">תזכורת</span>
                        <span class="pas-day-input">
                            <input type="number" min="1" max="120" class="pas-input" @bind="_dto.WarningAfterDays" />
                            <span class="pas-day-suffix">ימים</span>
                        </span>
                        <span class="pas-day-hint">תזכורת ראשונה למנחה</span>
                    </label>
                    <label class="pas-day">
                        <span class="pas-day-label">אסקלציה</span>
                        <span class="pas-day-input">
                            <input type="number" min="1" max="120" class="pas-input" @bind="_dto.EscalationAfterDays" />
                            <span class="pas-day-suffix">ימים</span>
                        </span>
                        <span class="pas-day-hint">הסלמה אוטומטית למרצה או רכז</span>
                    </label>
                    <label class="pas-day">
                        <span class="pas-day-label">קריטי</span>
                        <span class="pas-day-input">
                            <input type="number" min="1" max="120" class="pas-input" @bind="_dto.CriticalAfterDays" />
                            <span class="pas-day-suffix">ימים</span>
                        </span>
                        <span class="pas-day-hint">סימון הפרויקט בסיכון</span>
                    </label>
                </div>

                @* The one genuine validation failure on this page — and the
                   only thing that blocks the save button. *@
                @if (!ThresholdsAreOrdered)
                {
                    <p class="pas-error">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                             stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <circle cx="12" cy="12" r="9" /><path d="M12 8v5" /><path d="M12 16h.01" />
                        </svg>
                        הספים חייבים להיות בסדר עולה: תזכורת &lt; אסקלציה &lt; קריטי.
                    </p>
                }
            </section>

            @* 2 ── Reminder channels ─────────────────────────────────────── *@
            <section class="pas-card">
                <div class="pas-card-head">
                    <h2 class="pas-card-title">ערוצי תזכורת</h2>
                    <p class="pas-card-desc">באילו ערוצים תישלחנה התזכורות.</p>
                </div>

                <div class="pas-rows">
                    <div class="pas-row">
                        <div class="pas-row-copy">
                            <span class="pas-row-title">אימייל</span>
                            <span class="pas-row-note">שליחה לכתובות המייל הרשומות במערכת</span>
                        </div>
                        <MToggle Checked="_dto.ChannelEmail"
                                 CheckedChanged="@(v => _dto.ChannelEmail = v)"
                                 AriaLabel="ערוץ אימייל" />
                    </div>

                    <div class="pas-row">
                        <div class="pas-row-copy">
                            <span class="pas-row-title">התראה בתוך המערכת</span>
                            <span class="pas-row-note">פעמון ההתראות בכל ממשק</span>
                        </div>
                        <MToggle Checked="_dto.ChannelInSystem"
                                 CheckedChanged="@(v => _dto.ChannelInSystem = v)"
                                 AriaLabel="התראה בתוך המערכת" />
                    </div>

                    <div class="pas-row">
                        <div class="pas-row-copy">
                            <span class="pas-row-title">
                                Slack
                                <span class="pas-soon">בקרוב</span>
                            </span>
                            <span class="pas-row-note">פעיל לפי האינטגרציה הכללית — נשמר אך טרם נשלח</span>
                        </div>
                        <MToggle Checked="_dto.ChannelSlack"
                                 CheckedChanged="@(v => _dto.ChannelSlack = v)"
                                 AriaLabel="ערוץ Slack" />
                    </div>
                </div>
            </section>

            @* 3 ── Reminder frequency ────────────────────────────────────── *@
            <section class="pas-card">
                <div class="pas-card-head">
                    <h2 class="pas-card-title">תדירות תזכורת</h2>
                    <p class="pas-card-desc">קצב חזרת התזכורת אם עדיין לא טופלה.</p>
                </div>

                @* Native radios under a Motiva skin — the keyboard semantics
                   of a radio group are kept, not re-implemented. *@
                <div class="pas-choices">
                    @foreach (var f in ReminderFrequencies.All)
                    {
                        <label class="pas-choice @(IsFrequency(f) ? "pas-choice--on" : "")">
                            <input type="radio" name="freq" value="@f"
                                   checked="@IsFrequency(f)"
                                   @onchange="@(() => _dto.ReminderFrequency = f)" />
                            <span class="pas-choice-label">@ReminderFrequencies.Label(f)</span>
                        </label>
                    }
                </div>

                @if (_dto.ReminderFrequency == ReminderFrequencies.EveryNDays)
                {
                    <label class="pas-inline">
                        <span class="pas-inline-label">כל</span>
                        <span class="pas-day-input pas-day-input--narrow">
                            <input type="number" min="1" max="30" class="pas-input" @bind="_dto.ReminderIntervalDays" />
                            <span class="pas-day-suffix">ימים</span>
                        </span>
                    </label>
                }
            </section>

            @* 4 ── Recipients ────────────────────────────────────────────── *@
            <section class="pas-card">
                <div class="pas-card-head">
                    <h2 class="pas-card-title">מקבלי התזכורת</h2>
                    <p class="pas-card-desc">ניתן לבחור יותר מנמען אחד.</p>
                </div>

                <div class="pas-choices">
                    <label class="pas-choice @(_dto.RecipientMentor ? "pas-choice--on" : "")">
                        <input type="checkbox" @bind="_dto.RecipientMentor" />
                        <span class="pas-choice-label">מנחה</span>
                    </label>
                    <label class="pas-choice @(_dto.RecipientLecturer ? "pas-choice--on" : "")">
                        <input type="checkbox" @bind="_dto.RecipientLecturer" />
                        <span class="pas-choice-label">מרצה</span>
                    </label>
                    <label class="pas-choice @(_dto.RecipientCoordinator ? "pas-choice--on" : "")">
                        <input type="checkbox" @bind="_dto.RecipientCoordinator" />
                        <span class="pas-choice-label">רכז קורס</span>
                    </label>
                    <label class="pas-choice @(_dto.RecipientTeam ? "pas-choice--on" : "")">
                        <input type="checkbox" @bind="_dto.RecipientTeam" />
                        <span class="pas-choice-label">כל הצוות (סטודנטים)</span>
                    </label>
                </div>
            </section>

            @* 5 ── Escalation rules ──────────────────────────────────────── *@
            <section class="pas-card">
                <div class="pas-card-head">
                    <h2 class="pas-card-title">כללי אסקלציה</h2>
                    <p class="pas-card-desc">
                        פעולות שיופעלו כשעוברים את סף האסקלציה (@_dto.EscalationAfterDays ימים).
                    </p>
                </div>

                <div class="pas-rows">
                    <div class="pas-row">
                        <div class="pas-row-copy">
                            <span class="pas-row-title">הודעה אוטומטית למרצה</span>
                            <span class="pas-row-note">שליחת התראה למרצים ולמנהלים בעת חריגה</span>
                        </div>
                        <MToggle Checked="_dto.EscalateNotifyLecturer"
                                 CheckedChanged="@(v => _dto.EscalateNotifyLecturer = v)"
                                 AriaLabel="הודעה אוטומטית למרצה" />
                    </div>
                    <div class="pas-row">
                        <div class="pas-row-copy">
                            <span class="pas-row-title">הודעה אוטומטית לרכז הקורס</span>
                            <span class="pas-row-note">שליחת התראה לרכזים אם מוגדרים</span>
                        </div>
                        <MToggle Checked="_dto.EscalateNotifyCoordinator"
                                 CheckedChanged="@(v => _dto.EscalateNotifyCoordinator = v)"
                                 AriaLabel="הודעה אוטומטית לרכז הקורס" />
                    </div>
                    <div class="pas-row">
                        <div class="pas-row-copy">
                            <span class="pas-row-title">סימון הפרויקט כבסיכון</span>
                            <span class="pas-row-note">מעדכן את בריאות הפרויקט אוטומטית</span>
                        </div>
                        <MToggle Checked="_dto.MarkProjectAtRisk"
                                 CheckedChanged="@(v => _dto.MarkProjectAtRisk = v)"
                                 AriaLabel="סימון הפרויקט כבסיכון" />
                    </div>
                    <div class="pas-row">
                        <div class="pas-row-copy">
                            <span class="pas-row-title">הצגה בדשבורד הניהולי</span>
                            <span class="pas-row-note">הצגת הבקשה התקועה ברשימה הניהולית</span>
                        </div>
                        <MToggle Checked="_dto.ShowInManagementDashboard"
                                 CheckedChanged="@(v => _dto.ShowInManagementDashboard = v)"
                                 AriaLabel="הצגה בדשבורד הניהולי" />
                    </div>
                </div>
            </section>

            @* 6 ── Lecturer overrides ────────────────────────────────────── *@
            <section class="pas-card">
                <div class="pas-card-head">
                    <h2 class="pas-card-title">הרשאות עקיפה למרצה</h2>
                    <p class="pas-card-desc">מתי המרצה רשאי לפעול בעצמו, ללא תגובת מנחה.</p>
                </div>

                <div class="pas-rows">
                    <div class="pas-row">
                        <div class="pas-row-copy">
                            <span class="pas-row-title">אישור הגשה ללא תגובת מנחה</span>
                            <span class="pas-row-note">המרצה רשאי לאשר הגשה גם אם המנחה לא הגיב</span>
                        </div>
                        <MToggle Checked="_dto.LecturerCanApproveWithoutMentor"
                                 CheckedChanged="@(v => _dto.LecturerCanApproveWithoutMentor = v)"
                                 AriaLabel="אישור הגשה ללא תגובת מנחה" />
                    </div>
                    <div class="pas-row">
                        <div class="pas-row-copy">
                            <span class="pas-row-title">דחיית הגשה ללא תגובת מנחה</span>
                            <span class="pas-row-note">המרצה רשאי לדחות הגשה גם אם המנחה לא הגיב</span>
                        </div>
                        <MToggle Checked="_dto.LecturerCanRejectWithoutMentor"
                                 CheckedChanged="@(v => _dto.LecturerCanRejectWithoutMentor = v)"
                                 AriaLabel="דחיית הגשה ללא תגובת מנחה" />
                    </div>
                    <div class="pas-row">
                        <div class="pas-row-copy">
                            <span class="pas-row-title">פתיחה מחדש של הגשות</span>
                            <span class="pas-row-note">החזרת הגשה שכבר אושרה לסטטוס פעיל</span>
                        </div>
                        <MToggle Checked="_dto.LecturerCanReopenSubmissions"
                                 CheckedChanged="@(v => _dto.LecturerCanReopenSubmissions = v)"
                                 AriaLabel="פתיחה מחדש של הגשות" />
                    </div>
                    <div class="pas-row">
                        <div class="pas-row-copy">
                            <span class="pas-row-title">קידום אבן דרך באכיפה</span>
                            <span class="pas-row-note">העברת אבן דרך לסטטוס הבא גם אם נותרו משימות פתוחות</span>
                        </div>
                        <MToggle Checked="_dto.LecturerCanForceMilestone"
                                 CheckedChanged="@(v => _dto.LecturerCanForceMilestone = v)"
                                 AriaLabel="קידום אבן דרך באכיפה" />
                    </div>
                </div>
            </section>

            @* 7 ── Automation rules ──────────────────────────────────────── *@
            <section class="pas-card">
                <div class="pas-card-head">
                    <h2 class="pas-card-title">אוטומציות</h2>
                    <p class="pas-card-desc">כיבוי והפעלה של פעולות אוטומטיות במערכת.</p>
                </div>

                <div class="pas-rows">
                    <div class="pas-row">
                        <div class="pas-row-copy">
                            <span class="pas-row-title">אסקלציה אוטומטית</span>
                            <span class="pas-row-note">הפעלת ההסלמה אוטומטית בחציית הסף</span>
                        </div>
                        <MToggle Checked="_dto.AutoEscalation"
                                 CheckedChanged="@(v => _dto.AutoEscalation = v)"
                                 AriaLabel="אסקלציה אוטומטית" />
                    </div>
                    <div class="pas-row">
                        <div class="pas-row-copy">
                            <span class="pas-row-title">עדכון אוטומטי של בריאות הפרויקט</span>
                            <span class="pas-row-note">מעדכן את סטטוס הפרויקט (תקין / סיכון) אוטומטית</span>
                        </div>
                        <MToggle Checked="_dto.AutoProjectHealthUpdates"
                                 CheckedChanged="@(v => _dto.AutoProjectHealthUpdates = v)"
                                 AriaLabel="עדכון אוטומטי של בריאות הפרויקט" />
                    </div>
                    <div class="pas-row">
                        <div class="pas-row-copy">
                            <span class="pas-row-title">תזמון אוטומטי של תזכורות</span>
                            <span class="pas-row-note">מנוע הרקע מתזמן תזכורות לפי ההגדרות</span>
                        </div>
                        <MToggle Checked="_dto.AutoReminderScheduling"
                                 CheckedChanged="@(v => _dto.AutoReminderScheduling = v)"
                                 AriaLabel="תזמון אוטומטי של תזכורות" />
                    </div>
                    <div class="pas-row">
                        <div class="pas-row-copy">
                            <span class="pas-row-title">ניקוי אוטומטי של התראות ישנות</span>
                            <span class="pas-row-note">התראות שטופלו יוסרו אוטומטית לאחר זמן</span>
                        </div>
                        <MToggle Checked="_dto.AutoNotificationCleanup"
                                 CheckedChanged="@(v => _dto.AutoNotificationCleanup = v)"
                                 AriaLabel="ניקוי אוטומטי של התראות ישנות" />
                    </div>
                </div>
            </section>

        </div>

        @* 8 ── Preview / simulation timeline ─────────────────────────────── *@
        @* Outside the columns: it is a reading of every other card, so it
           spans the full canvas underneath them. *@
        <section class="pas-card pas-card--wide">
            <div class="pas-card-head">
                <h2 class="pas-card-title">תרחיש לדוגמה</h2>
                <p class="pas-card-desc">מה יקרה אם המנחה יתעלם מהגשה — לפי ההגדרות הנוכחיות.</p>
            </div>

            <ol class="pas-timeline">
                <li class="pas-tl">
                    <span class="pas-tl-tag">יום 0</span>
                    <span class="pas-tl-text">הסטודנט שולח הגשה — ההגשה ממתינה לאישור מנחה.</span>
                </li>
                <li class="pas-tl">
                    <span class="pas-tl-tag">יום @_dto.WarningAfterDays</span>
                    <span class="pas-tl-text">
                        תזכורת נשלחת אל @RecipientSummary דרך @ChannelSummary
                        (@ReminderFrequencies.Label(_dto.ReminderFrequency)@FrequencyExtra).
                    </span>
                </li>
                <li class="pas-tl">
                    <span class="pas-tl-tag">יום @_dto.EscalationAfterDays</span>
                    <span class="pas-tl-text">הסלמה אוטומטית: @EscalationSummary.</span>
                </li>
                @* The only rose on the page: this is the rung at which the
                   product actually declares the project at risk. *@
                <li class="pas-tl pas-tl--critical">
                    <span class="pas-tl-tag">יום @_dto.CriticalAfterDays</span>
                    <span class="pas-tl-text">@CriticalSummary</span>
                </li>
            </ol>
        </section>
    }
</div>

@code {
    private PendingApprovalSettingsDto? _dto;
    private bool   _loading    = true;
    private bool   _loadError;
    private bool   _saving;
    private string _toast      = "";
    private bool   _toastError;

    private bool ThresholdsAreOrdered =>
        _dto is not null
        && _dto.WarningAfterDays > 0
        && _dto.EscalationAfterDays > _dto.WarningAfterDays
        && _dto.CriticalAfterDays   > _dto.EscalationAfterDays;

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    private async Task ReloadAsync()
    {
        _loading = true;
        _loadError = false;
        try
        {
            _dto = await Http.GetFromJsonAsync<PendingApprovalSettingsDto>(
                "api/management/pending-approval-settings");
        }
        catch
        {
            _loadError = true;
            _dto = null;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task SaveAsync()
    {
        if (_dto is null) return;
        _saving = true;
        try
        {
            var resp = await Http.PutAsJsonAsync(
                "api/management/pending-approval-settings", _dto);

            if (resp.IsSuccessStatusCode)
            {
                _dto = await resp.Content.ReadFromJsonAsync<PendingApprovalSettingsDto>()
                       ?? _dto;
                ShowToast("ההגדרות נשמרו", false);
            }
            else
            {
                string body = (await resp.Content.ReadAsStringAsync()).Trim().Trim('"');
                ShowToast(string.IsNullOrEmpty(body) ? "שגיאת שמירה" : body, true);
            }
        }
        catch (Exception ex)
        {
            ShowToast("שגיאת תקשורת: " + ex.Message, true);
        }
        finally
        {
            _saving = false;
        }
    }

    private bool IsFrequency(string s) => _dto?.ReminderFrequency == s;

    private string FrequencyExtra =>
        _dto?.ReminderFrequency == ReminderFrequencies.EveryNDays
            ? $" · כל {_dto.ReminderIntervalDays} ימים"
            : "";

    private string RecipientSummary
    {
        get
        {
            if (_dto is null) return "—";
            var parts = new List<string>();
            if (_dto.RecipientMentor)      parts.Add("מנחה");
            if (_dto.RecipientLecturer)    parts.Add("מרצה");
            if (_dto.RecipientCoordinator) parts.Add("רכז קורס");
            if (_dto.RecipientTeam)        parts.Add("צוות הסטודנטים");
            return parts.Count == 0 ? "ללא נמענים" : string.Join(" + ", parts);
        }
    }

    private string ChannelSummary
    {
        get
        {
            if (_dto is null) return "—";
            var parts = new List<string>();
            if (_dto.ChannelEmail)    parts.Add("אימייל");
            if (_dto.ChannelInSystem) parts.Add("התראה במערכת");
            if (_dto.ChannelSlack)    parts.Add("Slack");
            return parts.Count == 0 ? "ללא ערוץ פעיל" : string.Join(" / ", parts);
        }
    }

    private string EscalationSummary
    {
        get
        {
            if (_dto is null) return "";
            var parts = new List<string>();
            if (_dto.EscalateNotifyLecturer)    parts.Add("התראה למרצה");
            if (_dto.EscalateNotifyCoordinator) parts.Add("התראה לרכז");
            if (_dto.MarkProjectAtRisk)         parts.Add("סימון הפרויקט כבסיכון");
            if (_dto.ShowInManagementDashboard) parts.Add("הצגה בדשבורד הניהולי");
            return parts.Count == 0 ? "לא מוגדרת פעולה" : string.Join(", ", parts);
        }
    }

    private string CriticalSummary
    {
        get
        {
            if (_dto is null) return "";
            var risk = _dto.MarkProjectAtRisk
                ? "הפרויקט מסומן כקריטי בבריאות הפרויקטים"
                : "הפרויקט נשאר במצב הנוכחי בבריאות הפרויקטים";
            var dash = _dto.ShowInManagementDashboard
                ? " ומופיע בדשבורד הניהולי"
                : "";
            var ov = _dto.LecturerCanApproveWithoutMentor
                ? "; המרצה רשאי לאשר את ההגשה ללא תגובת מנחה"
                : "; המרצה אינו רשאי לאשר ללא תגובת מנחה (לפי ההגדרות)";
            return risk + dash + ov + ".";
        }
    }

    private void ShowToast(string msg, bool isError)
    {
        _toast = msg;
        _toastError = isError;
        _ = HideToastSoon();
    }

    private async Task HideToastSoon()
    {
        await Task.Delay(2500);
        _toast = "";
        StateHasChanged();
    }
}
