@page "/lecturer/home"
@layout AppLayout
@attribute [Authorize(Roles = Roles.Admin + "," + Roles.Staff)]
@namespace AuthWithAdmin.Client.Pages.Lecturer
@using Microsoft.AspNetCore.Authorization
@using AuthWithAdmin.Client.Services
@using AuthWithAdmin.Shared.AuthSharedModels
@inject ILecturerHomeService Workspace
@inject NavigationManager Nav

@*
    ── Lecturer Home — בית ──────────────────────────────────────────────────
    Visual source:   design-reference/LecturerSide/Motiva Lecturer Home.dc.html
    Data source:     ILecturerHomeService (composes existing API endpoints)

    This page deliberately does NOT route all visuals through shared Motiva
    components (MPageHeader Hero, MKpiCard, MCard AmbientEdge, MRowList) because
    those components impose Student/Mentor proportions that diverge from the
    approved Lecturer design. The data wiring and shell infrastructure remain
    unchanged; only the HTML/CSS surface is Lecturer-specific.
*@

@* ── HERO — full-bleed ambient band ───────────────────────────────────── *@
<div class="lh-hero">

    @if (_loading)
    {
        <div class="lh-hero-loading" role="status" aria-live="polite">
            <span class="lh-spinner" aria-hidden="true"></span>
            <span>טוענת נתונים…</span>
        </div>
    }
    else
    {
        @* Date *@
        <p class="lh-date">@DateLine</p>

        @* Greeting *@
        <strong class="lh-greeting">@Greeting</strong>

        @* Headline summary *@
        <strong class="lh-headline">@HeadlineLine</strong>

        @* ─── ACTION KPIs — ממתין להחלטתך ─────────────────────────────── *@
        <p class="lh-band-label">ממתין להחלטתך</p>
        <div class="lh-action-row">
            @* Requests *@
            <button type="button"
                    class="lh-kpi-action @(_filter == FilterKey.Requests ? "lh-kpi-action-req-active" : "")"
                    aria-pressed="@(_filter == FilterKey.Requests ? "true" : "false")"
                    @onclick="@(() => ToggleFilter(FilterKey.Requests))">
                <span class="lh-kpi-ic lh-kpi-ic-orange">
                    <svg width="17" height="17" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="1.6"
                         stroke-linecap="round" stroke-linejoin="round">
                        <path d="M20 6.5v8a2 2 0 0 1-2 2H9l-4 3.5V6.5a2 2 0 0 1 2-2h11a2 2 0 0 1 2 2z"/>
                    </svg>
                </span>
                <span class="lh-kpi-body">
                    <strong class="lh-kpi-num lh-kpi-num-orange">@_ws.PendingDecisionRequests.Count</strong>
                    <span class="lh-kpi-label">בקשות להחלטתך</span>
                </span>
            </button>

            @* Submissions *@
            <button type="button"
                    class="lh-kpi-action @(_filter == FilterKey.Subs ? "lh-kpi-action-sub-active" : "")"
                    aria-pressed="@(_filter == FilterKey.Subs ? "true" : "false")"
                    @onclick="@(() => ToggleFilter(FilterKey.Subs))">
                <span class="lh-kpi-ic lh-kpi-ic-violet">
                    <svg width="17" height="17" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="1.6"
                         stroke-linecap="round" stroke-linejoin="round">
                        <path d="M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                        <path d="M14 3v5h5"/>
                    </svg>
                </span>
                <span class="lh-kpi-body">
                    <strong class="lh-kpi-num lh-kpi-num-violet">@_ws.PendingSubmissionApprovals.Count</strong>
                    <span class="lh-kpi-label">הגשות לאישורך</span>
                </span>
            </button>
        </div>

        @* ─── PROJECT HEALTH — מצב הפרויקטים בקורס ─────────────────────── *@
        <p class="lh-band-label lh-band-label-quiet">מצב הפרויקטים בקורס</p>
        <div class="lh-health-row">
            <a class="lh-kpi-health" style="--lh-accent:rgba(13,156,154,.45)"
               href="/lecturer/projects?status=on_track">
                <span class="lh-kpi-health-ic" style="background:rgba(13,156,154,.08);color:#0D9C9A">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="1.6"
                         stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="9"/><path d="m8.5 12.5 2.2 2.2 4.8-4.8"/>
                    </svg>
                </span>
                <span class="lh-kpi-health-body">
                    <strong class="lh-kpi-health-num" style="color:#0D9C73">@_ws.OnTrackCount</strong>
                    <span class="lh-kpi-health-label">תקין</span>
                </span>
            </a>
            <a class="lh-kpi-health" style="--lh-accent:rgba(47,111,208,.45)"
               href="/lecturer/projects?status=attention">
                <span class="lh-kpi-health-ic" style="background:rgba(47,111,208,.09);color:#2F6FD0">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="1.6"
                         stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 9v4M12 17h.01"/><circle cx="12" cy="12" r="9"/>
                    </svg>
                </span>
                <span class="lh-kpi-health-body">
                    <strong class="lh-kpi-health-num" style="color:#2F6FD0">@_ws.AttentionCount</strong>
                    <span class="lh-kpi-health-label">דורש תשומת לב</span>
                </span>
            </a>
            <a class="lh-kpi-health" style="--lh-accent:rgba(217,56,100,.45)"
               href="/lecturer/projects?status=at_risk">
                <span class="lh-kpi-health-ic" style="background:rgba(217,56,100,.08);color:#D93864">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="1.6"
                         stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 9v4M12 17h.01"/>
                        <path d="M10.3 3.9 2.7 17a2 2 0 0 0 1.7 3h15.2a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z"/>
                    </svg>
                </span>
                <span class="lh-kpi-health-body">
                    <strong class="lh-kpi-health-num" style="color:#D93864">@_ws.AtRiskCount</strong>
                    <span class="lh-kpi-health-label">בסיכון</span>
                </span>
            </a>
        </div>
    }
</div>

@* ── BODY — normal off-white background ────────────────────────────────── *@
<div class="lh-body">

    @if (_loading)
    {
        <div class="lh-loading-body" role="status" aria-live="polite">
            <span class="lh-spinner" aria-hidden="true"></span>
            <span>טוענת סביבת העבודה…</span>
        </div>
    }
    else if (_loadError)
    {
        <div class="lh-error" role="alert">שגיאה בטעינת הנתונים. נסה לרענן את הדף.</div>
    }
    else
    {
        @* ─── דורש את התייחסותך ─────────────────────────────────────────── *@
        <div id="lh-attention" class="lh-scroll-anchor">
            <p class="lh-section-label">דורש את התייחסותך</p>

            @* Active filter chip *@
            @if (_filter is not null)
            {
                <div class="lh-filter-chip">
                    <div class="lh-filter-chip-start">
                        <span class="lh-filter-chip-word">מסנן פעיל:</span>
                        <span class="@(_filter == FilterKey.Requests ? "lh-filter-tag-orange" : "lh-filter-tag-violet")">
                            @(_filter == FilterKey.Requests ? "בקשות להחלטתך" : "הגשות לאישורך")
                        </span>
                    </div>
                    <button type="button" class="lh-filter-clear" @onclick="ClearFilter">✕ נקה סינון</button>
                </div>
            }

            @* Attention list container — gradient border *@
            <div class="lh-amb-card lh-attention-card">
                @{
                    var attention = BuildAttentionItems();
                }
                @if (attention.Count == 0)
                {
                    <div class="lh-empty-state">
                        <strong class="lh-empty-title">@AttentionEmptyTitle</strong>
                        <p class="lh-empty-desc">@AttentionEmptyDesc</p>
                    </div>
                }
                else
                {
                    @foreach (var item in attention)
                    {
                        var it = item;
                        <a class="lh-attn-row" @onclick:preventDefault="true"
                           href="@it.Href" @onclick="@(() => Nav.NavigateTo(it.Href))">
                            <div class="lh-attn-row-start">
                                <span class="lh-tag" style="@it.TagStyle">@it.Tag</span>
                                <div class="lh-attn-row-text">
                                    <strong class="lh-attn-title">@it.Title</strong>
                                    <p class="lh-attn-desc">@it.Description</p>
                                </div>
                            </div>
                            <span class="lh-attn-cta">@it.Cta ←</span>
                        </a>
                    }
                }
            </div>
        </div>

        @* ─── מועדים קרובים בקורס ───────────────────────────────────────── *@
        <div class="lh-section-hdr">
            <p class="lh-section-label" style="margin:0">מועדים קרובים בקורס</p>
            <a class="lh-section-link" href="/lecturer/calendar">ליומן המלא ←</a>
        </div>
        <div class="lh-amb-card lh-upcoming-card">
            @{
                var upcoming = _ws.UpcomingMilestones.ToList();
            }
            @if (upcoming.Count == 0)
            {
                <div class="lh-empty-state">
                    <strong class="lh-empty-title">אין מועדים קרובים.</strong>
                </div>
            }
            else
            {
                @foreach (var p in upcoming)
                {
                    var project = p;
                    <a class="lh-upcoming-row" href="@($"/projects/{project.ProjectId}/overview")">
                        <div class="lh-upcoming-row-main">
                            <span class="lh-upcoming-when">@UpcomingLabel(project.NextMilestoneDueDate)</span>
                            <div>
                                <strong class="lh-upcoming-title">@project.NextMilestoneTitle</strong>
                                <small class="lh-upcoming-ctx">@project.ProjectTitle@(string.IsNullOrWhiteSpace(project.TeamName) ? "" : $" · {project.TeamName}")</small>
                            </div>
                        </div>
                        <span class="lh-tag lh-tag-milestone">אבן דרך</span>
                    </a>
                }
            }
        </div>

        @* ─── פעילות מהותית אחרונה ───────────────────────────────────────── *@
        <p class="lh-section-label lh-section-label-quiet" style="margin:0 0 10px">פעילות מהותית אחרונה</p>
        <div class="lh-activity-list">
            @{
                var activity = _ws.RecentActivity.ToList();
            }
            @if (activity.Count == 0)
            {
                <div class="lh-empty-state" style="padding:16px 0">
                    <strong class="lh-empty-title">אין פעילות אחרונה.</strong>
                </div>
            }
            else
            {
                @foreach (var req in activity)
                {
                    var r = req;
                    <div class="lh-activity-item">
                        <span class="lh-activity-dot" style="@ActivityDotStyle(r)"></span>
                        <div class="lh-activity-body">
                            <p class="lh-activity-text">@ActivityText(r)</p>
                            <small class="lh-activity-meta">@ActivityContext(r) · @RelativeTime(r.UpdatedAt)</small>
                        </div>
                    </div>
                }
            }
        </div>
    }
</div>

@code {
    [CascadingParameter] private User? _user { get; set; }

    private LecturerWorkspace _ws = LecturerWorkspace.Empty;
    private bool _loading   = true;
    private bool _loadError;
    private FilterKey? _filter;

    private enum FilterKey { Requests, Subs }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _ws = await Workspace.LoadAsync();
        }
        catch
        {
            _loadError = true;
        }
        finally
        {
            _loading = false;
        }
    }

    // ── Filter ──────────────────────────────────────────────────────────

    private void ToggleFilter(FilterKey key)
    {
        _filter = _filter == key ? null : key;
    }

    private void ClearFilter() => _filter = null;

    // ── Localisation helpers ──────────────────────────────────────────────
    //
    // WHY NOT CultureInfo("he-IL")
    // Blazor WASM ships SHARDED ICU data chosen by the browser's own language.
    // A browser running in English loads the EFIGS shard, which has no Hebrew,
    // so new CultureInfo("he-IL") throws a CultureNotFoundException at the
    // first render that reads a Hebrew date string — a failure the page cannot
    // recover from. MentorCalendarPage hit this first and documents it in full;
    // the fix there and here is identical: hardcoded arrays, zero runtime ICU.

    private static readonly string[] HebrewDayNames =
        { "ראשון", "שני", "שלישי", "רביעי", "חמישי", "שישי", "שבת" };

    private static readonly string[] HebrewMonthNames =
    {
        "ינואר", "פברואר", "מרץ", "אפריל", "מאי", "יוני",
        "יולי", "אוגוסט", "ספטמבר", "אוקטובר", "נובמבר", "דצמבר",
    };

    private static string HebrewDayAndMonth(DateTime d) =>
        $"{d.Day} ב{HebrewMonthNames[d.Month - 1]}";

    // ── Copy ─────────────────────────────────────────────────────────────

    private string Greeting
    {
        get
        {
            var name = _user?.FirstName?.Trim();
            var hour = DateTime.Now.Hour;
            var part = hour < 12 ? "בוקר טוב"
                     : hour < 17 ? "צהריים טובים"
                     : hour < 21 ? "ערב טוב"
                     :             "לילה טוב";
            return string.IsNullOrEmpty(name) ? part : $"{part}, {name}";
        }
    }

    private string DateLine
    {
        get
        {
            var now = DateTime.Now;
            return $"{HebrewDayNames[(int)now.DayOfWeek]} · {HebrewDayAndMonth(now)}";
        }
    }

    private string HeadlineLine
    {
        get
        {
            int pending = _ws.PendingDecisionRequests.Count
                        + _ws.PendingSubmissionApprovals.Count;
            int atRisk  = _ws.AtRiskCount;
            int total   = _ws.Overview.Summary.TotalProjects;

            if (pending == 0 && atRisk == 0)
                return "הכול תחת שליטה — אין פריטים הדורשים את התייחסותך.";

            var parts = new List<string>();
            if (pending > 0) parts.Add($"{pending} פריטים ממתינים להחלטתך");
            if (atRisk > 0 && total > 0)
                parts.Add($"{atRisk} פרויקטים בסיכון מתוך {total}");
            return string.Join(" · ", parts);
        }
    }

    // ── Attention feed ────────────────────────────────────────────────────

    private sealed record AttentionItem(
        string Tag, string TagStyle, string Title,
        string Description, string Cta, string Href,
        string Kind);

    private string AttentionEmptyTitle =>
        _filter == FilterKey.Requests ? "אין פריטים בסינון הנוכחי"
        : _filter == FilterKey.Subs   ? "אין פריטים בסינון הנוכחי"
        :                               "הכול תחת שליטה.";

    private string AttentionEmptyDesc =>
        _filter is not null
            ? "נקה את הסינון כדי לראות את כל מה שדורש את התייחסותך."
            : "אין בקשות, הגשות או פרויקטים שדורשים את התייחסותך כרגע.";

    // Tag CSS inline styles — matching exactly the design's own color mapping
    private const string TagOrange  = "color:#B8710F;background:rgba(217,118,26,.10)";
    private const string TagViolet  = "color:#4F46E5;background:rgba(79,70,229,.08)";
    private const string TagRose    = "color:#D93864;background:rgba(217,56,100,.08)";
    private const string TagBlue    = "color:#2F6FD0;background:rgba(47,111,208,.09)";

    private List<AttentionItem> BuildAttentionItems()
    {
        var all = new List<AttentionItem>();

        // 1. Requests awaiting lecturer decision → orange
        all.AddRange(_ws.PendingDecisionRequests.Take(2).Select(r => new AttentionItem(
            Tag:         "החלטה נדרשת",
            TagStyle:    TagOrange,
            Title:       $"{RequestTypes.Label(r.RequestType)} — {r.ProjectTitle}",
            Description: $"{(string.IsNullOrWhiteSpace(r.TeamName) ? r.ProjectTitle : r.TeamName)} · ממתינה {WaitingDays(r.UpdatedAt)} ימים",
            Cta:         "לבקשה",
            Href:        "/lecturer/requests?status=awaiting_lecturer",
            Kind:        "requests")));

        // 2. At-risk projects → rose
        all.AddRange(_ws.AtRiskProjects.Take(2).Select(p => new AttentionItem(
            Tag:         "פרויקט בסיכון",
            TagStyle:    TagRose,
            Title:       p.ProjectTitle,
            Description: $"{(string.IsNullOrWhiteSpace(p.TeamName) ? "" : $"{p.TeamName} · ")}{(string.IsNullOrWhiteSpace(p.MentorNames) ? "" : $"מנחה: {p.MentorNames}")}".TrimEnd(' ', '·').Trim(),
            Cta:         "לפרויקט",
            Href:        $"/projects/{p.ProjectId}/overview",
            Kind:        "risk")));

        // 3. Systemic blocker — 2+ missing subs → blue
        int missingSubs = _ws.Overview.Summary.SubmissionsMissing;
        if (missingSubs >= 2)
        {
            int affected = _ws.Overview.Projects.Count(p => p.MissingSubmissionCount > 0);
            all.Add(new AttentionItem(
                Tag:         "חסימה מערכתית",
                TagStyle:    TagBlue,
                Title:       $"{missingSubs} הגשות חסרות או באיחור",
                Description: $"מרוכזות ב־{affected} פרויקטים — ייתכן שנדרשת הבהרה כללית לקורס",
                Cta:         "להגשות",
                Href:        "/management/pending-mentor-approvals",
                Kind:        "blocker"));
        }

        // 4. Pending approval submissions → violet
        all.AddRange(_ws.PendingSubmissionApprovals.Take(1).Select(s => new AttentionItem(
            Tag:         "הגשה לאישורך",
            TagStyle:    TagViolet,
            Title:       $"{s.TaskTitle} — {s.ProjectTitle}",
            Description: $"אבן דרך: {s.MilestoneTitle}{(string.IsNullOrWhiteSpace(s.MentorName) ? "" : $" · מנחה: {s.MentorName}")} · {s.DaysWaiting} ימים ממתינה",
            Cta:         "לבדיקה",
            Href:        "/management/pending-mentor-approvals",
            Kind:        "subs")));

        // Apply filter
        var filtered = _filter switch
        {
            FilterKey.Requests => all.Where(a => a.Kind == "requests").ToList(),
            FilterKey.Subs     => all.Where(a => a.Kind == "subs").ToList(),
            _                  => all,
        };

        return filtered.Take(5).ToList();
    }

    // ── Activity feed ─────────────────────────────────────────────────────

    private static string ActivityText(ProjectRequestRowDto r) =>
        $"{RequestTypes.Label(r.RequestType)}: {r.Title}";

    private static string ActivityContext(ProjectRequestRowDto r)
    {
        var parts = new List<string>();
        if (!string.IsNullOrWhiteSpace(r.ProjectTitle)) parts.Add(r.ProjectTitle);
        parts.Add(RequestStatuses.Label(r.Status));
        return string.Join(" · ", parts);
    }

    private static string ActivityDotStyle(ProjectRequestRowDto r) => r.Status switch
    {
        RequestStatuses.PendingLecturerDecision => "background:#D9761A",
        RequestStatuses.Resolved                => "background:#0D9C9A",
        RequestStatuses.New or RequestStatuses.InProgress => "background:#4F46E5",
        _                                       => "background:#B7B2C2",
    };

    // ── Date / time ───────────────────────────────────────────────────────

    private static int WaitingDays(DateTime dt) =>
        Math.Max(0, (int)(DateTime.Today - dt.Date).TotalDays);

    private static string UpcomingLabel(DateTime? dt)
    {
        if (dt is null) return "";
        var days = (dt.Value.Date - DateTime.Today).TotalDays;
        return days switch
        {
            0    => "היום",
            1    => "מחר",
            <= 7 => $"בעוד {(int)days} ימים",
            _    => HebrewDayAndMonth(dt.Value),
        };
    }

    private static string RelativeTime(DateTime dt)
    {
        var days = (DateTime.Today - dt.Date).TotalDays;
        return days switch
        {
            0    => "היום",
            1    => "אתמול",
            <= 7 => $"לפני {(int)days} ימים",
            _    => dt.ToString("dd/MM/yy"),
        };
    }
}
