@page "/lecturer/resources"
@attribute [Authorize(Roles = Roles.Admin + "," + Roles.Staff)]
@using AuthWithAdmin.Client.Pages.Learning
@inject IResourceFilesService ResourceFilesService
@inject IJSRuntime JS

<PageTitle>משאבים – Motiva</PageTitle>

@* ── Hero ───────────────────────────────────────────────────────── *@
<div class="lres-hero">
    <h1 class="lres-hero-title">משאבים</h1>
    <p class="lres-hero-sub">נהלי הקורס, חומרי הערכה ותבניות לניהול פרויקטי הגמר</p>
    <div class="lres-search-wrap">
        <input class="lres-search"
               type="search"
               placeholder="חיפוש נוהל, טופס או תבנית…"
               @bind="_query"
               @bind:event="oninput" />
    </div>
</div>

@* ── Body ───────────────────────────────────────────────────────── *@
@if (_loading)
{
    <div class="lres-body">
        <div class="lres-state" role="status" aria-live="polite">
            <span class="lres-spinner" aria-hidden="true"></span>
            <span>טוענת משאבים…</span>
        </div>
    </div>
}
else if (_loadError)
{
    <div class="lres-body">
        <div class="lres-error">שגיאה בטעינת המשאבים. אפשר לנסות שוב.</div>
    </div>
}
else if (_resources.Count == 0)
{
    <div class="lres-body">
        <div class="lres-empty-page">
            <span class="lres-empty-title">אין עדיין משאבים בספרייה</span>
            <p class="lres-empty-desc">ניתן להעלות משאבים מדף הניהול.</p>
        </div>
    </div>
}
else if (IsSearching)
{
    @* ── Search results ─────────────────────────────────────── *@
    <div class="lres-body">
        <p class="lres-section-cap">
            תוצאות חיפוש
            <span class="lres-section-count">(@SearchResults.Count)</span>
        </p>
        @if (SearchResults.Count == 0)
        {
            <div class="lres-empty-list">לא נמצאו משאבים תואמים. אפשר לנסות מונח אחר.</div>
        }
        else
        {
            <div class="lres-grad-card lres-forms-card">
                @foreach (var r in SearchResults)
                {
                    var res = r;
                    <div class="lres-form-row">
                        @ResourceAnchor(res, cssClass: "lres-form-row-link")
                        <button type="button"
                                class="lres-star @(_favorites.Contains(res.Id) ? "lres-star-on" : "")"
                                title="@(_favorites.Contains(res.Id) ? "הסרה מהמועדפים" : "הוספה למועדפים")"
                                aria-label="@(_favorites.Contains(res.Id) ? "הסרה מהמועדפים" : "הוספה למועדפים")"
                                @onclick="() => ToggleFavoriteAsync(res.Id)"
                                @onclick:stopPropagation="true">
                            <svg width="15" height="15" viewBox="0 0 24 24"
                                 fill="@(_favorites.Contains(res.Id) ? "currentColor" : "none")"
                                 stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" aria-hidden="true">
                                <path d="m12 4 2.4 4.9 5.4.8-3.9 3.8.9 5.4-4.8-2.6-4.8 2.6.9-5.4L4.2 9.7l5.4-.8z" />
                            </svg>
                        </button>
                    </div>
                }
            </div>
        }
    </div>
}
else
{
    <div class="lres-body">

        @* ── Top 3-column: frequent | recent | favorites ─────── *@
        <div class="lres-top-grid">

            @* Frequent *@
            <div>
                <p class="lres-section-cap">בשימוש תכוף</p>
                <div class="lres-grad-card lres-quick-card">
                    @if (_frequent.Count == 0)
                    {
                        <div class="lres-quick-empty">אין משאבים להצגה</div>
                    }
                    else
                    {
                        @foreach (var r in _frequent)
                        {
                            var res = r;
                            <div class="lres-quick-row">
                                @ResourceAnchor(res, cssClass: "lres-quick-name")
                                <span class="lres-quick-meta">
                                    <button type="button"
                                            class="lres-star @(_favorites.Contains(res.Id) ? "lres-star-on" : "")"
                                            title="@(_favorites.Contains(res.Id) ? "הסרה מהמועדפים" : "הוספה למועדפים")"
                                            aria-label="@(_favorites.Contains(res.Id) ? "הסרה מהמועדפים" : "הוספה למועדפים")"
                                            @onclick="() => ToggleFavoriteAsync(res.Id)"
                                            @onclick:stopPropagation="true">
                                        <svg width="15" height="15" viewBox="0 0 24 24"
                                             fill="@(_favorites.Contains(res.Id) ? "currentColor" : "none")"
                                             stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" aria-hidden="true">
                                            <path d="m12 4 2.4 4.9 5.4.8-3.9 3.8.9 5.4-4.8-2.6-4.8 2.6.9-5.4L4.2 9.7l5.4-.8z" />
                                        </svg>
                                    </button>
                                    <span class="lres-open-arrow" aria-hidden="true">↗</span>
                                </span>
                            </div>
                        }
                    }
                </div>
            </div>

            @* Recent *@
            <div>
                <p class="lres-section-cap">נפתחו לאחרונה</p>
                <div class="lres-grad-card lres-quick-card">
                    @if (_recentResources.Count == 0)
                    {
                        <div class="lres-quick-empty">טרם נפתחו משאבים</div>
                    }
                    else
                    {
                        @foreach (var (res, openedAt) in _recentResources)
                        {
                            var r = res;
                            var t = openedAt;
                            <div class="lres-quick-row">
                                @ResourceAnchor(r, cssClass: "lres-quick-name")
                                <span class="lres-quick-meta">
                                    <button type="button"
                                            class="lres-star @(_favorites.Contains(r.Id) ? "lres-star-on" : "")"
                                            title="@(_favorites.Contains(r.Id) ? "הסרה מהמועדפים" : "הוספה למועדפים")"
                                            aria-label="@(_favorites.Contains(r.Id) ? "הסרה מהמועדפים" : "הוספה למועדפים")"
                                            @onclick="() => ToggleFavoriteAsync(r.Id)"
                                            @onclick:stopPropagation="true">
                                        <svg width="15" height="15" viewBox="0 0 24 24"
                                             fill="@(_favorites.Contains(r.Id) ? "currentColor" : "none")"
                                             stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" aria-hidden="true">
                                            <path d="m12 4 2.4 4.9 5.4.8-3.9 3.8.9 5.4-4.8-2.6-4.8 2.6.9-5.4L4.2 9.7l5.4-.8z" />
                                        </svg>
                                    </button>
                                    <span class="lres-recent-time">@t.ToString("dd.MM HH:mm")</span>
                                </span>
                            </div>
                        }
                    }
                </div>
            </div>

            @* Favorites *@
            <div>
                <p class="lres-section-cap">מועדפים</p>
                <div class="lres-grad-card lres-quick-card">
                    @if (FavoriteResources.Count == 0)
                    {
                        <div class="lres-quick-empty">עדיין לא הוספת משאבים למועדפים</div>
                    }
                    else
                    {
                        @foreach (var r in FavoriteResources)
                        {
                            var res = r;
                            <div class="lres-quick-row">
                                @ResourceAnchor(res, cssClass: "lres-quick-name")
                                <button type="button"
                                        class="lres-star lres-star-on"
                                        title="הסרה מהמועדפים"
                                        aria-label="הסרה מהמועדפים"
                                        @onclick="() => ToggleFavoriteAsync(res.Id)"
                                        @onclick:stopPropagation="true">
                                    <svg width="15" height="15" viewBox="0 0 24 24"
                                         fill="currentColor"
                                         stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" aria-hidden="true">
                                        <path d="m12 4 2.4 4.9 5.4.8-3.9 3.8.9 5.4-4.8-2.6-4.8 2.6.9-5.4L4.2 9.7l5.4-.8z" />
                                    </svg>
                                </button>
                            </div>
                        }
                    }
                </div>
            </div>

        </div>

        @* ── Guides / Procedures (Documents + Videos) ─────────── *@
        @if (GuideItems.Count > 0)
        {
            <p class="lres-section-cap">נהלים והנחיות</p>
            <div class="lres-guides-grid">
                @foreach (var r in GuideItems)
                {
                    var res = r;
                    var href = ResourceHref(res);
                    var download = res.Action == KnowledgeResourceAction.Download ? res.DownloadName : null;
                    var target  = res.Action != KnowledgeResourceAction.Download ? "_blank" : null;
                    <a class="lres-guide-card"
                       href="@href"
                       download="@download"
                       target="@target"
                       @onclick="() => TrackRecentAsync(res.Id)"
                       @onclick:preventDefault="false">
                        <div class="lres-guide-top">
                            <span class="lres-guide-tag">@res.TypeLabel</span>
                            <button type="button"
                                    class="lres-star @(_favorites.Contains(res.Id) ? "lres-star-on" : "")"
                                    title="@(_favorites.Contains(res.Id) ? "הסרה מהמועדפים" : "הוספה למועדפים")"
                                    aria-label="@(_favorites.Contains(res.Id) ? "הסרה מהמועדפים" : "הוספה למועדפים")"
                                    @onclick="() => ToggleFavoriteAsync(res.Id)"
                                    @onclick:stopPropagation="true"
                                    @onclick:preventDefault="true">
                                <svg width="15" height="15" viewBox="0 0 24 24"
                                     fill="@(_favorites.Contains(res.Id) ? "currentColor" : "none")"
                                     stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" aria-hidden="true">
                                    <path d="m12 4 2.4 4.9 5.4.8-3.9 3.8.9 5.4-4.8-2.6-4.8 2.6.9-5.4L4.2 9.7l5.4-.8z" />
                                </svg>
                            </button>
                        </div>
                        <strong class="lres-guide-name">@res.Title</strong>
                        <p class="lres-guide-meta">@res.MilestoneLabel · @res.UploadedLabel</p>
                    </a>
                }
            </div>
        }

        @* ── Bottom 2-col: forms | admin dates ────────────────── *@
        <div class="lres-bottom-grid">

            @* Forms & templates *@
            <div>
                <p class="lres-section-cap">טפסים ותבניות</p>
                <div class="lres-grad-card lres-forms-card">
                    @if (FormItems.Count == 0)
                    {
                        <div class="lres-quick-empty">אין טפסים להצגה</div>
                    }
                    else
                    {
                        @foreach (var r in FormItems)
                        {
                            var res = r;
                            var href = ResourceHref(res);
                            var download = res.Action == KnowledgeResourceAction.Download ? res.DownloadName : null;
                            var target   = res.Action != KnowledgeResourceAction.Download ? "_blank" : null;
                            <div class="lres-form-row">
                                <a class="lres-form-row-link"
                                   href="@href"
                                   download="@download"
                                   target="@target"
                                   @onclick="() => TrackRecentAsync(res.Id)"
                                   @onclick:preventDefault="false">@res.Title</a>
                                <span class="lres-form-row-end">
                                    <button type="button"
                                            class="lres-star @(_favorites.Contains(res.Id) ? "lres-star-on" : "")"
                                            title="@(_favorites.Contains(res.Id) ? "הסרה מהמועדפים" : "הוספה למועדפים")"
                                            aria-label="@(_favorites.Contains(res.Id) ? "הסרה מהמועדפים" : "הוספה למועדפים")"
                                            @onclick="() => ToggleFavoriteAsync(res.Id)"
                                            @onclick:stopPropagation="true">
                                        <svg width="15" height="15" viewBox="0 0 24 24"
                                             fill="@(_favorites.Contains(res.Id) ? "currentColor" : "none")"
                                             stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" aria-hidden="true">
                                            <path d="m12 4 2.4 4.9 5.4.8-3.9 3.8.9 5.4-4.8-2.6-4.8 2.6.9-5.4L4.2 9.7l5.4-.8z" />
                                        </svg>
                                    </button>
                                    <span class="lres-open-arrow" aria-hidden="true">↗</span>
                                </span>
                            </div>
                        }
                    }
                </div>
            </div>

            @* Admin dates — no live data source, show placeholder *@
            <div>
                <p class="lres-section-cap">תאריכים מנהליים</p>
                <div class="lres-grad-card lres-dates-card">
                    <div class="lres-quick-empty">אין תאריכים מנהליים להצגה</div>
                </div>
            </div>

        </div>

    </div>
}

@code {
    private const string FavKey    = "motiva-lecturer-resource-favorites-v1";
    private const string RecentKey = "motiva-lecturer-resource-recent-v1";

    private List<KnowledgeResource> _resources = new();
    private bool _loading    = true;
    private bool _loadError;

    private string _query = "";

    private HashSet<int> _favorites = new();

    // Recent: list of (resource, openedAt), most recent first, max 5
    private List<(KnowledgeResource Resource, DateTime OpenedAt)> _recentResources = new();

    // ── Lifecycle ───────────────────────────────────────────────────────

    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(LoadFavoritesAsync(), LoadRecentAsync());
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading   = true;
        _loadError = false;
        StateHasChanged();

        var files = await ResourceFilesService.GetAllAsync();
        if (files is null)
        {
            _loadError = true;
            _loading   = false;
            return;
        }

        _resources = KnowledgeCenterModel.ToResources(files);
        _loading   = false;

        // Rebuild recent from stored IDs now that we have the real resources
        await RebuildRecentListAsync();
    }

    // ── Computed lists ──────────────────────────────────────────────────

    private bool IsSearching => _query.Trim().Length > 0;

    private List<KnowledgeResource> SearchResults =>
        KnowledgeCenterModel.Search(_resources, _query);

    // Top 3 most recently uploaded, as a proxy for "frequently used"
    private List<KnowledgeResource> _frequent =>
        _resources.OrderByDescending(r => r.UploadedLabel).Take(3).ToList();

    private List<KnowledgeResource> FavoriteResources =>
        _resources.Where(r => _favorites.Contains(r.Id)).ToList();

    // Documents (pdf, doc, txt) + Videos → shown as cards in "נהלים"
    private List<KnowledgeResource> GuideItems =>
        _resources
            .Where(r => r.Category is KnowledgeCategoryKey.Documents or KnowledgeCategoryKey.Videos)
            .ToList();

    // Slides (ppt, xlsx) + Images/archives → shown as rows in "טפסים"
    private List<KnowledgeResource> FormItems =>
        _resources
            .Where(r => r.Category is KnowledgeCategoryKey.Slides or KnowledgeCategoryKey.Images)
            .ToList();

    // ── Resource link helpers ───────────────────────────────────────────

    private static string? ResourceHref(KnowledgeResource r) => r.Action switch
    {
        KnowledgeResourceAction.Download  => r.Href,
        KnowledgeResourceAction.External  => r.Href,
        KnowledgeResourceAction.PlayVideo => r.VideoUrl,
        _                                 => null,
    };

    // Renders a plain <a> anchor for a resource, handling download vs new-tab.
    // Used in the top-row quick panels where the whole row layout is controlled
    // by the parent element rather than this anchor.
    private RenderFragment ResourceAnchor(KnowledgeResource r, string cssClass) =>
        @<a class="@cssClass"
             href="@ResourceHref(r)"
             download="@(r.Action == KnowledgeResourceAction.Download ? r.DownloadName : null)"
             target="@(r.Action != KnowledgeResourceAction.Download ? "_blank" : null)"
             @onclick="() => TrackRecentAsync(r.Id)"
             @onclick:preventDefault="false">@r.Title</a>;

    // ── Favorites ───────────────────────────────────────────────────────

    private async Task ToggleFavoriteAsync(int id)
    {
        if (!_favorites.Add(id)) _favorites.Remove(id);
        try
        {
            await JS.InvokeVoidAsync("localStorage.setItem",
                FavKey, string.Join(",", _favorites));
        }
        catch { /* storage blocked — page stays fully usable */ }
    }

    private async Task LoadFavoritesAsync()
    {
        try
        {
            var raw = await JS.InvokeAsync<string?>("localStorage.getItem", FavKey);
            if (!string.IsNullOrWhiteSpace(raw))
                _favorites = raw.Split(',', StringSplitOptions.RemoveEmptyEntries)
                               .Select(x => int.TryParse(x, out var v) ? v : -1)
                               .Where(v => v > 0)
                               .ToHashSet();
        }
        catch { /* storage unavailable — favorites simply empty */ }
    }

    // ── Recent ──────────────────────────────────────────────────────────
    // Stored as comma-separated "id:ticks" pairs (ticks = DateTime.UtcNow.Ticks).
    // Max 5 entries, most-recently-opened first.

    private async Task TrackRecentAsync(int id)
    {
        try
        {
            var raw = await JS.InvokeAsync<string?>("localStorage.getItem", RecentKey) ?? "";
            var entries = ParseRecentRaw(raw)
                .Where(e => e.Id != id)         // remove stale entry for same id
                .Prepend((Id: id, At: DateTime.UtcNow))
                .Take(5)
                .ToList();

            var serialized = string.Join(",", entries.Select(e => $"{e.Id}:{e.At.Ticks}"));
            await JS.InvokeVoidAsync("localStorage.setItem", RecentKey, serialized);

            // Update the in-memory list
            await RebuildRecentListAsync();
            StateHasChanged();
        }
        catch { /* storage blocked — silently ignore */ }
    }

    private async Task LoadRecentAsync()
    {
        try
        {
            var raw = await JS.InvokeAsync<string?>("localStorage.getItem", RecentKey) ?? "";
            // _resources may not be populated yet; RebuildRecentListAsync handles it
            _ = ParseRecentRaw(raw); // just validates parsing
        }
        catch { }
    }

    private async Task RebuildRecentListAsync()
    {
        try
        {
            var raw = await JS.InvokeAsync<string?>("localStorage.getItem", RecentKey) ?? "";
            _recentResources = ParseRecentRaw(raw)
                .Select(e => (
                    Resource: _resources.FirstOrDefault(r => r.Id == e.Id),
                    OpenedAt: e.At))
                .Where(x => x.Resource is not null)
                .Select(x => (x.Resource!, x.OpenedAt))
                .ToList();
        }
        catch
        {
            _recentResources = new();
        }
    }

    private static IEnumerable<(int Id, DateTime At)> ParseRecentRaw(string raw) =>
        raw.Split(',', StringSplitOptions.RemoveEmptyEntries)
           .Select(part =>
           {
               var idx = part.IndexOf(':');
               if (idx < 1) return (Id: -1, At: default);
               return int.TryParse(part[..idx], out var id)
                   && long.TryParse(part[(idx + 1)..], out var ticks)
                   ? (Id: id, At: new DateTime(ticks, DateTimeKind.Utc))
                   : (Id: -1, At: default);
           })
           .Where(e => e.Id > 0);
}
