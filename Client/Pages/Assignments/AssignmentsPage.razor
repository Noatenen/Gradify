@page "/assignments"
@layout AppLayout
@attribute [Authorize(Roles = Roles.Admin)]
@using AuthWithAdmin.Client.Pages.Assignments
@using AuthWithAdmin.Client.Pages.Management.Forms
@inject IAssignmentManagementService AssignmentManagementService
@inject NavigationManager Nav
@implements IDisposable

@*
    ── שיבוצים (Assignment work queue) ──────────────────────────────────────
    Route: /assignments — reached from the ניהול hub and from the assignment
    form's own editor.

    WHAT THIS SCREEN IS
    ───────────────────
    The lecturer's WORK QUEUE. It answers one question:

        "Which teams still need an assignment, and what should I do with them?"

    Two views of the same cohort, switched by the shared segmented pill group:

      • ממתינים לשיבוץ  — the DEFAULT. One compact card per team with no
                           assignment yet: who they are, what they ranked, what
                           the system currently recommends, how contested it is,
                           and the one button that opens the decision.
      • שיבוצים קיימים  — the monitoring table over what is already decided:
                           team, project, mentors, status, publish state.

    WHAT REPLACED WHAT — AND WHY
    ────────────────────────────
    • The primary mode was called "טפסים שהוגשו" and listed every submitted
      form. Submitted forms are the SOURCE DATA, not the task: a settled team
      sat in the same list as a waiting one, and the screen could not say what
      was left to do. The primary view is now the teams that need a decision,
      and its count is the size of the job.

    • The deep work happened in an expandable detail row INSIDE the queue —
      a three-panel workspace unfolding between two table rows. Scanning ten
      teams and deciding about one need opposite densities, and a table row
      could serve neither. The decision moved to TeamAssignmentWorkspace, a
      focused modal for exactly one team.

    • Reading a team's submitted form required opening that same workspace, so
      "what did they ask for?" could only be answered through the machinery for
      "where should they go?". Reading is now AssignmentFormModal, which owns
      no actions at all beyond the one that hands the team to the workspace.

    • שיבוצים קיימים was pivoted to the PROJECT and carried a demand column and
      the recommendation engine's vocabulary. It is a monitoring view: it is
      pivoted to the team, and it answers only "what is assigned, and what state
      is it in".

    RECOMMENDATIONS ARE DERIVED, NEVER STORED
    ─────────────────────────────────────────
    Every recommendation on this screen comes from AssignmentRecommender, which
    is handed the live board on each call. Assign, move or unassign anyone and
    every other team's recommendation re-answers itself on the next render —
    a #1 that goes to somebody else drops out and the #2 takes over; free it
    again and the #1 comes back. Nothing is memoised across a mutation.

    WHAT DID NOT CHANGE
    ───────────────────
    Every business rule. Assign, force-move (with its conflict confirmation),
    unassign, add/remove mentor under MaxMentorsPerProject, and publish all call
    exactly the same IAssignmentManagementService methods with the same
    arguments and the same outcome handling as before. No DTO, service, endpoint
    or table was touched.

    DEEP LINKS
    ──────────
    ?team={id}            → opens that team's decision workspace
    ?team={id}&view=form  → opens that team's submitted form
    So any screen in the product can send a lecturer to "this team's form" or
    "this team's assignment" without inventing a second route, and without ever
    dumping them on a table to find the row themselves.

    DEMO DATA
    ─────────
    When the API returns nothing to show (or is unreachable), the page fills
    itself from AssignmentsDemoData and says so, in the open, with a chip on the
    mode bar. In that state actions mutate the in-memory copy instead of posting
    invented ids to the server — see PerformAssign / PerformUnassign / the
    mentor and publish handlers, which branch on _demo before any HTTP call.
*@

<div class="ap-page" dir="rtl" @onclick="CloseAllMenus">

    @* ══ Header — identity and the page-level acts ════════════════════════ *@
    <header class="ap-head">
        <div class="ap-head-main">
            <MAdminBack />

            <div class="ap-head-title">
                <h1 class="ap-h1">שיבוצים</h1>
                <MInfoTip Text="הצוותים הממתינים להחלטת שיבוץ, ההמלצה הנוכחית של המערכת עבור כל אחד מהם, והשיבוצים שכבר נקבעו" />
                @if (!_loading)
                {
                    <MSummaryTag Metrics="SummaryMetrics" />
                }
            </div>
        </div>

        <div class="ap-head-actions" @onclick:stopPropagation="true">
            <MCopyLinkAction Route="@StudentFormLinks.AssignmentForm"
                             Label="טופס השיבוצים לסטודנטים"
                             ButtonLabel="העתקת קישור"
                             Class="ap-copy" />

            @* Beside the link that HANDS the form to students, the control that
               shows what they will get. Copying an address you have never seen
               the other end of is the gap this fills — /student/assignment is
               Student-only, so an admin cannot simply follow their own link. *@
            <button type="button" class="ap-btn-ghost" @onclick="OpenStudentPreview">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7-10-7-10-7Z" />
                    <circle cx="12" cy="12" r="3" />
                </svg>
                תצוגה מקדימה של טופס הסטודנט
            </button>

            <button type="button"
                    class="ap-btn-primary motiva-cta"
                    disabled="@(!CanPublish)"
                    title="@PublishHint"
                    @onclick="OpenPublishConfirm">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M12 16V4" />
                    <path d="m7 9 5-5 5 5" />
                    <path d="M20 16v2a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2v-2" />
                </svg>
                פרסום שיבוצים
            </button>
        </div>
    </header>

    @* ══ Mode bar — the compact segmented switch, and where things stand ══ *@
    <div class="ap-modebar" @onclick:stopPropagation="true">
        <div class="ap-modes">
            <MFilterTabs Tabs="ModeTabs"
                         ActiveKey="@_mode"
                         OnSelect="SwitchMode"
                         AriaLabel="מצב תצוגה בשיבוצים" />
        </div>

        <div class="ap-modebar-end">
            @if (_demo)
            {
                <button type="button" class="ap-demo" title="@DemoHint" @onclick="ToggleDemo">
                    <span class="ap-demo-dot" aria-hidden="true"></span>
                    @DemoCohort.Submissions.Count טפסי הדגמה
                    <span class="ap-demo-off">הצגת הנתונים האמיתיים</span>
                </button>
            }
            else if (!_loading && !DemoCohort.IsEmpty)
            {
                <button type="button" class="ap-demo-on" title="@DemoOffHint" @onclick="ToggleDemo">
                    הצגת נתוני הדגמה
                </button>
            }

            @if (!_loading && _board is not null)
            {
                <span class="ap-pubstate @PublishStateClass">
                    <span class="ap-dot" aria-hidden="true"></span>
                    @PublishStateText
                </span>
            }
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(_actionMessage))
    {
        <div class="ap-toast @(_actionError ? "ap-toast--error" : "")" role="status">
            @_actionMessage
            <button type="button" class="ap-toast-x" @onclick="() => _actionMessage = null" aria-label="סגירה">×</button>
        </div>
    }

    @if (_loadFailed && !_demo)
    {
        <div class="ap-toast ap-toast--error" role="alert">שגיאה בטעינת נתוני השיבוצים. נסו לרענן את הדף.</div>
    }

    @* ══════════════════════════════════════════════════════════════════════
         VIEW 1 — ממתינים לשיבוץ (the work queue)

         A card list, not a table. The five things a lecturer reads while
         triaging — who, what they asked for, what we suggest, how contested
         it is, whether it is free — do not sit in five comparable columns;
         two of them are lists and one is a sentence. A table forced them into
         cells and then needed an expandable row to say anything real.
       ══════════════════════════════════════════════════════════════════════ *@
    @if (_mode == ModePending)
    {
        var waiting = VisibleWaitingTeams();

        <div class="ap-toolbar" @onclick:stopPropagation="true">
            <MSearchField Value="@_search"
                          ValueChanged="OnSearchChanged"
                          Placeholder="חיפוש לפי צוות, סטודנט או פרויקט"
                          AriaLabel="חיפוש בצוותים הממתינים לשיבוץ"
                          Class="ap-search" />

            @if (_search != "")
            {
                <button type="button" class="ap-clear" @onclick="ClearSearch">ניקוי חיפוש</button>
            }

            @if (!_loading)
            {
                <span class="ap-result">@waiting.Count(r => !r.IsSample) מתוך @WaitingCount צוותים</span>
            }
        </div>

        @if (_loading)
        {
            <div class="ap-loading" role="status">
                <span class="ap-spinner" aria-hidden="true"></span>
                טוען צוותים ממתינים…
            </div>
        }
        else if (waiting.Count == 0)
        {
            @if (WaitingCount == 0 && RealTeamRows.Count > 0)
            {
                <MEmptyState Title="כל הצוותים שובצו"
                             Description="לא נותרו צוותים הממתינים להחלטת שיבוץ. השיבוצים שנקבעו מוצגים בלשונית שיבוצים קיימים."
                             Live="true" />
            }
            else if (RealTeamRows.Count == 0)
            {
                <MEmptyState Title="טרם הוגשו טפסי שיבוץ"
                             Description="כאשר צוותים יגישו את טופס השיבוץ הם יופיעו כאן, עם ההמלצה של המערכת עבור כל אחד מהם."
                             Live="true" />
            }
            else
            {
                <MEmptyState Title="לא נמצאו צוותים"
                             Description="נסו לשנות את החיפוש"
                             Live="true" />
            }
        }
        else
        {
            <ul class="ap-queue">
                @foreach (var row in waiting)
                {
                    var rec     = RecommendationFor(row);
                    var primary = rec.Primary;
                    var busy    = _busyTeamIds.Contains(row.TeamId);

                    @* The card IS the way in. A lecturer scanning ten teams
                       should not have to land on a button to inspect one, so
                       the whole card opens the decision workspace. The two
                       explicit buttons stay: they are the keyboard path, and
                       טופס שיבוץ is the one act the card click cannot mean. *@
                    <li class="ap-q ap-q--clickable @(row.IsSample ? "ap-q--sample" : "")"
                        @onclick="() => OpenWorkspace(row.TeamId)">

                        @* ── Who ────────────────────────────────────────── *@
                        <div class="ap-q-team">
                            <span class="ap-avatar" aria-hidden="true">@Initials(row.TeamName)</span>
                            <span class="ap-identity">
                                <span class="ap-nameline">
                                    <span class="ap-name" title="@row.TeamName">@row.TeamName</span>
                                    @* The marking sits ON the identity, not on the
                                       card's edge: whatever else the eye takes from
                                       this row, it cannot read the names without
                                       reading what they are. *@
                                    @if (row.IsSample)
                                    {
                                        <span class="ap-sample" title="@AssignmentSampleForm.Hint">@AssignmentSampleForm.Label</span>
                                    }
                                </span>
                                <span class="ap-sub" title="@row.MembersLine">
                                    @if (row.Members.Count == 0)
                                    {
                                        <span class="ap-none">אין חברי צוות פעילים</span>
                                    }
                                    else
                                    {
                                        @row.MembersLine
                                    }
                                </span>
                            </span>
                        </div>

                        @* ── What they asked for ────────────────────────── *@
                        <div class="ap-q-block">
                            <span class="ap-q-label">העדפות</span>

                            @if (row.HasOwnProject && row.Preferences.Count == 0)
                            {
                                <span class="ap-pref ap-pref--own">פרויקט עצמאי</span>
                            }
                            else if (row.Preferences.Count == 0)
                            {
                                <span class="ap-none">לא דורגו העדפות</span>
                            }
                            else
                            {
                                <ol class="ap-q-prefs">
                                    @if (row.HasOwnProject)
                                    {
                                        <li><span class="ap-pref ap-pref--own">פרויקט עצמאי</span></li>
                                    }
                                    @foreach (var pref in row.Preferences.OrderBy(p => p.Priority).Take(3))
                                    {
                                        var takenBy = TeamOnProject(pref.ProjectId);
                                        <li class="ap-q-pref">
                                            <span class="ap-pref-rank">@pref.Priority</span>
                                            <span class="ap-q-pref-name" title="@pref.ProjectTitle">@pref.ProjectTitle</span>
                                            @* The conflict signal, at the scanning
                                               level. Without it the queue's headline
                                               recommendation can silently disagree
                                               with the team's first choice and the
                                               lecturer has no idea why. *@
                                            @if (takenBy is not null)
                                            {
                                                <span class="ap-q-taken">תפוס</span>
                                            }
                                        </li>
                                    }
                                </ol>
                            }
                        </div>

                        @* ── What to do about it ────────────────────────── *@
                        <div class="ap-q-block ap-q-block--rec">
                            <span class="ap-q-label">המלצה נוכחית</span>

                            @if (primary is null)
                            {
                                <span class="ap-none">אין פרויקט פנוי להמליץ עליו</span>
                            }
                            else
                            {
                                <div class="ap-q-rec">
                                    <span class="ap-q-rec-name" title="@primary.ProjectName">@primary.ProjectName</span>
                                    <span class="ap-score @ScoreClass(primary.Score)">התאמה @primary.Score</span>
                                </div>

                                <div class="ap-q-rec-meta">
                                    @if (primary.Source == AssignmentOptionSource.Preference)
                                    {
                                        <span class="ap-q-rank">העדפה #@primary.PreferenceRank</span>
                                    }
                                    else
                                    {
                                        <span class="ap-q-rank ap-q-rank--ext">מחוץ להעדפות</span>
                                    }

                                    @* Demand is decision support, not an alarm: the
                                       shared neutral meter, never rose. *@
                                    <MDemandBadge Teams="primary.Demand.Teams"
                                                  FirstChoice="primary.Demand.FirstChoice"
                                                  Size="MDemandBadge.DemandSize.Full" />
                                </div>
                            }
                        </div>

                        @* ── The two ways in ────────────────────────────── *@
                        <div class="ap-q-act" @onclick:stopPropagation="true">
                            <button type="button" class="ap-btn-row motiva-cta"
                                    disabled="@busy"
                                    @onclick="() => OpenWorkspace(row.TeamId)">
                                בדיקת שיבוץ
                            </button>

                            <button type="button" class="ap-btn-row ap-btn-row--ghost"
                                    @onclick="() => OpenForm(row.TeamId)">
                                טופס שיבוץ
                            </button>
                        </div>
                    </li>
                }
            </ul>
        }
    }

    @* ══════════════════════════════════════════════════════════════════════
         VIEW 2 — שיבוצים קיימים (monitoring)

         What is already assigned and what state it is in. Deliberately
         free of preferences, match scores and recommendations: those belong
         to the decision, and the decision has been made.
       ══════════════════════════════════════════════════════════════════════ *@
    else
    {
        var projectRows = VisibleProjects();

        <div class="ap-toolbar" @onclick:stopPropagation="true">
            <MSearchField Value="@_search"
                          ValueChanged="OnSearchChanged"
                          Placeholder="חיפוש לפי פרויקט, צוות או מנחה"
                          AriaLabel="חיפוש בשיבוצים קיימים"
                          Class="ap-search" />

            <div class="ap-filter">
                <button type="button"
                        class="ap-filter-btn @(_projectFilter != "assigned" ? "ap-filter-btn--on" : "")"
                        @onclick="@(() => ToggleFilter("project"))"
                        aria-haspopup="listbox" aria-expanded="@(_openFilter == "project" ? "true" : "false")">
                    <span class="ap-filter-name">מצב</span>
                    <span class="ap-filter-value">@ProjectFilterLabel(_projectFilter)</span>
                    <svg class="ap-chev @(_openFilter == "project" ? "ap-chev--open" : "")"
                         width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="m6 9 6 6 6-6" />
                    </svg>
                </button>

                @if (_openFilter == "project")
                {
                    <div class="ap-menu ap-menu--filter" role="listbox" aria-label="מצב">
                        @foreach (var opt in ProjectFilterOptions)
                        {
                            var val = opt;
                            <button type="button"
                                    class="ap-menu-item @(_projectFilter == val ? "ap-menu-item--on" : "")"
                                    role="option" aria-selected="@(_projectFilter == val ? "true" : "false")"
                                    @onclick="@(() => PickProjectFilter(val))">
                                <span class="ap-menu-item-label">@ProjectFilterLabel(val)</span>
                                @if (_projectFilter == val)
                                {
                                    <svg class="ap-menu-check" width="12" height="12" viewBox="0 0 24 24" fill="none"
                                         stroke="currentColor" stroke-width="2.6" stroke-linecap="round"
                                         stroke-linejoin="round" aria-hidden="true">
                                        <path d="m5 12.5 4.5 4.5L19 7" />
                                    </svg>
                                }
                            </button>
                        }
                    </div>
                }
            </div>

            @if (_search != "" || _projectFilter != "assigned")
            {
                <button type="button" class="ap-clear" @onclick="ClearProjectFilters">איפוס סינון</button>
            }

            @if (!_loading)
            {
                <span class="ap-result">@projectRows.Count מתוך @AllProjects.Count פרויקטים</span>
            }
        </div>

        <MDataTable TItem="AssignmentBoardProjectDto"
                    Items="projectRows"
                    Loading="_loading"
                    LoadingText="טוען שיבוצים…"
                    ColumnCount="6"
                    MinWidth="920px"
                    Class="ap-table">

            @* Team and project carry the row; the three state columns are sized
               to their own content and stop growing with the viewport. *@
            <Columns>
                <col class="ap-col-team" />
                <col class="ap-col-project" />
                <col class="ap-col-mentors" />
                <col class="ap-col-status" />
                <col class="ap-col-pub" />
                <col class="ap-col-kebab" />
            </Columns>

            <HeaderContent>
                <th scope="col">צוות</th>
                <th scope="col">פרויקט</th>
                <th scope="col">מנחה</th>
                <th scope="col">סטטוס</th>
                <th scope="col">פרסום</th>
                <th scope="col"><span class="ap-sr">פעולות</span></th>
            </HeaderContent>

            <EmptyContent>
                <MEmptyState Title="לא נמצאו שיבוצים"
                             Description="נסו לשנות את החיפוש או הסינון"
                             Live="true" />
            </EmptyContent>

            <RowTemplate Context="proj">
                @{
                    var menuOpen     = _openProjectMenu == proj.ProjectId;
                    var mentorOpen   = _openMentorMenu == proj.ProjectId;
                    var busy         = _busyProjectIds.Contains(proj.ProjectId);
                    var canAddMentor = proj.Mentors.Count < MaxMentors;
                    var memberLine   = string.Join(" · ", proj.AssignedMembers.Select(m => m.FullName));

                    // The row opens the assignment it describes — but only when
                    // this screen actually holds that team. A synced project can
                    // name a team from another cycle, and a row that offers to
                    // open something and then does nothing is worse than a row
                    // that never offered. Same guard gates the menu items below,
                    // which used to be dead on exactly these rows.
                    var openTeamId = OpenableTeamId(proj);
                }

                <tr class="@(menuOpen || mentorOpen ? "m-dt-row-active" : "") @(openTeamId is null ? "" : "ap-row--clickable")"
                    @onclick="@(() => OpenAssignmentRow(openTeamId))">

                    @* The team leads the row: this view is read team-first —
                       "where did Team_16 end up" — not catalogue-first. *@
                    <td class="ap-cell-team">
                      @if (openTeamId is not null)
                      {
                          @* The same act as the row click, as a real control:
                             the row is a mouse convenience and cannot be
                             tabbed to, and a <tr> given a button role would
                             cost the table its semantics. *@
                          <button type="button" class="ap-cellflex ap-rowlink"
                                  title="@($"פרטי השיבוץ של {AssignedTeamLabel(proj)}")"
                                  @onclick="@(() => OpenWorkspace(openTeamId.Value))"
                                  @onclick:stopPropagation="true">
                              <span class="ap-avatar" aria-hidden="true">@Initials(AssignedTeamLabel(proj))</span>
                              <span class="ap-identity">
                                  <span class="ap-name ap-name--link" title="@AssignedTeamLabel(proj)">@AssignedTeamLabel(proj)</span>
                                  @if (proj.AssignedMembers.Count > 0)
                                  {
                                      <span class="ap-sub" title="@memberLine">@memberLine</span>
                                  }
                              </span>
                          </button>
                      }
                      else
                      {
                        <div class="ap-cellflex">
                          @if (proj.AssignedTeamId.HasValue)
                          {
                              <span class="ap-avatar" aria-hidden="true">@Initials(AssignedTeamLabel(proj))</span>
                              <span class="ap-identity">
                                  <span class="ap-name" title="@AssignedTeamLabel(proj)">@AssignedTeamLabel(proj)</span>
                                  @if (proj.AssignedMembers.Count > 0)
                                  {
                                      <span class="ap-sub" title="@memberLine">@memberLine</span>
                                  }
                                  else if (string.IsNullOrWhiteSpace(proj.AssignedTeamName))
                                  {
                                      <span class="ap-sub">הצוות אינו במחזור הנוכחי</span>
                                  }
                              </span>
                          }
                          else
                          {
                              <span class="ap-none">טרם שובץ צוות</span>
                          }
                        </div>
                      }
                    </td>

                    <td class="ap-cell-project">
                      <div class="ap-cellflex">
                        <span class="ap-num">#@proj.ProjectNumber</span>
                        <span class="ap-identity">
                            <span class="ap-name" title="@proj.ProjectName">@proj.ProjectName</span>
                            @if (!string.IsNullOrWhiteSpace(proj.ProjectType))
                            {
                                <span class="ap-sub"><span class="ap-type">@ProjectTypeLabel(proj.ProjectType)</span></span>
                            }
                        </span>
                      </div>
                    </td>

                    <td class="ap-cell-mentors" @onclick:stopPropagation="true">
                        <div class="ap-mentors">
                            @foreach (var mentor in proj.Mentors)
                            {
                                <span class="ap-mentor">
                                    @mentor.FullName
                                    <button type="button" class="ap-mentor-x"
                                            disabled="@busy"
                                            title="@($"הסרת {mentor.FullName}")"
                                            aria-label="@($"הסרת {mentor.FullName}")"
                                            @onclick="@(() => RemoveMentor(proj, mentor))">×</button>
                                </span>
                            }

                            @if (proj.Mentors.Count == 0)
                            {
                                <span class="ap-none">אין מנחה</span>
                            }

                            @if (canAddMentor)
                            {
                                <div class="ap-filter">
                                    <button type="button" class="ap-mentor-add"
                                            disabled="@busy"
                                            @onclick="@(() => ToggleMentorMenu(proj.ProjectId))"
                                            aria-haspopup="listbox" aria-expanded="@(mentorOpen ? "true" : "false")"
                                            title="@($"הוספת מנחה ({proj.Mentors.Count}/{MaxMentors})")">
                                        + מנחה
                                    </button>

                                    @if (mentorOpen)
                                    {
                                        <div class="ap-menu ap-menu--filter" role="listbox" aria-label="בחירת מנחה">
                                            @{ var available = AvailableMentorsFor(proj).ToList(); }
                                            @if (available.Count == 0)
                                            {
                                                <div class="ap-menu-empty">כל המנחים כבר משויכים</div>
                                            }
                                            @foreach (var mentor in available)
                                            {
                                                var m = mentor;
                                                <button type="button" class="ap-menu-item" role="option" aria-selected="false"
                                                        @onclick="@(() => AddMentor(proj, m))">
                                                    <span class="ap-menu-item-label">@m.FullName</span>
                                                </button>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </td>

                    <td>
                        @if (proj.AssignedTeamId.HasValue)
                        {
                            <span class="ap-state ap-state--live"><span class="ap-dot" aria-hidden="true"></span>משובץ</span>
                        }
                        else
                        {
                            <span class="ap-state ap-state--none"><span class="ap-dot" aria-hidden="true"></span>טרם שובץ</span>
                        }
                    </td>

                    @* Publish is its own axis, not a third value of status: an
                       assignment can be settled and unpublished at the same
                       time, and the page's one primary act is publishing. *@
                    <td>
                        @if (!proj.AssignedTeamId.HasValue)
                        {
                            <span class="ap-none">—</span>
                        }
                        else if (proj.IsDraft)
                        {
                            <span class="ap-state ap-state--draft"><span class="ap-dot" aria-hidden="true"></span>טיוטה</span>
                        }
                        else
                        {
                            <span class="ap-state ap-state--live"><span class="ap-dot" aria-hidden="true"></span>פורסם</span>
                        }
                    </td>

                    <td class="ap-cell-act" @onclick:stopPropagation="true">
                        <div class="ap-actions">
                            <button type="button"
                                    class="ap-kebab @(menuOpen ? "ap-kebab--on" : "")"
                                    @onclick="@(() => ToggleProjectMenu(proj.ProjectId))"
                                    aria-haspopup="true" aria-expanded="@(menuOpen ? "true" : "false")"
                                    title="פעולות" aria-label="@($"פעולות עבור {proj.ProjectName}")">
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                                    <circle cx="12" cy="5" r="1.7" />
                                    <circle cx="12" cy="12" r="1.7" />
                                    <circle cx="12" cy="19" r="1.7" />
                                </svg>
                            </button>

                            @if (menuOpen)
                            {
                                @* SECONDARY acts only. Opening the assignment is
                                   the row's job now, so what stays here is what
                                   the row click cannot mean: read the form
                                   instead of the assignment, and undo it.
                                   Each item still goes exactly where its name
                                   says — neither one navigates. *@
                                <div class="ap-menu ap-menu--row" role="menu">
                                    @if (openTeamId is not null)
                                    {
                                        <button type="button" class="ap-menu-item" role="menuitem"
                                                @onclick="@(() => OpenForm(openTeamId.Value))">
                                            <span class="ap-menu-item-label">הצג טופס שיבוץ</span>
                                        </button>
                                        <button type="button" class="ap-menu-item" role="menuitem"
                                                @onclick="@(() => OpenReassign(openTeamId.Value))">
                                            <span class="ap-menu-item-label">שינוי שיבוץ</span>
                                        </button>
                                    }

                                    @if (proj.AssignedTeamId.HasValue)
                                    {
                                        <button type="button" class="ap-menu-item ap-menu-item--danger" role="menuitem"
                                                disabled="@busy"
                                                @onclick="@(() => UnassignProject(proj.ProjectId))">
                                            <span class="ap-menu-item-label">הסרת השיבוץ</span>
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="button" class="ap-menu-item" role="menuitem"
                                                @onclick="GoToQueue">
                                            <span class="ap-menu-item-label">מעבר לצוותים הממתינים</span>
                                        </button>
                                    }
                                </div>
                            }
                        </div>
                    </td>
                </tr>
            </RowTemplate>
        </MDataTable>
    }
</div>

@* ── טופס שיבוץ — the submitted form, read-only ───────────────────────────
   One instance for the whole page: every entry point that means "show me
   what this team submitted" sets _formTeamId and lands here. *@
<AssignmentFormModal IsOpen="@(_formTeam is not null)"
                     Team="_formTeam"
                     Demand="DemandFor"
                     Holder="TeamOnProject"
                     OnClose="CloseForm"
                     OnGoToWorkspace="FormToWorkspace"
                     OnInspectProject="InspectProject" />

@* ── בדיקת שיבוץ — the decision workspace for one team ────────────────────
   Holder and Demand are passed as functions, not as computed lists, so the
   workspace re-derives its recommendation from live board state on every
   render instead of holding a snapshot taken when it opened. *@
<TeamAssignmentWorkspace IsOpen="@(_workspaceTeam is not null)"
                         Team="_workspaceTeam"
                         Assignment="@AssignmentOf(_workspaceTeam)"
                         Cohort="Cohort"
                         Holder="TeamOnProject"
                         Demand="DemandFor"
                         Busy="@WorkspaceBusy"
                         OnAssign="AssignFromWorkspace"
                         OnTakeover="TakeoverFromWorkspace"
                         OnUnassign="UnassignProject"
                         OnClose="CloseWorkspace"
                         OnViewForm="WorkspaceToForm"
                         Decide="_workspaceDecide"
                         OnChangeAssignment="StartReassign"
                         OnBackToDetails="BackToAssignmentDetails"
                         OnInspectProject="InspectProject" />

@* ── Project quick view ───────────────────────────────────────────────────
   Rendered AFTER both assignment surfaces, so it paints over whichever one is
   open. Neither is closed or reset: the form and the workspace are addressed
   by team id and keep their own state, so dismissing this returns the reader
   to exactly the modal, the scroll position and the half-made decision they
   left. *@
<ProjectQuickView ProjectId="_inspectProjectId"
                  Demand="@(_inspectProjectId is int ip ? DemandFor(ip) : ProjectDemand.None)"
                  HeldBy="@(_inspectProjectId is int hp ? TeamOnProject(hp) : null)"
                  Mentors="@MentorsOf(_inspectProjectId)"
                  OnClose="CloseProjectInspection" />

@* ── תצוגה מקדימה של טופס הסטודנט ─────────────────────────────────────────
   The student's WHOLE choosing flow as they will meet it — catalogue, ranking,
   then the form — distinct from AssignmentFormModal above, which reads one
   team's SUBMITTED answers. It loads its own catalogue and form; nothing on
   this page is passed to it but the cycle. *@
<StudentFormPreviewModal IsOpen="_studentPreviewOpen"
                         AcademicYearId="@_board?.AcademicYearId"
                         OnClose="CloseStudentPreview" />

@* ── Move / takeover confirmation ─────────────────────────────────────────
   Unchanged semantics: this is the only path that sends force:true. *@
<MConfirmDialog IsOpen="@(_moveConfirm is not null)"
                Title="@(_moveConfirm?.DisplacedTeam is not null ? "החלפת צוות בפרויקט" : "העברת שיבוץ")"
                ConfirmText="@(_moveConfirm?.DisplacedTeam is not null ? "החלף צוות" : "העבר צוות")"
                CancelText="ביטול"
                Tone="MConfirmDialog.ConfirmTone.Danger"
                Busy="@_moveBusy"
                BusyText="מעביר…"
                OnConfirm="ConfirmMove"
                OnCancel="CloseMoveConfirm">
    @if (_moveConfirm is not null)
    {
        @* Two different acts share this dialog, and they must not read alike.
           A MOVE costs nobody anything. A TAKEOVER ends another team's
           assignment, and the server will do it without a second word once
           this is confirmed — so the team that loses the project is named
           here, in the sentence, rather than left for the lecturer to
           discover afterwards on the board. *@
        @if (_moveConfirm.DisplacedTeam is not null)
        {
            <p>
                הפרויקט <strong>@_moveConfirm.ToProjectName</strong> משובץ כעת ל<strong>@_moveConfirm.DisplacedTeam</strong>.
            </p>
            <p>
                שיבוץ <strong>@_moveConfirm.TeamName</strong> לפרויקט הזה יסיר את השיבוץ של
                <strong>@_moveConfirm.DisplacedTeam</strong>, והוא יחזור להמתין לשיבוץ.
            </p>
        }
        else
        {
            <p>
                הצוות <strong>@_moveConfirm.TeamName</strong> משובץ כעת לפרויקט
                <strong>@_moveConfirm.FromProjectName</strong>.
            </p>
            <p>להעביר אותו לפרויקט <strong>@_moveConfirm.ToProjectName</strong>?</p>
        }
    }
</MConfirmDialog>

@* ── Publish confirmation ─────────────────────────────────────────────── *@
<MConfirmDialog IsOpen="_showPublishConfirm"
                Title="פרסום שיבוצים"
                ShowIcon="false"
                ConfirmText="פרסם שיבוצים"
                CancelText="ביטול"
                Busy="@_publishBusy"
                BusyText="מפרסם…"
                OnConfirm="ConfirmPublish"
                OnCancel="ClosePublishConfirm">
    <p>לפרסם את כל השיבוצים לסטודנטים?</p>
    <p>לאחר הפרסום כל סטודנט שמשויך לפרויקט יראה את השיבוץ שלו בלוח הבקרה.</p>
</MConfirmDialog>


@code {
    // ─────────────────────────────────────────────────────────────────────
    //  Modes
    // ─────────────────────────────────────────────────────────────────────

    private const string ModePending  = "pending";
    private const string ModeAssigned = "assigned";

    /// <summary>The queue is the job. Submitted forms are the source data
    /// behind it, not a mode of their own — hence this default.</summary>
    private string _mode = ModePending;

    private IReadOnlyList<MFilterTabs.Tab> ModeTabs => new[]
    {
        new MFilterTabs.Tab(ModePending,  "ממתינים לשיבוץ", WaitingCount),
        new MFilterTabs.Tab(ModeAssigned, "שיבוצים קיימים", AssignedCount)
    };

    private void SwitchMode(string mode)
    {
        if (_mode == mode) return;
        _mode = mode;
        _search = "";
        CloseAllMenus();
    }

    private void GoToQueue()
    {
        CloseAllMenus();
        _mode = ModePending;
        _search = "";
    }

    // ─────────────────────────────────────────────────────────────────────
    //  Data
    // ─────────────────────────────────────────────────────────────────────

    // The board is ALWAYS the one the API returned. Demo mode adds submitted
    // FORMS on top of it — it never substitutes a fabricated board — so demand,
    // availability and every recommendation on the screen are derived against
    // real projects whichever mode is on. See AssignmentsDemoData.
    private List<AssignmentSubmissionListItemDto> _liveSubmissions = new();
    private AssignmentBoardDto?                   _liveBoard;

    private AssignmentsDemoData.Cohort? _demoCohort;

    /// <summary>Built once per board. Resolving it needs the catalogue, so it
    /// cannot exist before the first load.</summary>
    private AssignmentsDemoData.Cohort DemoCohort =>
        _demoCohort ??= AssignmentsDemoData.Build(_liveBoard);

    private List<AssignmentSubmissionListItemDto> _submissions =>
        _demo
            ? _liveSubmissions.Concat(DemoCohort.Submissions).ToList()
            : _liveSubmissions;

    private AssignmentBoardDto? _board => _liveBoard;

    private bool _loading = true;
    private bool _loadFailed;

    /// <summary>True while the screen is showing <see cref="AssignmentsDemoData"/>.
    /// Every mutating handler branches on it BEFORE reaching the service, so no
    /// invented id is ever posted to the server.
    ///
    /// <para>It turns itself on when the PRIMARY workspace would be empty — no
    /// submitted form and no team waiting on the board — because that is the
    /// state in which the screen cannot be judged. It is never silent: the mode
    /// bar carries a chip saying so, and that chip is the switch back. A board
    /// full of projects with nothing submitted against them still counts as
    /// empty here, which is exactly the local-dev case.</para></summary>
    private bool _demo;

    private const string DemoHint =
        "מוצגים כאן טפסי שיבוץ לדוגמה בנוסף לנתונים האמיתיים, לצורך בחינת המסך. הפרויקטים, הביקוש וההמלצות אמיתיים; פעולות במצב זה אינן נשמרות בשרת. לחצו כדי לחזור לנתונים האמיתיים בלבד.";

    private const string DemoOffHint =
        "הוספת טפסי שיבוץ לדוגמה מעל הנתונים האמיתיים, לצורך בחינת תור הממתינים. שום דבר אינו נשמר בשרת.";

    /// <summary>Turning demo mode ON only adds forms. Turning it OFF re-fetches,
    /// which is the whole restore story: demo actions mutate the in-memory board
    /// (that is what makes assigning a demo team change what the next one is
    /// offered), and re-reading the API is a cheaper and more trustworthy way
    /// back to the truth than unwinding those edits by hand.</summary>
    private async Task ToggleDemo()
    {
        _demo = !_demo;
        _actionMessage   = null;
        _formTeamId      = null;
        _workspaceTeamId = null;
        _workspaceDecide = false;
        CloseAllMenus();
        InvalidateRows();

        if (!_demo) await LoadAsync();
    }

    protected override async Task OnInitializedAsync()
    {
        Nav.LocationChanged += OnLocationChanged;
        await LoadAsync();
        ApplyQuery();
    }

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        ApplyQuery();
        StateHasChanged();
    }

    /// <summary>Deep links. <c>?team={id}</c> opens the decision workspace,
    /// <c>?team={id}&amp;view=form</c> opens the submitted form — so any screen
    /// in the product can name a team's form or a team's assignment without
    /// inventing a route, and without dropping the lecturer on a table to hunt
    /// for the row.</summary>
    private void ApplyQuery()
    {
        var query = Nav.ToAbsoluteUri(Nav.Uri).Query;

        if (!int.TryParse(QueryValue(query, "team"), out var teamId)) return;

        // A deep link is only honoured for a team the screen actually has.
        if (AllTeamRows.All(r => r.TeamId != teamId)) return;

        var wantsForm = string.Equals(QueryValue(query, "view"), "form", StringComparison.OrdinalIgnoreCase);

        if (wantsForm) { _formTeamId = teamId; _workspaceTeamId = null; }
        else           { _workspaceTeamId = teamId; _formTeamId = null; _workspaceDecide = false; }
    }

    /// <summary>One key out of a "?a=1&amp;b=2" string. Hand-rolled rather than
    /// pulled from WebUtilities: two optional keys do not justify a dependency
    /// this project does not otherwise take.</summary>
    private static string? QueryValue(string query, string key)
    {
        foreach (var pair in query.TrimStart('?').Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var eq = pair.IndexOf('=');
            if (eq <= 0) continue;
            if (!string.Equals(Uri.UnescapeDataString(pair[..eq]), key, StringComparison.OrdinalIgnoreCase)) continue;
            return Uri.UnescapeDataString(pair[(eq + 1)..]);
        }
        return null;
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _loadFailed = false;
        _demo = false;

        var subsTask  = AssignmentManagementService.GetSubmissionsAsync();
        var boardTask = AssignmentManagementService.GetAssignmentBoardAsync();

        var subs  = await subsTask;
        var board = await boardTask;

        _liveSubmissions = subs ?? new List<AssignmentSubmissionListItemDto>();
        _liveBoard       = board;
        _demoCohort      = null;   // resolved against the catalogue — rebuild it
        _loadFailed      = subs is null && board is null;

        // Nothing for the workspace to work on → fill the screen rather than
        // present an empty one. The chip on the mode bar says so and switches
        // back. See AssignmentsDemoData for why this is not a seed.
        // InvalidateRows BEFORE reading the join: the cache was populated by the
        // first (loading) render, when both data sets were still empty, and
        // nothing else here would drop it.
        InvalidateRows();

        _demo = _liveSubmissions.Count == 0
                && (_liveBoard?.UnassignedTeams.Count ?? 0) == 0
                && !DemoCohort.IsEmpty;

        if (_demo)
        {
            _loadFailed = false;
            InvalidateRows();
        }

        _loading = false;
    }

    /// <summary>Re-reads both endpoints after a successful mutation. In demo mode
    /// there is nothing to re-read — the in-memory board IS the state — so it
    /// only reports.</summary>
    private async Task ReloadAsync(string message)
    {
        if (!_demo)
        {
            var subs  = await AssignmentManagementService.GetSubmissionsAsync();
            var board = await AssignmentManagementService.GetAssignmentBoardAsync();

            if (board is null)
            {
                Toast("שגיאה בטעינה מחודשת של הנתונים", error: true);
                return;
            }

            if (subs is not null) _liveSubmissions = subs;
            _liveBoard = board;
        }

        Toast(message, error: false);
    }

    private void Toast(string message, bool error)
    {
        _actionMessage = message;
        _actionError   = error;
    }

    private string? _actionMessage;
    private bool    _actionError;

    // ─────────────────────────────────────────────────────────────────────
    //  Header summary + publish state
    // ─────────────────────────────────────────────────────────────────────

    private int MaxMentors => _board?.MaxMentorsPerProject ?? 2;

    private List<AssignmentBoardProjectDto> AllProjects =>
        _board?.Projects ?? new List<AssignmentBoardProjectDto>();

    private int AssignedCount => AllProjects.Count(p => p.AssignedTeamId.HasValue);

    /// <summary>Every row EXCEPT the inspection sample. This is the cohort the
    /// screen is actually about: the tab badge, the header summary, the result
    /// line and the cohort's rivalry are all counted over it, so a sample row on
    /// screen never moves a number the lecturer is reading the job by.</summary>
    private List<AssignmentTeamView> RealTeamRows =>
        AllTeamRows.Where(r => !r.IsSample).ToList();

    private int WaitingCount => AllTeamRows.Count(r => r.IsWaiting && !r.IsSample);

    private IReadOnlyList<MSummaryTag.Metric> SummaryMetrics
    {
        get
        {
            var rows = RealTeamRows;
            var list = new List<MSummaryTag.Metric>
            {
                new(rows.Count(r => r.IsWaiting).ToString(), "ממתינים"),
                new(rows.Count(r => !r.IsWaiting).ToString(), "שובצו"),
                new(rows.Count.ToString(), "צוותים")
            };

            if (!string.IsNullOrWhiteSpace(_board?.AcademicYearName))
                list.Add(new MSummaryTag.Metric("מחזור", _board!.AcademicYearName));

            return list;
        }
    }

    private bool CanPublish => !_publishBusy && _board is not null && _board.HasUnpublishedDrafts;

    private string PublishHint => _board is null
        ? "אין נתונים"
        : _board.HasUnpublishedDrafts
            ? "פרסום כל השיבוצים שבטיוטה לסטודנטים"
            : "אין שיבוצים חדשים לפרסום";

    private string PublishStateClass => _board switch
    {
        null                                                   => "ap-pubstate--none",
        { HasUnpublishedDrafts: true }                         => "ap-pubstate--draft",
        { AssignmentsPublished: true }                         => "ap-pubstate--live",
        _                                                      => "ap-pubstate--none"
    };

    private string PublishStateText
    {
        get
        {
            if (_board is null) return "אין נתונים";

            var drafts = AllProjects.Count(p => p.AssignedTeamId.HasValue && p.IsDraft);

            if (_board.HasUnpublishedDrafts)
                return drafts > 0 ? $"{drafts} שיבוצים בטיוטה — טרם פורסמו" : "קיימים שיבוצים שטרם פורסמו";

            if (_board.AssignmentsPublished)
                return string.IsNullOrWhiteSpace(_board.PublishedAt)
                    ? "כל השיבוצים פורסמו"
                    : $"פורסם ב־{FormatDate(_board.PublishedAt!)}";

            return "אין שיבוצים לפרסום";
        }
    }

    // ─────────────────────────────────────────────────────────────────────
    //  The joined team row
    // ─────────────────────────────────────────────────────────────────────

    private List<AssignmentTeamView> AllTeamRows => _teamRowCache ??= BuildTeamRows();
    private List<AssignmentTeamView>? _teamRowCache;

    /// <summary>Anything that changes the board invalidates the join — and the
    /// demand counts with it, since they are read off the same submissions.
    /// The recommendations hang off the same three caches, which is what makes
    /// them re-derive after every assign, move and unassign.</summary>
    private void InvalidateRows()
    {
        _teamRowCache = null;
        _demandCache  = null;
        _holderCache  = null;
        _cohortCache  = null;
    }

    private List<AssignmentTeamView> BuildTeamRows()
    {
        var rows = _submissions.Select(s => new AssignmentTeamView
        {
            TeamId                = s.TeamId,
            TeamName              = s.TeamName,
            AcademicYear          = s.AcademicYear,
            SubmittedAt           = s.SubmittedAt,
            HasSubmission         = true,
            HasOwnProject         = s.HasOwnProject,
            OwnProjectDescription = s.OwnProjectDescription,
            Notes                 = s.Notes,
            Members               = s.Members,
            Preferences           = s.Preferences
        }).ToList();

        if (_board is not null)
        {
            // A team can exist on the board without a submission row (its form
            // was withdrawn, or the two endpoints disagree). It still needs a
            // row, or it becomes invisible on the only screen that can assign it.
            var known = rows.Select(r => r.TeamId).ToHashSet();
            foreach (var t in _board.UnassignedTeams.Where(t => !known.Contains(t.TeamId)))
            {
                rows.Add(new AssignmentTeamView
                {
                    TeamId        = t.TeamId,
                    TeamName      = t.TeamName,
                    AcademicYear  = _board.AcademicYearName,
                    HasSubmission = false,
                    Members       = t.Members.Select(m => new AssignmentSubmissionMemberDto
                    {
                        UserId    = m.UserId,
                        FullName  = m.FullName,
                        Strengths = m.Strengths
                    }).ToList(),
                    Preferences = t.Preferences
                });
            }

            // Match data arrives from both directions: TopRecommendations on an
            // unassigned team, and Recommendations on every project. Merged per
            // (team, project) so an assigned team is not left without scores.
            var matches = new Dictionary<int, Dictionary<int, TeamProjectMatchDto>>();

            void Collect(TeamProjectMatchDto m)
            {
                if (!matches.TryGetValue(m.TeamId, out var byProject))
                    matches[m.TeamId] = byProject = new Dictionary<int, TeamProjectMatchDto>();
                byProject[m.ProjectId] = m;
            }

            foreach (var t in _board.UnassignedTeams)
                foreach (var m in t.TopRecommendations) Collect(m);
            foreach (var p in _board.Projects)
                foreach (var m in p.Recommendations) Collect(m);

            var assignment = _board.Projects
                .Where(p => p.AssignedTeamId.HasValue)
                .ToDictionary(p => p.AssignedTeamId!.Value, p => p);

            // A demo team has no board rows at all — the matcher never saw it.
            // Its scores come from the cohort, built the way the server builds
            // them, so a demo score and a real one land in the same bands.
            if (_demo)
                foreach (var demoRows in DemoCohort.Matches.Values)
                    foreach (var m in demoRows) Collect(m);

            foreach (var row in rows)
            {
                if (matches.TryGetValue(row.TeamId, out var byProject))
                    row.Matches = byProject.Values
                        .OrderByDescending(m => m.TotalMatchScore)
                        .ThenBy(m => m.ProjectName)
                        .ToList();

                if (assignment.TryGetValue(row.TeamId, out var proj))
                {
                    row.AssignedProjectId   = proj.ProjectId;
                    row.AssignedProjectName = proj.ProjectName;
                    row.AssignedIsDraft     = proj.IsDraft;
                }
            }
        }

        // The inspection row, added AFTER every real join so nothing above can
        // reach it and nothing about it can reach a real row. It carries its own
        // preferences and its own scores; the board's match maps never mention
        // it. See AssignmentSampleForm for what it is and what it may not touch.
        var sample = AssignmentSampleForm.Build(_liveBoard, _liveSubmissions);
        if (sample is not null) rows.Add(sample);

        // Waiting first — they are the ones with work left on them — then
        // oldest submission first, so nobody waits behind a newer form.
        return rows
            .OrderBy(r => r.IsWaiting ? 0 : 1)
            .ThenBy(r => r.SubmittedAt)
            .ThenBy(r => r.TeamName)
            .ToList();
    }

    /// <summary>The queue: teams with no assignment yet, narrowed by the search
    /// box. A settled team is not in it at all — that is what makes the tab's
    /// count the size of the remaining job.</summary>
    private List<AssignmentTeamView> VisibleWaitingTeams()
    {
        IEnumerable<AssignmentTeamView> q = AllTeamRows.Where(r => r.IsWaiting);

        if (!string.IsNullOrWhiteSpace(_search))
        {
            var needle = _search.Trim();
            q = q.Where(r =>
                Has(r.TeamName, needle) ||
                r.Members.Any(m => Has(m.FullName, needle) || Has(m.Email, needle)) ||
                r.Preferences.Any(p => Has(p.ProjectTitle, needle)));
        }

        // The sample leads the queue. It is there to be opened, and hunting for
        // it down a real cohort is the one thing an inspection row must not cost.
        // Its badge is what keeps that position from reading as urgency.
        return q.OrderBy(r => r.IsSample ? 0 : 1).ToList();
    }

    /// <summary>Every still-waiting team's score on every project they ranked.
    /// Cached beside the rows it is derived from, so it drops with them on the
    /// next mutation — which is what makes "who else wants this" re-answer
    /// itself after every assign, move and unassign rather than going stale.</summary>
    private CohortClaims Cohort => _cohortCache ??= new CohortClaims(RealTeamRows);
    private CohortClaims? _cohortCache;

    /// <summary>The one recommendation function on the screen. Both the queue
    /// card and the workspace read it, so the headline suggestion and the
    /// primary recommendation inside the workspace can never disagree — and
    /// both now see the same cohort.</summary>
    private AssignmentRecommendation RecommendationFor(AssignmentTeamView row) =>
        AssignmentRecommender.Build(row, TeamOnProject, DemandFor, Cohort);

    // ─────────────────────────────────────────────────────────────────────
    //  View 2 — projects
    // ─────────────────────────────────────────────────────────────────────

    private List<AssignmentBoardProjectDto> VisibleProjects()
    {
        IEnumerable<AssignmentBoardProjectDto> q = AllProjects;

        q = _projectFilter switch
        {
            "assigned"   => q.Where(p => p.AssignedTeamId.HasValue),
            "unassigned" => q.Where(p => !p.AssignedTeamId.HasValue),
            "draft"      => q.Where(p => p.AssignedTeamId.HasValue && p.IsDraft),
            _            => q
        };

        if (!string.IsNullOrWhiteSpace(_search))
        {
            var needle = _search.Trim();
            q = q.Where(p =>
                Has(p.ProjectName, needle) ||
                Has(p.AssignedTeamName, needle) ||
                p.ProjectNumber.ToString().Contains(needle) ||
                p.Mentors.Any(m => Has(m.FullName, needle)) ||
                p.AssignedMembers.Any(m => Has(m.FullName, needle)));
        }

        // Assigned first, then by team name — this view is read team-first.
        return q.OrderBy(p => p.AssignedTeamId.HasValue ? 0 : 1)
                .ThenBy(p => AssignedTeamLabel(p))
                .ThenBy(p => p.ProjectNumber)
                .ToList();
    }

    private static bool Has(string? haystack, string needle) =>
        !string.IsNullOrEmpty(haystack) &&
        haystack.Contains(needle, StringComparison.OrdinalIgnoreCase);

