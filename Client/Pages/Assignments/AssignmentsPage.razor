    /// <summary>The inspection row may be READ everywhere and ASSIGNED nowhere.
    /// Guarded here rather than by disabling the buttons, because the whole point
    /// of the sample is that the real controls are exercised: the workspace opens
    /// with its real actions live, and the refusal happens at the last moment
    /// before the call — which is also the only place a new mutation path would
    /// have to pass through. Unlike demo mode it does not even mutate the
    /// in-memory board: a sample that could occupy a project would move
    /// "0 assigned" and "0 published", which is exactly the baseline it must
    /// leave alone.</summary>
    private bool RefuseSampleMutation(int teamId)
    {
        if (!AssignmentSampleForm.IsSampleTeam(teamId)) return false;
        Toast($"{AssignmentSampleForm.Label} — לא בוצע שיבוץ. השורה הזו קיימת לבדיקת המסך בלבד.", error: false);
        return true;
    }

    private async Task AssignTeam(int teamId, int projectId)
    {
        CloseAllMenus();

        if (RefuseSampleMutation(teamId))
        {
            _workspaceTeamId = null;
            return;
        }

        _busyTeamIds.Add(teamId);
        _busyProjectIds.Add(projectId);

        try
        {
            if (_demo)
            {
                DemoAssign(teamId, projectId);
                InvalidateRows();
                _workspaceTeamId = null;
                Toast("מצב הדגמה — הצוות שובץ בתצוגה בלבד", error: false);
                return;
            }

            var res = await AssignmentManagementService.AssignTeamAsync(teamId, projectId, force: false);

            if (res.Outcome == AssignTeamOutcome.Success)
            {
                await ReloadAsync("הצוות שובץ לפרויקט (טיוטה)");
                InvalidateRows();
                // The decision has been taken: the team has left the queue and
                // belongs to שיבוצים קיימים now. Leaving the workspace open over
                // a team it can no longer decide anything about is the state
                // that made the old expanded row confusing.
                _workspaceTeamId = null;
            }
            else if (res.Outcome == AssignTeamOutcome.Conflict && res.Conflict is not null)
            {
                // The team is already on another project. Same confirmation as
                // before; force:true is sent only from ConfirmMove.
                var dest = AllProjects.FirstOrDefault(p => p.ProjectId == projectId);
                _workspaceTeamId = null;
                _moveConfirm = new MoveConfirmState
                {
                    TeamId          = teamId,
                    TeamName        = TeamName(teamId),
                    FromProjectName = res.Conflict.ProjectName,
                    ToProjectId     = projectId,
                    ToProjectName   = dest?.ProjectName ?? ""
                };
            }
            else
            {
                Toast("השיבוץ נכשל. נסו שוב.", error: true);
            }
        }
        finally
        {
            _busyTeamIds.Remove(teamId);
            _busyProjectIds.Remove(projectId);
        }
    }

    private void CloseMoveConfirm() => _moveConfirm = null;

    private async Task ConfirmMove()
    {
        if (_moveConfirm is null) return;
        var state = _moveConfirm;

        if (RefuseSampleMutation(state.TeamId))
        {
            _moveConfirm = null;
            return;
        }

        _moveBusy = true;
        _busyProjectIds.Add(state.ToProjectId);

        try
        {
            if (_demo)
            {
                DemoAssign(state.TeamId, state.ToProjectId);
                InvalidateRows();
                Toast("מצב הדגמה — ההעברה בוצעה בתצוגה בלבד", error: false);
                return;
            }

            var res = await AssignmentManagementService.AssignTeamAsync(state.TeamId, state.ToProjectId, force: true);

            if (res.Outcome == AssignTeamOutcome.Success)
            {
                await ReloadAsync($"הצוות הועבר ל{state.ToProjectName}");
                InvalidateRows();
            }
            else
            {
                Toast("ההעברה נכשלה. נסו שוב.", error: true);
            }
        }
        finally
        {
            _busyProjectIds.Remove(state.ToProjectId);
            _moveBusy = false;
            _moveConfirm = null;
        }
    }

