    // ─────────────────────────────────────────────────────────────────────
    //  Demo-mode mutations — in-memory only, never posted
    // ─────────────────────────────────────────────────────────────────────

    private void DemoAssign(int teamId, int projectId)
    {
        if (_board is null) return;

        // A team sits on exactly one project, so moving means clearing the old
        // one first — the same invariant the server enforces.
        foreach (var p in _board.Projects.Where(p => p.AssignedTeamId == teamId))
        {
            p.AssignedTeamId   = null;
            p.AssignedTeamName = null;
            p.AssignedMembers  = new List<AssignmentBoardTeamMemberDto>();
            p.IsDraft          = false;
        }

        var target = _board.Projects.FirstOrDefault(p => p.ProjectId == projectId);
        if (target is null) return;

        // Whoever was on the target goes back to the unassigned pool.
        if (target.AssignedTeamId.HasValue) DemoReturnToPool(target);

        var row = AllTeamRows.FirstOrDefault(r => r.TeamId == teamId);
        target.AssignedTeamId   = teamId;
        target.AssignedTeamName = row?.TeamName ?? TeamName(teamId);
        target.AssignedMembers  = (row?.Members ?? new List<AssignmentSubmissionMemberDto>())
            .Select(m => new AssignmentBoardTeamMemberDto
            {
                UserId    = m.UserId,
                FullName  = m.FullName,
                Strengths = m.Strengths
            }).ToList();
        target.IsDraft = true;

        _board.UnassignedTeams.RemoveAll(t => t.TeamId == teamId);
        _board.HasUnpublishedDrafts = true;
    }

    private void DemoUnassign(int projectId)
    {
        var proj = _board?.Projects.FirstOrDefault(p => p.ProjectId == projectId);
        if (proj?.AssignedTeamId is null) return;

        DemoReturnToPool(proj);
        proj.AssignedTeamId   = null;
        proj.AssignedTeamName = null;
        proj.AssignedMembers  = new List<AssignmentBoardTeamMemberDto>();
        proj.IsDraft          = false;

        if (_board is not null)
            _board.HasUnpublishedDrafts = _board.Projects.Any(p => p.AssignedTeamId.HasValue && p.IsDraft);
    }

    private void DemoReturnToPool(AssignmentBoardProjectDto proj)
    {
        if (_board is null || proj.AssignedTeamId is null) return;
        var teamId = proj.AssignedTeamId.Value;
        if (_board.UnassignedTeams.Any(t => t.TeamId == teamId)) return;

        var row = AllTeamRows.FirstOrDefault(r => r.TeamId == teamId);

        _board.UnassignedTeams.Add(new AssignmentBoardTeamDto
        {
            TeamId         = teamId,
            TeamName       = proj.AssignedTeamName ?? row?.TeamName ?? "צוות",
            AcademicYearId = _board.AcademicYearId,
            Members        = proj.AssignedMembers,
            Preferences    = row?.Preferences ?? new List<AssignmentSubmissionPreferenceDto>(),
            TopRecommendations = (row?.Matches ?? new List<TeamProjectMatchDto>()).Take(3).ToList()
        });
    }

    private void DemoPublish()
    {
        if (_board is null) return;
        foreach (var p in _board.Projects) p.IsDraft = false;
        _board.AssignmentsPublished = true;
        _board.HasUnpublishedDrafts = false;
        _board.PublishedAt          = DateTime.Now.ToString("s");
    }

    private string TeamName(int teamId) =>
        AllTeamRows.FirstOrDefault(r => r.TeamId == teamId)?.TeamName
        ?? AllProjects.FirstOrDefault(p => p.AssignedTeamId == teamId)?.AssignedTeamName
        ?? "צוות";

    // ─────────────────────────────────────────────────────────────────────
    //  Formatting
    // ─────────────────────────────────────────────────────────────────────

    private sealed class MoveConfirmState
    {
        public int     TeamId          { get; init; }
        public string  TeamName        { get; init; } = "";
        public string  FromProjectName { get; init; } = "";
        public int     ToProjectId     { get; init; }
        public string  ToProjectName   { get; init; } = "";
        public string? DisplacedTeam   { get; init; }
    }

    private MoveConfirmState? _moveConfirm;

    private static string FormatDate(string raw) =>
        DateTime.TryParse(raw, out var dt) ? dt.IsraelFormat() : raw;

    /// <summary>Same three bands the previous build used (40 / 25), so a score
    /// that read as "high" yesterday still does.</summary>
    private static string ScoreClass(int total) =>
        total >= 40 ? "ap-score--high" :
        total >= 25 ? "ap-score--mid"  :
                      "ap-score--low";

    private static string ProjectTypeLabel(string type) => type switch
    {
        "Technological"  => "טכנולוגי",
        "Methodological" => "מתודולוגי",
        _                => type
    };

    private static string Initials(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "?";
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length == 1
            ? parts[0][..System.Math.Min(2, parts[0].Length)]
            : $"{parts[0][0]}{parts[^1][0]}";
    }
}
