    private async Task AddMentor(AssignmentBoardProjectDto proj, AssignmentBoardMentorDto mentor)
    {
        CloseAllMenus();
        _busyProjectIds.Add(proj.ProjectId);

        try
        {
            if (_demo)
            {
                if (proj.Mentors.Count < MaxMentors) proj.Mentors.Add(mentor);
                Toast("מצב הדגמה — המנחה נוסף בתצוגה בלבד", error: false);
                return;
            }

            var res = await AssignmentManagementService.AssignMentorAsync(proj.ProjectId, mentor.UserId);

            switch (res.Outcome)
            {
                case AssignMentorOutcome.Success:
                    await ReloadAsync("המנחה נוסף לפרויקט");
                    InvalidateRows();
                    break;
                case AssignMentorOutcome.AlreadyAssigned:
                    Toast("המנחה כבר משויך לפרויקט", error: true);
                    break;
                case AssignMentorOutcome.LimitReached:
                    Toast($"מספר המנחים המקסימלי לפרויקט הוא {MaxMentors}", error: true);
                    break;
                case AssignMentorOutcome.NotMentor:
                    Toast("המשתמש שנבחר אינו מנחה פעיל", error: true);
                    break;
                default:
                    Toast("הוספת המנחה נכשלה.", error: true);
                    break;
            }
        }
        finally
        {
            _busyProjectIds.Remove(proj.ProjectId);
        }
    }

    private async Task RemoveMentor(AssignmentBoardProjectDto proj, AssignmentBoardMentorDto mentor)
