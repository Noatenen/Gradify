    /// <summary>Who currently holds a project, or null if it is free. Backed by
    /// a lookup rather than a scan: it is asked once per option per open
    /// surface, and the real board carries over a hundred projects.</summary>
    private string? TeamOnProject(int projectId) =>
        (_holderCache ??= BuildHolders()).TryGetValue(projectId, out var name) ? name : null;

    private Dictionary<int, string>? _holderCache;

    private Dictionary<int, string> BuildHolders() =>
        AllProjects.Where(p => p.AssignedTeamId.HasValue)
                   .ToDictionary(p => p.ProjectId, AssignedTeamLabel);

    // ─────────────────────────────────────────────────────────────────────
    //  Demand — how many teams asked for a project
    // ─────────────────────────────────────────────────────────────────────

    private Dictionary<int, ProjectDemand>? _demandCache;

    private ProjectDemand DemandFor(int projectId) =>
        (_demandCache ??= BuildDemand()).TryGetValue(projectId, out var d) ? d : ProjectDemand.None;

    /// <summary>Counted over the submissions spine, so it describes exactly the
    /// forms this screen is showing. A team is counted once per project however
    /// its form is shaped. See <see cref="ProjectDemand"/> for why this is not
    /// the board's weighted DemandScore.</summary>
    private Dictionary<int, ProjectDemand> BuildDemand()
    {
        var teams = new Dictionary<int, HashSet<int>>();
        var first = new Dictionary<int, HashSet<int>>();

        foreach (var sub in _submissions)
            foreach (var pref in sub.Preferences)
            {
                if (!teams.TryGetValue(pref.ProjectId, out var all))
                    teams[pref.ProjectId] = all = new HashSet<int>();
                all.Add(sub.TeamId);

                if (pref.Priority != 1) continue;
                if (!first.TryGetValue(pref.ProjectId, out var tops))
                    first[pref.ProjectId] = tops = new HashSet<int>();
                tops.Add(sub.TeamId);
            }

        return teams.ToDictionary(
            kv => kv.Key,
            kv => new ProjectDemand(kv.Value.Count,
                                    first.TryGetValue(kv.Key, out var f) ? f.Count : 0));
    }

    /// <summary>A synced project can point at a team id the board's team lookup
    /// does not carry — an Airtable row belonging to another cycle — and the
    /// server then returns <c>AssignedTeamName = null</c> for it. Naming the id
    /// is the honest reading of that state; an empty cell just reads as a broken
    /// page, and inventing a name would be worse than either.</summary>
    private static string AssignedTeamLabel(AssignmentBoardProjectDto p) =>
        !string.IsNullOrWhiteSpace(p.AssignedTeamName) ? p.AssignedTeamName!
        : p.AssignedTeamId.HasValue                    ? $"צוות #{p.AssignedTeamId}"
        :                                                "";

    private IEnumerable<AssignmentBoardMentorDto> AvailableMentorsFor(AssignmentBoardProjectDto proj)
    {
        if (_board is null) return Array.Empty<AssignmentBoardMentorDto>();
        var existing = proj.Mentors.Select(m => m.UserId).ToHashSet();
        return _board.Mentors.Where(m => !existing.Contains(m.UserId));
    }

