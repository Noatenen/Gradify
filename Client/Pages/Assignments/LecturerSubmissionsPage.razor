@*
    ── הגשות ובקרה — Lecturer Submissions & Review (Split Workspace) ─────────────
    Visual source: design/design-system/MotivaLecturerDesign/
                   הגשות מרצה 318.png
                   הגשות ובקרה מרצה 318.pdf

    LAYOUT (RTL split workspace — mirrors Requests page architecture)
    ─────────────────────────────────────────────────────────────────
    RIGHT  — compact submission list panel (sidebar)
             • segmented status control: לבדיקה / הוחזרו לתיקון / טופלו
             • team filter dropdown (כל הצוותים)
             • scrollable submission card list
    LEFT   — large selected-submission details and action workspace

    TAB BUCKETS
    ───────────
      לבדיקה          → pending mentor approval (IPendingMentorApprovalsService.GetPendingAsync)
                         DaysWaiting >= 3 → awaiting lecturer override action
                         DaysWaiting < 3  → still with mentor
      הוחזרו לתיקון   → no current backend endpoint; shows empty state
      טופלו           → approved submissions (ITaskSubmissionsService.GetApprovedAsync)

    ACTIONS (unchanged from previous implementation)
    ────────────────────────────────────────────────
      תזכורת למנחה  → PendingService.RemindMentorAsync(id)
      אישור ההגשה  → PendingService.OverrideApproveAsync(id, reason) — requires reason text
*@
@page "/lecturer/submissions"
@layout AppLayout
@attribute [Authorize(Roles = Roles.Admin + "," + Roles.Staff)]
@namespace AuthWithAdmin.Client.Pages.Assignments
@using Microsoft.AspNetCore.Authorization
@using AuthWithAdmin.Client.Services
@using AuthWithAdmin.Shared.AuthSharedModels
@inject IPendingMentorApprovalsService PendingService
@inject ITaskSubmissionsService SubmissionsService

<div class="lsb-page rqw-page" dir="rtl">

    <!-- ══════════════════════════════════════════════════════════════
         PAGE HEADER
         ══════════════════════════════════════════════════════════════ -->
    <div class="lsb-header rqw-header">

        <h1 class="lsb-h1 rqw-title">הגשות</h1>

    </div>

    @if (_loading)
    {
        <div class="lsb-full-loading" role="status">
            <span class="lsb-spinner" aria-hidden="true"></span>
            <span>טוענת הגשות…</span>
        </div>
    }
    else if (_loadError)
    {
        <MEmptyState Title="אירעה שגיאה בטעינת ההגשות" Description="נסה לרענן את הדף." />
    }
    else
    {
        <!-- ══════════════════════════════════════════════════════════════
             SPLIT WORKSPACE
             RTL flex-row: first child (sidebar) → RIGHT edge
                            second child (main)  → fills remaining LEFT
             ══════════════════════════════════════════════════════════════ -->
        <div class="lsb-split rqw-split">

            <!-- ── SIDEBAR — right panel ─────────────────────────────── -->
            <aside class="lsb-sidebar rqw-sidebar">

                <!-- 1. Segmented status selector -->
                <div class="lsb-seg" role="tablist" aria-label="סינון לפי סטטוס">
                    <button type="button"
                            class="lsb-seg-btn @(_activeTab == "review" ? "lsb-seg-active" : "")"
                            role="tab"
                            aria-selected="@(_activeTab == "review")"
                            @onclick='@(() => SetTab("review"))'>
                        לבדיקה
                        @if (ReviewCount > 0)
                        {
                            <span class="lsb-seg-badge motiva-count">@ReviewCount</span>
                        }
                    </button>
                    <button type="button"
                            class="lsb-seg-btn @(_activeTab == "returned" ? "lsb-seg-active" : "")"
                            role="tab"
                            aria-selected="@(_activeTab == "returned")"
                            @onclick='@(() => SetTab("returned"))'>
                        הוחזרו לתיקון
                    </button>
                    <button type="button"
                            class="lsb-seg-btn @(_activeTab == "done" ? "lsb-seg-active" : "")"
                            role="tab"
                            aria-selected="@(_activeTab == "done")"
                            @onclick='@(() => SetTab("done"))'>
                        טופלו
                    </button>
                </div>

                <!-- 2. Team filter dropdown -->
                <div class="rqw-type-wrap lsb-team-wrap">
                    <button type="button"
                            class="rqw-type-btn @(!string.IsNullOrEmpty(_selectedTeam) ? "rqw-type-btn-active" : "")"
                            aria-label="סינון לפי צוות"
                            @onclick="ToggleTeamMenu">
                        <span class="rqw-type-label-text">צוות</span>
                        <span class="rqw-type-val-text">@(string.IsNullOrEmpty(_selectedTeam) ? "כל הצוותים" : _selectedTeam)</span>
                        <span class="rqw-type-caret @(_teamMenuOpen ? "rqw-type-caret-open" : "")" aria-hidden="true">
                            <svg width="10" height="10" viewBox="0 0 24 24" fill="none"
                                 stroke="currentColor" stroke-width="2.5"
                                 stroke-linecap="round" stroke-linejoin="round">
                                <path d="m6 9 6 6 6-6"/>
                            </svg>
                        </span>
                    </button>

                    @if (_teamMenuOpen)
                    {
                        <div class="rqw-type-backdrop" @onclick="CloseTeamMenu"></div>
                        <div class="rqw-type-panel">
                            <button type="button"
                                    class="rqw-type-opt @(string.IsNullOrEmpty(_selectedTeam) ? "rqw-type-opt-on" : "")"
                                    @onclick='@(() => PickTeam(""))'>
                                <span class="rqw-type-opt-label">כל הצוותים</span>
                                @if (string.IsNullOrEmpty(_selectedTeam))
                                {
                                    <svg class="rqw-type-check" width="12" height="12" viewBox="0 0 24 24" fill="none"
                                         stroke="#6D28F5" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="m5 12.5 4.5 4.5L19 7"/>
                                    </svg>
                                }
                            </button>
                            @foreach (var team in AvailableTeams)
                            {
                                var t = team;
                                var on = _selectedTeam == t;
                                <button type="button"
                                        class="rqw-type-opt @(on ? "rqw-type-opt-on" : "")"
                                        @onclick='@(() => PickTeam(t))'>
                                    <span class="rqw-type-opt-label">@t</span>
                                    @if (on)
                                    {
                                        <svg class="rqw-type-check" width="12" height="12" viewBox="0 0 24 24" fill="none"
                                             stroke="#6D28F5" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="m5 12.5 4.5 4.5L19 7"/>
                                        </svg>
                                    }
                                </button>
                            }
                        </div>
                    }
                </div>

                <!-- 3. Scrollable submission list -->
                <div class="rqw-list">
                    <div class="rqw-list-inner" role="listbox" aria-label="רשימת הגשות">
                        @{
                            var visibleRows = VisibleRows;
                        }
                        @if (visibleRows.Count == 0)
                        {
                            <div class="lsb-list-empty">
                                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                     stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                                    <polyline points="14 2 14 8 20 8"/>
                                    <line x1="16" y1="13" x2="8" y2="13"/>
                                </svg>
                                <span>אין הגשות</span>
                            </div>
                        }
                        else
                        {
                            @foreach (var row in visibleRows)
                            {
                                var r = row;
                                var isSelected = _selectedId == r.SubmissionId;
                                <button type="button"
                                        class="rqw-row @(isSelected ? "rqw-row-selected" : "")"
                                        role="option"
                                        aria-selected="@isSelected"
                                        aria-label="@r.Title"
                                        @onclick='@(() => SelectSubmission(r.SubmissionId))'>

                                    @*  ── HEAD LINE — the title, and the date
                                        opposite it.

                                        THE TITLE LEADS THE ROW NOW. It used to
                                        be the second line, under a head that
                                        carried the milestone tag and a coloured
                                        state phrase — so the first thing the eye
                                        met on every row was a chip, and the
                                        thing being scanned for was underneath
                                        it. The title takes the reading end, is
                                        the only item that flexes (so a long one
                                        ellipses in place), and the date chip is
                                        pinned to the far LEFT on every row
                                        whatever the title's length.

                                        THE MILESTONE TAG IS GONE FROM THE ROW,
                                        not from the screen: `.lsb-ws-type-pill`
                                        in the record header still prints
                                        MilestoneBadge in full, where there is
                                        room for it and where it is read once.
                                        In the queue it was a second, longer
                                        piece of bold text competing with the
                                        title for the same line.

                                        AND NO STATE PHRASE. In לבדיקה every row
                                        is by definition waiting for a review, so
                                        "ממתין לאישורך" restated the tab the
                                        reader had just clicked, in the only
                                        accent colour on the row. The date is
                                        what actually tells two rows apart.  *@
                                    <div class="lsb-row-top">
                                        <span class="lsb-row-title">@r.Title</span>
                                        @if (HasSubmittedDate(r))
                                        {
                                            @*  Unlabelled on purpose. A queue of
                                                submissions has one date worth
                                                putting on a row, and the chip's
                                                own position says which — so
                                                "הוגש" was a word repeated once
                                                per row to say what the list
                                                already means. No chip at all when
                                                there is no date to put in it: an
                                                outlined "—" is a worse answer
                                                than silence.  *@
                                            <span class="lsb-row-date lsb-row-date-@RowDateTone(r)">@r.Submitted</span>
                                        }
                                    </div>
                                    <div class="lsb-row-meta">
                                        @if (!string.IsNullOrWhiteSpace(r.TeamName))
                                        {
                                            <span>@r.TeamName</span>
                                            @if (!string.IsNullOrWhiteSpace(r.ProjectTitle))
                                            {
                                                <span class="lsb-row-meta-sep" aria-hidden="true">·</span>
                                            }
                                        }
                                        @if (!string.IsNullOrWhiteSpace(r.ProjectTitle))
                                        {
                                            <span>@r.ProjectTitle</span>
                                        }
                                    </div>

                                </button>
                            }
                        }
                    </div>
                </div>

            </aside>

            <!-- ── MAIN WORKSPACE — left panel ──────────────────────── -->
            <main class="lsb-main rqw-main">

                @if (_selectedId is null)
                {
                    <!-- No selection — empty state -->
                    <div class="rqw-empty">
                        <div class="rqw-empty-icon" aria-hidden="true">
                            <svg width="40" height="40" viewBox="0 0 24 24" fill="none"
                                 stroke="currentColor" stroke-width="1.3"
                                 stroke-linecap="round" stroke-linejoin="round">
                                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                                <polyline points="14 2 14 8 20 8"/>
                                <line x1="16" y1="13" x2="8" y2="13"/>
                                <line x1="16" y1="17" x2="8" y2="17"/>
                                <polyline points="10 9 9 9 8 9"/>
                            </svg>
                        </div>
                        <p class="rqw-empty-title">בחרו הגשה כדי לצפות בפרטים</p>
                        <p class="rqw-empty-sub">פרטי ההגשה יוצגו כאן לאחר הבחירה</p>
                    </div>
                }
                else
                {
                    var selectedRow = VisibleRows.FirstOrDefault(x => x.SubmissionId == _selectedId)
                                   ?? AllRows.FirstOrDefault(x => x.SubmissionId == _selectedId);
                    var detailKey = $"s{_selectedId}";
                    var detail = _details.TryGetValue(detailKey, out var d) ? d : null;
                    var isLoadingDetail = _loadingDetails.Contains(detailKey);

                    @if (selectedRow is null)
                    {
                        <div class="rqw-empty">
                            <p class="rqw-empty-title">ההגשה לא נמצאה</p>
                        </div>
                    }
                    else
                    {
                        var row = selectedRow;
                        var actionMsg = GetActionMessage(detailKey);
                        var noteVal   = GetNote(detailKey);

                        <div class="rqw-card" id="submission-@row.SubmissionId">

                            @if (isLoadingDetail && detail is null)
                            {
                                <div class="lsb-detail-loading" role="status">
                                    <span class="lsb-spinner" aria-hidden="true"></span>
                                    <span>טוענת פרטי הגשה…</span>
                                </div>
                            }
                            else
                            {
                                @*  ── RECORD HEADER ─────────────────────────
                                    TWO CHILDREN ON ONE ROW, not a stack. The
                                    identity — title and the project / team /
                                    author line — keeps the reading end, the
                                    physical RIGHT under dir=rtl, and the badges
                                    take the opposite corner, the upper LEFT.

                                    The badges used to sit ABOVE the title, which
                                    made this record read as a different object
                                    from the request record beside it in the same
                                    shell. They now come SECOND in the DOM as
                                    well as visually, which is also the order a
                                    screen reader should meet them in.

                                    Flex, not absolute positioning: the badges
                                    stay in flow, so they cannot overlap a long
                                    title, they wrap among themselves at narrow
                                    widths, and the head's height still comes
                                    from its content. Below 720px the row unwraps
                                    back to a stack with the badges first, which
                                    is where they read correctly on one column.

                                    Neither badge is restyled — `.lsb-ws-type-pill`
                                    and `.lsb-ws-wait` keep their exact fill,
                                    radius, size and 10px gap.  *@
                                <div class="lsb-ws-head">
                                    <div class="lsb-ws-ident">
                                        <h2 class="lsb-ws-title">@row.Title</h2>
                                        @*  THE SEPARATOR BELONGS TO THE GAP, NOT
                                            TO THE ITEM AFTER IT. Each item used
                                            to carry its own leading "·", which
                                            is only correct while the item before
                                            it exists. A pending row has no
                                            SubmitterName and, where the team is
                                            unnamed, no TeamName either — so the
                                            line opened with a bare "·" hanging
                                            off the right edge before the project
                                            title. Collecting the parts first and
                                            putting a separator only BETWEEN two
                                            of them is right for every
                                            combination.

                                            THE ORDER IS PROJECT THEN TEAM, and
                                            those two are a GROUP: `teamContextEnd`
                                            marks the last of them that actually
                                            rendered, and the "לצוות" action is
                                            emitted straight after it. That is the
                                            whole point of moving it — the action
                                            opens the team's workspace, so it
                                            belongs against the words that name
                                            the team, not adrift among the file
                                            links two rows below. When the team
                                            has no name of its own the project is
                                            the last of the group and the action
                                            attaches there, which is the same
                                            fallback the request queue's identity
                                            uses.  *@
                                        @{
                                            var identParts = new List<(string Css, string Text)>();
                                            if (!string.IsNullOrWhiteSpace(row.SubmitterName))
                                                identParts.Add(("lsb-meta-submitter", row.SubmitterName));
                                            if (!string.IsNullOrWhiteSpace(row.ProjectTitle))
                                                identParts.Add(("lsb-meta-project", row.ProjectTitle));
                                            if (!string.IsNullOrWhiteSpace(row.TeamName))
                                                identParts.Add(("lsb-meta-team", row.TeamName));

                                            // The last item that names the team context — where the
                                            // action hangs. -1 when neither rendered, so it never fires.
                                            var teamContextEnd = identParts.Count - 1;
                                            if (string.IsNullOrWhiteSpace(row.ProjectTitle)
                                                && string.IsNullOrWhiteSpace(row.TeamName))
                                                teamContextEnd = -1;

                                            if (!string.IsNullOrWhiteSpace(row.MentorName))
                                                identParts.Add(("lsb-meta-mentor", $"מנחה: {row.MentorName}"));
                                        }
                                        <p class="lsb-ws-submeta">
                                            @for (var i = 0; i < identParts.Count; i++)
                                            {
                                                if (i > 0)
                                                {
                                                    <span class="lsb-meta-sep" aria-hidden="true">·</span>
                                                }
                                                <span class="@identParts[i].Css">@identParts[i].Text</span>

                                                @*  THE TEAM'S WORKSPACE — /projects/{id}/overview.

                                                    NOT /projects/{id}, which is what this action used
                                                    to point at and which is not a route: the router
                                                    knows /projects (הצוותים שלי) and
                                                    /projects/{ProjectId:int}/overview, and nothing in
                                                    between, so every click 404'd on NotFoundPage.
                                                    /overview is the destination הצוותים שלי, the
                                                    lecturer dashboard, the calendar and the milestones
                                                    overview all already use for exactly this — "open
                                                    this team's project".

                                                    ProjectId is what the route takes and what the row
                                                    already carries, so no team id had to be resolved
                                                    and no DTO changed.  *@
                                                if (i == teamContextEnd && row.ProjectId > 0)
                                                {
                                                    <a class="lsb-team-link"
                                                       href="@($"/projects/{row.ProjectId}/overview")"
                                                       aria-label="@($"מעבר למרחב הפרויקט של {(string.IsNullOrWhiteSpace(row.TeamName) ? row.ProjectTitle : row.TeamName)}")">
                                                        <span>לצוות</span>
                                                        <svg width="10" height="10" viewBox="0 0 24 24" fill="none"
                                                             stroke="currentColor" stroke-width="2.6"
                                                             stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                                            <path d="M15 6l-6 6 6 6"/>
                                                        </svg>
                                                    </a>
                                                }
                                            }
                                        </p>
                                    </div>
                                    <div class="lsb-ws-badges">
                                        <span class="lsb-ws-type-pill">@row.MilestoneBadge</span>
                                        <span class="lsb-ws-wait lsb-ws-wait-@row.TimeClass">@row.TimeLabel</span>
                                    </div>
                                </div>

                                <!-- ── WORKSPACE BODY ── -->
                                <div class="lsb-ws-body">

                                    <!-- Dates block -->
                                    <div class="lsb-ws-section">
                                        <div class="lsb-dates-row">
                                            <div class="lsb-dates-inner">
                                                <span class="lsb-date-col">
                                                    <span class="lsb-date-val">@row.Submitted</span>
                                                    <span class="lsb-date-lbl">הוגש</span>
                                                </span>
                                                @if (row.CanDecide && row.DaysWaiting > 0)
                                                {
                                                    <span class="lsb-date-sep"></span>
                                                    <span class="lsb-date-col">
                                                        <span class="lsb-date-val lsb-date-val-waiting">@row.DaysWaiting ימים</span>
                                                        <span class="lsb-date-lbl">ממתין לאישור</span>
                                                    </span>
                                                }
                                            </div>

                                            @{
                                                var studentFile = detail?.Files?.FirstOrDefault(f => !f.IsLecturerFeedback);
                                                var driveUrl    = detail?.DriveUrl?.Trim();
                                            }
                                            @if (studentFile is not null)
                                            {
                                                <a href="/submissions/@studentFile.StoredFileName"
                                                   target="_blank"
                                                   class="lsb-file-link">
                                                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                                         stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                                        <path d="M20 11.5 12 19.5a4.5 4.5 0 0 1-6.4-6.4l7.6-7.6a3 3 0 0 1 4.3 4.3l-7.6 7.6a1.5 1.5 0 0 1-2.2-2.2l7-7"/>
                                                    </svg>
                                                    @studentFile.OriginalFileName
                                                </a>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(driveUrl))
                                            {
                                                <a href="@driveUrl" target="_blank" rel="noopener noreferrer" class="lsb-file-link">
                                                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                                         stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                                        <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
                                                        <polyline points="15 3 21 3 21 9"/>
                                                        <line x1="10" y1="14" x2="21" y2="3"/>
                                                    </svg>
                                                    פתיחת הקישור
                                                </a>
                                            }
                                            @*  "לצוות" USED TO BE HERE, and pointed at
                                                /projects/{id} — a route that does not
                                                exist. It now lives against the team's own
                                                name in the identity line above, and points
                                                at /projects/{id}/overview. It is not
                                                duplicated: this is the only other place it
                                                was, and it is gone from it.  *@
                                        </div>
                                    </div>

                                    <!-- Notes / description -->
                                    @if (!string.IsNullOrWhiteSpace(detail?.Notes))
                                    {
                                        <div class="lsb-ws-section">
                                            <p class="lsb-ws-section-label">הערות הסטודנט</p>
                                            <p class="lsb-desc">@detail.Notes</p>
                                        </div>
                                    }

                                    <!-- Mentor feedback -->
                                    @{
                                        var mentorFeedback = detail?.MentorFeedback;
                                        var mentorName     = detail?.MentorName ?? row.MentorName;
                                    }
                                    @if (!string.IsNullOrWhiteSpace(mentorFeedback))
                                    {
                                        <div class="lsb-feedback-block">
                                            <p class="lsb-feedback-by">משוב המנחה · @mentorName</p>
                                            <p class="lsb-feedback-text">"@mentorFeedback"</p>
                                        </div>
                                    }

                                    <!-- Approved status display -->
                                    @if (_activeTab == "done" || (!row.CanDecide && _activeTab != "returned"))
                                    {
                                        @if (row.IsDone)
                                        {
                                            <div class="lsb-decision-done">
                                                <span class="lsb-decision-done-label">סטטוס:</span>
                                                <span class="lsb-decision-done-val">@row.StateLine</span>
                                                @if (!string.IsNullOrWhiteSpace(row.ApprovalSourceLabel))
                                                {
                                                    <span class="lsb-decision-done-src">@row.ApprovalSourceLabel</span>
                                                }
                                            </div>
                                        }
                                        else if (!row.CanDecide)
                                        {
                                            <div class="lsb-decision-waiting">
                                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                                     stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                                    <circle cx="12" cy="12" r="10"/>
                                                    <path d="M12 6v6l4 2"/>
                                                </svg>
                                                <span>@row.StateLine</span>
                                            </div>
                                        }
                                    }

                                    <!-- Decision row — only for items where DaysWaiting >= 3 -->
                                    @if (row.CanDecide)
                                    {
                                        var isBusy = _busyKeys.Contains(detailKey);

                                        <div class="lsb-decision-row">
                                            <button class="lsb-btn-outline"
                                                    disabled="@isBusy"
                                                    @onclick="() => RemindMentor(row)">
                                                תזכורת למנחה
                                            </button>
                                            <input class="lsb-note-input"
                                                   placeholder="סיבת האישור החריג (חובה)"
                                                   value="@noteVal"
                                                   @oninput="e => SetNote(detailKey, e.Value?.ToString() ?? string.Empty)" />
                                            <button class="lsb-btn-approve"
                                                    disabled="@IsApproveDisabled(detailKey)"
                                                    @onclick="() => OverrideApprove(row)">
                                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none"
                                                     stroke="currentColor" stroke-width="2.6"
                                                     stroke-linecap="round" stroke-linejoin="round">
                                                    <path d="m5 12.5 4.5 4.5L19 7"/>
                                                </svg>
                                                אישור ההגשה
                                            </button>
                                        </div>
                                        @if (!string.IsNullOrWhiteSpace(actionMsg))
                                        {
                                            <p class="@ActionMsgClass(detailKey)">@actionMsg</p>
                                        }
                                    }

                                    <!-- Submission version history -->
                                    @if (detail?.SubmissionHistory?.Count > 1)
                                    {
                                        var histOpen = _historyOpen.Contains(row.SubmissionId);
                                        <div class="lsb-hist-bar">
                                            <button type="button"
                                                    class="lsb-hist-btn"
                                                    aria-expanded="@(histOpen ? "true" : "false")"
                                                    @onclick='@(() => ToggleHistory(row.SubmissionId))'>
                                                <span>גרסאות · @detail.SubmissionHistory.Count @(detail.SubmissionHistory.Count == 1 ? "הגשה" : "הגשות")</span>
                                                <span class="lsb-hist-caret @(histOpen ? "lsb-hist-caret-open" : "")" aria-hidden="true">
                                                    <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                                         stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                                        <path d="m6 9 6 6 6-6"/>
                                                    </svg>
                                                </span>
                                            </button>
                                        </div>
                                        @if (histOpen)
                                        {
                                            <div class="lsb-hist-items">
                                                @foreach (var h in detail.SubmissionHistory)
                                                {
                                                    <div class="lsb-hist-item">
                                                        <span class="lsb-hist-dot" aria-hidden="true"></span>
                                                        <div class="lsb-hist-content">
                                                            <p class="lsb-hist-text">@h.SubmittedAt.ToString("dd.MM.yyyy · HH:mm")</p>
                                                            @if (!string.IsNullOrWhiteSpace(h.Notes))
                                                            {
                                                                <p class="lsb-hist-note">@h.Notes</p>
                                                            }
                                                        </div>
                                                    </div>
                                                }
                                            </div>
                                        }
                                    }

                                </div>@* lsb-ws-body *@
                            }

                        </div>@* rqw-card *@
                    }
                }

            </main>

        </div>@* rqw-split *@
    }

</div>@* lsb-page *@

@code {
    // ── State ─────────────────────────────────────────────────────────────────

    private string _activeTab    = "review";  // "review" | "returned" | "done"
    private int?   _selectedId;
    private string _selectedTeam = "";
    private bool   _teamMenuOpen;
    private bool   _loading  = true;
    private bool   _loadError;

    private List<PendingMentorApprovalRowDto> _pending  = new();
    private List<ApprovedSubmissionRowDto>   _approved = new();

    private readonly Dictionary<string, LecturerSubmissionDetailDto?> _details       = new();
    private readonly HashSet<string>                                    _loadingDetails = new();

    private readonly Dictionary<string, string>  _notes          = new();
    private readonly Dictionary<string, string>  _actionMessages = new();
    private readonly HashSet<string>             _actionErrors   = new();
    private readonly HashSet<string>             _busyKeys       = new();
    private readonly HashSet<int>                _historyOpen    = new();

    // ── Computed counts ────────────────────────────────────────────────────────
    // When a team is selected, each tab shows only that team's items.
    // When "כל הצוותים" is active, global totals are shown.
    // The selected STATUS tab never affects the other tabs' numbers.

    private int ReviewCount => string.IsNullOrEmpty(_selectedTeam)
        ? _pending.Count
        : _pending.Count(r => (r.TeamName ?? string.Empty) == _selectedTeam);

    private int DoneCount => string.IsNullOrEmpty(_selectedTeam)
        ? _approved.Count
        : _approved.Count(r => (r.TeamName ?? string.Empty) == _selectedTeam);

    // ── Row model ─────────────────────────────────────────────────────────────

    private record RowModel(
        int    SubmissionId,
        string Title,
        string MilestoneBadge,
        string TeamName,
        string ProjectTitle,
        string ProjectId_str,
        int    ProjectId,
        string SubmitterName,
        string MentorName,
        string Submitted,
        /// <summary>The raw timestamp behind <c>Submitted</c>, kept so the row
        /// can age itself. <c>Submitted</c> is already formatted for display and
        /// cannot be measured.</summary>
        DateTime SubmittedAt,
        string TimeLabel,
        string TimeClass,
        string StateLine,
        bool   CanDecide,
        bool   IsDone,
        int    DaysWaiting,
        string ApprovalSourceLabel
    );

    // ── Data mapping ──────────────────────────────────────────────────────────

    private IReadOnlyList<RowModel> AllRows =>
        _pending.Select(ToPendingRowModel)
            .Concat(_approved.Select(ToApprovedRowModel))
            .ToList();

    private RowModel ToPendingRowModel(PendingMentorApprovalRowDto r)
    {
        bool canDecide = r.DaysWaiting >= PendingMentorApprovals.LecturerActionThresholdDays;
        var submitted  = r.SubmittedAt != default ? r.SubmittedAt.ToString("dd.MM") : "—";
        string timeLabel, timeClass, stateLine;

        if (canDecide)
        {
            timeLabel  = "ממתין לאישורך";
            timeClass  = "attention";
            stateLine  = $"נבדק ע\"י המנחה · ממתין לאישורך ({r.DaysWaiting} ימים)";
        }
        else
        {
            timeLabel  = $"הוגש {submitted}";
            timeClass  = "mentor";
            stateLine  = "בבדיקת המנחה";
        }

        return new RowModel(
            SubmissionId:       r.SubmissionId,
            Title:              r.TaskTitle,
            MilestoneBadge:     string.IsNullOrWhiteSpace(r.MilestoneTitle) ? "הגשת משימה" : r.MilestoneTitle,
            TeamName:           r.TeamName ?? string.Empty,
            ProjectTitle:       r.ProjectTitle,
            ProjectId_str:      r.ProjectId.ToString(),
            ProjectId:          r.ProjectId,
            SubmitterName:      string.Empty,
            MentorName:         r.MentorName ?? string.Empty,
            Submitted:          submitted,
            SubmittedAt:        r.SubmittedAt,
            TimeLabel:          timeLabel,
            TimeClass:          timeClass,
            StateLine:          stateLine,
            CanDecide:          canDecide,
            IsDone:             false,
            DaysWaiting:        r.DaysWaiting,
            ApprovalSourceLabel: string.Empty
        );
    }

    private RowModel ToApprovedRowModel(ApprovedSubmissionRowDto r)
    {
        bool isOverride = string.Equals(r.ApprovalSource,
            ApprovalSources.LecturerOverride, StringComparison.Ordinal);
        var submitted  = r.SubmittedAt != default  ? r.SubmittedAt.ToString("dd.MM")  : "—";
        var approvedOn = r.ApprovedAt.HasValue      ? r.ApprovedAt.Value.ToString("dd.MM") : "—";
        var srcLabel   = isOverride ? "אושר ע\"י מרצה" : "אושר ע\"י מנחה";

        return new RowModel(
            SubmissionId:       r.SubmissionId,
            Title:              r.TaskTitle,
            MilestoneBadge:     string.IsNullOrWhiteSpace(r.MilestoneTitle) ? "הגשת משימה" : r.MilestoneTitle,
            TeamName:           r.TeamName ?? string.Empty,
            ProjectTitle:       r.ProjectTitle,
            ProjectId_str:      r.ProjectId.ToString(),
            ProjectId:          r.ProjectId,
            SubmitterName:      string.Empty,
            MentorName:         r.MentorName ?? string.Empty,
            Submitted:          submitted,
            SubmittedAt:        r.SubmittedAt,
            TimeLabel:          $"טופל · {approvedOn}",
            TimeClass:          "done",
            StateLine:          srcLabel,
            CanDecide:          false,
            IsDone:             true,
            DaysWaiting:        0,
            ApprovalSourceLabel: srcLabel
        );
    }

    // ── Row presentation ──────────────────────────────────────────────────────

    /// <summary>
    /// Whether the row has a real date to put in its chip.
    ///
    /// <para><c>Submitted</c> is preformatted by the two row mappers and falls
    /// back to this file's own "—" placeholder when <c>SubmittedAt</c> is
    /// default. That placeholder is right inside the record's dates block,
    /// which is a labelled field and has to show SOMETHING; inside a bordered
    /// chip on a queue row it is a box drawn around nothing. The chip is simply
    /// not rendered in that case.</para>
    /// </summary>
    private static bool HasSubmittedDate(RowModel r) =>
        !string.IsNullOrWhiteSpace(r.Submitted) && r.Submitted != "—";

    /// <summary>
    /// How long a submission may sit unreviewed before its date stops being
    /// metadata and starts being a problem.
    ///
    /// <para>SEPARATE FROM <see cref="PendingMentorApprovals.LecturerActionThresholdDays"/>
    /// (3 days) on purpose, and not a redefinition of it. That threshold answers
    /// "may the lecturer act on this yet" — it unlocks the remind / override
    /// controls and decides <c>CanDecide</c>. This one answers "has this been
    /// waiting too long", which is a louder question with a later answer. Both
    /// are read from the same date and neither is derived from the other.</para>
    /// </summary>
    private const int StaleAfterDays = 7;

    /// <summary>
    /// The date chip's tone — the whole of the age signal, with no words added.
    ///
    /// <para>THREE STATES, TWO OF WHICH EVER SHARE A LIST.</para>
    /// <list type="bullet">
    /// <item><b>fresh</b> — the informational tag every other chip in the
    /// product wears: white paper under the Motiva gradient edge
    /// (<c>--motiva-tag-brand-surface</c>).</item>
    /// <item><b>overdue</b> — rose, the system's one "this needs a person now"
    /// treatment (<c>--motiva-color-danger-bg</c> / <c>--motiva-color-rose-ink</c>),
    /// and the same ink the overdue pills elsewhere use. Never invented here.
    /// </item>
    /// <item><b>neutral</b> — the quiet outlined chip, for a row where the age
    /// means nothing.</item>
    /// </list>
    ///
    /// <para><b>Only while it is still pending.</b> The age rule is gated on
    /// <c>!IsDone</c>, so a submission approved months after it was handed in
    /// does not sit in טופלו wearing rose for a wait that is over. That is the
    /// whole reason this reads <c>IsDone</c> rather than the active tab: it is a
    /// fact about the submission, not about which filter is selected.</para>
    ///
    /// <para>PRESENTATION ONLY — nothing here filters, counts, or decides
    /// anything. <c>CanDecide</c>, <c>DaysWaiting</c> and every bucket are
    /// untouched.</para>
    /// </summary>
    private static string RowDateTone(RowModel r) =>
        r.IsDone                              ? "neutral"
      : SubmissionAgeDays(r) > StaleAfterDays ? "overdue"
      :                                         "fresh";

    /// <summary>
    /// The submission's age in ISRAEL CALENDAR DAYS, measured now.
    ///
    /// <para><b>Calendar days, not elapsed 24-hour periods, and Israel's
    /// calendar.</b> That is the product's existing convention for every
    /// "how long has this been waiting" question, and it is the one a reader
    /// checks against: something handed in late Monday night is one day old on
    /// Tuesday morning, not zero. <c>AsIsrael()</c> is the shared helper that
    /// does the UTC→Asia/Jerusalem conversion — server timestamps arrive as
    /// SQLite <c>datetime('now')</c>, i.e. UTC with an Unspecified Kind.</para>
    ///
    /// <para><b>Why not the DTO's own <c>DaysWaiting</c>.</b> The server
    /// computes it as <c>CAST(julianday('now') - julianday(SubmittedAt))</c> —
    /// whole 24-hour periods in UTC, which is a different measurement and drifts
    /// from a calendar day by up to the Israel offset. It also exists only on
    /// the pending DTO. It stays exactly as it is and still drives
    /// <c>CanDecide</c>; this is a second reading of the same date for a
    /// different question, not a replacement for it.</para>
    /// </summary>
    private static int SubmissionAgeDays(RowModel r) =>
        r.SubmittedAt == default
            ? 0
            : (DateTime.UtcNow.AsIsrael().Date - r.SubmittedAt.AsIsrael().Date).Days;

    // ── Visible rows (sidebar list) ───────────────────────────────────────────

    private List<RowModel> VisibleRows
    {
        get
        {
            IEnumerable<RowModel> source = _activeTab switch
            {
                "review"   => _pending.Select(ToPendingRowModel),
                "returned" => Enumerable.Empty<RowModel>(),
                "done"     => _approved.Select(ToApprovedRowModel),
                _          => AllRows,
            };

            if (!string.IsNullOrEmpty(_selectedTeam))
                source = source.Where(r => r.TeamName == _selectedTeam);

            return source.ToList();
        }
    }

    // ── Available teams for filter ────────────────────────────────────────────

    private List<string> AvailableTeams
    {
        get
        {
            var teams = _pending.Select(r => r.TeamName ?? string.Empty)
                .Concat(_approved.Select(r => r.TeamName ?? string.Empty))
                .Where(t => !string.IsNullOrWhiteSpace(t))
                .Distinct()
                .OrderBy(t => t)
                .ToList();
            return teams;
        }
    }

    // ── Lifecycle ─────────────────────────────────────────────────────────────

    protected override async Task OnInitializedAsync()
    {
        var pending  = await PendingService.GetPendingAsync();
        var approved = await SubmissionsService.GetApprovedAsync();

        if (pending is null)
            _loadError = true;
        else
            _pending = pending;

        _approved = approved ?? new();
        _loading  = false;
    }

    // ── Select submission ─────────────────────────────────────────────────────

    private async Task SelectSubmission(int id)
    {
        if (_selectedId == id)
        {
            _selectedId = null;
            return;
        }
        _selectedId = id;

        var key = $"s{id}";
        if (!_details.ContainsKey(key) && !_loadingDetails.Contains(key))
        {
            _loadingDetails.Add(key);
            StateHasChanged();
            var detail = await SubmissionsService.GetLecturerDetailAsync(id);
            _details[key] = detail;
            _loadingDetails.Remove(key);
        }
    }

    // ── Tab / team filter ─────────────────────────────────────────────────────

    private void SetTab(string tab)
    {
        _activeTab   = tab;
        _selectedId  = null;
    }

    private void ToggleTeamMenu() => _teamMenuOpen = !_teamMenuOpen;
    private void CloseTeamMenu()  => _teamMenuOpen = false;

    private void PickTeam(string team)
    {
        _selectedTeam  = team;
        _teamMenuOpen  = false;
        _selectedId    = null;
    }

    // ── Note helpers ──────────────────────────────────────────────────────────

    private string GetNote(string key) =>
        _notes.TryGetValue(key, out var n) ? n : string.Empty;

    private void SetNote(string key, string value)
    {
        if (string.IsNullOrEmpty(value)) _notes.Remove(key);
        else _notes[key] = value;
    }

    private bool IsApproveDisabled(string key) =>
        _busyKeys.Contains(key) || string.IsNullOrWhiteSpace(GetNote(key));

    private string? GetActionMessage(string key) =>
        _actionMessages.TryGetValue(key, out var m) ? m : null;

    private string ActionMsgClass(string key) =>
        "lsb-row-msg " + (_actionErrors.Contains(key) ? "lsb-row-msg-error" : "lsb-row-msg-ok");

    // ── History toggle ────────────────────────────────────────────────────────

    private void ToggleHistory(int id)
    {
        if (!_historyOpen.Remove(id))
            _historyOpen.Add(id);
    }

    // ── Remind mentor ─────────────────────────────────────────────────────────

    private async Task RemindMentor(RowModel row)
    {
        var key = $"s{row.SubmissionId}";
        _busyKeys.Add(key);
        var err = await PendingService.RemindMentorAsync(row.SubmissionId);
        _busyKeys.Remove(key);
        if (err is null)
        {
            _actionMessages[key] = "תזכורת נשלחה למנחה";
            _actionErrors.Remove(key);
        }
        else
        {
            _actionMessages[key] = err;
            _actionErrors.Add(key);
        }
    }

    // ── Override approve ──────────────────────────────────────────────────────

    private async Task OverrideApprove(RowModel row)
    {
        var key    = $"s{row.SubmissionId}";
        var reason = GetNote(key);
        if (string.IsNullOrWhiteSpace(reason)) return;

        _busyKeys.Add(key);
        var err = await PendingService.OverrideApproveAsync(row.SubmissionId, reason);
        _busyKeys.Remove(key);

        if (err is null)
        {
            _pending     = _pending.Where(r => r.SubmissionId != row.SubmissionId).ToList();
            _selectedId  = null;
            _actionMessages.Remove(key);
            _actionErrors.Remove(key);
            _notes.Remove(key);

            var freshApproved = await SubmissionsService.GetApprovedAsync();
            if (freshApproved is not null) _approved = freshApproved;
        }
        else
        {
            _actionMessages[key] = err;
            _actionErrors.Add(key);
        }
    }
}