@*
    ── Lecturer Home (Dashboard) ────────────────────────────────────────────
    Visual source: design/design-system/MotivaLecturerDesign/
                   Motiva Lecturer Home.dc (1).html
                   design/design-system/MotivaLecturerDesign/דשבורד מרצה 268.pdf
    Data source:   IDashboardOverviewService.GetAsync("lecturer")
                   → DashboardOverviewDto

    LAYOUT
      Big H1 greeting + subtitle + status pills row
      Two-column grid (1.75fr main | 1fr side):
        Main: "דורש את תשומת לבך" attention card + "צוותים שדורשים תשומת לב" teams card
        Side: "בקרוב" upcoming events card
      Attention rows have a coloured vertical accent bar and open a popup modal.
      Popup overlays the entire page; backdrop click closes it.
*@
@page "/dashboard/lecturer"
@layout AppLayout
@attribute [Authorize(Roles = Roles.Admin + "," + Roles.Staff + "," + Roles.Mentor)]
@using AuthWithAdmin.Client.Services
@using AuthWithAdmin.Shared.AuthSharedModels
@inject NavigationManager Nav
@inject IDashboardOverviewService DashboardService
@inject IPersonalTasksService PersonalTasks
@inject IProjectRequestsService RequestsService
@inject IPendingMentorApprovalsService ApprovalsService

<div class="ldh-page" dir="rtl">

    @* ── Title row ──
         MPageHeader, the same component and the same variant the student
         dashboard's greeting renders through — so the h1's size, weight,
         tracking, its 10px step down to the subtitle and the subtitle's own
         muted treatment all come from `.motiva-final .m-page-header` rather
         than from a hand-typed 38px/700/#1B1A22 block that happened to agree
         with it. The greeting and the subtitle are the lecturer's own
         strings, computed exactly as before. *@
    <MPageHeader Variant="MPageHeader.HeaderVariant.Hero"
                 Class="ldh-header"
                 Title="@_greeting">
        <SubtitleContent>@_subtitle</SubtitleContent>
    </MPageHeader>

    @* ── Status pills ──
         The four counts are unchanged. What changed is that their dots no
         longer carry four inline hex values: they read the Master's closed
         semantic set through tone classes, which is the same discipline
         MStatusDot enforces everywhere else in the product.

         AND ROSE IS NOW EARNED. All four pills used to be equally coloured,
         so "7 צוותים פעילים" shouted as loudly as "4 צוותים דורשים תשומת לב"
         and the one pill that reports a risk had no way to stand out. Census
         counts are calm; only the attention count is rose. Same numbers, same
         order, same labels. *@
    @if (!_loading && _data is not null)
    {
        <div class="ldh-pills">
            <span class="ldh-pill">
                <span class="ldh-pill-dot ldh-dot-teal" aria-hidden="true"></span>
                @_data.Summary.TotalProjects צוותים פעילים
            </span>
            <span class="ldh-pill">
                <span class="ldh-pill-dot ldh-dot-violet" aria-hidden="true"></span>
                @_data.Summary.OpenRequests בקשות להחלטתך
            </span>
            <span class="ldh-pill">
                <span class="ldh-pill-dot ldh-dot-violet" aria-hidden="true"></span>
                @_data.Summary.SubmissionsMissing הגשות לאישורך
            </span>
            <span class="ldh-pill">
                <span class="ldh-pill-dot ldh-dot-rose" aria-hidden="true"></span>
                @(_data.Charts.HealthAtRisk + _data.Charts.HealthAttention) צוותים דורשים תשומת לב
            </span>
        </div>
    }

    @* ── Loading / error ──
         The shared primitives. The design allows one spinner and one empty
         state; this page authored a second of each. *@
    @if (_loading)
    {
        <MLoadingState Label="טוענת נתונים…" />
    }
    else if (_loadError || _data is null)
    {
        <MEmptyState Title="שגיאה בטעינת הדשבורד"
                     Description="ייתכן שיש תקלת רשת זמנית. אפשר לנסות לרענן את הדף." />
    }
    else
    {
        @* ── Two-column grid ── *@
        <div class="ldh-grid">

            @* ── Main column ── *@
            <div class="ldh-main-col">

                @* ── Attention card ──
                     THE PAGE'S ONE LIFTED CARD, which is the student dashboard's
                     rule: every other surface is quiet and exactly one carries
                     the emphasis, given to the card that answers "what needs me
                     now". Same job דורש תשומת לב does over there.

                     Rows are MRow inside MRowList — the same list object the
                     student's request, deadline and team cards use — so the
                     hairline floor, the ink-moves-on-hover and the 15/700 over
                     13/500 type pair are the component's, not this page's.

                     THE 5px RED BAR IS GONE, and that is a semantic fix rather
                     than a cosmetic one: it was painted #E0335F on EVERY row,
                     including a routine request awaiting a decision, so the
                     page's only alarm colour marked the presence of a row
                     rather than a problem. The signal is now the leading
                     MStatusDot in the item's own tone — violet for work in
                     flight, rose for the submissions that are genuinely
                     escalated — which is one signal where it means something.

                     The chevron went with it: an MRow rendered with OnClick is
                     a real <button>, so it is focusable and Enter/Space
                     activate it natively. That is also why the page no longer
                     hand-rolls a keydown handler. Nothing about what a row
                     opens, or which items reach this list, changed. *@
                <MCard Padding="MCard.CardPadding.None"
                       Class="ldh-card-strong ldh-attention-card"
                       Fill="true">
                    <div class="sd-head">
                        <span class="sd-head-icon motiva-ico-gradient" aria-hidden="true">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="url(#motivaIconGradient)"
                                 stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z"></path>
                                <path d="M12 9v4M12 17h.01"></path>
                            </svg>
                        </span>
                        <h2 class="sd-head-title ldh-attention-title">בקשות שממתינות לתגובתך</h2>
                        <a class="sd-head-link" href="/management/requests">לכל הבקשות</a>
                    </div>

                    @if (AttentionItems.Count == 0)
                    {
                        <MEmptyState Title="אין בקשות ממתינות."
                                     Description="כל הבקשות טופלו — אין בקשות הממתינות להחלטתך כרגע." />
                    }
                    else
                    {
                        <MRowList Class="ldh-att-list" AriaLabel="בקשות שממתינות לתגובתך">
                            @foreach (var item in AttentionItems.Take(4))
                            {
                                var captured = item;
                                var waitDays = (DateTime.Today - captured.RequestRow!.CreatedAt.Date).Days;
                                <MRow Class="ldh-att-row"
                                      Primary="@captured.Title"
                                      Secondary="@captured.Desc"
                                      OnClick="@(async () => await OpenPopup(captured))"
                                      AriaLabel="@($"{captured.Title} — הצגת פרטים")">
                                    <Trailing>
                                        <span class="ldh-att-wait-pill">ממתין @waitDays ימים</span>
                                    </Trailing>
                                </MRow>
                            }
                        </MRowList>
                    }
                </MCard>

                @* ── Teams card ──
                     The student dashboard's quiet card, its head grammar
                     (glyph · title · link at the reading end) and its row
                     list. The four hand-laid flex tracks are MRow's own
                     Leading / Primary / Secondary / Meta slots, which is what
                     puts this row and a student's team row on one set of type
                     steps instead of two that happened to be within half a
                     pixel of each other.

                     THE DOT WAS ALWAYS #E0335F HERE TOO, for a bucket that
                     holds AtRisk and Attention alike. It now carries the
                     project's actual bucket — rose for at-risk, violet for
                     needs-watching — and the reason line, which was inline-
                     coloured, becomes MRow's Meta in the matching tone. Which
                     projects appear, their order, their cap and where a row
                     navigates are untouched. *@
                @if (TeamItems.Count > 0)
                {
                    <MCard Padding="MCard.CardPadding.None"
                           Class="ldh-teams-card"
                           Fill="true">
                        <div class="sd-head">
                            <span class="sd-head-icon motiva-ico-gradient" aria-hidden="true">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="url(#motivaIconGradient)"
                                     stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
                                    <circle cx="9" cy="7" r="4"></circle>
                                    <path d="M22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"></path>
                                </svg>
                            </span>
                            <h2 class="sd-head-title">צוותים שדורשים תשומת לב</h2>
                            <a class="sd-head-link" href="/projects">לכל הצוותים</a>
                        </div>

                        <MRowList Class="ldh-team-list" AriaLabel="צוותים שדורשים תשומת לב">
                            @foreach (var t in TeamItems)
                            {
                                <MRow Class="ldh-team-row"
                                      Primary="@t.TeamName"
                                      Secondary="@t.Mentor"
                                      Meta="@t.Reason"
                                      MetaTone="@t.MetaTone"
                                      Href="@($"/projects?open={t.ProjectId}")"
                                      AriaLabel="@($"פתח פרטי {t.TeamName} — {t.Reason}")">
                                    <Leading>
                                        <MStatusDot Tone="@t.Tone" />
                                    </Leading>
                                </MRow>
                            }
                        </MRowList>
                    </MCard>
                }

            </div>

            @* ── Side column ── *@
            <div class="ldh-side-col">
                @* ── בקרוב — FUTURE ONLY ──────────────────────────────────────
                     The list is filtered to dates on or after today and sorted
                     ascending in UpcomingItems below; nothing here hides a row
                     it was given. *@
                @* ────────────────────────────────────────────────────────────
                   Tile pattern transcribed from MentorHomePage: a 46px date block
                   per entry with the urgency carried as a 2.5px inset top bar.
                   The KindClass sets --ldh-kind so the tile bar matches item type. *@
                <MCard Padding="MCard.CardPadding.None"
                       Class="ldh-upcoming-card"
                       Fill="true">
                    @* The tile list below is the mentor dashboard's own
                       בקרוב pattern and is deliberately left as it is — it
                       is already shared with MentorHomePage through
                       css/lecturer-dashboard.css. Only the card shell and
                       the head move onto the student's grammar. *@
                    <div class="sd-head">
                        <span class="sd-head-icon motiva-ico-gradient" aria-hidden="true">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="url(#motivaIconGradient)"
                                 stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <rect x="3" y="4" width="18" height="18" rx="3"></rect>
                                <path d="M16 2v4M8 2v4M3 10h18"></path>
                            </svg>
                        </span>
                        <h2 class="sd-head-title" id="ldh-up-h">בקרוב</h2>
                        <a class="sd-head-link" href="/lecturer/calendar">ליומן המלא</a>
                    </div>

                    @if (!UpcomingItems.Any())
                    {
                        <MEmptyState Title="אין מועדים קרובים"
                                     Description="מועדי אבני דרך ותזכורות אישיות יופיעו כאן." />
                    }
                    else
                    {
                        <div class="ldh-up-list">
                            @foreach (var u in UpcomingItems)
                            {
                                <a class="ldh-up-row @u.KindClass" href="@u.Href">
                                    <span class="ldh-up-tile">
                                        <span class="ldh-up-day">@u.Date.Day.ToString("00")</span>
                                        <span class="ldh-up-month">@MotivaDates.ShortMonth(u.Date)</span>
                                    </span>
                                    <span class="ldh-up-body">
                                        <span class="ldh-up-title" title="@u.Label">@u.Label</span>
                                        <span class="ldh-up-meta">@u.When</span>
                                    </span>
                                </a>
                            }
                        </div>
                    }
                </MCard>
            </div>

        </div>
    }

</div>

@* ── Attention popup ── *@
@if (_popup is not null)
{
    <div class="ldh-overlay" @onclick="ClosePopup" aria-hidden="true"></div>
    <div class="ldh-popup-shell" role="dialog" aria-modal="true" aria-label="@_popup.Title">
        <div class="ldh-popup" dir="rtl">

            @* Header *@
            <div class="ldh-popup-header">
                <span class="ldh-popup-chip" style="background:@_popup.TagBg; color:@_popup.TagColor">
                    @_popup.Tag
                </span>
                <button type="button" class="ldh-popup-close" @onclick="ClosePopup" aria-label="סגור">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M18 6 6 18M6 6l12 12"></path>
                    </svg>
                </button>
            </div>

            <h3 class="ldh-popup-title">@_popup.Title</h3>
            @if (!string.IsNullOrEmpty(_popup.TeamName))
            {
                <p class="ldh-popup-team">@_popup.TeamName</p>
            }

            @* Detail rows — loading shimmer while fetching *@
            @if (_popupDetailLoading)
            {
                <div class="ldh-popup-detail-loading" role="status">
                    <span class="ldh-spinner" aria-hidden="true"></span>
                    <span>טוען פרטים…</span>
                </div>
            }
            else
            {
                <div class="ldh-popup-rows">

                    @* Extension-only: date-change row + target + mentor recommendation *@
                    @if (_popupDetail?.Extension is { } ext)
                    {
                        @* Dates row — always show when extension detail is present *@
                        <div class="ldh-popup-row">
                            <span class="ldh-popup-row-label">מועדים</span>
                            <span class="ldh-popup-dates">
                                @if (ext.CurrentDueDate.HasValue)
                                {
                                    <span class="ldh-popup-date-cur">@ext.CurrentDueDate.Value.ToString("dd.MM")</span>
                                    <span class="ldh-popup-date-arrow" aria-hidden="true">←</span>
                                }
                                <span class="ldh-popup-date-req">@ext.RequestedDueDate.ToString("dd.MM")</span>
                                <span class="ldh-popup-date-req-lbl">(מבוקש)</span>
                            </span>
                        </div>

                        @* Scope: which task / milestone is targeted *@
                        @if (!string.IsNullOrEmpty(ext.TaskTitle) || !string.IsNullOrEmpty(ext.MilestoneTitle))
                        {
                            <div class="ldh-popup-row">
                                <span class="ldh-popup-row-label">יעד</span>
                                <span class="ldh-popup-row-val" style="color:#4A4657">
                                    @(ext.TaskTitle ?? ext.MilestoneTitle)
                                </span>
                            </div>
                        }

                        @* Mentor recommendation — show only after a decision has been made *@
                        @if (ext.MentorDecision != ExtensionDecisionStatuses.Pending)
                        {
                            <div class="ldh-popup-row">
                                <span class="ldh-popup-row-label">המלצת מנחה</span>
                                <span class="ldh-popup-row-val" style="color:@MentorDecisionColor(ext.MentorDecision)">
                                    @ExtensionDecisionStatuses.Label(ext.MentorDecision)
                                    @if (!string.IsNullOrEmpty(ext.MentorDecidedByName))
                                    {
                                        <span style="color:#9B96A8"> · @ext.MentorDecidedByName</span>
                                    }
                                </span>
                            </div>
                        }
                    }

                    @* Shared contextual rows (project, mentor, submitted date) *@
                    @foreach (var row in _popup.Rows)
                    {
                        <div class="ldh-popup-row">
                            <span class="ldh-popup-row-label">@row.Label</span>
                            <span class="ldh-popup-row-val" style="color:@row.Color">@row.Value</span>
                            @if (row.Value2 is not null)
                            {
                                <span class="ldh-popup-row-val" style="color:@row.Color2">@row.Value2</span>
                            }
                        </div>
                    }
                </div>

                @* Action-required note *@
                @if (!string.IsNullOrEmpty(_popup.Note))
                {
                    <div class="ldh-popup-note">
                        <span class="ldh-popup-note-label">@_popup.NoteLabel</span>
                        <p class="ldh-popup-note-text">@_popup.Note</p>
                    </div>
                }
            }

            @* Footer — always visible so the user can close even while loading *@
            <div class="ldh-popup-footer">
                <button type="button" class="ldh-popup-btn-close" @onclick="ClosePopup">סגירה</button>
                <button type="button" class="ldh-popup-cta" @onclick="NavigateFromPopup">@_popup.CtaLabel</button>
            </div>

        </div>
    </div>
}

@code {
    [CascadingParameter] private User? _user { get; set; }

    private DashboardOverviewDto?             _data;
    private List<PersonalTaskDto>             _personalTasks    = new();
    private List<ProjectRequestRowDto>             _requests          = new();
    private List<PendingMentorApprovalRowDto>      _pendingApprovals  = new();
    private bool _loading   = true;
    private bool _loadError;

    private AttentionItem?            _popup;
    private ProjectRequestDetailDto?  _popupDetail;
    private bool                      _popupDetailLoading;

    // ── Time / greeting ──────────────────────────────────────────────────────

    private string _greeting
    {
        get
        {
            var name = _user?.FirstName?.Trim();
            var hour = DateTime.Now.Hour;
            var part = hour < 12 ? "בוקר טוב"
                     : hour < 17 ? "צהריים טובים"
                     : hour < 21 ? "ערב טוב"
                     :             "לילה טוב";
            return string.IsNullOrEmpty(name) ? part : $"{part}, {name}";
        }
    }

    private string _subtitle
    {
        get
        {
            if (_data is null)
                return DateTime.Now.ToString("dddd, d 'ב'MMMM yyyy",
                    new System.Globalization.CultureInfo("he-IL"));

            int items  = _data.Summary.OpenRequests + _data.Summary.SubmissionsMissing;
            int atRisk = _data.Charts.HealthAtRisk;
            int total  = _data.Summary.TotalProjects;

            if (items == 0 && atRisk == 0)
                return total > 0
                    ? $"כל {total} הפרויקטים במצב תקין"
                    : "אין פרויקטים פעילים כרגע";

            var parts = new List<string>();
            if (items > 0)  parts.Add($"{items} פריטים ממתינים להחלטתך");
            if (atRisk > 0) parts.Add($"{atRisk} פרויקטים בסיכון מתוך {total}");
            return string.Join(" · ", parts);
        }
    }

    // ── Data loading ─────────────────────────────────────────────────────────

    protected override async Task OnInitializedAsync()
    {
        var result = await DashboardService.GetAsync("lecturer");
        _loadError = result is null;
        _data      = result;

        // All three secondary sources are best-effort: failures degrade silently.
        try   { _personalTasks    = await PersonalTasks.GetAsync(); }
        catch { _personalTasks    = new(); }

        try   { _requests         = await RequestsService.GetAllAsync() ?? new(); }
        catch { _requests         = new(); }

        try   { _pendingApprovals = await ApprovalsService.GetPendingAsync() ?? new(); }
        catch { _pendingApprovals = new(); }

        _loading = false;
    }

    // ── Popup ─────────────────────────────────────────────────────────────────

    private async Task OpenPopup(AttentionItem item)
    {
        _popup        = item;
        _popupDetail  = null;

        if (item.RequestRow is not null)
        {
            _popupDetailLoading = true;
            StateHasChanged();
            try   { _popupDetail = await RequestsService.GetByIdAsync(item.RequestRow.Id); }
            catch { _popupDetail = null; }
            _popupDetailLoading = false;
        }
    }

    private void ClosePopup()
    {
        _popup       = null;
        _popupDetail = null;
    }

    private void NavigateFromPopup()
    {
        var href = _popup?.Href;
        _popup       = null;
        _popupDetail = null;
        if (href is not null) Nav.NavigateTo(href);
    }

    // OnAttentionKeyDown was removed with the hand-rolled role="button" div it
    // served: MRow with OnClick renders a real <button>, which is focusable and
    // activates on Enter and Space without a handler. No keyboard affordance
    // was lost — the row gained the browser's own.

    private static string MentorDecisionColor(string decision) => decision switch
    {
        ExtensionDecisionStatuses.Recommended    => "#22A05A",
        ExtensionDecisionStatuses.NotRecommended => "#E0335F",
        ExtensionDecisionStatuses.Approved       => "#22A05A",
        ExtensionDecisionStatuses.Rejected       => "#E0335F",
        _                                        => "#4A4657",
    };

    // ── Data models ───────────────────────────────────────────────────────────

    // Value2 / Color2: optional second value span in the same row — used for
    // the extension deadline comparison (current date vs. requested date).
    private sealed record PopupRow(string Label, string Value, string Color,
        string? Value2 = null, string? Color2 = null);

    // Tone replaces the old BarColor. It was a literal "#E0335F" passed to every
    // item of both kinds; it is now the Master's closed three-tone set, read by
    // MStatusDot, so a row cannot express a colour the design system does not
    // have. Tag / TagBg / TagColor still belong to the POPUP and are untouched.
    private sealed record AttentionItem(
        string Tag, string TagBg, string TagColor, MStatusDot.DotTone Tone,
        string Title, string TeamName, string Desc, string Href,
        IReadOnlyList<PopupRow> Rows, string? Note, string NoteLabel, string CtaLabel,
        ProjectRequestRowDto? RequestRow = null);

    private sealed record UpcomingItem(string When, string KindClass, string Label, string Href, DateTime Date);

    // MetaTone / Tone replace the single inline "#E0335F" dot and the inline
    // reason colour, for the same reason.
    private sealed record TeamItem(string TeamName, string Mentor, string Reason,
        MStatusDot.DotTone Tone, MRow.RowMetaTone MetaTone, int ProjectId);

    // ── Derived: attention items ──────────────────────────────────────────────
    // ONE ROW = ONE REQUEST from the "להחלטתך" bucket on the Requests page.
    // Filter mirrors BucketOf() in RequestsManagement exactly:
    //   NOT PendingMentorRecommendation AND NOT Resolved AND NOT Closed.
    // Sorted oldest-first (longest waiting) so the 4 most urgent surface first.
    // The template caps at 4 with .Take(4).

    private static bool IsDecisionBucket(string status) =>
        status != RequestStatuses.PendingMentorRecommendation
        && status != RequestStatuses.Resolved
        && status != RequestStatuses.Closed;

    private IReadOnlyList<AttentionItem> AttentionItems
    {
        get
        {
            var items = new List<AttentionItem>();

            // Requests that belong to the "להחלטתך" tab on the Requests page,
            // sorted by CreatedAt ascending so the oldest waiting request appears
            // first — "the 4 that have been waiting the longest".
            foreach (var r in _requests
                .Where(r => IsDecisionBucket(r.Status))
                .OrderBy(r => r.CreatedAt))
            {
                bool isExtDecision = r.RequestType == RequestTypes.Extension
                                  && r.Status == RequestStatuses.PendingLecturerDecision;

                string tag   = RequestTypes.Label(r.RequestType);
                string title = isExtDecision
                    ? $"החלטה נדרשת — {r.Title}"
                    : r.Title;

                var rows = new List<PopupRow>();
                if (!string.IsNullOrEmpty(r.ProjectTitle))
                    rows.Add(new PopupRow("פרויקט", r.ProjectTitle, "#4A4657"));
                if (r.MentorNames.Count > 0)
                    rows.Add(new PopupRow("מנחה", r.MentorNames[0], "#4A4657"));
                rows.Add(new PopupRow("הוגשה",
                    r.CreatedAt.ToString("d/M/yyyy"), "#4A4657"));

                items.Add(new AttentionItem(
                    Tag:       tag,
                    TagBg:     isExtDecision ? "rgba(109,40,245,.12)" : "rgba(109,40,245,.07)",
                    TagColor:  "#6D28F5",
                    Tone:      MStatusDot.DotTone.Violet,
                    Title:     title,
                    TeamName:  r.TeamName ?? "",
                    Desc:      BuildRequestDesc(r),
                    Href:      $"/management/requests?open={r.Id}",
                    Rows:      rows,
                    Note:      isExtDecision ? "בקשת ההדחייה ממתינה להחלטתך הסופית." : null,
                    NoteLabel: "נדרשת פעולה",
                    CtaLabel:  "לפתיחת הבקשה",
                    RequestRow: r));
            }

            return items.ToList();
        }
    }

    private static string BuildRequestDesc(ProjectRequestRowDto r)
    {
        var parts = new List<string>();
        if (!string.IsNullOrWhiteSpace(r.TeamName))   parts.Add(r.TeamName);
        if (r.MentorNames.Count > 0)                  parts.Add($"מנחה: {r.MentorNames[0]}");
        parts.Add(RequestStatuses.Label(r.Status));
        return string.Join(" · ", parts);
    }

    private static string BuildApprovalDesc(PendingMentorApprovalRowDto t)
    {
        var parts = new List<string>();
        if (!string.IsNullOrWhiteSpace(t.TeamName))   parts.Add(t.TeamName);
        if (!string.IsNullOrWhiteSpace(t.MentorName)) parts.Add($"מנחה: {t.MentorName}");
        parts.Add($"ממתינה {t.DaysWaiting} ימים");
        return string.Join(" · ", parts);
    }

    // ── Derived: teams needing attention ─────────────────────────────────────

    private IReadOnlyList<TeamItem> TeamItems
    {
        get
        {
            if (_data is null) return Array.Empty<TeamItem>();

            return _data.Projects
                .Where(p => p.HealthBucket is HealthBuckets.AtRisk or HealthBuckets.Attention)
                .OrderBy(p => p.HealthScore)
                .Take(5)
                .Select(p => new TeamItem(
                    TeamName:  p.TeamName ?? p.ProjectTitle,
                    Mentor:    p.MentorNames ?? "—",
                    Reason:    BuildReason(p),
                    // The bucket the server already scored, said in the
                    // Master's tones instead of two literals: at-risk is the
                    // real problem, needs-watching is in flight.
                    Tone:      p.HealthBucket == HealthBuckets.AtRisk
                                   ? MStatusDot.DotTone.Rose
                                   : MStatusDot.DotTone.Violet,
                    MetaTone:  p.HealthBucket == HealthBuckets.AtRisk
                                   ? MRow.RowMetaTone.Rose
                                   : MRow.RowMetaTone.Default,
                    ProjectId: p.ProjectId))
                .ToList();
        }
    }

    private static string BuildReason(DashboardProjectRowDto p)
    {
        if (p.HealthBucket == HealthBuckets.AtRisk) return "פרויקט בסיכון";
        if (p.OverdueTaskCount > 0)  return $"{p.OverdueTaskCount} משימות באיחור";
        if (p.OpenRequestCount > 0)  return $"{p.OpenRequestCount} בקשות פתוחות";
        if (p.MissingSubmissionCount > 0) return $"{p.MissingSubmissionCount} הגשות חסרות";
        return "דורש תשומת לב";
    }

    // ── Derived: upcoming deadlines ───────────────────────────────────────────

    // Unified pool: project milestones + the lecturer's own personal tasks.
    // Both sources use the same sort rule (proximity to today, take 5) so the
    // calendar and the dashboard always agree on "what is near" without
    // inventing a separate date-range rule for one of them.
    private IReadOnlyList<UpcomingItem> UpcomingItems
    {
        get
        {
            if (_data is null) return Array.Empty<UpcomingItem>();

            // TODAY IS THE FLOOR, and it is applied to each feed at its
            // source rather than to the union, so neither can leak a past
            // date into the other's half of the list. See the note on the
            // sort below for why filtering alone was not enough.
            var today = DateTime.Today;

            // ── Milestone items ──────────────────────────────────────────
            var milestoneItems = _data.Projects
                .Where(p => p.CurrentMilestoneDueDate.HasValue)
                .Where(p => p.CurrentMilestoneDueDate!.Value.Date >= today)
                .Select(p =>
                {
                    var d    = p.CurrentMilestoneDueDate!.Value;
                    int days = (d.Date - DateTime.Today).Days;

                    string when = days == 0             ? "היום"
                                : days == 1             ? "מחר"
                                : days is > 1 and <= 7  ? $"עוד {days} ימים"
                                : d.ToString("d/M", System.Globalization.CultureInfo.InvariantCulture);

                    // Tile bar color: type, not urgency.
                    string kindClass = p.MissingSubmissionCount > 0 ? "ldh-kind-submission"
                                     : p.OpenRequestCount > 0       ? "ldh-kind-review"
                                     :                                 "ldh-kind-milestone";

                    string label = string.IsNullOrWhiteSpace(p.CurrentMilestoneTitle)
                        ? p.ProjectTitle
                        : $"{p.CurrentMilestoneTitle} — {p.ProjectTitle}";

                    return new UpcomingItem(when, kindClass, label,
                        $"/projects/{p.ProjectId}/overview", d);
                });

            // ── Personal task items ──────────────────────────────────────
            // Same data source the calendar uses (PersonalTasks.GetAsync),
            // so a task created or edited from either surface is projected
            // identically here — one entity, two views.
            var personalItems = _personalTasks
                .Where(t => !t.IsDone && t.DueDate is not null)
                .Where(t => t.DueDate!.Value.Date >= today)
                .Select(t =>
                {
                    var d    = t.DueDate!.Value.Date;
                    int days = (d - DateTime.Today).Days;

                    string when = days == 0             ? "היום"
                                : days == 1             ? "מחר"
                                : days is > 1 and <= 7  ? $"עוד {days} ימים"
                                : d.ToString("d/M", System.Globalization.CultureInfo.InvariantCulture);

                    // If the task is linked to a project, show "title — project";
                    // otherwise just the title.
                    string label = t.ProjectId is int && !string.IsNullOrWhiteSpace(t.ProjectTitle)
                        ? $"{t.Title} — {t.ProjectTitle}"
                        : t.Title;

                    // Project-linked tasks navigate to the project overview;
                    // standalone personal tasks deep-link to the calendar event
                    // so it opens with the drawer pre-selected.
                    string href = t.ProjectId is int pid
                        ? $"/projects/{pid}/overview"
                        : $"/lecturer/calendar?open=pt-{t.Id}";

                    return new UpcomingItem(when, "ldh-kind-personal", label, href, d);
                });

            // ── Union, sort, cap ─────────────────────────────────────────
            //
            // CHRONOLOGICAL, nearest upcoming first. It was
            // `OrderBy(Math.Abs(days))` — proximity to today in EITHER
            // direction — which is a different question and the reason past
            // items did not merely appear here but led the list: a milestone
            // two days overdue outranked one due in five. Rendered, this card
            // opened with "לפני 2 ימים · לפני 52 ימים · לפני 61 ימים" under a
            // heading that says "coming up".
            //
            // With today as the floor on both feeds above, Abs() and a plain
            // ascending sort would now agree — the sort is corrected anyway,
            // because a rule that is only right because of a filter somewhere
            // else is the kind that comes back.
            //
            // NOTHING IS LOST FROM THE PRODUCT. An overdue milestone is
            // already this dashboard's דורש את תשומת לבך and צוותים שדורשים
            // תשומת לב business; an overdue personal task is counted on
            // /lecturer/tasks; and /lecturer/calendar still renders every past
            // event exactly as it did — this filter is local to this card's
            // view-model and touches no query, endpoint or DTO.
            return milestoneItems
                .Concat(personalItems)
                .OrderBy(u => u.Date)
                .Take(5)
                .ToList();
        }
    }
}
