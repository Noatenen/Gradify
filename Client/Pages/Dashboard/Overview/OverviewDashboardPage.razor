@*
    ── Lecturer Home (Dashboard) ────────────────────────────────────────────
    Visual source: design/design-system/MotivaLecturerDesign/
                   Motiva Lecturer Home.dc (1).html
                   design/design-system/MotivaLecturerDesign/דשבורד מרצה 268.pdf
    Data source:   IDashboardOverviewService.GetAsync("lecturer")
                   → DashboardOverviewDto

    LAYOUT
      Big H1 greeting + subtitle + status pills row
      Two-column grid (1.75fr main | 1fr side):
        Main: "דורש את תשומת לבך" attention card + "צוותים שדורשים תשומת לב" teams card
        Side: "בקרוב" upcoming events card
      Attention rows have a coloured vertical accent bar and open a popup modal.
      Popup overlays the entire page; backdrop click closes it.
*@
@page "/dashboard/lecturer"
@layout AppLayout
@attribute [Authorize(Roles = Roles.Admin + "," + Roles.Staff + "," + Roles.Mentor)]
@using AuthWithAdmin.Client.Services
@using AuthWithAdmin.Shared.AuthSharedModels
@inject NavigationManager Nav
@inject IDashboardOverviewService DashboardService
@inject IPersonalTasksService PersonalTasks
@inject IProjectRequestsService RequestsService
@inject IPendingMentorApprovalsService ApprovalsService

<div class="ldh-page" dir="rtl">

    @* ── Title row ── *@
    <div class="ldh-title-row">
        <h1 class="ldh-h1">@_greeting</h1>
        <p class="ldh-subtitle">@_subtitle</p>
    </div>

    @* ── Status pills ── *@
    @if (!_loading && _data is not null)
    {
        <div class="ldh-pills">
            <span class="ldh-pill">
                <span class="ldh-pill-dot" style="background:#0FA8C2"></span>
                @_data.Summary.TotalProjects צוותים פעילים
            </span>
            <span class="ldh-pill">
                <span class="ldh-pill-dot" style="background:#6D28F5"></span>
                @_data.Summary.OpenRequests בקשות להחלטתך
            </span>
            <span class="ldh-pill">
                <span class="ldh-pill-dot" style="background:#2E63E8"></span>
                @_data.Summary.SubmissionsMissing הגשות לאישורך
            </span>
            <span class="ldh-pill">
                <span class="ldh-pill-dot" style="background:#E0335F"></span>
                @(_data.Charts.HealthAtRisk + _data.Charts.HealthAttention) צוותים דורשים תשומת לב
            </span>
        </div>
    }

    @* ── Loading state ── *@
    @if (_loading)
    {
        <div class="ldh-loading" role="status" aria-live="polite">
            <span class="ldh-spinner" aria-hidden="true"></span>
            <span>טוענת נתונים…</span>
        </div>
    }
    else if (_loadError || _data is null)
    {
        <p class="ldh-error">שגיאה בטעינת הדשבורד. נסה לרענן את הדף.</p>
    }
    else
    {
        @* ── Two-column grid ── *@
        <div class="ldh-grid">

            @* ── Main column ── *@
            <div class="ldh-main-col">

                @* ── Attention card ── *@
                <section class="ldh-card ldh-card-strong ldh-attention-card" aria-label="דורש את תשומת לבך">
                    <div class="ldh-card-header">
                        <h2 class="ldh-card-title">דורש את תשומת לבך</h2>
                        @if (AttentionItems.Count > 0)
                        {
                            <span class="ldh-count-badge">@AttentionItems.Count</span>
                        }
                    </div>

                    @if (AttentionItems.Count == 0)
                    {
                        <div class="ldh-empty-state">
                            <span class="ldh-empty-title">הכול תחת שליטה.</span>
                            <p class="ldh-empty-desc">אין בקשות, הגשות או פרויקטים שדורשים את התייחסותך כרגע.</p>
                        </div>
                    }
                    else
                    {
                        @foreach (var item in AttentionItems.Take(4))
                        {
                            var captured = item;
                            <div class="ldh-att-row"
                                 role="button" tabindex="0"
                                 aria-label="@captured.Title — לחץ לפרטים"
                                 @onclick="() => OpenPopup(captured)"
                                 @onkeydown="e => OnAttentionKeyDown(e, captured)">
                                <span class="ldh-att-bar" style="background:@captured.BarColor"></span>
                                <div class="ldh-att-text">
                                    <span class="ldh-att-title">@captured.Title</span>
                                    <span class="ldh-att-desc">@captured.Desc</span>
                                </div>
                                <svg class="ldh-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                     stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <path d="M15 18l-6-6 6-6"></path>
                                </svg>
                            </div>
                        }
                    }
                </section>

                @* ── Teams card ── *@
                @if (TeamItems.Count > 0)
                {
                    <section class="ldh-card ldh-teams-card" aria-label="צוותים שדורשים תשומת לב">
                        <div class="ldh-card-header">
                            <h2 class="ldh-card-title-sm">צוותים שדורשים תשומת לב</h2>
                            <a class="ldh-card-link" href="/projects">לכל הצוותים</a>
                        </div>
                        @foreach (var t in TeamItems)
                        {
                            <a class="ldh-team-row" href="/projects?open=@t.ProjectId"
                               aria-label="@($"פתח פרטי {t.TeamName} — {t.Reason}")">
                                <span class="ldh-team-dot"></span>
                                <span class="ldh-team-name">@t.TeamName</span>
                                <span class="ldh-team-mentor">@t.Mentor</span>
                                <span class="ldh-team-reason">@t.Reason</span>
                            </a>
                        }
                    </section>
                }

            </div>

            @* ── Side column ── *@
            <div class="ldh-side-col">
                @* ── בקרוב ────────────────────────────────────────────────────
                   Tile pattern transcribed from MentorHomePage: a 46px date block
                   per entry with the urgency carried as a 2.5px inset top bar.
                   The KindClass sets --ldh-kind so the tile bar matches item type. *@
                <section class="ldh-card ldh-upcoming-card" aria-labelledby="ldh-up-h">
                    <div class="ldh-card-header">
                        <span class="ldh-head-icon" aria-hidden="true">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                 stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <rect x="3" y="4" width="18" height="18" rx="3"></rect>
                                <path d="M16 2v4M8 2v4M3 10h18"></path>
                            </svg>
                        </span>
                        <h2 class="ldh-card-title-sm" id="ldh-up-h">בקרוב</h2>
                        <a class="ldh-card-link" href="/lecturer/calendar">ליומן המלא</a>
                    </div>

                    @if (!UpcomingItems.Any())
                    {
                        <p class="ldh-empty-desc">אין מועדים קרובים.</p>
                    }
                    else
                    {
                        <div class="ldh-up-list">
                            @foreach (var u in UpcomingItems)
                            {
                                <a class="ldh-up-row @u.KindClass" href="@u.Href">
                                    <span class="ldh-up-tile">
                                        <span class="ldh-up-day">@u.Date.Day.ToString("00")</span>
                                        <span class="ldh-up-month">@MotivaDates.ShortMonth(u.Date)</span>
                                    </span>
                                    <span class="ldh-up-body">
                                        <span class="ldh-up-title" title="@u.Label">@u.Label</span>
                                        <span class="ldh-up-meta">@u.When</span>
                                    </span>
                                </a>
                            }
                        </div>
                    }
                </section>
            </div>

        </div>
    }

</div>

@* ── Attention popup ── *@
@if (_popup is not null)
{
    <div class="ldh-overlay" @onclick="ClosePopup" aria-hidden="true"></div>
    <div class="ldh-popup-shell" role="dialog" aria-modal="true" aria-label="@_popup.Title">
        <div class="ldh-popup" dir="rtl">

            @* Header *@
            <div class="ldh-popup-header">
                <span class="ldh-popup-chip" style="background:@_popup.TagBg; color:@_popup.TagColor">
                    @_popup.Tag
                </span>
                <button type="button" class="ldh-popup-close" @onclick="ClosePopup" aria-label="סגור">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M18 6 6 18M6 6l12 12"></path>
                    </svg>
                </button>
            </div>

            <h3 class="ldh-popup-title">@_popup.Title</h3>
            @if (!string.IsNullOrEmpty(_popup.TeamName))
            {
                <p class="ldh-popup-team">@_popup.TeamName</p>
            }

            @* Detail rows *@
            <div class="ldh-popup-rows">
                @foreach (var row in _popup.Rows)
                {
                    <div class="ldh-popup-row">
                        <span class="ldh-popup-row-label">@row.Label</span>
                        <span class="ldh-popup-row-val" style="color:@row.Color">@row.Value</span>
                        @if (row.Value2 is not null)
                        {
                            <span class="ldh-popup-row-val" style="color:@row.Color2">@row.Value2</span>
                        }
                    </div>
                }
            </div>

            @* Note *@
            @if (!string.IsNullOrEmpty(_popup.Note))
            {
                <div class="ldh-popup-note">
                    <span class="ldh-popup-note-label">@_popup.NoteLabel</span>
                    <p class="ldh-popup-note-text">@_popup.Note</p>
                </div>
            }

            @* Footer *@
            <div class="ldh-popup-footer">
                <button type="button" class="ldh-popup-btn-close" @onclick="ClosePopup">סגירה</button>
                <button type="button" class="ldh-popup-cta" @onclick="NavigateFromPopup">@_popup.CtaLabel</button>
            </div>

        </div>
    </div>
}

@code {
    [CascadingParameter] private User? _user { get; set; }

    private DashboardOverviewDto?             _data;
    private List<PersonalTaskDto>             _personalTasks    = new();
    private List<ProjectRequestRowDto>             _requests          = new();
    private List<PendingMentorApprovalRowDto>      _pendingApprovals  = new();
    private bool _loading   = true;
    private bool _loadError;

    private AttentionItem? _popup;

    // ── Time / greeting ──────────────────────────────────────────────────────

    private string _greeting
    {
        get
        {
            var name = _user?.FirstName?.Trim();
            var hour = DateTime.Now.Hour;
            var part = hour < 12 ? "בוקר טוב"
                     : hour < 17 ? "צהריים טובים"
                     : hour < 21 ? "ערב טוב"
                     :             "לילה טוב";
            return string.IsNullOrEmpty(name) ? part : $"{part}, {name}";
        }
    }

    private string _subtitle
    {
        get
        {
            if (_data is null)
                return DateTime.Now.ToString("dddd, d 'ב'MMMM yyyy",
                    new System.Globalization.CultureInfo("he-IL"));

            int items  = _data.Summary.OpenRequests + _data.Summary.SubmissionsMissing;
            int atRisk = _data.Charts.HealthAtRisk;
            int total  = _data.Summary.TotalProjects;

            if (items == 0 && atRisk == 0)
                return total > 0
                    ? $"כל {total} הפרויקטים במצב תקין"
                    : "אין פרויקטים פעילים כרגע";

            var parts = new List<string>();
            if (items > 0)  parts.Add($"{items} פריטים ממתינים להחלטתך");
            if (atRisk > 0) parts.Add($"{atRisk} פרויקטים בסיכון מתוך {total}");
            return string.Join(" · ", parts);
        }
    }

    // ── Data loading ─────────────────────────────────────────────────────────

    protected override async Task OnInitializedAsync()
    {
        var result = await DashboardService.GetAsync("lecturer");
        _loadError = result is null;
        _data      = result;

        // All three secondary sources are best-effort: failures degrade silently.
        try   { _personalTasks    = await PersonalTasks.GetAsync(); }
        catch { _personalTasks    = new(); }

        try   { _requests         = await RequestsService.GetAllAsync() ?? new(); }
        catch { _requests         = new(); }

        try   { _pendingApprovals = await ApprovalsService.GetPendingAsync() ?? new(); }
        catch { _pendingApprovals = new(); }

        _loading = false;
    }

    // ── Popup ─────────────────────────────────────────────────────────────────

    private void OpenPopup(AttentionItem item) => _popup = item;
    private void ClosePopup() => _popup = null;

    private void NavigateFromPopup()
    {
        var href = _popup?.Href;
        _popup = null;
        if (href is not null) Nav.NavigateTo(href);
    }

    private void OnAttentionKeyDown(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e, AttentionItem item)
    {
        if (e.Key is "Enter" or " ") OpenPopup(item);
    }

    // ── Data models ───────────────────────────────────────────────────────────

    // Value2 / Color2: optional second value span in the same row — used for
    // the extension deadline comparison (current date vs. requested date).
    private sealed record PopupRow(string Label, string Value, string Color,
        string? Value2 = null, string? Color2 = null);

    private sealed record AttentionItem(
        string Tag, string TagBg, string TagColor, string BarColor,
        string Title, string TeamName, string Desc, string Href,
        IReadOnlyList<PopupRow> Rows, string? Note, string NoteLabel, string CtaLabel);

    private sealed record UpcomingItem(string When, string KindClass, string Label, string Href, DateTime Date);

    private sealed record TeamItem(string TeamName, string Mentor, string Reason, int ProjectId);

    // ── Derived: attention items ──────────────────────────────────────────────
    // ONE ROW = ONE SPECIFIC ACTION ITEM requiring lecturer attention.
    // Sources: individual project requests + individual pending mentor approvals.
    // (Dashboard aggregates are no longer used here — they only provide counts.)

    private IReadOnlyList<AttentionItem> AttentionItems
    {
        get
        {
            var items = new List<AttentionItem>();

            // ── Pending requests that need lecturer input ─────────────────
            // PendingLecturerDecision (extension awaiting final call) comes
            // first; the other open statuses follow ordered by submit date.
            var actionable = new HashSet<string>
            {
                RequestStatuses.New,
                RequestStatuses.WaitingForStaff,
                RequestStatuses.PendingLecturerDecision,
            };

            foreach (var r in _requests
                .Where(r => actionable.Contains(r.Status))
                .OrderByDescending(r => r.Status == RequestStatuses.PendingLecturerDecision)
                .ThenBy(r => r.CreatedAt))
            {
                bool isExtDecision = r.RequestType == RequestTypes.Extension
                                  && r.Status == RequestStatuses.PendingLecturerDecision;

                string tag   = RequestTypes.Label(r.RequestType);
                string title = isExtDecision
                    ? $"החלטה נדרשת — {r.Title}"
                    : r.Title;

                var rows = new List<PopupRow>();
                rows.Add(new PopupRow("סוג בקשה", tag, "#4A4657"));
                rows.Add(new PopupRow("סטטוס",
                    RequestStatuses.Label(r.Status),
                    isExtDecision ? "#6D28F5" : "#4A4657"));
                if (!string.IsNullOrEmpty(r.ProjectTitle))
                    rows.Add(new PopupRow("פרויקט", r.ProjectTitle, "#4A4657"));
                if (!string.IsNullOrEmpty(r.TeamName))
                    rows.Add(new PopupRow("צוות", r.TeamName, "#4A4657"));
                if (r.MentorNames.Count > 0)
                    rows.Add(new PopupRow("מנחה", r.MentorNames[0], "#4A4657"));
                rows.Add(new PopupRow("הוגשה",
                    r.CreatedAt.ToString("d/M/yyyy"), "#4A4657"));

                items.Add(new AttentionItem(
                    Tag:      tag,
                    TagBg:    isExtDecision ? "rgba(109,40,245,.12)" : "rgba(109,40,245,.07)",
                    TagColor: "#6D28F5",
                    BarColor: "#E0335F",
                    Title:    title,
                    TeamName: r.TeamName ?? "",
                    Desc:     BuildRequestDesc(r),
                    Href:     $"/management/requests?open={r.Id}",
                    Rows:     rows,
                    Note:     isExtDecision ? "בקשת ההדחייה ממתינה להחלטתך הסופית." : null,
                    NoteLabel: "נדרשת פעולה",
                    CtaLabel: "לפתיחת הבקשה"));
            }

            // ── Pending mentor approvals (submission waiting for mentor) ──
            // Ordered most-delayed first.
            // Submissions page is deprecated; navigate to the project overview
            // which shows submission status in context.
            foreach (var t in _pendingApprovals
                .OrderByDescending(t => t.DaysWaiting))
            {
                var rows = new List<PopupRow>();
                rows.Add(new PopupRow("משימה", t.TaskTitle, "#4A4657"));
                if (!string.IsNullOrEmpty(t.MilestoneTitle))
                    rows.Add(new PopupRow("אבן דרך", t.MilestoneTitle, "#4A4657"));
                rows.Add(new PopupRow("פרויקט", t.ProjectTitle, "#4A4657"));
                if (!string.IsNullOrEmpty(t.TeamName))
                    rows.Add(new PopupRow("צוות", t.TeamName, "#4A4657"));
                if (!string.IsNullOrEmpty(t.MentorName))
                    rows.Add(new PopupRow("מנחה", t.MentorName, "#4A4657"));
                rows.Add(new PopupRow("ממתינה",
                    $"{t.DaysWaiting} ימים",
                    t.DaysWaiting > 7 ? "#E0335F"
                    : t.DaysWaiting > 3 ? "#F59E0B"
                    : "#4A4657"));

                items.Add(new AttentionItem(
                    Tag:      "הגשה ממתינה",
                    TagBg:    "rgba(46,99,232,.10)",
                    TagColor: "#2E63E8",
                    BarColor: "#E0335F",
                    Title:    $"הגשה ממתינה לאישור — {t.TaskTitle}",
                    TeamName: t.TeamName ?? "",
                    Desc:     BuildApprovalDesc(t),
                    Href:     $"/projects/{t.ProjectId}/overview",
                    Rows:     rows,
                    Note:     t.DaysWaiting > 3
                        ? $"ההגשה ממתינה לאישור המנחה {t.DaysWaiting} ימים."
                        : null,
                    NoteLabel: "שים לב",
                    CtaLabel: "לפתיחת הפרויקט"));
            }

            return items.ToList();
        }
    }

    private static string BuildRequestDesc(ProjectRequestRowDto r)
    {
        var parts = new List<string>();
        if (!string.IsNullOrWhiteSpace(r.TeamName))   parts.Add(r.TeamName);
        if (r.MentorNames.Count > 0)                  parts.Add($"מנחה: {r.MentorNames[0]}");
        parts.Add(RequestStatuses.Label(r.Status));
        return string.Join(" · ", parts);
    }

    private static string BuildApprovalDesc(PendingMentorApprovalRowDto t)
    {
        var parts = new List<string>();
        if (!string.IsNullOrWhiteSpace(t.TeamName))   parts.Add(t.TeamName);
        if (!string.IsNullOrWhiteSpace(t.MentorName)) parts.Add($"מנחה: {t.MentorName}");
        parts.Add($"ממתינה {t.DaysWaiting} ימים");
        return string.Join(" · ", parts);
    }

    // ── Derived: teams needing attention ─────────────────────────────────────

    private IReadOnlyList<TeamItem> TeamItems
    {
        get
        {
            if (_data is null) return Array.Empty<TeamItem>();

            return _data.Projects
                .Where(p => p.HealthBucket is HealthBuckets.AtRisk or HealthBuckets.Attention)
                .OrderBy(p => p.HealthScore)
                .Take(5)
                .Select(p => new TeamItem(
                    TeamName:  p.TeamName ?? p.ProjectTitle,
                    Mentor:    p.MentorNames ?? "—",
                    Reason:    BuildReason(p),
                    ProjectId: p.ProjectId))
                .ToList();
        }
    }

    private static string BuildReason(DashboardProjectRowDto p)
    {
        if (p.HealthBucket == HealthBuckets.AtRisk) return "פרויקט בסיכון";
        if (p.OverdueTaskCount > 0)  return $"{p.OverdueTaskCount} משימות באיחור";
        if (p.OpenRequestCount > 0)  return $"{p.OpenRequestCount} בקשות פתוחות";
        if (p.MissingSubmissionCount > 0) return $"{p.MissingSubmissionCount} הגשות חסרות";
        return "דורש תשומת לב";
    }

    // ── Derived: upcoming deadlines ───────────────────────────────────────────

    // Unified pool: project milestones + the lecturer's own personal tasks.
    // Both sources use the same sort rule (proximity to today, take 5) so the
    // calendar and the dashboard always agree on "what is near" without
    // inventing a separate date-range rule for one of them.
    private IReadOnlyList<UpcomingItem> UpcomingItems
    {
        get
        {
            if (_data is null) return Array.Empty<UpcomingItem>();

            // ── Milestone items ──────────────────────────────────────────
            var milestoneItems = _data.Projects
                .Where(p => p.CurrentMilestoneDueDate.HasValue)
                .Select(p =>
                {
                    var d    = p.CurrentMilestoneDueDate!.Value;
                    int days = (d.Date - DateTime.Today).Days;

                    string when = days == 0             ? "היום"
                                : days == 1             ? "מחר"
                                : days is > 1 and <= 7  ? $"עוד {days} ימים"
                                : days < 0              ? $"לפני {-days} ימים"
                                : d.ToString("d/M", System.Globalization.CultureInfo.InvariantCulture);

                    // Tile bar color: type, not urgency.
                    string kindClass = p.MissingSubmissionCount > 0 ? "ldh-kind-submission"
                                     : p.OpenRequestCount > 0       ? "ldh-kind-review"
                                     :                                 "ldh-kind-milestone";

                    string label = string.IsNullOrWhiteSpace(p.CurrentMilestoneTitle)
                        ? p.ProjectTitle
                        : $"{p.CurrentMilestoneTitle} — {p.ProjectTitle}";

                    return new UpcomingItem(when, kindClass, label,
                        $"/projects/{p.ProjectId}/overview", d);
                });

            // ── Personal task items ──────────────────────────────────────
            // Same data source the calendar uses (PersonalTasks.GetAsync),
            // so a task created or edited from either surface is projected
            // identically here — one entity, two views.
            var personalItems = _personalTasks
                .Where(t => !t.IsDone && t.DueDate is not null)
                .Select(t =>
                {
                    var d    = t.DueDate!.Value.Date;
                    int days = (d - DateTime.Today).Days;

                    string when = days == 0             ? "היום"
                                : days == 1             ? "מחר"
                                : days is > 1 and <= 7  ? $"עוד {days} ימים"
                                : days < 0              ? $"לפני {-days} ימים"
                                : d.ToString("d/M", System.Globalization.CultureInfo.InvariantCulture);

                    // If the task is linked to a project, show "title — project";
                    // otherwise just the title.
                    string label = t.ProjectId is int && !string.IsNullOrWhiteSpace(t.ProjectTitle)
                        ? $"{t.Title} — {t.ProjectTitle}"
                        : t.Title;

                    // Project-linked tasks navigate to the project overview;
                    // standalone personal tasks deep-link to the calendar event
                    // so it opens with the drawer pre-selected.
                    string href = t.ProjectId is int pid
                        ? $"/projects/{pid}/overview"
                        : $"/lecturer/calendar?open=pt-{t.Id}";

                    return new UpcomingItem(when, "ldh-kind-personal", label, href, d);
                });

            // ── Union, sort, cap ─────────────────────────────────────────
            return milestoneItems
                .Concat(personalItems)
                .OrderBy(u => Math.Abs((u.Date.Date - DateTime.Today).TotalDays))
                .ThenBy(u => u.Date)
                .Take(5)
                .ToList();
        }
    }
}
