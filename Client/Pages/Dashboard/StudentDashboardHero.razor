@using AuthWithAdmin.Shared.AuthSharedModels
@using AuthWithAdmin.Client.Services
@inject ITeamTasksService TeamTasksService
@inject INotificationService NotificationService
@inject NavigationManager Nav

@* ─────────────────────────────────────────────────────────────
   StudentDashboardHero — one coherent orientation-and-action
   surface plus a light status aside. Answers exactly two
   questions and nothing else:

     RIGHT (RTL start, main card) — "Where am I, and what do I
     do next?" in one flow: section title → current stage →
     compact stage timeline → next submission (milestone tag,
     task, status/date chips, CTA). One card, one story — not
     two sections stacked.

     LEFT (RTL end, plain tiles) — "What's my status at a
     glance?" A few standalone facts (active tasks, overdue,
     team tasks, project completion, open requests), open and
     light, not boxed in a second card.
     Deliberately NOT mirrored against the right block — see the
     "balance, not symmetry" principle: the right side ends in a
     CTA because it needs one, the left side ends in a tile
     because it doesn't.

   RTL: first DOM child appears on the RIGHT side.
   ───────────────────────────────────────────────────────────── *@

@if (_current is null)
{
    <MCard Class="sdh-empty-card" Padding="MCard.CardPadding.Large" Variant="MCard.CardVariant.Ambient">
        <span class="oi oi-info sdh-empty-icon" aria-hidden="true"></span>
        <p class="sdh-empty-text">לא נמצאה אבן דרך פעילה בפרויקט</p>
    </MCard>
}
else
{
    <div class="sdh-hero">
        <div class="sdh-blocks">

            @* ── MAIN CARD: Where am I? What do I do next? (first in DOM = right in RTL) ── *@
            <MCard Class="sdh-main" Padding="MCard.CardPadding.Medium" Title="מסלול הפרויקט">
                <ChildContent>
                    <!-- Stage tracker: milestone circles sit on top of one shared
                         continuous track. Completed = gradient fill + check mark;
                         current = larger gradient-border ring; future = muted ring.
                         No per-step line fragments — a single absolutely-positioned
                         track element spans between the first and last circle centers,
                         split into a filled (gradient) portion and a muted portion.
                         Stages run right → left in RTL (index 0 = rightmost). -->
                    <div class="sdh-timeline" role="list" aria-label="מסלול השלבים">
                        @if (Milestones.Count > 1)
                        {
                            <!-- Shared track: inset so it starts/ends at circle centers.
                                 First child = filled (right/start in RTL); second = muted. -->
                            <div class="sdh-tl-track"
                                 style="right: @TrackInset; left: @TrackInset;"
                                 aria-hidden="true">
                                <span class="sdh-tl-track-filled" style="width: @($"{TrackFilledPct:F2}%")"></span>
                                <span class="sdh-tl-track-muted"  style="width: @($"{100.0 - TrackFilledPct:F2}%")"></span>
                            </div>
                        }
                        @for (var i = 0; i < Milestones.Count; i++)
                        {
                            var m     = Milestones[i];
                            var state = StageState(m);

                            <div class="sdh-tl-step" role="listitem">
                                <!-- Circle sits above the shared track via z-index -->
                                <div class="sdh-tl-dot-row">
                                    <button class="sdh-tl-dot sdh-tl-@state"
                                            title="@DisplayTitle(m.Title)"
                                            aria-label="@DisplayTitle(m.Title)"
                                            @onclick="@(() => OnOpenMilestone.InvokeAsync(m))">
                                        @if (state == "completed")
                                        {
                                            <span class="oi oi-check" aria-hidden="true"></span>
                                        }
                                    </button>
                                </div>
                                <!-- Stage name — centered directly below its circle -->
                                <span class="sdh-tl-label sdh-tl-label-@state" aria-hidden="true">@DisplayTitle(m.Title)</span>
                            </div>
                        }
                    </div>

                    <!-- Next submission — same card, below the timeline. Milestone
                         shown as a compact tag beside the label (not a subtitle). -->
                    <div class="sdh-submission">
                        <div class="sdh-submission-header">
                            <span class="sdh-submission-label">ההגשה הבאה</span>
                            @if (_nextSubmissionMilestone is not null)
                            {
                                <span class="sdh-milestone-tag">@_nextSubmissionMilestone.Title</span>
                            }
                        </div>

                        @if (_nextSubmission is not null)
                        {
                            var subDays = _nextSubDays;

                            <div class="sdh-submission-row">
                                <div class="sdh-submission-info">
                                    <h4 class="sdh-next-title">@_nextSubmission.Title</h4>

                                    <div class="sdh-next-chips">
                                        <MStatusBadge Text="@SubmissionStatusLabel(_nextSubmission)" Variant="SubmissionStatusVariant(_nextSubmission)" />
                                        @if (_nextSubmission.DueDate.HasValue)
                                        {
                                            <span class="sdh-chip">
                                                <span class="oi oi-calendar" aria-hidden="true"></span>
                                                @_nextSubmission.DueDate.Value.ToString("dd/MM/yyyy")
                                            </span>
                                        }
                                        @if (subDays.HasValue)
                                        {
                                            <span class="sdh-chip @DaysClass(subDays.Value)">@DaysText(subDays.Value)</span>
                                        }
                                    </div>
                                </div>

                                <div class="sdh-submission-cta">
                                    <MButton Variant="MButton.ButtonVariant.Primary" Size="MButton.ButtonSize.Medium" OnClick="OpenNextTask">
                                        פתיחת משימה
                                        <span class="oi oi-chevron-left sdh-cta-arrow" aria-hidden="true"></span>
                                    </MButton>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="sdh-next-empty">
                                <span class="oi oi-circle-check sdh-next-empty-icon" aria-hidden="true"></span>
                                <p class="sdh-next-empty-title">אין הגשות קרובות</p>
                                <p class="sdh-next-empty-sub">המשך לעבודה על המשימות</p>
                            </div>
                        }
                    </div>
                </ChildContent>
            </MCard>

            @* ── NOTIFICATIONS ASIDE: recent notifications feed (second in DOM = left in RTL) ── *@
            <div class="sdh-status-aside">
                <div class="sdh-notif-heading-row">
                    <span class="oi oi-bell sdh-notif-heading-icon" aria-hidden="true"></span>
                    <h3 class="sdh-status-heading">התראות שהתקבלו</h3>
                    @if (_notifications.Any(n => !n.IsRead))
                    {
                        <span class="sdh-notif-unread-badge">@_notifications.Count(n => !n.IsRead)</span>
                    }
                </div>

                @if (_notificationsLoading)
                {
                    <div class="sdh-notif-loading">
                        <div class="sdh-notif-spinner"></div>
                    </div>
                }
                else if (_notifications.Count == 0)
                {
                    <div class="sdh-notif-empty">
                        <span class="oi oi-bell sdh-notif-empty-icon" aria-hidden="true"></span>
                        <p class="sdh-notif-empty-text">אין התראות חדשות</p>
                    </div>
                }
                else
                {
                    <div class="sdh-notif-list">
                        @foreach (var n in _notifications.Take(5))
                        {
                            var notif = n;
                            <div class="sdh-notif-item @(notif.IsRead ? "" : "sdh-notif-item-unread")"
                                 @onclick="@(() => HandleNotifClick(notif))"
                                 role="button" tabindex="0">
                                <div class="sdh-notif-item-icon sdh-notif-icon-@NotifIconClass(notif.Type)">
                                    <span class="oi @NotifIcon(notif.Type)" aria-hidden="true"></span>
                                </div>
                                <div class="sdh-notif-item-body">
                                    <div class="sdh-notif-item-title">@notif.Title</div>
                                    <div class="sdh-notif-item-time">@NotifTime(notif.CreatedAt)</div>
                                </div>
                                @if (!notif.IsRead)
                                {
                                    <span class="sdh-notif-unread-dot"></span>
                                }
                            </div>
                        }
                    </div>
                }
            </div>

        </div>
    </div>
}

@code {
    [Parameter, EditorRequired] public ProjectInfoDto?                    Project              { get; set; }
    [Parameter, EditorRequired] public List<MilestoneSummaryDto>          Milestones           { get; set; } = default!;
    [Parameter, EditorRequired] public List<OpenRequestDto>               OpenRequests         { get; set; } = new();
    [Parameter]                 public EventCallback                       OnOpenProjectDetails { get; set; }
    [Parameter]                 public EventCallback<MilestoneSummaryDto> OnOpenMilestone      { get; set; }
    [Parameter]                 public EventCallback<int>                  OnOpenTask           { get; set; }

    // ── Team tasks count (kept for completeness even though the aside no longer
    // shows the tile — still used internally if needed in future).
    private List<TeamTaskDto> _teamTasks = new();

    // ── Notifications for the aside panel ────────────────────────────────────
    private List<NotificationDto> _notifications      = new();
    private bool                  _notificationsLoading = true;

    protected override async Task OnInitializedAsync()
    {
        _teamTasks    = await TeamTasksService.GetAsync();
        _notifications = await NotificationService.GetRecentAsync();
        _notificationsLoading = false;
    }

    // ── Track helpers: continuous line behind milestone circles ──────────────

    // Inset from each physical edge so the track starts/ends at circle centers.
    // Each of the N equal columns is (100/N)% wide; the circle center sits at
    // (100/N)/2 % from each column's edge.
    private string TrackInset =>
        Milestones.Count > 0
            ? $"{100.0 / Milestones.Count / 2.0:F2}%"
            : "0%";

    // Width of the filled (gradient) portion as % of total track length.
    // With C steps completed, the filled portion covers C of the (N-1) gaps
    // (from step-0 center to step-C center, i.e. C/(N-1) of the track).
    // Clamped to [0, 100] so a full-completion state doesn't exceed the track.
    private double TrackFilledPct
    {
        get
        {
            var n = Milestones.Count;
            if (n <= 1) return 0.0;
            var c = Milestones.Count(m => m.Status == "Completed");
            return Math.Min(100.0, (double)Math.Min(c, n - 1) / (n - 1) * 100.0);
        }
    }

    // UI-only label mapping: the first stage was administratively renamed.
    // Only the display label changes — DTOs, API, and business logic are untouched.
    private static string DisplayTitle(string title) =>
        title == "בחירת פרויקט" ? "שיבוץ לפרויקט" : title;

    // ── Current milestone — same priority chain as ProjectJourneyCard ─────────
    private MilestoneSummaryDto? _current =>
        Milestones.FirstOrDefault(m => m.IsCurrentlyOpen && m.Status == "InProgress")
        ?? Milestones.FirstOrDefault(m => m.IsCurrentlyOpen)
        ?? Milestones.FirstOrDefault(m => m.Status == "InProgress")
        ?? Milestones.FirstOrDefault(m => m.Status != "Completed");

    // ── Timeline stage state: completed / current / future ────────────────────
    private string StageState(MilestoneSummaryDto m)
    {
        if (m.Status == "Completed") return "completed";
        if (_current is not null && m.ProjectMilestoneId == _current.ProjectMilestoneId) return "current";
        return "future";
    }

    // ── General-status metrics ──────────────────────────────────────────────
    private int _activeTasksCount =>
        Milestones.SelectMany(m => m.Tasks).Count(t => !IsComplete(t));

    // Mirrors ActionCenterCard.BuildItems' overdue condition exactly, so the
    // count agrees with what the exceptions list below actually flags.
    private int _overdueCount =>
        Milestones.SelectMany(m => m.Tasks).Count(t =>
            t.DueDate.HasValue
            && t.DueDate.Value.Date < DateTime.Today
            && !IsComplete(t)
            && t.Status is "Open" or "InProgress" or "ReturnedForRevision");

    private int _teamTasksCount => _teamTasks.Count(t => !t.IsDone);

    private int _completedCount => Milestones.Count(m => m.Status == "Completed");
    private int _overallPct     => Milestones.Count == 0 ? 0 : _completedCount * 100 / Milestones.Count;

    // ── Next upcoming submission across all milestones ────────────────────────
    private TaskSummaryDto? _nextSubmission =>
        Milestones
            .SelectMany(m => m.Tasks.Select(t => (Milestone: m, Task: t)))
            .Where(x => x.Task.IsSubmission && !IsComplete(x.Task) && x.Task.DueDate.HasValue)
            .OrderBy(x => x.Task.DueDate)
            .Select(x => x.Task)
            .FirstOrDefault();

    private MilestoneSummaryDto? _nextSubmissionMilestone =>
        _nextSubmission is null ? null
            : Milestones.FirstOrDefault(m => m.Tasks.Any(t => t.Id == _nextSubmission.Id));

    private int? _nextSubDays =>
        _nextSubmission?.DueDate is { } d ? (int)(d.Date - DateTime.Today).TotalDays : null;

    // First incomplete task in current milestone (CTA fallback)
    private TaskSummaryDto? _nextActionableTask =>
        _current?.Tasks.FirstOrDefault(t => !IsComplete(t) && t.IsSubmission)
        ?? _current?.Tasks.FirstOrDefault(t => !IsComplete(t));

    // ── Helpers ───────────────────────────────────────────────────────────────

    private static bool IsComplete(TaskSummaryDto t) =>
        t.IsSubmission
            ? t.LatestSubmissionStatus is not null
              && t.LatestMentorStatus == "Approved"
              && t.LatestMoodleConfirmed
            : t.Status == "Done";

    // ── Submission status — one resolved phrase replacing the old 3-row
    // pipeline. Losslessly re-encodes the same 3 booleans (file submitted /
    // mentor approved / Moodle confirmed) as a single sentence, and — unlike
    // the old checklist — makes "returned, act now" visually distinct from
    // "pending review, just wait" instead of rendering both as an unchecked
    // circle. Mirrors UpcomingSubmissionsCard.ResolveStatus's precedence.
    private static string SubmissionStatusLabel(TaskSummaryDto t)
    {
        if (t.LatestMentorStatus == "Returned")       return "הוחזר לתיקון ע\"י המנחה";
        if (t.LatestSubmissionStatus == "NeedsRevision") return "הוחזר לתיקון";
        if (t.LatestSubmissionStatus is null)          return "טרם הוגש";
        if (t.LatestMentorStatus == "Approved")        return "אושר ע\"י מנחה · ממתין לאישור מודל";
        return "הוגש · ממתין לאישור מנחה";
    }

    private static MStatusBadge.BadgeVariant SubmissionStatusVariant(TaskSummaryDto t)
    {
        if (t.LatestMentorStatus == "Returned" || t.LatestSubmissionStatus == "NeedsRevision")
            return MStatusBadge.BadgeVariant.Danger;
        if (t.LatestSubmissionStatus is null)
            return MStatusBadge.BadgeVariant.Neutral;
        if (t.LatestMentorStatus == "Approved")
            return MStatusBadge.BadgeVariant.Success;
        return MStatusBadge.BadgeVariant.Info;
    }

    private static string DaysClass(int days) =>
        days < 0 ? "sdh-chip-overdue"
        : days <= 3 ? "sdh-chip-urgent"
        : days <= 7 ? "sdh-chip-soon"
        : "sdh-chip-normal";

    private static string DaysText(int days) =>
        days < 0  ? $"{-days} ימים באיחור"
        : days == 0 ? "היום"
        : days == 1 ? "מחר"
        : $"נותרו {days} ימים";

    private async Task OpenNextTask()
    {
        var taskId = _nextSubmission?.Id ?? _nextActionableTask?.Id;
        if (taskId.HasValue)
            await OnOpenTask.InvokeAsync(taskId.Value);
    }

    // ── Notification helpers ──────────────────────────────────────────────────

    private void HandleNotifClick(NotificationDto n)
    {
        if (!n.IsRead)
        {
            // Optimistic mark-read (fire-and-forget; no await in a sync method)
            _ = NotificationService.MarkReadAsync(n.Id);
            n.IsRead = true;
        }

        string? url = GetNotifUrl(n);
        if (!string.IsNullOrEmpty(url))
            Nav.NavigateTo(url);
    }

    private static string? GetNotifUrl(NotificationDto n)
    {
        if (n.Type == "SubmissionReceived") return "mentor/submissions";
        if (n.Type == "SubmissionReturned")
            return n.RelatedEntityId.HasValue ? $"tasks?taskId={n.RelatedEntityId}" : "tasks";
        return n.RelatedEntityType switch
        {
            "ProjectRequest" => n.RelatedEntityId.HasValue
                ? $"requests?requestId={n.RelatedEntityId}"
                : "requests",
            "TaskSubmission" => "submissions",
            _ => null,
        };
    }

    private static string NotifIconClass(string type) => type switch
    {
        "SubmissionReceived" => "received",
        "SubmissionReturned" => "returned",
        "RequestReturned"    => "returned",
        _                    => "general",
    };

    private static string NotifIcon(string type) => type switch
    {
        "SubmissionReceived" => "oi-data-transfer-upload",
        "SubmissionReturned" => "oi-arrow-circle-left",
        "RequestReturned"    => "oi-loop-circular",
        _                    => "oi-bell",
    };

    private static string NotifTime(DateTime dt)
    {
        var utc  = dt.Kind == DateTimeKind.Utc ? dt : DateTime.SpecifyKind(dt, DateTimeKind.Utc);
        var diff = DateTime.UtcNow - utc;
        if (diff.TotalMinutes < 1) return "הרגע";
        if (diff.TotalMinutes < 60) return $"לפני {(int)diff.TotalMinutes} דקות";
        if (diff.TotalHours   < 24) return $"לפני {(int)diff.TotalHours} שעות";
        if (diff.TotalDays    < 7)  return $"לפני {(int)diff.TotalDays} ימים";
        return dt.ToString("dd/MM/yy");
    }
}
