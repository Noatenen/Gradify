@using AuthWithAdmin.Shared.AuthSharedModels

@* ─────────────────────────────────────────────────────────────
   StudentDashboardHero — how the finalized Dashboard opens.
   Visual source: design-reference/motiva-student-final/README.md,
   "Dashboard" and "Journey stepper" (Motiva Student dashboard final).

   The finalized screen opens with TWO things, not one band:

     1. an h1 greeting sitting directly on the canvas — no ambient
        band, no context line beside it
     2. a "מסע הפרויקט" section card holding the journey stepper

   That is the whole header. The context the old band carried in a
   two-ended line (current milestone ⟷ overall progress) is now read
   off the stepper itself: the current stage is the only violet one and
   it states its own percentage.

   WHAT MOVED, NOT WHAT WENT
   The expandable per-milestone checklist is gone from here — the
   finalized stepper is one line with one label per stage and no
   disclosure. Nothing was lost: clicking a stage still opens the full
   MilestoneDetailModal, which is the richer view the checklist was
   always a preview of.
   ───────────────────────────────────────────────────────────── *@

@* The wrapper is not decoration: scoped-CSS ::deep needs an element that
   belongs to THIS component to hang off, and both children here are
   components with their own roots. *@
<div class="sdh-open">

    <MPageHeader Variant="MPageHeader.HeaderVariant.Hero"
                 Class="sdh-header"
                 Title="@Greeting" />

@if (Milestones.Count > 0)
{
    <MCard Padding="MCard.CardPadding.Large" Class="sdh-journey">
        <MSectionHeading Text="מסע הפרויקט" Class="sdh-journey-heading">
            <Trailing>
                <span class="sdh-journey-count">@_completedCount מתוך @Milestones.Count אבני דרך הושלמו</span>
            </Trailing>
        </MSectionHeading>

        <MJourneyStepper Stages="@_stages" OnStageClick="OpenMilestoneAt" />
    </MCard>
}

</div>

@code {
    [Parameter, EditorRequired] public List<MilestoneSummaryDto>          Milestones      { get; set; } = new();
    [Parameter]                 public string?                            FirstName       { get; set; }
    [Parameter]                 public EventCallback<MilestoneSummaryDto> OnOpenMilestone { get; set; }

    private MilestoneSummaryDto? _current => StudentDashboardModel.CurrentMilestone(Milestones);

    private int _overallPct => StudentDashboardModel.OverallPercent(Milestones);

    // V4 opens on "בוקר טוב" — a time-of-day greeting, not stored data. The
    // name comes from the cascaded user; the band renders correctly without
    // one rather than showing an empty comma.
    private string Greeting
    {
        get
        {
            var hour = DateTime.Now.Hour;
            var part = hour < 12 ? "בוקר טוב"
                     : hour < 18 ? "צהריים טובים"
                     : "ערב טוב";
            return string.IsNullOrWhiteSpace(FirstName) ? part : $"{part}, {FirstName}";
        }
    }

    private int _completedCount => Milestones.Count(m => m.Status == "Completed");

    /// <summary>The milestones, mapped onto the journey the design draws.
    ///
    /// <para>Exactly one stage can be Current — StudentDashboardModel.CurrentMilestone
    /// is the single source of truth for which, the same one the focus card and
    /// the tasks page read, so the stepper can never disagree with them about
    /// where the project is.</para></summary>
    private IReadOnlyList<MJourneyStepper.JourneyStage> _stages =>
        Milestones
            .Select(m => new MJourneyStepper.JourneyStage(
                Label:   m.Title,
                State:   StateOf(m),
                Percent: StateOf(m) == MJourneyStepper.JourneyState.Current ? PercentOf(m) : 0))
            .ToList();

    private MJourneyStepper.JourneyState StateOf(MilestoneSummaryDto m)
    {
        if (m.Status == "Completed") return MJourneyStepper.JourneyState.Complete;
        if (_current is not null && m.ProjectMilestoneId == _current.ProjectMilestoneId)
            return MJourneyStepper.JourneyState.Current;
        return MJourneyStepper.JourneyState.Future;
    }

    /// <summary>Completion of the current stage, from its own tasks. A stage
    /// with no tasks reports 0 rather than 100 — "nothing to do yet" is not
    /// "finished", and showing it full would misreport the project.</summary>
    private static int PercentOf(MilestoneSummaryDto m)
    {
        if (m.Tasks.Count == 0) return 0;
        var done = m.Tasks.Count(StudentDashboardModel.IsComplete);
        return (int)Math.Round(done * 100.0 / m.Tasks.Count);
    }

    // Clicking the dot itself opens the full milestone detail — the richer
    // view (dates, every task's submission state, what caused an attention
    // flag) that the inline checklist deliberately does not duplicate.
    private Task OpenMilestoneAt(int index) =>
        index >= 0 && index < Milestones.Count
            ? OnOpenMilestone.InvokeAsync(Milestones[index])
            : Task.CompletedTask;
}
