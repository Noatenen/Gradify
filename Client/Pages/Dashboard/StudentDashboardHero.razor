@using AuthWithAdmin.Shared.AuthSharedModels

@* ─────────────────────────────────────────────────────────────
   StudentDashboardHero — the finalized Dashboard's ambient hero band.
   Visual source: design-reference/motiva/project/Motiva Student
   Dashboard V4.dc.html:85-126.

   V4 opens the page on a full-bleed ambient band carrying exactly three
   things, in this order:
     1. the greeting              (17px/700, quiet — not a page title)
     2. a two-ended context line  (current milestone ⟷ overall progress)
     3. the milestone stepper     + one label per step, the active one
                                    expandable into a task checklist

   It is rendered with MPageHeader Variant="Hero" — the variant built in
   Phase 3 from this exact band (ambient-hero wash, 40/30 block padding,
   the greeting styled quieter than a page title) and unused until now.

   READ-ONLY CHECKLIST (decision M.3): V4's prototype lets a student tick a
   project task done straight from this list. No API supports that — project
   tasks complete through the submission pipeline (submit → mentor approve →
   Moodle confirm), never a checkbox. The list therefore renders the real
   completion state and nothing more. Richer milestone detail stays reachable
   through the existing MilestoneDetailModal, opened from the stepper dot.
   ───────────────────────────────────────────────────────────── *@

<div class="sdh-bleed">
    <MPageHeader Variant="MPageHeader.HeaderVariant.Hero"
                 Class="sdh-header"
                 Title="@Greeting">
        <SubtitleContent>
            <div class="sdh-context">
                <span class="sdh-context-milestone">
                    @if (_current is not null)
                    {
                        <strong class="sdh-context-label">אבן דרך נוכחית:</strong>
                        <span class="sdh-context-value">@_current.Title</span>
                    }
                    else
                    {
                        <span class="sdh-context-value">לא נמצאה אבן דרך פעילה בפרויקט</span>
                    }
                </span>

                @if (Milestones.Count > 0)
                {
                    <span class="sdh-context-progress">
                        <strong class="sdh-progress-label">התקדמות כללית</strong>
                        <span class="sdh-progress-sep" aria-hidden="true"></span>
                        <strong class="sdh-progress-value">@_overallPct%</strong>
                    </span>
                }
            </div>
        </SubtitleContent>

        <ChildContent>
            @if (Milestones.Count > 0)
            {
                <MProgressStepper Steps="@_steps"
                                  AriaLabel="מסלול אבני הדרך"
                                  OnSelect="OpenMilestoneAt">
                    <LabelTemplate Context="cell">
                        @{
                            var milestone = Milestones[cell.Index];
                            var hasTasks  = milestone.Tasks.Count > 0;
                            var isOpen    = _openMilestoneId == milestone.ProjectMilestoneId && hasTasks;
                        }
                        <button type="button"
                                class="sdh-ms-label @(cell.Step.State == MProgressStepper.StepState.Current ? "sdh-ms-label-current" : "")"
                                title="@milestone.Title"
                                disabled="@(!hasTasks)"
                                aria-expanded="@(hasTasks ? (isOpen ? "true" : "false") : null)"
                                aria-controls="@(hasTasks ? ChecklistId : null)"
                                @onclick="@(() => ToggleMilestone(milestone.ProjectMilestoneId))">
                            <span class="sdh-ms-label-text">@milestone.Title</span>
                            @if (hasTasks)
                            {
                                <span class="sdh-ms-chevron @(isOpen ? "sdh-ms-chevron-open" : "")" aria-hidden="true">▾</span>
                            }
                        </button>
                    </LabelTemplate>
                </MProgressStepper>

                @*
                    ── Expanded checklist ──
                    DELIBERATE DEVIATION FROM V4: the Design nests this panel
                    inside the milestone's own stepper column, which works only
                    because its prototype has exactly four columns. Real projects
                    here run to fourteen milestones, where a column is ~72px and
                    an in-column checklist is unreadable. The panel is therefore
                    full width, directly under the rail, and names the milestone
                    it belongs to. The interaction V4 specifies — click a stage
                    label, reveal that stage's tasks inline, read-only — is
                    unchanged.
                *@
                @if (_openMilestone is { } open)
                {
                    <div class="sdh-ms-panel" id="@ChecklistId">
                        <p class="sdh-ms-panel-title">@open.Title</p>
                        <ul class="sdh-ms-tasklist">
                            @foreach (var task in open.Tasks)
                            {
                                var done = StudentDashboardModel.IsComplete(task);
                                <li class="sdh-ms-task">
                                    <span class="sdh-ms-check @(done ? "sdh-ms-check-done" : "")" aria-hidden="true">
                                        @(done ? "✓" : "")
                                    </span>
                                    <span class="sdh-ms-task-title @(done ? "sdh-ms-task-done" : "")">@task.Title</span>
                                    <span class="sdh-sr-only">@(done ? "הושלם" : "טרם הושלם")</span>
                                </li>
                            }
                        </ul>
                    </div>
                }
            }
        </ChildContent>
    </MPageHeader>
</div>

@code {
    [Parameter, EditorRequired] public List<MilestoneSummaryDto>          Milestones      { get; set; } = new();
    [Parameter]                 public string?                            FirstName       { get; set; }
    [Parameter]                 public EventCallback<MilestoneSummaryDto> OnOpenMilestone { get; set; }

    private const string ChecklistId = "sdh-milestone-tasks";

    /// <summary>Which milestone's checklist is expanded. One at a time, the
    /// Design's own toggle semantics.</summary>
    private int? _openMilestoneId;

    private MilestoneSummaryDto? _openMilestone =>
        _openMilestoneId is { } id
            ? Milestones.FirstOrDefault(m => m.ProjectMilestoneId == id && m.Tasks.Count > 0)
            : null;

    private MilestoneSummaryDto? _current => StudentDashboardModel.CurrentMilestone(Milestones);

    private int _overallPct => StudentDashboardModel.OverallPercent(Milestones);

    // V4 opens on "בוקר טוב" — a time-of-day greeting, not stored data. The
    // name comes from the cascaded user; the band renders correctly without
    // one rather than showing an empty comma.
    private string Greeting
    {
        get
        {
            var hour = DateTime.Now.Hour;
            var part = hour < 12 ? "בוקר טוב"
                     : hour < 18 ? "צהריים טובים"
                     : "ערב טוב";
            return string.IsNullOrWhiteSpace(FirstName) ? part : $"{part}, {FirstName}";
        }
    }

    private IReadOnlyList<MProgressStepper.Step> _steps =>
        Milestones
            .Select(m => new MProgressStepper.Step(m.Title, StateOf(m)))
            .ToList();

    private MProgressStepper.StepState StateOf(MilestoneSummaryDto m)
    {
        if (m.Status == "Completed") return MProgressStepper.StepState.Done;
        if (_current is not null && m.ProjectMilestoneId == _current.ProjectMilestoneId)
            return MProgressStepper.StepState.Current;
        return MProgressStepper.StepState.Upcoming;
    }

    private void ToggleMilestone(int projectMilestoneId) =>
        _openMilestoneId = _openMilestoneId == projectMilestoneId ? null : projectMilestoneId;

    // Clicking the dot itself opens the full milestone detail — the richer
    // view (dates, every task's submission state, what caused an attention
    // flag) that the inline checklist deliberately does not duplicate.
    private Task OpenMilestoneAt(int index) =>
        index >= 0 && index < Milestones.Count
            ? OnOpenMilestone.InvokeAsync(Milestones[index])
            : Task.CompletedTask;
}
