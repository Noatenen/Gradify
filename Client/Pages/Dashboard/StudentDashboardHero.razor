    // ── Notification helpers ──────────────────────────────────────────────────

    private void HandleNotifClick(NotificationDto n)
    {
        if (!n.IsRead)
        {
            // Optimistic mark-read (fire-and-forget; no await in a sync method)
            _ = NotificationService.MarkReadAsync(n.Id);
            n.IsRead = true;
        }

        string? url = GetNotifUrl(n);
        if (!string.IsNullOrEmpty(url))
            Nav.NavigateTo(url);
    }

    private static string? GetNotifUrl(NotificationDto n)
    {
        if (n.Type == "SubmissionReceived") return "mentor/submissions";
        if (n.Type == "SubmissionReturned")
            return n.RelatedEntityId.HasValue ? $"tasks?taskId={n.RelatedEntityId}" : "tasks";
        return n.RelatedEntityType switch
        {
            "ProjectRequest" => n.RelatedEntityId.HasValue
                ? $"requests?requestId={n.RelatedEntityId}"
                : "requests",
            "TaskSubmission" => "submissions",
            _ => null,
        };
    }

    private static string NotifIconClass(string type) => type switch
    {
        "SubmissionReceived" => "received",
        "SubmissionReturned" => "returned",
        "RequestReturned"    => "returned",
        _                    => "general",
    };

    private static string NotifIcon(string type) => type switch
    {
        "SubmissionReceived" => "oi-data-transfer-upload",
        "SubmissionReturned" => "oi-arrow-circle-left",
        "RequestReturned"    => "oi-loop-circular",
        _                    => "oi-bell",
    };

    private static string NotifTime(DateTime dt)
    {
        var utc  = dt.Kind == DateTimeKind.Utc ? dt : DateTime.SpecifyKind(dt, DateTimeKind.Utc);
        var diff = DateTime.UtcNow - utc;
        if (diff.TotalMinutes < 1) return "הרגע";
        if (diff.TotalMinutes < 60) return $"לפני {(int)diff.TotalMinutes} דקות";
        if (diff.TotalHours   < 24) return $"לפני {(int)diff.TotalHours} שעות";
        if (diff.TotalDays    < 7)  return $"לפני {(int)diff.TotalDays} ימים";
        return dt.ToString("dd/MM/yy");
    }
