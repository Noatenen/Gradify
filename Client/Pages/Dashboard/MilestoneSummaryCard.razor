@using AuthWithAdmin.Shared.AuthSharedModels

<!-- ══════════════════════════════════════════════════════════════
     MilestoneSummaryCard
     Shows the current milestone's state: name, date window, days
     remaining, and official task completion ratio. A single CTA
     opens the MilestoneDetailModal (hosted in Dashboard.razor).

     Personal tasks are NOT shown here — that data is not yet in
     DashboardDto. TODO: add when personal-task support is built.
     ══════════════════════════════════════════════════════════════ -->

<div class="msc-card @(_hasIssue ? "msc-card-attention" : "")">

    @if (CurrentMilestone is null)
    {
        <div class="msc-empty">
            <span class="oi oi-map msc-empty-icon" aria-hidden="true"></span>
            <p class="msc-empty-text">אין אבן דרך פעילה כרגע</p>
        </div>
    }
    else
    {
        <!-- ── Status dot + label ── -->
        <div class="msc-top-row">
            <span class="msc-label">אבן דרך נוכחית</span>
            <span class="msc-status-pill msc-pill-@_dotClass">@_statusLabel</span>
        </div>

        <!-- ── Milestone title ── -->
        <h2 class="msc-title">@CurrentMilestone.Title</h2>

        <!-- ── Date range ── -->
        @if (CurrentMilestone.OpenDate.HasValue || CurrentMilestone.DueDate.HasValue)
        {
            <div class="msc-dates">
                @if (CurrentMilestone.OpenDate.HasValue)
                {
                    <span class="msc-date-item">
                        <span class="oi oi-calendar msc-date-icon" aria-hidden="true"></span>
                        @CurrentMilestone.OpenDate.Value.ToString("dd/MM/yy")
                    </span>
                    <span class="msc-date-arrow" aria-hidden="true">←</span>
                }
                @if (CurrentMilestone.DueDate.HasValue)
                {
                    <span class="msc-date-item msc-date-due">
                        @CurrentMilestone.DueDate.Value.ToString("dd/MM/yy")
                    </span>
                }
            </div>
        }

        <!-- ── Days remaining badge ── -->
        @if (_daysRemaining.HasValue)
        {
            <div class="msc-days-row">
                <span class="msc-days-badge @DaysClass()">@DaysLabel()</span>
            </div>
        }

        <!-- ── Task completion ── -->
        <div class="msc-tasks-row">
            <div class="msc-task-track" role="progressbar"
                 aria-valuenow="@_taskPercent" aria-valuemin="0" aria-valuemax="100"
                 aria-label="השלמת משימות">
                <div class="msc-task-fill" style="width: @_taskPercent%"></div>
            </div>
            <span class="msc-task-ratio">
                <span class="msc-task-done">@_completedTasks</span>/<span class="msc-task-total">@_totalTasks</span>
                <span class="msc-task-label">משימות רשמיות</span>
            </span>
        </div>

        @* TODO: personal tasks count — add when DashboardDto includes personal tasks.
           Example placeholder:
           <div class="msc-personal-row">
               <span class="oi oi-list" aria-hidden="true"></span>
               <span>X/Y משימות אישיות</span>
           </div>
        *@

        <!-- ── Primary CTA ── -->
        <button class="msc-cta" @onclick="@(() => OnOpenDetail.InvokeAsync(CurrentMilestone))">
            <span class="oi oi-eye msc-cta-icon" aria-hidden="true"></span>
            פתיחת אבן הדרך
            <span class="oi oi-chevron-left msc-cta-arrow" aria-hidden="true"></span>
        </button>
    }

</div>

@code {
    [Parameter] public MilestoneSummaryDto?              CurrentMilestone { get; set; }
    [Parameter] public EventCallback<MilestoneSummaryDto> OnOpenDetail    { get; set; }
    [Parameter] public EventCallback<int>                 OnOpenTask      { get; set; }

    private int _totalTasks     => CurrentMilestone?.Tasks.Count ?? 0;
    private int _completedTasks => CurrentMilestone?.Tasks.Count(IsComplete) ?? 0;
    private int _taskPercent    =>
        _totalTasks > 0 ? (int)Math.Round((double)_completedTasks / _totalTasks * 100) : 0;

    private int? _daysRemaining =>
        CurrentMilestone?.DueDate.HasValue == true
            ? Math.Max(0, (int)(CurrentMilestone!.DueDate!.Value.Date - DateTime.Today).TotalDays)
            : null;

    private bool _hasIssue => CurrentMilestone?.Tasks.Any(TaskIsProblematic) == true;

    private string _dotClass => _hasIssue ? "attention" : StatusClass(CurrentMilestone?.Status ?? "");

    private string _statusLabel => _hasIssue
        ? "דורש תשומת לב"
        : StatusLabel(CurrentMilestone?.Status ?? "");

    private static bool TaskIsProblematic(TaskSummaryDto t) =>
        t.LatestMentorStatus == "Returned"
        || t.LatestSubmissionStatus == "NeedsRevision"
        || (t.DueDate.HasValue && t.DueDate.Value.Date < DateTime.Today
            && t.Status is "Open" or "InProgress" or "ReturnedForRevision");

    private static bool IsComplete(TaskSummaryDto t) =>
        t.IsSubmission
            ? t.LatestSubmissionStatus is not null
              && t.LatestMentorStatus == "Approved"
              && t.LatestMoodleConfirmed
            : t.Status == "Done";

    private string DaysLabel()
    {
        if (!_daysRemaining.HasValue) return "";
        int d = _daysRemaining.Value;
        return d switch { 0 => "היום!", 1 => "נותר יום", _ => $"נותרו {d} ימים" };
    }

    private string DaysClass()
    {
        if (!_daysRemaining.HasValue) return "msc-days-normal";
        int d = _daysRemaining.Value;
        if (d <= 0) return "msc-days-overdue";
        if (d <= 3) return "msc-days-urgent";
        if (d <= 7) return "msc-days-soon";
        return "msc-days-normal";
    }

    private static string StatusClass(string s) => s switch
    {
        "Completed"  => "completed",
        "InProgress" => "inprogress",
        "Delayed"    => "delayed",
        _            => "notstarted",
    };

    private static string StatusLabel(string s) => s switch
    {
        "Completed"  => "הושלם",
        "InProgress" => "בתהליך",
        "Delayed"    => "באיחור",
        _            => "טרם החל",
    };
}
