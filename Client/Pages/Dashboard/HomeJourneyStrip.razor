@using AuthWithAdmin.Shared.AuthSharedModels
@inject NavigationManager Nav

@*
    HomeJourneyStrip — Home Page Layer B ("Project Journey").

    Data source: GET /api/roadmap-stages/my-progress (IRoadmapStagesService,
    already used by StudentStagesPage — no new endpoint). Deliberately compact:
    per the approved Home Page design (design/motiva-home-page-v5.html), this
    section provides context and must not visually outweigh the Focus card
    below it — smaller dots, tighter card, one progress number shown once.
*@

@if (Progress is not null && Progress.Stages.Count > 0)
{
    <section class="hjs">
        <div class="hjs-header">
            <div class="hjs-label">
                <span class="oi oi-graph" aria-hidden="true"></span>
                המסלול שלך
            </div>
            <span class="hjs-link" @onclick="@(() => Nav.NavigateTo("/project-stages"))">לצפייה במסלול המלא ←</span>
        </div>

        <div class="hjs-card">
            <div class="hjs-timeline">
                @foreach (var (stage, index) in Progress.Stages.OrderBy(s => s.DisplayOrder).Select((s, i) => (s, i)))
                {
                    @if (index > 0)
                    {
                        <div class="hjs-connector @(Progress.Stages.OrderBy(s => s.DisplayOrder).ElementAt(index - 1).Status == RoadmapStageStatuses.Completed ? "hjs-connector-done" : "")"></div>
                    }
                    <div class="hjs-step @(stage.Status == RoadmapStageStatuses.Current ? "hjs-step-current" : "")">
                        <div class="hjs-dot @DotClass(stage.Status)">
                            @if (stage.Status == RoadmapStageStatuses.Completed)
                            {
                                <span class="oi oi-check" aria-hidden="true"></span>
                            }
                        </div>
                        <span class="hjs-step-label">@stage.Name</span>
                    </div>
                }
            </div>

            @if (CurrentStage is not null)
            {
                <div class="hjs-summary">
                    <div class="hjs-summary-left">
                        <span class="hjs-summary-dot"></span>
                        <span class="hjs-summary-stage">שלב @(CurrentStage.DisplayOrder) מתוך @(Progress.Stages.Count) — @CurrentStage.Name</span>
                        <span class="hjs-summary-detail">· @CurrentStage.CompletedMilestoneCount מתוך @CurrentStage.LinkedMilestoneCount תוצרים הושלמו</span>
                    </div>
                    <div class="hjs-summary-right">
                        <div class="hjs-track"><div class="hjs-fill" style="width:@(Progress.CurrentStageProgressPct ?? 0)%"></div></div>
                        <span class="hjs-pct">@(Progress.CurrentStageProgressPct ?? 0)%</span>
                        <span class="hjs-overall">(@(Progress.OverallProjectProgressPct)% מכלל הפרויקט)</span>
                    </div>
                </div>
            }
        </div>
    </section>
}

@code {
    [Parameter] public ProjectRoadmapProgressDto? Progress { get; set; }

    private StageProgressDto? CurrentStage =>
        Progress?.Stages.FirstOrDefault(s => s.Status == RoadmapStageStatuses.Current);

    private static string DotClass(string status) => status switch
    {
        RoadmapStageStatuses.Completed => "hjs-dot-done",
        RoadmapStageStatuses.Current   => "hjs-dot-current",
        _                              => "hjs-dot-future",
    };
}
