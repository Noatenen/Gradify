@using AuthWithAdmin.Shared.AuthSharedModels

<!-- ══════════════════════════════════════════════════════════════
     DashboardHero — the single visual focal point of the dashboard.

     Answers all four questions in one scan:
       1. Where am I?         → milestone title + position
       2. How far along?      → progress bar + task count
       3. How long do I have? → days-remaining block
       4. What comes next?    → next milestone hint + CTA

     Visual intent: large typography carries the hierarchy.
     No inner grid — one column, top to bottom, breathing room.
     ══════════════════════════════════════════════════════════════ -->

<div class="dh-panel @HeroPanelClass()">

    <!-- ── Identity row (project context + details link) ── -->
    <div class="dh-identity">
        <span class="dh-project-tag">
            <span class="oi oi-briefcase dh-project-icon" aria-hidden="true"></span>
            פרויקט @Project.ProjectNumber · @Project.Title
        </span>
        <button class="dh-details-btn"
                @onclick="@(() => OnOpenProjectDetails.InvokeAsync())"
                title="פרטי הפרויקט המלאים">
            פרטי הפרויקט
            <span class="oi oi-chevron-left dh-details-arrow" aria-hidden="true"></span>
        </button>
    </div>

    @if (_current is not null)
    {
        <!-- ── Title row: milestone name (large) + days block ── -->
        <div class="dh-title-row">

            <div class="dh-title-group">
                <h1 class="dh-ms-title">@_current.Title</h1>
                <div class="dh-subtitle">
                    @if (_milestoneIndex > 0)
                    {
                        <span class="dh-position">שלב @_milestoneIndex מתוך @Milestones.Count</span>
                    }
                    @if (_next is not null)
                    {
                        <span class="dh-subtitle-sep" aria-hidden="true">·</span>
                        <span class="dh-next-hint">
                            <span class="oi oi-arrow-left dh-next-icon" aria-hidden="true"></span>
                            הבא: @_next.Title
                        </span>
                    }
                </div>
            </div>

            @if (_daysRemaining.HasValue)
            {
                <div class="dh-days-block @DaysBlockClass()" aria-label="@DaysAriaLabel()">
                    @if (_daysRemaining.Value == 0)
                    {
                        <span class="dh-days-today">היום!</span>
                    }
                    else if (_daysRemaining.Value < 0)
                    {
                        <span class="dh-days-num dh-days-num-late">@Math.Abs(_daysRemaining.Value)</span>
                        <span class="dh-days-label">ימים באיחור</span>
                    }
                    else
                    {
                        <span class="dh-days-num">@_daysRemaining.Value</span>
                        <span class="dh-days-label">ימים נותרו</span>
                    }
                </div>
            }

        </div>

        <!-- ── Progress bar + meta ── -->
        @if (_taskTotal > 0)
        {
            <div class="dh-progress-section">
                <div class="dh-progress-track"
                     role="progressbar"
                     aria-valuenow="@_taskPercent"
                     aria-valuemin="0"
                     aria-valuemax="100"
                     aria-label="התקדמות משימות אבן הדרך הנוכחית">
                    <div class="dh-progress-fill" style="width: @_taskPercent%"></div>
                </div>
                <div class="dh-progress-meta">
                    <span class="dh-progress-text">@_taskDone מתוך @_taskTotal משימות הושלמו</span>
                    <span class="dh-progress-pct">@_taskPercent%</span>
                </div>
            </div>
        }

        <!-- ── Primary CTA ── -->
        <div class="dh-cta-row">
            <button class="dh-cta-primary"
                    @onclick="@(() => OnOpenMilestone.InvokeAsync(_current))">
                <span class="oi oi-play-circle dh-cta-icon" aria-hidden="true"></span>
                פתיחת אבן הדרך
                <span class="oi oi-chevron-left dh-cta-arrow" aria-hidden="true"></span>
            </button>
        </div>
    }
    else if (Milestones.Any(m => m.Status == "Completed"))
    {
        <!-- All milestones completed -->
        <div class="dh-title-group">
            <h1 class="dh-ms-title">כל השלבים הושלמו</h1>
            <p class="dh-subtitle">הפרויקט הסתיים בהצלחה.</p>
        </div>
    }
    else
    {
        <!-- No milestone data yet -->
        <div class="dh-title-group">
            <h1 class="dh-ms-title">הפרויקט עדיין לא פעיל</h1>
            <p class="dh-subtitle">אבני הדרך טרם הוגדרו. פנה למנחה.</p>
        </div>
    }

</div>

@code {
    [Parameter, EditorRequired] public ProjectInfoDto              Project              { get; set; } = default!;
    [Parameter, EditorRequired] public List<MilestoneSummaryDto>   Milestones           { get; set; } = default!;
    [Parameter]                 public EventCallback               OnOpenProjectDetails { get; set; }
    [Parameter]                 public EventCallback<MilestoneSummaryDto> OnOpenMilestone { get; set; }

    // ── Current milestone ────────────────────────────────────────────────────
    private MilestoneSummaryDto? _current =>
        Milestones.FirstOrDefault(m => m.IsCurrentlyOpen && m.Status == "InProgress")
        ?? Milestones.FirstOrDefault(m => m.IsCurrentlyOpen)
        ?? Milestones.FirstOrDefault(m => m.Status == "InProgress")
        ?? Milestones.FirstOrDefault(m => m.Status != "Completed");

    // ── Next milestone (first non-completed after current, by OrderIndex) ────
    private MilestoneSummaryDto? _next =>
        _current is null ? null
        : Milestones
            .Where(m => m.OrderIndex > _current.OrderIndex && m.Status != "Completed")
            .OrderBy(m => m.OrderIndex)
            .FirstOrDefault();

    // 1-based position of current in the ordered list
    private int _milestoneIndex =>
        _current is null ? 0
        : Milestones.OrderBy(m => m.OrderIndex).ToList().IndexOf(_current) + 1;

    // ── Deadline: prefer DueDate, fall back to CloseDate ────────────────────
    private DateTime? _deadline => _current?.DueDate ?? _current?.CloseDate;

    // Signed: negative means overdue
    private int? _daysRemaining =>
        _deadline.HasValue
            ? (int)(_deadline.Value.Date - DateTime.Today).TotalDays
            : null;

    // ── Task progress for the CURRENT milestone only ─────────────────────────
    private int _taskTotal     => _current?.Tasks.Count ?? 0;
    private int _taskDone      => _current?.Tasks.Count(IsComplete) ?? 0;
    private int _taskPercent   =>
        _taskTotal > 0 ? (int)Math.Round((double)_taskDone / _taskTotal * 100) : 0;

    private bool _hasUrgentIssue => _current?.Tasks.Any(t =>
        t.LatestMentorStatus == "Returned"
        || t.LatestSubmissionStatus == "NeedsRevision"
        || (t.DueDate.HasValue && t.DueDate.Value.Date < DateTime.Today
            && t.Status is "Open" or "InProgress")) == true;

    // ── CSS helpers ──────────────────────────────────────────────────────────
    private string HeroPanelClass() =>
        _hasUrgentIssue                                        ? "dh-panel-attention"
        : (_daysRemaining.HasValue && _daysRemaining.Value < 0) ? "dh-panel-overdue"
        : "";

    private string DaysBlockClass()
    {
        if (!_daysRemaining.HasValue) return "";
        int d = _daysRemaining.Value;
        if (d < 0)  return "dh-days-late";
        if (d <= 3) return "dh-days-urgent";
        if (d <= 7) return "dh-days-soon";
        return "";
    }

    private string DaysAriaLabel()
    {
        if (!_daysRemaining.HasValue) return "";
        int d = _daysRemaining.Value;
        if (d == 0) return "הגשה היום";
        if (d < 0)  return $"באיחור {Math.Abs(d)} ימים";
        return $"נותרו {d} ימים להגשה";
    }

    private static bool IsComplete(TaskSummaryDto t) =>
        t.IsSubmission
            ? t.LatestSubmissionStatus is not null
              && t.LatestMentorStatus == "Approved"
              && t.LatestMoodleConfirmed
            : t.Status == "Done";
}
