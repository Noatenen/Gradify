@page "/dashboard"
@layout AppLayout
@using Microsoft.AspNetCore.Authorization
@using AuthWithAdmin.Shared.AuthSharedModels
@using AuthWithAdmin.Client.Services
@using AuthWithAdmin.Client.Pages.Tasks
@using AuthWithAdmin.Client.Pages.Submissions
@inject IDashboardService DashboardService
@inject ITaskSubmissionsService SubmissionsService
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthStateProvider
@attribute [Authorize]

@*
    ── Student Dashboard ────────────────────────────────────────────────────
    Visual source of truth: design-reference/motiva-student-final
                            (Motiva Student dashboard final)
    Data source of truth:   GET api/projects/my-dashboard  (DashboardDto)
                          + GET api/notifications          (recent updates)
                          + GET api/projects/team-tasks    (team tasks)

    The reference's composition, top to bottom:

        1. h1 greeting + מסע הפרויקט journey stepper   (StudentDashboardHero)
        2. compact two-column row — 1fr / 1.4fr:
             לשים לב (focus)  |  בקשות (open requests)
        3. three-card glance row — team tasks at 1.6x, then two equal cards

    Two deliberate differences from the reference, both documented at their
    site: the glance row has three cards rather than four (the attention
    card that filled the fourth slot is withdrawn — see the note there), and
    the recommended-material section was withdrawn because /learning owns it.
    ─────────────────────────────────────────────────────────────────────── *@

@if (_isLoading)
{
    <div class="sdash-loading" role="status" aria-live="polite">
        <span class="sdash-spinner" aria-hidden="true"></span>
        <span>טוענת נתונים…</span>
    </div>
}
else if (_loadError)
{
    <MEmptyState Title="אירעה שגיאה בטעינת הדשבורד"
                 Description="ייתכן שיש תקלת רשת זמנית. אפשר לנסות שוב.">
        <Action>
            <MButton Variant="MButton.ButtonVariant.Secondary" OnClick="ReloadDashboard">
                נסי שוב
            </MButton>
        </Action>
    </MEmptyState>
}
else if (_data?.Project is null)
{
    <MEmptyState Title="לא שויכת לפרויקט עדיין"
                 Description="פני למנחה שלך להשמת הצוות." />
}
else
{
    <div class="sdash-page">

        @* 1 · HERO *@
        <StudentDashboardHero Milestones="@_milestones"
                              FirstName="@_user?.FirstName"
                              OnOpenMilestone="OpenMilestoneDetail" />

        @* ── ROW 2 — the reference's compact two-column middle section.
             1fr / 1.4fr: the focus card is deliberately the narrower of
             the two, because it holds one item and the requests card
             holds a list. ── *@
        <div class="sdash-row-mid">
            <DashboardFocusCard Milestones="@_milestones"
                                OnOpenTask="OpenDetail"
                                OnOpenLearning="@(() => Nav.NavigateTo("/learning"))" />

            <OpenRequestsCard OpenRequests="@(_data.OpenRequests ?? new())" />
        </div>

        @* ── ROW 3 — the glance row. Three cards now: team tasks at 1.6x
             (its rows carry four columns and genuinely need the width),
             then updates and deadlines equal. ── *@
        <div class="sdash-row-glance">
            <TeamTasksCard TeamMembers="@(_data.TeamMembers ?? new())" />

            <RecentUpdatesSection />

            <UpcomingSubmissionsCard Milestones="@_milestones"
                                     NextDeadline="@_data.NextDeadline"
                                     ExcludeTaskId="@_focusTaskId"
                                     OnOpenTask="OpenDetail" />

            @* ── AttentionItemsCard IS WITHDRAWN FROM THIS ROW ──────────────
                 It was titled "דורש תשומת לב" and sat beside a card titled
                 "דורש התייחסות", which read as two names for one idea even
                 though the two carried different things — task exceptions
                 there, open requests here. The requests card now carries
                 the name and this placement is withdrawn.

                 ONLY THE PLACEMENT. The component, its parameters and
                 StudentDashboardModel.AttentionTasks are all untouched and
                 still compile, exactly as DashboardResourcesSection was
                 left when its placement was withdrawn.

                 WHAT THIS COSTS, STATED PLAINLY: task exceptions —
                 returned, overdue, awaiting Moodle confirmation — no
                 longer appear as a list on the dashboard. The single most
                 pressing one is still on the focus card above, under its
                 own rose "דורש תשומת לב" flag, and the complete list is on
                 /tasks, which has its own independent TaskAttentionSection
                 and a filter tab for it. The deadlines card still excludes
                 those tasks (that filter is logic and was left alone), so
                 /tasks is where they live now. *@
        </div>

        @* The recommended-material section was removed here: the reference
           dashboard has no such block, and every resource it listed is
           reachable from משאבים (/learning), a primary nav destination. The
           component and its API are untouched — only this placement is
           withdrawn, so no functionality leaves the product. *@

    </div>
}

<MilestoneDetailModal Milestone="@_detailMilestone"
                      OnClose="CloseMilestoneDetail"
                      OnOpenTask="OpenTaskFromMilestone" />

<TaskDetailModal TaskId="@_detailTaskId"
                 OnClose="CloseDetail"
                 OnTaskChanged="ReloadDashboard"
                 OnEditMySubmission="OnEditFromDetail"
                 OnDeleteMySubmission="OnDeleteFromDetail"
                 OnMarkMoodleSubmitted="OnMarkMoodleFromDetail" />

@* The submission form and its two confirmations. Same component the tasks
   page mounts, so the student submits without leaving the dashboard. *@
<StudentSubmissionFlow @ref="_submissionFlow" OnChanged="ReloadDashboard" />

@code {
    [CascadingParameter] private User? _user { get; set; }

    private DashboardDto?         _data;
    private bool                  _isLoading = true;
    private bool                  _loadError;
    private int                   _detailTaskId;
    private MilestoneSummaryDto?  _detailMilestone;
    private bool                  _loadStarted;

    private List<MilestoneSummaryDto> _milestones => _data?.Milestones ?? new();

    // The task the focus card shows in full. Passed to the attention band and
    // the deadline list so the same task is never stated twice on one screen —
    // by identity, not by list position, because the focus pick is very often
    // the same task the attention rules flag.
    private int? _focusTaskId => StudentDashboardModel.FocusTask(_milestones)?.Id;

    // The cascading _user is hydrated asynchronously by App.razor, so it can be
    // null on the first parameter-set. The load is gated on _user being
    // available and a flag ensures it only runs once.
    protected override async Task OnParametersSetAsync()
    {
        try
        {
            if (_loadStarted || _user is null)
                return;
            _loadStarted = true;

            // Elevated roles (Mentor / Staff / Admin) that land on the legacy
            // /dashboard route are bounced to their dedicated dashboard. A plain
            // student (explicit "Student" role OR a "User" account that hasn't
            // been elevated) falls through and loads the student dashboard.
            //
            // Role classification is never a reason to error — a non-student
            // with no dedicated landing route simply falls through rather than
            // showing the generic error.
            if (!RoleService.IsStudent(_user))
            {
                var landing = RoleService.GetDefaultLandingRoute(_user);
                if (landing != PageRoutes.Dashboard && landing != "/" + PageRoutes.Dashboard)
                {
                    Nav.NavigateTo(landing, replace: true);
                    return;
                }
            }

            await LoadDashboardAsync();

            // Any student without an assigned project → catalog experience.
            // Covers both: has team but no project, and no team at all.
            if (_data is not null && _data.Project is null)
                Nav.NavigateTo("/" + PageRoutes.StudentCatalog);
        }
        catch (Exception)
        {
            _isLoading = false;
            _loadError = true;
        }
    }

    // Single load path shared by the initial render and the retry button so the
    // two can never drift. It always re-establishes a valid Authorization header
    // (via GetAuthenticationStateAsync) before hitting the API, and it only flags
    // a load error after a BOUNDED set of attempts has been exhausted — never
    // merely because auth/user state was not ready yet on the very first tick.
    //
    // Rationale: the manual "retry" button reliably fixes the cold-load failure,
    // which means whatever transient state was missing on the first attempt is
    // present a moment later. We perform that retry automatically with a small
    // delay so the user never sees the generic error for a transient hiccup, and
    // we never leave the page spinning forever (the loop is bounded).
    private const int MaxLoadAttempts = 5;
    private const int LoadRetryDelayMs = 300;

    private async Task LoadDashboardAsync()
    {
        _isLoading = true;
        _loadError = false;

        for (int attempt = 1; attempt <= MaxLoadAttempts; attempt++)
        {
            try
            {
                // Ensure the Authorization header is set on the shared HttpClient
                // before the API call fires. GetAuthenticationStateAsync sets the
                // header as a side-effect.
                var authState = await AuthStateProvider.GetAuthenticationStateAsync();
                var isAuthenticated = authState.User?.Identity?.IsAuthenticated == true;

                if (!isAuthenticated)
                {
                    // Auth state not ready yet — wait and retry rather than error.
                    if (attempt < MaxLoadAttempts)
                    {
                        await Task.Delay(LoadRetryDelayMs);
                        continue;
                    }
                    _loadError = true;
                    break;
                }

                _data = await DashboardService.GetDashboardAsync();

                if (_data is not null)
                {
                    _loadError = false;
                    break; // success
                }

                // Null data => transient request failure. Retry if budget left.
                if (attempt < MaxLoadAttempts)
                {
                    await Task.Delay(LoadRetryDelayMs);
                    continue;
                }
                _loadError = true;
            }
            catch (Exception)
            {
                if (attempt < MaxLoadAttempts)
                {
                    await Task.Delay(LoadRetryDelayMs);
                    continue;
                }
                _loadError = true;
                _data = null;
            }
        }

        _isLoading = false;
    }

    private void OpenDetail(int taskId)
    {
        _detailTaskId = taskId;
        StateHasChanged();
    }

    private void CloseDetail() => _detailTaskId = 0;

    // ── Milestone detail modal (opened from a stepper dot) ───────────────────
    // The hero's inline checklist answers "which tasks are in this stage, and
    // which are done". This modal is still the way to the richer view — dates,
    // per-task submission state, what caused an attention flag — so the two do
    // not duplicate each other.
    private void OpenMilestoneDetail(MilestoneSummaryDto ms)
    {
        _detailMilestone = ms;
        StateHasChanged();
    }

    private void CloseMilestoneDetail() => _detailMilestone = null;

    // Clicking a task inside the milestone modal reuses the existing
    // TaskDetailModal: close the milestone modal, then open the task one.
    private void OpenTaskFromMilestone(int taskId)
    {
        _detailMilestone = null;
        OpenDetail(taskId);
    }

    // ── Submission flow ──────────────────────────────────────────────────────
    // Submitting is no longer a separate destination OR a separate dialog:
    // TaskDetailModal switches into its own submission state in place, and
    // tells us here when something was actually submitted so the cards reload.
    //
    // What is left of StudentSubmissionFlow is the edit form and the two
    // confirmations, all reached from a row in the submission history.
    private StudentSubmissionFlow? _submissionFlow;

    // Edit / delete / "I submitted in Moodle" are raised by TaskDetailModal for
    // every host. The dashboard used to bind none of them, so those buttons
    // rendered inside the modal and silently did nothing when it was opened
    // from here.
    private void OnEditFromDetail((int TaskId, int SubmissionId, string? DriveUrl, string? Notes) e)
    {
        _detailTaskId = 0;
        _submissionFlow?.OpenEdit(e);
    }

    private void OnDeleteFromDetail(int submissionId)   => _submissionFlow?.RequestDelete(submissionId);

    private void OnMarkMoodleFromDetail(int submissionId) => _submissionFlow?.RequestMoodle(submissionId);

    private async Task ReloadDashboard()
    {
        await LoadDashboardAsync();

        // Mirror the initial-load behaviour: a student with no assigned project
        // belongs in the catalog experience, not the empty dashboard state.
        if (_data is not null && _data.Project is null)
            Nav.NavigateTo("/" + PageRoutes.StudentCatalog);
    }
}
