@page "/dashboard"
@layout AppLayout
@using Microsoft.AspNetCore.Authorization
@using AuthWithAdmin.Shared.AuthSharedModels
@using AuthWithAdmin.Client.Services
@using AuthWithAdmin.Client.Pages.Requests
@using AuthWithAdmin.Client.Pages.Tasks
@inject IDashboardService DashboardService
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthStateProvider
@attribute [Authorize]

<!-- New request modal (hosted at dashboard level) -->
<NewRequestModal IsOpen="@_showNewRequest"
                 OnClose="@(() => _showNewRequest = false)"
                 OnSuccess="ReloadDashboard" />

@if (_isLoading)
{
    <div class="sdash-loading">
        <div class="sdash-spinner"></div>
        <span>טוענת נתונים…</span>
    </div>
}
else if (_loadError)
{
    <div class="sdash-error">
        <span class="oi oi-warning" aria-hidden="true"></span>
        <p>אירעה שגיאה בטעינת הדשבורד. נסי לרענן את הדף.</p>
        <button class="btn btn-primary" @onclick="ReloadDashboard">נסי שוב</button>
    </div>
}
else if (_data?.Project is null)
{
    <div class="sdash-empty">
        <span class="oi oi-info" aria-hidden="true"></span>
        <p>לא שויכת לפרויקט עדיין. פני למנחה שלך להשמת הצוות.</p>
    </div>
}
else
{
    <div class="student-dashboard">

        <!-- Hero: current milestone stage + next submission in one unified card -->
        <StudentDashboardHero Project="@_data.Project"
                              Milestones="@(_data.Milestones ?? new())"
                              OpenRequests="@(_data.OpenRequests ?? new())"
                              OnOpenProjectDetails="OpenProjectDetails"
                              OnOpenMilestone="OpenMilestoneDetail"
                              OnOpenTask="OpenDetail" />

        <!-- Dashboard workspace: ONE surface, three zones — not three
             independent cards, and deliberately not a second "elevated
             card" sitting under the Hero either. A plain panel (background
             + radius only, no shadow/border — the same move already made
             for the Hero's own outer shell) so the page reads as one
             continuous canvas with the Hero's action card as the single
             elevated focal point, not a stack of boxes. Main column (needs
             attention, then what's coming next) and a visibly narrower,
             secondary Team Tasks column share this one panel, separated by
             a quiet vertical divider. Team Tasks stays narrower
             deliberately: it's an informal, student-created list with no
             milestone, no mentor review, and no effect on project
             progress, so it doesn't belong at equal visual weight with the
             project's actual status. -->
        <div class="sdash-workspace">
            <div class="sdash-workspace-main">
                <ActionCenterCard Embedded="true"
                                  Milestones="@(_data.Milestones ?? new())"
                                  OpenRequests="@(_data.OpenRequests ?? new())"
                                  OnOpenTask="OpenDetail" />
                <UpcomingSubmissionsCard Embedded="true"
                                         Milestones="@(_data.Milestones ?? new())"
                                         NextDeadline="@_data.NextDeadline"
                                         OnOpenTask="OpenDetail" />
            </div>
            <div class="sdash-workspace-aside">
                <TeamTasksCard Embedded="true" TeamMembers="@(_data.TeamMembers ?? new())" />
            </div>
        </div>

    </div>
}

<!-- Project details modal — ShowCard=false: no banner, modal only.
     Mounted here so Dashboard.razor can open it via @ref from the context strip. -->
@if (_data?.Project is not null)
{
    <ProjectDetailsCard @ref="_projectCard"
                        ShowCard="false"
                        Project="@_data.Project"
                        TeamMembers="@(_data.TeamMembers ?? new())"
                        Mentors="@(_data.Mentors ?? new())" />
}

<MilestoneDetailModal Milestone="@_detailMilestone"
                      OnClose="CloseMilestoneDetail"
                      OnOpenTask="OpenTaskFromMilestone" />

<TaskDetailModal TaskId="@_detailTaskId"
                 OnClose="CloseDetail"
                 OnOpenSubmission="OpenSubmissionFromDetail" />

@code {
    [CascadingParameter] private User? _user { get; set; }

    private DashboardDto? _data;
    private bool _isLoading = true;
    private bool _loadError = false;
    private bool _showNewRequest; // kept — TODO: wire to a dashboard CTA when requests are surfaced
    private int  _detailTaskId;
    private MilestoneSummaryDto? _detailMilestone;
    private bool _loadStarted;

    // @ref to the project details modal (card surface hidden; modal triggered from the hero).
    private ProjectDetailsCard? _projectCard;

    // The cascading _user is hydrated asynchronously by App.razor, so it can
    // be null on the first parameter-set. We gate the load on _user being
    // available and use a flag to ensure we only run once.
    protected override async Task OnParametersSetAsync()
    {
        try
        {
            if (_loadStarted || _user is null)
                return;
            _loadStarted = true;

            var isStudent = RoleService.IsStudent(_user);

            // Elevated roles (Mentor / Staff / Admin) that land on the legacy
            // /dashboard route are bounced to their dedicated dashboard. A plain
            // student (explicit "Student" role OR a "User" account that hasn't
            // been elevated) falls through and loads the student dashboard.
            //
            // Role classification is never a reason to error — a non-student
            // with no dedicated landing route simply falls through and loads
            // the student dashboard rather than showing the generic error.
            if (!isStudent)
            {
                var landing = RoleService.GetDefaultLandingRoute(_user);
                if (landing != PageRoutes.Dashboard && landing != "/" + PageRoutes.Dashboard)
                {
                    Nav.NavigateTo(landing, replace: true);
                    return;
                }
            }

            await LoadDashboardAsync();

            // Any student without an assigned project → catalog experience
            // Covers both: has team but no project, and no team at all.
            if (_data is not null && _data.Project is null)
                Nav.NavigateTo("/" + PageRoutes.StudentCatalog);
        }
        catch (Exception)
        {
            _isLoading = false;
            _loadError = true;
        }
    }

    // Single load path shared by the initial render and the retry button so the
    // two can never drift. It always re-establishes a valid Authorization header
    // (via GetAuthenticationStateAsync) before hitting the API, and it only flags
    // a load error after a BOUNDED set of attempts has been exhausted — never
    // merely because auth/user state was not ready yet on the very first tick.
    //
    // Rationale: the manual "retry" button reliably fixes the cold-load failure,
    // which means whatever transient state was missing on the first attempt is
    // present a moment later. We perform that retry automatically with a small
    // delay so the user never sees the generic error for a transient hiccup, and
    // we never leave the page spinning forever (the loop is bounded).
    private const int MaxLoadAttempts = 5;
    private const int LoadRetryDelayMs = 300;

    private async Task LoadDashboardAsync()
    {
        // [DashboardDiag] first line of method
        Console.WriteLine("[DashboardDiag] LoadDashboardAsync() FIRST LINE");

        _isLoading = true;
        _loadError = false;

        for (int attempt = 1; attempt <= MaxLoadAttempts; attempt++)
        {
            try
            {
                // [DashboardDiag] before GetAuthenticationStateAsync
                Console.WriteLine($"[DashboardDiag] attempt {attempt}: BEFORE GetAuthenticationStateAsync");
                // Ensure the Authorization header is set on the shared HttpClient
                // before the API call fires. GetAuthenticationStateAsync sets the
                // header as a side-effect.
                var authState = await AuthStateProvider.GetAuthenticationStateAsync();
                var isAuthenticated = authState.User?.Identity?.IsAuthenticated == true;
                var userId = authState.User?.FindFirst("nameid")?.Value;

                // [DashboardDiag] after GetAuthenticationStateAsync
                Console.WriteLine($"[DashboardDiag] attempt {attempt}/{MaxLoadAttempts}: AFTER GetAuthenticationStateAsync authenticated={isAuthenticated} userId={userId ?? "null"}");

                if (!isAuthenticated)
                {
                    // Auth state not ready yet — wait and retry rather than error.
                    if (attempt < MaxLoadAttempts)
                    {
                        await Task.Delay(LoadRetryDelayMs);
                        continue;
                    }
                    Console.WriteLine("[DashboardDiag] auth state never became ready after all attempts — showing error");
                    _loadError = true;
                    break;
                }

                // [DashboardDiag] before DashboardService.GetDashboardAsync
                Console.WriteLine($"[DashboardDiag] attempt {attempt}: BEFORE DashboardService.GetDashboardAsync");
                _data = await DashboardService.GetDashboardAsync();

                // [DashboardDiag] after DashboardService.GetDashboardAsync
                Console.WriteLine($"[DashboardDiag] attempt {attempt}: AFTER GetDashboardAsync dataNull={_data is null} hasTeam={_data?.HasTeam} projectNull={_data?.Project is null}");

                if (_data is not null)
                {
                    _loadError = false;
                    break; // success
                }

                // Null data => transient request failure (see DashboardService
                // diagnostics for the exact status/exception). Retry if budget left.
                if (attempt < MaxLoadAttempts)
                {
                    await Task.Delay(LoadRetryDelayMs);
                    continue;
                }
                _loadError = true;
            }
            catch (Exception ex)
            {
                // [DashboardDiag] temporary
                Console.WriteLine($"[DashboardDiag] attempt {attempt} EXCEPTION: {ex.GetType().Name}: {ex.Message}");
                if (attempt < MaxLoadAttempts)
                {
                    await Task.Delay(LoadRetryDelayMs);
                    continue;
                }
                _loadError = true;
                _data = null;
            }
        }

        _isLoading = false;

        // [DashboardDiag] final state
        Console.WriteLine($"[DashboardDiag] LoadDashboardAsync() FINAL: dataNull={_data is null} loadError={_loadError} isLoading={_isLoading}");
    }

    private async Task OpenProjectDetails()
    {
        if (_projectCard is not null)
            await _projectCard.OpenModal();
    }

    private void OpenDetail(int taskId)
    {
        _detailTaskId = taskId;
        StateHasChanged();
    }

    private void CloseDetail()               => _detailTaskId = 0;

    // ── Milestone detail modal (opened from the progress timeline) ──────────────
    private void OpenMilestoneDetail(MilestoneSummaryDto ms)
    {
        _detailMilestone = ms;
        StateHasChanged();
    }

    private void CloseMilestoneDetail()      => _detailMilestone = null;

    // Clicking a task inside the milestone modal reuses the existing
    // TaskDetailModal: close the milestone modal, then open the task one.
    private void OpenTaskFromMilestone(int taskId)
    {
        _detailMilestone = null;
        OpenDetail(taskId);
    }

    private void OpenSubmissionFromDetail(int taskId)
    {
        _detailTaskId = 0;
        Nav.NavigateTo("/tasks");
    }

    private async Task ReloadDashboard()
    {
        await LoadDashboardAsync();

        // Mirror the initial-load behaviour: a student with no assigned project
        // belongs in the catalog experience, not the empty dashboard state.
        if (_data is not null && _data.Project is null)
            Nav.NavigateTo("/" + PageRoutes.StudentCatalog);
    }
}
