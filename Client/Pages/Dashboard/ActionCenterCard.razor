@using AuthWithAdmin.Shared.AuthSharedModels
@inject NavigationManager Nav

@* ─────────────────────────────────────────────────────────────
   ActionCenterCard — the compact "דורש התייחסות" attention band.

   PHASE 4D (decision M.1, option A). The finalized Dashboard V4 has no
   attention list at all: it compresses every exception into one boolean
   flag on the focus card. The application, however, has a real, working
   exception engine — returned submissions, overdue tasks, submissions
   approved but not yet confirmed in Moodle, and open requests — that a
   student cannot see anywhere else on this page. Dropping it would be
   simplifying away real functionality.

   So the LOGIC is preserved verbatim (it now lives in
   StudentDashboardModel, shared with the focus card and the deadline
   list) and the PRESENTATION is rebuilt in the System Master's own rose
   alert language — §3 "Alert / filtered-state message: rose-tinted panel,
   always paired with one direct action" — which is exactly the treatment
   the already-approved Tasks screen uses for its own attention band.

   It is deliberately NOT a card: no ambient edge, no header chrome, no
   count badge, no empty state. It is one rose-tinted strip of rows that
   is not rendered at all when nothing needs attention, so it stays
   visually secondary to the focus card above it and can never grow into
   a second dashboard section.
   ───────────────────────────────────────────────────────────── *@

@if (_items.Count > 0)
{
    <section class="acc-band" aria-labelledby="acc-heading">
        <div class="acc-head">
            <MStatusDot Tone="MStatusDot.DotTone.Rose" Pulse="true" />
            <h2 class="acc-title" id="acc-heading">דורש התייחסות</h2>
            @if (_overflow > 0)
            {
                <a class="acc-more" href="/tasks">עוד @_overflow</a>
            }
        </div>

        <div class="acc-rows">
            @foreach (var item in _items)
            {
                var captured = item;
                <div class="acc-row">
                    <div class="acc-row-main">
                        <span class="acc-row-title">@item.Title</span>
                        <span class="acc-row-meta">@item.SubText</span>
                    </div>
                    <button type="button" class="acc-row-action motiva-cta"
                            @onclick="@(() => HandleAction(captured))"
                            aria-label="@($"{item.ActionLabel} — {item.Title}")">
                        @item.ActionLabel
                        <span class="oi oi-chevron-left acc-row-arrow" aria-hidden="true"></span>
                    </button>
                </div>
            }
        </div>
    </section>
}

@code {
    [Parameter, EditorRequired] public List<MilestoneSummaryDto> Milestones   { get; set; } = new();
    [Parameter, EditorRequired] public List<OpenRequestDto>      OpenRequests { get; set; } = new();
    [Parameter]                 public EventCallback<int>        OnOpenTask   { get; set; }

    /// <summary>Task the focus card already shows in full. Excluded here so the
    /// same exception is not stated twice on one screen — the focus card
    /// already carries its own "דורש תשומת לב" flag for it.</summary>
    [Parameter] public int? ExcludeTaskId { get; set; }

    private sealed record ActionItem(int Order, string Title, string SubText, string ActionLabel, int? TaskId);

    private List<ActionItem> _items    = new();
    private int              _overflow;

    protected override void OnParametersSet()
    {
        var all = BuildItems();

        // Bounded on purpose (density requirement): the dashboard shows the
        // three highest-priority exceptions and points at /tasks for the rest,
        // rather than growing without limit.
        _items    = all.Take(3).ToList();
        _overflow = Math.Max(0, all.Count - _items.Count);
    }

    // Unchanged ruleset — the same conditions, the same precedence and the
    // same copy the pre-4D card used; only the item shape is flatter.
    private List<ActionItem> BuildItems()
    {
        var items = new List<ActionItem>();

        foreach (var ms in Milestones)
        {
            foreach (var task in ms.Tasks)
            {
                if (task.Id == ExcludeTaskId) continue;

                switch (StudentDashboardModel.KindOf(task))
                {
                    case StudentDashboardModel.AttentionKind.Returned:
                        items.Add(new ActionItem(0, task.Title,
                            $"{ms.Title} — הוחזר לתיקון", "לתיקון", task.Id));
                        break;

                    case StudentDashboardModel.AttentionKind.Overdue:
                        var daysLate = (int)(DateTime.Today - task.DueDate!.Value.Date).TotalDays;
                        var lateStr  = daysLate == 1 ? "יום אחד באיחור" : $"{daysLate} ימים באיחור";
                        items.Add(new ActionItem(1, task.Title,
                            $"{ms.Title} — {lateStr}", "פתיחה", task.Id));
                        break;

                    case StudentDashboardModel.AttentionKind.PendingMoodle:
                        items.Add(new ActionItem(2, task.Title,
                            $"{ms.Title} — אושר ע״י מנחה, ממתין לאישור במודל", "לאישור", task.Id));
                        break;
                }
            }
        }

        // Open requests — the student is waiting on someone else, so this is
        // the lowest-priority signal, but it is the only place the dashboard
        // surfaces requests at all.
        foreach (var req in OpenRequests)
        {
            items.Add(new ActionItem(3, req.Title,
                $"{req.RequestType} — ממתין לתגובה", "צפייה", null));
        }

        return items.OrderBy(i => i.Order).ToList();
    }

    private async Task HandleAction(ActionItem item)
    {
        if (item.TaskId.HasValue)
            await OnOpenTask.InvokeAsync(item.TaskId.Value);
        else
            Nav.NavigateTo("/requests");
    }
}
