@using AuthWithAdmin.Shared.AuthSharedModels
@using AuthWithAdmin.Client.Services
@inject IPersonalTasksService PersonalTasksService

@* ─────────────────────────────────────────────────────────────
   PersonalTasksCard — student-private reminder checklist.
   Data: POST/GET/PATCH /api/projects/personal-tasks.
   Backend: PersonalTasks table, UserId-scoped, student-only.
   ───────────────────────────────────────────────────────────── *@

<div class="ptc-card">

    <!-- Card header: title + create button -->
    <div class="ptc-header">
        <div class="ptc-header-start">
            <span class="oi oi-check ptc-header-icon" aria-hidden="true"></span>
            <h2 class="ptc-header-title">משימות אישיות</h2>
        </div>
        <button class="ptc-add-btn" @onclick="OpenModal" title="משימה אישית חדשה">
            <span class="oi oi-plus" aria-hidden="true"></span>
            חדשה
        </button>
    </div>

    <!-- Body: loading / empty / list -->
    @if (_loading)
    {
        <div class="ptc-loading">
            <div class="ptc-spinner"></div>
        </div>
    }
    else if (_tasks.Count == 0)
    {
        <div class="ptc-empty">
            <span class="oi oi-clipboard ptc-empty-icon" aria-hidden="true"></span>
            <p class="ptc-empty-title">אין משימות אישיות עדיין</p>
            <p class="ptc-empty-sub">תזכורות אישיות יופיעו כאן</p>
            <button class="ptc-empty-create-btn" @onclick="OpenModal">
                + משימה חדשה
            </button>
        </div>
    }
    else
    {
        <div class="ptc-list">
            @foreach (var task in _tasks)
            {
                var captured = task;
                <div class="ptc-item @(task.IsDone ? "ptc-item-done" : "")">
                    <button class="ptc-toggle-btn"
                            @onclick="@(() => ToggleTask(captured))"
                            title="@ToggleLabel(task.IsDone)"
                            aria-label="@ToggleLabel(task.IsDone)">
                        <span class="oi @(task.IsDone ? "oi-circle-check" : "oi-circle") ptc-toggle-icon"
                              aria-hidden="true"></span>
                    </button>
                    <div class="ptc-item-body">
                        <span class="ptc-item-title">@task.Title</span>
                        @if (task.DueDate.HasValue)
                        {
                            var daysLeft = (int)(task.DueDate.Value.Date - DateTime.Today).TotalDays;
                            <span class="ptc-item-due @(daysLeft < 0 && !task.IsDone ? "ptc-due-overdue" : "")">
                                <span class="oi oi-calendar ptc-due-icon" aria-hidden="true"></span>
                                @task.DueDate.Value.ToString("dd/MM/yy")
                            </span>
                        }
                    </div>
                </div>
            }
        </div>
    }

</div>

@* ── Inline modal for creating a new personal task ── *@
@if (_showModal)
{
    <div class="ptc-overlay" @onclick="CloseModal">
        <div class="ptc-modal" @onclick:stopPropagation="true" dir="rtl"
             role="dialog" aria-modal="true" aria-label="משימה אישית חדשה">

            <!-- Modal header -->
            <div class="ptc-modal-header">
                <div class="ptc-modal-title-row">
                    <span class="oi oi-check ptc-modal-icon" aria-hidden="true"></span>
                    <h2 class="ptc-modal-title">משימה אישית חדשה</h2>
                </div>
                <button class="ptc-modal-close" @onclick="CloseModal"
                        title="סגירה" aria-label="סגירה"
                        disabled="@_isSaving">
                    <span class="oi oi-x" aria-hidden="true"></span>
                </button>
            </div>

            <!-- Modal body: form fields -->
            <div class="ptc-modal-body">

                <div class="ptc-field">
                    <label class="ptc-label">
                        כותרת <span class="ptc-required" aria-hidden="true">*</span>
                    </label>
                    <input class="ptc-input @(_touched && string.IsNullOrWhiteSpace(_newTitle) ? "ptc-input-error" : "")"
                           type="text"
                           placeholder="שם המשימה..."
                           @bind="_newTitle"
                           @bind:event="oninput"
                           disabled="@_isSaving" />
                    @if (_touched && string.IsNullOrWhiteSpace(_newTitle))
                    {
                        <div class="ptc-field-error">כותרת המשימה היא שדה חובה</div>
                    }
                </div>

                <div class="ptc-field">
                    <label class="ptc-label">תאריך יעד (אופציונלי)</label>
                    <input class="ptc-input"
                           type="date"
                           value="@_newDueDateStr"
                           @onchange="@(e => SetDueDate(e.Value?.ToString()))"
                           disabled="@_isSaving" />
                </div>

                <div class="ptc-field">
                    <label class="ptc-label">תיאור (אופציונלי)</label>
                    <textarea class="ptc-textarea"
                              placeholder="פרטים נוספים..."
                              @bind="_newDescription"
                              rows="3"
                              disabled="@_isSaving"></textarea>
                </div>

                @if (_saveError is not null)
                {
                    <div class="ptc-save-error">@_saveError</div>
                }

            </div><!-- /ptc-modal-body -->

            <!-- Modal footer: cancel + save -->
            <div class="ptc-modal-footer">
                <button class="ptc-cancel-btn" @onclick="CloseModal" disabled="@_isSaving">
                    ביטול
                </button>
                <button class="ptc-save-btn" @onclick="SaveTask" disabled="@_isSaving">
                    @(_isSaving ? "שומר..." : "שמירה")
                </button>
            </div>

        </div><!-- /ptc-modal -->
    </div><!-- /ptc-overlay -->
}

@code {
    private List<PersonalTaskDto> _tasks     = new();
    private bool                  _loading   = true;
    private bool                  _showModal;
    private bool                  _touched;
    private bool                  _isSaving;
    private string?               _saveError;

    // Form state
    private string  _newTitle       = "";
    private string  _newDueDateStr  = "";
    private string? _newDescription;

    private DateTime? _parsedDueDate =>
        string.IsNullOrEmpty(_newDueDateStr) ? null
        : DateTime.TryParse(_newDueDateStr, out var d) ? d : (DateTime?)null;

    private void SetDueDate(string? val) =>
        _newDueDateStr = string.IsNullOrEmpty(val) ? "" : val;

    protected override async Task OnInitializedAsync()
    {
        _tasks   = await PersonalTasksService.GetAsync();
        _loading = false;
    }

    private void OpenModal()
    {
        _newTitle       = "";
        _newDueDateStr  = "";
        _newDescription = null;
        _touched        = false;
        _saveError      = null;
        _showModal      = true;
    }

    private void CloseModal()
    {
        if (!_isSaving) _showModal = false;
    }

    private async Task SaveTask()
    {
        _touched = true;
        if (string.IsNullOrWhiteSpace(_newTitle)) return;

        _isSaving  = true;
        _saveError = null;

        var (created, error) = await PersonalTasksService.CreateAsync(new CreatePersonalTaskRequest
        {
            Title       = _newTitle.Trim(),
            Description = string.IsNullOrWhiteSpace(_newDescription) ? null : _newDescription.Trim(),
            DueDate     = _parsedDueDate,
        });

        _isSaving = false;

        if (created is not null)
        {
            _tasks.Insert(0, created); // newest first
            _showModal = false;
        }
        else
        {
            _saveError = error ?? "שגיאה בשמירת המשימה";
        }
    }

    private static string ToggleLabel(bool isDone) =>
        isDone ? "ביטול סימון" : "סימון כהושלם";

    private async Task ToggleTask(PersonalTaskDto task)
    {
        var success = await PersonalTasksService.ToggleAsync(task.Id);
        if (success) task.IsDone = !task.IsDone;
    }
}