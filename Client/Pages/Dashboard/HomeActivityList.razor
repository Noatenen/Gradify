@using AuthWithAdmin.Shared.AuthSharedModels

@*
    HomeActivityList — Home Page Layer E ("מה השתנה לאחרונה").

    Data source: INotificationService.GetRecentAsync() — the exact same feed
    NotificationBell reads, so nothing here is invented. Capped at 3, no card
    wrapper (deliberately the quietest section on the page), no tasks or
    deadlines — only events.
*@

@if (Notifications.Count > 0)
{
    <section class="hal">
        <div class="hal-label">
            <span class="oi oi-clock" aria-hidden="true"></span>
            מה השתנה לאחרונה
        </div>
        <div class="hal-list">
            @foreach (var n in Notifications.OrderByDescending(n => n.CreatedAt).Take(3))
            {
                <div class="hal-row">
                    <span class="hal-dot"></span>
                    <span class="hal-text">@n.Message</span>
                    <span class="hal-time">@FormatTime(n.CreatedAt)</span>
                </div>
            }
        </div>
    </section>
}

@code {
    [Parameter, EditorRequired] public List<NotificationDto> Notifications { get; set; } = default!;

    private static string FormatTime(DateTime dt)
    {
        var utc  = dt.Kind == DateTimeKind.Utc ? dt : DateTime.SpecifyKind(dt, DateTimeKind.Utc);
        var diff = DateTime.UtcNow - utc;
        if (diff.TotalMinutes < 1)  return "הרגע";
        if (diff.TotalMinutes < 60) return $"לפני {(int)diff.TotalMinutes} דקות";
        if (diff.TotalHours   < 24) return $"לפני {(int)diff.TotalHours} שעות";
        if (diff.TotalDays    < 7)  return $"לפני {(int)diff.TotalDays} ימים";
        return dt.ToString("dd/MM/yy");
    }
}
