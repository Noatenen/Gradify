@using AuthWithAdmin.Shared.AuthSharedModels

@* ─────────────────────────────────────────────────────────────
   AttentionItemsCard — "דורש תשומת לב"

   ── NOT CURRENTLY PLACED ON THE DASHBOARD ─────────────────────────────
   This component is intact and still compiles, but Dashboard.razor no
   longer renders it: its heading collided with the requests card beside
   it, which now carries the name. See the note at that card's old slot
   in Dashboard.razor for what moved and what it costs. Everything below
   describes the component as built; none of it was unwound.

   The student's own work that is off track: a submission returned for
   revision, a task past its due date, or a submission the mentor approved
   that has not been confirmed in Moodle yet. Exactly the three conditions
   StudentDashboardModel.AttentionKind already defines, and exactly the
   conditions the focus card has always labelled "דורש תשומת לב" — so this
   card names the same idea the same way rather than inventing a second
   vocabulary for it.

   WHAT CHANGED, AND WHY
   This replaces the lower half of the old ActionCenterCard, which put these
   task exceptions and the student's open requests together inside ONE
   rose-filled band. Two problems with that: the two are different kinds of
   information — one is "your work needs fixing", the other is "someone owes
   you an answer" — and a solid rose surface made the whole block read as an
   alarm, which is far louder than a pending Moodle confirmation deserves.

   So: the ordinary Motiva ambient card, the same shell as
   "עדכונים אחרונים" and "הגשות ומועדים קרובים", and rose reduced to what it
   should always have been — a per-item accent (a small dot, the state text)
   rather than the background of a section.

   Row language is MRowList/MRow, the same list the deadlines card uses, so
   the four cards in the two-column rhythm read as one system.
   ───────────────────────────────────────────────────────────── *@

<MCard Padding="MCard.CardPadding.None"
       Class="aic-card"
       Fill="true">
    <div class="aic-body">
        @* Mentor head grammar — glyph, title, link at the reading end. *@
        <div class="sd-head aic-head">
            <span class="sd-head-icon motiva-ico-gradient" aria-hidden="true">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="url(#motivaIconGradient)"
                     stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z"></path>
                    <path d="M12 9v4M12 17h.01"></path>
                </svg>
            </span>
            <h2 class="sd-head-title aic-title">דורש תשומת לב</h2>
            <a class="sd-head-link" href="/tasks">לכל המשימות</a>
        </div>

        @if (_rows.Count == 0)
        {
            <MEmptyState Title="אין משימות שדורשות תשומת לב"
                         Description="כשמשימה תוחזר לתיקון או תעבור את מועד ההגשה, היא תופיע כאן." />
        }
        else
        {
            <MRowList Class="aic-list" AriaLabel="דורש תשומת לב" Divided="true">
                @foreach (var row in _rows)
                {
                    var captured = row;
                    <MRow Class="aic-row"
                          Primary="@row.Title"
                          Secondary="@row.MilestoneTitle"
                          OnClick="@(() => Open(captured))"
                          AriaLabel="@($"פתיחת {row.Title} — {row.StateText}")">
                        <Status>
                            <MStatusBadge Variant="MStatusBadge.BadgeVariant.Rose"
                                          Size="MStatusBadge.BadgeSize.Small"
                                          Text="@row.StateText" />
                        </Status>
                    </MRow>
                }
            </MRowList>
        }
    </div>
</MCard>

@code {
    [Parameter, EditorRequired] public List<MilestoneSummaryDto> Milestones { get; set; } = new();
    [Parameter]                 public EventCallback<int>        OnOpenTask { get; set; }

    /// <summary>Task the focus card already shows in full, with its own
    /// "דורש תשומת לב" flag. Excluded by identity so one exception is never
    /// stated twice on a single screen.</summary>
    [Parameter] public int? ExcludeTaskId { get; set; }

    /// <summary>Bounded for density, like every other list on this page. The
    /// footer link carries the remainder — the old card's "עוד N" counter is
    /// gone because the two-column rhythm gives every card the same footer.</summary>
    private const int MaxRows = 3;

    private sealed record Row(string Title, string MilestoneTitle, string StateText, int TaskId);

    private List<Row> _rows => StudentDashboardModel
        .AttentionTasks(Milestones, ExcludeTaskId)
        .Take(MaxRows)
        .Select(x => new Row(x.Task.Title, x.Milestone.Title, StateText(x.Task, x.Kind), x.Task.Id))
        .ToList();

    /// <summary>The item's state, in the words the dashboard already uses for
    /// it. Overdue reports the real number of days from the real due date —
    /// this is a genuine deadline the student missed, so unlike the mentor
    /// area's waiting ages, "באיחור" is the correct word here.</summary>
    private static string StateText(TaskSummaryDto task, StudentDashboardModel.AttentionKind kind) =>
        kind switch
        {
            StudentDashboardModel.AttentionKind.Returned      => "הוחזר לתיקון",
            StudentDashboardModel.AttentionKind.Overdue       => OverdueText(task),
            _                                                 => "ממתין לאישור במודל",
        };

    private static string OverdueText(TaskSummaryDto task)
    {
        var days = (int)(DateTime.Today - task.DueDate!.Value.Date).TotalDays;
        return days == 1 ? "יום אחד באיחור" : $"{days} ימים באיחור";
    }

    private async Task Open(Row row) => await OnOpenTask.InvokeAsync(row.TaskId);
}
