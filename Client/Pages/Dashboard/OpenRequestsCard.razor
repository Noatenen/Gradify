@using AuthWithAdmin.Shared.AuthSharedModels
@using AuthWithAdmin.Client.Pages.Requests

@* ─────────────────────────────────────────────────────────────
   OpenRequestsCard — "בקשות"

   ── WHAT CHANGED, AND WHY ─────────────────────────────────────────────
   This card was titled "דורש תשומת לב" and led with the FOCUS TASK — the
   very task "משימה קרובה להגשה" already shows in full, one card away. Two
   large cards on one screen stating the same overdue task is not emphasis,
   it is duplication, and the task's milestone line under it ("הערכה") was
   a third copy of something the focus card already carries.

   The task row is gone. What is left is what this card was always half
   doing and what the dashboard has no other surface for: the student's own
   REQUESTS.

   ── WHAT APPEARS HERE ─────────────────────────────────────────────────
   Open requests, from the payload the server already filters — GET
   my-dashboard returns ProjectRequests with Status NOT IN
   ('Resolved','Closed'), so "open" is the server's own definition and
   nothing historical reaches this card.

   ORDERED BY WHOSE COURT IT IS IN, using RequestOwnership /
   RequestBuckets — the same two classes the /requests workspace reads.
   A request waiting on the STUDENT sorts first, because that is the only
   kind the student can move; the rest follow in the order the payload
   already carries. No new bucket, no new status, no parallel rule.

   ── STYLING ───────────────────────────────────────────────────────────
   The badge tone comes from RequestBuckets.Tone — rose when it waits on
   the student, violet while it is in flight — rather than rose on every
   row as before, which said "urgent" about requests that were simply
   progressing normally. Dividers come from MRowList's Divided default.
   ───────────────────────────────────────────────────────────── *@

<MCard Padding="MCard.CardPadding.None"
       Class="orc-card"
       Fill="true">
    <div class="orc-body">
        @* The mentor dashboard's section head: the glyph ALONE (no chip),
           the title, and the "see all" link at the head's reading end —
           where the mentor puts it — rather than centred under the list.
           Same href, same label, same destination. *@
        <div class="sd-head orc-head">
            @* The gradient glyph every other card head on this dashboard
               wears. The rose warning triangle went with the title it
               belonged to: a request in flight is not an alarm. *@
            <span class="sd-head-icon motiva-ico-gradient" aria-hidden="true">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="url(#motivaIconGradient)"
                     stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                    <path d="M14 2v6h6"></path>
                    <path d="M9 13h6M9 17h4"></path>
                </svg>
            </span>
            <h2 class="sd-head-title orc-title">בקשות</h2>
            <a class="sd-head-link" href="requests">לכל הבקשות</a>
        </div>

        @if (_items.Count == 0)
        {
            @* Quiet, and true: no open request is a normal, good state — not
               an error and not an empty list to apologise for. *@
            <MEmptyState Title="אין בקשות פתוחות"
                         Description="בקשה שתפתחי תופיע כאן עד שתטופל." />
        }
        else
        {
            <MRowList Class="orc-list" AriaLabel="בקשות פתוחות">
                @foreach (var item in _items)
                {
                    var captured = item;
                    <MRow Class="orc-row"
                          Primary="@captured.Primary"
                          Secondary="@captured.Secondary"
                          Href="@captured.Href"
                          AriaLabel="@($"מעבר לבקשה {captured.Primary} — {captured.StateText}")">
                        <Status>
                            <MStatusBadge Variant="@captured.Variant"
                                          Size="MStatusBadge.BadgeSize.Small"
                                          Text="@captured.StateText" />
                        </Status>
                    </MRow>
                }
            </MRowList>
        }
    </div>
</MCard>

@code {
    /// <summary>Open project requests, pre-filtered SERVER-SIDE to exclude
    /// Resolved and Closed (see GetMyDashboard's requestsSql). This card adds
    /// no status filter of its own — it only orders them.</summary>
    [Parameter, EditorRequired] public List<OpenRequestDto> OpenRequests { get; set; } = new();

    /// <summary>How many rows the card will draw. The dashboard is a glance,
    /// not the queue — "לכל הבקשות" in the head goes to the full list.</summary>
    private const int MaxRows = 4;

    private sealed record Item(
        string Primary,
        string Secondary,
        string StateText,
        string Href,
        MStatusBadge.BadgeVariant Variant);

    /// <summary>
    /// The card's rows: every open request, the ones waiting on the STUDENT
    /// first.
    ///
    /// <para>Both the ordering key and the row label come from
    /// RequestBuckets — the same class the /requests workspace uses to
    /// bucket and label these exact statuses — so the dashboard and the
    /// queue can never disagree about what a request's state is called.</para>
    /// </summary>
    private List<Item> _items =>
        OpenRequests
            .Select(r => new { Request = r, Bucket = RequestBuckets.Of(r.Status) })
            .OrderBy(x => x.Bucket == RequestBucket.Waiting ? 0 : 1)
            .Take(MaxRows)
            .Select(x => new Item(
                x.Request.Title,
                RequestTypes.Label(x.Request.RequestType),
                RequestBuckets.RowLabel(x.Bucket),
                $"requests?requestId={x.Request.Id}",
                BadgeFor(x.Bucket)))
            .ToList();

    /// <summary>The bucket's own tone, mapped onto the badge's vocabulary.
    /// RequestBuckets.Tone is the source — this method only translates
    /// MStatusDot.DotTone into MStatusBadge.BadgeVariant, it decides
    /// nothing.</summary>
    private static MStatusBadge.BadgeVariant BadgeFor(RequestBucket bucket) =>
        RequestBuckets.Tone(bucket) switch
        {
            MStatusDot.DotTone.Rose   => MStatusBadge.BadgeVariant.Rose,
            MStatusDot.DotTone.Violet => MStatusBadge.BadgeVariant.Violet,
            _                         => MStatusBadge.BadgeVariant.Teal,
        };
}
