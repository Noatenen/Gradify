@using AuthWithAdmin.Shared.AuthSharedModels
@using AuthWithAdmin.Client.Pages.Requests

@* ─────────────────────────────────────────────────────────────
   OpenRequestsCard — "דורש תשומת לב"

   ── WHAT APPEARS HERE ─────────────────────────────────────────────────
   Two sources, ordered tasks-first then requests:

   1. FOCUS TASK (when it is an attention item): the same task the focus
      card shows in full — returned, overdue, or pending Moodle. It is
      included here so the "what needs me now" card also surfaces in the
      attention list, without removing it from the focus card. Clicking
      the row opens the same TaskDetailModal the focus card would.

   2. REQUESTS that await the student (RequestOwnership.AwaitsStudent):
      NeedsInfo / הוחזרה לסטודנט. Requests sitting with a mentor or the
      academic side are excluded — nothing is waiting for the student
      there, and showing them would misread "you need to act" as the
      heading's meaning.

   ── STYLING ───────────────────────────────────────────────────────────
   Rose badge on every row (the attention token, reused from the prior
   pass). No leading dot — the badge alone carries the signal. Dividers
   between rows come from MRowList's default Divided=true; no extra CSS.
   ───────────────────────────────────────────────────────────── *@

<MCard Padding="MCard.CardPadding.None"
       Class="orc-card"
       Fill="true">
    <div class="orc-body">
        @* The mentor dashboard's section head: the glyph ALONE (no chip),
           the title, and the "see all" link at the head's reading end —
           where the mentor puts it — rather than centred under the list.
           Same href, same label, same destination. *@
        <div class="sd-head orc-head">
            <span class="orc-head-icon-rose" aria-hidden="true">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z"></path>
                    <path d="M12 9v4M12 17h.01"></path>
                </svg>
            </span>
            <h2 class="sd-head-title orc-title">דורש תשומת לב</h2>
            <a class="sd-head-link" href="/requests">לכל הבקשות</a>
        </div>

        @if (_items.Count == 0)
        {
            <MEmptyState Title="אין כרגע פריטים שדורשים את תשומת ליבך"
                         Description="בקשה שתוחזר אלייך לקבלת פרטים נוספים תופיע כאן. שאר הבקשות שפתחת ממתינות למענה ונמצאות תחת ״כל הבקשות״." />
        }
        else
        {
            <MRowList Class="orc-list" AriaLabel="פריטים שדורשים תשומת לב">
                @foreach (var item in _items)
                {
                    var captured = item;
                    @if (captured.TaskId.HasValue)
                    {
                        <MRow Class="orc-row"
                              Primary="@captured.Primary"
                              Secondary="@captured.Secondary"
                              OnClick="@(() => OnOpenTask.InvokeAsync(captured.TaskId!.Value))"
                              AriaLabel="@($"פתיחת {captured.Primary} — {captured.StateText}")">
                            <Status>
                                <MStatusBadge Variant="MStatusBadge.BadgeVariant.Rose"
                                              Size="MStatusBadge.BadgeSize.Small"
                                              Text="@captured.StateText" />
                            </Status>
                        </MRow>
                    }
                    else
                    {
                        <MRow Class="orc-row"
                              Primary="@captured.Primary"
                              Secondary="@captured.Secondary"
                              Href="@captured.RequestHref"
                              AriaLabel="@($"מעבר לבקשה {captured.Primary} — {captured.StateText}")">
                            <Status>
                                <MStatusBadge Variant="MStatusBadge.BadgeVariant.Rose"
                                              Size="MStatusBadge.BadgeSize.Small"
                                              Text="@captured.StateText" />
                            </Status>
                        </MRow>
                    }
                }
            </MRowList>
        }
    </div>
</MCard>

@code {
    [Parameter, EditorRequired] public List<OpenRequestDto>      OpenRequests { get; set; } = new();
    [Parameter]                 public List<MilestoneSummaryDto> Milestones   { get; set; } = new();
    [Parameter]                 public EventCallback<int>         OnOpenTask   { get; set; }

    /// <summary>Caps the request portion only; the focus task is always
    /// prepended when urgent and does not count against this limit.</summary>
    private const int MaxRequestRows = 3;

    /// <summary>Unified attention item — either a task (opens modal via OnOpenTask)
    /// or a request (navigates via RequestHref).</summary>
    private sealed record Item(
        string  Primary,
        string  Secondary,
        string  StateText,
        int?    TaskId,
        string? RequestHref);

    /// <summary>
    /// Combined attention list: focus task first (when urgent), then requests.
    ///
    /// FOCUS TASK — the task the "משימה קרובה להגשה" card shows in full,
    /// included here when StudentDashboardModel.IsAttentionItem is true. It is
    /// NOT excluded from the focus card — both surfaces show it intentionally.
    ///
    /// REQUESTS — only those whose next action belongs to the student
    /// (RequestOwnership.AwaitsStudent). Requests sitting with a mentor or the
    /// academic side are not actionable and are not shown.
    /// </summary>
    private List<Item> _items
    {
        get
        {
            var focusTask      = StudentDashboardModel.FocusTask(Milestones);
            var focusMilestone = StudentDashboardModel.MilestoneOf(Milestones, focusTask);
            var taskItem = (focusTask is not null
                            && focusMilestone is not null
                            && StudentDashboardModel.IsAttentionItem(focusTask))
                ? new Item(
                    focusTask.Title,
                    focusMilestone.Title,
                    TaskStateText(focusTask),
                    focusTask.Id,
                    null)
                : null;

            var requestItems = OpenRequests
                .Where(r => RequestOwnership.AwaitsStudent(r.Status))
                .Take(MaxRequestRows)
                .Select(r => new Item(
                    r.Title,
                    RequestTypes.Label(r.RequestType),
                    RequestBuckets.RowLabel(RequestBuckets.Of(r.Status)),
                    null,
                    $"/requests?requestId={r.Id}"))
                .ToList();

            return (taskItem is not null
                ? requestItems.Prepend(taskItem)
                : (IEnumerable<Item>)requestItems)
                .ToList();
        }
    }

    private static string TaskStateText(TaskSummaryDto task) =>
        StudentDashboardModel.KindOf(task) switch
        {
            StudentDashboardModel.AttentionKind.Returned      => "הוחזר לתיקון",
            StudentDashboardModel.AttentionKind.Overdue       => OverdueText(task),
            _                                                 => "ממתין לאישור במודל",
        };

    private static string OverdueText(TaskSummaryDto task)
    {
        var days = (int)(DateTime.Today - task.DueDate!.Value.Date).TotalDays;
        return days == 1 ? "יום אחד באיחור" : $"{days} ימים באיחור";
    }
}
