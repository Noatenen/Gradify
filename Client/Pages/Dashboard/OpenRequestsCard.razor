@using AuthWithAdmin.Shared.AuthSharedModels
@inject NavigationManager Nav

@* ─────────────────────────────────────────────────────────────
   OpenRequestsCard — "דורש תשומת לב"

   ── THE HEADING AND THE CONTENT ARE TWO DIFFERENT DECISIONS ───────────
   This card is titled "דורש תשומת לב" and shows OPEN REQUESTS. That is
   deliberate, not a mismatch: the dashboard used to carry this card as
   "דורש התייחסות" next to a second, smaller card titled "דורש תשומת לב",
   and two headings that mean the same thing in Hebrew read as one idea
   split in half. The name settled here; the other card's placement was
   withdrawn (see Dashboard.razor). Nothing about WHAT this card selects,
   loads or links to changed with the name.

   The student's open requests — the threads they filed that are still live
   with the academic side. DashboardDto.OpenRequests, the same list the old
   ActionCenterCard carried; this is the only place the dashboard surfaces
   requests at all.

   WHY THIS IS ITS OWN CARD
   It used to share one rose band with the task exceptions, and the two are
   not the same kind of information. A returned or overdue task is the
   student's own work going wrong and they must act on it. An open request
   is a conversation they already started and someone else now owes them an
   answer on. Merging them made a waiting request look like a failure.

   WHY IT IS NOT ROSE
   Nothing here is late or broken — the student did their part. So the row
   accent is the neutral violet the rest of the product uses for "in
   flight", and rose is left to the card beside it, where it means
   something. Same shell, same list language, different semantics.
   ───────────────────────────────────────────────────────────── *@

<MCard Padding="MCard.CardPadding.None"
       Class="orc-card"
       Fill="true">
    <div class="orc-body">
        @* The mentor dashboard's section head: the glyph ALONE (no chip),
           the title, and the "see all" link at the head's reading end —
           where the mentor puts it — rather than centred under the list.
           Same href, same label, same destination. *@
        <div class="sd-head orc-head">
            <span class="sd-head-icon" aria-hidden="true">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M21 11.5a8.4 8.4 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.4 8.4 0 0 1-3.8-.9L3 21l1.9-5.7a8.4 8.4 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.4 8.4 0 0 1 3.8-.9h.5a8.5 8.5 0 0 1 8 8v.5z"></path>
                </svg>
            </span>
            <h2 class="sd-head-title orc-title">דורש תשומת לב</h2>
            <a class="sd-head-link" href="/requests">לכל הבקשות</a>
        </div>

        @if (_rows.Count == 0)
        {
            <MEmptyState Title="אין בקשות פתוחות"
                         Description="בקשות שתפתחי ועדיין ממתינות למענה יופיעו כאן." />
        }
        else
        {
            <MRowList Class="orc-list" AriaLabel="בקשות פתוחות">
                @foreach (var row in _rows)
                {
                    @* MetaTone: the mentor states a row's STATE as a filled pill
                       in its own tone, never as bare text. The tone is the violet
                       this card already uses on its leading dot — nothing here is
                       late or broken, so rose stays with the card that means it.
                       Same string, same row, same destination. *@
                    <MRow Class="orc-row"
                          Primary="@row.Title"
                          Secondary="@row.TypeLabel"
                          Meta="ממתין לתגובה"
                          MetaTone="MRow.RowMetaTone.Violet"
                          OnClick="GoToRequests"
                          AriaLabel="@($"מעבר לבקשה {row.Title}")">
                        <Leading>
                            <MStatusDot Tone="MStatusDot.DotTone.Violet" AriaLabel="ממתין לתגובה" />
                        </Leading>
                    </MRow>
                }
            </MRowList>
        }
    </div>
</MCard>

@code {
    [Parameter, EditorRequired] public List<OpenRequestDto> OpenRequests { get; set; } = new();

    /// <summary>Bounded for density, matching every other list on this page.
    /// The footer link carries the remainder.</summary>
    private const int MaxRows = 3;

    private sealed record Row(string Title, string TypeLabel);

    // RequestType arrives as the raw controlled constant. RequestTypes.Label is
    // the product's own Hebrew for it — the same mapping the requests screens
    // use — so a type reads identically here and there. An unknown value falls
    // through Label unchanged rather than being hidden.
    private List<Row> _rows => OpenRequests
        .Take(MaxRows)
        .Select(r => new Row(r.Title, RequestTypes.Label(r.RequestType)))
        .ToList();

    /// <summary>Every row goes to the requests list. The student requests page
    /// has no ?requestId= deep link — unlike the mentor and management inboxes —
    /// so pointing a row at a specific thread would promise navigation the page
    /// cannot perform. This is what the old card did too.</summary>
    private void GoToRequests() => Nav.NavigateTo("/requests");
}
