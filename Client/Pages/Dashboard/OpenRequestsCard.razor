@using AuthWithAdmin.Shared.AuthSharedModels
@using AuthWithAdmin.Client.Pages.Requests

@* ─────────────────────────────────────────────────────────────
   OpenRequestsCard — "דורש תשומת לב"

   ── THE HEADING AND THE CONTENT ARE TWO DIFFERENT DECISIONS ───────────
   This card is titled "דורש תשומת לב" and shows REQUESTS. That is
   deliberate, not a mismatch: the dashboard used to carry this card as
   "דורש התייחסות" next to a second, smaller card titled "דורש תשומת לב",
   and two headings that mean the same thing in Hebrew read as one idea
   split in half. The name settled here; the other card's placement was
   withdrawn (see Dashboard.razor).

   ── WHAT IT SELECTS: ONLY WHAT THE STUDENT CAN ACT ON ─────────────────
   It used to list every request on the project that was not Resolved or
   Closed — which meant a request the student had filed and was WAITING
   on appeared under a heading telling them to attend to it. Nothing was
   waiting for them; they had already done their part.

   The filter is now the request's own workflow state, read through the
   single shared rule in Shared: RequestOwnership.AwaitsStudent. Only a
   request whose next action genuinely belongs to the team — NeedsInfo,
   "הוחזרה לסטודנט", the one status the server's /reply endpoint exists
   for — reaches this list. Anything sitting with a mentor or the
   academic side is out, by the same rule the mentor and lecturer
   dashboards use from their own side.

   This is a selection change ONLY. The data source (DashboardDto.
   OpenRequests), the route, the link, the cap and the row language are
   all untouched, and /requests still lists the complete set in its three
   responsibility buckets — the footer link is right there in the head.

   ── WHY THE ROW IS ROSE NOW ───────────────────────────────────────────
   It used to be violet, and the note that said so was right at the time:
   violet is the product's "in flight" tone, and the card was full of
   requests in flight. Now that a row appears here only when the student
   is the one holding it up, "in flight" is precisely what it is not —
   rose (--motiva-color-rose, the Master's attention tone, reached
   through MStatusDot's closed three-tone enum rather than a new colour)
   is the accurate signal.

   ROSE IS THE DOT AND NOTHING ELSE. The state text goes back to the
   neutral default tone: the row is a piece of information, not an alarm,
   and a fully-coloured row spends the attention budget on the fact that
   a row exists. Same rule the mentor and lecturer queues follow.
   ───────────────────────────────────────────────────────────── *@

<MCard Padding="MCard.CardPadding.None"
       Class="orc-card"
       Fill="true">
    <div class="orc-body">
        @* The mentor dashboard's section head: the glyph ALONE (no chip),
           the title, and the "see all" link at the head's reading end —
           where the mentor puts it — rather than centred under the list.
           Same href, same label, same destination. *@
        <div class="sd-head orc-head">
            <span class="sd-head-icon motiva-ico-gradient" aria-hidden="true">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="url(#motivaIconGradient)"
                     stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M21 11.5a8.4 8.4 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.4 8.4 0 0 1-3.8-.9L3 21l1.9-5.7a8.4 8.4 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.4 8.4 0 0 1 3.8-.9h.5a8.5 8.5 0 0 1 8 8v.5z"></path>
                </svg>
            </span>
            <h2 class="sd-head-title orc-title">דורש תשומת לב</h2>
            <a class="sd-head-link" href="/requests">לכל הבקשות</a>
        </div>

        @if (_rows.Count == 0)
        {
            @* Wording follows the selection: this card is empty when nothing
               is waiting on the STUDENT, which is not the same as having no
               open requests at all. The head's link is how the full list is
               reached. *@
            <MEmptyState Title="אין בקשות שממתינות לך"
                         Description="בקשה שתוחזר אלייך לקבלת פרטים נוספים תופיע כאן. שאר הבקשות שפתחת ממתינות למענה ונמצאות תחת ״כל הבקשות״." />
        }
        else
        {
            <MRowList Class="orc-list" AriaLabel="בקשות שממתינות לך">
                @foreach (var row in _rows)
                {
                    @* ── THE STATE IS A CHIP, NOT A LINE OF TEXT ──────────────
                       It was passed as Meta, which renders `.m-row-meta`:
                       13px/600 muted ink with no box. At the end of a row
                       whose primary is 15px/500, that reads as a second
                       heading rather than as an annotation on the first —
                       "תגובה חדשה" looked like a label for the row beneath it.

                       MStatusBadge is the system's chip, so the state now
                       carries the product's default tag language — white
                       paper, Motiva gradient edge, dark ink, pill radius —
                       and matches every other informational chip on this
                       dashboard rather than inventing a local one.

                       DELIBERATELY NEUTRAL, NOT ROSE. The rose dot in
                       Leading is still the whole attention signal. A red
                       chip beside a red dot would say the same thing twice
                       and make the entire row read as an alarm, which is
                       louder than "a request came back to you" ever is.

                       The string is unchanged: RequestBuckets.RowLabel, the
                       student workspace's own word for this bucket, so the
                       row says the same thing here and on /requests. *@
                    <MRow Class="orc-row"
                          Primary="@row.Title"
                          Secondary="@row.TypeLabel"
                          Href="@($"/requests?requestId={row.Id}")"
                          AriaLabel="@($"מעבר לבקשה {row.Title} — {row.StateText}")">
                        <Leading>
                            <MStatusDot Tone="MStatusDot.DotTone.Rose" AriaLabel="@row.StateText" />
                        </Leading>
                        <Status>
                            <MStatusBadge Text="@row.StateText" />
                        </Status>
                    </MRow>
                }
            </MRowList>
        }
    </div>
</MCard>

@code {
    [Parameter, EditorRequired] public List<OpenRequestDto> OpenRequests { get; set; } = new();

    /// <summary>Bounded for density, matching every other list on this page.
    /// The footer link carries the remainder.</summary>
    private const int MaxRows = 3;

    private sealed record Row(int Id, string Title, string TypeLabel, string StateText);

    /// <summary>
    /// The rows this card may show: the requests whose NEXT ACTION is the
    /// student's.
    ///
    /// <para>The predicate is RequestOwnership.AwaitsStudent — the shared
    /// Shared-layer rule, keyed on the request's workflow status, not on any
    /// displayed text. The lecturer dashboard filters the same feed with
    /// AwaitsStaff, so the two dashboards can never both claim the same
    /// request nor both drop it.</para>
    ///
    /// <para>OpenRequests already excludes the terminal statuses server-side
    /// (ProjectsController's my-dashboard query drops Resolved and Closed), so
    /// this narrows an already-open set rather than re-deriving "open".</para>
    ///
    /// <para>RequestType arrives as the raw controlled constant.
    /// RequestTypes.Label is the product's own Hebrew for it — the same mapping
    /// the requests screens use — so a type reads identically here and there.
    /// An unknown value falls through Label unchanged rather than being
    /// hidden.</para>
    /// </summary>
    private List<Row> _rows => OpenRequests
        .Where(r => RequestOwnership.AwaitsStudent(r.Status))
        .Take(MaxRows)
        .Select(r => new Row(
            r.Id,
            r.Title,
            RequestTypes.Label(r.RequestType),
            RequestBuckets.RowLabel(RequestBuckets.Of(r.Status))))
        .ToList();

    // ── WHY THE ROW IS A LINK TO ITS OWN REQUEST ──────────────────────────
    // It used to call Nav.NavigateTo("/requests") with no id, on the grounds —
    // recorded in a comment here — that the student requests page had no
    // ?requestId= deep link. That stopped being true: StudentRequestsPage now
    // reads [SupplyParameterFromQuery(Name = "requestId")] and selects the row,
    // the same convention the mentor inbox, the notification bell and the
    // updates card beside this one already use. The card was simply the last
    // caller still throwing the id away, so a student who clicked the request
    // that needed them had to find it again.
    //
    // It is an Href rather than an OnClick because this is navigation to an
    // addressable thing: the URL is shareable, survives a refresh, and opens
    // in a new tab on middle-click. MRow renders <a> and <button> with the
    // same class, so nothing about the row's appearance changes.
    //
    // Not found is handled at the destination — ApplyDeepLink() ignores an id
    // that is not in the student's own list and leaves the normal page.
}
