@using AuthWithAdmin.Shared.AuthSharedModels
@using AuthWithAdmin.Client.Pages.Requests
@using AuthWithAdmin.Client.Pages.Dashboard

@* ─────────────────────────────────────────────────────────────
   OpenRequestsCard — "דורש תשומת לב"

   ── THE HEADING AND THE CONTENT ARE TWO DIFFERENT DECISIONS ───────────
   This card is titled "דורש תשומת לב" and shows REQUESTS. That is
   deliberate, not a mismatch: the dashboard used to carry this card as
   "דורש התייחסות" next to a second, smaller card titled "דורש תשומת לב",
   and two headings that mean the same thing in Hebrew read as one idea
   split in half. The name settled here; the other card's placement was
   withdrawn (see Dashboard.razor).

   ── WHAT IT SELECTS: ONLY WHAT THE STUDENT CAN ACT ON ─────────────────
   It used to list every request on the project that was not Resolved or
   Closed — which meant a request the student had filed and was WAITING
   on appeared under a heading telling them to attend to it. Nothing was
   waiting for them; they had already done their part.

   The filter is now the request's own workflow state, read through the
   single shared rule in Shared: RequestOwnership.AwaitsStudent. Only a
   request whose next action genuinely belongs to the team — NeedsInfo,
   "הוחזרה לסטודנט", the one status the server's /reply endpoint exists
   for — reaches this list. Anything sitting with a mentor or the
   academic side is out, by the same rule the mentor and lecturer
   dashboards use from their own side.

   This is a selection change ONLY. The data source (DashboardDto.
   OpenRequests), the route, the link, the cap and the row language are
   all untouched, and /requests still lists the complete set in its three
   responsibility buckets — the footer link is right there in the head.

   ── WHY THE ROW IS ROSE NOW ───────────────────────────────────────────
   It used to be violet, and the note that said so was right at the time:
   violet is the product's "in flight" tone, and the card was full of
   requests in flight. Now that a row appears here only when the student
   is the one holding it up, "in flight" is precisely what it is not —
   rose (--motiva-color-rose, the Master's attention tone, reached
   through MStatusDot's closed three-tone enum rather than a new colour)
   is the accurate signal.

   ROSE IS THE DOT AND NOTHING ELSE. The state text goes back to the
   neutral default tone: the row is a piece of information, not an alarm,
   and a fully-coloured row spends the attention budget on the fact that
   a row exists. Same rule the mentor and lecturer queues follow.
   ───────────────────────────────────────────────────────────── *@

<MCard Padding="MCard.CardPadding.None"
       Class="orc-card"
       Fill="true">
    <div class="orc-body">
        @* The mentor dashboard's section head: the glyph ALONE (no chip),
           the title, and the "see all" link at the head's reading end —
           where the mentor puts it — rather than centred under the list.
           Same href, same label, same destination. *@
        <div class="sd-head orc-head">
            <span class="sd-head-icon motiva-ico-gradient" aria-hidden="true">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="url(#motivaIconGradient)"
                     stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z"></path>
                    <path d="M12 9v4M12 17h.01"></path>
                </svg>
            </span>
            <h2 class="sd-head-title orc-title">דורש תשומת לב</h2>
        </div>

        @if (_items.Count == 0)
        {
            <MEmptyState Title="אין כרגע פריטים שדורשים את תשומת ליבך" />
        }
        else
        {
            <MRowList Class="orc-list" AriaLabel="פריטים שדורשים תשומת לב">
                @foreach (var item in _items)
                {
                    var captured = item;
                    @if (captured.TaskId.HasValue)
                    {
                        <MRow Class="orc-row"
                              Primary="@captured.Primary"
                              Secondary="@captured.Secondary"
                              OnClick="@(() => OnOpenTask.InvokeAsync(captured.TaskId!.Value))"
                              AriaLabel="@($"פתיחת {captured.Primary} — {captured.StateText}")">
                            <Leading>
                                <MStatusDot Tone="MStatusDot.DotTone.Rose" AriaLabel="@captured.StateText" />
                            </Leading>
                            <Status>
                                <MStatusBadge Text="@captured.StateText" />
                            </Status>
                        </MRow>
                    }
                    else
                    {
                        <MRow Class="orc-row"
                              Primary="@captured.Primary"
                              Secondary="@captured.Secondary"
                              Href="@captured.RequestHref"
                              AriaLabel="@($"מעבר לבקשה {captured.Primary} — {captured.StateText}")">
                            <Leading>
                                <MStatusDot Tone="MStatusDot.DotTone.Rose" AriaLabel="@captured.StateText" />
                            </Leading>
                            <Status>
                                <MStatusBadge Text="@captured.StateText" />
                            </Status>
                        </MRow>
                    }
                }
            </MRowList>
        }
    </div>
</MCard>

@code {
    /// <summary>Open project requests, pre-filtered server-side to exclude
    /// Resolved and Closed. Client-side we further narrow to AwaitsStudent.</summary>
    [Parameter, EditorRequired] public List<OpenRequestDto>      OpenRequests { get; set; } = new();

    /// <summary>All milestones for the student's project — used to derive
    /// task-level attention items via the shared StudentDashboardModel rules.</summary>
    [Parameter]                 public List<MilestoneSummaryDto> Milestones   { get; set; } = new();

    /// <summary>Opens the TaskDetailModal for a task row.</summary>
    [Parameter]                 public EventCallback<int>        OnOpenTask   { get; set; }

    private sealed record Item(
        string  Primary,
        string  Secondary,
        string  StateText,
        int?    TaskId,       // non-null → task row (opens modal)
        string? RequestHref); // non-null → request row (navigates)

    /// <summary>
    /// Unified attention list: task exceptions followed by request exceptions.
    ///
    /// TASKS — every item StudentDashboardModel.AttentionTasks identifies:
    ///   • Returned by the mentor / returned for revision (student must resubmit).
    ///   • Overdue: past due date, still open.
    ///   • PendingMoodle: mentor approved, student has not yet confirmed in Moodle.
    /// No ExcludeTaskId: if the focus card also flags the task, it must appear
    /// here too — the requirement is to show everything actionable, not to avoid
    /// repeating what the focus card says.
    ///
    /// REQUESTS — only NeedsInfo: the single status RequestOwnership.AwaitsStudent
    /// returns true for. A request sitting with a mentor or the academic side is
    /// not actionable by the student and is not shown.
    ///
    /// Ordering: tasks surface first (they are active submission work); requests
    /// follow. Within tasks the existing kind ordering is preserved (Returned →
    /// Overdue → PendingMoodle). Within requests, the server already orders by
    /// CreatedAt DESC.
    /// </summary>
    private List<Item> _items
    {
        get
        {
            var taskItems = StudentDashboardModel
                .AttentionTasks(Milestones)
                .Select(x => new Item(
                    x.Task.Title,
                    x.Milestone.Title,
                    TaskStateText(x.Task, x.Kind),
                    x.Task.Id,
                    null))
                .ToList();

            var requestItems = OpenRequests
                .Where(r => RequestOwnership.AwaitsStudent(r.Status))
                .Select(r => new Item(
                    r.Title,
                    RequestTypes.Label(r.RequestType),
                    RequestBuckets.RowLabel(RequestBuckets.Of(r.Status)),
                    null,
                    $"/requests?requestId={r.Id}"))
                .ToList();

            return taskItems.Concat(requestItems).ToList();
        }
    }

    private static string TaskStateText(TaskSummaryDto task, StudentDashboardModel.AttentionKind kind) =>
        kind switch
        {
            StudentDashboardModel.AttentionKind.Returned      => "הוחזר לתיקון",
            StudentDashboardModel.AttentionKind.Overdue       => OverdueText(task),
            _                                                 => "ממתין לאישור במודל",
        };

    private static string OverdueText(TaskSummaryDto task)
    {
        var days = (int)(DateTime.Today - task.DueDate!.Value.Date).TotalDays;
        return days == 1 ? "יום אחד באיחור" : $"{days} ימים באיחור";
    }
}
