@{
    RenderFragment body = @<text>
        @if (_submissions.Count == 0 && (_allUpcoming.Count == 0 ? NextDeadline is null : true))
        {
            <div class="usc2-empty">
                <span class="oi oi-circle-check usc2-empty-icon" aria-hidden="true"></span>
                <p class="usc2-empty-text">
                    @(_allUpcoming.Count == 0 ? "אין הגשות קרובות" : "כל ההגשות הקרובות מוצגות למעלה")
                </p>
            </div>
        }
        else if (_submissions.Count > 0)
        {
            <div class="usc2-list">
                @foreach (var (task, milestoneTitle) in _submissions)
                {
                    var resolved = ResolveStatus(task);
                    // A task only reaches this list once IsActionCenterItem has
                    // ruled out every "student still owes action" overdue case,
                    // so a passed due date here always means the task is already
                    // submitted and sitting with someone else (mentor/Moodle) —
                    // never a lateness the student caused. The red "overdue"
                    // treatment is reserved for that genuine case, i.e. a
                    // submission that was never made at all.
                    bool overdue = task.DueDate.HasValue
                                && task.DueDate.Value.Date < DateTime.Today
                                && task.LatestSubmissionStatus is null;
                    int  days    = task.DueDate.HasValue
                                ? (int)(task.DueDate.Value.Date - DateTime.Today).TotalDays
                                : 0;

                    <div class="usc2-item @(overdue ? "usc2-item-overdue" : "")">
                        <div class="usc2-item-top">
                            <span class="usc2-task-title">@task.Title</span>
                            @if (days >= 0 || overdue)
                            {
                                <span class="usc2-days @DaysClass(days, overdue)">@DaysLabel(days, overdue)</span>
                            }
                        </div>
                        <div class="usc2-item-meta">
                            <span class="usc2-milestone-name">
                                <span class="oi oi-map-marker usc2-ms-icon" aria-hidden="true"></span>
                                @milestoneTitle
                            </span>
                            @if (task.DueDate.HasValue)
                            {
                                <span class="usc2-date">
                                    <span class="oi oi-calendar usc2-date-icon" aria-hidden="true"></span>
                                    @task.DueDate.Value.ToString("dd/MM/yyyy")
                                </span>
                            }
                        </div>
                        <div class="usc2-item-footer">
                            <MStatusBadge Text="@TaskLabel(resolved, overdue)" Variant="TaskVariant(resolved, overdue)" />
                            <button class="usc2-open-btn"
                                    @onclick="@(() => OnOpenTask.InvokeAsync(task.Id))">
                                פתיחת משימה
                                <span class="oi oi-chevron-left usc2-btn-arrow" aria-hidden="true"></span>
                            </button>
                        </div>
                    </div>
                }
            </div>
        }
        else if (NextDeadline is not null)
        {
            <!-- Fallback: show the server-derived next deadline when no
                 IsSubmission tasks are found in the milestone list. -->
            var fallbackDays = (int)(NextDeadline.DueDate.Date - DateTime.Today).TotalDays;
            bool fallbackOverdue = fallbackDays < 0;

            <div class="usc2-list">
                <div class="usc2-item @(fallbackOverdue ? "usc2-item-overdue" : "")">
                    <div class="usc2-item-top">
                        <span class="usc2-task-title">@NextDeadline.Title</span>
                        <span class="usc2-days @DaysClass(fallbackDays, fallbackOverdue)">
                            @DaysLabel(fallbackDays, fallbackOverdue)
                        </span>
                    </div>
                    <div class="usc2-item-meta">
                        <span class="usc2-date">
                            <span class="oi oi-calendar usc2-date-icon" aria-hidden="true"></span>
                            @NextDeadline.DueDate.ToString("dd/MM/yyyy")
                        </span>
                    </div>
                    <div class="usc2-item-footer">
                        @if (NextDeadline.LatestMentorStatus == "Returned")
                        {
                            <MStatusBadge Text="הוחזר לתיקון" Variant="MStatusBadge.BadgeVariant.Warning" />
                        }
                        else
                        {
                            <MStatusBadge Text="ממתין להגשה" Variant="MStatusBadge.BadgeVariant.Neutral" />
                        }
                        @if (NextDeadline.TaskId.HasValue)
                        {
                            <button class="usc2-open-btn"
                                    @onclick="@(() => OnOpenTask.InvokeAsync(NextDeadline.TaskId!.Value))">
                                פתיחת משימה
                                <span class="oi oi-chevron-left usc2-btn-arrow" aria-hidden="true"></span>
                            </button>
                        }
                        else
                        {
                            <button class="usc2-open-btn"
                                    @onclick="@(() => Nav.NavigateTo("/tasks"))">
                                לכל המשימות
                                <span class="oi oi-chevron-left usc2-btn-arrow" aria-hidden="true"></span>
                            </button>
                        }
                    </div>
                </div>
            </div>
        }
    </text>;
}

