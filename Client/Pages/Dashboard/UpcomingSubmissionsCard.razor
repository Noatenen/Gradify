@code {
    [Parameter, EditorRequired] public List<MilestoneSummaryDto> Milestones   { get; set; } = new();
    [Parameter]                 public UpcomingDeadlineDto?      NextDeadline { get; set; }
    [Parameter]                 public EventCallback<int>        OnOpenTask   { get; set; }

    /// <summary>Task the focus card shows in full — excluded by identity, not
    /// by list position, because the focus pick is very often the same task the
    /// attention band flags.</summary>
    [Parameter] public int? ExcludeTaskId { get; set; }

    private const int MaxRows = 3;

    private sealed record Row(string Title, string Subtitle, string DueLabel, MRow.RowMetaTone Tone, int? TaskId);

    private List<Row> _rows => BuildRows();

    private List<Row> BuildRows()
    {
        var rows = Milestones
            .SelectMany(ms => ms.Tasks
                .Where(t => t.IsSubmission
                            && t.DueDate.HasValue
                            && !StudentDashboardModel.IsComplete(t)
                            && t.Id != ExcludeTaskId
                            && !StudentDashboardModel.IsAttentionItem(t))
                .Select(t => (Task: t, MilestoneTitle: ms.Title)))
            .OrderBy(x => x.Task.DueDate!.Value)
            .Take(MaxRows)
            .Select(x => ToRow(x.Task.Title, x.MilestoneTitle, x.Task.DueDate!.Value, x.Task.Id,
                               submitted: x.Task.LatestSubmissionStatus is not null))
            .ToList();

        // Fallback: the server's own nearest deadline, for a project whose
        // milestone data carries no IsSubmission task yet. UpcomingDeadlineDto
        // carries no submission status, so it is treated as not-yet-submitted.
        if (rows.Count == 0 && NextDeadline is not null)
        {
            rows.Add(ToRow(NextDeadline.Title, "מועד קרוב", NextDeadline.DueDate, NextDeadline.TaskId,
                           submitted: false));
        }

        return rows;
    }

    // A task only reaches this list after the attention rules have ruled out
    // every "the student still owes something" case, so a passed due date here
    // means the work is already submitted and sitting with the mentor or with
    // Moodle — never a lateness the student caused. Saying "23 ימים באיחור"
    // about it would be wrong, so a submitted-but-past-due row shows the date
    // alone and rose is reserved for a deadline that is genuinely pressing.
    private static Row ToRow(string title, string subtitle, DateTime due, int? taskId, bool submitted)
    {
        var days       = StudentDashboardModel.DaysUntil(due) ?? 0;
        var studentLate = days < 0 && !submitted;

        var meta = days < 0 && submitted
            ? $"{due:dd.MM}"
            : $"{due:dd.MM} · {StudentDashboardModel.DaysText(days)}";

        var tone = studentLate || (days >= 0 && days <= 3)
            ? MRow.RowMetaTone.Rose
            : MRow.RowMetaTone.Default;

        return new Row(title, subtitle, meta, tone, taskId);
    }

    private async Task Open(Row row)
    {
        if (row.TaskId.HasValue) await OnOpenTask.InvokeAsync(row.TaskId.Value);
    }
}
