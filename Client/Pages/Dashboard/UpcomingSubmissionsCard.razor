@using AuthWithAdmin.Shared.AuthSharedModels
@inject NavigationManager Nav

<!-- ══════════════════════════════════════════════════════════════
     UpcomingSubmissionsCard
     Shows up to 3 upcoming submission tasks derived client-side
     from the milestone data (IsSubmission == true, not complete,
     has a DueDate, ordered soonest first).

     Falls back to NextDeadline when no submission tasks are found
     in the milestone list (edge case: project with no IsSubmission
     tasks yet mapped in the current data).

     CTA is "פתיחת משימה" → opens the existing TaskDetailModal via
     OnOpenTask. No upload actions on the dashboard (those belong
     in the task/milestone workspace).

     Embedded (default): rendered as the second zone of the shared
     "Project Signal" panel in Dashboard.razor, directly below
     ActionCenterCard — one continuous surface instead of two
     separate boxes with duplicated chrome. Embedded=false keeps the
     original standalone MCard for reuse elsewhere if ever needed.
     ══════════════════════════════════════════════════════════════ -->

@{
    RenderFragment body = @<text>
        @if (_submissions.Count == 0 && (_allUpcoming.Count == 0 ? NextDeadline is null : true))
        {
            <div class="usc2-empty">
                <span class="oi oi-circle-check usc2-empty-icon" aria-hidden="true"></span>
                <p class="usc2-empty-text">
                    @(_allUpcoming.Count == 0 ? "אין הגשות קרובות" : "כל ההגשות הקרובות מוצגות למעלה")
                </p>
            </div>
        }
        else if (_submissions.Count > 0)
        {
            <div class="usc2-list">
                @foreach (var (task, milestoneTitle) in _submissions)
                {
                    var resolved = ResolveStatus(task);
                    // A task only reaches this list once IsActionCenterItem has
                    // ruled out every "student still owes action" overdue case,
                    // so a passed due date here always means the task is already
                    // submitted and sitting with someone else (mentor/Moodle) —
                    // never a lateness the student caused. The red "overdue"
                    // treatment is reserved for that genuine case, i.e. a
                    // submission that was never made at all.
                    bool overdue = task.DueDate.HasValue
                                && task.DueDate.Value.Date < DateTime.Today
                                && task.LatestSubmissionStatus is null;
                    int  days    = task.DueDate.HasValue
                                ? (int)(task.DueDate.Value.Date - DateTime.Today).TotalDays
                                : 0;

                    <div class="usc2-item @(overdue ? "usc2-item-overdue" : "")">
                        <div class="usc2-item-top">
                            <span class="usc2-task-title">@task.Title</span>
                            @if (days >= 0 || overdue)
                            {
                                <span class="usc2-days @DaysClass(days, overdue)">@DaysLabel(days, overdue)</span>
                            }
                        </div>
                        <div class="usc2-item-meta">
                            <span class="usc2-milestone-name">
                                <span class="oi oi-map-marker usc2-ms-icon" aria-hidden="true"></span>
                                @milestoneTitle
                            </span>
                            @if (task.DueDate.HasValue)
                            {
                                <span class="usc2-date">
                                    <span class="oi oi-calendar usc2-date-icon" aria-hidden="true"></span>
                                    @task.DueDate.Value.ToString("dd/MM/yyyy")
                                </span>
                            }
                        </div>
                        <div class="usc2-item-footer">
                            <MStatusBadge Text="@TaskLabel(resolved, overdue)" Variant="TaskVariant(resolved, overdue)" />
                            <button class="usc2-open-btn"
                                    @onclick="@(() => OnOpenTask.InvokeAsync(task.Id))">
                                פתיחת משימה
                                <span class="oi oi-chevron-left usc2-btn-arrow" aria-hidden="true"></span>
                            </button>
                        </div>
                    </div>
                }
            </div>
        }
        else if (NextDeadline is not null)
        {
            <!-- Fallback: show the server-derived next deadline when no
                 IsSubmission tasks are found in the milestone list. -->
            var fallbackDays = (int)(NextDeadline.DueDate.Date - DateTime.Today).TotalDays;
            bool fallbackOverdue = fallbackDays < 0;

            <div class="usc2-list">
                <div class="usc2-item @(fallbackOverdue ? "usc2-item-overdue" : "")">
                    <div class="usc2-item-top">
                        <span class="usc2-task-title">@NextDeadline.Title</span>
                        <span class="usc2-days @DaysClass(fallbackDays, fallbackOverdue)">
                            @DaysLabel(fallbackDays, fallbackOverdue)
                        </span>
                    </div>
                    <div class="usc2-item-meta">
                        <span class="usc2-date">
                            <span class="oi oi-calendar usc2-date-icon" aria-hidden="true"></span>
                            @NextDeadline.DueDate.ToString("dd/MM/yyyy")
                        </span>
                    </div>
                    <div class="usc2-item-footer">
                        @if (NextDeadline.LatestMentorStatus == "Returned")
                        {
                            <MStatusBadge Text="הוחזר לתיקון" Variant="MStatusBadge.BadgeVariant.Warning" />
                        }
                        else
                        {
                            <MStatusBadge Text="ממתין להגשה" Variant="MStatusBadge.BadgeVariant.Neutral" />
                        }
                        @if (NextDeadline.TaskId.HasValue)
                        {
                            <button class="usc2-open-btn"
                                    @onclick="@(() => OnOpenTask.InvokeAsync(NextDeadline.TaskId!.Value))">
                                פתיחת משימה
                                <span class="oi oi-chevron-left usc2-btn-arrow" aria-hidden="true"></span>
                            </button>
                        }
                        else
                        {
                            <button class="usc2-open-btn"
                                    @onclick="@(() => Nav.NavigateTo("/tasks"))">
                                לכל המשימות
                                <span class="oi oi-chevron-left usc2-btn-arrow" aria-hidden="true"></span>
                            </button>
                        }
                    </div>
                </div>
            </div>
        }
    </text>;
}

@if (Embedded)
{
    <div class="usc2-embedded">
        <div class="usc2-embedded-header">
            <span class="oi oi-calendar usc2-header-icon" aria-hidden="true"></span>
            <h3 class="usc2-embedded-title">משימות להגשה</h3>
        </div>
        @body
    </div>
}
else
{
    <MCard Class="usc2-card" Padding="MCard.CardPadding.None" Title="משימות להגשה">
        <Icon><span class="oi oi-calendar usc2-header-icon" aria-hidden="true"></span></Icon>
        <ChildContent>@body</ChildContent>
    </MCard>
}

@code {
    [Parameter, EditorRequired] public List<MilestoneSummaryDto> Milestones   { get; set; } = default!;
    [Parameter]                 public UpcomingDeadlineDto?      NextDeadline { get; set; }
    [Parameter]                 public EventCallback<int>        OnOpenTask   { get; set; }
    [Parameter]                 public bool                      Embedded     { get; set; }

    // The single nearest-due submission across the whole project — computed
    // with the exact same rule as StudentDashboardHero._nextSubmission (earliest
    // due date, incomplete, regardless of exception status) so we can exclude
    // precisely the task the hero already shows in full detail, by identity
    // rather than by list position. Position-based skipping broke once
    // exception items were filtered out below: the hero's pick is very often
    // the same task ActionCenterCard flags (the most overdue thing usually has
    // the earliest due date), so a plain Skip(1) would silently drop the next
    // legitimate calm item instead of the one already shown elsewhere.
    private TaskSummaryDto? _heroNextSubmission =>
        Milestones
            .SelectMany(ms => ms.Tasks)
            .Where(t => t.IsSubmission && t.DueDate.HasValue && !IsComplete(t))
            .OrderBy(t => t.DueDate)
            .FirstOrDefault();

    // All upcoming IsSubmission tasks, sorted by due date, not yet complete,
    // excluding the hero's own pick and anything ActionCenterCard already
    // surfaces (returned / overdue / pending Moodle) — that card owns the
    // "needs attention" signal; repeating the same task here would make the
    // same exception look duplicated rather than urgent.
    // Used only to decide whether the NextDeadline fallback below applies.
    private List<(TaskSummaryDto Task, string MilestoneTitle)> _allUpcoming =>
        Milestones
            .SelectMany(ms => ms.Tasks
                .Where(t => t.IsSubmission && t.DueDate.HasValue && !IsComplete(t)
                            && t.Id != _heroNextSubmission?.Id
                            && !IsActionCenterItem(t))
                .Select(t => (Task: t, MilestoneTitle: ms.Title)))
            .OrderBy(x => x.Task.DueDate!.Value)
            .ToList();

    private List<(TaskSummaryDto Task, string MilestoneTitle)> _submissions =>
        _allUpcoming.Take(2).ToList();

    private static bool IsComplete(TaskSummaryDto t) =>
        t.IsSubmission
            ? t.LatestSubmissionStatus is not null
              && t.LatestMentorStatus == "Approved"
              && t.LatestMoodleConfirmed
            : t.Status == "Done";

    // Mirrors ActionCenterCard.BuildItems' exception conditions exactly, so a
    // task is never shown as both a calm "upcoming" item here and an urgent
    // exception there.
    private static bool IsActionCenterItem(TaskSummaryDto t)
    {
        if (t.LatestMentorStatus == "Returned") return true;
        if (t.LatestSubmissionStatus == "NeedsRevision") return true;
        if (t.DueDate.HasValue
            && t.DueDate.Value.Date < DateTime.Today
            && !IsComplete(t)
            && t.Status is "Open" or "InProgress" or "ReturnedForRevision") return true;
        if (t.IsSubmission && t.LatestMentorStatus == "Approved" && !t.LatestMoodleConfirmed) return true;
        return false;
    }

    private static string ResolveStatus(TaskSummaryDto t)
    {
        if (t.LatestSubmissionStatus is null) return t.Status;
        if (t.LatestMentorStatus == "Returned") return "ReturnedByMentor";
        if (t.LatestSubmissionStatus == "NeedsRevision") return "ReturnedForRevision";
        if (t.LatestMentorStatus == "Pending") return "PendingMentorReview";
        if (t.LatestMentorStatus == "Approved" && t.LatestSubmissionStatus == "Submitted") return "ApprovedByMentor";
        return t.Status;
    }

    private static string DaysLabel(int days, bool overdue)
    {
        if (overdue) return $"באיחור {Math.Abs(days)} ימים";
        return days switch { 0 => "היום!", 1 => "מחר", _ => $"נותרו {days} ימים" };
    }

    private static string DaysClass(int days, bool overdue)
    {
        if (overdue || days < 0) return "usc2-days-overdue";
        if (days <= 3) return "usc2-days-urgent";
        if (days <= 7) return "usc2-days-soon";
        return "usc2-days-normal";
    }

    private static MStatusBadge.BadgeVariant TaskVariant(string s, bool overdue) => overdue ? MStatusBadge.BadgeVariant.Danger : s switch
    {
        "Done"                  => MStatusBadge.BadgeVariant.Success,
        "InProgress"            => MStatusBadge.BadgeVariant.Success,
        "PendingMentorReview"   => MStatusBadge.BadgeVariant.Info,
        "ReturnedForRevision"   => MStatusBadge.BadgeVariant.Warning,
        "ReturnedByMentor"      => MStatusBadge.BadgeVariant.Warning,
        "ApprovedByMentor"      => MStatusBadge.BadgeVariant.Success,
        _                       => MStatusBadge.BadgeVariant.Neutral,
    };

    private static string TaskLabel(string s, bool overdue) => overdue ? "באיחור" : s switch
    {
        "Done"                  => "הושלמה",
        "InProgress"            => "בעבודה",
        "PendingMentorReview"   => "ממתין לאישור מנחה",
        "ReturnedForRevision"   => "הוחזר לתיקון",
        "ReturnedByMentor"      => "הוחזר ע״י מנחה",
        "ApprovedByMentor"      => "אושר — ממתין לאישור מרצה",
        _                       => "ממתין להגשה",
    };
}
