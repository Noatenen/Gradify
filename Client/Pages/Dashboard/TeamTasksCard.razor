@using AuthWithAdmin.Shared.AuthSharedModels
@using AuthWithAdmin.Client.Services
@inject ITeamTasksService TeamTasksService

@* ─────────────────────────────────────────────────────────────
   TeamTasksCard — student-created, team-visible work items.
   Completely separate from the official Tasks/Submissions workflow.
   No milestone, no mentor review, no progress impact.

   Embedded (default false): rendered as a zone of the shared
   "Dashboard Workspace" surface in Dashboard.razor, alongside
   ActionCenterCard/UpcomingSubmissionsCard — one continuous surface
   for the whole lower dashboard instead of three separate MCards.
   Mirrors the exact Embedded pattern those two cards already use.
   Embedded=false keeps the original standalone MCard for reuse
   elsewhere if ever needed.
   ───────────────────────────────────────────────────────────── *@

@{
    RenderFragment body = @<text>
        @if (_loading)
        {
            <div class="ttc-loading">
                <div class="ttc-spinner"></div>
            </div>
        }
        else if (_incompleteTasks.Count == 0)
        {
            <div class="ttc-empty">
                <span class="oi oi-people ttc-empty-icon" aria-hidden="true"></span>
                <p class="ttc-empty-title">אין כרגע משימות צוות פתוחות</p>
                <button class="ttc-empty-create-btn" @onclick="OpenCreateModal">
                    + משימה חדשה
                </button>
            </div>
        }
        else
        {
            <div class="ttc-list">
                @foreach (var task in _incompleteTasks)
                {
                    var captured = task;
                    <div class="ttc-item">

                        <!-- Toggle: mark complete -->
                        <button class="ttc-toggle-btn"
                                @onclick="@(() => ToggleTask(captured))"
                                title="@ToggleLabel(task.IsDone)"
                                aria-label="@ToggleLabel(task.IsDone)">
                            <span class="oi oi-circle ttc-toggle-icon" aria-hidden="true"></span>
                        </button>

                        <!-- Body: title + meta (clickable → edit) -->
                        <div class="ttc-item-body" @onclick="@(() => OpenEditModal(captured))"
                             role="button" tabindex="0"
                             @onkeydown="@(e => OnItemKeyDown(e, captured))">
                            <span class="ttc-item-title">@task.Title</span>
                            <div class="ttc-item-meta">
                                <span class="ttc-item-assignee">
                                    <span class="oi oi-person ttc-meta-icon" aria-hidden="true"></span>
                                    @task.AssigneeName
                                </span>
                                @if (task.DueDate.HasValue)
                                {
                                    var overdue = task.DueDate.Value.Date < DateTime.Today;
                                    <span class="ttc-item-due @(overdue ? "ttc-due-overdue" : "")">
                                        <span class="oi oi-calendar ttc-meta-icon" aria-hidden="true"></span>
                                        @task.DueDate.Value.ToString("dd/MM/yy")
                                    </span>
                                }
                            </div>
                        </div>

                        <!-- Delete: inline confirm pattern -->
                        @if (_pendingDeleteId == task.Id)
                        {
                            <div class="ttc-delete-confirm">
                                <span class="ttc-delete-confirm-text">מחק?</span>
                                <button class="ttc-confirm-yes" @onclick="@(() => ConfirmDelete(captured))">כן</button>
                                <button class="ttc-confirm-no"  @onclick="CancelDelete">לא</button>
                            </div>
                        }
                        else
                        {
                            <button class="ttc-delete-btn"
                                    @onclick="@(() => _pendingDeleteId = captured.Id)"
                                    title="מחק משימה"
                                    aria-label="מחק משימה">
                                <span class="oi oi-trash" aria-hidden="true"></span>
                            </button>
                        }

                    </div>
                }
            </div>
        }
    </text>;
}

@if (Embedded)
{
    <div class="ttc-embedded">
        <div class="ttc-embedded-header">
            <span class="oi oi-people ttc-header-icon" aria-hidden="true"></span>
            <h3 class="ttc-embedded-title">משימות צוות</h3>
            <button class="ttc-add-btn" @onclick="OpenCreateModal" title="משימה חדשה">
                <span class="oi oi-plus" aria-hidden="true"></span>
                משימה חדשה
            </button>
        </div>
        @body
    </div>
}
else
{
    <MCard Class="ttc-card" Padding="MCard.CardPadding.None" Title="משימות צוות">
        <Icon><span class="oi oi-people ttc-header-icon" aria-hidden="true"></span></Icon>
        <TrailingContent>
            <button class="ttc-add-btn" @onclick="OpenCreateModal" title="משימה חדשה">
                <span class="oi oi-plus" aria-hidden="true"></span>
                משימה חדשה
            </button>
        </TrailingContent>
        <ChildContent>@body</ChildContent>
    </MCard>
}

@*
    Create / Edit modal — the shared TeamTaskEditModal. Phase 4B moved this
    card's own modal markup, form state and save logic into that component
    unchanged, so the Tasks page could reuse the same behaviour instead of a
    second copy. Nothing about how this card looks or behaves changed.
*@
<TeamTaskEditModal IsOpen="@_showModal"
                   EditingTask="@_editingTask"
                   TeamMembers="@TeamMembers"
                   OnClose="CloseModal"
                   OnCreated="OnTaskCreated"
                   OnUpdated="StateHasChanged" />

@code {
    /// <summary>Team member list passed from the parent dashboard (already loaded
    /// in DashboardDto.TeamMembers — no extra API call needed).</summary>
    [Parameter] public List<TeamMemberDto> TeamMembers { get; set; } = new();
    [Parameter] public bool                Embedded    { get; set; }

    private List<TeamTaskDto> _tasks     = new();
    private bool              _loading   = true;
    private bool              _showModal;
    private TeamTaskDto?      _editingTask;
    private int               _pendingDeleteId;

    // Show only incomplete tasks, up to 4 (matches product spec)
    private List<TeamTaskDto> _incompleteTasks =>
        _tasks.Where(t => !t.IsDone).Take(4).ToList();

    // Helpers: avoid double-quote conflicts inside HTML attribute strings
    private static string ToggleLabel(bool isDone) =>
        isDone ? "ביטול סימון" : "סימון כהושלם";

    private void OnItemKeyDown(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e, TeamTaskDto task)
    {
        if (e.Key == "Enter") OpenEditModal(task);
    }

    protected override async Task OnInitializedAsync()
    {
        _tasks   = await TeamTasksService.GetAsync();
        _loading = false;
    }

    private void OpenCreateModal()
    {
        _editingTask = null;
        _showModal   = true;
    }

    private void OpenEditModal(TeamTaskDto task)
    {
        _editingTask = task;
        _showModal   = true;
    }

    private void CloseModal()
    {
        _showModal   = false;
        _editingTask = null;
    }

    private void OnTaskCreated(TeamTaskDto created) => _tasks.Insert(0, created);

    private async Task ToggleTask(TeamTaskDto task)
    {
        var success = await TeamTasksService.ToggleAsync(task.Id);
        if (success) task.IsDone = !task.IsDone;
    }

    private async Task ConfirmDelete(TeamTaskDto task)
    {
        var success = await TeamTasksService.DeleteAsync(task.Id);
        if (success) _tasks.Remove(task);
        _pendingDeleteId = 0;
    }

    private void CancelDelete() => _pendingDeleteId = 0;
}