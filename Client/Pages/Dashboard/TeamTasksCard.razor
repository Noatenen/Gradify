@using AuthWithAdmin.Shared.AuthSharedModels
@using AuthWithAdmin.Client.Services
@inject ITeamTasksService TeamTasksService

@* ─────────────────────────────────────────────────────────────
   TeamTasksCard — "משימות צוות"
   Visual source: Motiva Student Dashboard V4.dc.html:237-274.

   Student-created, team-visible work items. Completely separate from the
   official Tasks/Submissions workflow: no milestone, no mentor review, no
   effect on project progress.

   V4's presentation, matched: full-width ambient-edge card; header
   carrying the title, a quiet sub-label and a 28px violet "+"; rows laid
   out as [checkbox · title · assignee initials · due]; a maximum of three
   open rows followed by a centred "ראה הכל" that hands off to the Tasks
   page's own team-tasks panel rather than expanding here.

   The BEHAVIOUR is the real one and is unchanged: ITeamTasksService
   Get/Toggle/Delete plus the shared TeamTaskEditModal, which the approved
   Tasks page also uses. Delete stays available — it moved from an inline
   confirm into the edit modal, which is where V4 puts it.
   ───────────────────────────────────────────────────────────── *@

<MCard Variant="MCard.CardVariant.AmbientEdge"
       Padding="MCard.CardPadding.None"
       Class="ttc-card">
    <div class="ttc-body">
        <div class="ttc-head">
            <div class="ttc-head-text">
                <h2 class="ttc-title">משימות צוות</h2>
                <span class="ttc-subtitle">משימות פנימיות וחלוקת אחריות</span>
            </div>
            <button type="button" class="ttc-add motiva-cta"
                    @onclick="OpenCreateModal"
                    title="הוספת משימת צוות" aria-label="הוספת משימת צוות">
                <span class="oi oi-plus" aria-hidden="true"></span>
            </button>
        </div>

        @if (_loading)
        {
            <div class="ttc-loading" role="status" aria-live="polite">
                <span class="ttc-spinner" aria-hidden="true"></span>
                <span>טוענת משימות צוות…</span>
            </div>
        }
        else if (_open.Count == 0)
        {
            <MEmptyState Title="אין כרגע משימות צוות"
                         Description="משימות שהצוות מגדיר לעצמו יופיעו כאן.">
                <Action>
                    <MButton Variant="MButton.ButtonVariant.Primary"
                             Size="MButton.ButtonSize.Small"
                             OnClick="OpenCreateModal">
                        הוספת משימה
                    </MButton>
                </Action>
            </MEmptyState>
        }
        else
        {
            <div class="ttc-list">
                @foreach (var task in _visible)
                {
                    var captured = task;
                    <div class="ttc-row">
                        @*
                            A real checkbox role with a real keyboard handler —
                            unlike the milestone checklist in the hero, THIS
                            toggle is backed by an API (TeamTasks.Toggle) and
                            is genuinely interactive.
                        *@
                        <span class="ttc-check @(task.IsDone ? "ttc-check-on" : "")"
                              role="checkbox" tabindex="0"
                              aria-checked="@(task.IsDone ? "true" : "false")"
                              aria-label="@(task.IsDone ? "ביטול סימון" : "סימון כהושלם")"
                              @onclick="@(() => ToggleTask(captured))"
                              @onclick:stopPropagation="true"
                              @onkeydown="@(e => OnCheckKeyDown(e, captured))"
                              @onkeydown:stopPropagation="true">
                            @if (task.IsDone)
                            {
                                <span class="ttc-check-mark" aria-hidden="true">✓</span>
                            }
                        </span>

                        <button type="button" class="ttc-row-title"
                                @onclick="@(() => OpenEditModal(captured))"
                                aria-label="@($"עריכת {task.Title}")">
                            @task.Title
                        </button>

                        <span class="ttc-assignee" title="@task.AssigneeName" aria-label="@task.AssigneeName">
                            @Initials(task.AssigneeName)
                        </span>

                        <span class="ttc-due">@DueLabel(task)</span>
                    </div>
                }
            </div>

            @if (_open.Count > MaxRows)
            {
                <div class="ttc-foot">
                    <a class="ttc-all" href="/tasks#team-tasks">ראה הכל</a>
                </div>
            }
        }
    </div>
</MCard>

@*
    Create / edit modal — the shared TeamTaskEditModal, unchanged. Delete
    lives inside it, which is where V4 puts the delete action too.
*@
<TeamTaskEditModal IsOpen="@_showModal"
                   EditingTask="@_editingTask"
                   TeamMembers="@TeamMembers"
                   OnClose="CloseModal"
                   OnCreated="OnTaskCreated"
                   OnUpdated="StateHasChanged" />

@code {
    /// <summary>Team member list passed from the parent dashboard (already in
    /// DashboardDto.TeamMembers — no extra API call needed).</summary>
    [Parameter] public List<TeamMemberDto> TeamMembers { get; set; } = new();

    /// <summary>Bounded on purpose (density requirement) — V4 shows three and
    /// hands the rest to the Tasks page.</summary>
    private const int MaxRows = 3;

    private List<TeamTaskDto> _tasks = new();
    private bool              _loading = true;
    private bool              _showModal;
    private TeamTaskDto?      _editingTask;

    private List<TeamTaskDto> _open    => _tasks.Where(t => !t.IsDone).ToList();
    private List<TeamTaskDto> _visible => _open.Take(MaxRows).ToList();

    protected override async Task OnInitializedAsync()
    {
        _tasks   = await TeamTasksService.GetAsync();
        _loading = false;
    }

    private void OpenCreateModal()
    {
        _editingTask = null;
        _showModal   = true;
    }

    private void OpenEditModal(TeamTaskDto task)
    {
        _editingTask = task;
        _showModal   = true;
    }

    private void CloseModal()
    {
        _showModal   = false;
        _editingTask = null;
    }

    private void OnTaskCreated(TeamTaskDto created) => _tasks.Insert(0, created);

    private async Task ToggleTask(TeamTaskDto task)
    {
        var success = await TeamTasksService.ToggleAsync(task.Id);
        if (success) task.IsDone = !task.IsDone;
    }

    private async Task OnCheckKeyDown(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e, TeamTaskDto task)
    {
        if (e.Key is "Enter" or " ") await ToggleTask(task);
    }

    private static string Initials(string? name)
    {
        var trimmed = (name ?? "").Trim();
        if (trimmed.Length == 0) return "—";
        var parts = trimmed.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length >= 2
            ? $"{parts[0][0]}{parts[1][0]}"
            : trimmed[..Math.Min(2, trimmed.Length)];
    }

    private static string DueLabel(TeamTaskDto task) =>
        task.DueDate.HasValue ? task.DueDate.Value.ToString("dd.MM") : "";
}
