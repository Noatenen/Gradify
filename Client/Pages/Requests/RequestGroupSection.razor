@*
    RequestGroupSection — one of the finalized design's three responsibility
    groups (Motiva Requests.dc.html, the `groups` loop).

    Design shape: a label whose weight encodes urgency (the "waiting on you"
    group is the only one drawn at 700/ink, the other two at 600/muted), an
    optional count, and — for "הושלמו" only — a show/hide toggle, since a
    finished request is history rather than work.

    It owns nothing but its own layout: the rows come in as ChildContent so
    this component never sees a request.
*@

<section class="rgs @(!string.IsNullOrEmpty(BucketClass) ? $"rgs-{BucketClass}" : "")">
    <div class="rgs-head">
        <p class="rgs-label @(Emphasis ? "rgs-label-strong" : "")">@Label</p>

        @if (Count > 0)
        {
            <span class="rgs-count">@Count @(Count == 1 ? "בקשה" : "בקשות")</span>
        }

        @if (Collapsible)
        {
            <button type="button"
                    class="rgs-toggle"
                    aria-expanded="@(Open ? "true" : "false")"
                    @onclick="OnToggle">
                @(Open ? "הסתרה" : "הצגה")
            </button>
        }
    </div>

    @if (!Collapsible || Open)
    {
        <div class="rgs-rows">@ChildContent</div>
    }
</section>

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = "";

    /// <summary>Number of requests in the group. Rendered beside the label, and
    /// it is the count of everything in the bucket — including the rows a
    /// collapsed group is not currently drawing.</summary>
    [Parameter] public int Count { get; set; }

    /// <summary>Draws the label at the Design's stronger weight. Reserved for
    /// the group that needs the student's action.</summary>
    [Parameter] public bool Emphasis { get; set; }

    [Parameter] public bool Collapsible { get; set; }
    [Parameter] public bool Open { get; set; }
    [Parameter] public EventCallback OnToggle { get; set; }

    [Parameter] public RenderFragment? ChildContent { get; set; }

    [Parameter] public string BucketClass { get; set; } = "";
}
