@page "/requests"
@layout AppLayout
@using Microsoft.AspNetCore.Authorization
@using AuthWithAdmin.Shared.AuthSharedModels
@using AuthWithAdmin.Client.Services
@using Microsoft.AspNetCore.Components.Forms
@attribute [Authorize]
@inject IProjectRequestsService RequestsService
@inject IRequestTypesService    RequestTypesService

@*
    StudentRequestsPage — the finalized Motiva Requests screen
    (design-reference/motiva/project/Motiva Requests.dc.html).

    The Design's shape: an ambient hero whose h1 is a state summary rather than
    a page title, a KPI row that IS the status filter, and one workspace card
    holding three responsibility groups of accordion threads. That replaces the
    previous two-pane inbox, where only one request could be open at a time.

    Everything below the presentation is unchanged: the same four service calls,
    the same reply validation, the same mark-read behaviour, the same statuses.
    The one behavioural correction is the "in flight" bucket, which now includes
    the two extension-flow statuses the old "ממתין למענה" pill silently dropped —
    see RequestWorkspaceModel.cs.
*@

<NewRequestModal IsOpen="@_showModal"
                 OnClose="CloseModal"
                 OnSuccess="OnRequestCreated" />

@*
    .sreq-header-bleed cancels the student shell's inline inset so the ambient
    band reaches the shell edge, exactly as /tasks does; MPageHeader's own
    padding keeps its text and the KPI row on the content boundary.
*@
<div class="sreq-header-bleed">
    <MPageHeader Variant="MPageHeader.HeaderVariant.Compact" Title="@HeroTitle">
        <Actions>
            <MButton Variant="MButton.ButtonVariant.Primary"
                     OnClick="OpenModal">
                <span class="sreq-new-plus" aria-hidden="true">+</span>
                <span class="sreq-new-label">בקשה חדשה</span>
            </MButton>
        </Actions>
        <ChildContent>
            @if (!_isLoading && !_loadError)
            {
                <RequestsKpiRow WaitingCount="@BucketCount(RequestBucket.Waiting)"
                                LecturerCount="@BucketCount(RequestBucket.Lecturer)"
                                DoneCount="@BucketCount(RequestBucket.Done)"
                                TotalCount="@_requests.Count"
                                ActiveStatusFilters="@_statusFilters"
                                OnSelectStatus="ToggleStatusFilter"
                                OnClearStatusFilters="ClearStatusFilters" />
            }
        </ChildContent>
    </MPageHeader>
</div>

@if (_isLoading)
{
    <div class="sreq-loading" role="status">
        <span class="sreq-spinner" aria-hidden="true"></span>
        <span>טוענת בקשות…</span>
    </div>
}
else if (_loadError)
{
    <div class="sreq-page">
        <MEmptyState Title="אירעה שגיאה בטעינת הבקשות"
                     Description="נסי לרענן את הדף." />
    </div>
}
else
{
    <div class="sreq-page">
        <MCard Variant="MCard.CardVariant.AmbientEdge" Padding="MCard.CardPadding.None">
            <div class="sreq-workspace">

                @if (_requests.Count > 0)
                {
                    <RequestFilterBar Axes="@FilterAxes"
                                      OnToggle="OnFilterToggled"
                                      OnClearAll="ClearAllFilters" />
                }

                @if (_requests.Count == 0)
                {
                    <MEmptyState Title="עדיין לא פתחת בקשות"
                                 Description="כשתפתחי בקשה לצוות האקדמי היא תופיע כאן, יחד עם כל השיחה סביבה.">
                        <Action>
                            <MButton Variant="MButton.ButtonVariant.Primary"
                                     OnClick="OpenModal">
                                פתיחת בקשה ראשונה
                            </MButton>
                        </Action>
                    </MEmptyState>
                }
                else if (!VisibleBuckets.Any())
                {
                    <MEmptyState Title="אין בקשות שתואמות לסינון הנוכחי"
                                 Description="אפשר לשנות את הסינון או להציג את כל הבקשות."
                                 Live="true">
                        <Action>
                            <MButton Variant="MButton.ButtonVariant.Secondary" OnClick="ClearAllFilters">
                                הצגת כל הבקשות
                            </MButton>
                        </Action>
                    </MEmptyState>
                }
                else
                {
                    @foreach (var bucket in VisibleBuckets)
                    {
                        var captured  = bucket;
                        var rows      = RowsIn(captured);
                        var isDone    = captured == RequestBucket.Done;

                        <RequestGroupSection Label="@RequestBuckets.GroupLabel(captured)"
                                             Count="@rows.Count"
                                             Emphasis="@(captured == RequestBucket.Waiting)"
                                             Collapsible="@(isDone && rows.Count > 0)"
                                             Open="@(!isDone || DoneGroupOpen)"
                                             OnToggle="ToggleDoneGroup">
                            @if (rows.Count == 0)
                            {
                                <MEmptyState Title="@EmptyLineFor(captured)" />
                            }
                            else
                            {
                                @foreach (var r in rows)
                                {
                                    var req = r;
                                    <RequestThreadRow @key="req.Id"
                                                      Request="@req"
                                                      Bucket="@captured"
                                                      TypeLabel="@TypeLabel(req.RequestType)"
                                                      Expanded="@_expanded.Contains(req.Id)"
                                                      OnToggle="@(() => ToggleThread(req.Id))"
                                                      CanReply="@CanReply(req)"
                                                      ReplyText="@GetReplyText(req.Id)"
                                                      ReplyTextChanged="@(v => SetReplyText(req.Id, v))"
                                                      Attachments="@GetReplyAttachments(req.Id)"
                                                      OnFilesSelected="@(e => OnReplyFilesSelected(req.Id, e))"
                                                      OnRemoveAttachment="@(a => RemoveReplyAttachment(req.Id, a))"
                                                      MaxAttachments="@MaxReplyAttachments"
                                                      IsSending="@IsReplying(req.Id)"
                                                      ReplyError="@GetReplyError(req.Id)"
                                                      FileError="@GetReplyFileError(req.Id)"
                                                      OnSend="@(() => SubmitReply(req.Id))" />
                                }
                            }
                        </RequestGroupSection>
                    }
                }
            </div>
        </MCard>
    </div>
}

@code {
    private List<StudentOwnRequestDto> _requests = new();
    private bool _isLoading = true;
    private bool _loadError;
    private bool _showModal;

    // ── Filter state ──────────────────────────────────────────────────────
    // Two independent axes, exactly as the Design models them: the KPI cards
    // and the "סטטוס" dropdown write to _statusFilters, the "סוג בקשה"
    // dropdown to _typeFilters. Both are multi-select.
    private const string StatusAxis = "status";
    private const string TypeAxis   = "type";

    private readonly HashSet<string> _statusFilters = new();
    private readonly HashSet<string> _typeFilters   = new();

    // ── Accordion state ───────────────────────────────────────────────────
    // Any number of threads can be open at once (the Design's `expanded` map).
    private readonly HashSet<int> _expanded = new();

    // The completed group is collapsed at rest — finished requests are history.
    // It opens on demand, and is opened FOR the student when they filter to it,
    // since a "טופלו" KPI press that reveals nothing would be a regression on
    // the pill it replaces.
    //
    // That auto-open sets the flag (see OpenDoneGroupIfFilteredTo) rather than
    // being OR-ed into a computed property: as a computed override it won the
    // comparison every render, so the group's own הצגה/הסתרה toggle became
    // inert for exactly as long as the filter was on.
    private bool _doneGroupOpen;
    private bool DoneGroupOpen => _doneGroupOpen;

    // Code → display name for the admin-managed request-type catalogue. Falls
    // back to the built-in RequestTypes.Label, which itself falls back to the
    // raw code, so a custom type never renders blank.
    private Dictionary<string, string> _typeNames = new();

    // ── Per-request reply state (unchanged) ───────────────────────────────
    private readonly Dictionary<int, string> _replyTexts  = new();
    private readonly HashSet<int>            _replyingIds = new();
    private readonly Dictionary<int, string> _replyErrors = new();
    private readonly Dictionary<int, List<PendingRequestAttachment>> _replyAttachments = new();
    private readonly Dictionary<int, string> _replyFileErrors = new();

    private const int  MaxReplyAttachments = 3;
    private const long MaxReplyAttachBytes = 5 * 1024 * 1024;

    // ── Hero ──────────────────────────────────────────────────────────────
    // The Design's heroSummary(): the h1 reports the overall communication
    // state, never a single request. Only the title is rendered — the
    // prototype computes subtitles it never puts on the page.
    private string HeroTitle
    {
        get
        {
            if (_isLoading) return "הבקשות שלי";
            if (_loadError) return "לא הצלחנו לטעון את הבקשות";
            if (_requests.Count == 0) return "עדיין לא פתחת בקשות";
            if (BucketCount(RequestBucket.Waiting)  > 0) return "יש לך תגובות חדשות שממתינות להתייחסות";
            if (BucketCount(RequestBucket.Lecturer) > 0) return "כל הבקשות שלך נמצאות בטיפול מרצה";
            return "אין כרגע עדכונים חדשים";
        }
    }

    // ── Buckets, filtering, ordering ──────────────────────────────────────

    private int BucketCount(RequestBucket bucket) =>
        _requests.Count(r => RequestBuckets.Of(r.Status) == bucket);

    /// <summary>Type filter only. The status axis selects which GROUPS render,
    /// so applying it here as well would empty every group it hides.</summary>
    private IEnumerable<StudentOwnRequestDto> TypeFiltered =>
        _typeFilters.Count == 0
            ? _requests
            : _requests.Where(r => _typeFilters.Contains(r.RequestType));

    /// <summary>Newest activity first — every server write path bumps
    /// UpdatedAt, so a thread floats up on any meaningful change.</summary>
    private List<StudentOwnRequestDto> RowsIn(RequestBucket bucket) =>
        TypeFiltered.Where(r => RequestBuckets.Of(r.Status) == bucket)
                    .OrderByDescending(r => r.UpdatedAt)
                    .ToList();

    private static readonly RequestBucket[] BucketOrder =
        { RequestBucket.Waiting, RequestBucket.Lecturer, RequestBucket.Done };

    /// <summary>Which groups render. No status filter → all three (the Design
    /// always shows the full workspace); otherwise only the selected ones.
    /// A group with no rows under the current TYPE filter drops out entirely,
    /// so a type filter can genuinely empty the page and reach the
    /// "no results" state rather than showing three empty headings.</summary>
    private IEnumerable<RequestBucket> VisibleBuckets =>
        BucketOrder
            .Where(b => _statusFilters.Count == 0 || _statusFilters.Contains(RequestBuckets.FilterId(b)))
            .Where(b => _typeFilters.Count == 0 || RowsIn(b).Count > 0);

    private static string EmptyLineFor(RequestBucket bucket) => bucket switch
    {
        RequestBucket.Waiting  => "אין בקשות שממתינות לתגובה שלך",
        RequestBucket.Lecturer => "אין בקשות בטיפול כרגע",
        _                      => "עדיין לא נסגרו בקשות",
    };

    private string TypeLabel(string code) =>
        _typeNames.TryGetValue(code, out var name) && !string.IsNullOrWhiteSpace(name)
            ? name
            : RequestTypes.Label(code);

    /// <summary>The two dropdown axes. Type options are built from the types
    /// actually present in this student's requests, so the menu never offers a
    /// filter that can only return nothing.</summary>
    private IReadOnlyList<RequestFilterBar.FilterAxis> FilterAxes
    {
        get
        {
            var statusOptions = new List<RequestFilterBar.FilterOption>
            {
                new(RequestBuckets.WaitingFilterId,  "מחכות לתגובתך", "rfb-dot-waiting"),
                new(RequestBuckets.LecturerFilterId, "בבדיקת מרצה",   "rfb-dot-lecturer"),
                new(RequestBuckets.DoneFilterId,     "טופלו",         "rfb-dot-done"),
            };

            var typeOptions = _requests
                .Select(r => r.RequestType)
                .Distinct()
                .OrderBy(TypeLabel, StringComparer.CurrentCulture)
                .Select(code => new RequestFilterBar.FilterOption(code, TypeLabel(code)))
                .ToList();

            return new[]
            {
                new RequestFilterBar.FilterAxis(StatusAxis, "סטטוס",    statusOptions, _statusFilters),
                new RequestFilterBar.FilterAxis(TypeAxis,   "סוג בקשה", typeOptions,   _typeFilters),
            };
        }
    }

    private void OnFilterToggled((string AxisKey, string Value) f)
    {
        var set = f.AxisKey == StatusAxis ? _statusFilters : _typeFilters;
        if (!set.Add(f.Value)) set.Remove(f.Value);
        OpenDoneGroupIfFilteredTo();
    }

    /// <summary>Reveals the completed group when the student has just asked to
    /// see it. One-way on purpose: it opens the group, and the group's own
    /// toggle is then free to close it again.</summary>
    private void OpenDoneGroupIfFilteredTo()
    {
        if (_statusFilters.Contains(RequestBuckets.DoneFilterId)) _doneGroupOpen = true;
    }

    /// <summary>KPI press. Design: the KPI cards are a single-choice view of
    /// the status axis — pressing one replaces whatever status filter was set
    /// and pressing the active one clears it. The type axis is untouched.</summary>
    private void ToggleStatusFilter(string id)
    {
        bool wasOnlyThis = _statusFilters.Count == 1 && _statusFilters.Contains(id);
        _statusFilters.Clear();
        if (!wasOnlyThis) _statusFilters.Add(id);
        OpenDoneGroupIfFilteredTo();
    }

    private void ClearStatusFilters() => _statusFilters.Clear();

    private void ClearAllFilters()
    {
        _statusFilters.Clear();
        _typeFilters.Clear();
    }

    private void ToggleDoneGroup() => _doneGroupOpen = !_doneGroupOpen;

    // ── Lifecycle ─────────────────────────────────────────────────────────
    protected override async Task OnInitializedAsync()
    {
        // Both are existing endpoints. The catalogue is loaded so the type
        // filter can label admin-defined types; a failure just falls back to
        // the built-in labels, never blocks the page.
        var requestsTask = RequestsService.GetMyRequestsAsync();
        var typesTask    = RequestTypesService.GetActiveAsync();

        var result = await requestsTask;
        _loadError = result is null;
        _requests  = result ?? new();

        var types = await typesTask;
        _typeNames = types is null
            ? new()
            : types.Where(t => !string.IsNullOrWhiteSpace(t.Code))
                   .GroupBy(t => t.Code)
                   .ToDictionary(g => g.Key, g => g.First().Name);

        _isLoading = false;
    }

    private async Task LoadAsync()
    {
        var result = await RequestsService.GetMyRequestsAsync();
        _loadError = result is null;
        _requests  = result ?? new();
    }

    // No thread opens on load. The page's job on arrival is the overview —
    // which groups need the student, how many, and what each is about — and
    // one auto-opened conversation was taking most of the viewport before
    // the student had chosen anything to read. Urgency and unread state are
    // carried by the row itself (the violet dot, the group's tint, the
    // status chip, the "מחכה לתגובתך" group and its ordering); none of them
    // expands a thread. Opening is the student's decision, and a future
    // notification deep-link will be the only other caller.

    private async Task ToggleThread(int id)
    {
        if (!_expanded.Add(id))
        {
            _expanded.Remove(id);
            return;
        }
        await MarkOpenedAsync(id);
    }

    /// <summary>
    /// Expanding a thread is what "reading" it means now that there is no
    /// detail pane. Same optimistic local clear + best-effort server call the
    /// previous SelectRequest did, so the dot disappears immediately and stays
    /// gone in other tabs after their next refresh.
    /// </summary>
    private async Task MarkOpenedAsync(int id)
    {
        _expanded.Add(id);

        var row = _requests.FirstOrDefault(r => r.Id == id);
        if (row is { HasUnread: true })
        {
            row.HasUnread = false;
            await RequestsService.MarkReadAsync(id);
            StateHasChanged();
        }
    }

    private void OpenModal()  => _showModal = true;
    private void CloseModal() => _showModal = false;

    private async Task OnRequestCreated()
    {
        await LoadAsync();
        // Open the newest request so the student sees what they just submitted.
        var newest = _requests.OrderByDescending(r => r.CreatedAt).FirstOrDefault();
        if (newest is not null) _expanded.Add(newest.Id);
    }

    // ── Reply state (behaviour carried over unchanged) ────────────────────

    private static bool CanReply(StudentOwnRequestDto r) =>
        r.Status is not (RequestStatuses.Resolved or RequestStatuses.Closed);

    private string GetReplyText(int id) => _replyTexts.TryGetValue(id, out var t) ? t : "";
    private void SetReplyText(int id, string v) => _replyTexts[id] = v;
    private bool IsReplying(int id) => _replyingIds.Contains(id);
    private string GetReplyError(int id) => _replyErrors.TryGetValue(id, out var e) ? e : "";
    private string GetReplyFileError(int id) => _replyFileErrors.TryGetValue(id, out var e) ? e : "";

    private List<PendingRequestAttachment> GetReplyAttachments(int id) =>
        _replyAttachments.TryGetValue(id, out var list) ? list : new();

    private void RemoveReplyAttachment(int requestId, PendingRequestAttachment att)
    {
        if (_replyAttachments.TryGetValue(requestId, out var list))
            list.Remove(att);
    }

    private async Task OnReplyFilesSelected(int requestId, InputFileChangeEventArgs e)
    {
        _replyFileErrors.Remove(requestId);
        if (!_replyAttachments.ContainsKey(requestId))
            _replyAttachments[requestId] = new();

        var list      = _replyAttachments[requestId];
        var remaining = MaxReplyAttachments - list.Count;
        if (remaining <= 0)
        {
            _replyFileErrors[requestId] = $"ניתן לצרף עד {MaxReplyAttachments} קבצים לתגובה";
            return;
        }

        foreach (var file in e.GetMultipleFiles(remaining))
        {
            if (file.Size > MaxReplyAttachBytes)
            {
                _replyFileErrors[requestId] = $"הקובץ \"{file.Name}\" גדול מדי (מקסימום 5MB)";
                continue;
            }
            try
            {
                using var stream = file.OpenReadStream(MaxReplyAttachBytes);
                using var ms     = new System.IO.MemoryStream();
                await stream.CopyToAsync(ms);
                var base64 = Convert.ToBase64String(ms.ToArray());
                list.Add(new PendingRequestAttachment(file.Name, base64, file.ContentType, file.Size));
            }
            catch
            {
                _replyFileErrors[requestId] = $"שגיאה בקריאת הקובץ \"{file.Name}\"";
            }
        }
    }

    private async Task SubmitReply(int requestId)
    {
        var text = GetReplyText(requestId).Trim();
        if (string.IsNullOrEmpty(text)) return;

        _replyingIds.Add(requestId);
        _replyErrors.Remove(requestId);

        var attachments = GetReplyAttachments(requestId)
            .Select(a => new RequestAttachmentUploadRequest
            {
                OriginalFileName = a.Name,
                FileBase64       = a.Base64,
                ContentType      = a.ContentType,
                SizeBytes        = a.Size,
            }).ToList();

        var error = await RequestsService.ReplyAsync(requestId, text, attachments);

        _replyingIds.Remove(requestId);

        if (error is not null)
        {
            _replyErrors[requestId] = error.Trim('"', ' ');
            return;
        }

        _replyTexts.Remove(requestId);
        _replyAttachments.Remove(requestId);
        _replyFileErrors.Remove(requestId);

        await LoadAsync();

        // A reply moves NeedsInfo → WaitingForStaff server-side, i.e. the row
        // changes bucket. Keeping it expanded is what makes that legible —
        // the student sees their message land in the thread that just moved.
        _expanded.Add(requestId);
    }
}
