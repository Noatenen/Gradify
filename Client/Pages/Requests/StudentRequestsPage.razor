@page "/requests"
@layout AppLayout
@using Microsoft.AspNetCore.Authorization
@using AuthWithAdmin.Shared.AuthSharedModels
@using AuthWithAdmin.Client.Services
@using Microsoft.AspNetCore.Components.Forms
@attribute [Authorize]
@inject IProjectRequestsService RequestsService
@inject IRequestTypesService    RequestTypesService

@*
    StudentRequestsPage — redesigned to match Motiva Student Requests final.

    Key changes from previous version:
    · Static "בקשות" page title (was dynamic hero summary).
    · KPI grid replaced by compact tab filter bar (הכל / דורש ממך פעולה /
      בטיפול / טופלו) with an inline type dropdown and the + button.
    · Single-expand accordion: opening one request closes the previous.
    · Prev / next nav controls inside each expanded thread.
    · Bottom link to the טופלו group when not already viewing it.

    All API calls, reply validation, attachment limits and mark-read behaviour
    are unchanged.
*@

<NewRequestModal IsOpen="@_showModal"
                 OnClose="CloseModal"
                 OnSuccess="OnRequestCreated" />

@*
    .sreq-header-bleed cancels the student shell's inline inset so the ambient
    band reaches the shell edge, exactly as /tasks does.
*@
<div class="sreq-header-bleed">
    <MPageHeader Variant="MPageHeader.HeaderVariant.Compact" Title="בקשות">
        <ChildContent>
            @if (!_isLoading && !_loadError && _requests.Count > 0)
            {
                <div class="sreq-tabbar">

                    <!-- Status tabs -->
                    <div class="sreq-tabs" role="tablist" aria-label="סינון לפי סטטוס">
                        <button type="button"
                                role="tab"
                                class="sreq-tab @(ActiveTabId is null ? "sreq-tab-active" : "")"
                                aria-selected="@(ActiveTabId is null ? "true" : "false")"
                                @onclick="ClearStatusFilter">
                            הכל
                        </button>

                        <button type="button"
                                role="tab"
                                class="sreq-tab sreq-tab-waiting @(ActiveTabId == RequestBuckets.WaitingFilterId ? "sreq-tab-active" : "")"
                                aria-selected="@(ActiveTabId == RequestBuckets.WaitingFilterId ? "true" : "false")"
                                @onclick="@(() => SetStatusTab(RequestBuckets.WaitingFilterId))">
                            דורש ממך פעולה
                            @if (BucketCount(RequestBucket.Waiting) > 0)
                            {
                                <span class="sreq-tab-badge">@BucketCount(RequestBucket.Waiting)</span>
                            }
                        </button>

                        <button type="button"
                                role="tab"
                                class="sreq-tab @(ActiveTabId == RequestBuckets.LecturerFilterId ? "sreq-tab-active" : "")"
                                aria-selected="@(ActiveTabId == RequestBuckets.LecturerFilterId ? "true" : "false")"
                                @onclick="@(() => SetStatusTab(RequestBuckets.LecturerFilterId))">
                            בטיפול
                        </button>

                        <button type="button"
                                role="tab"
                                class="sreq-tab @(ActiveTabId == RequestBuckets.DoneFilterId ? "sreq-tab-active" : "")"
                                aria-selected="@(ActiveTabId == RequestBuckets.DoneFilterId ? "true" : "false")"
                                @onclick="@(() => SetStatusTab(RequestBuckets.DoneFilterId))">
                            טופלו
                        </button>
                    </div>

                    <span class="sreq-tabbar-sep" aria-hidden="true"></span>

                    <!-- Request-type dropdown -->
                    @if (TypeOptions.Count > 0)
                    {
                        <div class="sreq-type-wrap">
                            <button type="button"
                                    class="sreq-type-btn @(_typeMenuOpen ? "sreq-type-btn-open" : "") @(_typeFilters.Count > 0 ? "sreq-type-btn-active" : "")"
                                    aria-haspopup="true"
                                    aria-expanded="@(_typeMenuOpen ? "true" : "false")"
                                    @onclick="ToggleTypeMenu">
                                <span>סוג בקשה</span>
                                @if (_typeFilters.Count > 0)
                                {
                                    <span class="sreq-type-count">@_typeFilters.Count</span>
                                }
                                <span class="sreq-type-caret @(_typeMenuOpen ? "sreq-type-caret-open" : "")" aria-hidden="true">▾</span>
                            </button>

                            @if (_typeMenuOpen)
                            {
                                <div class="sreq-type-backdrop" @onclick="CloseTypeMenu"></div>
                                <div class="sreq-type-panel" role="group" aria-label="סוג בקשה">
                                    @foreach (var opt in TypeOptions)
                                    {
                                        var captured = opt;
                                        var on = _typeFilters.Contains(captured.Code);
                                        <button type="button"
                                                class="sreq-type-opt"
                                                role="checkbox"
                                                aria-checked="@(on ? "true" : "false")"
                                                @onclick="@(() => ToggleType(captured.Code))">
                                            <span class="sreq-type-box @(on ? "sreq-type-box-on" : "")" aria-hidden="true">
                                                @if (on) { <span class="sreq-type-check">✓</span> }
                                            </span>
                                            <span class="sreq-type-opt-label @(on ? "sreq-type-opt-label-on" : "")">@captured.Label</span>
                                        </button>
                                    }
                                </div>
                            }
                        </div>
                    }

                    <!-- Active type chips -->
                    @foreach (var code in _typeFilters)
                    {
                        var captured = code;
                        <span class="sreq-type-chip">
                            <span>@TypeLabel(captured)</span>
                            <button type="button"
                                    class="sreq-type-chip-x"
                                    aria-label="@($"הסרת הסינון {TypeLabel(captured)}")"
                                    @onclick="@(() => ToggleType(captured))">×</button>
                        </span>
                    }

                    <MButton Variant="MButton.ButtonVariant.Primary"
                             OnClick="OpenModal">
                        <span class="sreq-new-plus" aria-hidden="true">+</span>
                        <span class="sreq-new-label">בקשה חדשה</span>
                    </MButton>
                </div>
            }
        </ChildContent>
    </MPageHeader>
</div>

@if (_isLoading)
{
    <div class="sreq-loading" role="status">
        <span class="sreq-spinner" aria-hidden="true"></span>
        <span>טוענת בקשות…</span>
    </div>
}
else if (_loadError)
{
    <div class="sreq-page">
        <MEmptyState Title="אירעה שגיאה בטעינת הבקשות"
                     Description="נסי לרענן את הדף." />
    </div>
}
else
{
    <div class="sreq-page">
        <div class="sreq-groups">

            @if (_requests.Count == 0)
            {
                <MEmptyState Title="עדיין לא פתחת בקשות"
                             Description="כשתפתחי בקשה לצוות האקדמי היא תופיע כאן, יחד עם כל השיחה סביבה.">
                    <Action>
                        <MButton Variant="MButton.ButtonVariant.Primary"
                                 OnClick="OpenModal">
                            פתיחת בקשה ראשונה
                        </MButton>
                    </Action>
                </MEmptyState>
            }
            else if (!VisibleBuckets.Any())
            {
                <MEmptyState Title="אין בקשות שתואמות לסינון הנוכחי"
                             Description="אפשר לשנות את הסינון או להציג את כל הבקשות."
                             Live="true">
                    <Action>
                        <MButton Variant="MButton.ButtonVariant.Secondary" OnClick="ClearAllFilters">
                            הצגת כל הבקשות
                        </MButton>
                    </Action>
                </MEmptyState>
            }
            else
            {
                @foreach (var bucket in VisibleBuckets)
                {
                    var captured  = bucket;
                    var rows      = RowsIn(captured);
                    var isDone    = captured == RequestBucket.Done;

                    <RequestGroupSection Label="@RequestBuckets.GroupLabel(captured)"
                                         Count="@rows.Count"
                                         Emphasis="@(captured == RequestBucket.Waiting)"
                                         Collapsible="@(isDone && rows.Count > 0)"
                                         Open="@(!isDone || DoneGroupOpen)"
                                         OnToggle="ToggleDoneGroup"
                                         BucketClass="@RequestBuckets.CssSuffix(captured)">
                        @if (rows.Count == 0)
                        {
                            <MEmptyState Title="@EmptyLineFor(captured)" />
                        }
                        else
                        {
                            @foreach (var r in rows)
                            {
                                var req = r;
                                var bucketRows = rows; @* captured for nav *@
                                var reqIdx = bucketRows.IndexOf(req);

                                <RequestThreadRow @key="req.Id"
                                                  Request="@req"
                                                  Bucket="@captured"
                                                  TypeLabel="@TypeLabel(req.RequestType)"
                                                  Expanded="@(_expandedId == req.Id)"
                                                  OnToggle="@(() => ToggleThread(req.Id))"
                                                  HasPrev="@(reqIdx > 0)"
                                                  HasNext="@(reqIdx < bucketRows.Count - 1)"
                                                  OnPrev="@(() => NavigateInBucket(bucketRows, reqIdx - 1))"
                                                  OnNext="@(() => NavigateInBucket(bucketRows, reqIdx + 1))"
                                                  CanReply="@CanReply(req)"
                                                  ReplyText="@GetReplyText(req.Id)"
                                                  ReplyTextChanged="@(v => SetReplyText(req.Id, v))"
                                                  Attachments="@GetReplyAttachments(req.Id)"
                                                  OnFilesSelected="@(e => OnReplyFilesSelected(req.Id, e))"
                                                  OnRemoveAttachment="@(a => RemoveReplyAttachment(req.Id, a))"
                                                  MaxAttachments="@MaxReplyAttachments"
                                                  IsSending="@IsReplying(req.Id)"
                                                  ReplyError="@GetReplyError(req.Id)"
                                                  FileError="@GetReplyFileError(req.Id)"
                                                  OnSend="@(() => SubmitReply(req.Id))" />
                            }
                        }
                    </RequestGroupSection>
                }

                @*
                    Bottom shortcut to the completed archive. Only rendered
                    when the student is NOT already viewing the done group,
                    and only when there are completed requests to show.
                    Clicking sets the tab to טופלו and opens the group.
                *@
                @if (BucketCount(RequestBucket.Done) > 0
                     && ActiveTabId != RequestBuckets.DoneFilterId)
                {
                    <div class="sreq-done-link">
                        <button type="button"
                                class="sreq-done-link-btn"
                                @onclick="GoToDoneView">
                            הצגת @BucketCount(RequestBucket.Done) בקשות שטופלו ←
                        </button>
                    </div>
                }
            }
        </div>
    </div>
}

@code {
    private List<StudentOwnRequestDto> _requests = new();
    private bool _isLoading = true;
    private bool _loadError;
    private bool _showModal;

    // ── Filter state ──────────────────────────────────────────────────────
    private readonly HashSet<string> _statusFilters = new();
    private readonly HashSet<string> _typeFilters   = new();

    // Which tab is active (null = הכל)
    private string? ActiveTabId =>
        _statusFilters.Count == 1 ? _statusFilters.First() : null;

    // Type dropdown open state
    private bool _typeMenuOpen;

    // ── Accordion — single-expand ─────────────────────────────────────────
    // Only one request can be expanded at a time. Opening a new one
    // automatically collapses the previous.
    private int? _expandedId;

    // The completed group is collapsed at rest and opens when the student
    // navigates to it (via tab or the bottom link).
    private bool _doneGroupOpen;
    private bool DoneGroupOpen => _doneGroupOpen;

    // Code → display name for the admin-managed request-type catalogue.
    private Dictionary<string, string> _typeNames = new();

    // ── Per-request reply state ───────────────────────────────────────────
    private readonly Dictionary<int, string> _replyTexts  = new();
    private readonly HashSet<int>            _replyingIds = new();
    private readonly Dictionary<int, string> _replyErrors = new();
    private readonly Dictionary<int, List<PendingRequestAttachment>> _replyAttachments = new();
    private readonly Dictionary<int, string> _replyFileErrors = new();

    private const int  MaxReplyAttachments = 3;
    private const long MaxReplyAttachBytes = 5 * 1024 * 1024;

    // ── Buckets, filtering, ordering ──────────────────────────────────────

    private int BucketCount(RequestBucket bucket) =>
        _requests.Count(r => RequestBuckets.Of(r.Status) == bucket);

    private IEnumerable<StudentOwnRequestDto> TypeFiltered =>
        _typeFilters.Count == 0
            ? _requests
            : _requests.Where(r => _typeFilters.Contains(r.RequestType));

    private List<StudentOwnRequestDto> RowsIn(RequestBucket bucket) =>
        TypeFiltered.Where(r => RequestBuckets.Of(r.Status) == bucket)
                    .OrderByDescending(r => r.UpdatedAt)
                    .ToList();

    private static readonly RequestBucket[] BucketOrder =
        { RequestBucket.Waiting, RequestBucket.Lecturer, RequestBucket.Done };

    private IEnumerable<RequestBucket> VisibleBuckets =>
        BucketOrder
            .Where(b => _statusFilters.Count == 0 || _statusFilters.Contains(RequestBuckets.FilterId(b)))
            .Where(b => _typeFilters.Count == 0 || RowsIn(b).Count > 0);

    private static string EmptyLineFor(RequestBucket bucket) => bucket switch
    {
        RequestBucket.Waiting  => "אין בקשות שממתינות לתגובה שלך",
        RequestBucket.Lecturer => "אין בקשות בטיפול כרגע",
        _                      => "עדיין לא נסגרו בקשות",
    };

    private string TypeLabel(string code) =>
        _typeNames.TryGetValue(code, out var name) && !string.IsNullOrWhiteSpace(name)
            ? name
            : RequestTypes.Label(code);

    // ── Type dropdown ─────────────────────────────────────────────────────

    private sealed record TypeOption(string Code, string Label);

    private IReadOnlyList<TypeOption> TypeOptions =>
        _requests
            .Select(r => r.RequestType)
            .Distinct()
            .OrderBy(TypeLabel, StringComparer.CurrentCulture)
            .Select(code => new TypeOption(code, TypeLabel(code)))
            .ToList();

    private void ToggleTypeMenu() => _typeMenuOpen = !_typeMenuOpen;
    private void CloseTypeMenu()  => _typeMenuOpen = false;

    private void ToggleType(string code)
    {
        if (!_typeFilters.Add(code)) _typeFilters.Remove(code);
    }

    // ── Tab / status filter ───────────────────────────────────────────────

    private void SetStatusTab(string id)
    {
        _statusFilters.Clear();
        _statusFilters.Add(id);
        OpenDoneGroupIfFilteredTo();
        _typeMenuOpen = false;
    }

    private void ClearStatusFilter()
    {
        _statusFilters.Clear();
        _typeMenuOpen = false;
    }

    private void OpenDoneGroupIfFilteredTo()
    {
        if (_statusFilters.Contains(RequestBuckets.DoneFilterId)) _doneGroupOpen = true;
    }

    private void ClearAllFilters()
    {
        _statusFilters.Clear();
        _typeFilters.Clear();
    }

    private void ToggleDoneGroup() => _doneGroupOpen = !_doneGroupOpen;

    private void GoToDoneView()
    {
        _statusFilters.Clear();
        _statusFilters.Add(RequestBuckets.DoneFilterId);
        _doneGroupOpen = true;
    }

    // ── Lifecycle ─────────────────────────────────────────────────────────
    protected override async Task OnInitializedAsync()
    {
        var requestsTask = RequestsService.GetMyRequestsAsync();
        var typesTask    = RequestTypesService.GetActiveAsync();

        var result = await requestsTask;
        _loadError = result is null;
        _requests  = result ?? new();

        var types = await typesTask;
        _typeNames = types is null
            ? new()
            : types.Where(t => !string.IsNullOrWhiteSpace(t.Code))
                   .GroupBy(t => t.Code)
                   .ToDictionary(g => g.Key, g => g.First().Name);

        _isLoading = false;
    }

    private async Task LoadAsync()
    {
        var result = await RequestsService.GetMyRequestsAsync();
        _loadError = result is null;
        _requests  = result ?? new();
    }

    // ── Accordion — single-expand ─────────────────────────────────────────

    private async Task ToggleThread(int id)
    {
        if (_expandedId == id)
        {
            _expandedId = null;
            return;
        }
        _expandedId = id;
        await MarkOpenedAsync(id);
    }

    private async Task MarkOpenedAsync(int id)
    {
        _expandedId = id;
        var row = _requests.FirstOrDefault(r => r.Id == id);
        if (row is { HasUnread: true })
        {
            row.HasUnread = false;
            await RequestsService.MarkReadAsync(id);
            StateHasChanged();
        }
    }

    // ── Prev / Next navigation within a bucket ────────────────────────────

    private async Task NavigateInBucket(List<StudentOwnRequestDto> bucketRows, int targetIdx)
    {
        if (targetIdx < 0 || targetIdx >= bucketRows.Count) return;
        var target = bucketRows[targetIdx];
        await MarkOpenedAsync(target.Id);
    }

    // ── Modal ─────────────────────────────────────────────────────────────

    private void OpenModal()  => _showModal = true;
    private void CloseModal() => _showModal = false;

    private async Task OnRequestCreated()
    {
        await LoadAsync();
        var newest = _requests.OrderByDescending(r => r.CreatedAt).FirstOrDefault();
        if (newest is not null) _expandedId = newest.Id;
    }

    // ── Reply state ───────────────────────────────────────────────────────

    private static bool CanReply(StudentOwnRequestDto r) =>
        r.Status is not (RequestStatuses.Resolved or RequestStatuses.Closed);

    private string GetReplyText(int id) => _replyTexts.TryGetValue(id, out var t) ? t : "";
    private void SetReplyText(int id, string v) => _replyTexts[id] = v;
    private bool IsReplying(int id) => _replyingIds.Contains(id);
    private string GetReplyError(int id) => _replyErrors.TryGetValue(id, out var e) ? e : "";
    private string GetReplyFileError(int id) => _replyFileErrors.TryGetValue(id, out var e) ? e : "";

    private List<PendingRequestAttachment> GetReplyAttachments(int id) =>
        _replyAttachments.TryGetValue(id, out var list) ? list : new();

    private void RemoveReplyAttachment(int requestId, PendingRequestAttachment att)
    {
        if (_replyAttachments.TryGetValue(requestId, out var list))
            list.Remove(att);
    }

    private async Task OnReplyFilesSelected(int requestId, InputFileChangeEventArgs e)
    {
        _replyFileErrors.Remove(requestId);
        if (!_replyAttachments.ContainsKey(requestId))
            _replyAttachments[requestId] = new();

        var list      = _replyAttachments[requestId];
        var remaining = MaxReplyAttachments - list.Count;
        if (remaining <= 0)
        {
            _replyFileErrors[requestId] = $"ניתן לצרף עד {MaxReplyAttachments} קבצים לתגובה";
            return;
        }

        foreach (var file in e.GetMultipleFiles(remaining))
        {
            if (file.Size > MaxReplyAttachBytes)
            {
                _replyFileErrors[requestId] = $"הקובץ \"{file.Name}\" גדול מדי (מקסימום 5MB)";
                continue;
            }
            try
            {
                using var stream = file.OpenReadStream(MaxReplyAttachBytes);
                using var ms     = new System.IO.MemoryStream();
                await stream.CopyToAsync(ms);
                var base64 = Convert.ToBase64String(ms.ToArray());
                list.Add(new PendingRequestAttachment(file.Name, base64, file.ContentType, file.Size));
            }
            catch
            {
                _replyFileErrors[requestId] = $"שגיאה בקריאת הקובץ \"{file.Name}\"";
            }
        }
    }

    private async Task SubmitReply(int requestId)
    {
        var text = GetReplyText(requestId).Trim();
        if (string.IsNullOrEmpty(text)) return;

        _replyingIds.Add(requestId);
        _replyErrors.Remove(requestId);

        var attachments = GetReplyAttachments(requestId)
            .Select(a => new RequestAttachmentUploadRequest
            {
                OriginalFileName = a.Name,
                FileBase64       = a.Base64,
                ContentType      = a.ContentType,
                SizeBytes        = a.Size,
            }).ToList();

        var error = await RequestsService.ReplyAsync(requestId, text, attachments);

        _replyingIds.Remove(requestId);

        if (error is not null)
        {
            _replyErrors[requestId] = error.Trim('"', ' ');
            return;
        }

        _replyTexts.Remove(requestId);
        _replyAttachments.Remove(requestId);
        _replyFileErrors.Remove(requestId);

        await LoadAsync();

        // A reply moves NeedsInfo → WaitingForStaff server-side. Keep the
        // thread open so the student sees their message land.
        _expandedId = requestId;
    }
}
