@using AuthWithAdmin.Client.Services
@using AuthWithAdmin.Shared.AuthSharedModels
@using Microsoft.AspNetCore.Components.Forms
@inject IProjectRequestsService RequestsService
@inject IProjectContextService  ProjectContext
@inject IRequestTypesService    RequestTypesService

@if (IsOpen)
{
    <div class="nrm-overlay" @onclick="TryClose">
        <div class="nrm-box" @onclick:stopPropagation="true">

            @if (_phase == Phase.Success)
            {
                <!-- ── Success state ── -->
                <div class="nrm-success">
                    <div class="nrm-success-icon">
                        <span class="oi oi-circle-check" aria-hidden="true"></span>
                    </div>
                    <h2 class="nrm-success-title">הבקשה נשלחה בהצלחה!</h2>
                    <p class="nrm-success-body">
                        הבקשה שלך התקבלה ותטופל על ידי הצוות האקדמי.
                        תוכל לעקוב אחרי הסטטוס בדף הבקשות שלך.
                    </p>
                    <div class="nrm-success-actions">
                        <button class="nrm-primary-btn" @onclick="SuccessClose">סגירה</button>
                        <button class="nrm-ghost-btn" @onclick="ResetForm">הגשת בקשה נוספת</button>
                    </div>
                </div>
            }
            else
            {
                <!-- ── Header ── -->
                <div class="nrm-header">
                    <div class="nrm-header-start">
                        <div class="nrm-icon">
                            <span class="oi oi-envelope-closed" aria-hidden="true"></span>
                        </div>
                        <div>
                            <h2 class="nrm-title">פתיחת בקשה חדשה</h2>
                            <p class="nrm-subtitle">הגש בקשה לצוות האקדמי</p>
                        </div>
                    </div>
                    <button class="nrm-close-btn" @onclick="TryClose" title="סגירה"
                            disabled="@(_phase == Phase.Submitting)">
                        <span class="oi oi-x" aria-hidden="true"></span>
                    </button>
                </div>

                <!-- ── Form ── -->
                <div class="nrm-form">

                    <!-- Request type -->
                    <div class="nrm-field">
                        <label class="nrm-label">
                            סוג הבקשה <span class="nrm-required">*</span>
                        </label>
                        <select class="nrm-select @(_touched && string.IsNullOrEmpty(_requestType) ? "nrm-input-error" : "")"
                                @bind="_requestType"
                                disabled="@(_phase == Phase.Submitting)">
                            <option value="">— בחר סוג בקשה —</option>
                            @foreach (var t in _availableTypes)
                            {
                                <option value="@t.Code">@t.Name</option>
                            }
                        </select>
                        @if (_touched && string.IsNullOrEmpty(_requestType))
                        {
                            <div class="nrm-field-error">יש לבחור סוג בקשה</div>
                        }
                    </div>

                    <!-- Title -->
                    <div class="nrm-field">
                        <label class="nrm-label">
                            כותרת <span class="nrm-required">*</span>
                        </label>
                        <input type="text"
                               class="nrm-input @(_touched && string.IsNullOrWhiteSpace(_title) ? "nrm-input-error" : "")"
                               placeholder="תאר בקצרה את הבקשה…"
                               maxlength="200"
                               @bind="_title"
                               @bind:event="oninput"
                               disabled="@(_phase == Phase.Submitting)" />
                        @if (_touched && string.IsNullOrWhiteSpace(_title))
                        {
                            <div class="nrm-field-error">כותרת הבקשה היא שדה חובה</div>
                        }
                    </div>

                    <!-- Description -->
                    <div class="nrm-field">
                        <label class="nrm-label">
                            פירוט <span class="nrm-required">*</span>
                        </label>
                        <textarea class="nrm-textarea @(_touched && string.IsNullOrWhiteSpace(_description) ? "nrm-input-error" : "")"
                                  rows="4"
                                  placeholder="פרט את הבקשה, הסיבה, ומה הסיוע הנדרש…"
                                  maxlength="2000"
                                  @bind="_description"
                                  @bind:event="oninput"
                                  disabled="@(_phase == Phase.Submitting)"></textarea>
                        @if (_touched && string.IsNullOrWhiteSpace(_description))
                        {
                            <div class="nrm-field-error">פירוט הבקשה הוא שדה חובה</div>
                        }
                    </div>

                    <!-- Postponement (Extension) details — visible only for Extension requests -->
                    @if (_requestType == RequestTypes.Extension)
                    {
                        <div class="nrm-section">
                            <div class="nrm-section-title">פרטי הדחייה</div>

                            <div class="nrm-field">
                                <label class="nrm-label">
                                    בחר משימה / אבן דרך <span class="nrm-required">*</span>
                                </label>
                                @if (_targetsLoading)
                                {
                                    <div class="nrm-hint">
                                        <span class="nrm-spinner-sm"></span> טוען רשימה…
                                    </div>
                                }
                                else
                                {
                                    <select class="nrm-select @(_touched && string.IsNullOrEmpty(_extTargetKey) ? "nrm-input-error" : "")"
                                            @bind="_extTargetKey"
                                            disabled="@(_phase == Phase.Submitting)">
                                        <option value="">— בחר משימה / אבן דרך —</option>
                                        @if (_extTargets.Any(t => t.Kind == "Task"))
                                        {
                                            <optgroup label="משימות הגשה">
                                                @foreach (var t in _extTargets.Where(x => x.Kind == "Task"))
                                                {
                                                    <option value="@($"Task:{t.Id}")">@OptionLabel(t)</option>
                                                }
                                            </optgroup>
                                        }
                                        @if (_extTargets.Any(t => t.Kind == "Milestone"))
                                        {
                                            <optgroup label="אבני דרך">
                                                @foreach (var t in _extTargets.Where(x => x.Kind == "Milestone"))
                                                {
                                                    <option value="@($"Milestone:{t.Id}")">@OptionLabel(t)</option>
                                                }
                                            </optgroup>
                                        }
                                    </select>
                                    @if (_touched && string.IsNullOrEmpty(_extTargetKey))
                                    {
                                        <div class="nrm-field-error">יש לבחור משימה או אבן דרך</div>
                                    }
                                }
                            </div>

                            @{
                                var selected   = SelectedTarget;
                                int? overdueDays = OverdueDays(selected);
                                bool hasDueDate  = selected?.CurrentDueDate is not null;
                            }

                            @if (selected is not null)
                            {
                                @* Details panel — surfaces the full context of
                                   the selected target so the student knows
                                   what they're asking to defer. Conditional
                                   sub-blocks below cover the three states
                                   (overdue / has-date / no-date). *@
                                <div class="nrm-ext-details">
                                    <div class="nrm-ext-row">
                                        <span class="nrm-ext-label">פריט נבחר</span>
                                        <span class="nrm-ext-value nrm-ext-value-strong">
                                            <span class="nrm-ext-kind">
                                                @(selected.Kind == "Task" ? "משימה" : "אבן דרך")
                                            </span>
                                            @selected.Title
                                        </span>
                                    </div>

                                    @if (selected.Kind == "Task" && !string.IsNullOrWhiteSpace(selected.MilestoneTitle))
                                    {
                                        <div class="nrm-ext-row">
                                            <span class="nrm-ext-label">אבן דרך משויכת</span>
                                            <span class="nrm-ext-value">@selected.MilestoneTitle</span>
                                        </div>
                                    }

                                    @if (!string.IsNullOrWhiteSpace(_projectTitle))
                                    {
                                        <div class="nrm-ext-row">
                                            <span class="nrm-ext-label">פרויקט / צוות</span>
                                            <span class="nrm-ext-value">
                                                @_projectTitle
                                                @if (!string.IsNullOrWhiteSpace(_teamName))
                                                {
                                                    <span class="nrm-ext-muted"> — @_teamName</span>
                                                }
                                            </span>
                                        </div>
                                    }

                                    @if (!string.IsNullOrWhiteSpace(selected.Status))
                                    {
                                        <div class="nrm-ext-row">
                                            <span class="nrm-ext-label">סטטוס נוכחי</span>
                                            <span class="nrm-ext-value">@StatusLabel(selected.Status)</span>
                                        </div>
                                    }

                                    @if (hasDueDate)
                                    {
                                        <div class="nrm-ext-row">
                                            <span class="nrm-ext-label">תאריך יעד נוכחי</span>
                                            <span class="nrm-ext-value nrm-ext-value-strong">
                                                @selected.CurrentDueDate!.Value.ToString("dd.MM.yyyy")
                                            </span>
                                        </div>

                                        @if (overdueDays is > 0)
                                        {
                                            <div class="nrm-ext-banner nrm-ext-banner-overdue">
                                                <span class="oi oi-warning" aria-hidden="true"></span>
                                                <div>
                                                    <div class="nrm-ext-banner-title">
                                                        הפריט כבר באיחור של @overdueDays.Value ימים
                                                    </div>
                                                    <div class="nrm-ext-banner-body">
                                                        בקשת הדחייה תועבר לבדיקה ביחס לתאריך היעד הנוכחי.
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="nrm-ext-banner nrm-ext-banner-ok">
                                                <span class="oi oi-info" aria-hidden="true"></span>
                                                <span>
                                                    תאריך היעד הנוכחי: @selected.CurrentDueDate.Value.ToString("dd.MM.yyyy")
                                                </span>
                                            </div>
                                        }
                                    }
                                    else
                                    {
                                        <div class="nrm-ext-banner nrm-ext-banner-warn">
                                            <span class="oi oi-warning" aria-hidden="true"></span>
                                            <span>לא מוגדר תאריך יעד לפריט זה</span>
                                        </div>
                                    }
                                </div>
                            }

                            <div class="nrm-field">
                                <label class="nrm-label">
                                    תאריך מבוקש חדש <span class="nrm-required">*</span>
                                </label>
                                <input class="nrm-input @(_touched && _extRequestedDate is null ? "nrm-input-error" : "")"
                                       type="date"
                                       @bind="_extRequestedDate"
                                       disabled="@(_phase == Phase.Submitting)" />
                                @if (_touched && _extRequestedDate is null)
                                {
                                    <div class="nrm-field-error">יש לבחור תאריך מבוקש חדש</div>
                                }
                                else if (_touched && selected?.CurrentDueDate is not null
                                                  && _extRequestedDate is not null
                                                  && _extRequestedDate.Value.Date <= selected.CurrentDueDate.Value.Date)
                                {
                                    <div class="nrm-field-error">התאריך המבוקש חייב להיות אחרי תאריך ההגשה הנוכחי</div>
                                }
                            </div>
                        </div>
                    }

                    <!-- File attachments -->
                    <div class="nrm-field">
                        <label class="nrm-label">צירוף קבצים (אופציונלי)</label>

                        @{
                            bool canAddMore = _attachments.Count < MaxAttachments && _phase != Phase.Submitting;
                        }

                        <div class="nrm-uploader @(canAddMore ? "" : "nrm-uploader--full")">
                            @* The wrapping <label> turns the entire block into
                               a click target for the hidden <input type="file">.
                               Disabled when at-limit / submitting. *@
                            <label class="nrm-uploader-row @(canAddMore ? "" : "nrm-uploader-row--disabled")">
                                <span class="nrm-uploader-icon" aria-hidden="true">
                                    <span class="oi oi-cloud-upload"></span>
                                </span>
                                <span class="nrm-uploader-text">
                                    <span class="nrm-uploader-title">
                                        @(canAddMore ? "בחירת קבצים" : "הגעת/ ה למספר המקסימלי")
                                    </span>
                                    @if (_attachments.Count == 0)
                                    {
                                        <span class="nrm-uploader-empty">לא נבחרו קבצים</span>
                                    }
                                    else
                                    {
                                        <span class="nrm-uploader-count">
                                            נבחרו @_attachments.Count מתוך @MaxAttachments
                                        </span>
                                    }
                                </span>
                                <span class="nrm-uploader-action">
                                    <span class="oi oi-plus" aria-hidden="true"></span>
                                    <span>הוסף</span>
                                </span>
                                @if (canAddMore)
                                {
                                    <InputFile OnChange="OnFilesSelected"
                                               accept="image/jpeg,image/png,image/webp,.jpg,.jpeg,.png,.webp,application/pdf,.pdf,application/msword,.doc,application/vnd.openxmlformats-officedocument.wordprocessingml.document,.docx"
                                               multiple
                                               class="nrm-file-hidden" />
                                }
                            </label>
                            <p class="nrm-uploader-hint">
                                jpg, png, webp, pdf, doc, docx · עד @MaxAttachments קבצים · עד 5MB לכל קובץ
                            </p>
                        </div>

                        @if (!string.IsNullOrEmpty(_fileError))
                        {
                            <div class="nrm-field-error">@_fileError</div>
                        }

                        @if (_attachments.Count > 0)
                        {
                            <ul class="nrm-file-list">
                                @foreach (var att in _attachments)
                                {
                                    <li class="nrm-file-item">
                                        @if (!string.IsNullOrWhiteSpace(att.Base64) && IsImageContentType(att.ContentType))
                                        {
                                            <img class="nrm-file-thumb"
                                                 src="data:@att.ContentType;base64,@att.Base64"
                                                 alt="@att.Name" />
                                        }
                                        else
                                        {
                                            <span class="nrm-file-thumb-fallback" aria-hidden="true">
                                                <span class="oi oi-image"></span>
                                            </span>
                                        }
                                        <span class="nrm-file-name">@att.Name</span>
                                        <span class="nrm-file-size">@FormatBytes(att.Size)</span>
                                        <button type="button"
                                                class="nrm-file-remove"
                                                title="הסר תמונה"
                                                disabled="@(_phase == Phase.Submitting)"
                                                @onclick="@(() => RemoveAttachment(att))">
                                            <span class="oi oi-x" aria-hidden="true"></span>
                                        </button>
                                    </li>
                                }
                            </ul>
                        }
                    </div>

                    <!-- Error banner -->
                    @if (!string.IsNullOrWhiteSpace(_submitError))
                    {
                        <div class="nrm-error-banner">
                            <span class="oi oi-warning" aria-hidden="true"></span>
                            @_submitError
                        </div>
                    }

                </div>

                <!-- ── Footer ── -->
                <div class="nrm-footer">
                    <button class="nrm-ghost-btn"
                            @onclick="TryClose"
                            disabled="@(_phase == Phase.Submitting)">
                        ביטול
                    </button>
                    <button class="nrm-primary-btn"
                            @onclick="Submit"
                            disabled="@(_phase == Phase.Submitting)">
                        @if (_phase == Phase.Submitting)
                        {
                            <span class="nrm-spinner-sm"></span>
                            <span>שולח…</span>
                        }
                        else
                        {
                            <span class="oi oi-envelope-closed" aria-hidden="true"></span>
                            <span>שליחת בקשה</span>
                        }
                    </button>
                </div>
            }

        </div>
    </div>
}

@code {
    [Parameter] public bool          IsOpen    { get; set; }
    [Parameter] public EventCallback OnClose   { get; set; }
    [Parameter] public EventCallback OnSuccess { get; set; }

    private enum Phase { Form, Submitting, Success }
    private Phase  _phase = Phase.Form;

    // Form fields
    private string _requestType = "";
    private string _title       = "";
    private string _description = "";

    // Attachments
    private record PendingAttachment(string Name, string Base64, string ContentType, long Size);
    private List<PendingAttachment> _attachments = new();
    private string _fileError = "";
    private const int  MaxAttachments   = 5;
    private const long MaxAttachmentBytes = 5 * 1_048_576L; // 5 MB

    // Validation / error
    private bool   _touched     = false;
    private string _submitError = "";

    // Resolved on first open
    private int    _projectId;
    /// <summary>Surfaced in the extension-request details panel so the
    /// student can confirm which project the deferral targets.</summary>
    private string _projectTitle = "";
    private string _teamName     = "";

    // Active request types loaded from /api/request-types/active. Falls back
    // to the legacy hard-coded constants if the catalogue is empty or the
    // fetch fails, so the picker never goes silent on the student.
    private List<RequestTypeDefinitionDto> _availableTypes = new();
    private bool _typesLoaded;

    // Extension-only state — populated when the student opens the modal and
    // selects type=Extension. The picker source is fetched once per modal open
    // so the student doesn't pay the cost when they choose a different type.
    private List<ExtensionTargetDto> _extTargets       = new();
    private bool                     _extTargetsLoaded;
    private bool                     _targetsLoading;
    /// <summary>"Task:{id}" or "Milestone:{id}" — keys the dropdown.</summary>
    private string                   _extTargetKey = "";
    private DateTime?                _extRequestedDate;

    /// <summary>The chosen target row (or null when nothing selected).</summary>
    private ExtensionTargetDto? SelectedTarget
    {
        get
        {
            if (string.IsNullOrEmpty(_extTargetKey)) return null;
            var parts = _extTargetKey.Split(':', 2);
            if (parts.Length != 2) return null;
            if (!int.TryParse(parts[1], out var id)) return null;
            return _extTargets.FirstOrDefault(t => t.Kind == parts[0] && t.Id == id);
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (IsOpen && _projectId == 0)
        {
            var ctx = await ProjectContext.GetAsync();
            _projectId    = ctx?.ProjectId ?? 0;
            _projectTitle = ctx?.ProjectTitle ?? "";
            _teamName     = ctx?.TeamName ?? "";
        }

        // Load the active request types catalogue once per modal lifetime.
        // Disabled types are filtered server-side so the student never sees
        // them. If the fetch fails or returns empty (e.g. fresh deploy before
        // the migrator runs on a hosted env), fall back to the legacy static
        // constants so the picker never goes silent.
        if (IsOpen && !_typesLoaded)
        {
            var list = await RequestTypesService.GetActiveAsync();
            if (list is { Count: > 0 })
            {
                _availableTypes = list;
            }
            else
            {
                _availableTypes = RequestTypes.All
                    .Select(code => new RequestTypeDefinitionDto
                    {
                        Code = code,
                        Name = RequestTypes.Label(code),
                        IsActive = true,
                    })
                    .ToList();
            }
            _typesLoaded = true;
        }

        // Load extension picker targets the first time the modal opens.
        // Targets are project-scoped, so they're cached per modal lifetime.
        if (IsOpen && !_extTargetsLoaded && !_targetsLoading)
        {
            _targetsLoading = true;
            var list = await RequestsService.GetExtensionTargetsAsync();
            _extTargets       = list ?? new();
            _extTargetsLoaded = true;
            _targetsLoading   = false;
        }
    }

    private async Task OnFilesSelected(InputFileChangeEventArgs e)
    {
        _fileError = "";

        int remaining = MaxAttachments - _attachments.Count;
        if (remaining <= 0) return;

        foreach (var file in e.GetMultipleFiles(remaining))
        {
            // Validate type by extension
            string ext = Path.GetExtension(file.Name).TrimStart('.').ToLowerInvariant();
            if (ext is not ("jpg" or "jpeg" or "png" or "webp" or "pdf" or "doc" or "docx"))
            {
                _fileError = $"הקובץ \"{file.Name}\" אינו סוג נתמך (jpg, png, webp, pdf, doc, docx)";
                continue;
            }

            if (file.Size > MaxAttachmentBytes)
            {
                _fileError = $"הקובץ \"{file.Name}\" חורג מהגודל המקסימלי (5 MB)";
                continue;
            }

            try
            {
                using var stream = file.OpenReadStream(maxAllowedSize: MaxAttachmentBytes);
                using var ms     = new MemoryStream();
                await stream.CopyToAsync(ms);
                string base64 = Convert.ToBase64String(ms.ToArray());

                _attachments.Add(new PendingAttachment(
                    Name:        file.Name,
                    Base64:      base64,
                    ContentType: file.ContentType,
                    Size:        file.Size));
            }
            catch
            {
                _fileError = $"שגיאה בקריאת הקובץ \"{file.Name}\"";
            }
        }
    }

    private void RemoveAttachment(PendingAttachment att)
    {
        _attachments.Remove(att);
        _fileError = "";
    }

    private async Task Submit()
    {
        _touched = true;
        _submitError = "";

        if (string.IsNullOrEmpty(_requestType)      ||
            string.IsNullOrWhiteSpace(_title)        ||
            string.IsNullOrWhiteSpace(_description))
            return;

        if (_projectId <= 0)
        {
            _submitError = "לא נמצא פרויקט מקושר לחשבון שלך";
            return;
        }

        // Extension-specific validation — runs only when type=Extension.
        int?      extTaskId      = null;
        int?      extMilestoneId = null;
        if (_requestType == RequestTypes.Extension)
        {
            var sel = SelectedTarget;
            if (sel is null)
            {
                _submitError = "יש לבחור משימה או אבן דרך";
                return;
            }
            if (_extRequestedDate is null)
            {
                _submitError = "יש לבחור תאריך מבוקש חדש";
                return;
            }
            if (sel.CurrentDueDate is not null
                && _extRequestedDate.Value.Date <= sel.CurrentDueDate.Value.Date)
            {
                _submitError = "התאריך המבוקש חייב להיות אחרי תאריך ההגשה הנוכחי";
                return;
            }
            if (sel.Kind == "Task")           extTaskId      = sel.Id;
            else if (sel.Kind == "Milestone") extMilestoneId = sel.Id;
        }

        _phase = Phase.Submitting;

        var req = new CreateProjectRequestRequest
        {
            ProjectId   = _projectId,
            RequestType = _requestType,
            Title       = _title.Trim(),
            Description = _description.Trim(),
            Attachments = _attachments.Select(a => new RequestAttachmentUploadRequest
            {
                OriginalFileName = a.Name,
                FileBase64       = a.Base64,
                ContentType      = a.ContentType,
                SizeBytes        = a.Size,
            }).ToList(),

            // Extension fields — silently ignored server-side for non-Extension types.
            TargetTaskId       = extTaskId,
            TargetMilestoneId  = extMilestoneId,
            RequestedDueDate   = _requestType == RequestTypes.Extension ? _extRequestedDate : null,
        };

        var (newId, error) = await RequestsService.CreateAsync(req);

        if (newId is null)
        {
            _phase       = Phase.Form;
            _submitError = string.IsNullOrWhiteSpace(error)
                ? "אירעה שגיאה בשליחת הבקשה. נסה שנית."
                : error;
            return;
        }

        _phase = Phase.Success;
        await OnSuccess.InvokeAsync();
    }

    private void ResetForm()
    {
        _phase       = Phase.Form;
        _requestType = "";
        _title       = "";
        _description = "";
        _attachments.Clear();
        _fileError   = "";
        _touched     = false;
        _submitError = "";

        // Extension-only state
        _extTargetKey     = "";
        _extRequestedDate = null;
    }

    private async Task TryClose()
    {
        if (_phase == Phase.Submitting) return;
        ResetForm();
        await OnClose.InvokeAsync();
    }

    private async Task SuccessClose()
    {
        ResetForm();
        await OnClose.InvokeAsync();
    }

    private static string FormatBytes(long bytes)
    {
        if (bytes < 1024)       return $"{bytes} B";
        if (bytes < 1_048_576)  return $"{bytes / 1024.0:F1} KB";
        return $"{bytes / 1_048_576.0:F1} MB";
    }

    /// <summary>True for image MIME types we render as inline thumbnails.
    /// Mirrors the accept list on the InputFile element.</summary>
    private static bool IsImageContentType(string? ct)
    {
        if (string.IsNullOrWhiteSpace(ct)) return false;
        var c = ct.Trim().ToLowerInvariant();
        return c is "image/jpeg" or "image/jpg" or "image/png" or "image/webp";
    }

    // ── Extension-target helpers ─────────────────────────────────────────
    //
    // Used by the deadline-extension request flow. These are pure
    // functions on the ExtensionTargetDto / DateTime values; no state
    // mutation, no I/O. The dropdown label and the details-panel banner
    // both share the same OverdueDays computation so they can never
    // disagree on whether a target is late.

    /// <summary>Days past the current due date, or null when the item has no
    /// due date. Negative values are clamped to null so we never call the
    /// banner "overdue by -3 days" for a future deadline.</summary>
    private static int? OverdueDays(ExtensionTargetDto? t)
    {
        if (t?.CurrentDueDate is null) return null;
        int days = (DateTime.Today - t.CurrentDueDate.Value.Date).Days;
        return days > 0 ? days : null;
    }

    /// <summary>Dropdown-option text: "Title — יעד: dd.MM.yyyy — באיחור N ימים"
    /// when the item is overdue, "Title — יעד: dd.MM.yyyy" when on time, and
    /// "Title — ללא תאריך יעד" when no date is set. The same Title is the
    /// only thing the legacy UI showed.</summary>
    private static string OptionLabel(ExtensionTargetDto t)
    {
        if (t.CurrentDueDate is null) return $"{t.Title} — ללא תאריך יעד";
        string dueStr = t.CurrentDueDate.Value.ToString("dd.MM.yyyy");
        int? late = OverdueDays(t);
        return late is > 0
            ? $"{t.Title} — יעד: {dueStr} — באיחור {late.Value} ימים"
            : $"{t.Title} — יעד: {dueStr}";
    }

    /// <summary>Hebrew label for the raw Status string. Falls back to the
    /// raw value when an unknown code is encountered so the student still
    /// sees something useful rather than a blank.</summary>
    private static string StatusLabel(string raw) => raw switch
    {
        "Open"               => "פתוח",
        "InProgress"         => "בביצוע",
        "Done"               => "הושלם",
        "Completed"          => "הושלם",
        "SubmittedToMentor"  => "הוגש למנחה",
        "NotStarted"         => "טרם החל",
        _                    => raw,
    };
}
