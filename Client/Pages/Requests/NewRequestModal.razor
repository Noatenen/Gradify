@using AuthWithAdmin.Client.Services
@using AuthWithAdmin.Shared.AuthSharedModels
@using Microsoft.AspNetCore.Components.Forms
@inject IProjectRequestsService RequestsService
@inject IProjectContextService  ProjectContext
@inject IRequestTypesService    RequestTypesService
@implements IAsyncDisposable
@inject IJSRuntime JS

@*
    NewRequestModal — single-step compact create form.
    Design reference: Motiva Student Requests final.dc.html (createOpen overlay).

    Collapses the previous 4-step wizard (type → details → review → sent) into
    a single form: type chips inline at the top, then fields, then submit.
    All validation, extension fields, attachment handling, and API calls are
    unchanged. The Done/sent screen is kept as the success state.
*@

@if (IsOpen)
{
    <div class="nrm-overlay" @onclick="TryClose">
        <div class="nrm-sheet"
             role="dialog"
             aria-modal="true"
             aria-labelledby="nrm-title"
             @onclick:stopPropagation="true">

            <!-- ── Header ── -->
            <div class="nrm-head">
                <strong class="nrm-title" id="nrm-title">בקשה חדשה</strong>
                <button type="button" class="nrm-x" aria-label="סגירה"
                        disabled="@(_phase == Phase.Submitting)"
                        @onclick="TryClose">×</button>
            </div>

            @if (_step == Step.Form)
            {
                <!-- ── Body: single-step form ── -->
                <div class="nrm-body">

                    <!-- Type chips -->
                    <div class="nrm-field">
                        <p class="nrm-label">סוג הבקשה</p>
                        <div class="nrm-type-chips">
                            @if (!_typesLoaded)
                            {
                                <p class="nrm-hint"><span class="nrm-spinner-sm"></span> טוען סוגי בקשה…</p>
                            }
                            else if (_availableTypes.Count == 0)
                            {
                                <p class="nrm-hint">אין סוגי בקשה פעילים — פני למרצה</p>
                            }
                            else
                            {
                                @foreach (var t in _availableTypes)
                                {
                                    var captured = t;
                                    var on = _requestType == captured.Code;
                                    <button type="button"
                                            class="nrm-chip-type @(on ? "nrm-chip-type-on" : "")"
                                            aria-pressed="@(on ? "true" : "false")"
                                            disabled="@(_phase == Phase.Submitting)"
                                            @onclick="@(() => PickType(captured.Code))">
                                        @captured.Name
                                    </button>
                                }
                            }
                        </div>
                    </div>

                    <!-- Title -->
                    <div class="nrm-field">
                        <label class="nrm-label" for="nrm-title-input">נושא הבקשה</label>
                        <input id="nrm-title-input"
                               class="nrm-input @(TitleInvalid ? "nrm-invalid" : "")"
                               type="text"
                               placeholder="למשל: בקשה להארכת מועד הגשה"
                               maxlength="200"
                               @bind="_title"
                               @bind:event="oninput"
                               disabled="@(_phase == Phase.Submitting)" />
                        @if (TitleInvalid)
                        {
                            <p class="nrm-err">יש להזין נושא לבקשה</p>
                        }
                    </div>

                    <!-- Description -->
                    <div class="nrm-field">
                        <label class="nrm-label" for="nrm-desc">פירוט</label>
                        <textarea id="nrm-desc"
                                  class="nrm-textarea @(DescriptionInvalid ? "nrm-invalid" : "")"
                                  rows="3"
                                  placeholder="תיאור קצר של הבקשה והסיבה"
                                  maxlength="2000"
                                  @bind="_description"
                                  @bind:event="oninput"
                                  disabled="@(_phase == Phase.Submitting)"></textarea>
                        @if (DescriptionInvalid)
                        {
                            <p class="nrm-err">יש להזין תוכן לבקשה</p>
                        }
                    </div>

                    <!-- Extension-only fields (conditional) -->
                    @if (_requestType == RequestTypes.Extension)
                    {
                        <div class="nrm-field">
                            <label class="nrm-label" for="nrm-target">משימה או אבן דרך</label>
                            @if (_targetsLoading)
                            {
                                <p class="nrm-hint"><span class="nrm-spinner-sm"></span> טוען רשימה…</p>
                            }
                            else
                            {
                                <select id="nrm-target"
                                        class="nrm-input @(TargetInvalid ? "nrm-invalid" : "")"
                                        @bind="_extTargetKey"
                                        disabled="@(_phase == Phase.Submitting)">
                                    <option value="">בחירת משימה / אבן דרך</option>
                                    @if (_extTargets.Any(t => t.Kind == "Task"))
                                    {
                                        <optgroup label="משימות הגשה">
                                            @foreach (var t in _extTargets.Where(x => x.Kind == "Task"))
                                            {
                                                <option value="@($"Task:{t.Id}")">@OptionLabel(t)</option>
                                            }
                                        </optgroup>
                                    }
                                    @if (_extTargets.Any(t => t.Kind == "Milestone"))
                                    {
                                        <optgroup label="אבני דרך">
                                            @foreach (var t in _extTargets.Where(x => x.Kind == "Milestone"))
                                            {
                                                <option value="@($"Milestone:{t.Id}")">@OptionLabel(t)</option>
                                            }
                                        </optgroup>
                                    }
                                </select>
                                @if (TargetInvalid)
                                {
                                    <p class="nrm-err">יש לבחור משימה או אבן דרך</p>
                                }
                            }
                        </div>

                        var sel = SelectedTarget;
                        int? overdue = OverdueDays(sel);

                        @if (sel is not null)
                        {
                            <div class="nrm-target-info">
                                <div class="nrm-info-row">
                                    <span class="nrm-info-k">פריט נבחר</span>
                                    <span class="nrm-info-v">
                                        @(sel.Kind == "Task" ? "משימה" : "אבן דרך") · @sel.Title
                                    </span>
                                </div>
                                @if (sel.Kind == "Task" && !string.IsNullOrWhiteSpace(sel.MilestoneTitle))
                                {
                                    <div class="nrm-info-row">
                                        <span class="nrm-info-k">אבן דרך משויכת</span>
                                        <span class="nrm-info-v">@sel.MilestoneTitle</span>
                                    </div>
                                }
                                @if (!string.IsNullOrWhiteSpace(_projectTitle))
                                {
                                    <div class="nrm-info-row">
                                        <span class="nrm-info-k">פרויקט / צוות</span>
                                        <span class="nrm-info-v">
                                            @_projectTitle@(string.IsNullOrWhiteSpace(_teamName) ? "" : $" — {_teamName}")
                                        </span>
                                    </div>
                                }
                                @if (!string.IsNullOrWhiteSpace(sel.Status))
                                {
                                    <div class="nrm-info-row">
                                        <span class="nrm-info-k">סטטוס נוכחי</span>
                                        <span class="nrm-info-v">@StatusLabel(sel.Status)</span>
                                    </div>
                                }
                                <div class="nrm-info-row">
                                    <span class="nrm-info-k">מועד נוכחי</span>
                                    <span class="nrm-info-v">@CurrentDueText(sel)</span>
                                </div>
                                @if (overdue is > 0)
                                {
                                    <p class="nrm-banner nrm-banner-warn">
                                        הפריט כבר באיחור של @overdue.Value ימים · הבקשה תיבחן ביחס לתאריך היעד הנוכחי
                                    </p>
                                }
                                else if (sel.CurrentDueDate is null)
                                {
                                    <p class="nrm-banner nrm-banner-warn">לא מוגדר תאריך יעד לפריט זה</p>
                                }
                            </div>
                        }

                        <div class="nrm-field">
                            <label class="nrm-label" for="nrm-date">תאריך חדש מבוקש</label>
                            <input id="nrm-date"
                                   class="nrm-input @(DateInvalid ? "nrm-invalid" : "")"
                                   type="date"
                                   @bind="_extRequestedDate"
                                   disabled="@(_phase == Phase.Submitting)" />
                            @if (DateInvalid)
                            {
                                <p class="nrm-err">@DateErrorText</p>
                            }
                        </div>
                    }

                    <!-- Attachments -->
                    <div class="nrm-field">
                        <p class="nrm-label">מסמכים תומכים</p>
                        <div class="nrm-files">
                            @foreach (var att in _attachments)
                            {
                                var captured = att;
                                <span class="nrm-chip">
                                    📎 @captured.Name
                                    <span class="nrm-chip-size">@FormatBytes(captured.Size)</span>
                                    <button type="button" class="nrm-chip-x"
                                            aria-label="@($"הסרת הקובץ {captured.Name}")"
                                            disabled="@(_phase == Phase.Submitting)"
                                            @onclick="@(() => RemoveAttachment(captured))">×</button>
                                </span>
                            }

                            <label class="nrm-attach @(CanAddMore ? "" : "nrm-attach-off")">
                                📎 <span>@(CanAddMore ? "צירוף קובץ" : "הגעת למספר המרבי")</span>
                                @if (CanAddMore)
                                {
                                    <span class="nrm-file-hidden">
                                        <InputFile multiple
                                                   accept="image/jpeg,image/png,image/webp,.jpg,.jpeg,.png,.webp,application/pdf,.pdf,application/msword,.doc,application/vnd.openxmlformats-officedocument.wordprocessingml.document,.docx"
                                                   OnChange="OnFilesSelected" />
                                    </span>
                                }
                            </label>
                        </div>
                        <p class="nrm-hint">jpg, png, webp, pdf, doc, docx · עד @MaxAttachments קבצים · עד 5MB לכל קובץ</p>
                        @if (!string.IsNullOrEmpty(_fileError))
                        {
                            <p class="nrm-err">@_fileError</p>
                        }
                    </div>

                    @if (!string.IsNullOrWhiteSpace(_submitError))
                    {
                        <p class="nrm-err nrm-err-banner">@_submitError</p>
                    }

                </div>

                <!-- ── Footer ── -->
                <div class="nrm-foot nrm-foot-form">
                    <button type="button" class="nrm-cancel-btn"
                            disabled="@(_phase == Phase.Submitting)"
                            @onclick="TryClose">ביטול</button>
                    <button type="button" class="nrm-submit-btn"
                            disabled="@(_phase == Phase.Submitting)"
                            @onclick="Submit">
                        @if (_phase == Phase.Submitting)
                        {
                            <span class="nrm-spinner-sm" aria-hidden="true"></span>
                            <span>שולח…</span>
                        }
                        else
                        {
                            <span>שליחת הבקשה</span>
                        }
                    </button>
                </div>
            }
            else
            {
                <!-- ── Done state ── -->
                <div class="nrm-done">
                    <span class="nrm-done-ic" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                             stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                            <path d="m5 12.5 4.5 4.5L19 7.5"></path>
                        </svg>
                    </span>
                    <strong class="nrm-done-title">הבקשה נשלחה</strong>
                    <p class="nrm-done-body">הבקשה נוספה לרשימה ומחכה לבדיקת @SubmittedChannel.</p>
                    <MButton Variant="MButton.ButtonVariant.Primary"
                             OnClick="SuccessClose">חזרה לבקשות</MButton>
                    <MButton Variant="MButton.ButtonVariant.Ghost" OnClick="ResetForm">הגשת בקשה נוספת</MButton>
                </div>
            }

        </div>
    </div>
}

@code {
    [Parameter] public bool          IsOpen    { get; set; }
    [Parameter] public EventCallback OnClose   { get; set; }
    [Parameter] public EventCallback OnSuccess { get; set; }

    private enum Phase { Form, Submitting }
    private enum Step  { Form, Done }

    private Phase _phase = Phase.Form;
    private Step  _step  = Step.Form;

    // Form fields
    private string _requestType = "";
    private string _title       = "";
    private string _description = "";

    // Attachments
    private record PendingAttachment(string Name, string Base64, string ContentType, long Size);
    private List<PendingAttachment> _attachments = new();
    private string _fileError = "";
    private const int  MaxAttachments     = 5;
    private const long MaxAttachmentBytes = 5 * 1_048_576L;

    // Validation / error
    private bool   _touched;
    private string _submitError = "";
    private bool   _scrollLocked;

    // Resolved on first open
    private int    _projectId;
    private string _projectTitle = "";
    private string _teamName     = "";

    private List<RequestTypeDefinitionDto> _availableTypes = new();
    private bool _typesLoaded;

    // Extension-only state
    private List<ExtensionTargetDto> _extTargets = new();
    private bool      _extTargetsLoaded;
    private bool      _targetsLoading;
    private string    _extTargetKey = "";
    private DateTime? _extRequestedDate;

    // ── Computed ──────────────────────────────────────────────────────────

    private RequestTypeDefinitionDto? SelectedType =>
        _availableTypes.FirstOrDefault(t => t.Code == _requestType);

    private string SelectedTypeName =>
        SelectedType?.Name is { Length: > 0 } n ? n : RequestTypes.Label(_requestType);

    private string SubmittedChannel
    {
        get
        {
            var roles = (SelectedType?.HandlerRole ?? "")
                .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                .Select(RequestTypeHandlerRoles.Label)
                .ToList();
            return roles.Count == 0 ? "הצוות האקדמי" : string.Join(" / ", roles);
        }
    }

    private bool CanAddMore => _attachments.Count < MaxAttachments && _phase != Phase.Submitting;

    // ── Validation ────────────────────────────────────────────────────────
    private bool TitleInvalid       => _touched && string.IsNullOrWhiteSpace(_title);
    private bool DescriptionInvalid => _touched && string.IsNullOrWhiteSpace(_description);
    private bool TargetInvalid      => _touched && _requestType == RequestTypes.Extension && SelectedTarget is null;

    private bool DateInvalid
    {
        get
        {
            if (!_touched || _requestType != RequestTypes.Extension) return false;
            if (_extRequestedDate is null) return true;
            var sel = SelectedTarget;
            return sel?.CurrentDueDate is not null
                   && _extRequestedDate.Value.Date <= sel.CurrentDueDate.Value.Date;
        }
    }

    private string DateErrorText =>
        _extRequestedDate is null
            ? "יש לבחור תאריך חדש מבוקש"
            : "התאריך המבוקש חייב להיות אחרי תאריך ההגשה הנוכחי";

    private ExtensionTargetDto? SelectedTarget
    {
        get
        {
            if (string.IsNullOrEmpty(_extTargetKey)) return null;
            var parts = _extTargetKey.Split(':', 2);
            if (parts.Length != 2) return null;
            if (!int.TryParse(parts[1], out var id)) return null;
            return _extTargets.FirstOrDefault(t => t.Kind == parts[0] && t.Id == id);
        }
    }

    // ── Lifecycle ─────────────────────────────────────────────────────────
    protected override async Task OnParametersSetAsync()
    {
        var isOpen = IsOpen;
        if (isOpen && !_scrollLocked)
            try { await JS.InvokeVoidAsync("gradify.scrollLock.lock"); } catch { }
        else if (!isOpen && _scrollLocked)
            try { await JS.InvokeVoidAsync("gradify.scrollLock.unlock"); } catch { }
        _scrollLocked = isOpen;

        if (IsOpen && _projectId == 0)
        {
            var ctx = await ProjectContext.GetAsync();
            _projectId    = ctx?.ProjectId ?? 0;
            _projectTitle = ctx?.ProjectTitle ?? "";
            _teamName     = ctx?.TeamName ?? "";
        }

        if (IsOpen && !_typesLoaded)
        {
            var list = await RequestTypesService.GetActiveAsync();
            _availableTypes = list is { Count: > 0 }
                ? list
                : RequestTypes.All
                    .Select(code => new RequestTypeDefinitionDto
                    {
                        Code = code,
                        Name = RequestTypes.Label(code),
                        IsActive = true,
                    })
                    .ToList();
            _typesLoaded = true;
        }

        if (IsOpen && !_extTargetsLoaded && !_targetsLoading)
        {
            _targetsLoading = true;
            var list = await RequestsService.GetExtensionTargetsAsync();
            _extTargets       = list ?? new();
            _extTargetsLoaded = true;
            _targetsLoading   = false;
        }
    }

    // ── Actions ───────────────────────────────────────────────────────────
    private void PickType(string code)
    {
        _requestType = code;
        _touched     = false;
        _submitError = "";
    }

    // ── Files ─────────────────────────────────────────────────────────────
    private async Task OnFilesSelected(InputFileChangeEventArgs e)
    {
        _fileError = "";

        int remaining = MaxAttachments - _attachments.Count;
        if (remaining <= 0) return;

        foreach (var file in e.GetMultipleFiles(remaining))
        {
            string ext = Path.GetExtension(file.Name).TrimStart('.').ToLowerInvariant();
            if (ext is not ("jpg" or "jpeg" or "png" or "webp" or "pdf" or "doc" or "docx"))
            {
                _fileError = $"הקובץ \"{file.Name}\" אינו סוג נתמך (jpg, png, webp, pdf, doc, docx)";
                continue;
            }

            if (file.Size > MaxAttachmentBytes)
            {
                _fileError = $"הקובץ \"{file.Name}\" חורג מהגודל המקסימלי (5 MB)";
                continue;
            }

            try
            {
                using var stream = file.OpenReadStream(maxAllowedSize: MaxAttachmentBytes);
                using var ms     = new MemoryStream();
                await stream.CopyToAsync(ms);
                string base64 = Convert.ToBase64String(ms.ToArray());
                _attachments.Add(new PendingAttachment(file.Name, base64, file.ContentType, file.Size));
            }
            catch
            {
                _fileError = $"שגיאה בקריאת הקובץ \"{file.Name}\"";
            }
        }
    }

    private void RemoveAttachment(PendingAttachment att)
    {
        _attachments.Remove(att);
        _fileError = "";
    }

    // ── Submit ────────────────────────────────────────────────────────────
    private async Task Submit()
    {
        _touched     = true;
        _submitError = "";

        if (string.IsNullOrEmpty(_requestType) || TitleInvalid || DescriptionInvalid || TargetInvalid || DateInvalid)
            return;

        if (_projectId <= 0)
        {
            _submitError = "לא נמצא פרויקט מקושר לחשבון שלך";
            return;
        }

        int? extTaskId      = null;
        int? extMilestoneId = null;
        if (_requestType == RequestTypes.Extension)
        {
            var sel = SelectedTarget!;
            if (sel.Kind == "Task")           extTaskId      = sel.Id;
            else if (sel.Kind == "Milestone") extMilestoneId = sel.Id;
        }

        _phase = Phase.Submitting;

        var req = new CreateProjectRequestRequest
        {
            ProjectId   = _projectId,
            RequestType = _requestType,
            Title       = _title.Trim(),
            Description = _description.Trim(),
            Attachments = _attachments.Select(a => new RequestAttachmentUploadRequest
            {
                OriginalFileName = a.Name,
                FileBase64       = a.Base64,
                ContentType      = a.ContentType,
                SizeBytes        = a.Size,
            }).ToList(),
            TargetTaskId      = extTaskId,
            TargetMilestoneId = extMilestoneId,
            RequestedDueDate  = _requestType == RequestTypes.Extension ? _extRequestedDate : null,
        };

        var (newId, error) = await RequestsService.CreateAsync(req);

        _phase = Phase.Form;

        if (newId is null)
        {
            _submitError = string.IsNullOrWhiteSpace(error)
                ? "אירעה שגיאה בשליחת הבקשה. נסה שנית."
                : error;
            return;
        }

        _step = Step.Done;
        await OnSuccess.InvokeAsync();
    }

    // ── Reset / close ─────────────────────────────────────────────────────
    private void ResetForm()
    {
        _phase       = Phase.Form;
        _step        = Step.Form;
        _requestType = "";
        _title       = "";
        _description = "";
        _attachments.Clear();
        _fileError   = "";
        _touched     = false;
        _submitError = "";

        _extTargetKey     = "";
        _extRequestedDate = null;
    }

    private async Task TryClose()
    {
        if (_phase == Phase.Submitting) return;
        ResetForm();
        await OnClose.InvokeAsync();
    }

    private async Task SuccessClose()
    {
        ResetForm();
        await OnClose.InvokeAsync();
    }

    // ── Helpers ───────────────────────────────────────────────────────────
    private static string FormatBytes(long bytes)
    {
        if (bytes < 1024)      return $"{bytes} B";
        if (bytes < 1_048_576) return $"{bytes / 1024.0:F1} KB";
        return $"{bytes / 1_048_576.0:F1} MB";
    }

    private static int? OverdueDays(ExtensionTargetDto? t)
    {
        if (t?.CurrentDueDate is null) return null;
        int days = (DateTime.Today - t.CurrentDueDate.Value.Date).Days;
        return days > 0 ? days : null;
    }

    private static string CurrentDueText(ExtensionTargetDto? t) =>
        t?.CurrentDueDate is null ? "—" : t.CurrentDueDate.Value.ToString("dd.MM.yyyy");

    private static string OptionLabel(ExtensionTargetDto t)
    {
        if (t.CurrentDueDate is null) return $"{t.Title} — ללא תאריך יעד";
        string dueStr = t.CurrentDueDate.Value.ToString("dd.MM.yyyy");
        int? late = OverdueDays(t);
        return late is > 0
            ? $"{t.Title} — יעד: {dueStr} — באיחור {late.Value} ימים"
            : $"{t.Title} — יעד: {dueStr}";
    }

    private static string StatusLabel(string raw) => raw switch
    {
        "Open"              => "פתוח",
        "InProgress"        => "בביצוע",
        "Done"              => "הושלם",
        "Completed"         => "הושלם",
        "SubmittedToMentor" => "הוגש למנחה",
        "NotStarted"        => "טרם החל",
        _                   => raw,
    };

    public async ValueTask DisposeAsync()
    {
        if (_scrollLocked)
            try { await JS.InvokeVoidAsync("gradify.scrollLock.unlock"); } catch { }
    }
}
