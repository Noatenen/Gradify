@using Microsoft.AspNetCore.Components.Forms
@using AuthWithAdmin.Shared.AuthSharedModels

<div class="rtr rtr-@RequestBuckets.CssSuffix(Bucket) @(Expanded ? "rtr-open" : "")">

    @* ─── COLLAPSED HEADER ────────────────────────────────────────── *@
    @* Hidden via CSS when expanded (rtr-open .rtr-head { display:none }) *@
    <div class="rtr-head" role="button" tabindex="0" aria-expanded="@(Expanded ? "true" : "false")"
         aria-label="@(Expanded ? $"צמצום {Request.Title}" : $"פתיחת {Request.Title}")"
         @onclick="OnToggle"
         @onkeydown="@(e => { if (e.Key == "Enter" || e.Key == " ") OnToggle.InvokeAsync(); })">
        <span class="rtr-dot" aria-hidden="true"></span>
        <div class="rtr-head-body">
            <div class="rtr-titlerow">
                @if (Request.HasUnread)
                {
                    <span class="rtr-unread" title="עדכון חדש" role="img" aria-label="עדכון שלא נקרא"></span>
                }
                <strong class="rtr-title">@Request.Title</strong>
                <span class="rtr-badge">@TypeLabel</span>
            </div>
            @if (!string.IsNullOrWhiteSpace(SubLine))
            {
                <span class="rtr-sub">@SubLine</span>
            }
        </div>
        <span class="rtr-time" aria-hidden="true">@RelativeTime</span>
        <span class="rtr-chevron @(Expanded ? "rtr-chevron-open" : "")" aria-hidden="true">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="m6 9 6 6 6-6"/>
            </svg>
        </span>
    </div>

    @* ─── EXPANDED BODY ────────────────────────────────────────────── *@
    <div class="rtr-body @(Expanded ? "rtr-body-open" : "")">
        <div class="rtr-body-clip">

            @* Expanded header: visible only when open *@
            <div class="rtr-exp-head">
                <div class="rtr-exp-htext">
                    <p class="rtr-exp-title">@Request.Title</p>
                    <p class="rtr-exp-sub">
                        @TypeLabel ·
                        <span class="rtr-exp-state rtr-exp-state-@RequestBuckets.CssSuffix(Bucket)">@RequestBuckets.RowLabel(Bucket)</span>
                    </p>
                </div>
                <button type="button" class="rtr-exp-nav" aria-label="סגירה" @onclick="OnToggle">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="m18 6-12 12M6 6l12 12"/>
                    </svg>
                </button>
            </div>

            <div class="rtr-body-pad">

                @* Description *@
                @if (!string.IsNullOrWhiteSpace(Request.Description))
                {
                    <p class="rtr-desc">@Request.Description</p>
                }

                @* Initial attachments count *@
                @if (Request.AttachmentCount > 0 && string.IsNullOrWhiteSpace(Request.Description))
                {
                    <p class="rtr-attach-count">📎 @Request.AttachmentCount @(Request.AttachmentCount == 1 ? "מסמך מצורף" : "מסמכים מצורפים")</p>
                }

                @* Latest staff response — shown prominently as tinted block *@
                @{
                    var staffResp = LatestStaffComment;
                }
                @if (staffResp is not null)
                {
                    <div class="rtr-resp">
                        <p class="rtr-resp-meta">
                            @staffResp.UserName
                            @if (!string.IsNullOrWhiteSpace(staffResp.UserRole))
                            {
                                <span> · @RoleLabel(staffResp.UserRole)</span>
                            }
                            <span> · @staffResp.CreatedAt.IsraelFormat("dd.MM")</span>
                        </p>
                        @if (!string.IsNullOrWhiteSpace(staffResp.Content))
                        {
                            <p class="rtr-resp-text">@staffResp.Content</p>
                        }
                        @if (staffResp.Attachments.Count > 0)
                        {
                            <div class="rtr-files rtr-resp-files">
                                @foreach (var att in staffResp.Attachments)
                                {
                                    <a class="rtr-file" href="@AttachmentUrl(att)"
                                       target="_blank" rel="noopener noreferrer">
                                        📎 @att.OriginalFileName
                                    </a>
                                }
                            </div>
                        }
                    </div>
                }

                @* Resolution notes (closed requests) *@
                @if (!string.IsNullOrWhiteSpace(Request.ResolutionNotes))
                {
                    <div class="rtr-resp rtr-resp-done">
                        <p class="rtr-resp-meta">תגובת הצוות האקדמי</p>
                        <p class="rtr-resp-text">@Request.ResolutionNotes</p>
                    </div>
                }

                @* ─── COMPOSER (horizontal inline) ─── *@
                @if (CanReply)
                {
                    <div class="rtr-composer">
                        @if (Attachments.Count > 0)
                        {
                            <div class="rtr-drafts">
                                @foreach (var att in Attachments)
                                {
                                    var captured = att;
                                    <span class="rtr-draft">
                                        📎 @captured.Name
                                        <span class="rtr-draft-size">@FormatBytes(captured.Size)</span>
                                        <button type="button"
                                                class="rtr-draft-x"
                                                aria-label="@($"הסרת הקובץ {captured.Name}")"
                                                disabled="@IsSending"
                                                @onclick="@(() => OnRemoveAttachment.InvokeAsync(captured))">×</button>
                                    </span>
                                }
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(FileError))
                        {
                            <p class="rtr-error">@FileError</p>
                        }
                        @if (!string.IsNullOrEmpty(ReplyError))
                        {
                            <p class="rtr-error">@ReplyError</p>
                        }
                        <div class="rtr-composer-row">
                            <label class="rtr-attach @(CanAttachMore ? "" : "rtr-attach-off")"
                                   title="@($"עד {MaxAttachments} קבצים, עד 5MB כל אחד")">
                                <svg class="rtr-attach-ic" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                     stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <path d="M20 11.5 12 19.5a4.5 4.5 0 0 1-6.4-6.4l7.6-7.6a3 3 0 0 1 4.3 4.3l-7.6 7.6a1.5 1.5 0 0 1-2.2-2.2l7-7"/>
                                </svg>
                                <span>צירוף מסמך</span>
                                @if (CanAttachMore)
                                {
                                    <span class="rtr-file-hidden">
                                        <InputFile multiple
                                                   accept="image/jpeg,image/png,image/webp,application/pdf,.pdf,application/msword,.doc,application/vnd.openxmlformats-officedocument.wordprocessingml.document,.docx,.jpg,.jpeg,.png,.webp"
                                                   OnChange="OnFilesSelected"
                                                   disabled="@IsSending" />
                                    </span>
                                }
                            </label>
                            <textarea class="rtr-input"
                                      rows="1"
                                      placeholder="כתיבת תגובה..."
                                      maxlength="2000"
                                      disabled="@IsSending"
                                      value="@ReplyText"
                                      @oninput="@(e => ReplyTextChanged.InvokeAsync(e.Value?.ToString() ?? ""))"></textarea>
                            <button type="button"
                                    class="rtr-send-btn"
                                    disabled="@(IsSending || string.IsNullOrWhiteSpace(ReplyText))"
                                    @onclick="OnSend">
                                @if (IsSending)
                                {
                                    <span class="rtr-send-spinner" aria-hidden="true"></span>
                                }
                                <span>שליחה</span>
                            </button>
                        </div>
                    </div>
                }
                else
                {
                    <p class="rtr-closed">הבקשה טופלה ונסגרה · השיחה נשמרת לקריאה</p>
                }

                @* ─── HISTORY TOGGLE ─── *@
                @{
                    var timeline  = VisibleEvents;
                    var histCount = timeline.Count;
                }
                @if (histCount > 0)
                {
                    <div class="rtr-hist">
                        <button type="button"
                                class="rtr-hist-btn"
                                aria-expanded="@(_showOlder ? "true" : "false")"
                                @onclick="ToggleOlder">
                            <span>היסטוריה · @histCount @(histCount == 1 ? "עדכון" : "עדכונים")</span>
                            <span class="rtr-hist-caret @(_showOlder ? "rtr-hist-caret-open" : "")" aria-hidden="true">
                                <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                     stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="m6 9 6 6 6-6"/>
                                </svg>
                            </span>
                        </button>

                        @if (_showOlder)
                        {
                            <div class="rtr-hist-items">
                                @foreach (var evt in timeline)
                                {
                                    var isComment = evt.EventType == RequestEventTypes.Comment;
                                    <div class="rtr-hist-item">
                                        <span class="rtr-hist-dot" aria-hidden="true"></span>
                                        <div class="rtr-hist-content">
                                            @if (isComment)
                                            {
                                                <p class="rtr-hist-who">@evt.UserName · @evt.CreatedAt.IsraelFormat("dd.MM · HH:mm")</p>
                                            }
                                            <p class="rtr-hist-text">
                                                @(isComment ? evt.Content : $"{EventSummary(evt)} · {evt.CreatedAt.IsraelFormat("dd.MM · HH:mm")}")
                                            </p>
                                            @if (isComment && evt.Attachments.Count > 0)
                                            {
                                                <div class="rtr-files">
                                                    @foreach (var att in evt.Attachments)
                                                    {
                                                        <a class="rtr-file" href="@AttachmentUrl(att)"
                                                           target="_blank" rel="noopener noreferrer">
                                                            📎 @att.OriginalFileName
                                                        </a>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }

            </div>@* end rtr-body-pad *@
        </div>@* end rtr-body-clip *@
    </div>@* end rtr-body *@

</div>@* end rtr *@

@code {
    [Parameter, EditorRequired] public StudentOwnRequestDto Request { get; set; } = default!;
    [Parameter, EditorRequired] public RequestBucket Bucket { get; set; }

    /// <summary>Resolved by the page from the admin-managed request-type
    /// catalogue, falling back to RequestTypes.Label. Passed in rather than
    /// looked up here so every row on the page uses one map.</summary>
    [Parameter] public string TypeLabel { get; set; } = "";

    [Parameter] public bool Expanded { get; set; }
    [Parameter] public EventCallback OnToggle { get; set; }

    /// <summary>False for Resolved/Closed — the server rejects a reply on those,
    /// so the composer is replaced by the read-only line rather than failing.</summary>
    [Parameter] public bool CanReply { get; set; }

    [Parameter] public string ReplyText { get; set; } = "";
    [Parameter] public EventCallback<string> ReplyTextChanged { get; set; }

    [Parameter] public IReadOnlyList<PendingRequestAttachment> Attachments { get; set; }
        = Array.Empty<PendingRequestAttachment>();
    [Parameter] public EventCallback<InputFileChangeEventArgs> OnFilesSelected { get; set; }
    [Parameter] public EventCallback<PendingRequestAttachment> OnRemoveAttachment { get; set; }

    [Parameter] public int MaxAttachments { get; set; } = 3;
    [Parameter] public bool IsSending { get; set; }
    [Parameter] public string? ReplyError { get; set; }
    [Parameter] public string? FileError { get; set; }
    [Parameter] public EventCallback OnSend { get; set; }

    private bool CanAttachMore => Attachments.Count < MaxAttachments && !IsSending;

    // ── Timeline window ───────────────────────────────────────────────────
    // How much of a conversation is "enough recent context to act". Three
    // events is a staff message plus the exchange around it, which is what a
    // student re-reads before replying; everything older is reference.

    private const int RecentEventWindow = 3;

    /// <summary>Per-thread, and the page's @key on this component is the
    /// request id — so the choice to open history survives a reload, a reply
    /// and a collapse/expand of the thread, exactly like the reply draft.</summary>
    private bool _showOlder;

    private void ToggleOlder() => _showOlder = !_showOlder;

    /// <summary>The events that actually reach the student. A system event with
    /// no summary (an event type this screen does not narrate) renders nothing,
    /// so counting it would make the window silently shorter than three and
    /// could offer a "show older" control that reveals nothing.
    /// Order is the server's — CreatedAt ASC — and is never re-sorted here.</summary>
    private List<ProjectRequestEventDto> VisibleEvents =>
        Request.Events
               .Where(e => e.EventType == RequestEventTypes.Comment
                           || !string.IsNullOrWhiteSpace(EventSummary(e)))
               .ToList();

    private bool HasAnyMessage =>
        !string.IsNullOrWhiteSpace(Request.Description)
        || Request.AttachmentCount > 0
        || Request.Events.Count > 0
        || !string.IsNullOrWhiteSpace(Request.ResolutionNotes);

    // ── Counterpart ───────────────────────────────────────────────────────
    // The Design's avatar and sub-line name the person on the other side of the
    // thread. The student list DTO carries no assignee, so the counterpart is
    // derived from who last spoke that isn't the student — which is exactly who
    // the student is waiting on. Falls back to the generic academic-side name.

    private ProjectRequestEventDto? LatestStaffEvent =>
        Request.Events
               .Where(e => e.EventType == RequestEventTypes.Comment
                           && e.UserRole != Roles.Student
                           && !string.IsNullOrWhiteSpace(e.UserName))
               .OrderByDescending(e => e.CreatedAt)
               .FirstOrDefault();

    private ProjectRequestEventDto? LatestStaffComment =>
        Request.Events
               .Where(e => e.EventType == RequestEventTypes.Comment
                           && e.UserRole != Roles.Student
                           && !string.IsNullOrWhiteSpace(e.Content))
               .OrderByDescending(e => e.CreatedAt)
               .FirstOrDefault();

    private string CounterpartName => LatestStaffEvent?.UserName ?? "הצוות האקדמי";

    private string CounterpartInitials
    {
        get
        {
            var parts = CounterpartName
                .Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
            if (parts.Length == 0) return "?";
            if (parts.Length == 1) return parts[0][..Math.Min(2, parts[0].Length)];
            return $"{parts[0][0]}{parts[1][0]}";
        }
    }

    /// <summary>Design's sub-line: who is on the other side, then the latest
    /// message as a one-line excerpt. Reuses the excerpt rule the previous
    /// inbox list already used.</summary>
    private string SubLine
    {
        get
        {
            var latest = Request.Events
                .Where(e => e.EventType == RequestEventTypes.Comment
                            && !string.IsNullOrWhiteSpace(e.Content))
                .OrderByDescending(e => e.CreatedAt)
                .FirstOrDefault();

            var raw = latest?.Content ?? Request.ResolutionNotes ?? Request.Description ?? "";
            raw = raw.Replace("\r", " ").Replace("\n", " ").Trim();
            if (raw.Length > 90) raw = raw[..90] + "…";

            if (LatestStaffEvent is null) return raw;
            return string.IsNullOrEmpty(raw) ? CounterpartName : $"{CounterpartName} · {raw}";
        }
    }

    private string BubbleMeta(ProjectRequestEventDto evt, bool mine)
    {
        var stamp = evt.CreatedAt.IsraelFormat("dd.MM · HH:mm");
        if (mine) return $"את · {stamp}";

        var role = string.IsNullOrWhiteSpace(evt.UserRole) ? "" : $" · {RoleLabel(evt.UserRole)}";
        return $"{evt.UserName}{role} · {stamp}";
    }

    private string RelativeTime => FormatRelativeOrDate(Request.UpdatedAt);

    // ── Display helpers (carried over unchanged from the previous page) ────

    private static string EventSummary(ProjectRequestEventDto evt) => evt.EventType switch
    {
        RequestEventTypes.StatusChange   => $"סטטוס שונה ל: {evt.NewValue}",
        RequestEventTypes.PriorityChange => $"עדיפות שונתה ל: {evt.NewValue}",
        RequestEventTypes.AssigneeChange => evt.NewValue is not null
            ? $"הבקשה הועברה ל{evt.NewValue}"
            : "שיוך הוסר",
        _ => "",
    };

    private static string RoleLabel(string role) => role switch
    {
        Roles.Admin   => "מנהל",
        Roles.Staff   => "מרצה",
        Roles.Mentor  => "מנחה",
        Roles.Student => "סטודנט",
        _             => role,
    };

    private static string AttachmentUrl(ProjectRequestEventAttachmentDto att) =>
        $"/request-attachments/{att.StoredFileName}";

    private static bool IsImage(string? contentType) =>
        !string.IsNullOrWhiteSpace(contentType)
        && contentType.StartsWith("image/", StringComparison.OrdinalIgnoreCase);

    private static string FormatBytes(long bytes)
    {
        if (bytes < 1024)        return $"{bytes} B";
        if (bytes < 1024 * 1024) return $"{bytes / 1024.0:F1} KB";
        return $"{bytes / (1024.0 * 1024):F1} MB";
    }

    private static string FormatRelativeOrDate(DateTime t)
    {
        var diff = DateTime.Now - t.ToLocalTime();
        if (diff.TotalMinutes < 1)  return "כעת";
        if (diff.TotalMinutes < 60) return $"לפני {(int)diff.TotalMinutes} דק'";
        if (diff.TotalHours   < 24) return $"לפני {(int)diff.TotalHours} שע'";
        if (diff.TotalDays    < 7)  return $"לפני {(int)diff.TotalDays} ימים";
        return t.ToLocalTime().ToString("dd.MM.yyyy");
    }
}
