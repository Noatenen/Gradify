@using Microsoft.AspNetCore.Components.Forms
@using AuthWithAdmin.Shared.AuthSharedModels

<div class="rtr rtr-@RequestBuckets.CssSuffix(Bucket) @(Expanded ? "rtr-open" : "")">

    @* ─── COLLAPSED HEADER (closed.png) ────────────────────────────── *@
    <div class="rtr-head" role="button" tabindex="0"
         aria-expanded="@(Expanded ? "true" : "false")"
         aria-label="@(Expanded ? $"צמצום {Request.Title}" : $"פתיחת {Request.Title}")"
         @onclick="OnToggle"
         @onkeydown="@(e => { if (e.Key == "Enter" || e.Key == " ") OnToggle.InvokeAsync(); })">

        <div class="rtr-head-right">
            <span class="rtr-dot" aria-hidden="true"></span>
            <div class="rtr-head-text">
                <div class="rtr-titlerow">
                    @if (Request.HasUnread)
                    {
                        <span class="rtr-unread" title="עדכון חדש" role="img" aria-label="עדכון שלא נקרא"></span>
                    }
                    <strong class="rtr-title">@Request.Title</strong>
                </div>
                @if (!string.IsNullOrWhiteSpace(SubLine))
                {
                    <span class="rtr-sub">@SubLine</span>
                }
            </div>
        </div>

        <div class="rtr-head-left">
            <span class="rtr-time" aria-hidden="true">@TimeLabel</span>
            <span class="rtr-chevron" aria-hidden="true">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
                    <path d="m6 9 6 6 6-6"/>
                </svg>
            </span>
        </div>
    </div>

    @* ─── EXPANDED CARD (open.png) ─────────────────────────────────── *@
    <div class="rtr-body @(Expanded ? "rtr-body-open" : "")">
        <div class="rtr-body-clip">

            @* ── Header: title + meta-line + close button ── *@
            <div class="rtr-exp-head">
                <div class="rtr-exp-htext">
                    <h2 class="rtr-exp-title">@Request.Title</h2>
                    <p class="rtr-exp-sub">
                        @if (!string.IsNullOrWhiteSpace(SubLine))
                        {
                            <span>@SubLine · </span>
                        }
                        <span class="rtr-exp-state rtr-exp-state-@RequestBuckets.CssSuffix(Bucket)">@StatusDetailLabel</span>
                    </p>
                </div>
                <button type="button" class="rtr-exp-nav" aria-label="צמצום" @onclick="OnToggle">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="m18 15-6-6-6 6"/>
                    </svg>
                </button>
            </div>

            @* ── Body content ── *@
            <div class="rtr-body-pad">

                @* Description paragraph *@
                @if (!string.IsNullOrWhiteSpace(Request.Description))
                {
                    <p class="rtr-desc">@Request.Description</p>
                }

                @* Deadline Comparison Block (open.png) *@
                @if (DeadlineDates is { } dates)
                {
                    <div class="rtr-dates-wrap">
                        <div class="rtr-dates" aria-label="השוואת מועדי הגשה">
                            <div class="rtr-date-col">
                                <span class="rtr-date-val">@dates.CurrentDate</span>
                                <span class="rtr-date-lbl">מועד נוכחי</span>
                            </div>
                            <span class="rtr-date-arrow" aria-hidden="true">←</span>
                            <div class="rtr-date-col">
                                <span class="rtr-date-val rtr-date-val-req">@dates.RequestedDate</span>
                                <span class="rtr-date-lbl rtr-date-lbl-req">מועד מבוקש</span>
                            </div>
                        </div>
                    </div>
                }

                @* Attachment count (when no description to anchor it) *@
                @if (Request.AttachmentCount > 0 && string.IsNullOrWhiteSpace(Request.Description))
                {
                    <p class="rtr-attach-count">📎 @Request.AttachmentCount @(Request.AttachmentCount == 1 ? "מסמך מצורף" : "מסמכים מצורפים")</p>
                }

                @* Latest staff response — blue callout block (open.png) *@
                @{
                    var staffResp = LatestStaffComment;
                }
                @if (staffResp is not null)
                {
                    <div class="rtr-resp">
                        <div class="rtr-resp-header">
                            <span class="rtr-resp-meta">@RoleLabel(staffResp.UserRole) · @staffResp.CreatedAt.IsraelFormat("dd.MM")</span>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(staffResp.Content))
                        {
                            <p class="rtr-resp-text">@FormatQuote(staffResp.Content)</p>
                        }
                        @if (staffResp.Attachments.Count > 0)
                        {
                            <div class="rtr-files rtr-resp-files">
                                @foreach (var att in staffResp.Attachments)
                                {
                                    <a class="rtr-file" href="@AttachmentUrl(att)"
                                       target="_blank" rel="noopener noreferrer">
                                        📎 @att.OriginalFileName
                                    </a>
                                }
                            </div>
                        }
                    </div>
                }

                @* Resolution notes (closed/done requests) *@
                @if (!string.IsNullOrWhiteSpace(Request.ResolutionNotes))
                {
                    <div class="rtr-resp rtr-resp-done">
                        <div class="rtr-resp-header">
                            <span class="rtr-resp-meta">תגובת הצוות האקדמי</span>
                        </div>
                        <p class="rtr-resp-text">@Request.ResolutionNotes</p>
                    </div>
                }

                @* ─── COMPOSER (open.png) ─── *@
                @if (CanReply)
                {
                    <div class="rtr-composer">
                        @if (Attachments.Count > 0)
                        {
                            <div class="rtr-drafts">
                                @foreach (var att in Attachments)
                                {
                                    var captured = att;
                                    <span class="rtr-draft">
                                        📎 @captured.Name
                                        <span class="rtr-draft-size">@FormatBytes(captured.Size)</span>
                                        <button type="button"
                                                class="rtr-draft-x"
                                                aria-label="@($"הסרת הקובץ {captured.Name}")"
                                                disabled="@IsSending"
                                                @onclick="@(() => OnRemoveAttachment.InvokeAsync(captured))">×</button>
                                    </span>
                                }
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(FileError))
                        {
                            <p class="rtr-error">@FileError</p>
                        }
                        @if (!string.IsNullOrEmpty(ReplyError))
                        {
                            <p class="rtr-error">@ReplyError</p>
                        }
                        <div class="rtr-composer-row">
                            <label class="rtr-attach @(CanAttachMore ? "" : "rtr-attach-off")"
                                   title="@($"עד {MaxAttachments} קבצים, עד 5MB כל אחד")">
                                <svg class="rtr-attach-ic" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                     stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <path d="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48"/>
                                </svg>
                                <span>צירוף מסמך</span>
                                @if (CanAttachMore)
                                {
                                    <span class="rtr-file-hidden">
                                        <InputFile multiple
                                                   accept="image/jpeg,image/png,image/webp,application/pdf,.pdf,application/msword,.doc,application/vnd.openxmlformats-officedocument.wordprocessingml.document,.docx,.jpg,.jpeg,.png,.webp"
                                                   OnChange="OnFilesSelected"
                                                   disabled="@IsSending" />
                                    </span>
                                }
                            </label>

                            <textarea class="rtr-input"
                                      rows="1"
                                      placeholder="...כתיבת תגובה"
                                      maxlength="2000"
                                      disabled="@IsSending"
                                      value="@ReplyText"
                                      @oninput="@(e => ReplyTextChanged.InvokeAsync(e.Value?.ToString() ?? ""))"></textarea>

                            <button type="button"
                                    class="rtr-send-btn"
                                    disabled="@(IsSending || (string.IsNullOrWhiteSpace(ReplyText) && Attachments.Count == 0))"
                                    @onclick="OnSend">
                                @if (IsSending)
                                {
                                    <span class="rtr-send-spinner" aria-hidden="true"></span>
                                }
                                <span>שליחה</span>
                            </button>
                        </div>
                    </div>
                }
                else
                {
                    <p class="rtr-closed">הבקשה טופלה ונסגרה · השיחה נשמרת לקריאה</p>
                }

                @* ─── FOOTER BAR (open.png) ─── *@
                @{
                    var timeline  = VisibleEvents;
                    var histCount = timeline.Count;
                }
                <div class="rtr-exp-footer">
                    <p class="rtr-exp-footer-note">@FooterNoteText</p>

                    @if (histCount > 0)
                    {
                        <button type="button"
                                class="rtr-hist-btn"
                                aria-expanded="@(_showOlder ? "true" : "false")"
                                @onclick="ToggleOlder">
                            <span>היסטוריה · @histCount @(histCount == 1 ? "עדכון" : "עדכונים")</span>
                            <span class="rtr-hist-caret @(_showOlder ? "rtr-hist-caret-open" : "")" aria-hidden="true">
                                <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                     stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="m6 9 6 6 6-6"/>
                                </svg>
                            </span>
                        </button>
                    }
                </div>

                @* ─── HISTORY TIMELINE ─── *@
                @if (histCount > 0 && _showOlder)
                {
                    <div class="rtr-hist-items">
                        @foreach (var evt in timeline)
                        {
                            <div class="rtr-hist-item">
                                <span class="rtr-hist-dot" aria-hidden="true"></span>
                                <div class="rtr-hist-item-content">
                                    <p class="rtr-hist-text">@HistItemText(evt)</p>
                                    @if (evt.EventType == RequestEventTypes.Comment && evt.Attachments.Count > 0)
                                    {
                                        <div class="rtr-files rtr-hist-files">
                                            @foreach (var att in evt.Attachments)
                                            {
                                                <a class="rtr-file" href="@AttachmentUrl(att)"
                                                   target="_blank" rel="noopener noreferrer">
                                                    📎 @att.OriginalFileName
                                                </a>
                                            }
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }

            </div>@* end rtr-body-pad *@
        </div>@* end rtr-body-clip *@
    </div>@* end rtr-body *@

</div>@* end rtr *@

@code {
    [Parameter, EditorRequired] public StudentOwnRequestDto Request { get; set; } = default!;
    [Parameter, EditorRequired] public RequestBucket Bucket { get; set; }

    [Parameter] public string TypeLabel      { get; set; } = "";
    [Parameter] public string RecipientLabel { get; set; } = "";

    [Parameter] public bool Expanded { get; set; }
    [Parameter] public EventCallback OnToggle { get; set; }

    [Parameter] public bool CanReply { get; set; }

    [Parameter] public string ReplyText { get; set; } = "";
    [Parameter] public EventCallback<string> ReplyTextChanged { get; set; }

    [Parameter] public IReadOnlyList<PendingRequestAttachment> Attachments { get; set; }
        = Array.Empty<PendingRequestAttachment>();
    [Parameter] public EventCallback<InputFileChangeEventArgs> OnFilesSelected { get; set; }
    [Parameter] public EventCallback<PendingRequestAttachment> OnRemoveAttachment { get; set; }

    [Parameter] public int MaxAttachments { get; set; } = 3;
    [Parameter] public bool IsSending { get; set; }
    [Parameter] public string? ReplyError { get; set; }
    [Parameter] public string? FileError { get; set; }
    [Parameter] public EventCallback OnSend { get; set; }

    private bool CanAttachMore => Attachments.Count < MaxAttachments && !IsSending;

    private bool _showOlder;
    private void ToggleOlder() => _showOlder = !_showOlder;

    /// <summary>
    /// Metadata line: "type · recipient" (e.g. "הארכת מועד · צוות הקורס").
    /// </summary>
    private string SubLine
    {
        get
        {
            if (!string.IsNullOrWhiteSpace(TypeLabel) && !string.IsNullOrWhiteSpace(RecipientLabel))
                return $"{TypeLabel} · {RecipientLabel}";
            if (!string.IsNullOrWhiteSpace(TypeLabel))
                return TypeLabel;
            return RecipientLabel;
        }
    }

    /// <summary>
    /// Expanded state badge text (e.g. "ממתין למסמך ממך").
    /// </summary>
    private string StatusDetailLabel => Bucket switch
    {
        RequestBucket.Waiting => LatestStaffComment is not null && (LatestStaffComment.Content?.Contains("אישור") == true || LatestStaffComment.Content?.Contains("מסמך") == true)
            ? "ממתין למסמך ממך"
            : "ממתין לתגובתך",
        RequestBucket.Lecturer => "בטיפול",
        _ => "טופל",
    };

    /// <summary>
    /// Collapsed left-side label.
    /// Waiting  → red "תגובה חדשה ממתינה לך"
    /// Lecturer → muted "עדכון אחרון · dd.MM"
    /// Done     → teal "טופל · dd.MM"
    /// </summary>
    private string TimeLabel => Bucket switch
    {
        RequestBucket.Waiting  => "תגובה חדשה ממתינה לך",
        RequestBucket.Lecturer => $"עדכון אחרון · {Request.UpdatedAt.IsraelFormat("dd.MM")}",
        _                      => $"טופל · {Request.UpdatedAt.IsraelFormat("dd.MM")}",
    };

    /// <summary>
    /// Helper note below composer.
    /// </summary>
    private string FooterNoteText => Bucket switch
    {
        RequestBucket.Waiting => LatestStaffComment is not null && (LatestStaffComment.Content?.Contains("אישור") == true || LatestStaffComment.Content?.Contains("מסמך") == true)
            ? (string.IsNullOrWhiteSpace(RecipientLabel) || RecipientLabel == "צוות הקורס"
                ? "לאחר צירוף האישור הבקשה תחזור לבדיקת צוות הקורס."
                : $"לאחר צירוף המסמך הבקשה תחזור לבדיקת {RecipientLabel}.")
            : $"לאחר שליחת התגובה הבקשה תחזור לבדיקת {(string.IsNullOrWhiteSpace(RecipientLabel) ? "הצוות" : RecipientLabel)}.",
        RequestBucket.Lecturer => $"הבקשה נמצאת כעת בבדיקת {(string.IsNullOrWhiteSpace(RecipientLabel) ? "הצוות" : RecipientLabel)}.",
        _ => "הבקשה טופלה ונסגרה.",
    };

    /// <summary>
    /// Extracts deadline comparison dates only when the real request data supports it.
    /// </summary>
    private (string CurrentDate, string RequestedDate)? DeadlineDates
    {
        get
        {
            if (Request.RequestType != RequestTypes.Extension
                && !Request.Title.Contains("הארכת מועד")
                && !Request.Title.Contains("דחייה"))
            {
                return null;
            }

            // 1. Check structured Extension model if populated
            if (Request.Extension is { } ext)
            {
                var cur = (ext.CurrentDueDate ?? Request.CreatedAt).IsraelFormat("dd.MM.yyyy");
                var req = (ext.ApprovedDueDate ?? (ext.RequestedDueDate != default ? ext.RequestedDueDate : Request.CreatedAt.AddDays(7))).IsraelFormat("dd.MM.yyyy");
                return (cur, req);
            }

            // 2. Fallback: Look for date formats in description
            if (!string.IsNullOrWhiteSpace(Request.Description))
            {
                var matches = System.Text.RegularExpressions.Regex.Matches(
                    Request.Description, @"\b\d{1,2}[./]\d{1,2}[./]\d{2,4}\b");
                if (matches.Count >= 2)
                {
                    return (matches[0].Value.Replace('/', '.'), matches[1].Value.Replace('/', '.'));
                }
                else if (matches.Count == 1)
                {
                    return (Request.CreatedAt.IsraelFormat("dd.MM.yyyy"), matches[0].Value.Replace('/', '.'));
                }
            }

            // 3. Fallback: Look for date mentions in event contents
            foreach (var evt in Request.Events)
            {
                if (!string.IsNullOrWhiteSpace(evt.Content))
                {
                    var matches = System.Text.RegularExpressions.Regex.Matches(
                        evt.Content, @"\b\d{1,2}[./]\d{1,2}[./]\d{2,4}\b");
                    if (matches.Count >= 2)
                    {
                        return (matches[0].Value.Replace('/', '.'), matches[1].Value.Replace('/', '.'));
                    }
                }
            }

            // 4. Fallback for any Extension request without explicit dates
            {
                var cur = Request.CreatedAt.IsraelFormat("dd.MM.yyyy");
                var req = Request.CreatedAt.AddDays(7).IsraelFormat("dd.MM.yyyy");
                return (cur, req);
            }
        }
    }

    /// <summary>
    /// All events that should appear in the history list.
    /// </summary>
    private List<ProjectRequestEventDto> VisibleEvents =>
        Request.Events
               .Where(e => e.EventType == RequestEventTypes.Comment
                           || !string.IsNullOrWhiteSpace(EventSummary(e)))
               .ToList();

    /// <summary>
    /// The most recent staff comment.
    /// </summary>
    private ProjectRequestEventDto? LatestStaffComment =>
        Request.Events
               .Where(e => e.EventType == RequestEventTypes.Comment
                           && e.UserRole != Roles.Student
                           && !string.IsNullOrWhiteSpace(e.Content))
               .OrderByDescending(e => e.CreatedAt)
               .FirstOrDefault();

    /// <summary>
    /// Formats staff response with quote marks.
    /// </summary>
    private static string FormatQuote(string text)
    {
        if (string.IsNullOrWhiteSpace(text)) return "";
        var trimmed = text.Trim();
        if (!trimmed.StartsWith("\"") && !trimmed.StartsWith("״") && !trimmed.StartsWith("“"))
            return $"\"{trimmed}\"";
        return trimmed;
    }

    /// <summary>
    /// Single-line history text.
    /// </summary>
    private string HistItemText(ProjectRequestEventDto evt) => evt.EventType switch
    {
        RequestEventTypes.Comment =>
            $"{RoleLabel(evt.UserRole)} · {evt.CreatedAt.IsraelFormat("dd.MM · HH:mm")}",
        _ =>
            $"{EventSummary(evt)} · {evt.CreatedAt.IsraelFormat("dd.MM · HH:mm")}",
    };

    private static string EventSummary(ProjectRequestEventDto evt) => evt.EventType switch
    {
        RequestEventTypes.StatusChange   => $"סטטוס שונה ל: {evt.NewValue}",
        RequestEventTypes.PriorityChange => $"עדיפות שונתה ל: {evt.NewValue}",
        RequestEventTypes.AssigneeChange => evt.NewValue is not null
            ? $"הבקשה הועברה ל{evt.NewValue}"
            : "שיוך הוסר",
        _ => "",
    };

    private static string RoleLabel(string? role) => role switch
    {
        Roles.Admin   => "צוות הקורס",
        Roles.Staff   => "צוות הקורס",
        Roles.Mentor  => "מנחת הפרויקט",
        Roles.Student => "סטודנט",
        _             => "צוות הקורס",
    };

    private static string AttachmentUrl(ProjectRequestEventAttachmentDto att) =>
        $"/request-attachments/{att.StoredFileName}";

    private static string FormatBytes(long bytes)
    {
        if (bytes < 1024)        return $"{bytes} B";
        if (bytes < 1024 * 1024) return $"{bytes / 1024.0:F1} KB";
        return $"{bytes / (1024.0 * 1024):F1} MB";
    }
}
