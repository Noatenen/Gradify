@*
    RequestsKpiRow — the finalized design's KPI row
    (Motiva Requests.dc.html, .kpi-grid inside the ambient hero).

    Unlike Tasks, all four cards here are filter toggles: the Design wires the
    first three to a status filter and the fourth ("סה״כ") to clearing it, and
    its own comment is explicit that "KPI quick filters and the Status dropdown
    write to the SAME filter state". This component therefore reports the
    pressed state and raises a filter id — it owns no state of its own.

    Everything visual comes from the shared MKpiGrid / MKpiCard: the grid's
    stretch-to-content-width behaviour is the System Master's own Requests
    reference fix, and the accents are MKpiCard's presentation hues. Amber is
    the one added for this screen; the row's *status* colours are unaffected
    and still resolve onto violet / teal / rose via MStatusDot.

    Icons are the Design's own inline SVGs rather than "oi" glyphs — the four
    marks (speech bubble, review, check, list) have no open-iconic equivalent
    that reads the same at 15px.
*@

<MKpiGrid Columns="4" AriaLabel="סיכום בקשות">

    <MKpiCard Value="@WaitingCount.ToString()"
              Label="מחכות לתגובתך"
              Accent="MKpiCard.KpiAccent.Amber"
              Pressed="@IsPressed(RequestBuckets.WaitingFilterId)"
              OnClick="@(() => Select(RequestBuckets.WaitingFilterId))"
              AriaLabel="@($"{WaitingCount} בקשות שמחכות לתגובתך")">
        <Icon>
            <svg class="rkr-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M20 6.5v8a2 2 0 0 1-2 2H9l-4 3.5V6.5a2 2 0 0 1 2-2h11a2 2 0 0 1 2 2z"></path>
            </svg>
        </Icon>
    </MKpiCard>

    <MKpiCard Value="@LecturerCount.ToString()"
              Label="בבדיקת מרצה"
              Accent="MKpiCard.KpiAccent.Violet"
              Pressed="@IsPressed(RequestBuckets.LecturerFilterId)"
              OnClick="@(() => Select(RequestBuckets.LecturerFilterId))"
              AriaLabel="@($"{LecturerCount} בקשות בבדיקת מרצה")">
        <Icon>
            <svg class="rkr-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M8 3h8M8 21h8M8 3v4l4 4 4-4V3M8 21v-4l4-4 4 4v4"></path>
            </svg>
        </Icon>
    </MKpiCard>

    <MKpiCard Value="@DoneCount.ToString()"
              Label="טופלו"
              Accent="MKpiCard.KpiAccent.Teal"
              Pressed="@IsPressed(RequestBuckets.DoneFilterId)"
              OnClick="@(() => Select(RequestBuckets.DoneFilterId))"
              AriaLabel="@($"{DoneCount} בקשות שטופלו")">
        <Icon>
            <svg class="rkr-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="9"></circle>
                <path d="m8.5 12.5 2.2 2.2 4.8-4.8"></path>
            </svg>
        </Icon>
    </MKpiCard>

    @*
        "סה״כ" is not a fourth filter — it clears the status axis, which is why
        it reads as pressed exactly when no status filter is active. Type
        filters are a separate axis and are deliberately left alone by it,
        matching the Design's resetStatusFilter().
    *@
    <MKpiCard Value="@TotalCount.ToString()"
              Label="סה״כ בקשות"
              Accent="MKpiCard.KpiAccent.None"
              Pressed="@(ActiveStatusFilters.Count == 0)"
              OnClick="OnClearStatusFilters"
              AriaLabel="@($"סך הכול {TotalCount} בקשות — הצגת כל הסטטוסים")">
        <Icon>
            <svg class="rkr-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="4" y="4" width="16" height="16" rx="3"></rect>
                <path d="M8 10h8"></path>
                <path d="M8 14h5"></path>
            </svg>
        </Icon>
    </MKpiCard>

</MKpiGrid>

@code {
    [Parameter, EditorRequired] public int WaitingCount  { get; set; }
    [Parameter, EditorRequired] public int LecturerCount { get; set; }
    [Parameter, EditorRequired] public int DoneCount     { get; set; }
    [Parameter, EditorRequired] public int TotalCount    { get; set; }

    /// <summary>The status half of the page's filter state — the same set the
    /// status dropdown writes to.</summary>
    [Parameter] public IReadOnlyCollection<string> ActiveStatusFilters { get; set; }
        = Array.Empty<string>();

    /// <summary>Raises one of the RequestBuckets.*FilterId constants.</summary>
    [Parameter] public EventCallback<string> OnSelectStatus { get; set; }

    [Parameter] public EventCallback OnClearStatusFilters { get; set; }

    private bool IsPressed(string id) => ActiveStatusFilters.Contains(id);

    private Task Select(string id) => OnSelectStatus.InvokeAsync(id);
}
