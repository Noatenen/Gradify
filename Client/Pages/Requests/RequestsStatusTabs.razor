@*
    RequestsStatusTabs — the finalized Requests screen's status switcher.

    The final design (design-reference/motiva-student-final, Motiva Student
    Requests final) puts the status axis in ONE segmented pill group on the
    title row — הכל · דורש ממך פעולה② · בטיפול · טופלו — not in a row of KPI
    cards. The count that mattered is kept: it rides on the "דורש ממך פעולה"
    tab as a badge, exactly as the reference draws it.

    This replaces RequestsKpiRow. Only the presentation changed: the
    parameters, the pressed semantics and both callbacks are identical, so
    the page's filter state, the status dropdown it shares that state with,
    and the clear-filters behaviour are untouched.

    "הכל" is not a fourth status — it CLEARS the status axis, which is why it
    reads as selected exactly when no status filter is active. Type filters
    are a separate axis and are deliberately left alone by it.
*@

<nav class="rst" aria-label="סינון לפי סטטוס">

    <button type="button"
            class="@TabClass(ActiveStatusFilters.Count == 0)"
            aria-pressed="@(ActiveStatusFilters.Count == 0)"
            @onclick="OnClearStatusFilters">
        הכל
    </button>

    <button type="button"
            class="@TabClass(IsPressed(RequestBuckets.WaitingFilterId))"
            aria-pressed="@IsPressed(RequestBuckets.WaitingFilterId)"
            @onclick="@(() => Select(RequestBuckets.WaitingFilterId))">
        דורש ממך פעולה
        @if (WaitingCount > 0)
        {
            <span class="rst-badge">@WaitingCount</span>
        }
    </button>

    <button type="button"
            class="@TabClass(IsPressed(RequestBuckets.LecturerFilterId))"
            aria-pressed="@IsPressed(RequestBuckets.LecturerFilterId)"
            @onclick="@(() => Select(RequestBuckets.LecturerFilterId))">
        בטיפול
    </button>

    <button type="button"
            class="@TabClass(IsPressed(RequestBuckets.DoneFilterId))"
            aria-pressed="@IsPressed(RequestBuckets.DoneFilterId)"
            @onclick="@(() => Select(RequestBuckets.DoneFilterId))">
        טופלו
    </button>

</nav>

@code {
    [Parameter, EditorRequired] public int WaitingCount  { get; set; }
    [Parameter, EditorRequired] public int LecturerCount { get; set; }
    [Parameter, EditorRequired] public int DoneCount     { get; set; }
    [Parameter, EditorRequired] public int TotalCount    { get; set; }

    /// <summary>The status half of the page's filter state — the same set the
    /// status dropdown writes to.</summary>
    [Parameter] public IReadOnlyCollection<string> ActiveStatusFilters { get; set; }
        = Array.Empty<string>();

    /// <summary>Raises one of the RequestBuckets.*FilterId constants.</summary>
    [Parameter] public EventCallback<string> OnSelectStatus { get; set; }

    [Parameter] public EventCallback OnClearStatusFilters { get; set; }

    private bool IsPressed(string id) => ActiveStatusFilters.Contains(id);

    private Task Select(string id) => OnSelectStatus.InvokeAsync(id);

    private static string TabClass(bool selected) =>
        selected ? "rst-tab rst-tab-active" : "rst-tab";
}
