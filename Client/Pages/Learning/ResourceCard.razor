@namespace AuthWithAdmin.Client.Pages.Learning

@*
    ResourceCard — the FINAL Resources screen's library card.
    Source: design-reference/motiva-student-final/Motiva Student Resources
    final.dc.html, the `cards` grid (one `<a>` per resource).

    Three rows, top to bottom:
        icon chip · type label ·· [stage pill] [★]
        title
        description (only when the lecturer wrote one)
        upload date ·· action verb ›

    WHY IT IS A div[role=button] AND NOT AN <a>
    The reference nests a <button> (the star) inside the card's <a>, which is
    invalid HTML — an interactive control inside a link. The card's job here is
    to OPEN THE DETAIL PANEL, not to navigate, so it is the same
    div[role=button] + keyboard handler shape MCard.Interactive already uses,
    and the star stays a real button inside it. The resource's real action
    (download / play / external link) lives on the panel, on a real <a>.
*@

@*  `motiva-cta-outline` on the SELECTED card only — the product's shared
    gradient-edge recipe (motiva-base.css, over --motiva-tag-brand-surface).
    It gives the open card a near-white interior and a Motiva edge at the
    radius it already has, which is what makes it findable on the grid behind
    the panel's scrim. No second gradient is declared anywhere for it, and it
    is deliberately NOT a solid violet border — that is the recurring bug the
    edge token exists to prevent.  *@
<div class="rc @(IsSelected ? "rc-selected motiva-cta-outline" : "")"
     role="button"
     tabindex="0"
     aria-label="@AriaLabel"
     @onclick="OpenAsync"
     @onkeydown="HandleKeyDownAsync">

    <div class="rc-top">
        @*  ── THE TYPE, AS ONE UNIT ──────────────────────────────────
            A gradient glyph and a compact outlined tag, read together.

            It was a 34px chip tinted with the resource's own accent hex
            beside that same hex as bold coloured text — so "Word" and
            "PDF" arrived as two differently-coloured objects saying one
            thing, and the loudest ink on the card belonged to its file
            format. The format is metadata; the title is the resource.

            The glyph now takes the shared #motivaIconGradient and the
            label the shared `.motiva-tag` (the gradient-EDGE recipe over
            --motiva-tag-brand-surface — the same object as a request-type
            pill and MStatusBadge's informational variants). Neither is a
            new colour and neither is a purple fill.

            18px, not 16: the sweep needs area to read as a sweep, and
            under about 12px it resolves as its own blue midpoint.  *@
        <span class="rc-typeunit">
            <span class="rc-icon motiva-ico-gradient" aria-hidden="true">
                <KnowledgeIcon Category="Resource.Category" Size="18" Gradient="true" />
            </span>
            <span class="rc-type motiva-tag">@Resource.TypeLabel</span>
        </span>

        <span class="rc-top-end">
            @if (Resource.HasMilestone)
            {
                <span class="rc-stage">@Resource.MilestoneLabel</span>
            }

            @* stopPropagation is load-bearing: starring must never open the panel. *@
            <button type="button"
                    class="rc-star @(IsFavorite ? "rc-star-on" : "")"
                    title="@FavTitle"
                    aria-label="@FavTitle"
                    aria-pressed="@IsFavorite"
                    @onclick="ToggleFavAsync"
                    @onclick:stopPropagation="true">
                <svg width="14" height="14" viewBox="0 0 24 24"
                     fill="@(IsFavorite ? "currentColor" : "none")"
                     stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"
                     aria-hidden="true" focusable="false">
                    <path d="m12 2.6 2.9 5.9 6.5.9-4.7 4.6 1.1 6.5L12 17.4l-5.8 3.1 1.1-6.5L2.6 9.4l6.5-.9Z"></path>
                </svg>
            </button>
        </span>
    </div>

    <div class="rc-body">
        <p class="rc-title">@Resource.Title</p>
        @if (!string.IsNullOrWhiteSpace(Resource.Description))
        {
            <p class="rc-desc">@Resource.Description</p>
        }
    </div>

    <div class="rc-foot">
        @* The reference's card foot names the resource's owner. ResourceFiles
           exposes no uploader on its DTO, so the slot carries the one piece of
           provenance the data does have — when it was published. Nothing is
           invented to fill it. *@
        <span class="rc-meta">@Resource.UploadedLabel</span>

        @if (Resource.ActionLabel.Length > 0)
        {
            @*  ── THE ACTION ─────────────────────────────────────────
                A secondary button: neutral ink, a hairline edge, a real
                hover. It was violet 600 text with a back-chevron after
                it, which put it in the same visual class as the type
                label it sat under — two purple metadata strings on one
                card, neither of which looked pressable.

                STILL A <span>, and on purpose. The whole card is the
                control (div[role=button]); a real <button> here would be
                a second focus stop for the identical action and would
                make the card announce twice. The verb is an affordance
                on one control, not a second one — which is also why it
                carries no click handler and why behaviour is unchanged.

                The chevron is replaced by the verb's own glyph, so
                הורדה, צפייה and פתיחה stop sharing one arrow that
                pointed at none of them.  *@
            <span class="rc-action">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                     aria-hidden="true" focusable="false">
                    @switch (Resource.Action)
                    {
                        case KnowledgeResourceAction.PlayVideo:
                            <path d="M7 4.5v15l12-7.5Z"></path>
                            break;

                        case KnowledgeResourceAction.External:
                            <path d="M14 4h6v6"></path>
                            <path d="M20 4 11 13"></path>
                            <path d="M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5"></path>
                            break;

                        default: // Download
                            <path d="M12 3.5v11"></path>
                            <path d="m7.5 10.5 4.5 4.5 4.5-4.5"></path>
                            <path d="M4.5 19.5h15"></path>
                            break;
                    }
                </svg>
                @Resource.ActionLabel
            </span>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public KnowledgeResource Resource { get; set; } = default!;

    [Parameter] public bool IsFavorite { get; set; }

    /// <summary>Highlighted while its detail panel is open.</summary>
    [Parameter] public bool IsSelected { get; set; }

    [Parameter] public EventCallback<KnowledgeResource> OnOpen { get; set; }

    [Parameter] public EventCallback<KnowledgeResource> OnToggleFavorite { get; set; }

    private string FavTitle => IsFavorite ? "הסרה מהמועדפים" : "הוספה למועדפים";

    private string AriaLabel => $"{Resource.Title} — פתיחת פרטי המשאב";

    private Task OpenAsync() =>
        OnOpen.HasDelegate ? OnOpen.InvokeAsync(Resource) : Task.CompletedTask;

    private Task ToggleFavAsync() =>
        OnToggleFavorite.HasDelegate ? OnToggleFavorite.InvokeAsync(Resource) : Task.CompletedTask;

    // role="button" carries no built-in activation, so Enter and Space are
    // wired by hand — the same contract MCard.Interactive implements.
    private async Task HandleKeyDownAsync(KeyboardEventArgs e)
    {
        if (e.Key is "Enter" or " " or "Spacebar") await OpenAsync();
    }
}
