@page "/learning"
@layout AppLayout
@using Microsoft.AspNetCore.Authorization
@using AuthWithAdmin.Shared.AuthSharedModels
@using AuthWithAdmin.Client.Services
@inject IResourceFilesService ResourceFilesService
@attribute [Authorize]

@*
    ── Student Knowledge Center (מרכז ידע) ──────────────────────────────────
    Visual source of truth: design-reference/motiva/project/Motiva Resources.dc.html
    Data source of truth:   GET api/student/resources (ResourceFiles)

    The Design's browse architecture is preserved exactly — ambient compact hero
    with the search field inside it, a four-card category grid, one category
    expanding into an attached panel of dense rows, and search replacing the
    whole browse body with flat cross-category results.

    What is NOT here, and why: the article/reader view, "נצפו לאחרונה",
    "צפייה נדרשת" / required badges, related resources, read time, and the
    embedded-form modal. Every one of them needs a field the domain does not
    have (body text, view tracking, a required flag, a form resource type), and
    none is simulated with localStorage or sample content.
*@

<div class="kc-header-bleed">
    <MPageHeader Variant="MPageHeader.HeaderVariant.Compact"
                 Class="kc-header"
                 Title="מרכז ידע"
                 Subtitle="כל הקבצים, המסמכים והסרטונים שהועמדו לרשותכם לאורך הפרויקט.">
        @if (!_loadError)
        {
            <MSearchField @bind-Value="_query"
                          MaxWidth="480px"
                          Placeholder="חיפוש קובץ, נושא או אבן דרך…"
                          AriaLabel="חיפוש במרכז הידע" />
        }
    </MPageHeader>
</div>

<div class="kc-body">

    @if (_isLoading)
    {
        <div class="kc-loading" role="status" aria-live="polite">
            <span class="kc-spinner" aria-hidden="true"></span>
            <span>טוענת את מרכז הידע…</span>
        </div>
    }
    else if (_loadError)
    {
        <MEmptyState Live="true"
                     Title="לא הצלחנו לטעון את מרכז הידע"
                     Description="ייתכן שיש תקלת רשת זמנית. אפשר לנסות שוב.">
            <Action>
                <MButton Variant="MButton.ButtonVariant.Secondary" OnClick="LoadAsync">
                    נסי שוב
                </MButton>
            </Action>
        </MEmptyState>
    }
    else if (_resources.Count == 0)
    {
        @* Global empty state — nothing has been published to any category yet. *@
        <MEmptyState Title="אין עדיין חומרים במרכז הידע"
                     Description="כשצוות הקורס יעלה מסמכים, מצגות או סרטונים, הם יופיעו כאן." />
    }
    else if (IsSearching)
    {
        @* ── SEARCH RESULTS — flat, category-labeled ── *@
        var results = Results;
        <section class="kc-results" aria-label="תוצאות חיפוש">
            <p class="kc-results-count" role="status" aria-live="polite">
                תוצאות עבור "@_query.Trim()" · @results.Count
            </p>

            @if (results.Count > 0)
            {
                <MCard Variant="MCard.CardVariant.AmbientEdge" Padding="MCard.CardPadding.None">
                    <MRowList Class="kc-reslist" AriaLabel="תוצאות חיפוש">
                        @foreach (var resource in results)
                        {
                            <KnowledgeResourceRow Resource="resource"
                                                  ShowCategory="true"
                                                  OnPlay="OpenVideo" />
                        }
                    </MRowList>
                </MCard>
            }
            else
            {
                <MEmptyState Live="true"
                             Title="לא נמצאו תוצאות"
                             Description="אפשר לנסות מונח אחר, או לנקות את החיפוש ולעיין בקטגוריות." />
            }
        </section>
    }
    else
    {
        @* ── BROWSE — category grid + attached panel ── *@
        <div class="kc-catgrid">
            @foreach (var category in KnowledgeCenterModel.Categories)
            {
                var key = category.Key;
                <KnowledgeCategoryCard Category="category"
                                       Count="CountIn(key)"
                                       IsOpen="_openCategory == key"
                                       PanelId="@PanelId"
                                       OnToggle="() => ToggleCategory(key)" />
            }
        </div>

        @if (_openCategory is { } openKey)
        {
            var items = ResourcesIn(openKey);
            <MCard Variant="MCard.CardVariant.AmbientEdge"
                   Padding="MCard.CardPadding.None"
                   Class="kc-panel">
                <div class="kc-panel-inner" id="@PanelId">
                    <div class="kc-panel-head">
                        <h2 class="kc-panel-title">@KnowledgeCenterModel.LabelFor(openKey)</h2>
                        <button type="button"
                                class="kc-panel-close"
                                aria-label="סגירת הקטגוריה"
                                @onclick="CloseCategory">
                            <span aria-hidden="true">✕</span>
                        </button>
                    </div>

                    @if (items.Count > 0)
                    {
                        <MRowList Class="kc-reslist" AriaLabel="@KnowledgeCenterModel.LabelFor(openKey)">
                            @foreach (var resource in items)
                            {
                                <KnowledgeResourceRow Resource="resource" OnPlay="OpenVideo" />
                            }
                        </MRowList>
                    }
                    else
                    {
                        @* The Design's own empty-category line, verbatim. *@
                        <p class="kc-panel-empty">אין עדיין משאבים בקטגוריה הזו.</p>
                    }
                </div>
            </MCard>
        }
    }

</div>

@* ── Video modal ──────────────────────────────────────────────────────────
   The Design has no player at all; the app does, and real playback is
   preserved. A modal rather than an inline iframe per row keeps the dense
   list intact. *@
<MModal IsOpen="_playing is not null"
        Title="@(_playing?.Title)"
        Size="MModal.ModalSize.Large"
        Class="kc-video-modal"
        OnClose="CloseVideo">
    @if (_playing is not null)
    {
        var embed = KnowledgeCenterModel.ToEmbedUrl(_playing.VideoUrl);
        if (embed is not null)
        {
            <div class="kc-video-frame">
                <iframe src="@embed"
                        title="@_playing.Title"
                        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                        allowfullscreen></iframe>
            </div>
        }
        else
        {
            @* Not a recognisable YouTube URL — fall back to opening it safely. *@
            <MEmptyState Title="הסרטון אינו זמין להצגה כאן"
                         Description="אפשר לפתוח אותו במקור בכרטיסייה חדשה.">
                <Action>
                    <a class="kc-video-external"
                       href="@_playing.VideoUrl"
                       target="_blank"
                       rel="noopener noreferrer">
                        פתיחה בכרטיסייה חדשה ↗
                    </a>
                </Action>
            </MEmptyState>
        }
    }
</MModal>

@code {
    private const string PanelId = "kc-category-panel";

    private bool _isLoading = true;
    private bool _loadError;

    private List<KnowledgeResource> _resources = new();
    private KnowledgeCategoryKey?   _openCategory;
    private KnowledgeResource?      _playing;

    private string _query = "";

    private bool IsSearching => !string.IsNullOrWhiteSpace(_query);

    private List<KnowledgeResource> Results =>
        KnowledgeCenterModel.Search(_resources, _query);

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _isLoading = true;
        _loadError = false;
        StateHasChanged();

        // Same endpoint the (unchanged) /files page reads. Nothing on the
        // server, in the DTO or in the SQL is touched by this phase.
        var files = await ResourceFilesService.GetPublicAsync();

        _loadError = files is null;
        _resources = files is null
            ? new()
            : KnowledgeCenterModel.ToResources(files);

        _isLoading = false;
    }

    private int CountIn(KnowledgeCategoryKey key) =>
        _resources.Count(r => r.Category == key);

    private List<KnowledgeResource> ResourcesIn(KnowledgeCategoryKey key) =>
        _resources.Where(r => r.Category == key).ToList();

    // One category open at a time — the Design's own toggle semantics.
    private void ToggleCategory(KnowledgeCategoryKey key) =>
        _openCategory = _openCategory == key ? null : key;

    private void CloseCategory() => _openCategory = null;

    private void OpenVideo(KnowledgeResource resource) => _playing = resource;

    private void CloseVideo() => _playing = null;
}
