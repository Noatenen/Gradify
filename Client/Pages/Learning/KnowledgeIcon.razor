@namespace AuthWithAdmin.Client.Pages.Learning

@*
    KnowledgeIcon — the four category glyphs, lifted verbatim from the
    finalized Knowledge Center (Motiva Resources.dc.html):

      Documents → the file-with-lines glyph (cat.isDocs, :186-188)
      Videos    → the play triangle          (cat.isVideos, :195-197)
      Slides    → the stacked-frames glyph   (cat.isTemplates, :183-185)
      Images    → the picture glyph          (cat.isExamples, :198-200)

    One component rather than two copies because the category card (18px)
    and the resource row (16px) draw the same glyph at two sizes — the
    Design does exactly this too, with parallel sc-if blocks in both places.

    Inline SVG, not "oi": the Master specifies "thin outline (stroke
    ~1.6-2px), rounded joins, single weight, 14-16px. No emoji, no filled
    icons" — open-iconic is a solid icon font and reads visibly heavier.
    Colour comes from currentColor so the caller's accent drives it.
*@

<svg width="@Size" height="@Size" viewBox="0 0 24 24" fill="none"
     stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
     aria-hidden="true" focusable="false">
    @switch (Category)
    {
        case KnowledgeCategoryKey.Videos:
            <polygon points="6 3 20 12 6 21 6 3"></polygon>
            break;

        case KnowledgeCategoryKey.Slides:
            <rect x="8" y="8" width="12" height="12" rx="2"></rect>
            <path d="M4 16V4a2 2 0 0 1 2-2h10"></path>
            break;

        case KnowledgeCategoryKey.Images:
            <rect x="3" y="3" width="18" height="18" rx="2"></rect>
            <circle cx="8.5" cy="8.5" r="1.5"></circle>
            <path d="m21 15-5-5L5 21"></path>
            break;

        default: // Documents
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8Z"></path>
            <polyline points="14 2 14 8 20 8"></polyline>
            <line x1="8" y1="13" x2="16" y2="13"></line>
            <line x1="8" y1="17" x2="16" y2="17"></line>
            break;
    }
</svg>

@code {
    [Parameter, EditorRequired] public KnowledgeCategoryKey Category { get; set; }

    /// <summary>Edge length in px. 18 on category cards, 16 in resource rows —
    /// both Design values.</summary>
    [Parameter] public int Size { get; set; } = 16;
}
