@namespace AuthWithAdmin.Client.Pages.ProjectWorkspace
@using AuthWithAdmin.Shared.AuthSharedModels
@using AuthWithAdmin.Client.Services
@using AuthWithAdmin.Client.Components
@using AuthWithAdmin.Client.Pages.Learning
@inject IProjectWorkspaceService Workspace
@inject IResourceFilesService ResourceFilesService

@*
    SubmissionDeliverablesSection — "תוצרי ההגשה"

    ONE PANEL, TWO INTERNAL STATES — and the panel is the same size in both.

      LIST     — the eight categories as compact rows.
      DETAIL   — one category's content, in the SAME place, reached by clicking
                 a row and left by the back action at its top.

    The swap happens inside `.pws-body`, which has a fixed height and scrolls
    (see the .razor.css). That is what makes the promise "selecting a
    deliverable changes nothing outside this panel" literally true: the panel's
    intrinsic height does not depend on which state it is in, so the workspace
    row, the card beside it and משאבי הפרויקט below it cannot move on a click.

    THREE EARLIER SHAPES ARE GONE and should not come back:
      * an accordion body INSIDE the tile — opening one made that grid item
        span all four columns and shove the other seven down the page;
      * a 62/38 master-detail split that re-flowed the grid on selection;
      * a floating fixed drawer (`.pws-drawer`) over the page — which did keep
        the grid still, but at the cost of an overlay this page never wanted,
        a viewport-anchored surface that scrolled away from its own list, and a
        bottom-sheet variant for narrow screens.
    The list and the detail now occupy one region, one at a time.

    ── WHERE A STATUS COMES FROM ─────────────────────────────────────────────
    NOT from a control the student moves through three positions. See
    ProjectWorkspaceModel.DeriveDeliverableStatus for the full rule; in short:

      הושלם    ProjectSubmissionStatuses says 'Done' — the team's own
               completion record, and the ONLY state anybody declares.
      בעבודה   at least one ProjectResource carries this deliverable's key —
               real, persisted evidence of work — or a legacy 'InProgress' row
               written back when that state was set by hand.
      לא התחיל neither.

    So a team that adds "דף מידע – טיוטה" to משאבי הפרויקט and associates it
    with דף מידע sees that deliverable move to בעבודה by itself. The count above
    the list is unaffected: it reads 'Done' only.

    Two independent halves remain, deliberately:
      CONTENT  — the course's submission guidance, from
                 SubmissionDeliverablesCatalog. Static, because the guidance has
                 no authoring UI and no table behind it anywhere in this
                 repository. A category that genuinely has no guidance says so
                 inside itself, where it is true of the thing it is attached to.
      PROGRESS — real and persisted: ProjectSubmissionStatuses for the
                 completion record, ProjectResources for the artifacts.

    Statuses that fail to load do NOT hide the guidance: the categories still
    render, with a line saying progress is unavailable.

    Documents come from the REAL Knowledge Center (ResourceFiles), matched by
    title, and are omitted entirely when a category has no match — the page
    never invents a URL.
*@

<MCard Padding="MCard.CardPadding.None" Fill="true">
<section class="pws" aria-labelledby="pws-heading">

    @* THE HEAD DOES NOT SWAP. It names the panel and states the one number
       that is true of all eight categories, so it stays put while the body
       below it changes between the list and one deliverable — which is also
       what stops the top of the panel from jumping on selection. *@
    <div class="pws-head">
        <div class="pws-headtext">
            <h2 class="pws-heading" id="pws-heading">תוצרי ההגשה</h2>
            <p class="pws-sub">כל מה שנדרש להגשת פרויקט הגמר, לפי דרישות הסגל</p>
        </div>

        @if (!_statusLoadFailed)
        {
            <span class="pws-count">@DoneCount מתוך @TotalCount הושלמו</span>
        }
    </div>

    @if (!_statusLoadFailed)
    {
        @* DONE ONLY, never בעבודה — see requirement 6. The bar reads exactly
           what the count beside the heading reads. *@
        <MProgressBar Value="DoneCount"
                      Max="TotalCount"
                      Size="MProgressBar.ProgressSize.Small"
                      Class="pws-progress"
                      AccessibleLabel="התקדמות בתוצרי ההגשה" />
    }
    else
    {
        <p class="pws-note pws-note-error" role="status">
            לא הצלחנו לטעון את התקדמות ההגשה. הדרישות מוצגות, ושינוי מצב לא יישמר.
        </p>
    }

    @*
        THE SWAPPING REGION.

        Fixed height, scrolls inside itself, and holds exactly one of the two
        states. Keyed on the selection so Blazor REPLACES the subtree rather
        than re-parameterising it — without the key, switching from one
        deliverable to another reuses the same component instance, the
        entrance animation does not replay, and the change reads as nothing
        having happened.
    *@
    <div class="pws-body">
        @if (SelectedDeliverable is { } selected)
        {
            <SubmissionDeliverableDetail @key="selected.Key"
                                         Deliverable="selected"
                                         Status="@StatusOf(selected.Key)"
                                         Artifacts="ArtifactsFor(selected.Key)"
                                         Documents="DocumentsFor(selected)"
                                         Saving="_savingKey == selected.Key"
                                         CanWrite="!_statusLoadFailed"
                                         OnStatusChange="value => SetStatusAsync(selected.Key, value)"
                                         OnBack="ClearSelection" />
        }
        else
        {
            <div class="pws-list">
                @foreach (var deliverable in SubmissionDeliverablesCatalog.All)
                {
                    var captured = deliverable;
                    <SubmissionDeliverableRow Deliverable="captured"
                                              Status="@StatusOf(captured.Key)"
                                              ArtifactCount="ArtifactsFor(captured.Key).Count"
                                              Documents="DocumentsFor(captured)"
                                              OnSelect="() => Select(captured.Key)" />
                }
            </div>
        }
    </div>

    @if (_statusError is not null)
    {
        <p class="pws-note pws-note-error" role="alert">@_statusError</p>
    }

</section>
</MCard>

@code {
    /// <summary>
    /// The team's own resources, owned and loaded by ProjectWorkspacePage.
    ///
    /// <para>Read-only here, and read for ONE reason: a resource that carries a
    /// deliverable's key is the evidence that derives "בעבודה". The section
    /// never writes them — משאבי הפרויקט at the foot of the page does — which
    /// is why an add or an edit down there is reflected up here immediately,
    /// through the page's single list.</para>
    /// </summary>
    [Parameter] public IReadOnlyList<ProjectResourceDto> Resources { get; set; }
        = Array.Empty<ProjectResourceDto>();

    /// <summary>Status per catalog key. A key with no entry is "not started" —
    /// the server stores a row only once a team touches a category.</summary>
    private Dictionary<string, string> _statuses = new(StringComparer.Ordinal);

    /// <summary>Knowledge Center resources, indexed by title, for the
    /// documents block. Empty when the load fails — a category then simply
    /// renders no documents, which is the same honest result as having none.</summary>
    private Dictionary<string, KnowledgeResource> _resourcesByTitle =
        new(StringComparer.OrdinalIgnoreCase);

    /// <summary>The deliverable the body is showing, or null for the list.
    /// Exactly one, which is what guarantees the two states can never both be
    /// on screen.</summary>
    private string? _selectedKey;

    private string? _savingKey;
    private string? _statusError;
    private bool    _statusLoadFailed;

    private int TotalCount => SubmissionDeliverablesCatalog.All.Count;

    /// <summary>
    /// COMPLETED ONLY. A deliverable in בעבודה is not counted, whether that
    /// state was inferred from an artifact or read from a legacy row — the
    /// count answers "how many are finished", and the progress bar under the
    /// head reads the same number.
    /// </summary>
    private int DoneCount =>
        SubmissionDeliverablesCatalog.All
            .Count(d => StatusOf(d.Key) == SubmissionStatusValues.Done);

    protected override async Task OnInitializedAsync()
    {
        var statuses = await Workspace.GetSubmissionProgressAsync();

        _statusLoadFailed = statuses is null;

        if (statuses is not null)
        {
            _statuses = statuses
                .Where(s => !string.IsNullOrWhiteSpace(s.DeliverableKey))
                .GroupBy(s => s.DeliverableKey, StringComparer.Ordinal)
                .ToDictionary(g => g.Key, g => g.Last().Status, StringComparer.Ordinal);
        }

        // The same endpoint the Knowledge Center and the dashboard's
        // recommendations already read, and the same classification, so a file
        // is described identically everywhere it appears.
        var files = await ResourceFilesService.GetPublicAsync();

        if (files is not null)
        {
            foreach (var resource in KnowledgeCenterModel.ToResources(files))
            {
                _resourcesByTitle[resource.Title] = resource;
            }
        }
    }

    /// <summary>What the team has actually recorded for this category, or null
    /// when it has never touched it. The raw value — the DISPLAYED state is
    /// <see cref="StatusOf"/>.</summary>
    private string? DeclaredStatusOf(string key) =>
        _statuses.TryGetValue(key, out var value) && SubmissionStatusValues.IsValid(value)
            ? value
            : null;

    /// <summary>The state to show: the declared record and the real artifacts,
    /// resolved by one shared rule so the row and the detail panel can never
    /// disagree.</summary>
    private string StatusOf(string key) =>
        ProjectWorkspaceModel.DeriveDeliverableStatus(
            DeclaredStatusOf(key), ArtifactsFor(key).Count);

    /// <summary>
    /// The team's work artifacts for one category, matched on the STORED KEY —
    /// never on the resource's label or its URL. A filename that happens to
    /// contain "פוסטר" is not an association; ProjectResources.DeliverableKey
    /// is.
    /// </summary>
    private IReadOnlyList<ProjectResourceDto> ArtifactsFor(string key) =>
        Resources
            .Where(r => string.Equals(r.DeliverableKey, key, StringComparison.Ordinal))
            .ToList();

    /// <summary>Resolves a category's declared resource titles against what the
    /// Knowledge Center actually holds. An unmatched title is dropped silently:
    /// a document that is not there must not become a broken chip.</summary>
    private IReadOnlyList<KnowledgeResource> DocumentsFor(SubmissionDeliverable deliverable)
    {
        if (deliverable.ResourceTitles.Count == 0) return Array.Empty<KnowledgeResource>();

        var found = new List<KnowledgeResource>(deliverable.ResourceTitles.Count);

        foreach (var title in deliverable.ResourceTitles)
        {
            if (_resourcesByTitle.TryGetValue(title, out var resource)) found.Add(resource);
        }

        return found;
    }

    private SubmissionDeliverable? SelectedDeliverable =>
        _selectedKey is null
            ? null
            : SubmissionDeliverablesCatalog.All.FirstOrDefault(d => d.Key == _selectedKey);

    // A row OPENS a deliverable and the back action CLOSES it. Not a toggle:
    // in a master/detail panel the row you clicked is not on screen any more,
    // so "click it again to close" is not an interaction anybody can perform.
    private void Select(string key) => _selectedKey = key;

    private void ClearSelection() => _selectedKey = null;

    // NOTHING SCROLLS THE PAGE HERE, deliberately.
    //
    // Selecting used to call `gradify.scrollIntoView` from OnAfterRenderAsync,
    // which was right while the details opened BELOW the whole grid and could
    // land off-screen. The detail now replaces the list in a region that is
    // already where the eye is, so the call had nothing left to do except move
    // the page ~95px on every click. It, its pending flag and this component's
    // IJSRuntime dependency are gone rather than kept for a case that no
    // longer exists.

    /// <summary>
    /// Writes the team's completion record — 'Done', or 'NotStarted' to undo it.
    ///
    /// <para>'InProgress' is never written any more: that state is derived from
    /// the artifacts associated with the deliverable, so a control that set it
    /// by hand would be a second, competing source for the same fact. Rows that
    /// already hold it are still read (see DeriveDeliverableStatus).</para>
    /// </summary>
    private async Task SetStatusAsync(string key, string status)
    {
        if (!SubmissionStatusValues.IsValid(status)) return;
        if (DeclaredStatusOf(key) == status) return;

        var previous = _statuses.TryGetValue(key, out var existing) ? existing : null;

        // Optimistic, then rolled back on failure: the control has to respond
        // immediately to be usable, and the count and the progress bar above
        // read from the same dictionary, so all three move together either way.
        _statuses[key] = status;
        _savingKey     = key;
        _statusError   = null;

        var ok = await Workspace.SetSubmissionStatusAsync(key, status);

        _savingKey = null;

        if (!ok)
        {
            if (previous is null) _statuses.Remove(key);
            else                  _statuses[key] = previous;

            _statusError = "עדכון מצב התוצר נכשל. נסי שנית.";
        }
    }
}
