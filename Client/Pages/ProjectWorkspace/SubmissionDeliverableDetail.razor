@namespace AuthWithAdmin.Client.Pages.ProjectWorkspace
@using AuthWithAdmin.Shared.AuthSharedModels
@using AuthWithAdmin.Client.Components
@using AuthWithAdmin.Client.Pages.Learning

@*
    SubmissionDeliverableDetail — one deliverable, drawn IN PLACE OF the list
    inside תוצרי ההגשה's own panel.

    It is not a drawer, not a modal and not a panel below a grid. Those were
    the three earlier attempts, in that order, and each of them existed to stop
    the list from moving when something opened. Replacing the list inside a
    fixed-height region removes the problem instead of working around it: there
    is nothing to move, because the list is not on screen.

    ONE COLUMN. The two-column arrangement it had came from being full width,
    where the content ran ~450px down a 1560px panel with most of it empty. In
    a 43% column there is no second column to have, and the blocks read in the
    order the work happens: what it is → what it requires → what the faculty
    added → what the team has made → where it stands.

    Nothing here is padded to a minimum height. A category with one line of
    intro and two requirements is exactly that tall, and the region it sits in
    scrolls when it is taller than the panel.
*@

<section class="pwv" id="@PanelId" role="region" aria-label="@($"פרטי {Deliverable.Title}")">

    @* THE WAY BACK, first and on its own line — the one control that is always
       in the same place whichever deliverable is open. The arrow points to the
       reading start (right, in this RTL shell), which is the direction the
       list is in. *@
    <button type="button" class="pwv-back motiva-cta-outline" @onclick="() => OnBack.InvokeAsync()">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor"
             stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M9 6l6 6-6 6"></path>
        </svg>
        <span>חזרה לתוצרי ההגשה</span>
    </button>

    <div class="pwv-head">
        @* The same mark the row shows, at the same treatment — it is what
           tells you at a glance which row this is. *@
        <span class="pwv-icon motiva-ico-gradient" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none"
                 stroke="url(#motivaIconGradient)"
                 stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="@Deliverable.IconPath"></path>
            </svg>
        </span>

        <div class="pwv-headtext">
            <h3 class="pwv-title">@Deliverable.Title</h3>
            @if (!string.IsNullOrWhiteSpace(MetaLine))
            {
                <p class="pwv-meta">@MetaLine</p>
            }
        </div>
    </div>

    @*
        PER-DELIVERABLE EMPTY STATE, never a banner.

        A category with no intro, no requirements, no notes and no matched
        documents would otherwise open onto nothing but its status block, which
        reads as a broken panel rather than as "the faculty has not published
        this yet". One quiet line says the true thing, about the one deliverable
        it is true of.

        The status block below is NOT part of this: it is real and persisted
        whether or not any guidance exists, so it renders either way.
    *@
    @if (!HasGuidance)
    {
        <p class="pwv-empty">טרם נוספו הנחיות</p>
    }

    @if (!string.IsNullOrWhiteSpace(Deliverable.Intro))
    {
        <p class="pwv-intro">@Deliverable.Intro</p>
    }

    @if (Deliverable.Requirements.Count > 0)
    {
        <div class="pwv-block">
            <p class="pwv-blocklabel">@Deliverable.RequirementsLabel</p>
            <ul class="pwv-reqs">
                @foreach (var requirement in Deliverable.Requirements)
                {
                    <li class="pwv-req">
                        <span class="pwv-bullet" aria-hidden="true"></span>
                        <span class="pwv-reqtext">@requirement</span>
                    </li>
                }
            </ul>
        </div>
    }

    @if (Deliverable.Notes.Count > 0)
    {
        @* Neutral informational surface, NOT amber (which would be a fourth
           semantic colour) and NOT rose (which would read as an error on an
           ordinary note). The hierarchy is carried by the quiet fill, the
           hairline and the label weight. *@
        <div class="pwv-callout" aria-label="לתשומת לבכם">
            <p class="pwv-calloutlabel">לתשומת לבכם</p>
            @foreach (var note in Deliverable.Notes)
            {
                <p class="pwv-note">@note</p>
            }
        </div>
    }

    @if (Documents.Count > 0)
    {
        @* COURSE MATERIAL — real Knowledge Center resources only, see the
           catalog's ResourceTitles note. Each chip follows the resource's own
           action (download / external / video), exactly as the Knowledge
           Center rows do, and never exposes a raw URL. *@
        <div class="pwv-block">
            <p class="pwv-blocklabel">מסמכים והנחיות</p>
            <div class="pwv-docs">
                @foreach (var doc in Documents)
                {
                    var captured = doc;

                    if (captured.Action == KnowledgeResourceAction.External)
                    {
                        <a class="pwv-doc"
                           href="@captured.Href"
                           target="_blank"
                           rel="noopener noreferrer">
                            @DocIcon
                            <span class="pwv-doclabel">@captured.Title</span>
                        </a>
                    }
                    else if (captured.Action == KnowledgeResourceAction.Download)
                    {
                        <a class="pwv-doc"
                           href="@captured.Href"
                           download="@captured.DownloadName">
                            @DocIcon
                            <span class="pwv-doclabel">@captured.Title</span>
                        </a>
                    }
                    else if (captured.Action == KnowledgeResourceAction.PlayVideo)
                    {
                        <a class="pwv-doc"
                           href="@captured.VideoUrl"
                           target="_blank"
                           rel="noopener noreferrer">
                            @DocIcon
                            <span class="pwv-doclabel">@captured.Title</span>
                        </a>
                    }
                }
            </div>
        </div>
    }

    @*
        ── THE TEAM'S OWN WORK ───────────────────────────────────────────────
        The resources from משאבי הפרויקט that carry this deliverable's key.

        This block is the visible half of the status rule: these rows ARE the
        evidence that puts the deliverable in "בעבודה", so the state and its
        reason are on screen together and the student never has to guess why
        it says what it says. The empty case says where the association is
        made, because that is the only actionable thing about it.
    *@
    <div class="pwv-block">
        <p class="pwv-blocklabel">חומרי העבודה של הצוות</p>

        @if (Artifacts.Count > 0)
        {
            <div class="pwv-arts">
                @foreach (var artifact in Artifacts)
                {
                    var captured = artifact;
                    <a class="pwv-art"
                       href="@captured.Url"
                       target="_blank"
                       rel="noopener noreferrer"
                       title="@captured.Url">
                        <span class="pwv-art-icon motiva-ico-gradient" aria-hidden="true">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
                                 stroke="url(#motivaIconGradient)" stroke-width="1.6"
                                 stroke-linecap="round" stroke-linejoin="round">
                                <path d="@ProjectResourceKinds.IconPath(ProjectResourceKinds.Detect(captured.Url))"></path>
                            </svg>
                        </span>
                        <span class="pwv-art-text">
                            <span class="pwv-art-label">@captured.Label</span>
                            <span class="pwv-art-kind">
                                @ProjectResourceKinds.Label(ProjectResourceKinds.Detect(captured.Url))
                            </span>
                        </span>
                    </a>
                }
            </div>
        }
        else
        {
            <p class="pwv-hint">
                עדיין אין חומרים שמשויכים לתוצר הזה. אפשר לשייך משאב לתוצר במשאבי הפרויקט,
                בתחתית העמוד — וברגע שיש חומר משויך, התוצר יסומן אוטומטית כ"בעבודה".
            </p>
        }
    </div>

    @*
        ── WHERE IT STANDS ───────────────────────────────────────────────────
        A DERIVED state and ONE act, not a three-position control.

        The segmented control that used to be here let a student set "בעבודה"
        by hand — a value the system can now see for itself, and a second
        source for the same fact. What is left is the one thing only a person
        can know: whether the deliverable is finished. Everything else is read
        from ProjectSubmissionStatuses and ProjectResources.

        The line under the state says WHERE the state came from, so nothing
        about it is mysterious.
    *@
    <div class="pwv-state">
        <div class="pwv-statetext">
            <span class="pwv-statelabel">מצב התוצר</span>
            <span class="pwv-status @($"pwv-status-{StatusTone}")">
                <span class="pwv-dot" aria-hidden="true"></span>
                <span class="pwv-statustext">@StatusLabel</span>
            </span>
            <p class="pwv-statewhy">@StatusExplanation</p>
        </div>

        @if (CanWrite)
        {
            @if (Status == SubmissionStatusValues.Done)
            {
                <MButton Variant="MButton.ButtonVariant.Secondary"
                         Size="MButton.ButtonSize.Small"
                         Loading="Saving"
                         LoadingText="שומרת…"
                         OnClick="() => OnStatusChange.InvokeAsync(SubmissionStatusValues.NotStarted)">
                    ביטול סימון ההשלמה
                </MButton>
            }
            else
            {
                <MButton Variant="MButton.ButtonVariant.Primary"
                         Size="MButton.ButtonSize.Small"
                         Loading="Saving"
                         LoadingText="שומרת…"
                         OnClick="() => OnStatusChange.InvokeAsync(SubmissionStatusValues.Done)">
                    סימון כהושלם
                </MButton>
            }
        }
    </div>

</section>

@code {
    /// <summary>The detail region's id. A constant rather than a
    /// per-deliverable one because there is exactly ONE detail region, and
    /// which deliverable it is showing is the selection, not the identity of
    /// the region. Private now that nothing outside points at it — the list
    /// rows used to carry `aria-controls` while they were disclosure buttons,
    /// which they are not any more.</summary>
    private const string PanelId = "pws-detail";

    [Parameter, EditorRequired] public SubmissionDeliverable Deliverable { get; set; } = default!;

    /// <summary>The DERIVED status (one of SubmissionStatusValues), resolved by
    /// the section — never recomputed here.</summary>
    [Parameter] public string Status { get; set; } = SubmissionStatusValues.NotStarted;

    /// <summary>The team's resources associated with this deliverable. Empty is
    /// a real state with its own line, not a hidden block: it is the reason the
    /// deliverable reads "לא התחיל".</summary>
    [Parameter] public IReadOnlyList<ProjectResourceDto> Artifacts { get; set; }
        = Array.Empty<ProjectResourceDto>();

    /// <summary>Knowledge Center resources this category resolved to. Empty
    /// means the documents block is not rendered at all.</summary>
    [Parameter] public IReadOnlyList<KnowledgeResource> Documents { get; set; } = Array.Empty<KnowledgeResource>();

    /// <summary>True while this deliverable's status write is in flight.</summary>
    [Parameter] public bool Saving { get; set; }

    /// <summary>False when the progress read failed — the state is still shown
    /// (the artifacts are real either way), but the completion action is
    /// withheld rather than offering a write that cannot be trusted to
    /// round-trip.</summary>
    [Parameter] public bool CanWrite { get; set; } = true;

    [Parameter] public EventCallback<string> OnStatusChange { get; set; }
    [Parameter] public EventCallback OnBack { get; set; }

    /// <summary>Whether this category has any published guidance at all —
    /// intro, requirements, notes or a resolved document. False means the empty
    /// line renders instead of nothing.</summary>
    private bool HasGuidance =>
        !string.IsNullOrWhiteSpace(Deliverable.Intro)
        || Deliverable.Requirements.Count > 0
        || Deliverable.Notes.Count > 0
        || Documents.Count > 0;

    private string MetaLine =>
        SubmissionDeliverablesCatalog.MetaLine(Deliverable, Documents.Count, Artifacts.Count);

    private string StatusLabel => ProjectWorkspaceModel.DeliverableStatusLabel(Status);
    private string StatusTone  => ProjectWorkspaceModel.DeliverableStatusTone(Status);

    /// <summary>
    /// One sentence naming the actual source of the state on screen. The four
    /// cases are the four branches of DeriveDeliverableStatus, in the same
    /// order — including the legacy one, so a hand-set "בעבודה" from before the
    /// association existed does not silently claim there are artifacts.
    /// </summary>
    private string StatusExplanation => Status switch
    {
        SubmissionStatusValues.Done => "הצוות סימן את התוצר כהושלם.",

        SubmissionStatusValues.InProgress when Artifacts.Count == 1 =>
            "נקבע אוטומטית: חומר עבודה אחד משויך לתוצר.",

        SubmissionStatusValues.InProgress when Artifacts.Count > 1 =>
            $"נקבע אוטומטית: {Artifacts.Count} חומרי עבודה משויכים לתוצר.",

        // InProgress with no artifacts — a row written by hand before the
        // association existed.
        SubmissionStatusValues.InProgress => "התוצר סומן בעבר כנמצא בעבודה.",

        _ => "נקבע אוטומטית: אין חומרי עבודה משויכים והתוצר לא סומן כהושלם."
    };

    private readonly RenderFragment DocIcon = @<svg width="13" height="13" viewBox="0 0 24 24" fill="none"
                                                    stroke="currentColor" stroke-width="1.7"
                                                    stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M7 3h7l5 5v13H7zM10 12h7M10 16h5"></path>
    </svg>;
}
