@namespace AuthWithAdmin.Client.Pages.ProjectWorkspace
@using AuthWithAdmin.Shared.AuthSharedModels
@using AuthWithAdmin.Client.Components
@using AuthWithAdmin.Client.Pages.Learning

@*
    SubmissionDeliverableRow — one submission category as a COMPACT LIST ROW.

    It is a master-list entry and nothing else: clicking it replaces the list
    with that deliverable's details inside the same panel
    (SubmissionDeliverablesSection). Nothing opens here, so there is no
    expanded state, no body, and no size the row can grow to.

    THE SHAPE IT REPLACES. This was a ~120px card in a four-column grid, built
    when תוצרי ההגשה was a full-width section: a mark on its own line, the
    title under it, the meta under that and a foot row with the status and a
    chevron. In a 43%-wide panel that grid is two columns of tall cards and
    eight of them do not fit in the panel's body. A row states the same four
    facts along ONE line at about 52px, so all eight are visible at once —
    which is the whole point of a master list.

    ONE <button>, so the click target, the keyboard activation and the focus
    ring are the browser's rather than something re-implemented on a div. Not
    `aria-expanded`: nothing expands. The chevron points along the reading
    direction to say "this opens something", the way a navigation row does.

    (The reason that note is up here rather than beside the attributes: a Razor
    comment placed BETWEEN an element's attributes builds clean and then throws
    at render as an unknown component parameter.)
*@

<button type="button"
        class="pwd"
        @onclick="() => OnSelect.InvokeAsync()">

    @* The semantic mark — the shared #motivaIconGradient paint server with no
       chip, at 22px: large enough for the sweep to read as all three hues,
       small enough to sit on one line with the text. *@
    <span class="pwd-icon motiva-ico-gradient" aria-hidden="true">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none"
             stroke="url(#motivaIconGradient)"
             stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="@Deliverable.IconPath"></path>
        </svg>
    </span>

    <span class="pwd-text">
        <span class="pwd-title">@Deliverable.Title</span>
        @if (!string.IsNullOrWhiteSpace(MetaLine))
        {
            <span class="pwd-meta">@MetaLine</span>
        }
    </span>

    @* STATUS: a 7px dot and a word, never a pill.

       Eight bordered, filled chips — most of them reading the same word — put
       the emphasis on the fact that a status EXISTS rather than on what it is.
       This is MStatusDot's own inline pattern, rebuilt under this component's
       prefix because that component's DotTone enum is deliberately closed to
       the Master's three semantic colours and "לא התחיל" is none of them: it
       is the ABSENCE of a status, and the Master's answer to that is neutral
       ink, not a fourth hue. The dot sizes and the violet and teal values are
       transcribed from MStatusDot.razor.css so the two cannot drift. *@
    <span class="pwd-status @($"pwd-status-{StatusTone}")">
        <span class="pwd-dot" aria-hidden="true"></span>
        <span class="pwd-statustext">@StatusLabel</span>
    </span>

    @* Points along the reading direction (left in this RTL shell) — "opens".
       Rotated by a logical transform in the CSS rather than drawn twice. *@
    <span class="pwd-chevron" aria-hidden="true">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
             stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
            <path d="M15 6l-6 6 6 6"></path>
        </svg>
    </span>

</button>

@code {
    [Parameter, EditorRequired] public SubmissionDeliverable Deliverable { get; set; } = default!;

    /// <summary>The DERIVED status (one of SubmissionStatusValues) — see
    /// ProjectWorkspaceModel.DeriveDeliverableStatus. The row never computes it
    /// itself; the section resolves it once so the list and the detail panel
    /// cannot show two different answers for the same deliverable.</summary>
    [Parameter] public string Status { get; set; } = SubmissionStatusValues.NotStarted;

    /// <summary>How many of the team's resources are associated with this
    /// deliverable. Shown in the meta line, where it is the visible reason a
    /// row reads "בעבודה".</summary>
    [Parameter] public int ArtifactCount { get; set; }

    /// <summary>Knowledge Center resources this category resolved to. Used here
    /// only for the meta line's document count; the chips themselves belong to
    /// the detail panel.</summary>
    [Parameter] public IReadOnlyList<KnowledgeResource> Documents { get; set; } = Array.Empty<KnowledgeResource>();

    [Parameter] public EventCallback OnSelect { get; set; }

    private string MetaLine =>
        SubmissionDeliverablesCatalog.MetaLine(Deliverable, Documents.Count, ArtifactCount);

    private string StatusLabel => ProjectWorkspaceModel.DeliverableStatusLabel(Status);

    /// <summary>
    ///     לא התחיל  →  neutral dot  +  muted ink
    ///     בעבודה    →  violet dot   +  ordinary ink   (the dot carries the
    ///                                                  brand; the label does
    ///                                                  not need to be purple)
    ///     הושלם     →  teal dot     +  teal ink       (the one state worth
    ///                                                  reading in colour)
    /// </summary>
    private string StatusTone => ProjectWorkspaceModel.DeliverableStatusTone(Status);
}
