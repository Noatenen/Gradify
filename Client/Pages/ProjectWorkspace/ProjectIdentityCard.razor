@namespace AuthWithAdmin.Client.Pages.ProjectWorkspace
@using AuthWithAdmin.Shared.AuthSharedModels
@using AuthWithAdmin.Client.Services
@using AuthWithAdmin.Client.Components

@*
    ProjectIdentityCard — the identity block of מרחב הפרויקט.

    Structural reference: design-reference/project-details/project/Motiva
    Project Details.dc.html:93-152. Visual language: the already-shipped
    student cards (StudentProfilePersonalCard / StudentProfileTeamCard) —
    MCard AmbientEdge with Padding.None and this component owning its own
    inset, exactly as those two do.

    THIS CARD IS READ-ONLY.
    ───────────────────────
    It used to swap itself into a form. That is gone: "עריכת פרטים" now opens
    <ProjectIdentityEditModal>, and nothing on this surface has an editing
    state any more.

    WHY. The card is the top half of the page's right column and takes that
    column's height from .pw-workspace, so .pwi-inner holds a fixed height and
    scrolls. Fine for a short read-only record; wrong for a form, where the
    fields pushed שמירה/ביטול below the card's own fold and the actions could
    only be reached through an internal scrollbar belonging to nothing the
    reader had asked to scroll. Letting the card grow instead would have
    resized one column of a 50/50 row while the other stayed put. A dialog has
    neither problem — see the modal's own header for the rest.

    What this means for the code below: there is no _editing flag, no drafts,
    no field markup and no save path here. The card renders values, and it
    owns exactly two pieces of state — whether the dialog is open, and the
    "נשמר" flash that follows a successful write.

    WHAT IS SYSTEM INFORMATION AND WHAT IS THE TEAM'S
      * project number, type and academic year — read-only, rendered as a
        quiet meta LINE, deliberately not as disabled inputs. This is the
        same decision StudentProfilePersonalCard made for email and academic
        year: a disabled-looking field promises an edit the system will not
        allow.
      * team members — read-only chips, from the project context the shell
        already caches. Mentors are NOT repeated here; they are already named
        on the profile's team card, and this card is about the project.
      * display name, description and logo — the team's own, and the only
        three editable values on this page. All three live in the dialog.

    HALF WIDTH BY DESIGN
    This card is one of the two columns of the page's 50/50 overview row, not
    a full-width band. Every measure below is set for that: the name is at the
    section step rather than the page-title step (a 38px h1 in a ~600px card
    wraps on any real project name), and the branding lockup, the description
    and the team strip stack rather than sharing rows.

    BRANDING
    The row at the top is a mark + name + system-line lockup. The mark is the
    team's OWN uploaded logo — ProjectTeamProfile.LogoPath, written by
    PUT api/projects/my-project/logo and served out of wwwroot/project-logos.
    With no upload it is a neutral placeholder glyph, deliberately NOT initials
    derived from the project name: a monogram is a generated stand-in that
    reads as content, and a team that has not chosen a mark should see an empty
    slot inviting one, not a machine-made one it has to undo.

    Writes go to ProjectTeamProfile — never to Projects.Title /
    Projects.Description, which the Airtable sync owns — and the dialog
    refreshes IProjectContextService afterwards so the sidebar's project name
    (which is also the link back to this page) updates without a reload.
*@

<ProjectIdentityEditModal Project="Project"
                          IsOpen="_editorOpen"
                          OnClose="CloseEditor"
                          OnSaved="HandleSavedAsync" />

@* `Fill`, because the workspace hands this card a height now.

   The card is the top half of the page's right column, and that column is as
   tall as תוצרי ההגשה beside it (.pw-workspace / .pw-col-project). `Fill` is
   the only way a caller can reach an MCard's own root element across CSS
   isolation, and it does exactly the two things the arrangement needs: the
   card takes its cell's height, and its content becomes a flex column so
   .pwi-inner can hold that height and scroll inside it. *@
<MCard Padding="MCard.CardPadding.None" Fill="true">
    <div class="pwi-inner">

        @*
            ── BRANDING ROW ─────────────────────────────────────────────────
            The project's own mark, its name and its system line, as one
            lockup. This is the row that used to be a bare h1 with the
            team-edited name in it — which at full width read as a page title
            and, at half width, as a card with nothing at the top of it.

            THE MARK IS THE PROJECT'S, NOT MOTIVA'S. The earlier attempt at a
            glyph here was removed because it invented a second piece of
            product branding on a screen that already carries MotivaTopNav's.
            This is a different object: it identifies THIS project.
        *@
        <div class="pwi-brand">
            <span class="pwi-logo" aria-hidden="true">
                @if (HasLogo)
                {
                    @* Never a broken image: a src that fails to load flips
                       _logoFailed and the placeholder takes the tile back on
                       the next render, so the fallback covers a dead URL and
                       not just an absent one. *@
                    <img class="pwi-logo-img"
                         src="@LogoUrl"
                         alt=""
                         loading="lazy"
                         @onerror="HandleLogoError" />
                }
                else
                {
                    @* The empty slot. An outline glyph, not initials — see
                       the BRANDING note at the top of this file. *@
                    <svg class="pwi-logo-ph" width="22" height="22" viewBox="0 0 24 24"
                         fill="none" stroke="currentColor" stroke-width="1.5"
                         stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="3" width="18" height="18" rx="4" />
                        <circle cx="8.5" cy="9" r="1.6" />
                        <path d="M21 15.5l-4.6-4.2a1.6 1.6 0 0 0-2.2 0L4.2 20" />
                    </svg>
                }
            </span>

            <div class="pwi-brandtext">
                <h2 class="pwi-name">@DisplayTitle</h2>
                @if (!string.IsNullOrWhiteSpace(MetaLine))
                {
                    <p class="pwi-meta">@MetaLine</p>
                }
            </div>

            @* The card's ONE action. It stays in the branding row whatever the
               name's length, and it is now unconditional — there is no edit
               state for it to disappear into. *@
            <div class="pwi-headend">
                <span class="pwi-status" aria-live="polite">
                    @if (_saved)
                    {
                        <span class="pwi-saved">נשמר</span>
                    }
                </span>
                <MButton Variant="MButton.ButtonVariant.Secondary"
                         Size="MButton.ButtonSize.Small"
                         Class="pwi-editbtn motiva-cta-outline"
                         OnClick="OpenEditor">
                    עריכת פרטים
                </MButton>
            </div>
        </div>

        <div class="pwi-desc">
            @if (HasDescription)
            {
                <p class="pwi-desc-text">@Project.Description</p>
            }
            else
            {
                @* Not an MEmptyState: the design file writes this as an
                   invitation in the flow of the card, not as a centred block,
                   and MEmptyState is centre-only by construction. *@
                <p class="pwi-desc-empty">
                    עדיין אין תיאור לפרויקט. כמה משפטים על מה שאתם בונים יעזרו למנחה ולצוות לראות את התמונה המלאה.
                </p>
            }
        </div>

        @if (MemberNames.Count > 0)
        {
            <div class="pwi-team">
                <span class="pwi-team-label">חברי הצוות</span>
                <ul class="pwi-team-list">
                    @foreach (var name in MemberNames)
                    {
                        <li class="pwi-chip">
                            <span class="pwi-chip-avatar" aria-hidden="true">@ProjectWorkspaceModel.Initials(name)</span>
                            <span class="pwi-chip-name">@name</span>
                        </li>
                    }
                </ul>
            </div>
        }

    </div>
</MCard>

@code {
    /// <summary>The project as returned by GET api/projects/my-project-details.
    /// Mutated in place by the dialog on a successful save, so the page and
    /// this card never disagree about the current values.</summary>
    [Parameter, EditorRequired] public StudentProjectDetailsDto Project { get; set; } = default!;

    /// <summary>The cached project context, for the team roster. Null when the
    /// context call failed — the roster strip is then simply absent rather than
    /// showing an error inside an otherwise healthy card.</summary>
    [Parameter] public ProjectContextDto? Context { get; set; }

    /// <summary>Raised after a successful write so the page can re-render.</summary>
    [Parameter] public EventCallback OnProjectChanged { get; set; }

    private bool _editorOpen;
    private bool _saved;

    private string DisplayTitle =>
        string.IsNullOrWhiteSpace(Project.Title) ? "פרויקט ללא שם" : Project.Title;

    private string MetaLine =>
        ProjectWorkspaceModel.IdentityMetaLine(
            Project.ProjectNumber, Project.ProjectType, Project.AcademicYear);

    // ── Branding ─────────────────────────────────────────────────────────
    //
    // Read straight off the DTO. The card never composes the path itself: the
    // server names the stored file, so its value is the only authoritative
    // source for the URL. See the BRANDING note at the top of the file for
    // what exists behind it.
    private string? LogoUrl => Project.LogoUrl;

    /// <summary>Set when the browser fails to load a logo that WAS supplied.
    /// Distinct from "there is no logo": a dead URL and an absent one look the
    /// same to a student, and both have to end up at the placeholder.</summary>
    private bool _logoFailed;

    private bool HasLogo => !_logoFailed && !string.IsNullOrWhiteSpace(LogoUrl);

    private void HandleLogoError() => _logoFailed = true;

    private bool HasDescription => !string.IsNullOrWhiteSpace(Project.Description);

    private IReadOnlyList<string> MemberNames =>
        Context?.StudentNames?.Where(n => !string.IsNullOrWhiteSpace(n)).ToList()
        ?? (IReadOnlyList<string>)Array.Empty<string>();

    // ── Editor ───────────────────────────────────────────────────────────

    private void OpenEditor()
    {
        _editorOpen = true;
        _saved      = false;
    }

    private void CloseEditor() => _editorOpen = false;

    /// <summary>Any successful write inside the dialog — a text save, a logo
    /// upload or a logo removal. The dialog has already updated Project in
    /// place; this repaints the card around it and flashes the confirmation.
    ///
    /// <para>A fresh URL deserves a fresh attempt at loading it: without
    /// clearing the flag, one broken image would keep the placeholder up for
    /// the rest of the session even after a good logo replaced it.</para></summary>
    private async Task HandleSavedAsync()
    {
        _logoFailed = false;
        _saved      = true;

        if (OnProjectChanged.HasDelegate) await OnProjectChanged.InvokeAsync();

        _ = ClearSavedFlagAsync();
    }

    private async Task ClearSavedFlagAsync()
    {
        // Same 2.2s the profile card holds its own "נשמר" for.
        await Task.Delay(2200);
        _saved = false;
        await InvokeAsync(StateHasChanged);
    }
}
