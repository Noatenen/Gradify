@page "/project"
@layout AppLayout
@namespace AuthWithAdmin.Client.Pages.ProjectWorkspace
@using Microsoft.AspNetCore.Authorization
@using AuthWithAdmin.Shared.AuthSharedModels
@using AuthWithAdmin.Client.Services
@using AuthWithAdmin.Client.Components
@inject IProjectWorkspaceService Workspace
@inject IProjectContextService ProjectContext
@inject IDashboardService DashboardService
@attribute [Authorize]

@*
    ── מרחב הפרויקט (Student project workspace) ─────────────────────────────
    Structural / UX reference: design-reference/project-details/project/
                               Motiva Project Details.dc.html
    Visual source of truth:    the implemented student workspace — this page
                               borrows LearningMaterialsPage's shell recipe
                               (header bleed + MPageHeader Compact + a body
                               that adds no inset of its own, because the
                               student shell already supplies 40px/60px).

    NOT a new nav destination: the entry point is the project name in the
    sidebar (AppSideNav's .snav-workspace), per the IA decision that the
    project's own name is what opens its workspace.

    Three areas, in this order:
      1. מסע הפרויקט            — MJourneyStepper, full width
      2. THE WORKSPACE — one grid, three cells:
           right column, top    — ProjectIdentityCard       (what the project IS)
           right column, under it — ProjectResourcesSection (what it is built with)
           left column, both rows — SubmissionDeliverablesSection
                                                          (what the team WORKS on)

    WHY THIS SHAPE. The row pairs the project's identity — read once, changed
    rarely — with תוצרי ההגשה, the only part of the page a student actually
    works in, so the working area sits above the fold beside it instead of
    under it. תוצרי ההגשה is ~540px tall by construction and the project card
    is ~230px of content, which left the bottom of the right column empty;
    משאבי הפרויקט now fills exactly that space, and the right column reads as
    one vertical stack: what the project is, then what it is built with.

    RESOURCES ARE LOADED HERE, ONCE, AND SHARED. Both halves need them: the
    bottom section renders and edits them, and תוצרי ההגשה reads them as the
    evidence that derives "בעבודה". One fetch on the page, one list, passed
    down — so adding a resource associated with a deliverable updates that
    deliverable's state in the same frame, with no refetch and no second copy
    that could disagree.

    The design file's 880px content column is deliberately NOT reproduced: the
    student shell is full-bleed with a 40px inset (motiva-tokens.css:313-317),
    and StudentProfilePage already established that a narrow centred column
    leaves a real screen floating in empty canvas. Readability is held by the
    prose max-widths inside the cards instead.
*@

@*
    TITLE ONLY.

    The header used to carry two more things: the project's name in gradient
    text (with its topic after a separator dot) under the h1, and a
    "צוות 15 · 2025-2026 · Technological" chip at the reading end. Both were
    removed as redundant — the project card immediately below states its name
    as its own headline and the number/type/year as its meta line, so the
    header was repeating, in smaller type, what the first card says properly.

    MPageHeader renders no subtitle element and no actions element at all when
    those slots are absent (not merely empty), so nothing is left behind: the
    band keeps its own padding and the h1 sits in it alone. The slots are
    therefore DELETED rather than emptied — a `<SubtitleContent>` holding a
    false `@if` still counts as supplied, and would leave an empty div holding
    the old spacing open.
*@
<MPageHeader Variant="MPageHeader.HeaderVariant.Compact" Title="הפרויקט שלי" />

<div class="pw-body">

    @if (_loading)
    {
        <div class="pw-loading" role="status" aria-live="polite">
            <span class="pw-spinner" aria-hidden="true"></span>
            <span>טוענת את מרחב הפרויקט…</span>
        </div>
    }
    else if (_state == ProjectLoadState.Error)
    {
        <MEmptyState Live="true"
                     Title="לא הצלחנו לטעון את מרחב הפרויקט"
                     Description="ייתכן שיש תקלת רשת זמנית. אפשר לנסות שוב.">
            <Action>
                <MButton Variant="MButton.ButtonVariant.Secondary" OnClick="LoadAsync">
                    נסי שוב
                </MButton>
            </Action>
        </MEmptyState>
    }
    else if (_state == ProjectLoadState.NoProject || _project is null)
    {
        @* Not an error: a student who has not been placed on a team yet. The
           endpoint answers 404 for exactly this case, and the wording matches
           StudentProfileTeamCard's own unassigned copy. *@
        <MEmptyState Title="עדיין לא שויכת לפרויקט"
                     Description="לאחר השיבוץ יופיעו כאן פרטי הפרויקט, המשאבים של הצוות ותוצרי ההגשה." />
    }
    else
    {
        @* מסע הפרויקט — the same stepper the dashboard draws, on the same real
           milestone data. The reference puts it directly under the title on
           this screen too. It renders only once milestones have loaded; a
           failed load simply omits it rather than blocking the page. *@
        @if (_journeyStages.Count > 0)
        {
            <MCard Padding="MCard.CardPadding.Large" Class="pw-journey">
                <MSectionHeading Text="מסע הפרויקט">
                    <Trailing>
                        <span class="pw-journey-count">@_completedMilestones מתוך @_milestones.Count אבני דרך הושלמו</span>
                    </Trailing>
                </MSectionHeading>

                <MJourneyStepper Stages="@_journeyStages" />
            </MCard>
        }

        @* ── THE WORKSPACE — ≈57 / 43, three cells ───────────────────────
           Reading order IS the layout: the grid inherits the shell's
           `direction: rtl`, so COLUMN 1 IS THE RIGHT ONE. No `[dir=rtl]` rule
           and no `order` is involved.

           TWO REAL COLUMNS, each a vertical stack. The right one holds the
           project card and משאבי הפרויקט under it at the page's own 22px card
           step; the left one holds תוצרי ההגשה.

           ONE ROW, ONE HEIGHT. Both columns are as tall as the row and the row
           is as tall as תוצרי ההגשה — which is the only cell whose height is
           declared rather than measured (.pws-body's clamp). The right column
           then splits what it is given in half, so פרטי הפרויקט and משאבי
           הפרויקט are equal cards that end on the same line as the panel
           beside them instead of leaving canvas under it. The two cards that
           now receive a height rather than stating one carry their own scroll
           regions; see .pw-col-project in the .razor.css for why the row can
           never be measured from this column.

           THE NARROW ORDER IS FIXED IN CSS, NOT IN THE DOM. Stacked, the page
           must read פרטי הפרויקט → תוצרי ההגשה → משאבי הפרויקט, which is not
           this markup's order. Below the step the two column wrappers become
           `display: contents`, so all three cells become siblings of one flex
           column and `order` can put them in that sequence — see the
           .pw-cell-* rules in the .razor.css.

           THE CELLS ARE PAGE-OWNED <div>s, not the components themselves.
           Blazor's scoped CSS stamps this page's attribute on the wrapper; a
           component's own root carries ITS scope, so a rule written here for
           `.pw-workspace > *` would match nothing — and `order` has to be set
           on something this page can select.

           The two columns are deliberately UNEQUAL. The project card holds
           prose (a description, a team strip) and wants the wider measure;
           תוצרי ההגשה holds a list of short rows and reads better narrow.

           NOTHING RESIZES WHEN A DELIVERABLE IS SELECTED. The panel on the
           left swaps its own content between the list and one deliverable's
           details inside a body of fixed height that scrolls — see .pws-body
           in SubmissionDeliverablesSection.razor.css. *@
        <div class="pw-workspace">

            @* RIGHT — what the project is, then what it is built with. *@
            <div class="pw-col pw-col-project">

                <div class="pw-cell pw-cell-identity">
                    <ProjectIdentityCard Project="_project"
                                         Context="_context"
                                         OnProjectChanged="StateHasChanged" />
                </div>

                @* Under the project card, in the space its height leaves. Both
                   sections around it refer to it: a resource can be associated
                   with a deliverable, which is what puts that deliverable in
                   "בעבודה". *@
                <div class="pw-cell pw-cell-resources">
                    <ProjectResourcesSection Resources="_resources"
                                             Loading="_resourcesLoading"
                                             LoadFailed="_resourcesLoadFailed"
                                             OnAdded="HandleResourceAdded"
                                             OnUpdated="HandleResourceUpdated"
                                             OnRemoved="HandleResourceRemoved" />
                </div>

            </div>

            @* LEFT — the working area, full height of the row. *@
            <div class="pw-col pw-col-work">
                <div class="pw-cell pw-cell-deliverables">
                    <SubmissionDeliverablesSection Resources="_resources" />
                </div>
            </div>

        </div>
    }

</div>

@code {
    private StudentProjectDetailsDto? _project;
    private ProjectContextDto?        _context;

    // Milestones for the journey stepper. Read through IDashboardService —
    // GET api/projects/my-dashboard, the SAME endpoint and service the
    // dashboard's own stepper uses — so both screens draw one truth and no
    // new API surface was added for this.
    private List<MilestoneSummaryDto> _milestones = new();

    // ── The team's own resources, owned by the PAGE ──────────────────────
    // Read once here and handed to both משאבי הפרויקט (which renders and edits
    // them) and תוצרי ההגשה (which reads them as the artifacts that derive
    // "בעבודה"). Two independent fetches would have been two lists that drift
    // apart the moment one of them is edited.
    private List<ProjectResourceDto> _resources = new();
    private bool _resourcesLoading = true;
    private bool _resourcesLoadFailed;

    private ProjectLoadState _state = ProjectLoadState.Loaded;
    private bool             _loading = true;

    private int _completedMilestones => _milestones.Count(m => m.Status == "Completed");

    /// <summary>Identical mapping to StudentDashboardHero's — one Current
    /// stage, chosen by the shared StudentDashboardModel, so the two steppers
    /// can never disagree about where the project is.</summary>
    private IReadOnlyList<MJourneyStepper.JourneyStage> _journeyStages =>
        _milestones
            .Select(m => new MJourneyStepper.JourneyStage(
                Label:   m.Title,
                State:   JourneyStateOf(m),
                // Own progress, always — independent of its neighbours.
                Percent: PercentOf(m),
                Meta:    JourneyStateOf(m) == MJourneyStepper.JourneyState.Current && m.DueDate.HasValue
                             ? $"יעד {m.DueDate.Value:dd.MM}"
                             : null,
                Primary: m.ProjectMilestoneId == PrimaryMilestoneId))
            .ToList();

    /// <summary>Which stage gets the wider track. Emphasis only — it gates
    /// nothing, and every other stage still shows its own real progress.</summary>
    private int? PrimaryMilestoneId =>
        AuthWithAdmin.Client.Pages.Dashboard.StudentDashboardModel
            .CurrentMilestone(_milestones)?.ProjectMilestoneId;

    /// <summary>Same independent rule the dashboard applies — a milestone's
    /// state comes from itself, never from whether the one before it is
    /// finished. Several stages can be active at once.</summary>
    private static MJourneyStepper.JourneyState JourneyStateOf(MilestoneSummaryDto m)
    {
        if (m.Status == "Completed") return MJourneyStepper.JourneyState.Complete;

        bool hasProgress = m.Tasks.Count > 0
            && m.Tasks.Any(AuthWithAdmin.Client.Pages.Dashboard.StudentDashboardModel.IsComplete);

        return m.IsCurrentlyOpen || m.Status is "InProgress" or "Delayed" || hasProgress
            ? MJourneyStepper.JourneyState.Current
            : MJourneyStepper.JourneyState.Future;
    }

    private static int PercentOf(MilestoneSummaryDto m)
    {
        if (m.Tasks.Count == 0) return 0;
        var done = m.Tasks.Count(AuthWithAdmin.Client.Pages.Dashboard.StudentDashboardModel.IsComplete);
        return (int)Math.Round(done * 100.0 / m.Tasks.Count);
    }

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        StateHasChanged();

        // Two reads, both already part of the student session:
        //   * my-project-details — the project's own fields.
        //   * my-context         — the roster, already cached by
        //                          ProjectContextService, so this costs no
        //                          extra HTTP request on any page but the
        //                          first one of the session.
        var result = await Workspace.GetProjectAsync();

        _state   = result.State;
        _project = result.Project;

        // The roster and the milestones are independent of each other, so they
        // are fetched CONCURRENTLY. Awaiting them in sequence added a third
        // serial round-trip to this page's first paint when the stepper was
        // introduced; WhenAll puts it back to two.
        //
        // Both are tolerant: a failed context costs the roster strip, a failed
        // dashboard costs the stepper, and neither fails the page — the
        // project's own details still render.
        if (_state == ProjectLoadState.Loaded)
        {
            var contextTask   = ProjectContext.GetAsync();
            var dashboardTask = DashboardService.GetDashboardAsync();
            var resourcesTask = Workspace.GetResourcesAsync();
            await Task.WhenAll(contextTask, dashboardTask, resourcesTask);

            _context    = contextTask.Result;
            _milestones = dashboardTask.Result?.Milestones ?? new();

            // null is a FAILED read; an empty list is a team with no resources
            // yet. The section below draws two different things for them.
            _resourcesLoadFailed = resourcesTask.Result is null;
            _resources           = resourcesTask.Result ?? new();
        }
        else
        {
            _context             = null;
            _milestones          = new();
            _resources           = new();
            _resourcesLoadFailed = false;
        }

        _resourcesLoading = false;
        _loading          = false;
    }

    // ── Resource writes ──────────────────────────────────────────────────
    // The section performs the HTTP call and reports the OUTCOME; the page owns
    // the list. A NEW list instance each time rather than a mutation in place,
    // so the change is visible to Blazor as a changed parameter and both
    // children re-render from one source.

    private void HandleResourceAdded(ProjectResourceDto resource) =>
        _resources = new List<ProjectResourceDto>(_resources) { resource };

    private void HandleResourceUpdated(ProjectResourceDto resource)
    {
        var next  = new List<ProjectResourceDto>(_resources);
        var index = next.FindIndex(r => r.Id == resource.Id);

        // Replaced in place, never appended: the grid's order is the server's
        // insertion order and an edit must not move a tile.
        if (index >= 0) next[index] = resource;
        else            next.Add(resource);

        _resources = next;
    }

    private void HandleResourceRemoved(int id) =>
        _resources = _resources.Where(r => r.Id != id).ToList();
}
