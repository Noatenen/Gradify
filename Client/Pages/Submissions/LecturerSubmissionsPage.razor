@page "/lecturer-submissions"
@layout AppLayout
@using AuthWithAdmin.Shared.AuthSharedModels
@inject NavigationManager Nav
@attribute [Authorize(Roles = Roles.Admin + "," + Roles.Staff)]

@*
    Lecturer Submissions — DEPRECATED 2026-05-17.

    The lecturer-final-review flow was retired. Final deliverables now go
    through Moodle (external); inside Gradify we only handle mentor review.

    The route still resolves so existing bookmarks don't 404, but the page
    body is just a card explaining where to find the equivalent surfaces:
    mentor feedback lives inside each project's overview page, and project
    health monitoring lives on the dashboard.
*@

<div class="lsub-deprecated-wrap" dir="rtl">
    <div class="lsub-deprecated-card">
        <div class="lsub-deprecated-icon" aria-hidden="true">
            <span class="oi oi-info"></span>
        </div>
        <div class="lsub-deprecated-body">
            <h1 class="lsub-deprecated-title">תהליך הבדיקה הסופית הוסר</h1>
            <p class="lsub-deprecated-lead">
                ההגשה הרשמית של תוצרי הפרויקט מתבצעת כעת ב-<strong>מודל</strong>
                בלבד, ולכן הסרנו את ממשק הבדיקה הסופית מהמערכת.
            </p>
            <p class="lsub-deprecated-lead">
                ניתן עדיין לצפות בסקירת מנחה ובמשובי המנחה דרך עמודי הפרויקטים,
                ולעקוב אחר סטטוס ההגשות והבריאות במסך הבית.
            </p>

            <div class="lsub-deprecated-actions">
                <button class="lsub-deprecated-btn lsub-deprecated-btn-primary"
                        @onclick="@(() => Nav.NavigateTo("/dashboard/lecturer"))">
                    <span class="oi oi-pulse" aria-hidden="true"></span>
                    מעבר לדשבורד
                </button>
                <button class="lsub-deprecated-btn lsub-deprecated-btn-secondary"
                        @onclick="@(() => Nav.NavigateTo("/management"))">
                    <span class="oi oi-list-rich" aria-hidden="true"></span>
                    מעבר לאיזור הניהול
                </button>
            </div>
        </div>
    </div>
</div>
