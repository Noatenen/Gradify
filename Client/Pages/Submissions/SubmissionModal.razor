@using AuthWithAdmin.Client.Services
@using AuthWithAdmin.Shared.AuthSharedModels
@implements IAsyncDisposable
@inject IJSRuntime JS

@* ═══════════════════════════════════════════════════════════════════════════
   SubmissionModal — the STANDALONE host for StudentSubmissionForm.

   This file used to be the form. The form moved to StudentSubmissionForm so
   TaskDetailModal could mount it inline, and what is left here is the dialog:
   the scrim, the box, the scroll lock and backdrop dismissal. No validation,
   no API call and no submission state lives here any more — there is exactly
   one implementation of those and it is the child component.

   Still used for the EDIT-EXISTING path, which is reached from a row in the
   submission history rather than from the task's primary action.
   ═══════════════════════════════════════════════════════════════════════════ *@

@if (TaskId > 0)
{
    <div class="smo-overlay" @onclick="TryClose">
        <div class="smo-box" @onclick:stopPropagation="true">
            <StudentSubmissionForm TaskId="@TaskId"
                                   EditSubmissionId="@EditSubmissionId"
                                   InitialDriveUrl="@InitialDriveUrl"
                                   InitialNotes="@InitialNotes"
                                   ShowTaskContext="true"
                                   ShowClose="true"
                                   CancelText="ביטול"
                                   DoneText="סגירה"
                                   OnSubmitted="OnSubmitted"
                                   OnBusyChanged="@(b => _submitting = b)"
                                   OnCancel="Close" />
        </div>
    </div>
}

@code {
    [Parameter] public int           TaskId  { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    /// <summary>Raised once, when a submission is actually accepted by the
    /// server — as opposed to <see cref="OnClose"/>, which also fires when the
    /// student cancels.</summary>
    [Parameter] public EventCallback OnSubmitted { get; set; }

    /// <summary>When > 0 the form opens in *edit-existing* mode. Passed
    /// straight through; the server is authoritative about what may be
    /// edited.</summary>
    [Parameter] public int     EditSubmissionId { get; set; }
    [Parameter] public string? InitialDriveUrl  { get; set; }
    [Parameter] public string? InitialNotes     { get; set; }

    private bool _scrollLocked;

    /// <summary>Mirrors the form's own busy state so a backdrop click cannot
    /// dismiss the dialog mid-submit. The form owns the phase and reports the
    /// one bit of it the shell needs through OnBusyChanged.</summary>
    private bool _submitting;

    protected override async Task OnParametersSetAsync()
    {
        var isOpen = TaskId > 0;
        if (isOpen && !_scrollLocked)
            try { await JS.InvokeVoidAsync("gradify.scrollLock.lock"); } catch { }
        else if (!isOpen && _scrollLocked)
            try { await JS.InvokeVoidAsync("gradify.scrollLock.unlock"); } catch { }
        _scrollLocked = isOpen;
    }

    private async Task Close() => await OnClose.InvokeAsync();

    private async Task TryClose()
    {
        if (!_submitting) await Close();
    }

    public async ValueTask DisposeAsync()
    {
        if (_scrollLocked)
            try { await JS.InvokeVoidAsync("gradify.scrollLock.unlock"); } catch { }
    }
}
