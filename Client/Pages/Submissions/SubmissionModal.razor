@using AuthWithAdmin.Client.Services
@using AuthWithAdmin.Shared.AuthSharedModels
@using Microsoft.AspNetCore.Components.Forms
@inject ITaskSubmissionsService SubmissionsService

@if (TaskId > 0)
{
    <div class="smo-overlay" @onclick="TryClose">
        <div class="smo-box" @onclick:stopPropagation="true">

            @if (_phase == Phase.Loading)
            {
                <div class="smo-loading">
                    <div class="smo-spinner"></div>
                    <span>טוענת פרטי משימה…</span>
                </div>
            }
            else if (_phase == Phase.LoadError)
            {
                <div class="smo-load-error">
                    <span class="oi oi-warning" aria-hidden="true"></span>
                    <p>אירעה שגיאה בטעינת פרטי המשימה</p>
                    <button class="smo-ghost-btn" @onclick="Close">סגירה</button>
                </div>
            }
            else
            {
                <!-- ── Header ── -->
                <div class="smo-header">
                    <div class="smo-header-start">
                        <div class="smo-task-icon">
                            <span class="oi @(IsEditMode ? "oi-pencil" : "oi-data-transfer-upload")" aria-hidden="true"></span>
                        </div>
                        <div>
                            <p class="smo-milestone-label">
                                @_task!.MilestoneTitle
                                @if (IsEditMode)
                                {
                                    <span class="smo-mode-tag">עריכת הגשה</span>
                                }
                            </p>
                            <h2 class="smo-title">@_task.TaskTitle</h2>
                        </div>
                    </div>
                    <button class="smo-close-btn" @onclick="Close" title="סגירה">
                        <span class="oi oi-x" aria-hidden="true"></span>
                    </button>
                </div>

                <!-- ── Meta row (due date + status) ── -->
                <div class="smo-meta-row">
                    @if (_task.DueDate.HasValue)
                    {
                        bool isOverdue = _task.DueDate.Value.Date < DateTime.Today
                                      && _task.LatestSubmissionStatus is null or "NeedsRevision";
                        <span class="smo-due @(isOverdue ? "smo-due-overdue" : "")">
                            <span class="oi oi-calendar" aria-hidden="true"></span>
                            מועד הגשה: <strong>@_task.DueDate.Value.ToString("dd/MM/yyyy")</strong>
                            @if (isOverdue) { <span class="smo-overdue-label">(באיחור)</span> }
                        </span>
                    }
                    @if (_task.LatestSubmissionStatus is not null)
                    {
                        <span class="smo-submission-badge smo-badge-@_task.LatestSubmissionStatus.ToLower()">
                            @SubmissionStatusLabel(_task.LatestSubmissionStatus)
                        </span>
                    }
                </div>

                <!-- ── Description ── -->
                @if (!string.IsNullOrWhiteSpace(_task.Description))
                {
                    <p class="smo-description">@_task.Description</p>
                }

                <!-- ── Submission instructions ── -->
                @if (!string.IsNullOrWhiteSpace(_task.SubmissionInstructions))
                {
                    <div class="smo-instructions">
                        <div class="smo-instructions-title">
                            <span class="oi oi-info" aria-hidden="true"></span>
                            הוראות הגשה
                        </div>
                        <p class="smo-instructions-body">@_task.SubmissionInstructions</p>
                    </div>
                }

                <!-- ── Existing submission banner ── -->
                @if (_task.LatestSubmissionId.HasValue)
                {
                    <div class="smo-prev-submission">
                        <span class="oi oi-circle-check" aria-hidden="true"></span>
                        <span>
                            הגשה אחרונה: @_task.LatestSubmittedAt.IsraelFormat()
                            (@_task.SubmissionCount הגשות בסה"כ)
                        </span>
                    </div>
                }

                @* Drive-link-only submission form (uploads removed 2026-05-19). *@
                @if (_phase != Phase.Success)
                {
                    <!-- Drive URL -->
                    <div class="smo-field">
                        <label class="smo-label">
                            קישור Google Drive <span class="smo-required">*</span>
                        </label>
                        <input class="smo-input smo-drive-input smo-drive-input--@LinkStateClass"
                               type="url"
                               dir="ltr"
                               placeholder="https://drive.google.com/..."
                               value="@_driveUrl"
                               @oninput="OnDriveUrlInput"
                               disabled="@(_phase == Phase.Submitting)" />

                        @* Live validation status badge — gates the submit button. *@
                        <div class="smo-drive-status smo-drive-status--@LinkStateClass">
                            @switch (_linkState)
                            {
                                case LinkState.Idle:
                                    <span class="oi oi-link-intact" aria-hidden="true"></span>
                                    <span>הדבק/י קישור כדי לבדוק שהוא נגיש לכולם.</span>
                                    break;
                                case LinkState.Checking:
                                    <span class="smo-spinner-sm"></span>
                                    <span>בודק נגישות לקישור…</span>
                                    break;
                                case LinkState.Accessible:
                                    <span class="oi oi-circle-check" aria-hidden="true"></span>
                                    <span>הקישור נגיש — ניתן לשלוח את ההגשה.</span>
                                    break;
                                case LinkState.Inaccessible:
                                    <span class="oi oi-warning" aria-hidden="true"></span>
                                    <span>@(_linkError ?? "הקישור אינו פתוח לצפייה.")</span>
                                    break;
                            }
                        </div>

                        <div class="smo-drive-help">
                            <span class="oi oi-info smo-drive-help-icon" aria-hidden="true"></span>
                            <div class="smo-drive-help-body">
                                <strong>איך לשתף נכון בדרייב:</strong>
                                <ol class="smo-drive-help-list">
                                    <li>היכנס/י לקובץ או לתיקייה ב-Google Drive.</li>
                                    <li>בחר/י באפשרות <em>שיתוף</em> (Share).</li>
                                    <li>תחת <em>גישה כללית</em>, החליפ/י ל-<em>"כל מי שיש את הקישור"</em>.</li>
                                    <li>העתק/י את הקישור והדבק/י אותו כאן.</li>
                                </ol>
                                <p class="smo-drive-help-note">
                                    מותר רק קישור מ-<code>drive.google.com</code> או <code>docs.google.com</code>.
                                    אנחנו לא מורידים את הקובץ — המנחה יפתח אותו ישירות מהדרייב.
                                </p>
                            </div>
                        </div>
                    </div>

                    <!-- Notes -->
                    <div class="smo-field">
                        <label class="smo-label">הערות (אופציונלי)</label>
                        <textarea class="smo-textarea" @bind="_notes" rows="2"
                                  placeholder="הוסף/י הערות להגשה…" disabled="@(_phase == Phase.Submitting)"></textarea>
                    </div>

                    <!-- Validation / submit error -->
                    @if (!string.IsNullOrEmpty(_submitError))
                    {
                        <div class="smo-error-msg">
                            <span class="oi oi-warning" aria-hidden="true"></span>
                            @_submitError
                        </div>
                    }

                    <!-- Submit / cancel actions -->
                    <div class="smo-actions">
                        <button class="smo-ghost-btn" @onclick="Close" disabled="@(_phase == Phase.Submitting)">
                            ביטול
                        </button>
                        <button class="smo-submit-btn motiva-cta"
                                @onclick="Submit"
                                disabled="@(!CanSubmit)"
                                title="@(CanSubmit ? "" : "יש להזין קישור נגיש לדרייב")">
                            @if (_phase == Phase.Submitting)
                            {
                                <span class="smo-spinner-sm"></span>
                                <span>@(IsEditMode ? "שומר…" : "שולח…")</span>
                            }
                            else if (IsEditMode)
                            {
                                <span class="oi oi-check" aria-hidden="true"></span>
                                <span>שמירת שינויים</span>
                            }
                            else
                            {
                                <span class="oi oi-share-boxed" aria-hidden="true"></span>
                                <span>שלח קישור</span>
                            }
                        </button>
                    </div>
                }
                else
                {
                    <!-- Success state -->
                    <div class="smo-success">
                        <div class="smo-success-icon">
                            <span class="oi oi-circle-check" aria-hidden="true"></span>
                        </div>
                        <h3 class="smo-success-title">
                            @(IsEditMode ? "ההגשה עודכנה בהצלחה!" : "ההגשה נשלחה בהצלחה!")
                        </h3>
                        <p class="smo-success-body">
                            @(IsEditMode ? "השינויים נשמרו." : "הגשתך נקלטה במערכת.")
                        </p>
                        <button class="smo-submit-btn motiva-cta" @onclick="Close">סגירה</button>
                    </div>
                }

            }
        </div>
    </div>
}

@code {
    [Parameter] public int             TaskId   { get; set; }
    [Parameter] public EventCallback   OnClose  { get; set; }

    /// <summary>When > 0 the modal is in *edit-existing* mode: it pre-fills
    /// the fields and submits a PATCH instead of a POST. The student can
    /// only edit their own latest submission while MentorStatus='Pending' —
    /// the server is authoritative.</summary>
    [Parameter] public int      EditSubmissionId    { get; set; }
    [Parameter] public string?  InitialDriveUrl     { get; set; }
    [Parameter] public string?  InitialNotes        { get; set; }

    private bool IsEditMode => EditSubmissionId > 0;

    private enum Phase     { Loading, LoadError, View, Submitting, Success }
    private enum LinkState { Idle, Checking, Accessible, Inaccessible }

    private Phase                      _phase       = Phase.Loading;
    private StudentSubmissionTaskDto?  _task;
    private string                     _notes       = "";
    private string                     _driveUrl    = "";
    private string                     _submitError = "";

    // ── Live Drive-link validation state ───────────────────────────────────
    private LinkState _linkState   = LinkState.Idle;
    private string?   _linkError;
    /// <summary>Monotonic token so a stale in-flight request can't overwrite
    /// the result of a fresher one when the user keeps typing.</summary>
    private int       _linkToken;

    /// <summary>The submit button is enabled only when the live probe says
    /// the link is accessible. The server runs the same check on submit, so
    /// gating here is purely a UX guard against avoidable round-trips.</summary>
    private bool CanSubmit =>
        _phase != Phase.Submitting
        && !string.IsNullOrWhiteSpace(_driveUrl)
        && _linkState == LinkState.Accessible;

    private string LinkStateClass => _linkState switch
    {
        LinkState.Checking     => "checking",
        LinkState.Accessible   => "ok",
        LinkState.Inaccessible => "bad",
        _                      => "idle",
    };

    // ── Lifecycle ──────────────────────────────────────────────────────────────

    protected override async Task OnParametersSetAsync()
    {
        if (TaskId <= 0) return;

        _phase       = Phase.Loading;
        _notes       = InitialNotes    ?? "";
        _driveUrl    = InitialDriveUrl ?? "";
        _submitError = "";
        _linkState   = LinkState.Idle;
        _linkError   = null;

        _task = await SubmissionsService.GetSubmissionTaskAsync(TaskId);
        _phase = _task is null ? Phase.LoadError : Phase.View;

        // Edit mode pre-fills the URL — kick off the live probe so the
        // button isn't permanently disabled for an already-valid link.
        if (!string.IsNullOrWhiteSpace(_driveUrl))
            _ = ScheduleLinkCheck();
    }

    private async Task OnDriveUrlInput(ChangeEventArgs e)
    {
        _driveUrl = (e.Value as string) ?? "";
        await ScheduleLinkCheck();
    }

    /// <summary>Debounced live check. Each call increments a token; only
    /// the response that still matches the latest token is applied to UI
    /// state, so quick typing can't cause an older "bad" answer to overwrite
    /// a newer "good" one.</summary>
    private async Task ScheduleLinkCheck()
    {
        int my = ++_linkToken;
        var raw = _driveUrl?.Trim() ?? "";

        if (string.IsNullOrEmpty(raw))
        {
            _linkState = LinkState.Idle;
            _linkError = null;
            StateHasChanged();
            return;
        }

        _linkState = LinkState.Checking;
        _linkError = null;
        StateHasChanged();

        await Task.Delay(600);                  // typing debounce
        if (my != _linkToken) return;           // user kept typing

        var (ok, error) = await SubmissionsService.ValidateDriveLinkAsync(raw);
        if (my != _linkToken) return;           // a newer check superseded us

        if (ok)
        {
            _linkState = LinkState.Accessible;
            _linkError = null;
        }
        else
        {
            _linkState = LinkState.Inaccessible;
            _linkError = string.IsNullOrWhiteSpace(error)
                ? "הקישור אינו פתוח לצפייה. יש לשתף את הקובץ/התיקייה בדרייב כך שלכל מי שיש את הקישור תהיה גישה."
                : error;
        }
        StateHasChanged();
    }

    // ── Submit ─────────────────────────────────────────────────────────────────

    private async Task Submit()
    {
        _submitError = "";

        // The submit button is disabled unless the live probe already
        // returned Accessible — but a defensive re-check protects against
        // a user enabling the button via dev-tools or stale state.
        var trimmed = (_driveUrl ?? "").Trim();
        if (string.IsNullOrEmpty(trimmed) || _linkState != LinkState.Accessible)
        {
            _submitError = _linkError
                ?? "יש להזין קישור Google Drive נגיש לפני שליחת ההגשה";
            return;
        }

        _phase = Phase.Submitting;

        bool ok;
        string? error;
        if (IsEditMode)
        {
            (ok, error) = await SubmissionsService.UpdateMySubmissionAsync(
                EditSubmissionId,
                new UpdateMySubmissionRequest
                {
                    DriveUrl = trimmed,
                    Notes    = string.IsNullOrWhiteSpace(_notes) ? null : _notes.Trim(),
                });
        }
        else
        {
            var (newId, createErr) = await SubmissionsService.CreateSubmissionAsync(new CreateSubmissionRequest
            {
                TaskId   = TaskId,
                Notes    = string.IsNullOrWhiteSpace(_notes) ? null : _notes.Trim(),
                DriveUrl = trimmed,
            });
            ok    = newId.HasValue;
            error = createErr;
        }

        if (!ok)
        {
            // Server-supplied Hebrew message takes priority (e.g. "הקישור אינו פתוח לצפייה…")
            _submitError = string.IsNullOrWhiteSpace(error)
                ? (IsEditMode ? "שגיאה בשמירת השינויים. נסה/י שנית." : "שגיאה בשליחת ההגשה. נסה/י שנית.")
                : error;
            _phase       = Phase.View;
        }
        else
        {
            _phase = Phase.Success;
        }
    }

    // ── Close ──────────────────────────────────────────────────────────────────

    private async Task Close() => await OnClose.InvokeAsync();

    private async Task TryClose()
    {
        if (_phase != Phase.Submitting)
            await Close();
    }

    private static string SubmissionStatusLabel(string status) => status switch
    {
        "Submitted"      => "הוגש",
        "Reviewed"       => "נבדק",
        "NeedsRevision"  => "דורש תיקון",
        _                => status,
    };
}