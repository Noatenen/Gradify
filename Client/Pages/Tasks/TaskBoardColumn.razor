@using AuthWithAdmin.Shared.AuthSharedModels

@*
    TaskBoardColumn — one column of the tasks board (or, when a single
    workflow filter is active, the sole full-width column shown). System-
    defined and read-only: users cannot drag cards between columns, this
    purely presents TaskStatusHelpers.GetWorkflowSection's grouping.

    Primary="true" (used for exactly one column — "needs my action") gets
    a bolder heading and a slim accent rule; every other column stays
    plain. Cards have no shared column "box" of their own — each TaskCard
    is independently elevated, and the column just stacks them with real
    spacing, so a short column doesn't leave a big empty card behind it.
*@

<div class="tbc-column @(Primary ? "tbc-column-primary" : "")">
    <div class="tbc-header">
        <span class="oi @Icon tbc-icon" aria-hidden="true"></span>
        <span class="tbc-title">@Title</span>
        <span class="tbc-count">@Count</span>
    </div>

    <div class="tbc-cards">
        @if (Tasks.Count == 0)
        {
            <div class="tbc-empty">
                <span class="oi @(EmptyIsPositive ? "oi-circle-check tbc-empty-ok" : "oi-info")" aria-hidden="true"></span>
                <p>@EmptyMessage</p>
            </div>
        }
        else
        {
            @foreach (var task in Tasks)
            {
                <TaskCard Task="task"
                          MilestoneTitle="@MilestoneTitleLookup.GetValueOrDefault(task.Id, "")"
                          StudentName="@StudentName"
                          OnOpenDetail="OnOpenDetail" />
            }
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter, EditorRequired] public string Icon { get; set; } = "";
    [Parameter, EditorRequired] public int Count { get; set; }
    [Parameter] public bool Primary { get; set; }
    [Parameter, EditorRequired] public IReadOnlyList<TaskItemDto> Tasks { get; set; } = Array.Empty<TaskItemDto>();
    [Parameter] public Dictionary<int, string> MilestoneTitleLookup { get; set; } = new();
    [Parameter, EditorRequired] public string EmptyMessage { get; set; } = "";
    [Parameter] public bool EmptyIsPositive { get; set; }
    [Parameter] public string? StudentName { get; set; }
    [Parameter] public EventCallback<int> OnOpenDetail { get; set; }
}
