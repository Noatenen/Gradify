@using AuthWithAdmin.Shared.AuthSharedModels

@*
    CurrentProgressStrip — persistent "where am I" context while working
    the daily task workspace. Sticks to the top of the page on scroll so
    stage/milestone context never disappears while the student works
    through the sections below.

    Sprint-1 data source: ProjectContextDto (already fetched elsewhere via
    IProjectContextService, no new endpoint). This intentionally reads at
    milestone granularity for now — once the Project Stages epic ships real
    RoadmapStage progress, this strip is the seam that swaps to stage-level
    data without moving or restructuring anything else on the page.

    TODO (future sprint, not Sprint 1): evolve this from a status strip into
    a richer Project Context Card — approved architectural direction, not a
    blocker for the current sprint.
*@

@if (Context is not null)
{
    <div class="cps-strip">
        @if (!string.IsNullOrWhiteSpace(Context.CurrentMilestoneTitle))
        {
            <div class="cps-current">
                <span class="oi oi-map cps-icon" aria-hidden="true"></span>
                <span class="cps-label">שלב נוכחי:</span>
                <span class="cps-value">@Context.CurrentMilestoneTitle</span>
                @if (!string.IsNullOrEmpty(Context.CurrentMilestoneStatus))
                {
                    <span class="cps-status-badge cps-status-@StatusClass(Context.CurrentMilestoneStatus)">
                        @StatusLabel(Context.CurrentMilestoneStatus)
                    </span>
                }
                @if (Context.CurrentMilestoneDueDate.HasValue)
                {
                    <span class="cps-due">
                        <span class="oi oi-calendar" aria-hidden="true"></span>
                        יעד: @Context.CurrentMilestoneDueDate.Value.ToString("dd/MM/yy")
                    </span>
                }
            </div>
        }
        else
        {
            <div class="cps-current">
                <span class="oi oi-circle-check cps-icon cps-icon-ok" aria-hidden="true"></span>
                <span class="cps-value">כל אבני הדרך הושלמו</span>
            </div>
        }

        @if (Context.MilestonesTotal > 0 || Context.TasksTotal > 0)
        {
            <div class="cps-progress">
                @if (Context.MilestonesTotal > 0)
                {
                    <span class="cps-progress-item">@Context.MilestonesCompleted/@Context.MilestonesTotal אבני דרך</span>
                }
                @if (Context.TasksTotal > 0)
                {
                    <span class="cps-progress-item">@Context.TasksDone/@Context.TasksTotal משימות</span>
                }
            </div>
        }
    </div>
}

@code {
    [Parameter] public ProjectContextDto? Context { get; set; }

    private static string StatusClass(string s) => s switch
    {
        "Completed"  => "completed",
        "InProgress" => "inprogress",
        "Delayed"    => "delayed",
        _            => "notstarted",
    };

    private static string StatusLabel(string s) => s switch
    {
        "Completed"  => "הושלם",
        "InProgress" => "בתהליך",
        "Delayed"    => "באיחור",
        _            => "טרם החל",
    };
}
