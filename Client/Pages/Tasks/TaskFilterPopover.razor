@*
    TaskFilterPopover — compact "סינון" control for the toolbar.

    Options mirror the 4 workflow sections (+ "הכל") the page is now
    organized around — selecting one collapses the page from the 4-section
    browse view into a single flat list for that bucket; the trigger shows
    the active selection so it stays visible without a permanent tab row.
*@

<div class="tfp-wrap">
    <button class="tfp-trigger @(_isOpen ? "tfp-trigger-open" : "") @(ActiveFilter != "all" ? "tfp-trigger-active" : "")"
            @onclick="ToggleOpen"
            aria-haspopup="listbox"
            aria-expanded="@_isOpen">
        <span class="tfp-trigger-label">@TriggerLabel</span>
        <span class="oi oi-chevron-bottom tfp-chevron" aria-hidden="true"></span>
    </button>

    @if (_isOpen)
    {
        <div class="tfp-backdrop" @onclick="Close"></div>
        <div class="tfp-panel" role="listbox" aria-label="סינון משימות לפי סטטוס">
            @foreach (var opt in Options)
            {
                <button class="tfp-option @(ActiveFilter == opt.Key ? "tfp-option-active" : "")"
                        role="option" aria-selected="@(ActiveFilter == opt.Key)"
                        @onclick="() => Select(opt.Key)">
                    @if (!string.IsNullOrEmpty(opt.DotClass))
                    {
                        <span class="tfp-option-dot @opt.DotClass" aria-hidden="true"></span>
                    }
                    <span>@opt.Label</span>
                </button>
            }
        </div>
    }
</div>

@code {
    [Parameter] public string ActiveFilter { get; set; } = "all";
    [Parameter] public EventCallback<string> OnSelectFilter { get; set; }

    private bool _isOpen;

    private static readonly (string Key, string Label, string DotClass)[] Options = new[]
    {
        ("all",    "הכל",             ""),
        ("action", "דורש ממני פעולה", "tfp-dot-action"),
        ("submit", "מוכן להגשה",      "tfp-dot-submit"),
        ("team",   "משימות צוות",     "tfp-dot-team"),
        ("done",   "הושלמו",          "tfp-dot-done"),
    };

    private string TriggerLabel => Options.First(o => o.Key == ActiveFilter).Key == "all"
        ? "סינון"
        : Options.First(o => o.Key == ActiveFilter).Label;

    private void ToggleOpen() => _isOpen = !_isOpen;
    private void Close() => _isOpen = false;

    private async Task Select(string key)
    {
        _isOpen = false;
        await OnSelectFilter.InvokeAsync(key);
    }
}
