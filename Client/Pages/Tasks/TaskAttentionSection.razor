@using AuthWithAdmin.Shared.AuthSharedModels

@*
    TaskAttentionSection — "דורש התייחסות".

    A cross-cutting VIEW over tasks that already exist elsewhere on the page,
    not a fifth bucket: a returned or overdue task still belongs to its
    milestone in משימות הפרויקט. Nothing about the domain model changes to put
    a task here.

    Deliberately NOT full-bleed. The Claude Design reference draws this band
    edge to edge, but it fills that width with expandable rows carrying mentor
    feedback, the attached file, work-time and calendar sync. With the data this
    app actually has — a title, a reason and a due date — the same full-width
    surface reads as one short line marooned in a banner. So the band is capped
    at a readable measure and sits at the reading start; it keeps the
    reference's row anatomy (pulsing dot, title, reason chip, chevron) and its
    rose vocabulary, and stays the first thing under the title, which is what
    made it prominent in the first place.
*@

<div id="requires-attention" class="tas-section">
    <MCard Padding="MCard.CardPadding.None">
        <div class="tas-body">
            <div class="tas-header">
                <MStatusDot Tone="MStatusDot.DotTone.Rose" Pulse="true" AriaLabel="דורש התייחסות" />
                <p class="tas-title">דורש התייחסות</p>
                <span class="tas-count">@Tasks.Count</span>
            </div>

            @*
                The band's height is driven by its rows. Past RowsMaxHeight the
                list scrolls inside itself rather than pushing the workspace
                below off the viewport; the header stays put.
            *@
            <MScrollArea MaxHeight="@RowsMaxHeight" Tabbable="false">
                @foreach (var task in Tasks)
                {
                    var captured = task;
                    <button type="button" class="tas-row"
                            @onclick="@(() => OnOpenDetail.InvokeAsync(captured.Id))"
                            aria-label="@($"פתיחת {task.Title}")">
                        @*
                            The reference's attention row: a pulsing rose dot, the
                            title, then the REASON as a chip rather than a loose
                            sentence, and a chevron at the end. The chip is what
                            makes the row scannable — the eye finds one shape per
                            row instead of reading a rose sentence.
                        *@
                        <span class="tas-row-dot" aria-hidden="true"></span>
                        <span class="tas-row-title">@task.Title</span>
                        <span class="tas-row-chip">@ReasonFor(task)</span>
                        <span class="tas-row-spacer"></span>
                        @if (task.DueDate.HasValue)
                        {
                            <span class="tas-row-due">יעד @task.DueDate.Value.ToString("dd.MM")</span>
                        }
                        <span class="tas-row-go" aria-hidden="true">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                 stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="m15 6-6 6 6 6"></path>
                            </svg>
                        </span>
                    </button>
                }
            </MScrollArea>
        </div>
    </MCard>
</div>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<TaskItemDto> Tasks { get; set; } = Array.Empty<TaskItemDto>();
    [Parameter] public EventCallback<int> OnOpenDetail { get; set; }

    // Padding=None on purpose: the Design's 11px/20px/22px inset matches no
    // MCard padding step, so .tas-body carries it inside the card instead.

    /// <summary>Where the attention list starts scrolling instead of growing.
    /// The row is now a single line — title and reason side by side rather than
    /// stacked — so it measures ~55px instead of ~69px, and three rows plus
    /// their hairlines come to ~168px. Three is still the point where the band
    /// reads as a short priority list rather than a second board.
    ///
    /// <para>The 20vh half of the min() is the viewport-fit half: a priority
    /// band should never take more than a fifth of the screen, so on a short
    /// laptop it yields space to the task panels below instead of holding its
    /// full three rows and pushing them off the fold.</para></summary>
    private const string RowsMaxHeight = "min(168px, 20vh)";

    /// <summary>Why this task is in the band. Both strings come from the
    /// existing status helpers — a returned task reads "נדרש תיקון", an overdue
    /// one "באיחור" — so the band never invents a status of its own. The due
    /// date is rendered separately now rather than being concatenated in, which
    /// lets the reason become a chip and the date sit with the other dates on
    /// the page.</summary>
    private static string ReasonFor(TaskItemDto t) =>
        TaskStatusHelpers.GetCategory(t) == TaskStatusHelpers.TaskCategory.Returned
            ? "נדרש תיקון"
            : "באיחור";
}
