@using AuthWithAdmin.Shared.AuthSharedModels

@*
    TaskAttentionSection — the finalized design's full-width "דורש התייחסות"
    band (design-reference/motiva/project/Motiva Tasks.dc.html, #requires-attention).

    A cross-cutting VIEW over tasks that already exist elsewhere on the page, not
    a fifth bucket: a returned or overdue task still belongs to its milestone in
    משימות הפרויקט. Nothing about the domain model changes to put a task here.

    The Design draws a rose dot with the attention ring, one row per task
    (title + rose status/date line) and a violet "פתיחה" action that opens the
    existing task detail modal.
*@

<div id="requires-attention" class="tas-section">
    <MCard Variant="MCard.CardVariant.AmbientEdge" Padding="MCard.CardPadding.None">
        <div class="tas-body">
            <div class="tas-header">
                <MStatusDot Tone="MStatusDot.DotTone.Rose" Pulse="true" AriaLabel="דורש התייחסות" />
                <p class="tas-title">דורש התייחסות</p>
            </div>

            @*
                The band's height is driven by its rows — one attention task
                gives one row's worth of section, as the Design draws it. Past
                RowsMaxHeight the list scrolls inside itself rather than pushing
                the task panels below off the viewport; the header stays put.
            *@
            <MScrollArea MaxHeight="@RowsMaxHeight" Tabbable="false">
                @foreach (var task in Tasks)
                {
                    var captured = task;
                    <div class="tas-row">
                        <div class="tas-row-main">
                            <strong class="tas-row-title">@task.Title</strong>
                            <div class="tas-row-meta">@MetaFor(task)</div>
                        </div>
                        <button type="button" class="tas-open"
                                @onclick="@(() => OnOpenDetail.InvokeAsync(captured.Id))"
                                aria-label="@($"פתיחת {task.Title}")">
                            פתיחה
                        </button>
                    </div>
                }
            </MScrollArea>
        </div>
    </MCard>
</div>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<TaskItemDto> Tasks { get; set; } = Array.Empty<TaskItemDto>();
    [Parameter] public EventCallback<int> OnOpenDetail { get; set; }

    // Padding=None on purpose: the Design's 11px/20px/22px inset matches no
    // MCard padding step, so .tas-body carries it inside the card instead.

    /// <summary>Where the attention list starts scrolling instead of growing.
    /// Derived from the Design's own row: 14px + 14px padding, a 14px/1.35 title
    /// (~19px) and a 12.5px/1.4 meta line 4px under it (~22px) come to ~69px, so
    /// three rows plus their hairlines are ~208px. Three is the point where the
    /// band still reads as a short priority list rather than a second board.
    ///
    /// <para>The 20vh half of the min() is the viewport-fit half: a priority
    /// band should never take more than a fifth of the screen, so on a short
    /// laptop it yields space to the task panels below instead of holding its
    /// full three rows and pushing them off the fold.</para></summary>
    private const string RowsMaxHeight = "min(208px, 20vh)";

    /// <summary>The Design's rose meta line: why this task is here, then its due
    /// date. Both strings come from the existing status helpers — a returned task
    /// reads "נדרש תיקון", an overdue one "באיחור", exactly as the reference does.</summary>
    private static string MetaFor(TaskItemDto t)
    {
        string reason = TaskStatusHelpers.GetCategory(t) == TaskStatusHelpers.TaskCategory.Returned
            ? "נדרש תיקון"
            : "באיחור";

        return t.DueDate.HasValue
            ? $"{reason} · יעד {t.DueDate.Value:dd.MM}"
            : reason;
    }
}
