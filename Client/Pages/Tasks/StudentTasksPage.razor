@page "/tasks"
@layout AppLayout
@using Microsoft.AspNetCore.Authorization
@using AuthWithAdmin.Shared.AuthSharedModels
@using AuthWithAdmin.Client.Services
@using AuthWithAdmin.Client.Pages.Submissions
@inject ITasksService TasksService
@inject ITaskSubmissionsService SubmissionsService
@inject ITeamTasksService TeamTasksService
@inject IProjectContextService ProjectContext
@inject NavigationManager Nav
@inject IJSRuntime JS
@implements IDisposable
@attribute [Authorize]

<!-- ── Task detail modal ── -->
<TaskDetailModal TaskId="@_detailTaskId"
                 OnClose="CloseDetail"
                 OnOpenSubmission="OpenSubmissionFromDetail"
                 OnEditMySubmission="OnEditFromDetail"
                 OnDeleteMySubmission="OnDeleteFromDetail"
                 OnMarkMoodleSubmitted="OnMarkMoodleFromDetail" />

<!-- ── Submission upload / resubmit modal ── -->
<SubmissionModal TaskId="@_submissionTaskId"
                 EditSubmissionId="@_editSubmissionId"
                 InitialDriveUrl="@_editDriveUrl"
                 InitialNotes="@_editNotes"
                 OnClose="CloseSubmission" />

<!-- ── Moodle confirmation ──
     Shared MConfirmDialog since the migration pass: this page's own dialog
     was the pattern the component was lifted from, so what renders is the
     same dialog, now declared once for every student surface. -->
<MConfirmDialog IsOpen="@(_moodleSubId > 0)"
                Title="אישור הגשה במודל"
                Message="האם את/ה בטוח/ה שההגשה בוצעה במודל?"
                Error="@_moodleError"
                ConfirmText="כן, הוגש"
                ConfirmIcon="oi-check"
                BusyText="שומר…"
                Busy="@_moodleBusy"
                OnConfirm="ConfirmMoodleAsync"
                OnCancel="CancelMoodle" />

<!-- ── Delete confirmation ── -->
<MConfirmDialog IsOpen="@(_deleteSubId > 0)"
                Tone="MConfirmDialog.ConfirmTone.Danger"
                Title="ביטול הגשה"
                Message="האם למחוק את ההגשה? המשימה תחזור למצב פתוח להגשה."
                Error="@_deleteError"
                ConfirmText="מחק"
                ConfirmIcon="oi-trash"
                BusyText="מוחק…"
                Busy="@_deleteBusy"
                OnConfirm="ConfirmDeleteAsync"
                OnCancel="CancelDelete" />

@*
    ── Hero ──
    The finalized design's compact ambient header: page title, one line of live
    milestone context, and the KPI row — one composition on one surface. The KPI
    row goes in MPageHeader's own ChildContent slot, so there is no second hero
    and no component API change.

    .tsk-header-bleed cancels the student shell's 40px inline padding so the band
    reaches the shell edge the way the Design draws it, while MPageHeader's own
    inline padding keeps its text and the KPI row on the same boundary as the
    content below.
*@
<div class="tsk-header-bleed">
    <MPageHeader Variant="MPageHeader.HeaderVariant.Compact" Title="המשימות שלי">
        @*
            The hero reads the CANONICAL current milestone from
            IProjectContextService — the same value the dashboard hero, the
            sidebar widget and the planning workspace show.

            It deliberately does NOT use the local `CurrentMilestone` below.
            That one is derived from ActiveGroups (milestones that still have an
            unfinished task), which is the right input for ordering/highlighting
            the task list but the wrong answer for "which milestone am I on":
            with every task in פיתוח finished, ActiveGroups no longer contains
            it, so this hero announced הערכה while every other student page said
            פיתוח. `CurrentMilestone` is left untouched for the list.
        *@
        <SubtitleContent>
            @if (!string.IsNullOrWhiteSpace(_context?.CurrentMilestoneTitle))
            {
                @:אבן דרך נוכחית:
                <strong class="tsk-milestone-name">@_context!.CurrentMilestoneTitle</strong>
                @if (_context.CurrentMilestoneDueDate.HasValue)
                {
                    @($" · יעד {_context.CurrentMilestoneDueDate.Value:dd.MM}")
                }
            }
        </SubtitleContent>
        @* The reference puts the tabs on the TITLE row, pushed to the reading
           end — not on a full-width row of their own under the subtitle. *@
        <Actions>
            @if (HasData)
            {
                <TaskStatusTabs AttentionCount="@AttentionTasks.Count"
                                DueThisWeekCount="@DueThisWeekCount"
                                TeamCount="@_teamTasks.Count"
                                CompletedCount="@CompletedTasks.Count"
                                ActiveFilter="@_kpiFilter"
                                OnSelectFilter="ToggleKpiFilter" />
            }
        </Actions>
    </MPageHeader>
</div>

@if (_isLoading)
{
    <MLoadingState Label="טוענת משימות…" />
}
else if (_loadError)
{
    <MEmptyState Title="אירעה שגיאה בטעינת המשימות"
                 Description="נסי לרענן את הדף." />
}
else if (!HasData)
{
    <MEmptyState Title="לא שויכת לפרויקט עדיין"
                 Description="פני למנחה שלך להשמת הצוות." />
}
else
{
    <div class="tsk-page">

        @*
            ── דורש התייחסות ──
            A cross-cutting view: these tasks still belong to their milestones in
            משימות הפרויקט below. Hidden entirely when empty — the Design has no
            empty state for this band, and a permanently empty rose-dotted strip
            would read as an alert that isn't one.
        *@
        @if (AttentionTasks.Count > 0)
        {
            <TaskAttentionSection Tasks="@AttentionTasks" OnOpenDetail="OpenDetail" />
        }

        @*
            ── Active KPI filter ──
            The Design surfaces the active filter as a removable chip rather than
            a permanent toolbar; clearing it here and pressing the KPI again are
            the same action.
        *@
        @if (!string.IsNullOrEmpty(_kpiFilter))
        {
            <div class="tsk-filterbar">
                <div class="tsk-filterbar-main">
                    <span class="tsk-filterbar-label">מסנן פעיל:</span>
                    <span class="tsk-filterbar-chip">@FilterChipLabel</span>
                </div>
                <button type="button" class="tsk-filterbar-clear" @onclick="ClearKpiFilter">
                    ✕ נקה סינון
                </button>
            </div>
        }

        <!-- ── Project + Team, side by side (Design: 1.6fr / 1fr) ── -->
        <div id="task-sections" class="tsk-sections">
            <ProjectTasksSection Groups="@VisibleGroups"
                                 CurrentMilestoneIds="@CurrentMilestoneIds"
                                 EmptyMessage="@SectionEmptyMessage"
                                 OnOpenDetail="OpenDetail" />

            <TeamTasksSection Tasks="@_teamTasks"
                              Filter="@TeamFilter"
                              EmptyTitle="@TeamEmptyTitle"
                              OnChanged="StateHasChanged" />
        </div>

    </div>
}
@code {
    [CascadingParameter] private User? _user { get; set; }
    [Parameter, SupplyParameterFromQuery] public int? TaskId { get; set; }

    private TasksPageDto?      _data;
    /// <summary>Canonical project context for the hero's current-milestone
    /// line. Cached per browser tab by ProjectContextService, so this is a
    /// cache hit — the sidebar has already fetched it.</summary>
    private ProjectContextDto? _context;
    private bool               _isLoading = true;
    private bool               _loadError = false;

    // ── KPI filter ────────────────────────────────────────────────────────────
    // "" | "week" | "done". The Design's only filter axis: two of the four KPI
    // cards are toggles, the other two are anchors. Pressing the active one
    // clears it, matching the reference's `kpiFilter === key ? null : key`.
    private string _kpiFilter = "";

    // Team tasks — a separate, student-created work layer (TeamTaskDto), loaded
    // from the same ITeamTasksService the dashboard card uses. Owned by the page
    // rather than by TeamTasksSection so the KPI count and the list can never
    // disagree about how many there are.
    private List<TeamTaskDto> _teamTasks = new();

    // Search and sort are retained but no longer rendered: the finalized Tasks
    // screen has no toolbar (the System Master assigns the search field to
    // Knowledge Center). ApplySearchSort still runs, so the ordering behaviour
    // and this code path stay live and can be re-exposed without rework.
    private string _searchText = "";
    // "due" | "priority" | "updated"
    private string _sortKey = "due";

    // Milestone title lookup, still used by TaskDetailModal callers.
    private Dictionary<int, string> _taskMilestoneMap = new();

    // ── Task detail modal ────────────────────────────────────────────────────
    private int _detailTaskId = 0;

    // ── Submission modal ─────────────────────────────────────────────────────
    private int     _submissionTaskId  = 0;
    private int     _editSubmissionId  = 0;
    private string? _editDriveUrl;
    private string? _editNotes;

    // ── Moodle confirmation ───────────────────────────────────────────────────
    private int    _moodleSubId  = 0;
    private bool   _moodleBusy  = false;
    private string _moodleError = "";

    // ── Delete confirmation ───────────────────────────────────────────────────
    private int    _deleteSubId  = 0;
    private bool   _deleteBusy  = false;
    private string _deleteError = "";

    // ── Lifecycle ─────────────────────────────────────────────────────────────
    protected override async Task OnInitializedAsync()
    {
        Nav.LocationChanged += OnLocationChanged;

        await LoadDataAsync();

        // Auto-open from ?taskId=N deep link (e.g. from dashboard card or notification)
        if (TaskId.HasValue && TaskId.Value > 0)
            _detailTaskId = TaskId.Value;
    }

    // ── KPI anchor scrolling ──────────────────────────────────────────────────
    // Two of the four KPI cards are real links to a section on this page, as the
    // Design draws them. Blazor's router intercepts the click and updates the URL
    // but does not scroll to the fragment, so the scroll is driven here through
    // gradify.scrollToAnchor, added next to the existing scrollIntoView helper
    // in wwwroot/js/gradify-interop.js (that one uses block:'nearest' and so
    // does nothing while any part of the section is still on screen).
    private string? _pendingFragment;

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        _pendingFragment = FragmentOf(e.Location);
        if (_pendingFragment is not null) InvokeAsync(StateHasChanged);
    }

    private static string? FragmentOf(string uri)
    {
        int hash = uri.IndexOf('#');
        if (hash < 0 || hash == uri.Length - 1) return null;
        return uri[(hash + 1)..];
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // On first render the fragment may already be in the URL (a shared or
        // reloaded deep link), so it is read from the current location too.
        var fragment = _pendingFragment ?? (firstRender ? FragmentOf(Nav.Uri) : null);
        if (fragment is null) return;

        _pendingFragment = null;
        await JS.InvokeVoidAsync("gradify.scrollToAnchor", fragment);
    }

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;

    private async Task LoadDataAsync()
    {
        // Both calls hit existing endpoints; team tasks were already being
        // served to the dashboard, this page simply never asked for them.
        var tasksTask   = TasksService.GetTasksAsync();
        var teamTask    = TeamTasksService.GetAsync();
        var contextTask = ProjectContext.GetAsync();

        _data      = await tasksTask;
        _teamTasks = await teamTask;
        _context   = await contextTask;

        _loadError = _data is null;
        _isLoading = false;
        BuildMilestoneMap();
    }

    private void BuildMilestoneMap()
    {
        _taskMilestoneMap = AllTasksGroups
            .SelectMany(g => g.Tasks.Select(t => (t.Id, g.MilestoneTitle)))
            .GroupBy(x => x.Id)
            .ToDictionary(g => g.Key, g => g.First().MilestoneTitle);
    }

    // ── KPI filter ────────────────────────────────────────────────────────────
    private void ToggleKpiFilter(string key) =>
        _kpiFilter = _kpiFilter == key ? "" : key;

    private void ClearKpiFilter() => _kpiFilter = "";

    private string FilterChipLabel => _kpiFilter switch
    {
        "done"      => "משימות שהושלמו",
        "attention" => "דורש התייחסות",
        _           => "הגשה בשבוע הקרוב",
    };

    // Retained (not rendered) — see the field declarations above.
    private void OnSearchChanged(ChangeEventArgs e) => _searchText = e.Value?.ToString() ?? "";

    private void OnSortChanged(ChangeEventArgs e) => _sortKey = e.Value?.ToString() ?? "due";

    // ── Submission modal handlers ─────────────────────────────────────────────
    private async Task CloseSubmission()
    {
        _submissionTaskId = 0;
        _editSubmissionId = 0;
        _editDriveUrl     = null;
        _editNotes        = null;
        await LoadDataAsync();
    }

    // ── Detail modal handlers ─────────────────────────────────────────────────
    private void OpenDetail(int taskId)      => _detailTaskId = taskId;
    private void CloseDetail()               => _detailTaskId = 0;

    private void OpenSubmissionFromDetail(int taskId)
    {
        _detailTaskId     = 0;
        _submissionTaskId = taskId;
    }

    private void OnEditFromDetail((int TaskId, int SubmissionId, string? DriveUrl, string? Notes) e)
    {
        _editSubmissionId = e.SubmissionId;
        _editDriveUrl     = e.DriveUrl;
        _editNotes        = e.Notes;
        _submissionTaskId = e.TaskId;
    }

    private void OnDeleteFromDetail(int submissionId)
    {
        _deleteSubId  = submissionId;
        _deleteError  = "";
        _deleteBusy   = false;
    }

    private void OnMarkMoodleFromDetail(int submissionId)
    {
        _moodleSubId  = submissionId;
        _moodleError  = "";
        _moodleBusy   = false;
    }

    // ── Moodle confirmation ───────────────────────────────────────────────────
    private void CancelMoodle()
    {
        if (_moodleBusy) return;
        _moodleSubId  = 0;
        _moodleError  = "";
    }

    private async Task ConfirmMoodleAsync()
    {
        if (_moodleSubId <= 0) return;
        _moodleBusy  = true;
        _moodleError = "";
        var (ok, _, _, err) = await SubmissionsService.MarkMoodleSubmittedAsync(_moodleSubId);
        if (!ok)
        {
            _moodleError = string.IsNullOrWhiteSpace(err) ? "הסימון נכשל. נסה/י שנית." : err;
            _moodleBusy  = false;
            return;
        }
        _moodleSubId = 0;
        _moodleBusy  = false;
        await LoadDataAsync();
    }

    // ── Delete confirmation ───────────────────────────────────────────────────
    private void CancelDelete()
    {
        if (_deleteBusy) return;
        _deleteSubId  = 0;
        _deleteError  = "";
    }

    private async Task ConfirmDeleteAsync()
    {
        if (_deleteSubId <= 0) return;
        _deleteBusy  = true;
        _deleteError = "";
        var (ok, err) = await SubmissionsService.DeleteMySubmissionAsync(_deleteSubId);
        if (!ok)
        {
            _deleteError = string.IsNullOrWhiteSpace(err) ? "מחיקת ההגשה נכשלה. נסה/י שנית." : err;
            _deleteBusy  = false;
            return;
        }
        _deleteSubId = 0;
        _deleteBusy  = false;
        await LoadDataAsync();
    }
    // ══════════════════════════════════════════════════════════════════════════
    //  DATA → DESIGN MAPPING
    //  Every section below is a VIEW over the data the page already loads. No
    //  business rule changed: TaskStatusHelpers still decides what a task's
    //  status is, and the server still decides which milestone it belongs to.
    // ══════════════════════════════════════════════════════════════════════════

    private bool HasData => _data is not null && !string.IsNullOrEmpty(_data.ProjectTitle);

    // Both group sets, so completed milestones can be shown alongside active ones.
    private List<TaskMilestoneGroupDto> AllTasksGroups =>
        _data is null ? new() : _data.ActiveGroups.Concat(_data.CompletedGroups).ToList();

    private List<TaskItemDto> AllTasks =>
        AllTasksGroups.SelectMany(g => g.Tasks).ToList();

    // ── Current milestone (hero subtitle + Project section emphasis) ──────────
    // The server already marks visibility with IsCurrentlyOpen and progress with
    // MilestoneStatus. Prefer an open, in-progress milestone; fall back to any
    // open one, then to the first non-completed by OrderIndex. Null when there
    // is genuinely no current milestone — the subtitle then renders nothing
    // rather than inventing a date.
    private TaskMilestoneGroupDto? CurrentMilestone
    {
        get
        {
            if (_data is null) return null;
            var active = _data.ActiveGroups;
            return active.FirstOrDefault(g => g.IsCurrentlyOpen && g.MilestoneStatus == "InProgress")
                ?? active.FirstOrDefault(g => g.IsCurrentlyOpen)
                ?? active.Where(g => g.MilestoneStatus != "Completed")
                         .OrderBy(g => g.OrderIndex)
                         .FirstOrDefault();
        }
    }

    private IReadOnlySet<int> CurrentMilestoneIds =>
        CurrentMilestone is null
            ? new HashSet<int>()
            : new HashSet<int> { CurrentMilestone.ProjectMilestoneId };

    // ── A. דורש התייחסות ──────────────────────────────────────────────────────
    // Returned by the mentor, past due, or flagged urgent by the server. A
    // cross-cutting view: these same tasks still appear under their milestone in
    // משימות הפרויקט, exactly as the brief requires — nothing is moved or copied
    // in the domain model.
    /// <summary>"This task needs the student." Extracted from AttentionTasks so
    /// the דורש התייחסות tab filters on exactly the predicate the attention
    /// band is built from, rather than a second copy of it.</summary>
    private static bool IsAttentionTask(TaskItemDto t) =>
        (TaskStatusHelpers.GetCategory(t) == TaskStatusHelpers.TaskCategory.Returned
         || TaskStatusHelpers.IsOverdue(t)
         || t.IsUrgent)
        && TaskStatusHelpers.GetCategory(t) != TaskStatusHelpers.TaskCategory.Completed;

    private List<TaskItemDto> AttentionTasks =>
        AllTasks
            .Where(IsAttentionTask)
            .OrderBy(t => t.DueDate ?? DateTime.MaxValue)
            .ToList();

    // ── B. משימות הפרויקט ─────────────────────────────────────────────────────
    // Real milestone groups, with the KPI filter applied to the tasks inside
    // each. Mirrors the reference: a milestone whose tasks all filter out is
    // dropped, and completed milestones are hidden while the "week" filter is on
    // (showCompletedMilestones: kpiFilter !== 'week').
    private List<TaskMilestoneGroupDto> VisibleGroups
    {
        get
        {
            var groups = AllTasksGroups
                .OrderByDescending(g => CurrentMilestoneIds.Contains(g.ProjectMilestoneId))
                .ThenBy(g => g.OrderIndex)
                .ToList();

            if (_kpiFilter == "week")
                groups = groups.Where(g => g.MilestoneStatus != "Completed").ToList();

            return groups
                .Select(g => new TaskMilestoneGroupDto
                {
                    ProjectMilestoneId = g.ProjectMilestoneId,
                    MilestoneTitle     = g.MilestoneTitle,
                    OrderIndex         = g.OrderIndex,
                    MilestoneStatus    = g.MilestoneStatus,
                    OpenDate           = g.OpenDate,
                    DueDate            = g.DueDate,
                    CloseDate          = g.CloseDate,
                    IsCurrentlyOpen    = g.IsCurrentlyOpen,
                    DoneCount          = g.DoneCount,
                    TotalCount         = g.TotalCount,
                    Tasks              = ApplySearchSort(g.Tasks.Where(PassesKpiFilter)).ToList(),
                })
                .Where(g => g.Tasks.Count > 0)
                .ToList();
        }
    }

    private bool PassesKpiFilter(TaskItemDto t) => _kpiFilter switch
    {
        // "attention" is new with the final design, which makes דורש התייחסות a
        // tab like its neighbours rather than an anchor to a section. It reuses
        // IsAttentionTask — the SAME predicate AttentionTasks is built from, so
        // the tab and the band above it can never disagree about what needs the
        // student.
        "attention" => IsAttentionTask(t),
        "week" => TaskStatusHelpers.GetCategory(t) != TaskStatusHelpers.TaskCategory.Completed && IsDueThisWeek(t.DueDate),
        "done" => TaskStatusHelpers.GetCategory(t) == TaskStatusHelpers.TaskCategory.Completed,
        _      => true,
    };

    // ── C. משימות צוות ────────────────────────────────────────────────────────
    // The same filter axis reaches the team panel, as it does in the reference.
    private Func<TeamTaskDto, bool>? TeamFilter => _kpiFilter switch
    {
        // Team tasks carry no attention state of their own, so the attention
        // tab hides the panel's rows rather than inventing one for them.
        "attention" => _ => false,
        "week" => t => !t.IsDone && IsDueThisWeek(t.DueDate),
        "done" => t => t.IsDone,
        _      => null,
    };

    // ── D. הושלמו ─────────────────────────────────────────────────────────────
    // No section of its own in the finalized design — a KPI count and a filter.
    // The underlying completion data and logic are untouched.
    private List<TaskItemDto> CompletedTasks =>
        AllTasks.Where(t => TaskStatusHelpers.GetCategory(t) == TaskStatusHelpers.TaskCategory.Completed).ToList();

    // ── KPI: להגשה השבוע ──────────────────────────────────────────────────────
    // Derived client-side from DueDate, per the reference's dueThisWeek (today
    // through today + 7 days, inclusive). Counts project tasks and team tasks
    // together, since the filter it drives applies to both panels.
    private int DueThisWeekCount =>
        AllTasks.Count(t => TaskStatusHelpers.GetCategory(t) != TaskStatusHelpers.TaskCategory.Completed
                            && IsDueThisWeek(t.DueDate))
        + _teamTasks.Count(t => !t.IsDone && IsDueThisWeek(t.DueDate));

    private static bool IsDueThisWeek(DateTime? due) =>
        due.HasValue
        && due.Value.Date >= DateTime.Today
        && due.Value.Date <= DateTime.Today.AddDays(7);

    // ── Empty-state copy, per active filter ───────────────────────────────────
    private string SectionEmptyMessage => _kpiFilter switch
    {
        "done" => "אין משימות שהושלמו",
        "week" => "אין משימות להגשה בשבוע הקרוב",
        _      => "אין משימות בפרויקט זה",
    };

    private string TeamEmptyTitle => _kpiFilter switch
    {
        "done" => "אין משימות צוות שהושלמו",
        "week" => "אין משימות צוות להגשה בשבוע הקרוב",
        _      => "אין עדיין משימות צוות",
    };

    // ── Search + sort — retained, not rendered ────────────────────────────────
    // "לפי עדכון אחרון" approximates last-updated from the closest available
    // signal (last submission, else completion time), since TaskItemDto has no
    // stored UpdatedAt column.
    private List<TaskItemDto> ApplySearchSort(IEnumerable<TaskItemDto> tasks)
    {
        var filtered = string.IsNullOrWhiteSpace(_searchText)
            ? tasks
            : tasks.Where(t => t.Title.Contains(_searchText, StringComparison.OrdinalIgnoreCase));

        return _sortKey switch
        {
            "priority" => filtered.OrderByDescending(t => t.IsMandatory)
                                  .ThenBy(t => t.DueDate ?? DateTime.MaxValue)
                                  .ToList(),
            "updated"  => filtered.OrderByDescending(t => t.LatestSubmittedAt ?? t.CompletedAt ?? DateTime.MinValue)
                                  .ThenByDescending(t => t.Id)
                                  .ToList(),
            _          => filtered.OrderBy(t => t.DueDate ?? DateTime.MaxValue).ToList(),
        };
    }
}
