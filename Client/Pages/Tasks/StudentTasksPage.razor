@page "/tasks"
@layout AppLayout
@using Microsoft.AspNetCore.Authorization
@using AuthWithAdmin.Shared.AuthSharedModels
@using AuthWithAdmin.Client.Services
@using AuthWithAdmin.Client.Pages.Submissions
@inject ITasksService TasksService
@inject ITaskSubmissionsService SubmissionsService
@inject IProjectContextService ProjectContext
@attribute [Authorize]

<!-- ── Task detail modal ── -->
<TaskDetailModal TaskId="@_detailTaskId"
                 OnClose="CloseDetail"
                 OnOpenSubmission="OpenSubmissionFromDetail"
                 OnEditMySubmission="OnEditFromDetail"
                 OnDeleteMySubmission="OnDeleteFromDetail"
                 OnMarkMoodleSubmitted="OnMarkMoodleFromDetail" />

<!-- ── Submission upload / resubmit modal ── -->
<SubmissionModal TaskId="@_submissionTaskId"
                 EditSubmissionId="@_editSubmissionId"
                 InitialDriveUrl="@_editDriveUrl"
                 InitialNotes="@_editNotes"
                 OnClose="CloseSubmission" />

<!-- ── Moodle confirmation modal ── -->
@if (_moodleSubId > 0)
{
    <div class="tsk-confirm-overlay" @onclick="CancelMoodle">
        <div class="tsk-confirm-modal" dir="rtl" @onclick:stopPropagation="true"
             role="dialog" aria-modal="true" aria-labelledby="tsk-moodle-title">
            <div class="tsk-confirm-head">
                <span class="oi oi-question-mark tsk-confirm-icon-ok" aria-hidden="true"></span>
                <h3 class="tsk-confirm-title" id="tsk-moodle-title">אישור הגשה במודל</h3>
            </div>
            <p class="tsk-confirm-body">האם את/ה בטוח/ה שההגשה בוצעה במודל?</p>
            @if (!string.IsNullOrEmpty(_moodleError))
            {
                <div class="tsk-confirm-error">@_moodleError</div>
            }
            <div class="tsk-confirm-actions">
                <button class="tsk-confirm-cancel" @onclick="CancelMoodle" disabled="@_moodleBusy">ביטול</button>
                <button class="tsk-confirm-ok" @onclick="ConfirmMoodleAsync" disabled="@_moodleBusy">
                    @if (_moodleBusy)
                    {
                        <span class="tsk-spinner-sm"></span>
                        <span>שומר…</span>
                    }
                    else
                    {
                        <span class="oi oi-check" aria-hidden="true"></span>
                        <span>כן, הוגש</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

<!-- ── Delete confirmation modal ── -->
@if (_deleteSubId > 0)
{
    <div class="tsk-confirm-overlay" @onclick="CancelDelete">
        <div class="tsk-confirm-modal" dir="rtl" @onclick:stopPropagation="true"
             role="dialog" aria-modal="true" aria-labelledby="tsk-delete-title">
            <div class="tsk-confirm-head">
                <span class="oi oi-warning tsk-confirm-icon-warn" aria-hidden="true"></span>
                <h3 class="tsk-confirm-title" id="tsk-delete-title">ביטול הגשה</h3>
            </div>
            <p class="tsk-confirm-body">האם למחוק את ההגשה? המשימה תחזור למצב פתוח להגשה.</p>
            @if (!string.IsNullOrEmpty(_deleteError))
            {
                <div class="tsk-confirm-error">@_deleteError</div>
            }
            <div class="tsk-confirm-actions">
                <button class="tsk-confirm-cancel" @onclick="CancelDelete" disabled="@_deleteBusy">ביטול</button>
                <button class="tsk-confirm-delete" @onclick="ConfirmDeleteAsync" disabled="@_deleteBusy">
                    @if (_deleteBusy)
                    {
                        <span class="tsk-spinner-sm"></span>
                        <span>מוחק…</span>
                    }
                    else
                    {
                        <span class="oi oi-trash" aria-hidden="true"></span>
                        <span>מחק</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

@if (_isLoading)
{
    <div class="tsk-loading">
        <div class="tsk-spinner"></div>
        <span>טוענת משימות…</span>
    </div>
}
else if (_loadError)
{
    <div class="tsk-state-msg tsk-error">
        <span class="oi oi-warning" aria-hidden="true"></span>
        <p>אירעה שגיאה בטעינת המשימות. נסי לרענן את הדף.</p>
    </div>
}
else if (_data is null || string.IsNullOrEmpty(_data.ProjectTitle))
{
    <div class="tsk-state-msg">
        <span class="oi oi-info" aria-hidden="true"></span>
        <p>לא שויכת לפרויקט עדיין. פני למנחה שלך להשמת הצוות.</p>
    </div>
}
else
{
    <div class="tsk-page">

        <!-- ── Page header ── -->
        <div class="tsk-header">
            <h1 class="tsk-page-title">המשימות שלי</h1>
        </div>

        <!-- ── Persistent "where am I" context — stays visible while scrolling ── -->
        <CurrentProgressStrip Context="@_projectCtx" />

        <!-- ── 1. דורש ממני טיפול — the page's primary focus ── -->
        <TaskFlatList SectionTitle="דורש ממני טיפול"
                      Subtitle="@HeroSummary"
                      Tasks="@ActionRequiredTasks"
                      MilestoneTitleLookup="@_taskMilestoneMap"
                      EmptyMessage="כל המשימות בסדר — אין משימות שדורשות פעולה כרגע."
                      EmptyIsPositive="true"
                      IsUrgent="true"
                      IsHero="true"
                      OnOpenDetail="OpenDetail" />

        <!-- ── 2. ממתין לאחרים — visually secondary look-ahead context ── -->
        <TaskFlatList SectionTitle="ממתין לאחרים"
                      Tasks="@WaitingOnOthersTasks"
                      MilestoneTitleLookup="@_taskMilestoneMap"
                      EmptyMessage="אין כרגע משימות שממתינות למישהו אחר."
                      IsMuted="true"
                      OnOpenDetail="OpenDetail" />

        <!-- ── 3. המשימות הקרובות — visually secondary look-ahead context ── -->
        <TaskFlatList SectionTitle="המשימות הקרובות"
                      Tasks="@UpcomingTasks"
                      MilestoneTitleLookup="@_taskMilestoneMap"
                      EmptyMessage="אין משימות קרובות נוספות כרגע."
                      IsMuted="true"
                      OnOpenDetail="OpenDetail" />

        <!-- ── 4. כל המשימות — reference catalogue, collapsed by default ── -->
        <div class="tsk-all-section">
            <button class="tsk-all-toggle" @onclick="ToggleAllTasks" aria-expanded="@_showAllTasks">
                <span class="oi @(_showAllTasks ? "oi-chevron-top" : "oi-chevron-bottom")" aria-hidden="true"></span>
                <span class="tsk-all-title">כל המשימות</span>
                <span class="tsk-all-hint">קטלוג מלא לעיון</span>
            </button>

            @if (_showAllTasks)
            {
                <div class="tsk-tabs" role="tablist" aria-label="סינון כל המשימות">
                    <button class="tsk-tab @(_activeFilter == "all" ? "tsk-tab-active" : "")"
                            role="tab" aria-selected="@(_activeFilter == "all")"
                            @onclick='() => SetFilter("all")'>הכול</button>

                    <button class="tsk-tab @(_activeFilter == "submissions" ? "tsk-tab-active" : "")"
                            role="tab" aria-selected="@(_activeFilter == "submissions")"
                            @onclick='() => SetFilter("submissions")'>הגשות</button>

                    <button class="tsk-tab @(_activeFilter == "tasks" ? "tsk-tab-active" : "")"
                            role="tab" aria-selected="@(_activeFilter == "tasks")"
                            @onclick='() => SetFilter("tasks")'>משימות</button>
                </div>

                <TaskMilestoneAccordion SectionTitle=""
                                        Groups="@FilteredAllGroups"
                                        IsCompletedSection="false"
                                        ShowAddButton="false"
                                        EmptyMessage="@ActiveEmptyMessage"
                                        OnOpenSubmission="OpenSubmission"
                                        OnOpenDetail="OpenDetail" />
            }
        </div>

    </div>
}

@code {
    [CascadingParameter] private User? _user { get; set; }
    [Parameter, SupplyParameterFromQuery] public int? TaskId { get; set; }

    private TasksPageDto?      _data;
    private ProjectContextDto? _projectCtx;
    private bool               _isLoading = true;
    private bool               _loadError = false;

    /// <summary>Scopes only the "כל המשימות" catalog section (all / הגשות / משימות).
    /// The three primary urgency sections above are never filtered by this.</summary>
    private string          _activeFilter = "all";

    /// <summary>"כל המשימות" is a reference catalogue, not a daily-priority
    /// section — collapsed by default so it never competes visually with
    /// the actionable sections above it.</summary>
    private bool             _showAllTasks = false;

    // Milestone title lookup shared by every flat-list section + the catalog accordion.
    private Dictionary<int, string> _taskMilestoneMap = new();

    // ── Task detail modal ────────────────────────────────────────────────────
    private int _detailTaskId = 0;

    // ── Submission modal ─────────────────────────────────────────────────────
    private int     _submissionTaskId  = 0;
    private int     _editSubmissionId  = 0;
    private string? _editDriveUrl;
    private string? _editNotes;

    // ── Moodle confirmation ───────────────────────────────────────────────────
    private int    _moodleSubId  = 0;
    private bool   _moodleBusy  = false;
    private string _moodleError = "";

    // ── Delete confirmation ───────────────────────────────────────────────────
    private int    _deleteSubId  = 0;
    private bool   _deleteBusy  = false;
    private string _deleteError = "";

    // ── Lifecycle ─────────────────────────────────────────────────────────────
    protected override async Task OnInitializedAsync()
    {
        // ProjectContextService caches after its first call, so this costs no
        // extra round trip if the sidebar has already fetched it this session.
        var contextTask = ProjectContext.GetAsync();

        await LoadDataAsync();
        _projectCtx = await contextTask;

        // Auto-open from ?taskId=N deep link (e.g. from dashboard card or notification)
        if (TaskId.HasValue && TaskId.Value > 0)
            _detailTaskId = TaskId.Value;
    }

    private async Task LoadDataAsync()
    {
        _data      = await TasksService.GetTasksAsync();
        _loadError = _data is null;
        _isLoading = false;
        BuildMilestoneMap();
    }

    private void BuildMilestoneMap()
    {
        _taskMilestoneMap = _data?.ActiveGroups
            .SelectMany(g => g.Tasks.Select(t => (t.Id, g.MilestoneTitle)))
            .GroupBy(x => x.Id)
            .ToDictionary(g => g.Key, g => g.First().MilestoneTitle)
            ?? new();
    }

    // ── "כל המשימות" catalog filter + collapse toggle ──────────────────────────
    private void SetFilter(string filter) => _activeFilter = filter;
    private void ToggleAllTasks() => _showAllTasks = !_showAllTasks;

    // ── Hero summary — answers "what should I do now" before the list itself ──
    // TODO (future sprint, not Sprint 1): evolve from a task-count summary
    // into a recommendation engine that names the single next best action,
    // rather than only reporting how many items need attention.
    private string HeroSummary => ActionRequiredTasks.Count switch
    {
        0 => "הכול בסדר — אין כרגע משימות שדורשות ממך טיפול.",
        1 => "יש לך משימה אחת שדורשת טיפול.",
        _ => $"יש לך {ActionRequiredTasks.Count} משימות שדורשות טיפול.",
    };

    // ── Submission modal handlers ─────────────────────────────────────────────
    private void OpenSubmission(int taskId)
    {
        _editSubmissionId = 0;
        _editDriveUrl     = null;
        _editNotes        = null;
        _submissionTaskId = taskId;
    }

    private async Task CloseSubmission()
    {
        _submissionTaskId = 0;
        _editSubmissionId = 0;
        _editDriveUrl     = null;
        _editNotes        = null;
        await LoadDataAsync();
    }

    // ── Detail modal handlers ─────────────────────────────────────────────────
    private void OpenDetail(int taskId)      => _detailTaskId = taskId;
    private void CloseDetail()               => _detailTaskId = 0;

    private void OpenSubmissionFromDetail(int taskId)
    {
        _detailTaskId     = 0;
        _submissionTaskId = taskId;
    }

    private void OnEditFromDetail((int TaskId, int SubmissionId, string? DriveUrl, string? Notes) e)
    {
        _editSubmissionId = e.SubmissionId;
        _editDriveUrl     = e.DriveUrl;
        _editNotes        = e.Notes;
        _submissionTaskId = e.TaskId;
    }

    private void OnDeleteFromDetail(int submissionId)
    {
        _deleteSubId  = submissionId;
        _deleteError  = "";
        _deleteBusy   = false;
    }

    private void OnMarkMoodleFromDetail(int submissionId)
    {
        _moodleSubId  = submissionId;
        _moodleError  = "";
        _moodleBusy   = false;
    }

    // ── Moodle confirmation ───────────────────────────────────────────────────
    private void CancelMoodle()
    {
        if (_moodleBusy) return;
        _moodleSubId  = 0;
        _moodleError  = "";
    }

    private async Task ConfirmMoodleAsync()
    {
        if (_moodleSubId <= 0) return;
        _moodleBusy  = true;
        _moodleError = "";
        var (ok, _, _, err) = await SubmissionsService.MarkMoodleSubmittedAsync(_moodleSubId);
        if (!ok)
        {
            _moodleError = string.IsNullOrWhiteSpace(err) ? "הסימון נכשל. נסה/י שנית." : err;
            _moodleBusy  = false;
            return;
        }
        _moodleSubId = 0;
        _moodleBusy  = false;
        await LoadDataAsync();
    }

    // ── Delete confirmation ───────────────────────────────────────────────────
    private void CancelDelete()
    {
        if (_deleteBusy) return;
        _deleteSubId  = 0;
        _deleteError  = "";
    }

    private async Task ConfirmDeleteAsync()
    {
        if (_deleteSubId <= 0) return;
        _deleteBusy  = true;
        _deleteError = "";
        var (ok, err) = await SubmissionsService.DeleteMySubmissionAsync(_deleteSubId);
        if (!ok)
        {
            _deleteError = string.IsNullOrWhiteSpace(err) ? "מחיקת ההגשה נכשלה. נסה/י שנית." : err;
            _deleteBusy  = false;
            return;
        }
        _deleteSubId = 0;
        _deleteBusy  = false;
        await LoadDataAsync();
    }

    // ── Computed: "כל המשימות" catalog filter content ──────────────────────────

    private string ActiveEmptyMessage => _activeFilter switch
    {
        "submissions" => "אין משימות הגשה בפרויקט זה",
        "tasks"       => "אין משימות בפרויקט זה",
        _             => "אין משימות בפרויקט זה",
    };

    // All milestones: active first, completed at the end — never the other way around.
    private List<TaskMilestoneGroupDto> AllGroups =>
        _data is null ? new() : _data.ActiveGroups.Concat(_data.CompletedGroups).ToList();

    private List<TaskMilestoneGroupDto> FilteredAllGroups
    {
        get
        {
            if (_data is null) return new();
            return _activeFilter switch
            {
                "submissions" => FilterByType(AllGroups, isSubmission: true),
                "tasks"       => FilterByType(AllGroups, isSubmission: false),
                _             => AllGroups,
            };
        }
    }

    private static List<TaskMilestoneGroupDto> FilterByType(
        List<TaskMilestoneGroupDto> groups, bool isSubmission)
    {
        return groups
            .Select(g => new TaskMilestoneGroupDto
            {
                ProjectMilestoneId = g.ProjectMilestoneId,
                MilestoneTitle     = g.MilestoneTitle,
                OrderIndex         = g.OrderIndex,
                MilestoneStatus    = g.MilestoneStatus,
                OpenDate           = g.OpenDate,
                DueDate            = g.DueDate,
                CloseDate          = g.CloseDate,
                IsCurrentlyOpen    = g.IsCurrentlyOpen,
                DoneCount          = g.DoneCount,
                TotalCount         = g.TotalCount,
                Tasks              = g.Tasks.Where(t => t.IsSubmission == isSubmission).ToList(),
            })
            .Where(g => g.Tasks.Count > 0)
            .ToList();
    }

    // ── Computed: the three primary urgency buckets ────────────────────────────
    // All three read from ActiveGroups only (server already excludes Done tasks
    // there) and are mutually exclusive by construction: TaskRequiresAction
    // already returns false for "PendingMentorReview" and for "Done", so a task
    // lands in exactly one of the three buckets below. None of them group by
    // milestone — milestone still shows as an inline meta chip per row via
    // _taskMilestoneMap, for orientation only, not as a sort/grouping axis.

    // 1. דורש ממני טיפול — returned/needs-revision, approved-pending-Moodle,
    //    overdue, or due within 3 days.
    private IReadOnlyList<TaskItemDto> ActionRequiredTasks
    {
        get
        {
            if (_data is null) return Array.Empty<TaskItemDto>();

            return _data.ActiveGroups
                .SelectMany(g => g.Tasks)
                .Where(TaskStatusHelpers.TaskRequiresAction)
                .OrderBy(t =>
                {
                    // Overdue: most overdue first (most negative days = lowest)
                    if (t.DueDate.HasValue && t.DueDate.Value.Date < DateTime.Today)
                        return (t.DueDate.Value.Date - DateTime.Today).TotalDays;
                    // Returned/approved: high urgency with no date sort by 0
                    string r = TaskStatusHelpers.ResolveDisplayStatus(t);
                    if (r is "ReturnedByMentor" or "ReturnedForRevision") return 0;
                    if (r == "ApprovedByMentor") return 0;
                    // Due soon: sort ascending
                    return t.DueDate.HasValue ? (t.DueDate.Value.Date - DateTime.Today).TotalDays : 100;
                })
                .ToList();
        }
    }

    // 2. ממתין לאחרים — submitted, sitting with the mentor for review.
    //    Longest-waiting first, since that's the one most worth surfacing.
    private IReadOnlyList<TaskItemDto> WaitingOnOthersTasks
    {
        get
        {
            if (_data is null) return Array.Empty<TaskItemDto>();

            return _data.ActiveGroups
                .SelectMany(g => g.Tasks)
                .Where(t => TaskStatusHelpers.ResolveDisplayStatus(t) == "PendingMentorReview")
                .OrderBy(t => t.LatestSubmittedAt ?? DateTime.MaxValue)
                .ToList();
        }
    }

    // 3. המשימות הקרובות — everything left: plain Open/InProgress work that
    //    isn't yet urgent. Soonest-due first; no-due-date tasks sort last.
    private IReadOnlyList<TaskItemDto> UpcomingTasks
    {
        get
        {
            if (_data is null) return Array.Empty<TaskItemDto>();

            return _data.ActiveGroups
                .SelectMany(g => g.Tasks)
                .Where(t => !TaskStatusHelpers.TaskRequiresAction(t)
                         && TaskStatusHelpers.ResolveDisplayStatus(t) != "PendingMentorReview")
                .OrderBy(t => t.DueDate ?? DateTime.MaxValue)
                .ToList();
        }
    }
}