@page "/tasks"
@layout AppLayout
@using Microsoft.AspNetCore.Authorization
@using AuthWithAdmin.Shared.AuthSharedModels
@using AuthWithAdmin.Client.Services
@using AuthWithAdmin.Client.Pages.Submissions
@inject ITasksService TasksService
@inject ITaskSubmissionsService SubmissionsService
@attribute [Authorize]

<!-- ── Task detail modal ── -->
<TaskDetailModal TaskId="@_detailTaskId"
                 OnClose="CloseDetail"
                 OnOpenSubmission="OpenSubmissionFromDetail"
                 OnEditMySubmission="OnEditFromDetail"
                 OnDeleteMySubmission="OnDeleteFromDetail"
                 OnMarkMoodleSubmitted="OnMarkMoodleFromDetail" />

<!-- ── Submission upload / resubmit modal ── -->
<SubmissionModal TaskId="@_submissionTaskId"
                 EditSubmissionId="@_editSubmissionId"
                 InitialDriveUrl="@_editDriveUrl"
                 InitialNotes="@_editNotes"
                 OnClose="CloseSubmission" />

<!-- ── Moodle confirmation modal ── -->
@if (_moodleSubId > 0)
{
    <div class="tsk-confirm-overlay" @onclick="CancelMoodle">
        <div class="tsk-confirm-modal" dir="rtl" @onclick:stopPropagation="true"
             role="dialog" aria-modal="true" aria-labelledby="tsk-moodle-title">
            <div class="tsk-confirm-head">
                <span class="oi oi-question-mark tsk-confirm-icon-ok" aria-hidden="true"></span>
                <h3 class="tsk-confirm-title" id="tsk-moodle-title">אישור הגשה במודל</h3>
            </div>
            <p class="tsk-confirm-body">האם את/ה בטוח/ה שההגשה בוצעה במודל?</p>
            @if (!string.IsNullOrEmpty(_moodleError))
            {
                <div class="tsk-confirm-error">@_moodleError</div>
            }
            <div class="tsk-confirm-actions">
                <button class="tsk-confirm-cancel" @onclick="CancelMoodle" disabled="@_moodleBusy">ביטול</button>
                <button class="tsk-confirm-ok" @onclick="ConfirmMoodleAsync" disabled="@_moodleBusy">
                    @if (_moodleBusy)
                    {
                        <span class="tsk-spinner-sm"></span>
                        <span>שומר…</span>
                    }
                    else
                    {
                        <span class="oi oi-check" aria-hidden="true"></span>
                        <span>כן, הוגש</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

<!-- ── Delete confirmation modal ── -->
@if (_deleteSubId > 0)
{
    <div class="tsk-confirm-overlay" @onclick="CancelDelete">
        <div class="tsk-confirm-modal" dir="rtl" @onclick:stopPropagation="true"
             role="dialog" aria-modal="true" aria-labelledby="tsk-delete-title">
            <div class="tsk-confirm-head">
                <span class="oi oi-warning tsk-confirm-icon-warn" aria-hidden="true"></span>
                <h3 class="tsk-confirm-title" id="tsk-delete-title">ביטול הגשה</h3>
            </div>
            <p class="tsk-confirm-body">האם למחוק את ההגשה? המשימה תחזור למצב פתוח להגשה.</p>
            @if (!string.IsNullOrEmpty(_deleteError))
            {
                <div class="tsk-confirm-error">@_deleteError</div>
            }
            <div class="tsk-confirm-actions">
                <button class="tsk-confirm-cancel" @onclick="CancelDelete" disabled="@_deleteBusy">ביטול</button>
                <button class="tsk-confirm-delete" @onclick="ConfirmDeleteAsync" disabled="@_deleteBusy">
                    @if (_deleteBusy)
                    {
                        <span class="tsk-spinner-sm"></span>
                        <span>מוחק…</span>
                    }
                    else
                    {
                        <span class="oi oi-trash" aria-hidden="true"></span>
                        <span>מחק</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

@if (_isLoading)
{
    <div class="tsk-loading">
        <div class="tsk-spinner"></div>
        <span>טוענת משימות…</span>
    </div>
}
else if (_loadError)
{
    <div class="tsk-state-msg tsk-error">
        <span class="oi oi-warning" aria-hidden="true"></span>
        <p>אירעה שגיאה בטעינת המשימות. נסי לרענן את הדף.</p>
    </div>
}
else if (_data is null || string.IsNullOrEmpty(_data.ProjectTitle))
{
    <div class="tsk-state-msg">
        <span class="oi oi-info" aria-hidden="true"></span>
        <p>לא שויכת לפרויקט עדיין. פני למנחה שלך להשמת הצוות.</p>
    </div>
}
else
{
    <div class="tsk-page">

        <!-- ── One continuous ambient canvas — summary, toolbar and the
             workflow sections are zones of the SAME surface (thin seams
             between them), not separate stacked components. The ambient
             gradient carries through the whole canvas, fading naturally
             into the task rows below rather than stopping at the summary. ── -->
        <div class="tsk-canvas">

            <div class="tsk-zone tsk-zone-summary">
                <TaskStatusOverview NeedsActionCount="@NeedsActionTasks.Count"
                                    ReadyToSubmitCount="@ReadyToSubmitTasks.Count"
                                    TeamCount="@TeamTasks.Count"
                                    CompletedCount="@CompletedTasks.Count"
                                    ActiveFilter="@_statusFilter"
                                    OnSelectFilter="SetStatusFilter" />
            </div>

            <div class="tsk-zone tsk-zone-toolbar">
                <div class="tsk-toolbar">
                    <div class="tsk-search">
                        <span class="oi oi-magnifying-glass" aria-hidden="true"></span>
                        <input type="text"
                               class="tsk-search-input"
                               placeholder="חיפוש משימות..."
                               value="@_searchText"
                               @oninput="OnSearchChanged" />
                    </div>
                    <TaskFilterPopover ActiveFilter="@_statusFilter" OnSelectFilter="SetStatusFilter" />
                    <select class="tsk-sort-select" value="@_sortKey" @onchange="OnSortChanged">
                        <option value="due">לפי תאריך יעד</option>
                        <option value="priority">לפי עדיפות</option>
                        <option value="updated">לפי עדכון אחרון</option>
                    </select>
                </div>
            </div>

            <div class="tsk-zone tsk-zone-sections">
                @if (_statusFilter == "all")
                {
                    <TaskWorkflowSection Title="דורש ממני פעולה" Icon="oi-bolt" Count="@NeedsActionTasks.Count">
                        <TaskCompactList Tasks="@DisplayedNeedsAction"
                                          MilestoneTitleLookup="@_taskMilestoneMap"
                                          StudentName="@_data?.StudentName"
                                          EmptyMessage='@EmptyMessageFor("action")'
                                          EmptyIsPositive='@EmptyIsPositiveFor("action")'
                                          OnOpenDetail="OpenDetail" />
                    </TaskWorkflowSection>

                    <TaskWorkflowSection Title="מוכן להגשה" Icon="oi-circle-check" Count="@ReadyToSubmitTasks.Count">
                        <TaskCompactList Tasks="@DisplayedReadyToSubmit"
                                          MilestoneTitleLookup="@_taskMilestoneMap"
                                          StudentName="@_data?.StudentName"
                                          EmptyMessage='@EmptyMessageFor("submit")'
                                          OnOpenDetail="OpenDetail" />
                    </TaskWorkflowSection>

                    <TaskWorkflowSection Title="משימות צוות" Icon="oi-people" Count="@TeamTasks.Count">
                        <TaskCompactList Tasks="@DisplayedTeam"
                                          MilestoneTitleLookup="@_taskMilestoneMap"
                                          StudentName="@_data?.StudentName"
                                          EmptyMessage='@EmptyMessageFor("team")'
                                          OnOpenDetail="OpenDetail" />
                    </TaskWorkflowSection>

                    <TaskWorkflowSection Title="הושלמו" Icon="oi-task" Count="@CompletedTasks.Count" Collapsible="true">
                        <TaskCompactList Tasks="@DisplayedCompleted"
                                          MilestoneTitleLookup="@_taskMilestoneMap"
                                          StudentName="@_data?.StudentName"
                                          EmptyMessage='@EmptyMessageFor("done")'
                                          OnOpenDetail="OpenDetail" />
                    </TaskWorkflowSection>
                }
                else
                {
                    <TaskWorkflowSection Title="@ActiveFilterTitle" Icon="@ActiveFilterIcon" Count="@DisplayedFlatList.Count">
                        <TaskCompactList Tasks="@DisplayedFlatList"
                                          MilestoneTitleLookup="@_taskMilestoneMap"
                                          StudentName="@_data?.StudentName"
                                          EmptyMessage="@EmptyMessageFor(_statusFilter)"
                                          EmptyIsPositive="@EmptyIsPositiveFor(_statusFilter)"
                                          OnOpenDetail="OpenDetail" />
                    </TaskWorkflowSection>
                }
            </div>

        </div>

    </div>
}

@code {
    [CascadingParameter] private User? _user { get; set; }
    [Parameter, SupplyParameterFromQuery] public int? TaskId { get; set; }

    private TasksPageDto?      _data;
    private bool               _isLoading = true;
    private bool               _loadError = false;

    // ── Unified workflow filter (synced with the summary/overview) ─────────────
    // "all" | "action" | "submit" | "team" | "done"
    private string _statusFilter = "all";
    private string _searchText   = "";
    // "due" | "priority" | "updated"
    private string _sortKey = "due";

    // Milestone title lookup shared by the task list.
    private Dictionary<int, string> _taskMilestoneMap = new();

    // ── Task detail modal ────────────────────────────────────────────────────
    private int _detailTaskId = 0;

    // ── Submission modal ─────────────────────────────────────────────────────
    private int     _submissionTaskId  = 0;
    private int     _editSubmissionId  = 0;
    private string? _editDriveUrl;
    private string? _editNotes;

    // ── Moodle confirmation ───────────────────────────────────────────────────
    private int    _moodleSubId  = 0;
    private bool   _moodleBusy  = false;
    private string _moodleError = "";

    // ── Delete confirmation ───────────────────────────────────────────────────
    private int    _deleteSubId  = 0;
    private bool   _deleteBusy  = false;
    private string _deleteError = "";

    // ── Lifecycle ─────────────────────────────────────────────────────────────
    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();

        // Auto-open from ?taskId=N deep link (e.g. from dashboard card or notification)
        if (TaskId.HasValue && TaskId.Value > 0)
            _detailTaskId = TaskId.Value;
    }

    private async Task LoadDataAsync()
    {
        _data      = await TasksService.GetTasksAsync();
        _loadError = _data is null;
        _isLoading = false;
        BuildMilestoneMap();
    }

    private void BuildMilestoneMap()
    {
        _taskMilestoneMap = AllTasksGroups
            .SelectMany(g => g.Tasks.Select(t => (t.Id, g.MilestoneTitle)))
            .GroupBy(x => x.Id)
            .ToDictionary(g => g.Key, g => g.First().MilestoneTitle);
    }

    // ── Unified status filter / search / sort ──────────────────────────────────
    private void SetStatusFilter(string filter) => _statusFilter = filter;

    private void OnSearchChanged(ChangeEventArgs e) => _searchText = e.Value?.ToString() ?? "";

    private void OnSortChanged(ChangeEventArgs e) => _sortKey = e.Value?.ToString() ?? "due";

    // ── Submission modal handlers ─────────────────────────────────────────────
    private async Task CloseSubmission()
    {
        _submissionTaskId = 0;
        _editSubmissionId = 0;
        _editDriveUrl     = null;
        _editNotes        = null;
        await LoadDataAsync();
    }

    // ── Detail modal handlers ─────────────────────────────────────────────────
    private void OpenDetail(int taskId)      => _detailTaskId = taskId;
    private void CloseDetail()               => _detailTaskId = 0;

    private void OpenSubmissionFromDetail(int taskId)
    {
        _detailTaskId     = 0;
        _submissionTaskId = taskId;
    }

    private void OnEditFromDetail((int TaskId, int SubmissionId, string? DriveUrl, string? Notes) e)
    {
        _editSubmissionId = e.SubmissionId;
        _editDriveUrl     = e.DriveUrl;
        _editNotes        = e.Notes;
        _submissionTaskId = e.TaskId;
    }

    private void OnDeleteFromDetail(int submissionId)
    {
        _deleteSubId  = submissionId;
        _deleteError  = "";
        _deleteBusy   = false;
    }

    private void OnMarkMoodleFromDetail(int submissionId)
    {
        _moodleSubId  = submissionId;
        _moodleError  = "";
        _moodleBusy   = false;
    }

    // ── Moodle confirmation ───────────────────────────────────────────────────
    private void CancelMoodle()
    {
        if (_moodleBusy) return;
        _moodleSubId  = 0;
        _moodleError  = "";
    }

    private async Task ConfirmMoodleAsync()
    {
        if (_moodleSubId <= 0) return;
        _moodleBusy  = true;
        _moodleError = "";
        var (ok, _, _, err) = await SubmissionsService.MarkMoodleSubmittedAsync(_moodleSubId);
        if (!ok)
        {
            _moodleError = string.IsNullOrWhiteSpace(err) ? "הסימון נכשל. נסה/י שנית." : err;
            _moodleBusy  = false;
            return;
        }
        _moodleSubId = 0;
        _moodleBusy  = false;
        await LoadDataAsync();
    }

    // ── Delete confirmation ───────────────────────────────────────────────────
    private void CancelDelete()
    {
        if (_deleteBusy) return;
        _deleteSubId  = 0;
        _deleteError  = "";
    }

    private async Task ConfirmDeleteAsync()
    {
        if (_deleteSubId <= 0) return;
        _deleteBusy  = true;
        _deleteError = "";
        var (ok, err) = await SubmissionsService.DeleteMySubmissionAsync(_deleteSubId);
        if (!ok)
        {
            _deleteError = string.IsNullOrWhiteSpace(err) ? "מחיקת ההגשה נכשלה. נסה/י שנית." : err;
            _deleteBusy  = false;
            return;
        }
        _deleteSubId = 0;
        _deleteBusy  = false;
        await LoadDataAsync();
    }

    // ── Base data pool ──────────────────────────────────────────────────────────
    // Every group (including הושלמו) must be filterable/countable, so unlike
    // the pre-Sprint-1 page this reads BOTH ActiveGroups and CompletedGroups —
    // not just ActiveGroups (which the server already excludes Done tasks from).
    private List<TaskMilestoneGroupDto> AllTasksGroups =>
        _data is null ? new() : _data.ActiveGroups.Concat(_data.CompletedGroups).ToList();

    private List<TaskItemDto> AllTasks =>
        AllTasksGroups.SelectMany(g => g.Tasks).ToList();

    // ── Workflow buckets — the page's primary organizing axis. Mutually
    // exclusive by construction (TaskStatusHelpers.GetWorkflowSection), so a
    // summary tile's count always equals what that bucket's section shows.
    private List<TaskItemDto> NeedsActionTasks =>
        AllTasks.Where(t => TaskStatusHelpers.GetWorkflowSection(t, _data?.StudentName) == TaskStatusHelpers.WorkflowSection.NeedsAction).ToList();

    private List<TaskItemDto> ReadyToSubmitTasks =>
        AllTasks.Where(t => TaskStatusHelpers.GetWorkflowSection(t, _data?.StudentName) == TaskStatusHelpers.WorkflowSection.ReadyToSubmit).ToList();

    private List<TaskItemDto> TeamTasks =>
        AllTasks.Where(t => TaskStatusHelpers.GetWorkflowSection(t, _data?.StudentName) == TaskStatusHelpers.WorkflowSection.Team).ToList();

    private List<TaskItemDto> CompletedTasks =>
        AllTasks.Where(t => TaskStatusHelpers.GetWorkflowSection(t, _data?.StudentName) == TaskStatusHelpers.WorkflowSection.Completed).ToList();

    // ── Search + sort — applied uniformly whether a bucket is being shown as
    // its own section (browse mode) or as the single flat list (filtered
    // mode), so typing a search term or changing sort never resets which
    // bucket/filter is active. "לפי עדכון אחרון" approximates "last updated"
    // from the closest available signal (last submission time, else
    // completion time) since TaskItemDto has no stored UpdatedAt column.
    private List<TaskItemDto> ApplySearchSort(IEnumerable<TaskItemDto> tasks)
    {
        var filtered = string.IsNullOrWhiteSpace(_searchText)
            ? tasks
            : tasks.Where(t => t.Title.Contains(_searchText, StringComparison.OrdinalIgnoreCase));

        return _sortKey switch
        {
            "priority" => filtered.OrderByDescending(t => t.IsMandatory)
                                  .ThenBy(t => t.DueDate ?? DateTime.MaxValue)
                                  .ToList(),
            "updated"  => filtered.OrderByDescending(t => t.LatestSubmittedAt ?? t.CompletedAt ?? DateTime.MinValue)
                                  .ThenByDescending(t => t.Id)
                                  .ToList(),
            _          => filtered.OrderBy(t => t.DueDate ?? DateTime.MaxValue).ToList(),
        };
    }

    private List<TaskItemDto> DisplayedNeedsAction   => ApplySearchSort(NeedsActionTasks);
    private List<TaskItemDto> DisplayedReadyToSubmit => ApplySearchSort(ReadyToSubmitTasks);
    private List<TaskItemDto> DisplayedTeam          => ApplySearchSort(TeamTasks);
    private List<TaskItemDto> DisplayedCompleted     => ApplySearchSort(CompletedTasks);

    // ── Flat filtered mode (a specific bucket selected via summary/popover) ──
    private List<TaskItemDto> DisplayedFlatList => _statusFilter switch
    {
        "action" => DisplayedNeedsAction,
        "submit" => DisplayedReadyToSubmit,
        "team"   => DisplayedTeam,
        "done"   => DisplayedCompleted,
        _        => ApplySearchSort(AllTasks),
    };

    private string ActiveFilterTitle => _statusFilter switch
    {
        "action" => "דורש ממני פעולה",
        "submit" => "מוכן להגשה",
        "team"   => "משימות צוות",
        "done"   => "הושלמו",
        _        => "כל המשימות",
    };

    private string ActiveFilterIcon => _statusFilter switch
    {
        "action" => "oi-bolt",
        "submit" => "oi-circle-check",
        "team"   => "oi-people",
        "done"   => "oi-task",
        _        => "oi-list",
    };

    // ── Contextual empty state, per bucket ──────────────────────────────────────
    private string EmptyMessageFor(string bucket) => !string.IsNullOrWhiteSpace(_searchText)
        ? "לא נמצאו משימות התואמות את החיפוש."
        : bucket switch
        {
            "action" => "אין כרגע משימות שדורשות ממך פעולה.",
            "submit" => "אין כרגע משימות שמוכנות להגשה.",
            "team"   => "אין כרגע משימות שמטופלות על ידי הצוות.",
            "done"   => "עדיין לא הושלמו משימות.",
            _        => "אין משימות בפרויקט זה.",
        };

    private bool EmptyIsPositiveFor(string bucket) =>
        string.IsNullOrWhiteSpace(_searchText) && bucket == "action";
}