@*
    TaskStatusOverview — one compact stat strip, not a stacked hero block.

    This is a ZONE inside the shared ambient canvas (StudentTasksPage's
    .tsk-canvas), not its own surface — no background/border/shadow of its
    own. Primary metric + the 3 secondary stats sit in one inline row,
    separated by short vertical hairlines, so the whole thing reads as a
    single compact line rather than a dashboard-hero-sized block.
*@

<div class="tso-strip">

    <button class="tso-primary @(ActiveFilter == "action" ? "tso-active" : "")"
            @onclick='() => OnSelectFilter.InvokeAsync("action")'>
        <span class="tso-primary-value">@PrimaryHeadline</span>
        <span class="tso-primary-sub">@PrimarySubline</span>
    </button>

    <span class="tso-sep" aria-hidden="true"></span>

    <button class="tso-stat @(ActiveFilter == "submit" ? "tso-active" : "")"
            @onclick='() => OnSelectFilter.InvokeAsync("submit")'>
        <span class="tso-dot tso-dot-submit" aria-hidden="true"></span>
        <span class="tso-stat-label">מוכן להגשה</span>
        <span class="tso-stat-value">@ReadyToSubmitCount</span>
    </button>

    <span class="tso-sep" aria-hidden="true"></span>

    <button class="tso-stat @(ActiveFilter == "team" ? "tso-active" : "")"
            @onclick='() => OnSelectFilter.InvokeAsync("team")'>
        <span class="tso-dot tso-dot-team" aria-hidden="true"></span>
        <span class="tso-stat-label">משימות צוות</span>
        <span class="tso-stat-value">@TeamCount</span>
    </button>

    <span class="tso-sep" aria-hidden="true"></span>

    <button class="tso-stat @(ActiveFilter == "done" ? "tso-active" : "")"
            @onclick='() => OnSelectFilter.InvokeAsync("done")'>
        <span class="tso-dot tso-dot-done" aria-hidden="true"></span>
        <span class="tso-stat-label">הושלמו</span>
        <span class="tso-stat-value">@CompletedCount</span>
    </button>

</div>

@code {
    [Parameter, EditorRequired] public int NeedsActionCount { get; set; }
    [Parameter, EditorRequired] public int ReadyToSubmitCount { get; set; }
    [Parameter, EditorRequired] public int TeamCount { get; set; }
    [Parameter, EditorRequired] public int CompletedCount { get; set; }
    [Parameter] public string ActiveFilter { get; set; } = "all";
    [Parameter] public EventCallback<string> OnSelectFilter { get; set; }

    private string PrimaryHeadline => NeedsActionCount switch
    {
        0 => "אין משימות פתוחות",
        1 => "1 משימה פתוחה",
        _ => $"{NeedsActionCount} משימות פתוחות",
    };

    private string PrimarySubline => NeedsActionCount switch
    {
        0 => "מצוין! אין דבר שדורש טיפול",
        1 => "דורשת טיפול כעת",
        _ => "דורשות טיפול כעת",
    };
}
