@*
    TaskStatusOverview — the page's compact task summary, one row of
    self-contained stat chips (not inline text-in-a-line). Each chip is
    its own small colored surface, so the summary reads as distinct at-a-
    glance numbers rather than a cramped admin-panel status line. The
    "needs my action" chip is visibly the primary one — bigger value,
    brand-tinted surface — the other three stay small and quiet.

    Clicking a chip applies the matching workflow filter, same as before.
*@

<div class="tso-row">

    <button class="tso-chip tso-chip-primary @(ActiveFilter == "action" ? "tso-chip-active" : "")"
            @onclick='() => OnSelectFilter.InvokeAsync("action")'>
        <span class="oi oi-bolt tso-chip-icon" aria-hidden="true"></span>
        <span class="tso-chip-value">@NeedsActionCount</span>
        <span class="tso-chip-label">דורש ממני פעולה</span>
    </button>

    <button class="tso-chip @(ActiveFilter == "submit" ? "tso-chip-active" : "")"
            @onclick='() => OnSelectFilter.InvokeAsync("submit")'>
        <span class="tso-dot tso-dot-submit" aria-hidden="true"></span>
        <span class="tso-chip-value">@ReadyToSubmitCount</span>
        <span class="tso-chip-label">מוכן להגשה</span>
    </button>

    <button class="tso-chip @(ActiveFilter == "team" ? "tso-chip-active" : "")"
            @onclick='() => OnSelectFilter.InvokeAsync("team")'>
        <span class="tso-dot tso-dot-team" aria-hidden="true"></span>
        <span class="tso-chip-value">@TeamCount</span>
        <span class="tso-chip-label">משימות צוות</span>
    </button>

    <button class="tso-chip @(ActiveFilter == "done" ? "tso-chip-active" : "")"
            @onclick='() => OnSelectFilter.InvokeAsync("done")'>
        <span class="tso-dot tso-dot-done" aria-hidden="true"></span>
        <span class="tso-chip-value">@CompletedCount</span>
        <span class="tso-chip-label">הושלמו</span>
    </button>

</div>

@code {
    [Parameter, EditorRequired] public int NeedsActionCount { get; set; }
    [Parameter, EditorRequired] public int ReadyToSubmitCount { get; set; }
    [Parameter, EditorRequired] public int TeamCount { get; set; }
    [Parameter, EditorRequired] public int CompletedCount { get; set; }
    [Parameter] public string ActiveFilter { get; set; } = "all";
    [Parameter] public EventCallback<string> OnSelectFilter { get; set; }
}
