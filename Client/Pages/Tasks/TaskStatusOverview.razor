@*
    TaskStatusOverview — the finalized design's KPI row
    (Motiva Tasks.dc.html, .kpi-grid inside the compact page header).

    The Design mixes two kinds of KPI in one row, and MKpiCard already models
    both: two are anchors that jump to a section, two are filter toggles that
    report aria-pressed. This component only maps Tasks' numbers onto that
    shape — the grid, card, accents, hover and pressed treatments are all shared.

    Accents are the Design's four hues. They are presentation accents, not status
    semantics; MStatusDot/MStatusBadge stay closed to violet/teal/rose.

    The anchor hrefs are route-qualified on purpose. index.html declares
    <base href="/">, and a bare "#fragment" is resolved against the BASE url,
    not the current document — so href="#team-tasks" navigates to "/#team-tasks",
    which lands on the root route and redirects to the dashboard. Naming the
    route keeps the jump on this page.
*@

<MKpiGrid Columns="4" AriaLabel="סיכום משימות">

    <MKpiCard Value="@AttentionCount.ToString()"
              Label="דורש התייחסות"
              Accent="MKpiCard.KpiAccent.Rose"
              Href="/tasks#requires-attention"
              AriaLabel="@($"{AttentionCount} משימות שדורשות התייחסות")">
        <Icon><span class="oi oi-warning tso-icon" aria-hidden="true"></span></Icon>
    </MKpiCard>

    <MKpiCard Value="@DueThisWeekCount.ToString()"
              Label="להגשה השבוע"
              Accent="MKpiCard.KpiAccent.Periwinkle"
              Pressed="@(ActiveFilter == "week")"
              OnClick="@(() => Select("week"))"
              AriaLabel="@($"{DueThisWeekCount} משימות להגשה השבוע")">
        <Icon><span class="oi oi-calendar tso-icon" aria-hidden="true"></span></Icon>
    </MKpiCard>

    <MKpiCard Value="@TeamCount.ToString()"
              Label="משימות צוות"
              Accent="MKpiCard.KpiAccent.Cobalt"
              Href="/tasks#team-tasks"
              AriaLabel="@($"{TeamCount} משימות צוות")">
        <Icon><span class="oi oi-list tso-icon" aria-hidden="true"></span></Icon>
    </MKpiCard>

    <MKpiCard Value="@CompletedCount.ToString()"
              Label="הושלמו"
              Accent="MKpiCard.KpiAccent.Teal"
              Pressed="@(ActiveFilter == "done")"
              OnClick="@(() => Select("done"))"
              AriaLabel="@($"{CompletedCount} משימות שהושלמו")">
        <Icon><span class="oi oi-circle-check tso-icon" aria-hidden="true"></span></Icon>
    </MKpiCard>

</MKpiGrid>

@code {
    [Parameter, EditorRequired] public int AttentionCount { get; set; }
    [Parameter, EditorRequired] public int DueThisWeekCount { get; set; }
    [Parameter, EditorRequired] public int TeamCount { get; set; }
    [Parameter, EditorRequired] public int CompletedCount { get; set; }

    /// <summary>"" | "week" | "done" — only the two toggle cards can be active.</summary>
    [Parameter] public string ActiveFilter { get; set; } = "";

    [Parameter] public EventCallback<string> OnSelectFilter { get; set; }

    private Task Select(string key) => OnSelectFilter.InvokeAsync(key);
}
