@using AuthWithAdmin.Shared.AuthSharedModels
@using AuthWithAdmin.Client.Pages.Tasks

@*
    TaskFlatList — one flat, non-milestone-grouped urgency section.

    Extracted from the row markup that used to power only the old
    "דורש פעולה" tab in StudentTasksPage. The existing status/icon/label
    helpers already have correct branches for every resolved status these
    sections can show (returned / approved / pending-mentor-review / plain
    open-in-progress), so the same row rendering serves all three primary
    buckets ("דורש ממני טיפול" / "ממתין לאחרים" / "המשימות הקרובות") —
    only the Tasks list and copy differ per call site.
*@

<div class="tfl-section @(IsHero ? "tfl-section-hero" : "") @(IsMuted ? "tfl-section-muted" : "")">
    <div class="tfl-section-header">
        <div class="tfl-section-heading">
            <h2 class="tfl-section-title">@SectionTitle</h2>
            @if (!string.IsNullOrEmpty(Subtitle))
            {
                <p class="tfl-section-subtitle">@Subtitle</p>
            }
        </div>
        @if (Tasks.Count > 0)
        {
            <span class="tfl-count-badge @(IsUrgent ? "tfl-count-badge-urgent" : "")">@Tasks.Count</span>
        }
    </div>

    @if (Tasks.Count == 0)
    {
        <div class="tfl-empty">
            <span class="oi @(EmptyIsPositive ? "oi-circle-check tfl-empty-ok" : "oi-info")" aria-hidden="true"></span>
            <p>@EmptyMessage</p>
        </div>
    }
    else
    {
        <div class="tfl-list">
            @foreach (var task in Tasks)
            {
                string resolved    = TaskStatusHelpers.ResolveDisplayStatus(task);
                bool   isOverdue   = task.DueDate.HasValue
                                  && task.DueDate.Value.Date < DateTime.Today
                                  && resolved is not ("PendingMentorReview" or "ApprovedByMentor");
                var (relLabel, absLabel, _, isSoon) = TaskStatusHelpers.GetDateDisplay(task.DueDate);
                string milestoneTitle = MilestoneTitleLookup.GetValueOrDefault(task.Id, "");

                <button class="tfl-row @(resolved is "ReturnedByMentor" or "ReturnedForRevision" ? "tfl-row-returned" : "")"
                        @onclick="() => OnOpenDetail.InvokeAsync(task.Id)"
                        aria-label="@BuildAriaLabel(task.Title, task.IsSubmission, task.DueDate, resolved)">
                    <!-- Status icon -->
                    <div class="tfl-icon @IconClass(resolved, isOverdue)">
                        <span class="oi @IconName(resolved, isOverdue)" aria-hidden="true"></span>
                    </div>
                    <!-- Body -->
                    <div class="tfl-body">
                        <div class="tfl-title-row">
                            <span class="tfl-title">@task.Title</span>
                            @if (task.IsSubmission)
                            {
                                <span class="tfl-type tfl-type-submission">
                                    <span class="oi oi-data-transfer-upload" aria-hidden="true"></span>
                                    הגשה
                                </span>
                            }
                            else
                            {
                                <span class="tfl-type tfl-type-task">
                                    <span class="oi oi-check" aria-hidden="true"></span>
                                    משימה
                                </span>
                            }
                        </div>
                        @if (!string.IsNullOrEmpty(milestoneTitle))
                        {
                            <div class="tfl-milestone-pill">
                                <span class="oi oi-flag" aria-hidden="true"></span>
                                @milestoneTitle
                            </div>
                        }
                        <div class="tfl-meta">
                            @if (task.DueDate.HasValue)
                            {
                                <span class="tfl-date @(isOverdue ? "tfl-date-overdue" : isSoon ? "tfl-date-soon" : "")">
                                    <span class="oi oi-calendar" aria-hidden="true"></span>
                                    @if (!string.IsNullOrEmpty(relLabel))
                                    {
                                        <strong>@relLabel</strong>
                                        <span class="tfl-date-abs">@absLabel</span>
                                    }
                                    else
                                    {
                                        <span>@absLabel</span>
                                    }
                                </span>
                            }
                        </div>
                    </div>
                    <!-- Status badge -->
                    <span class="tfl-status @StatusClass(resolved, isOverdue)">
                        @StatusLabel(resolved, isOverdue)
                    </span>
                    <!-- Decorative chevron -->
                    <span class="oi oi-chevron-left tfl-chevron" aria-hidden="true"></span>
                </button>
            }
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public string SectionTitle { get; set; } = "";
    [Parameter, EditorRequired] public IReadOnlyList<TaskItemDto> Tasks { get; set; } = Array.Empty<TaskItemDto>();
    [Parameter] public Dictionary<int, string> MilestoneTitleLookup { get; set; } = new();
    [Parameter, EditorRequired] public string EmptyMessage { get; set; } = "";
    /// <summary>True → empty state reads as "all clear" (green check). Used for "דורש ממני טיפול".</summary>
    [Parameter] public bool EmptyIsPositive { get; set; }
    /// <summary>True → count badge uses the alert colour. Reserved for "דורש ממני טיפול".</summary>
    [Parameter] public bool IsUrgent { get; set; }
    /// <summary>Optional line under the section title — used for the hero
    /// section's dynamic "what should I do now" summary.</summary>
    [Parameter] public string? Subtitle { get; set; }
    /// <summary>True → hero container styling (tinted background, larger
    /// title). Reserved for "דורש ממני טיפול" — the page's primary focus.</summary>
    [Parameter] public bool IsHero { get; set; }
    /// <summary>True → visually secondary styling (smaller/quieter header).
    /// Used for "ממתין לאחרים" and "המשימות הקרובות" so they read as
    /// look-ahead context rather than competing with the hero section.</summary>
    [Parameter] public bool IsMuted { get; set; }
    [Parameter] public EventCallback<int> OnOpenDetail { get; set; }

    private static string IconClass(string resolved, bool isOverdue) =>
        isOverdue ? "tfl-icon-overdue" : resolved switch
        {
            "ReturnedByMentor" or "ReturnedForRevision" => "tfl-icon-returned",
            "ApprovedByMentor"                          => "tfl-icon-approved",
            "PendingMentorReview"                       => "tfl-icon-pending",
            "Done"                                      => "tfl-icon-done",
            "InProgress"                                => "tfl-icon-inprogress",
            _                                           => "tfl-icon-open",
        };

    private static string IconName(string resolved, bool isOverdue) =>
        isOverdue ? "oi-warning" : resolved switch
        {
            "ReturnedByMentor" or "ReturnedForRevision" => "oi-arrow-circle-left",
            "ApprovedByMentor"                          => "oi-circle-check",
            "PendingMentorReview"                       => "oi-clock",
            "Done"                                      => "oi-circle-check",
            "InProgress"                                => "oi-reload",
            _                                           => "oi-media-record",
        };

    private static string StatusClass(string resolved, bool isOverdue) =>
        isOverdue ? "tfl-status-overdue" : resolved switch
        {
            "ReturnedByMentor" or "ReturnedForRevision" => "tfl-status-returned",
            "ApprovedByMentor"                          => "tfl-status-approved",
            "PendingMentorReview"                       => "tfl-status-pending",
            "InProgress"                                => "tfl-status-inprogress",
            _                                           => "tfl-status-open",
        };

    private static string StatusLabel(string resolved, bool isOverdue)
    {
        if (isOverdue) return "באיחור";
        return resolved switch
        {
            "ReturnedByMentor" or "ReturnedForRevision" => "הוחזר לתיקון",
            "ApprovedByMentor"                          => "יש להגיש במודל",
            "PendingMentorReview"                       => "ממתין למנחה",
            "InProgress"                                => "בביצוע",
            _                                           => "ממתין לביצוע",
        };
    }

    private static string BuildAriaLabel(string title, bool isSubmission, DateTime? dueDate, string resolved)
    {
        string type   = isSubmission ? "הגשה" : "משימה";
        string due    = dueDate.HasValue ? $", תאריך {dueDate.Value:dd/MM/yy}" : "";
        string status = StatusLabel(resolved, dueDate.HasValue && dueDate.Value.Date < DateTime.Today
                                            && resolved is not ("PendingMentorReview" or "ApprovedByMentor"));
        return $"פתח {type}: {title}{due}, סטטוס: {status}";
    }
}