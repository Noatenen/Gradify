@using AuthWithAdmin.Shared.AuthSharedModels
@using AuthWithAdmin.Client.Services
@using AuthWithAdmin.Client.Pages.Submissions
@inject ITasksService          TasksService
@inject ITaskSubmissionsService SubmissionsService
@implements IAsyncDisposable
@inject IJSRuntime JS

@* ═══════════════════════════════════════════════════════════════════════════
   TaskDetailModal  — full task detail view for students

   Layout (RTL):
     Header  : milestone chip · task-type chip · title · mandatory tag · ✕
     Body    : two-column info grid (description | dates + status dropdown)
               ↓ submission pipeline  (IsSubmission only)
               ↓ moodle reminder banner  (when latest status = Reviewed)
               ↓ sub-tasks checklist  (team-private)
               ↓ submission history  (IsSubmission + has submissions)
     Footer  : close · submit / resubmit

   Status separation — must never be collapsed:
     _task.Status              = student progress (7-step dropdown)
     SubmissionHistoryItemDto.Status        = reviewer decision
     SubmissionHistoryItemDto.MentorStatus  = mentor decision

   THE BOX IS MModal. This screen used to draw its own centred overlay
   (`.tdm-overlay` / `.tdm-modal`, 820px, a black 0.48 scrim, bordered header
   and footer rules) — the student's task inspection popup, sitting in a
   different container from the mentor's, which has always been <MModal>.
   Same act, two boxes. The shell is now the shared one for both roles: the
   overlay, scrim, surface, radius, shadow, width, max-height, internal
   scroll, close control and footer row all come from MModal, and Escape now
   closes the modal the way it does everywhere else.

   The body is FLUSH: the sections below carry their own gutter and their own
   full-bleed divider rules, and that layout is not being redesigned here.
   ═══════════════════════════════════════════════════════════════════════════ *@

<MModal IsOpen="@(TaskId > 0)"
        Size="MModal.ModalSize.Large"
        FlushBody="true"
        AriaLabelledBy="@_titleId"
        OnClose="Close">

    <HeaderContent>
        @if (_task is not null)
        {
            <div class="tdm-header-chips">
                        @if (!string.IsNullOrWhiteSpace(_task.MilestoneTitle))
                        {
                            <span class="tdm-chip tdm-chip-milestone">
                                <span class="oi oi-flag" aria-hidden="true"></span>
                                @_task.MilestoneTitle
                            </span>
                        }
                        @if (_task.IsSubmission)
                        {
                            <span class="tdm-chip tdm-chip-submission">
                                <span class="oi oi-arrow-top" aria-hidden="true"></span>
                                הגשה
                            </span>
                        }
                        else
                        {
                            <span class="tdm-chip tdm-chip-activity">
                                <span class="oi oi-check" aria-hidden="true"></span>
                                משימה
                            </span>
                        }
            </div>
        }
    </HeaderContent>

    <ChildContent>
            @if (_loading)
            {
                <MLoadingState Label="טוענת פרטי משימה…" Class="tdm-loading" />
            }
            else if (_loadError)
            {
                <div class="tdm-error-state">
                    <MEmptyState Live="true"
                                 Title="אירעה שגיאה בטעינת פרטי המשימה"
                                 Description="אפשר לסגור ולנסות שוב." />
                </div>
            }
            else if (_task is not null && _submitMode)
            {
                @* ── SUBMISSION STATE ──────────────────────────────────────
                   Same modal, same TaskId, same URL. The task is still named
                   above so the student can never be unsure what they are
                   submitting, and ShowTaskContext is off because this shell
                   already carries the milestone chip, title and due date. *@
                <div class="tdm-submit-pane">
                    @* No "הגשה" tag here: the shell's header already carries
                       the submission chip, and naming the state twice on one
                       screen is noise, not reassurance. *@
                    <div class="tdm-header-title-row">
                        <h2 class="tdm-title" id="@_titleId">@_task.Title</h2>
                    </div>

                    @if (_task.DueDate.HasValue)
                    {
                        <div class="tdm-meta-line">
                            <span class="tdm-meta-item @(IsOverdue ? "tdm-meta-overdue" : "")">
                                <span class="oi oi-calendar tdm-meta-icon" aria-hidden="true"></span>
                                <span class="tdm-meta-key">@DueDateLabel:</span>
                                @_task.DueDate.Value.ToString("dd.MM.yyyy")
                            </span>
                        </div>
                    }

                    <StudentSubmissionForm TaskId="@TaskId"
                                           ShowTaskContext="false"
                                           CancelText="חזרה לפרטי המשימה"
                                           DoneText="חזרה לפרטי המשימה"
                                           OnSubmitted="OnInlineSubmitted"
                                           OnCancel="BackToDetails" />
                </div>
            }
            else if (_task is not null)
            {
                <div class="tdm-header-title-row">
                    <h2 class="tdm-title" id="@_titleId">@_task.Title</h2>

                    @if (!_task.IsSubmission)
                    {
                        @* Activity Task: simple read-only status pill; completion via footer *@
                        <span class="tdm-status-pill tdm-pill-@ActivityStatusCssClass">
                            @ActivityStatusLabel
                        </span>
                    }
                    else if (IsStatusEditable)
                    {
                        @* Submission Task: editable dropdown before any submission *@
                        <div class="tdm-status-pill-ctrl">
                            <MSelectField Options="@StatusOptions"
                                          Value="@StatusForDisplay"
                                          ValueChanged="@(async v => await OnStatusDropdownChanged(new ChangeEventArgs { Value = v }))"
                                          Disabled="@_updatingStatus"
                                          Class="tdm-status-pill-select" />
                            @if (_updatingStatus)
                            {
                                <div class="tdm-spinner-sm"></div>
                            }
                        </div>
                    }
                    else
                    {
                        @* Submission Task: locked pill showing pipeline state *@
                        var state = CurrentSubmissionState;
                        <span class="tdm-status-pill tdm-pill-@state.CssClass"
                              title="הסטטוס מנוהל אוטומטית על ידי תהליך בדיקת המנחה ואישור ה-Moodle ואינו ניתן לשינוי ידני">
                            <span class="oi oi-lock-locked" aria-hidden="true"></span>
                            @state.Label
                        </span>
                    }
                </div>
                @if (_statusError)
                {
                    <p class="tdm-inline-error tdm-inline-error-title">שגיאה בעדכון הסטטוס. נסי שנית.</p>
                }

                <!-- ── Due date ── -->
                @if (_task.DueDate.HasValue)
                {
                    <div class="tdm-meta-line">
                        <span class="tdm-meta-item @(IsOverdue ? "tdm-meta-overdue" : "")">
                            @* Same calendar glyph the other student surfaces
                               use for a date (TeamTasksCard, MilestoneDetailModal
                               and this modal's own sub-task rows). Muted ink, so
                               the line stays subordinate to the title. *@
                            <span class="oi oi-calendar tdm-meta-icon" aria-hidden="true"></span>
                            <span class="tdm-meta-key">@DueDateLabel:</span>
                            @_task.DueDate.Value.ToString("dd.MM.yyyy")
                            @if (IsOverdue)
                            {
                                <span class="tdm-overdue-tag">באיחור</span>
                            }
                        </span>
                    </div>
                }

                <!-- ── Body ── -->

                    <!-- ════ 4-step workflow — visible even before first submission ════ -->
                    @if (_task.IsSubmission)
                    {
                        <div class="tdm-section">
                            <h3 class="tdm-section-title">
                                <span class="oi oi-arrow-top" aria-hidden="true"></span>
                                מצב הגשה
                            </h3>

                            @{
                                var wfSteps = BuildWorkflowSteps();
                            }
                            <div class="tdm-timeline">
                                @for (int i = 0; i < wfSteps.Count; i++)
                                {
                                    var step = wfSteps[i];
                                    <div class="tdm-timeline-step tdm-tl-@TimelineStateClass(step.State)">
                                        <span class="tdm-timeline-marker">
                                            <span class="oi @TimelineMarkerIcon(step.State)" aria-hidden="true"></span>
                                        </span>
                                        <span class="tdm-timeline-title">@step.Title</span>
                                        <span class="tdm-timeline-sub">@step.Subtitle</span>
                                    </div>
                                    @if (i < wfSteps.Count - 1)
                                    {
                                        <div class="tdm-timeline-connector tdm-tl-connector-@TimelineStateClass(step.State)"></div>
                                    }
                                }
                            </div>

                            <!-- Feedback banners — only once a submission exists -->
                            @if (_task.Submissions.Count > 0)
                            {
                                var latest = LatestSubmission!;
                                @if (latest.MentorStatus == "Returned")
                                {
                                    <div class="tdm-feedback-banner tdm-feedback-returned">
                                        <div class="tdm-feedback-header">
                                            <span class="oi oi-arrow-circle-left" aria-hidden="true"></span>
                                            <strong>הגשה הוחזרה ע״י המנחה</strong>
                                        </div>
                                        @if (!string.IsNullOrWhiteSpace(latest.MentorFeedback))
                                        {
                                            <p class="tdm-feedback-text">@latest.MentorFeedback</p>
                                        }
                                    </div>
                                }
                                @if (latest.IsFeedbackPublished &&
                                     !string.IsNullOrWhiteSpace(latest.ReviewerFeedback))
                                {
                                    <div class="tdm-feedback-banner tdm-feedback-returned">
                                        <div class="tdm-feedback-header">
                                            <span class="oi oi-comment-square" aria-hidden="true"></span>
                                            <strong>הערות מרצה</strong>
                                            @if (latest.FeedbackPublishedAt.HasValue)
                                            {
                                                <span class="tdm-feedback-date">
                                                    @latest.FeedbackPublishedAt.Value.ToString("dd/MM/yy")
                                                </span>
                                            }
                                        </div>
                                        <p class="tdm-feedback-text">@latest.ReviewerFeedback</p>
                                    </div>
                                }
                            }
                        </div>
                    }

                    <!-- ════ Description — full width, the primary content ════ -->
                    <div class="tdm-section-desc">
                        @if (!string.IsNullOrWhiteSpace(_task.Description))
                        {
                            <p class="tdm-desc-text">@_task.Description</p>
                        }
                        else
                        {
                            <p class="tdm-desc-empty">אין תיאור למשימה זו.</p>
                        }

                        @* SUBMISSION INSTRUCTIONS ARE NOT SHOWN HERE. This view
                           answers "what is this task and where does it stand".
                           How to hand work in belongs to the act of handing it
                           in, so the instructions now live in the submission
                           state below — on the Drive field's own info trigger,
                           where they are read at the moment they apply. Nothing
                           was deleted: the same _task.SubmissionInstructions
                           text is what that tooltip shows. *@
                    </div>

                    <!-- ════ Sub-tasks (Submission Tasks only) ════ -->
                    @if (_task.IsSubmission)
                    {
                    <div class="tdm-section tdm-section-subtasks">
                        <div class="tdm-subtask-header">
                            <h3 class="tdm-section-title">
                                <span class="oi oi-check" aria-hidden="true"></span>
                                משימות משנה
                            </h3>
                            <div class="tdm-subtask-header-end">
                                <button class="tdm-subtask-toggle-add"
                                        @onclick="ToggleAddForm"
                                        title="@(_showAddForm ? "בטל" : "הוסף משימה")">
                                    <span class="oi @(_showAddForm ? "oi-minus" : "oi-plus")" aria-hidden="true"></span>
                                    @(_showAddForm ? "בטל" : "הוסף")
                                </button>
                            </div>
                        </div>

                        <!-- Expandable add form -->
                        @if (_showAddForm)
                        {
                            <div class="tdm-subtask-form">
                                <div class="tdm-subtask-form-row">
                                    <input class="tdm-subtask-input tdm-subtask-input-title"
                                           @bind="_newSubTaskTitle"
                                           @bind:event="oninput"
                                           @onkeydown="OnSubTaskInputKeyDown"
                                           placeholder="כותרת משימה…"
                                           maxlength="120" />
                                </div>
                                <div class="tdm-subtask-form-row tdm-subtask-form-row-meta">
                                    <input class="tdm-subtask-date-input"
                                           type="date"
                                           @bind="_newSubTaskDueDate" />
                                </div>
                                <div class="tdm-subtask-form-row">
                                    <textarea class="tdm-subtask-notes-input"
                                              @bind="_newSubTaskNotes"
                                              placeholder="הערות (אופציונלי)…"
                                              rows="2"
                                              maxlength="500"></textarea>
                                </div>
                                <div class="tdm-subtask-form-actions">
                                    <button class="tdm-subtask-add-btn motiva-cta"
                                            @onclick="AddSubTask"
                                            disabled="@(string.IsNullOrWhiteSpace(_newSubTaskTitle) || _addingSubTask)">
                                        @if (_addingSubTask)
                                        {
                                            <div class="tdm-spinner-sm"></div>
                                        }
                                        else
                                        {
                                            <span class="oi oi-plus" aria-hidden="true"></span>
                                        }
                                        הוסף
                                    </button>
                                </div>
                            </div>
                        }

                        @if (_subTasksLoading)
                        {
                            <div class="tdm-subtask-loading">
                                <div class="tdm-spinner-sm"></div>
                                <span>טוענת…</span>
                            </div>
                        }
                        else if (!_subTasks.Any())
                        {
                            <p class="tdm-subtask-empty">אין משימות משנה. לחצו + הוסף כדי להוסיף פריטים פנימיים לצוות.</p>
                        }
                        else
                        {
                            <div class="tdm-subtask-list">
                                @foreach (var st in _subTasks)
                                {
                                    bool isEditing = _editingSubTaskId == st.Id;
                                    <div class="tdm-subtask-row @(st.IsDone ? "tdm-subtask-row-done" : "")">
                                        @if (isEditing)
                                        {
                                            <!-- Inline edit form -->
                                            <div class="tdm-subtask-edit-form">
                                                <div class="tdm-subtask-form-row">
                                                    <input class="tdm-subtask-input tdm-subtask-input-title"
                                                           @bind="_editTitle"
                                                           @bind:event="oninput"
                                                           maxlength="120" />
                                                </div>
                                                <div class="tdm-subtask-form-row tdm-subtask-form-row-meta">
                                                    <input class="tdm-subtask-date-input"
                                                           type="date"
                                                           @bind="_editDueDate" />
                                                </div>
                                                <div class="tdm-subtask-form-row">
                                                    <textarea class="tdm-subtask-notes-input"
                                                              @bind="_editNotes"
                                                              rows="2"
                                                              maxlength="500"></textarea>
                                                </div>
                                                <div class="tdm-subtask-form-actions">
                                                    <button class="tdm-subtask-add-btn motiva-cta"
                                                            @onclick="() => SaveSubTaskEdit(st)"
                                                            disabled="@(string.IsNullOrWhiteSpace(_editTitle))">
                                                        <span class="oi oi-check" aria-hidden="true"></span>
                                                        שמור
                                                    </button>
                                                    <button class="tdm-subtask-cancel-btn"
                                                            @onclick="CancelSubTaskEdit">
                                                        ביטול
                                                    </button>
                                                </div>
                                            </div>
                                        }
                                        else
                                        {
                                            <!-- Normal display row -->
                                            <span class="tdm-subtask-check @(st.IsDone ? "tdm-subtask-check-done" : "")"
                                                  @onclick="() => ToggleSubTask(st)"
                                                  title="@(st.IsDone ? "סמן כלא הושלם" : "סמן כהושלם")">
                                                <span class="tdm-subtask-check-box" aria-hidden="true"></span>
                                            </span>
                                            <div class="tdm-subtask-body">
                                                <span class="tdm-subtask-title @(st.IsDone ? "tdm-subtask-title-done" : "")">
                                                    @st.Title
                                                </span>
                                                <div class="tdm-subtask-meta">
                                                    @if (st.DueDate.HasValue)
                                                    {
                                                        bool stOverdue = st.DueDate.Value.Date < DateTime.Today && !st.IsDone;
                                                        <span class="tdm-subtask-meta-item @(stOverdue ? "tdm-subtask-meta-overdue" : "")">
                                                            <span class="oi oi-calendar" aria-hidden="true"></span>
                                                            @st.DueDate.Value.ToString("dd/MM/yy")
                                                            @if (stOverdue) { <span>(באיחור)</span> }
                                                        </span>
                                                    }
                                                    @if (!string.IsNullOrWhiteSpace(st.Notes))
                                                    {
                                                        <span class="tdm-subtask-has-notes" title="@st.Notes">
                                                            <span class="oi oi-comment-square" aria-hidden="true"></span>
                                                        </span>
                                                    }
                                                </div>
                                            </div>
                                            <div class="tdm-subtask-actions">
                                                <button class="tdm-subtask-edit"
                                                        @onclick="() => StartSubTaskEdit(st)"
                                                        title="ערוך">
                                                    <span class="oi oi-pencil" aria-hidden="true"></span>
                                                </button>
                                                <button class="tdm-subtask-delete"
                                                        @onclick="() => DeleteSubTask(st)"
                                                        title="מחק">
                                                    <span class="oi oi-trash" aria-hidden="true"></span>
                                                </button>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </div>
                    } @* end @if (_task.IsSubmission) — sub-tasks *@

                    <!-- ════ Submission history ════ -->
                    @if (_task.IsSubmission && _task.Submissions.Count > 0)
                    {
                        <div class="tdm-section">
                            <h3 class="tdm-section-title">
                                <span class="oi oi-list-rich" aria-hidden="true"></span>
                                היסטוריית הגשות
                                <span class="tdm-history-count">@_task.Submissions.Count</span>
                            </h3>

                            <div class="tdm-history-list">
                                @foreach (var (sub, idx) in _task.Submissions.Select((s, i) => (s, i)))
                                {
                                    bool isExpanded = _expandedSubmissions.Contains(sub.Id);
                                    // Submissions are oldest-first; the last item is the latest round.
                                    bool isLatest   = idx == _task.Submissions.Count - 1;

                                    <div class="tdm-history-item @(isLatest ? "tdm-history-latest" : "")">
                                        <button class="tdm-history-header"
                                                @onclick="() => ToggleSubmission(sub.Id)">
                                            <div class="tdm-history-header-start">
                                                <span class="tdm-history-number">
                                                    הגשה @(idx + 1)
                                                </span>
                                                <span class="tdm-submission-badge tdm-sbadge-@sub.Status.ToLower()">
                                                    @SubmissionStatusLabel(sub.Status)
                                                </span>
                                                @if (sub.MentorStatus != "Pending")
                                                {
                                                    <span class="tdm-mentor-badge tdm-mbadge-@sub.MentorStatus.ToLower()">
                                                        מנחה: @MentorStatusLabel(sub.MentorStatus)
                                                    </span>
                                                }
                                            </div>
                                            <div class="tdm-history-header-end">
                                                <span class="tdm-history-date">
                                                    @sub.SubmittedAt.IsraelFormat("dd/MM/yy HH:mm")
                                                </span>
                                                <span class="oi @(isExpanded ? "oi-chevron-top" : "oi-chevron-bottom") tdm-chevron"
                                                      aria-hidden="true"></span>
                                            </div>
                                        </button>

                                        @if (isExpanded)
                                        {
                                            <div class="tdm-history-body">
                                                @if (!string.IsNullOrWhiteSpace(sub.Notes))
                                                {
                                                    <div class="tdm-history-notes">
                                                        <span class="tdm-notes-label">הערות:</span>
                                                        <p class="tdm-notes-text">@sub.Notes</p>
                                                    </div>
                                                }

                                                @if (!string.IsNullOrWhiteSpace(sub.MentorFeedback))
                                                {
                                                    <div class="tdm-feedback-banner tdm-feedback-returned">
                                                        <div class="tdm-feedback-header">
                                                            <span class="oi oi-comment-square" aria-hidden="true"></span>
                                                            <strong>הערות מנחה</strong>
                                                            @if (sub.MentorReviewedAt.HasValue)
                                                            {
                                                                <span class="tdm-feedback-date">
                                                                    @sub.MentorReviewedAt.Value.ToString("dd/MM/yy")
                                                                </span>
                                                            }
                                                        </div>
                                                        <p class="tdm-feedback-text">@sub.MentorFeedback</p>
                                                    </div>
                                                }

                                                @if (sub.IsFeedbackPublished &&
                                                     !string.IsNullOrWhiteSpace(sub.ReviewerFeedback))
                                                {
                                                    <div class="tdm-feedback-banner tdm-feedback-returned">
                                                        <div class="tdm-feedback-header">
                                                            <span class="oi oi-comment-square" aria-hidden="true"></span>
                                                            <strong>הערות מרצה</strong>
                                                            @if (sub.FeedbackPublishedAt.HasValue)
                                                            {
                                                                <span class="tdm-feedback-date">
                                                                    @sub.FeedbackPublishedAt.Value.ToString("dd/MM/yy")
                                                                </span>
                                                            }
                                                        </div>
                                                        <p class="tdm-feedback-text">@sub.ReviewerFeedback</p>
                                                    </div>
                                                }

                                                @* Drive link (new flow, post-2026-05-19). *@
                                                @if (!string.IsNullOrWhiteSpace(sub.DriveUrl))
                                                {
                                                    bool isLatestPending =
                                                        _task.LatestSubmissionId == sub.Id
                                                        && sub.MentorStatus == "Pending";
                                                    bool isLatestApprovedUnmarked =
                                                        _task.LatestSubmissionId == sub.Id
                                                        && sub.MentorStatus == "Approved"
                                                        && !sub.CourseSubmittedAt.HasValue;
                                                    <div class="tdm-files">
                                                        <span class="tdm-files-label">קישור Google Drive</span>
                                                        <div class="tdm-drive-row">
                                                            <a class="tdm-drive-btn motiva-cta"
                                                               href="@sub.DriveUrl"
                                                               target="_blank" rel="noopener noreferrer">
                                                                <span class="oi oi-external-link" aria-hidden="true"></span>
                                                                פתיחת הקישור בדרייב
                                                            </a>
                                                            @if (isLatestPending)
                                                            {
                                                                <button type="button"
                                                                        class="tdm-edit-btn"
                                                                        @onclick="@(() => OpenEditOwnSubmission(sub))">
                                                                    <span class="oi oi-pencil" aria-hidden="true"></span>
                                                                    עריכת הגשה
                                                                </button>
                                                                <button type="button"
                                                                        class="tdm-delete-btn"
                                                                        @onclick="@(() => RequestDeleteOwn(sub))">
                                                                    <span class="oi oi-trash" aria-hidden="true"></span>
                                                                    מחיקת הגשה
                                                                </button>
                                                            }
                                                            else if (isLatestApprovedUnmarked)
                                                            {
                                                                <button type="button"
                                                                        class="tdm-moodle-btn"
                                                                        @onclick="@(() => RequestMarkMoodle(sub))">
                                                                    <span class="oi oi-check" aria-hidden="true"></span>
                                                                    הגשתי במודל
                                                                </button>
                                                            }
                                                        </div>

                                                        @if (sub.CourseSubmittedAt.HasValue)
                                                        {
                                                            <div class="tdm-moodle-done">
                                                                <span class="oi oi-circle-check" aria-hidden="true"></span>
                                                                <span>הוגש במודל · @sub.CourseSubmittedAt.IsraelFormat()</span>
                                                            </div>
                                                        }
                                                    </div>
                                                }

                                                @* Legacy uploaded files (pre-cutover). *@
                                                @if (sub.Files.Count > 0)
                                                {
                                                    <div class="tdm-files">
                                                        <span class="tdm-files-label">קבצים מצורפים</span>
                                                        <div class="tdm-files-list">
                                                            @foreach (var f in sub.Files)
                                                            {
                                                                <a class="tdm-file-row"
                                                                   href="/api/task-submissions/@sub.Id/files/@f.Id/download"
                                                                   target="_blank"
                                                                   title="@f.OriginalFileName">
                                                                    <span class="oi oi-file tdm-file-icon" aria-hidden="true"></span>
                                                                    <span class="tdm-file-name">@f.OriginalFileName</span>
                                                                    <span class="tdm-file-size">@FormatSize(f.SizeBytes)</span>
                                                                    <span class="oi oi-cloud-download tdm-file-dl" aria-hidden="true"></span>
                                                                </a>
                                                            }
                                                        </div>
                                                    </div>
                                                }
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    }

            }
    </ChildContent>

    @*  The dismiss control is unconditional: it is the way out of a modal that
        is still loading, or that failed to load, as much as of a loaded one.
        The task's own action only appears once there is a task. *@
    <FooterContent>
                    @* In submission mode the form supplies its own back/submit
                       row — one set of actions, never two. *@
                    @if (!_submitMode)
                    {
                    @if (_task is not null)
                    {
                    @if (!_task.IsSubmission)
                    {
                        @* Activity Task: primary completion CTA; reopen when already done *@
                        @if (_task.Status != "Done")
                        {
                            <button class="tdm-btn-primary motiva-cta" @onclick="CompleteActivity"
                                    disabled="@_updatingStatus">
                                @if (_updatingStatus)
                                {
                                    <div class="tdm-spinner-sm"></div>
                                }
                                else
                                {
                                    <span class="oi oi-circle-check" aria-hidden="true"></span>
                                }
                                סמן כהושלם
                            </button>
                        }
                        else
                        {
                            <button class="tdm-btn-ghost" @onclick="ReopenActivity"
                                    disabled="@_updatingStatus">
                                @if (_updatingStatus)
                                {
                                    <div class="tdm-spinner-sm"></div>
                                }
                                פתיחה מחדש
                            </button>
                        }
                    }
                    else if (CanSubmit)
                    {
                        @* Submission Task: submit / resubmit Drive link *@
                        <button class="tdm-btn-primary motiva-cta" @onclick="OpenSubmission">
                            <span class="oi oi-arrow-top" aria-hidden="true"></span>
                            @(LatestSubmission is null ? "הגשת משימה" : "הגשה מחדש")
                        </button>
                    }
                    }
                    }
    </FooterContent>
</MModal>

@code {
    /// <summary>The task name heads the body, not the shell's header row (which
    /// carries the milestone and task-type chips), so the dialog is pointed at
    /// it explicitly rather than left unnamed.</summary>
    private readonly string _titleId = $"tdm-title-{Guid.NewGuid():N}";

    [Parameter] public int           TaskId  { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    /// <summary>Raised after an inline submission is accepted, so the host page
    /// can refresh whatever it shows about this task. Replaces the old
    /// OnOpenSubmission, which existed only to hand the task off to a second
    /// modal — submitting now happens here.</summary>
    [Parameter] public EventCallback OnTaskChanged { get; set; }

    /// <summary>Bubbles a "the student wants to edit submission X for task T"
    /// signal up to the page that hosts SubmissionModal, so the modal opens
    /// at that level with pre-filled fields.</summary>
    [Parameter] public EventCallback<(int TaskId, int SubmissionId, string? DriveUrl, string? Notes)>
        OnEditMySubmission { get; set; }

    /// <summary>Bubbles a delete request up to the parent page (the parent
    /// hosts the confirm-modal and refresh logic).</summary>
    [Parameter] public EventCallback<int> OnDeleteMySubmission { get; set; }

    /// <summary>Bubbles a "I submitted in Moodle" click up to the parent
    /// page so the same confirm modal handles both entry points.</summary>
    [Parameter] public EventCallback<int> OnMarkMoodleSubmitted { get; set; }

    // ── Task detail state ──────────────────────────────────────────────────────
    private TaskDetailDto?   _task;
    private bool             _loading           = false;
    private bool             _loadError         = false;
    private bool             _updatingStatus    = false;
    private bool             _statusError       = false;

    private readonly HashSet<int> _expandedSubmissions = new();

    /// <summary>True while this modal is showing the submission form instead of
    /// the task detail. It is a STATE OF THIS MODAL, not a second dialog: the
    /// shell, the TaskId and the URL are unchanged across the switch.</summary>
    private bool _submitMode = false;

    // ── Sub-task state ─────────────────────────────────────────────────────────
    private List<StudentSubTaskDto> _subTasks        = new();
    private bool                    _subTasksLoading = false;
    private bool                    _showAddForm     = false;
    private string                  _newSubTaskTitle = "";
    private DateTime?               _newSubTaskDueDate;
    private string?                 _newSubTaskNotes;
    private bool                    _addingSubTask   = false;

    // ── Sub-task inline edit state ─────────────────────────────────────────────
    private int       _editingSubTaskId = 0;
    private string    _editTitle        = "";
    private DateTime? _editDueDate;
    private string?   _editNotes;

    // ── Computed helpers ───────────────────────────────────────────────────────

    private static readonly IReadOnlyList<MSelect.Option> StatusOptions = new[]
    {
        new MSelect.Option("Open",       "ממתין לביצוע"),
        new MSelect.Option("InProgress", "בעבודה"),
    };

    // Derive the effective status to show in the dropdown.
    // Latest submission/review state takes priority over the stored task status,
    // because the server may not have synced task.Status yet for older records.
    private string StatusForDisplay
    {
        get
        {
            if (_task is null) return "Open";
            // Mentor returned → student must fix; always override to returned
            if (LatestSubmission?.MentorStatus == "Returned")
                return "ReturnedForRevision";
            // Reviewer returned
            if (LatestSubmission?.Status == "NeedsRevision")
                return "ReturnedForRevision";
            // RevisionSubmitted is functionally "back at mentor" from student POV
            if (_task.Status is "RevisionSubmitted")
                return "SubmittedToMentor";
            return _task.Status;
        }
    }

    // True only before the task's first mentor submission exists — students
    // may freely toggle between the two student-owned statuses (Open /
    // InProgress) up to that point. Once any submission exists, status
    // ownership passes permanently to the mentor-review / Moodle pipeline and
    // becomes read-only here. Mirrors the server-side check in
    // ProjectsController.UpdateTaskProgress (PATCH /tasks/{id}/progress).
    private bool IsStatusEditable =>
        _task is not null && _task.Submissions.Count == 0;

    // Submissions are ordered oldest-first by the server; the latest is the last element.
    private SubmissionHistoryItemDto? LatestSubmission =>
        _task?.Submissions.Count > 0
            ? _task.Submissions[^1]
            : null;

    // The single, glanceable "current state" pill shown beside the title once
    // status editing is locked (see IsStatusEditable). This is the ONE source
    // of truth for "what's happening with this submission right now" — it
    // replaces the old trio of course-submitted / course-action / Moodle
    // banners, which often duplicated each other and the pipeline at once.
    private (string Label, string CssClass) CurrentSubmissionState
    {
        get
        {
            var sub = LatestSubmission;
            if (sub is null) return (TaskStatusLabel(StatusForDisplay), "neutral");

            if (sub.MentorStatus == "Returned" || sub.Status == "NeedsRevision")
                return ("הוחזר לתיקונים", "returned");

            if (sub.MentorStatus != "Approved")
                return ("ממתין לאישור מנחה", "waiting");

            return sub.CourseSubmittedAt.HasValue
                ? ("הוגש במודל", "done")
                : ("יש להגיש במודל", "approved");
        }
    }

    /// <summary>
    /// True when the due date has passed AND the task is not considered "done".
    /// For submission tasks: only overdue if no submission exists, or the last
    /// submission was returned (NeedsRevision or MentorStatus = Returned).
    /// </summary>
    private bool IsOverdue
    {
        get
        {
            if (_task is null || !_task.DueDate.HasValue) return false;
            if (_task.DueDate.Value.Date >= DateTime.Today)  return false;
            if (_task.Status == "Done")                       return false;

            // Submission task: not overdue when a valid submission exists
            if (_task.IsSubmission && LatestSubmission is not null)
            {
                // Still overdue if the submission was returned for revision
                bool returned = LatestSubmission.MentorStatus == "Returned"
                             || LatestSubmission.Status        == "NeedsRevision";
                if (!returned) return false;
            }

            return true;
        }
    }

    private bool CanSubmit
    {
        get
        {
            if (_task is null || !_task.IsSubmission) return false;
            if (LatestSubmission is null) return true;
            return LatestSubmission.MentorStatus == "Returned"
                || LatestSubmission.Status        == "NeedsRevision";
        }
    }

    // Uses the server-computed LatestMentorStatus field — same approach as the submissions page.
    // Retained but unused — the property is referenced by no markup since the
    // course-submission flow was retired (2026-05-17). Left here briefly to
    // keep call-sites with stale references from breaking the build.
    [Obsolete("Course-submission flow removed; finalisation lives in Moodle.")]
    private bool CanSubmitToCourse => false;

    private bool _scrollLocked;

    // ── Lifecycle ──────────────────────────────────────────────────────────────

    protected override async Task OnParametersSetAsync()
    {
        var isOpen = TaskId > 0;
        if (isOpen && !_scrollLocked)
            try { await JS.InvokeVoidAsync("gradify.scrollLock.lock"); } catch { }
        else if (!isOpen && _scrollLocked)
            try { await JS.InvokeVoidAsync("gradify.scrollLock.unlock"); } catch { }
        _scrollLocked = isOpen;

        if (TaskId <= 0) return;

        _loading      = true;
        _loadError    = false;
        _task         = null;
        _statusError  = false;
        _submitMode   = false;
        _expandedSubmissions.Clear();
        _subTasks          = new();
        _showAddForm       = false;
        _newSubTaskTitle   = "";
        _newSubTaskDueDate = null;
        _newSubTaskNotes   = null;
        _editingSubTaskId  = 0;

        _task      = await TasksService.GetTaskDetailAsync(TaskId);
        _loadError = _task is null;
        _loading   = false;

        if (_task is not null)
        {
            // Auto-expand the latest (last) submission — list is oldest-first.
            if (_task.Submissions.Count > 0)
                _expandedSubmissions.Add(_task.Submissions[^1].Id);

            await LoadSubTasksAsync();
        }
    }

    private async Task LoadSubTasksAsync()
    {
        _subTasksLoading = true;
        _subTasks = await TasksService.GetSubTasksAsync(TaskId);
        _subTasksLoading = false;
    }

    // ── Event handlers ─────────────────────────────────────────────────────────

    private async Task Close() => await OnClose.InvokeAsync();

    /// <summary>Bubble the edit click to the host page (SubmissionsPage),
    /// which already mounts SubmissionModal with edit-mode parameters.</summary>
    private async Task OpenEditOwnSubmission(SubmissionHistoryItemDto sub)
    {
        await OnClose.InvokeAsync();
        if (OnEditMySubmission.HasDelegate)
            await OnEditMySubmission.InvokeAsync((TaskId, sub.Id, sub.DriveUrl, sub.Notes));
    }

    /// <summary>Bubble the delete click — the host page renders the
    /// confirmation modal so a single confirm UI services both entry points.</summary>
    private async Task RequestDeleteOwn(SubmissionHistoryItemDto sub)
    {
        await OnClose.InvokeAsync();
        if (OnDeleteMySubmission.HasDelegate)
            await OnDeleteMySubmission.InvokeAsync(sub.Id);
    }

    /// <summary>Bubble the "I submitted in Moodle" click — same routing
    /// pattern as edit/delete. Parent page owns the confirm dialog.</summary>
    private async Task RequestMarkMoodle(SubmissionHistoryItemDto sub)
    {
        await OnClose.InvokeAsync();
        if (OnMarkMoodleSubmitted.HasDelegate)
            await OnMarkMoodleSubmitted.InvokeAsync(sub.Id);
    }

    /// <summary>The primary action. This used to close the modal and hand the
    /// task to a separate SubmissionModal (and, from the dashboard, navigate to
    /// /tasks and lose the task entirely). It now switches this modal into its
    /// submission state — same dialog, same task, same page.</summary>
    private void OpenSubmission() => _submitMode = true;

    /// <summary>Back out of the submission state. Also the success panel's
    /// action, which is why the detail is reloaded before it is shown again.</summary>
    private void BackToDetails() => _submitMode = false;

    /// <summary>A submission was accepted. Re-fetch the task so the pipeline,
    /// the status pill and the history behind the success panel are the NEW
    /// state, then let the host page refresh its own cards.</summary>
    private async Task OnInlineSubmitted()
    {
        _task = await TasksService.GetTaskDetailAsync(TaskId);
        if (_task is not null && _task.Submissions.Count > 0)
        {
            _expandedSubmissions.Clear();
            _expandedSubmissions.Add(_task.Submissions[^1].Id);
        }
        await OnTaskChanged.InvokeAsync();
    }

    // SubmitToCourseAsync — retired 2026-05-17. The student no longer
    // forwards submissions to course staff inside Gradify; the official
    // deliverable submission happens in Moodle (external).

    private async Task OnStatusDropdownChanged(ChangeEventArgs e)
    {
        var newStatus = e.Value?.ToString() ?? "";
        if (string.IsNullOrEmpty(newStatus) || _task is null) return;
        await SetProgress(newStatus);
    }

    private async Task SetProgress(string status)
    {
        if (_task is null) return;
        _updatingStatus = true;
        _statusError    = false;

        bool ok = await TasksService.UpdateTaskProgressAsync(_task.Id, status);
        if (ok)
            _task.Status = status;
        else
            _statusError = true;

        _updatingStatus = false;
    }

    private void ToggleSubmission(int id)
    {
        if (!_expandedSubmissions.Remove(id))
            _expandedSubmissions.Add(id);
    }

    // ── Sub-task handlers ──────────────────────────────────────────────────────

    private async Task OnSubTaskInputKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await AddSubTask();
    }

    private void ToggleAddForm()
    {
        _showAddForm = !_showAddForm;
        if (!_showAddForm)
        {
            _newSubTaskTitle   = "";
            _newSubTaskDueDate = null;
            _newSubTaskNotes   = null;
        }
    }

    private async Task AddSubTask()
    {
        var title = _newSubTaskTitle.Trim();
        if (string.IsNullOrEmpty(title) || _addingSubTask) return;

        _addingSubTask = true;
        var req = new CreateSubTaskRequest
        {
            Title   = title,
            Status  = "Open",
            DueDate = _newSubTaskDueDate,
            Notes   = string.IsNullOrWhiteSpace(_newSubTaskNotes) ? null : _newSubTaskNotes.Trim(),
        };
        var created = await TasksService.CreateSubTaskAsync(TaskId, req);
        if (created is not null)
        {
            _subTasks.Add(created);
            _newSubTaskTitle   = "";
            _newSubTaskDueDate = null;
            _newSubTaskNotes   = null;
            _showAddForm       = false;
        }
        _addingSubTask = false;
    }

    private async Task ToggleSubTask(StudentSubTaskDto st)
    {
        bool ok = await TasksService.ToggleSubTaskAsync(st.Id);
        if (ok) st.IsDone = !st.IsDone;
    }

    private void StartSubTaskEdit(StudentSubTaskDto st)
    {
        _editingSubTaskId = st.Id;
        _editTitle        = st.Title;
        _editDueDate      = st.DueDate;
        _editNotes        = st.Notes;
    }

    private void CancelSubTaskEdit()
    {
        _editingSubTaskId = 0;
    }

    private async Task SaveSubTaskEdit(StudentSubTaskDto st)
    {
        var title = _editTitle.Trim();
        if (string.IsNullOrEmpty(title)) return;

        var req = new UpdateSubTaskRequest
        {
            Title   = title,
            Status  = st.Status,   // preserve; not edited in UI
            DueDate = _editDueDate,
            Notes   = string.IsNullOrWhiteSpace(_editNotes) ? null : _editNotes.Trim(),
        };
        bool ok = await TasksService.UpdateSubTaskAsync(st.Id, req);
        if (ok)
        {
            st.Title   = req.Title;
            st.DueDate = req.DueDate;
            st.Notes   = req.Notes;
        }
        _editingSubTaskId = 0;
    }

    private async Task DeleteSubTask(StudentSubTaskDto st)
    {
        bool ok = await TasksService.DeleteSubTaskAsync(st.Id);
        if (ok) _subTasks.Remove(st);
    }

    // ── Activity Task helpers ──────────────────────────────────────────────────

    // Simple status label for Activity Tasks (no submission pipeline).
    private string ActivityStatusLabel => _task?.Status switch
    {
        "Done"       => "הושלמה",
        "InProgress" => "בביצוע",
        _            => "ממתין לביצוע",
    };

    private string ActivityStatusCssClass => _task?.Status == "Done" ? "done" : "neutral";

    private string DueDateLabel =>
        _task?.IsSubmission == true ? "מועד הגשה" : "תאריך יעד";

    private async Task CompleteActivity() => await SetProgress("Done");

    private async Task ReopenActivity()   => await SetProgress("InProgress");

    // ── Status label/class helpers ─────────────────────────────────────────────

    private static string TaskStatusLabel(string status) => status switch
    {
        "Open"                  => "ממתין לביצוע",
        "InProgress"            => "בעבודה",
        "SubmittedToMentor"     => "הועבר לבדיקת מנחה",
        "RevisionSubmitted"     => "הועבר לבדיקת מנחה",
        "ReturnedForRevision"   => "הוחזר לתיקונים",
        "ApprovedForSubmission" => "יש להגיש במודל",
        "Done"                  => "הושלם",
        _                       => status,
    };

    private static string SubmissionStatusLabel(string s) => s switch
    {
        "Reviewed"      => "אושר",
        "NeedsRevision" => "הוחזר לתיקון",
        _               => "ממתין לבדיקה",
    };

    private static string MentorStatusLabel(string s) => s switch
    {
        "Approved" => "אושר ע״י מנחה",
        "Returned" => "הוחזר ע״י מנחה",
        _          => "ממתין לאישור מנחה",
    };

    // ── Submission workflow ────────────────────────────────────────────────────

    private enum TimelineState { Done, Returned, Active, Locked }

    private sealed class TimelineStep
    {
        public string        Title    { get; init; } = "";
        public string        Subtitle { get; init; } = "";
        public TimelineState State    { get; init; }
    }

    // 4-step workflow shown ABOVE description for all Submission Tasks.
    // Visible even before the first submission (all steps Locked/○).
    // Mapping:
    //   Step 1 הגשה למנחה  : Done=has submission & not returned; Active=returned; Locked=no submissions
    //   Step 2 בדיקת מנחה  : Done=MentorApproved; Returned=MentorReturned; Active=Pending; Locked=no sub
    //   Step 3 הגשה במודל  : Done=CourseSubmittedAt set; Active=Approved+no moodle; Locked=not approved yet
    //   Step 4 הושלם        : Done=CourseSubmittedAt set; Locked=otherwise
    private List<TimelineStep> BuildWorkflowSteps()
    {
        var sub = LatestSubmission;

        bool hasSubmission = sub is not null;
        bool returned      = hasSubmission && (sub!.MentorStatus == "Returned" || sub.Status == "NeedsRevision");
        bool mentorApproved = hasSubmission && sub!.MentorStatus == "Approved";
        bool moodleDone    = mentorApproved && sub!.CourseSubmittedAt.HasValue;

        // Step 1: הגשה למנחה
        TimelineState step1State;
        string        step1Sub;
        if (!hasSubmission)
        {
            step1State = TimelineState.Locked;
            step1Sub   = "טרם הוגש";
        }
        else if (returned)
        {
            step1State = TimelineState.Active;   // needs resubmission
            step1Sub   = "נדרשת הגשה מחדש";
        }
        else
        {
            step1State = TimelineState.Done;
            step1Sub   = sub!.SubmittedAt != default ? FormatStepStamp(sub.SubmittedAt) : "";
        }

        // Step 2: בדיקת מנחה
        TimelineState step2State;
        string        step2Sub;
        if (!hasSubmission)
        {
            step2State = TimelineState.Locked;
            step2Sub   = "";
        }
        else if (sub!.MentorStatus == "Returned")
        {
            step2State = TimelineState.Returned;
            step2Sub   = sub.MentorReviewedAt.HasValue
                ? $"הוחזר · {FormatStepStamp(sub.MentorReviewedAt.Value)}"
                : "הוחזר לתיקון";
        }
        else if (mentorApproved)
        {
            step2State = TimelineState.Done;
            step2Sub   = sub.MentorReviewedAt.HasValue ? FormatStepStamp(sub.MentorReviewedAt.Value) : "";
        }
        else
        {
            step2State = TimelineState.Active;
            step2Sub   = "ממתין לבדיקת מנחה";
        }

        // Step 3: הגשה במודל
        TimelineState step3State;
        string        step3Sub;
        if (moodleDone)
        {
            step3State = TimelineState.Done;
            step3Sub   = FormatStepStamp(sub!.CourseSubmittedAt!.Value);
        }
        else if (mentorApproved)
        {
            step3State = TimelineState.Active;
            step3Sub   = "יש להגיש במודל";
        }
        else
        {
            step3State = TimelineState.Locked;
            step3Sub   = "";
        }

        // Step 4: הושלם
        var step4State = moodleDone ? TimelineState.Done : TimelineState.Locked;
        var step4Sub   = moodleDone ? "המשימה הושלמה" : "";

        return new List<TimelineStep>
        {
            new() { Title = "הגשה למנחה",  Subtitle = step1Sub, State = step1State },
            new() { Title = "בדיקת מנחה",  Subtitle = step2Sub, State = step2State },
            new() { Title = "הגשה במודל",  Subtitle = step3Sub, State = step3State },
            new() { Title = "הושלם",        Subtitle = step4Sub, State = step4State },
        };
    }

    // 3-step timeline used inside EACH row of the submission history accordion.
    private static List<TimelineStep> BuildTimelineSteps(SubmissionHistoryItemDto sub)
    {
        bool returned = sub.MentorStatus == "Returned" || sub.Status == "NeedsRevision";

        var steps = new List<TimelineStep>
        {
            new()
            {
                Title    = "הוגש לאישור מנחה",
                Subtitle = FormatStepStamp(sub.SubmittedAt),
                State    = TimelineState.Done,
            },
        };

        steps.Add(sub.MentorStatus switch
        {
            "Approved" => new TimelineStep
            {
                Title    = "אושר ע״י מנחה",
                Subtitle = sub.MentorReviewedAt.HasValue ? FormatStepStamp(sub.MentorReviewedAt.Value) : "",
                State    = TimelineState.Done,
            },
            _ when returned => new TimelineStep
            {
                Title    = "אושר ע״י מנחה",
                Subtitle = sub.MentorReviewedAt.HasValue
                    ? $"הוחזר לתיקונים · {FormatStepStamp(sub.MentorReviewedAt.Value)}"
                    : "הוחזר לתיקונים",
                State    = TimelineState.Returned,
            },
            _ => new TimelineStep
            {
                Title    = "אושר ע״י מנחה",
                Subtitle = "ממתין לבדיקת מנחה",
                State    = TimelineState.Active,
            },
        });

        steps.Add(sub.CourseSubmittedAt.HasValue
            ? new TimelineStep
              {
                  Title    = "הוגש במודל",
                  Subtitle = FormatStepStamp(sub.CourseSubmittedAt.Value),
                  State    = TimelineState.Done,
              }
            : new TimelineStep
              {
                  Title    = "הוגש במודל",
                  Subtitle = sub.MentorStatus == "Approved" ? "ממתין להגשה ב-Moodle" : "טרם זמין",
                  State    = sub.MentorStatus == "Approved" ? TimelineState.Active : TimelineState.Locked,
              });

        return steps;
    }

    private static string FormatStepStamp(DateTime utc) =>
        $"{utc.IsraelFormat("dd.MM.yyyy")} | {utc.IsraelFormat("HH:mm")}";

    private static string TimelineMarkerIcon(TimelineState state) => state switch
    {
        TimelineState.Done     => "oi-check",
        TimelineState.Returned => "oi-x",
        TimelineState.Active   => "oi-media-record",
        _                      => "oi-media-record",
    };

    private static string TimelineStateClass(TimelineState state) => state switch
    {
        TimelineState.Done     => "done",
        TimelineState.Returned => "returned",
        TimelineState.Active   => "active",
        _                      => "locked",
    };

    private static string FormatSize(long bytes)
    {
        if (bytes < 1024)      return $"{bytes} B";
        if (bytes < 1_048_576) return $"{bytes / 1024} KB";
        return $"{bytes / 1_048_576.0:F1} MB";
    }

    public async ValueTask DisposeAsync()
    {
        if (_scrollLocked)
            try { await JS.InvokeVoidAsync("gradify.scrollLock.unlock"); } catch { }
    }
}
