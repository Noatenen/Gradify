@using AuthWithAdmin.Shared.AuthSharedModels

<div class="tsc-strip">

    <button class="tsc-pill tsc-pill-active @(ActiveFilter == "active" ? "tsc-pill-selected" : "")"
            @onclick='() => OnFilterChange.InvokeAsync(ActiveFilter == "active" ? "" : "active")'>
        <span class="tsc-pill-count">@ActiveCount</span>
        <span class="tsc-pill-label">פעילות</span>
    </button>

    <button class="tsc-pill tsc-pill-pending @(ActiveFilter == "pending" ? "tsc-pill-selected" : "")"
            @onclick='() => OnFilterChange.InvokeAsync(ActiveFilter == "pending" ? "" : "pending")'>
        <span class="tsc-pill-count">@PendingCount</span>
        <span class="tsc-pill-label">דורשות תשומת לב</span>
        @if (PendingCount > 0 && ActiveFilter != "pending")
        {
            <span class="tsc-pill-alert" aria-hidden="true"></span>
        }
    </button>

    <button class="tsc-pill tsc-pill-completed @(ActiveFilter == "completed" ? "tsc-pill-selected" : "")"
            @onclick='() => OnFilterChange.InvokeAsync(ActiveFilter == "completed" ? "" : "completed")'>
        <span class="tsc-pill-count">@CompletedCount</span>
        <span class="tsc-pill-label">הושלמו</span>
    </button>

</div>

@code {
    [Parameter, EditorRequired] public int    ActiveCount    { get; set; }
    [Parameter, EditorRequired] public int    PendingCount   { get; set; }
    [Parameter, EditorRequired] public int    CompletedCount { get; set; }
    [Parameter]                 public string ActiveFilter   { get; set; } = "";
    [Parameter]                 public EventCallback<string> OnFilterChange { get; set; }
}