@*
    TaskStatusTabs — the finalized Tasks screen's filter switcher.

    The final design (design-reference/motiva-student-final, Motiva Student
    Tasks final) puts four tabs in one segmented pill group on the title row:

        הכל · דורש התייחסות② · השבוע · הושלמו

    — not a KPI grid. This replaces TaskStatusOverview. The two counts that
    drove behaviour survive: the attention count rides its tab as a badge, and
    every tab writes the SAME `_kpiFilter` the page already owned, so the
    filter bar, the milestone groups and the team panel are untouched.

    "דורש התייחסות" was an anchor that jumped to a section; the reference makes
    it a filter like its neighbours, which is why the page gained an
    "attention" arm in PassesKpiFilter/TeamFilter.
*@

<nav class="tst" aria-label="סינון משימות">

    <button type="button"
            class="@TabClass(string.IsNullOrEmpty(ActiveFilter))"
            aria-pressed="@string.IsNullOrEmpty(ActiveFilter)"
            @onclick="@(() => Select(""))">
        הכל
    </button>

    <button type="button"
            class="@TabClass(ActiveFilter == "attention")"
            aria-pressed="@(ActiveFilter == "attention")"
            @onclick="@(() => Select("attention"))">
        דורש התייחסות
        @if (AttentionCount > 0)
        {
            <span class="tst-badge">@AttentionCount</span>
        }
    </button>

    <button type="button"
            class="@TabClass(ActiveFilter == "week")"
            aria-pressed="@(ActiveFilter == "week")"
            @onclick="@(() => Select("week"))">
        השבוע
    </button>

    <button type="button"
            class="@TabClass(ActiveFilter == "done")"
            aria-pressed="@(ActiveFilter == "done")"
            @onclick="@(() => Select("done"))">
        הושלמו
    </button>

</nav>

@code {
    [Parameter, EditorRequired] public int AttentionCount   { get; set; }
    [Parameter, EditorRequired] public int DueThisWeekCount { get; set; }
    [Parameter, EditorRequired] public int TeamCount        { get; set; }
    [Parameter, EditorRequired] public int CompletedCount   { get; set; }

    /// <summary>"" | "attention" | "week" | "done".</summary>
    [Parameter] public string ActiveFilter { get; set; } = "";

    [Parameter] public EventCallback<string> OnSelectFilter { get; set; }

    // "" clears; anything else toggles, which the page's own handler already does.
    private Task Select(string key) => OnSelectFilter.InvokeAsync(key);

    private static string TabClass(bool selected) =>
        selected ? "tst-tab tst-tab-active" : "tst-tab";
}
