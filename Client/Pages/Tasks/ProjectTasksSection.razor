@using AuthWithAdmin.Shared.AuthSharedModels

@*
    ProjectTasksSection — the finalized design's "משימות הפרויקט" panel
    (Motiva Tasks.dc.html, first child of #task-sections, the wider 1.6fr track).

    This restores the milestone hierarchy the previous board flattened away:
    TasksPageDto already ships ActiveGroups / CompletedGroups as real
    TaskMilestoneGroupDto records, and the page had been discarding everything
    but the milestone's title. Nothing is invented here — current vs completed,
    the task counts and the due dates all come off the existing DTO.

    The Design's two milestone states:
      • current   — gradient-wash block, hollow violet ring dot, expanded
      • completed — plain block, solid teal dot, collapsed

    Both now carry the milestone's own due date and its own DoneCount/TotalCount
    as a bar plus a count, replacing the text meta that used to sit there. The
    counts were already on the DTO and already loaded; only the rendering is new.
*@

@*
    Fill. The card is one column of a stretch row now, so it takes the row's
    full height and hands it down: .m-card-fill is height:100% + flex column +
    min-height:0, .pts-body claims what is left, and the scroll box inside it
    is the only thing that scrolls.

    An earlier pass removed Fill for the opposite reason — the page grid was
    `align-items: start`, every card was as tall as its own content, and Fill
    made this one a 482px box around 109px of rows. That was true of THAT
    composition. Here the row's height is the viewport's, both columns claim
    it, and the panel is full because the work fills it, not because a
    constant said so.
*@
<MCard Padding="MCard.CardPadding.None" Fill="true">
    <div class="pts-body">
        <div class="pts-header">
            <p class="pts-title">משימות הפרויקט</p>
            @* The reference sets a muted "· N" beside every section title. It is
               the number of milestones currently listed — real, already in hand,
               and it tells the student how much is below without a scroll. *@
            <span class="pts-count">· @Groups.Count</span>
        </div>

        @*
            No MaxHeight. The scroll box takes whatever the column has left
            after the header — see .pts-body ::deep .m-scroll in the scoped
            CSS, which is how a parent reaches a child component's root when
            Blazor's isolation will not put the scope attribute on it.

            What went away with it was a hand-measured constant: "~319px of
            page above this panel plus 73px of its own chrome", re-derived
            every time anything above it moved, and wrong the moment the filter
            bar appeared. The height is now inherited from the row.
        *@
        <MScrollArea Tabbable="false">
            @if (Groups.Count == 0)
            {
                <MEmptyState Title="@EmptyMessage" Live="true" />
            }
            else
            {
                @foreach (var group in Groups)
                {
                    var captured = group;
                    var isCurrent = IsCurrent(group);
                    var isOpen = IsExpanded(group);

                    <div class="pts-milestone @(isCurrent ? "pts-milestone-current" : "")">
                        <button type="button"
                                class="pts-mile-head"
                                aria-expanded="@(isOpen ? "true" : "false")"
                                @onclick="@(() => Toggle(captured.ProjectMilestoneId))">
                            <span class="pts-mile-lead">
                                @* A 30px circular target with a 14px SVG, in
                                   place of an 11px "⌄" text glyph — the control
                                   that expands the milestone should look and
                                   behave like a control. *@
                                <span class="pts-chevron @(isOpen ? "pts-chevron-open" : "")" aria-hidden="true">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                         stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="m6 9 6 6 6-6"></path>
                                    </svg>
                                </span>
                                @* Reference marker: 14px, not 8. Current is a
                                   white disc with a 3.5px violet ring and a soft
                                   pulse; a finished milestone is a filled teal
                                   disc carrying a white check. At 8px neither
                                   read as anything but a bullet. *@
                                <span class="pts-dot @(isCurrent ? "pts-dot-current" : "pts-dot-done")" aria-hidden="true">
                                    @if (!isCurrent && IsDone(group))
                                    {
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                             stroke-width="3.6" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="m5 12.5 4.5 4.5L19 7"></path>
                                        </svg>
                                    }
                                </span>
                                <strong class="pts-mile-title">@group.MilestoneTitle</strong>
                                @if (group.DueDate.HasValue)
                                {
                                    <span class="pts-mile-due">יעד @group.DueDate.Value.ToString("dd.MM")</span>
                                }
                            </span>

                            @*
                                Per-milestone progress, from the group's OWN
                                DoneCount/TotalCount. Each milestone reports only
                                its own completion — פיתוח can read 100% while
                                הערכה reads 50% — which is the independent model,
                                not a position in a sequence. It is deliberately a
                                bar and a count rather than the dashboard's
                                journey: the journey answers "where is the project",
                                this answers "how far is this one milestone".
                            *@
                            <span class="pts-mile-trail">
                                <span class="pts-mile-bar" aria-hidden="true">
                                    <span class="pts-mile-bar-fill @BarClass(group)"
                                          style="width: @PercentOf(group)%"></span>
                                </span>
                                <span class="pts-mile-count @(IsDone(group) ? "pts-mile-count-done" : "")">
                                    @group.DoneCount/@group.TotalCount
                                </span>
                            </span>
                        </button>

                        @if (isOpen)
                        {
                            <div class="pts-mile-body">
                                @if (group.Tasks.Count == 0)
                                {
                                    <p class="pts-mile-empty">@EmptyMessage</p>
                                }
                                else
                                {
                                    @foreach (var task in group.Tasks)
                                    {
                                        var capturedTask = task;
                                        <button type="button" class="pts-task @(TaskStatusHelpers.IsOverdue(task) ? "pts-task-late" : "")"
                                                @onclick="@(() => OnOpenDetail.InvokeAsync(capturedTask.Id))"
                                                aria-label="@($"פתיחת {task.Title}")">
                                            @*
                                                Three siblings, not a nested main +
                                                status: the row is a grid, so title,
                                                meta and status line up into columns
                                                down the whole list. Nested, the
                                                title block absorbed the panel's
                                                width and stranded the status pill
                                                ~750px from the task it described.

                                                The meta column carries the due date
                                                plus the two facts already on the DTO
                                                that were never shown — whether the
                                                task is a submission and whether it
                                                is mandatory. Both are real columns
                                                (IsSubmission, IsMandatory); neither
                                                is invented and neither adds a status.
                                            *@
                                            <strong class="pts-task-title">@task.Title</strong>

                                            <span class="pts-task-meta">
                                                @if (task.DueDate.HasValue)
                                                {
                                                    <span class="pts-task-due">יעד @task.DueDate.Value.ToString("dd.MM")</span>
                                                }
                                                @if (task.IsSubmission)
                                                {
                                                    <span class="pts-task-tag">הגשה</span>
                                                }
                                                @if (task.IsMandatory)
                                                {
                                                    <span class="pts-task-tag pts-task-tag-req">חובה</span>
                                                }
                                            </span>

                                            <span class="pts-task-status @StatusClass(task)">@StatusLabel(task)</span>

                                            @* The reference ends every openable
                                               task row with a chevron pointing
                                               the way the row opens. Ours opens a
                                               modal rather than expanding, so the
                                               glyph points to the reading end (‹)
                                               instead of down — an expand chevron
                                               here would promise in-place detail
                                               the row does not give. *@
                                            <span class="pts-task-go" aria-hidden="true">
                                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                                     stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                                    <path d="m15 6-6 6 6 6"></path>
                                                </svg>
                                            </span>
                                        </button>
                                    }
                                }
                            </div>
                        }
                    </div>
                }
            }
        </MScrollArea>
    </div>
</MCard>

@code {
    /// <summary>Milestone groups to render, already filtered/ordered by the page.
    /// The component does no filtering of its own.</summary>
    [Parameter, EditorRequired] public IReadOnlyList<TaskMilestoneGroupDto> Groups { get; set; } = Array.Empty<TaskMilestoneGroupDto>();

    /// <summary>Milestone ids the page considers "current" — the ones the Design
    /// emphasises and expands by default.</summary>
    [Parameter] public IReadOnlySet<int> CurrentMilestoneIds { get; set; } = new HashSet<int>();

    [Parameter] public string EmptyMessage { get; set; } = "אין משימות להצגה.";

    [Parameter] public EventCallback<int> OnOpenDetail { get; set; }

    // Expansion is pure view state: which milestones the student has opened or
    // closed. Absent from the set means "use the default for this milestone",
    // which the Design defines as open for current, closed for completed.
    private readonly Dictionary<int, bool> _expanded = new();

    private bool IsCurrent(TaskMilestoneGroupDto g) => CurrentMilestoneIds.Contains(g.ProjectMilestoneId);

    private bool IsExpanded(TaskMilestoneGroupDto g) =>
        _expanded.TryGetValue(g.ProjectMilestoneId, out var open) ? open : IsCurrent(g);

    private void Toggle(int milestoneId)
    {
        var group = Groups.FirstOrDefault(g => g.ProjectMilestoneId == milestoneId);
        bool current = group is not null && IsExpanded(group);
        _expanded[milestoneId] = !current;
    }

    // ── Per-milestone progress ───────────────────────────────────────────────
    // Straight from the group's own counts. This replaced the old text meta
    // ("אבן דרך נוכחית" / "N משימות · הושלמה"): the current milestone is
    // already marked by its wash and ring dot, so that label was restating
    // what the surface said, and the completed-milestone sentence buried the
    // one number worth scanning. A bar plus "done/total" says both in less
    // space and stays true for a milestone that is neither.
    private static int PercentOf(TaskMilestoneGroupDto g) =>
        g.TotalCount <= 0 ? 0 : (int)Math.Round(100.0 * g.DoneCount / g.TotalCount);

    private static bool IsDone(TaskMilestoneGroupDto g) =>
        g.TotalCount > 0 && g.DoneCount >= g.TotalCount;

    // Teal at full, the violet→teal ramp while in flight, nothing at zero — the
    // same three readings the journey stepper uses, so a milestone means the
    // same thing on both surfaces.
    private static string BarClass(TaskMilestoneGroupDto g) =>
        g.DoneCount <= 0 ? "pts-mile-bar-empty"
        : IsDone(g)      ? "pts-mile-bar-done"
                         : "pts-mile-bar-part";

    // Status text and tone come from the existing shared helpers — this section
    // introduces no second status vocabulary.
    private static string StatusLabel(TaskItemDto t) => TaskStatusHelpers.GetCategory(t) switch
    {
        TaskStatusHelpers.TaskCategory.Completed             => "הושלם",
        TaskStatusHelpers.TaskCategory.Returned              => "נדרש תיקון",
        TaskStatusHelpers.TaskCategory.ApprovedForSubmission => "מאושרת להגשה",
        _                                                     => TaskStatusHelpers.IsOverdue(t) ? "באיחור" : "פתוחה",
    };

    private static string StatusClass(TaskItemDto t) => TaskStatusHelpers.GetCategory(t) switch
    {
        TaskStatusHelpers.TaskCategory.Completed             => "pts-status-done",
        TaskStatusHelpers.TaskCategory.Returned              => "pts-status-attention",
        TaskStatusHelpers.TaskCategory.ApprovedForSubmission => "pts-status-done",
        _                                                     => TaskStatusHelpers.IsOverdue(t) ? "pts-status-attention" : "pts-status-open",
    };
}
