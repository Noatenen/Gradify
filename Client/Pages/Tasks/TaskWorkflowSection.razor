@*
    TaskWorkflowSection — one zone inside the shared ambient canvas.

    An editorial subheading, not a widget: icon + title + a plain muted
    count (no pill/badge), thin divider from the section above. Only
    "הושלמו" is collapsible (collapsed by default) — every other section
    stays permanently visible.
*@

<div class="tws-section">
    <button class="tws-header @(Collapsible ? "tws-header-toggle" : "tws-header-static")"
            @onclick="Toggle"
            disabled="@(!Collapsible)"
            aria-expanded="@_expanded">
        <span class="oi @Icon tws-icon" aria-hidden="true"></span>
        <span class="tws-title">@Title</span>
        <span class="tws-count">(@Count)</span>
        @if (Collapsible)
        {
            <span class="oi @(_expanded ? "oi-chevron-top" : "oi-chevron-bottom") tws-chevron" aria-hidden="true"></span>
        }
    </button>

    @if (!Collapsible || _expanded)
    {
        <div class="tws-body">
            @ChildContent
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter, EditorRequired] public string Icon { get; set; } = "";
    [Parameter, EditorRequired] public int Count { get; set; }
    [Parameter] public bool Collapsible { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private bool _expanded;

    protected override void OnParametersSet()
    {
        // Non-collapsible sections always render their body; collapsible
        // ones (today: only "הושלמו") start closed so they never compete
        // with the actionable sections above them.
        if (!Collapsible) _expanded = true;
    }

    private void Toggle()
    {
        if (Collapsible) _expanded = !_expanded;
    }
}
