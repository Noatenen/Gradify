@namespace AuthWithAdmin.Client.Shared

@*
    ═══════════════════════════════════════════════════════════════════════
    AboutModal — "אודות", the final-project credit surface.

    ONE IMPLEMENTATION, EVERY EXPERIENCE. Mounted exactly once, by AppLayout,
    and opened through AboutDialogService from either entry point — the
    profile menu in the top bar or the footer line. Student, Mentor and
    Lecturer/Management all render MotivaTopNav, so all three reach the same
    component; there is deliberately no per-role variant, because nothing in
    these credits differs by who is reading them.

    THE SHELL IS MModal — the same dialog every other Motiva popup uses. It
    brings role="dialog", aria-modal, the Escape handler, backdrop dismissal,
    the close button, open-focus and the scroll lock, so none of that is
    re-implemented here. This file supplies content and nothing else.

    THE ASSET PATHS ARE BASE-RELATIVE, with no leading slash — the convention
    index.html states for the favicon and every other client path:

        images/branding/faculty_logo.png       ✓ resolves against <base href>
        /images/branding/faculty_logo.png      ✗ resolves against the origin

    The app deploys under a sub-path, where a leading slash 404s. The same
    spelling AppSideNav, MotivaTopNav, AuthShell and CreateTeam already use.

    NO LOGO IS SCALED ON BOTH AXES. Every image here is `object-fit: contain`
    inside a box, so each keeps its own aspect ratio and its own colours, and
    none is cropped or redrawn. The three files differ a lot in shape
    (1566x338, 5310x2104, 4545x3144) and in how much whitespace each bakes
    in, which is exactly why the boxes are tuned individually in the
    stylesheet rather than sharing one size.
    ═══════════════════════════════════════════════════════════════════════
*@

<MModal IsOpen="@IsOpen"
        Size="MModal.ModalSize.Large"
        AriaLabelledBy="@_titleId"
        OnClose="OnClose"
        Class="abt-modal">

    <HeaderContent>
        @* MOTIVA IS THE IDENTITY OF THIS DIALOG, so the wordmark heads it
           rather than a text title. The accessible name comes from the alt
           text, which is what AriaLabelledBy points at. *@
        <div class="abt-head">
            <img src="images/motiva-logo.png"
                 alt="MOTIVA"
                 id="@_titleId"
                 class="abt-wordmark" />
            <p class="abt-tagline">מערכת לניהול וליווי תהליך פרויקט הגמר</p>
        </div>
    </HeaderContent>

    <ChildContent>
        @*
            The credits, as a description list — which is what they are:
            labelled values. <dl> gives the pairing real semantics instead of
            styled <div>s and costs nothing visually.

            GROUPED ON ONE SOFT SURFACE rather than floated on the dialog's
            white: it reads as a single block of provenance instead of four
            stray lines, and the tint is the same barely-there violet the
            product uses for a raised row. One level of grouping only — no
            card inside a card.
        *@
        <dl class="abt-credits">
            <div class="abt-item">
                <dt class="abt-label">פותח עבור</dt>
                <dd class="abt-value">הפקולטה לטכנולוגיות למידה – המכון הטכנולוגי חולון</dd>
            </div>

            <div class="abt-item">
                <dt class="abt-label">פותח על ידי</dt>
                <dd class="abt-value">נועה טננבאום ואופיר שרעבי</dd>
            </div>

            <div class="abt-item">
                <dt class="abt-label">מנחי הפרויקט</dt>
                <dd class="abt-value">ינאי זגורי ואבי לוי</dd>
            </div>

            <div class="abt-item">
                <dt class="abt-label">שנת הפרויקט</dt>
                @* Latin digits inside an RTL line — isolated so the bidi
                   algorithm cannot reorder them against neighbouring text. *@
                <dd class="abt-value"><bdi>2026</bdi></dd>
            </div>
        </dl>

        @*
            ── The institutional strip ──────────────────────────────────
            The two official marks, paired, with the way to the faculty
            beside them. Separated from the credits above by one hairline —
            the only rule in the dialog, because it divides two genuinely
            different kinds of content.
        *@
        <div class="abt-institution">
            @*
                NO loading="lazy" ON THESE TWO. It deadlocks here: the marks
                are sized `width: auto` inside a height box, so before the
                file decodes the element is 0px wide — and a zero-width
                element never intersects the viewport, so the lazy loader
                never fetches it and the width never becomes non-zero.
                Measured: complete:false, naturalWidth 0, still 0 after
                three seconds. They are fetched only when the dialog first
                opens (these elements do not exist until then), so eager
                loading costs nothing.
            *@
            <div class="abt-marks">
                <img src="images/branding/faculty_logo.png"
                     alt="הפקולטה לטכנולוגיות למידה"
                     class="abt-mark abt-mark-faculty" />

                <span class="abt-marks-rule" aria-hidden="true"></span>

                <img src="images/branding/hit_logo.png"
                     alt="המכון הטכנולוגי חולון"
                     class="abt-mark abt-mark-hit" />
            </div>

            @* rel="noopener noreferrer" is not decoration: target="_blank"
               otherwise hands the opened page a live window.opener reference
               back into the app. *@
            <a class="abt-link"
               href="https://www.hit.ac.il/academic/instructional-technologies/"
               target="_blank"
               rel="noopener noreferrer">
                <span>אתר הפקולטה לטכנולוגיות למידה</span>
                <svg class="abt-link-ico" width="13" height="13" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"
                     aria-hidden="true">
                    <path d="M15 3h6v6"></path>
                    <path d="M10 14 21 3"></path>
                    <path d="M21 14v7H3V3h7"></path>
                </svg>
                <span class="abt-sr">נפתח בחלון חדש</span>
            </a>
        </div>
    </ChildContent>
</MModal>

@code {
    /// <summary>The wordmark carries the dialog's accessible name, so the id
    /// is generated per instance rather than hard-coded.</summary>
    private readonly string _titleId = $"abt-title-{Guid.NewGuid():N}";

    [Parameter] public bool           IsOpen  { get; set; }
    [Parameter] public EventCallback  OnClose { get; set; }
}
