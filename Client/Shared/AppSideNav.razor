@using AuthWithAdmin.Client.Services
@using AuthWithAdmin.Client.Models
@using AuthWithAdmin.Shared.AuthSharedModels
@inject IAuthenticationService _Auth
@inject IProjectContextService _ProjectContext
@inject NavigationManager Nav
@implements IDisposable

<aside class="sidenav-wrapper @(IsStudentNav ? "snav-motiva" : "")">
    <div class="sidenav-panel">

        <!-- ======= Logo (+ notification bell, students) ======= -->
        @*
            The System Master puts the notification bell in the sidebar
            header beside the wordmark, present on every student screen —
            it is global navigation, not page chrome. For students it is
            rendered here; every other role keeps it in AppTopBar exactly
            as before (see AppTopBar.razor).

            This is a PLACEMENT change only. NotificationBell itself is
            untouched — same component, same unread polling, same
            outside-click/mark-all-read behaviour, same role-aware
            GetTargetUrl / BuildRequestUrl routing. Its student-specific
            appearance is applied from AppSideNav.razor.css via ::deep,
            so the component's own styles stay valid for AppTopBar.
        *@
        <div class="snav-logo">
            <img src="/images/motiva-logo.png" alt="Motiva" class="snav-logo-img" />
            @if (IsStudentNav)
            {
                <NotificationBell />
            }
        </div>

        <!-- ======= User header (staff + mentors) ======= -->
        @*
            Students no longer get a block here. Their project context
            moved to the BOTTOM of the rail, directly above the profile —
            see the "Project context" section below. The rail now reads
            brand -> navigation -> project -> user, so the two pieces of
            context about WHO and WHERE sit together at the foot instead of
            one of them interrupting the brand and the nav.
        *@
        @if (!RoleService.IsStudent(_user))
        {
            <div class="snav-header">
                <div class="snav-user-row">
                    <div class="snav-avatar">@GetInitials()</div>
                    <div class="snav-user-text">
                        <div class="snav-user-name">@($"{_user?.FirstName} {_user?.LastName}".Trim())</div>
                        <div class="snav-user-role">@RoleService.GetRoleLabel(_user)</div>
                        @if (_projectCtx is not null)
                        {
                            <div class="snav-project-info">
                                <div class="snav-project-number-row">
                                    <div class="snav-project-number">
                                        <span class="oi oi-layers" aria-hidden="true"></span>
                                        צוות @_projectCtx.ProjectNumber
                                    </div>
                                    <TeamQuickInfoPopover TeamName="@(string.IsNullOrWhiteSpace(_projectCtx.TeamName) ? $"צוות {_projectCtx.ProjectNumber}" : _projectCtx.TeamName)"
                                                          ProjectTitle="@_projectCtx.ProjectTitle"
                                                          TrackName="@_projectCtx.TrackName"
                                                          StudentNames="_projectCtx.StudentNames"
                                                          StudentEmails="_projectCtx.StudentEmails"
                                                          MentorNames="_projectCtx.MentorNames"
                                                          MentorEmails="_projectCtx.MentorEmails"
                                                          MentorUserIds="_projectCtx.MentorUserIds"
                                                          ShowCopyAll="false">
                                        <button type="button"
                                                class="snav-team-info-btn"
                                                title="פרטי צוות"
                                                aria-label="פרטי צוות">
                                            <span class="oi oi-info" aria-hidden="true"></span>
                                            <span class="snav-team-info-btn-label">פרטי צוות</span>
                                        </button>
                                    </TeamQuickInfoPopover>
                                </div>
                                <div class="snav-project-title">@_projectCtx.ProjectTitle</div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }

        @* Dual-role mode toggle. Renders nothing for single-role users. *@
        <div class="snav-mode-row">
            <UserModeToggle />
        </div>

        <!-- ======= Main Navigation ======= -->
        <nav class="snav-section snav-section-main">
            @foreach (var item in _navMain)
            {
                <NavLink class="snav-item" href="@item.Href" Match="@item.Match">
                    @NavIcon(item)
                    <span class="snav-label">@item.Label</span>
                </NavLink>
            }
        </nav>

        <div class="snav-divider"></div>

        <!-- ======= Bottom Navigation (admin / mentor only) ======= -->
        @if (_navBottom.Any())
        {
            <nav class="snav-section snav-section-bottom">
                @foreach (var item in _navBottom)
                {
                    <NavLink class="snav-item" href="@item.Href" Match="@item.Match">
                        <span class="oi @item.Icon snav-icon" aria-hidden="true"></span>
                        <span class="snav-label">@item.Label</span>
                    </NavLink>
                }
            </nav>
            <div class="snav-divider"></div>
        }

        <!-- ======= Project context (students) ======= -->
        @*
            The rail's third level: NAVIGATION -> PROJECT CONTEXT -> USER. It
            sits here, not at the top, because it is context rather than a
            destination among the five — the same kind of thing as the profile
            row it sits on top of, and read at the same moment.

            The main nav above carries flex:1, so this and the profile stay
            anchored to the foot of the rail no matter how tall the viewport is.

            It is NOT a selector: one project exists, there is no switching, and
            nothing here suggests otherwise — no caret, no menu, no "switch"
            wording. The row navigates to מרחב הפרויקט and nothing else.

            A plain <a> rather than a NavLink, for the same mechanical reason as
            the profile row below: these rules are ordinary scoped CSS and a
            child component's root would not carry this component's scope
            attribute. The active state is tracked by hand (IsProjectRoute).
        *@
        @if (IsStudentNav && _projectCtx is not null)
        {
            <div class="snav-project-divider" role="presentation"></div>

            <div class="snav-project">
                <a href="/project"
                   class="snav-project-link @(IsProjectRoute ? "snav-project-link-active" : "")"
                   aria-current="@(IsProjectRoute ? "page" : null)">
                    @* Stacked layers — the mark for "the project as a whole",
                       drawn in the same 24x24 stroked family and weight as the
                       navigation icons above (see NavIcons). *@
                    <span class="snav-project-icon" aria-hidden="true">
                        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                             stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83Z"></path>
                            <path d="m6.08 9.5-3.5 1.6a1 1 0 0 0 0 1.81l8.6 3.91a2 2 0 0 0 1.65 0l8.58-3.9a1 1 0 0 0 0-1.83l-3.5-1.59"></path>
                            <path d="m6.08 14.5-3.5 1.6a1 1 0 0 0 0 1.81l8.6 3.91a2 2 0 0 0 1.65 0l8.58-3.9a1 1 0 0 0 0-1.83l-3.5-1.59"></path>
                        </svg>
                    </span>
                    <span class="snav-project-text">
                        <span class="snav-project-name">@_projectCtx.ProjectTitle</span>
                        <span class="snav-project-sub">מרחב הפרויקט</span>
                    </span>
                </a>
            </div>
        }

        <!-- ======= My Profile footer ======= -->
        @*
            The System Master's sidebar footer IS the Profile entry point —
            avatar + name + role, with a trailing gear, and the whole row
            filled with the ambient wash while Profile is the current page
            (Motiva Profile.dc.html:80-86; the same row appears unfilled on
            every other student screen, e.g. Dashboard V4:74-79).

            Every addition here is gated on IsStudentNav so Mentor, Lecturer
            and Admin footers render exactly as before.

            This stays a plain <a> rather than becoming a NavLink: the
            .snav-profile-link rules above are ordinary scoped CSS, and a
            child component's root element does not carry this component's
            scope attribute — swapping in NavLink silently drops every one of
            them and the footer collapses into a vertical stack. The nav items
            above get away with NavLink only because their rules are written
            with ::deep. Tracking the route by hand here is cheaper than
            re-authoring the footer's whole rule set through ::deep.
        *@
        <div class="snav-profile-footer">
            <a href="/settings"
               class="snav-profile-link @(IsProfileRoute ? "snav-profile-link-active" : "")">
                <div class="snav-profile-avatar">@GetInitials()</div>
                <div class="snav-profile-text">
                    <div class="snav-profile-name">@($"{_user?.FirstName} {_user?.LastName}".Trim())</div>
                    <div class="snav-profile-action">
                        @(IsStudentNav ? RoleService.GetRoleLabel(_user) : "הצג פרופיל")
                    </div>
                </div>
                @if (IsStudentNav)
                {
                    <span class="snav-profile-cog" aria-hidden="true">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                             stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="12" r="3"></circle>
                            <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
                        </svg>
                    </span>
                }
            </a>
            <button class="snav-logout-icon-btn" @onclick="HandleLogout" title="התנתקות" aria-label="התנתקות">
                <span class="oi oi-account-logout" aria-hidden="true"></span>
            </button>
        </div>

    </div>
</aside>

@code {
    [CascadingParameter]
    private User? _user { get; set; }

    private IReadOnlyList<NavItem> _navMain   = Array.Empty<NavItem>();
    private IReadOnlyList<NavItem> _navBottom = Array.Empty<NavItem>();
    private ProjectContextDto?     _projectCtx;

    // Gates the Motiva visual-language pass (see AppSideNav.razor.css'
    // ".snav-motiva" rules) to students only — Mentor/Staff/Admin must render
    // byte-identical to before, per the standing Student-experience scope.
    private bool IsStudentNav => RoleService.IsStudent(_user);

    /// <summary>Whether /settings is the current route, which fills the profile
    /// footer row with the ambient wash (students only — see the .snav-motiva
    /// rules). Tracked here rather than via NavLink because the footer's styles
    /// are scoped to this component and would not reach a NavLink's own root.</summary>
    /// <summary>
    /// One icon slot, two renderers. Students get the stroked 24x24 line art
    /// (NavIcons); every other role gets the open-iconic glyph the item always
    /// carried, byte-identical to before.
    ///
    /// <para>Size, stroke width and joins are set HERE, once, rather than on
    /// each path — which is what guarantees the five icons cannot drift apart
    /// in weight or scale. 1.7 is the stroke the rest of the Motiva student
    /// surface uses; 18px inside the 20px slot leaves each glyph the same
    /// optical room.</para>
    /// </summary>
    private RenderFragment NavIcon(NavItem item) => @<text>
        @if (IsStudentNav && item.IconPaths is { Count: > 0 })
        {
            <span class="snav-icon snav-icon-svg" aria-hidden="true">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                    @foreach (var d in item.IconPaths)
                    {
                        <path d="@d"></path>
                    }
                </svg>
            </span>
        }
        else
        {
            <span class="oi @item.Icon snav-icon" aria-hidden="true"></span>
        }
    </text>;

    private bool IsProfileRoute => IsRoute("settings");

    /// <summary>Whether /project (מרחב הפרויקט) is the current route. Tracked
    /// here for the same reason as <see cref="IsProfileRoute"/> — the project
    /// name is a plain anchor, not a NavLink, so nothing else knows.</summary>
    private bool IsProjectRoute => IsRoute("project");

    private bool IsRoute(string path) =>
        string.Equals(new Uri(Nav.Uri).AbsolutePath.Trim('/'), path,
                      StringComparison.OrdinalIgnoreCase);

    protected override async Task OnInitializedAsync()
    {
        _projectCtx = await _ProjectContext.GetAsync();
        UserModeService.CurrentModeChanged += OnModeChanged;
        Nav.LocationChanged += OnLocationChanged;
        // The project's display name is editable on /project. Without this the
        // rail would keep showing the pre-save title for the rest of the
        // session — the context cache has no expiry.
        _ProjectContext.Changed += OnProjectContextChanged;
    }

    private void OnProjectContextChanged(ProjectContextDto? ctx)
    {
        _projectCtx = ctx;
        InvokeAsync(StateHasChanged);
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
        => InvokeAsync(StateHasChanged);

    protected override void OnParametersSet()
    {
        (_navMain, _navBottom) = NavDefinitions.GetNavItems(_user);
    }

    private void OnModeChanged()
    {
        (_navMain, _navBottom) = NavDefinitions.GetNavItems(_user);
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        UserModeService.CurrentModeChanged -= OnModeChanged;
        Nav.LocationChanged -= OnLocationChanged;
        _ProjectContext.Changed -= OnProjectContextChanged;
    }

    private string GetInitials()
    {
        var first = _user?.FirstName?.Trim() ?? "";
        var last  = _user?.LastName?.Trim()  ?? "";
        if (first.Length == 0 && last.Length == 0) return "?";
        return (first.Length > 0 ? first[0].ToString() : "")
             + (last.Length  > 0 ? last[0].ToString()  : "");
    }

    private async Task HandleLogout()
    {
        await _Auth.Logout();
        Nav.NavigateTo(PageRoutes.Login, forceLoad: true);
    }
}
