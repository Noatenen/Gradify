@inherits LayoutComponentBase

@*
    AppLayout — shared shell for the authenticated app area.
    Renders the sidebar navigation + the page content side by side.
    Auth pages (Login, Signup, etc.) continue to use MainLayout.
*@

<div class="app-shell @(IsStudentShell ? "motiva-student" : "")">
    <AppSideNav />
    <div class="app-main">
        <AppTopBar />
        <div class="app-content">
            @Body
        </div>
    </div>
</div>

@code {
    [CascadingParameter] private User? _user { get; set; }

    // Single attachment point for the Motiva System Master foundations.
    //
    // `.motiva-student` carries the entire token rebase declared in
    // motiva-tokens.css (palette, Heebo, type scale, radii, shadows,
    // ambient gradients, shell geometry). Putting it on the shell root
    // means the sidebar AND the page content inherit it together, and
    // nothing outside this element can ever reach it — so Mentor,
    // Lecturer, Staff and Admin continue to resolve every token at its
    // :root value, unchanged.
    //
    // Gated on the same predicate AppSideNav already uses for its
    // .snav-motiva override layer, so the two can never disagree about
    // who counts as a student.
    //
    // _user cascades in asynchronously from App.razor, so this is false
    // on the very first render and flips once auth state resolves —
    // identical to the existing AppSideNav behaviour.
    private bool IsStudentShell => RoleService.IsStudent(_user);
}
