@inherits LayoutComponentBase
@using AuthWithAdmin.Client.Services

@*
    AppLayout — shared shell for the authenticated app area.
    Renders the sidebar navigation + the page content side by side.
    Auth pages (Login, Signup, etc.) continue to use MainLayout.

    The "app-shell--student" class scopes the refined Motiva design
    tokens (see gradify-theme.css) to the student experience only —
    Mentor/Staff/Admin sessions keep today's look untouched. This is
    the UI Harmonization Sprint's foundation: token-level, no layout
    change.
*@

<div class="app-shell @(RoleService.IsStudent(_user) ? "app-shell--student" : "")">
    <AppSideNav />
    <div class="app-main">
        <AppTopBar />
        <div class="app-content">
            @Body
        </div>
    </div>
</div>

@code {
    [CascadingParameter] private AuthWithAdmin.Shared.AuthSharedModels.User? _user { get; set; }
}
