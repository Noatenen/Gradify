@inherits LayoutComponentBase
@using AuthWithAdmin.Client.Services
@implements IDisposable

@*
    AppLayout — shared shell for the authenticated app area.
    Renders the sidebar navigation + the page content side by side.
    Auth pages (Login, Signup, etc.) continue to use MainLayout.
*@

@if (UsesCanvasShell)
{
    @*
        ── The finalized canvas shell — Student AND Mentor ───────────────
        Both finished experiences draw the same chrome: a washed canvas
        with a top bar (logo · centred pill nav · round action cluster)
        and no rail. Every `… final.dc.html` student screen and every
        `Motiva Mentor *.dc.html` screen puts exactly this at the top, so
        one branch serves both and MotivaTopNav renders each role's own
        destinations from NavDefinitions.

        The reference draws its screens inside a centred, rounded canvas
        card floating on a darker page. That frame is deliberately NOT
        reproduced: the workspace uses the full viewport, and the canvas's
        soft wash becomes the page's own background instead. This is the
        one intentional deviation from the design files.

        What that means concretely — no max-width, no outer radius, no
        outer shadow, and no second background ringing the app. The
        chrome and the content sit directly on one washed surface.

        Kept as a separate branch rather than a variant of the sidebar
        shell below, because the two have no markup in common — one is a
        two-column flex with a rail, the other a single column. Branching
        here means Lecturer / Staff / Admin render the exact tree they
        always have.

        The class stays `app-shell-student`: it is the selector ~60 lines
        of AppLayout.razor.css hang off, and renaming it would be a
        no-op diff across a stylesheet this epic has no other reason to
        touch. Read it as "the canvas shell".
    *@
    <div class="app-shell app-shell-student @ShellClasses">
        <MotivaTopNav />
        <div class="app-content">
            @Body
        </div>
    </div>
}
else if (IsLecturer)
{
    <div class="app-shell app-shell-student @ShellClasses">
        <LecturerTopNav />
        <div class="app-content">
            @Body
        </div>
    </div>
}
else
{
    <div class="app-shell @ShellClasses">
        <AppSideNav />
        <div class="app-main">
            <AppTopBar />
            <div class="app-content">
                @Body
            </div>
        </div>
    </div>
}

@code {
    [CascadingParameter] private User? _user { get; set; }

    // Single attachment point for the Motiva System Master foundations.
    //
    // `.motiva` carries the entire token rebase declared in motiva-tokens.css
    // (palette, Heebo, type scale, radii, shadows, ambient gradients, shell
    // geometry). Putting it on the shell root means the sidebar AND the page
    // content inherit it together, and nothing outside this element can ever
    // reach it — so Lecturer, Staff and Admin continue to resolve every token
    // at its :root value, unchanged.
    //
    // TWO CLASSES, NOT ONE (Epic 0)
    // ─────────────────────────────
    // `.motiva`          the shared visual system. Every token, every
    //                    component override, every ambient gradient reads
    //                    this and only this. There is nothing in it that
    //                    means one thing for a student and another for a
    //                    mentor, which is exactly why it carries no role.
    //
    // `.motiva-student`  / `.motiva-mentor` — role hooks, for the places
    //                    where behaviour or UX genuinely differs. Nothing in
    //                    the foundations layer uses them today; they exist so
    //                    that when a genuine divergence appears it has an
    //                    obvious, scoped home instead of being expressed as a
    //                    second copy of the design system.
    //
    // The student experience is the regression baseline: it still carries
    // `.motiva-student`, and `.motiva` has identical specificity to the class
    // it replaced, declared in the same place in the same files — so every
    // computed value on every student page is what it was before.
    //
    // _user cascades in asynchronously from App.razor, so this resolves to
    // Staff on the very first render and settles once auth state arrives —
    // identical to the existing AppSideNav behaviour.
    //
    // Gated on NavDefinitions.GetShell, the same method AppSideNav uses for
    // its .snav-motiva rail and AppTopBar for its bell placement, so the
    // three can never disagree about who gets which shell — including the
    // dual-role (Staff + Mentor) case, where the active view mode decides.
    /// <summary>Which of the two shells renders. Reads the same
    /// NavDefinitions.GetShell as ShellClasses below, so the frame and the
    /// token scope can never disagree — including for a dual-role user, whose
    /// active mode decides.
    ///
    /// <para>Student and Mentor both resolve to the canvas shell: their
    /// finished designs draw identical chrome. Staff (Lecturer / Admin) keeps
    /// the rail.</para></summary>
    private bool UsesCanvasShell => NavDefinitions.GetShell(_user)
        is NavDefinitions.Shell.Student or NavDefinitions.Shell.Mentor;

    private bool IsLecturer => NavDefinitions.GetShell(_user)
        is NavDefinitions.Shell.Lecturer;

    /// <summary>
    /// THREE classes on the finished shells, not two.
    ///
    /// <para><c>motiva</c> — the shared visual system, as before.</para>
    ///
    /// <para><c>motiva-final</c> — the FINISHED design's values: the palette,
    /// geometry and component treatments transcribed from the Claude Design
    /// project. It carries no role because nothing in it is role-specific —
    /// the mentor screens and the student screens draw the same canvas, the
    /// same pills, the same 38px controls. Both finished experiences wear it;
    /// Lecturer / Staff / Admin do not, which is what keeps them on the legacy
    /// look. (It was named <c>motiva-student</c> until Mentor's designs landed
    /// with the same values — see the block it scopes in motiva-tokens.css.)</para>
    ///
    /// <para><c>motiva-student</c> / <c>motiva-mentor</c> — the role hooks,
    /// unchanged in meaning: the place a genuine role divergence goes.</para>
    /// </summary>
    private string ShellClasses => NavDefinitions.GetShell(_user) switch
    {
        NavDefinitions.Shell.Student  => "motiva motiva-final motiva-student",
        NavDefinitions.Shell.Mentor   => "motiva motiva-final motiva-mentor",
        NavDefinitions.Shell.Lecturer => "motiva motiva-lecturer",
        _                             => "",
    };

    // A dual-role user flipping the mode toggle changes which shell they are
    // in, not just which nav items they see. Without this the token scope
    // would keep whatever it resolved to at first render until a full reload.
    // AppSideNav already subscribes for the same reason.
    protected override void OnInitialized()
        => UserModeService.CurrentModeChanged += OnModeChanged;

    private void OnModeChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
        => UserModeService.CurrentModeChanged -= OnModeChanged;
}
