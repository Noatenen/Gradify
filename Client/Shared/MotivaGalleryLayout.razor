@using Microsoft.AspNetCore.Components.WebAssembly.Hosting
@using AuthWithAdmin.Client.Components.MotivaGallery
@inherits LayoutComponentBase
@inject IWebAssemblyHostEnvironment HostEnvironment

@*
    MotivaGalleryLayout — internal shell for the Motiva design-system gallery
    (Phase 4). Not part of the production app shell (AppLayout/BlankLayout
    are untouched). Gated to the Development environment using the standard
    hosted-Blazor-WebAssembly environment API.

    IMPORTANT LIMITATION (documented in full in design/design-system/GALLERY.md):
    this check only hides the gallery's UI when the host environment reports
    "Development". Blazor WebAssembly ships all compiled client code to every
    browser regardless of environment — this is a visibility gate, not a
    security boundary. No backend/build changes were made to enforce this
    further, per the Phase 4 scope.
*@

@if (HostEnvironment.IsDevelopment())
{
    <div class="motiva-gallery-shell">
        <GallerySidebar />
        <div class="motiva-gallery-main">
            <div class="motiva-gallery-content">
                @Body
            </div>
        </div>
    </div>
}
else
{
    <div class="motiva-gallery-blocked">
        <div class="motiva-gallery-blocked-card">
            <h1>Motiva Gallery — Development only</h1>
            <p>
                This internal component gallery is only available when the application
                is running in the Development environment. It is not part of the
                production Gradify experience.
            </p>
        </div>
    </div>
}
