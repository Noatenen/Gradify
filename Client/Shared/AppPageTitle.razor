@implements IDisposable
@inject NavigationManager Nav

@*
    AppPageTitle — the app's ONLY browser-title renderer.

    Rendered once from App.razor, above the Router, so every route in every
    layout gets "Motiva | Page Name" without a <PageTitle> per page. The name
    comes from PageTitles.Resolve, which is the map to edit when a page is
    added or renamed.

    Because it renders before the routed component, a page that genuinely
    needs its own <PageTitle> still wins: HeadOutlet takes the last title
    registered, and reverts to this one when that page is disposed.

    Browser metadata only — this component renders nothing into the page,
    so the Hebrew/RTL UI is untouched.
*@

<PageTitle>@PageTitles.Resolve(Nav.ToBaseRelativePath(Nav.Uri))</PageTitle>

@code {
    protected override void OnInitialized()
        => Nav.LocationChanged += OnLocationChanged;

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
        => InvokeAsync(StateHasChanged);

    public void Dispose()
        => Nav.LocationChanged -= OnLocationChanged;
}
