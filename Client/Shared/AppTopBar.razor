@using AuthWithAdmin.Shared.AuthSharedModels
@inject NavigationManager Nav
@implements IDisposable

@* ─────────────────────────────────────────────────────────────
   AppTopBar — shell-level bar sitting above every page.
   RTL: greeting appears on the RIGHT (reading start),
        icons appear on the LEFT (reading end).
   ───────────────────────────────────────────────────────────── *@

<div class="atb-bar @(IsDashboardMerge ? "atb-dash-merge" : "")">

    <!-- RIGHT (RTL start): greeting -->
    <div class="atb-start">
        <span class="atb-greeting">שלום, @(_user?.FirstName ?? "")</span>
    </div>

    <!-- LEFT (RTL end): notification + calendar quick-access -->
    <div class="atb-end">
        <NotificationBell />
        <button class="atb-icon-btn"
                @onclick="@(() => Nav.NavigateTo("/milestones"))"
                title="לוח זמנים">
            <span class="oi oi-calendar" aria-label="לוח זמנים"></span>
        </button>
    </div>

</div>

@code {
    [CascadingParameter] private User? _user { get; set; }

    // Dashboard-merge treatment (see .atb-dash-merge in AppTopBar.razor.css)
    // only applies for students, only on /dashboard — every other student
    // route keeps the plain standalone bar; Mentor/Staff/Admin are never
    // affected. AppTopBar is a persistent shell component that doesn't
    // remount on navigation, so route changes are tracked explicitly via
    // NavigationManager.LocationChanged rather than relying on parameters.
    private bool IsDashboardMerge => RoleService.IsStudent(_user) && IsDashboardRoute(Nav.Uri);

    private static bool IsDashboardRoute(string uri) =>
        new Uri(uri).AbsolutePath.Trim('/').Equals("dashboard", StringComparison.OrdinalIgnoreCase);

    protected override void OnInitialized()
    {
        Nav.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
        => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
    }
}
