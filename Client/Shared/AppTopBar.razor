@using AuthWithAdmin.Shared.AuthSharedModels
@inject NavigationManager Nav
@implements IDisposable

@* ─────────────────────────────────────────────────────────────
   AppTopBar — shell-level bar sitting above every page.
   RTL: greeting appears on the RIGHT (reading start),
        icons appear on the LEFT (reading end).
   ───────────────────────────────────────────────────────────── *@

<div class="atb-bar @(UsesAmbientMerge ? "atb-dash-merge" : "")">

    <!-- RIGHT (RTL start): greeting, or the Tasks page's own title+subtitle -->
    <div class="atb-start">
        @if (IsTasksRoute)
        {
            <div class="atb-tasks-heading">
                <h1 class="atb-tasks-title">המשימות שלי</h1>
                <p class="atb-tasks-subtitle">כל המשימות, ההגשות והעדכונים במקום אחד</p>
            </div>
        }
        else
        {
            <span class="atb-greeting">שלום, @(_user?.FirstName ?? "")</span>
        }
    </div>

    <!-- LEFT (RTL end): notification + calendar quick-access -->
    <div class="atb-end">
        @*
            Students now get the bell in the sidebar header, where the
            System Master puts it (see AppSideNav.razor). It stays here
            for Mentor / Lecturer / Staff / Admin, whose shell is
            unchanged. Rendering it in both places at once would mount
            two instances, each polling the unread count independently.
        *@
        @if (ShowNotificationBell)
        {
            <NotificationBell />
        }
        <button class="atb-icon-btn"
                @onclick="@(() => Nav.NavigateTo("/milestones"))"
                title="לוח זמנים">
            <span class="oi oi-calendar" aria-label="לוח זמנים"></span>
        </button>
    </div>

</div>

@code {
    [CascadingParameter] private User? _user { get; set; }

    // Ambient-merge treatment (see .atb-dash-merge in AppTopBar.razor.css)
    // only applies for students on /dashboard, where StudentDashboardHero
    // sits directly under this bar and the merged gradient reads as one
    // continuous surface. /tasks deliberately does NOT get this anymore —
    // the tasks workspace (board-style, dense with cards) wants a plain,
    // quiet header with no ambient area competing for attention; only the
    // route-gated title/subtitle swap below still applies there. AppTopBar
    // is a persistent shell component that doesn't remount on navigation,
    // so route changes are tracked explicitly via NavigationManager.LocationChanged
    // rather than relying on parameters.
    private bool UsesAmbientMerge => RoleService.IsStudent(_user) && IsDashboardRoute(Nav.Uri);

    // The bell moved into the sidebar header for students in Phase 2 of the
    // System Master migration; it remains here for every other role.
    //
    // The rest of this bar is deliberately UNCHANGED for students, even
    // though the Master has no top bar at all:
    //   * .atb-dash-merge  — StudentDashboardHero squares its top corners
    //     unconditionally on the assumption this bar sits above it, so
    //     dropping the merge now would leave cut corners and no bar.
    //   * the Tasks title/subtitle swap — /tasks has no in-page title;
    //     removing it would strip the page's heading outright.
    //   * the calendar button — currently the only student route to
    //     /milestones (there is no student nav entry for it); removing it
    //     is a navigation-IA decision, not a shell one.
    // All three are retired in Phase 4, once pages own real headers.
    private bool ShowNotificationBell => !RoleService.IsStudent(_user);

    // Tasks page owns its own title/subtitle (matches the dashboard's own
    // top-header language) — the generic greeting would be redundant right
    // above it, so it's swapped out here rather than duplicated in-page.
    // Gated the same way as UsesAmbientMerge: student-only, this route only,
    // so every other role/route renders byte-identical to before.
    private bool IsTasksRoute => RoleService.IsStudent(_user) && IsTasksPath(Nav.Uri);

    private static bool IsDashboardRoute(string uri) =>
        new Uri(uri).AbsolutePath.Trim('/').Equals("dashboard", StringComparison.OrdinalIgnoreCase);

    private static bool IsTasksPath(string uri) =>
        new Uri(uri).AbsolutePath.Trim('/').Equals("tasks", StringComparison.OrdinalIgnoreCase);

    protected override void OnInitialized()
    {
        Nav.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
        => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
    }
}
