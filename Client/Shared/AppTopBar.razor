@using AuthWithAdmin.Shared.AuthSharedModels
@inject NavigationManager Nav
@implements IDisposable

@* ─────────────────────────────────────────────────────────────
   AppTopBar — shell-level bar sitting above every page.
   RTL: greeting appears on the RIGHT (reading start),
        icons appear on the LEFT (reading end).
   ───────────────────────────────────────────────────────────── *@

@if (!IsHidden)
{
    <div class="atb-bar">

        <!-- RIGHT (RTL start): greeting -->
        <div class="atb-start">
            <span class="atb-greeting">שלום, @(_user?.FirstName ?? "")</span>
        </div>

        <!-- LEFT (RTL end): notification + calendar quick-access -->
        <div class="atb-end">
            @*
                Students now get the bell in the sidebar header, where the
                System Master puts it (see AppSideNav.razor). It stays here
                for Mentor / Lecturer / Staff / Admin, whose shell is
                unchanged. Rendering it in both places at once would mount
                two instances, each polling the unread count independently.
            *@
            @if (ShowNotificationBell)
            {
                <NotificationBell />
            }
            <button class="atb-icon-btn"
                    @onclick="@(() => Nav.NavigateTo("/milestones"))"
                    title="לוח זמנים">
                <span class="oi oi-calendar" aria-label="לוח זמנים"></span>
            </button>
        </div>

    </div>
}

@code {
    [CascadingParameter] private User? _user { get; set; }

    // AppTopBar is a persistent shell component that doesn't remount on
    // navigation, so route changes are tracked explicitly via
    // NavigationManager.LocationChanged rather than relying on parameters.

    // The bell moved into the sidebar header for students in Phase 2 of the
    // System Master migration; it remains here for every other role.
    //
    // The calendar button stays here for every role. It used to be the only
    // student route to /milestones; students now reach that page from the
    // "יומן ותכנון" nav item in NavDefinitions._studentMain instead, which is
    // why hiding this bar on the student routes below costs them nothing.
    // Nothing about the button or the /milestones route itself changed.
    private bool ShowNotificationBell => !RoleService.IsStudent(_user);

    // The bar renders NOTHING on the student Dashboard, Tasks, Requests,
    // Knowledge Center and Planning routes.
    //
    // Everything it used to contribute there is now owned elsewhere: the
    // page title moved into the page's own MPageHeader (Phase 4A/4B), the
    // notification bell moved into the sidebar (Phase 2), and the greeting
    // was already suppressed so it would not compete with the page title.
    // That left a bar whose only visible control was the calendar
    // shortcut, which neither finalized design includes — so the whole bar
    // goes rather than an empty strip taking vertical space between the
    // shell edge and the Hero.
    //
    // Requests joined the list in Phase 4B for exactly the same reason:
    // its finalized screen opens on the ambient hero, whose h1 is a state
    // summary ("יש לך תגובות חדשות…"). A greeting strip above that is a
    // second, competing salutation.
    //
    // Knowledge Center joined in Phase 4C: same compact ambient hero as
    // Tasks, and the finalized Motiva Resources screen likewise opens
    // straight onto it. No layout compensation is needed when the bar
    // disappears — MPageHeader's compact band carries its own 38px top
    // padding, so the hero's title lands the same distance below the shell
    // edge that it does on /tasks.
    //
    // Dashboard joined in Phase 4D. Motiva Student Dashboard V4 has no top
    // bar at all: its ambient hero band opens the page and owns the greeting
    // ("בוקר טוב, נועה", V4 line 89), which is now rendered by the page's own
    // MPageHeader Hero. Leaving the bar would put a second, competing
    // greeting directly above the first. The bar's ambient-merge treatment
    // existed only to blend into that hero and is retired with it.
    //
    // Planning ("יומן ותכנון", /milestones) joined last, for the same reason
    // as Tasks and Knowledge Center: StudentPlanningPage opens straight onto
    // an MPageHeader/Compact ambient hero whose title IS the page title, and
    // its subtitle carries the current-milestone context. The greeting strip
    // above it was a competing header, and the strip's only control — the
    // calendar shortcut — pointed at /milestones itself, i.e. at the page the
    // student was already on. As on /tasks and /learning, no layout
    // compensation is needed: MPageHeader/Compact brings its own 38px top
    // padding, so the hero title keeps the same distance from the shell edge.
    //
    // Route- and role-scoped:
    //   * every other student route keeps the bar unchanged, greeting and
    //     calendar button included;
    //   * Mentor / Lecturer / Staff / Admin keep it on every route,
    //     /dashboard, /tasks, /requests, /learning and /milestones included.
    private static readonly string[] BarlessStudentRoutes = { "dashboard", "tasks", "requests", "learning", "milestones" };

    private bool IsHidden => RoleService.IsStudent(_user) && IsBarlessRoute(Nav.Uri);

    private static bool IsBarlessRoute(string uri) =>
        BarlessStudentRoutes.Contains(
            new Uri(uri).AbsolutePath.Trim('/'), StringComparer.OrdinalIgnoreCase);

    protected override void OnInitialized()
    {
        Nav.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
        => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
    }
}
