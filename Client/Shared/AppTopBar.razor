@using AuthWithAdmin.Client.Services
@using AuthWithAdmin.Shared.AuthSharedModels
@inject NavigationManager Nav
@implements IDisposable

@* ─────────────────────────────────────────────────────────────
   AppTopBar — shell-level bar sitting above every page.
   RTL: start content appears on the RIGHT (reading start),
        icons appear on the LEFT (reading end).

   Students get a calm, functional page-context label instead of a
   repeated greeting — the emotional "hello" belongs to the Dashboard
   Hero alone. Mentor/Staff/Admin keep the original greeting header
   unchanged (out of scope for this redesign).
   ───────────────────────────────────────────────────────────── *@

<div class="atb-bar">

    <!-- RIGHT (RTL start) -->
    <div class="atb-start">
        @if (RoleService.IsStudent(_user))
        {
            <span class="atb-page-title">@_pageTitle</span>
        }
        else
        {
            <span class="atb-greeting">שלום, @(_user?.FirstName ?? "")</span>
            @if (_user is not null)
            {
                <span class="atb-role-badge">@RoleService.GetRoleLabel(_user)</span>
            }
        }
    </div>

    <!-- LEFT (RTL end): notification + calendar quick-access -->
    <div class="atb-end">
        <NotificationBell />
        <button class="atb-icon-btn"
                @onclick="@(() => Nav.NavigateTo("/milestones"))"
                title="לוח זמנים">
            <span class="oi oi-calendar" aria-label="לוח זמנים"></span>
        </button>
    </div>

</div>

@code {
    [CascadingParameter] private User? _user { get; set; }

    private string _pageTitle = "";

    protected override void OnInitialized()
    {
        UpdatePageTitle();
        Nav.LocationChanged += OnLocationChanged;
    }

    protected override void OnParametersSet() => UpdatePageTitle();

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        UpdatePageTitle();
        InvokeAsync(StateHasChanged);
    }

    private void UpdatePageTitle()
    {
        var relative = Nav.ToBaseRelativePath(Nav.Uri);
        _pageTitle = NavDefinitions.GetPageTitle(_user, relative);
    }

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;
}
