@using AuthWithAdmin.Client.Services
@using AuthWithAdmin.Shared.AuthSharedModels
@inject INotificationService NotificationService
@inject NavigationManager Nav

<div class="nbell-wrap" dir="rtl">

    @if (_isOpen)
    {
        <!-- Invisible backdrop — closes the panel when clicking outside -->
        <div class="nbell-backdrop" @onclick="Close"></div>

        <div class="nbell-panel">

            <!-- Panel header -->
            <div class="nbell-panel-header">
                <span class="nbell-panel-title">התראות</span>
                @if (_notifications.Any(n => !n.IsRead))
                {
                    <button class="nbell-mark-all-btn" @onclick="MarkAllRead">
                        סמן הכל כנקרא
                    </button>
                }
            </div>

            <!-- Panel body -->
            @if (_loading)
            {
                <div class="nbell-loading">
                    <div class="nbell-spinner"></div>
                    <span>טוען…</span>
                </div>
            }
            else if (!_notifications.Any())
            {
                <div class="nbell-empty">
                    <span class="oi oi-bell nbell-empty-icon" aria-hidden="true"></span>
                    <span>אין התראות חדשות</span>
                </div>
            }
            else
            {
                <div class="nbell-list">
                    @foreach (var n in _notifications)
                    {
                        <div class="nbell-item @(n.IsRead ? "nbell-item-read" : "nbell-item-unread")"
                             @onclick="() => HandleClick(n)"
                             title="@n.Message">
                            <div class="nbell-item-icon nbell-icon-@NotificationIconClass(n.Type)">
                                <span class="oi @NotificationIcon(n.Type)" aria-hidden="true"></span>
                            </div>
                            <div class="nbell-item-body">
                                <div class="nbell-item-title">@n.Title</div>
                                <div class="nbell-item-msg">@n.Message</div>
                                <div class="nbell-item-time">@FormatTime(n.CreatedAt)</div>
                            </div>
                            @if (!n.IsRead)
                            {
                                <span class="nbell-unread-dot"></span>
                            }
                        </div>
                    }
                </div>
            }

        </div>
    }

    <!-- Bell trigger button -->
    <button class="nbell-btn @(_isOpen ? "nbell-btn-active" : "")"
            @onclick="TogglePanel"
            title="התראות"
            aria-label="התראות">
        @if (Icon == BellIcon.Stroked)
        {
            @* The final student design draws every icon as stroked line art;
               the open-iconic glyph below is what every other shell has
               always rendered and stays the default. *@
            <svg class="nbell-glyph" width="16" height="16" viewBox="0 0 24 24" fill="none"
                 stroke="currentColor" stroke-width="1.8" stroke-linecap="round"
                 stroke-linejoin="round" aria-hidden="true">
                <path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9"></path>
                <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
            </svg>
        }
        else
        {
            <span class="oi oi-bell" aria-hidden="true"></span>
        }
        @if (_unreadCount > 0)
        {
            <span class="nbell-badge" aria-label="@($"{_unreadCount} התראות שלא נקראו")">
                @(_unreadCount > 99 ? "99+" : _unreadCount.ToString())
            </span>
        }
    </button>

</div>

@code {
    /// <summary>Which glyph the trigger renders. The default is the
    /// open-iconic bell every shell has always shown; Stroked is the line-art
    /// bell the finalized student chrome uses. Appearance only — the panel,
    /// the polling and the routing are identical either way.</summary>
    public enum BellIcon { Glyph, Stroked }

    [Parameter] public BellIcon Icon { get; set; } = BellIcon.Glyph;

    [CascadingParameter] private User? _user { get; set; }

    private bool                    _isOpen      = false;
    private int                     _unreadCount = 0;
    private List<NotificationDto>   _notifications = new();
    private bool                    _loading     = false;

    protected override async Task OnInitializedAsync()
    {
        _unreadCount = await NotificationService.GetUnreadCountAsync();
    }

    private async Task TogglePanel()
    {
        _isOpen = !_isOpen;
        if (_isOpen)
            await LoadAsync();
    }

    private void Close() => _isOpen = false;

    private async Task LoadAsync()
    {
        _loading = true;
        _notifications = await NotificationService.GetRecentAsync();
        _unreadCount   = _notifications.Count(n => !n.IsRead);
        _loading = false;
    }

    private async Task HandleClick(NotificationDto n)
    {
        // Mark as read regardless of current state
        if (!n.IsRead)
        {
            await NotificationService.MarkReadAsync(n.Id);
            n.IsRead = true;
            n.ReadAt = DateTime.Now;
            _unreadCount = _notifications.Count(x => !x.IsRead);
        }

        // Close the panel and navigate to the relevant destination
        _isOpen = false;
        string? url = GetTargetUrl(n);
        if (!string.IsNullOrEmpty(url))
            Nav.NavigateTo(url);
    }

    /// <summary>
    /// Maps a notification to a client-side route. Routing is role-aware so a
    /// staff member's "request created" notification opens the management
    /// review page for that request, not the student's "my requests" list.
    /// When the request id is known we append it as a query parameter so the
    /// destination page can auto-open the drawer; pages that don't recognise
    /// the parameter just ignore it.
    /// </summary>
    private string? GetTargetUrl(NotificationDto n)
    {
        // The daily digest is a summary of the whole queue, so it opens the
        // queue. A notification type with no arm here renders with a generic
        // icon and navigates nowhere.
        if (n.Type == NotificationTypes.MentorDailyDigest) return "mentor/tasks";

        // ── Requests (RelatedEntityId = ProjectRequest.Id) ──
        // Every request type carries the request id, so all three role surfaces
        // can deep-link straight to the request and open its detail pane.
        bool isRequest =
            n.RelatedEntityType == "ProjectRequest"
            || n.Type == "RequestReturned"
            || n.Type == NotificationTypes.RequestCreated
            || n.Type == NotificationTypes.RequestStatusChanged
            || n.Type == NotificationTypes.RequestCommentAdded;
        if (isRequest) return BuildRequestUrl(n.RelatedEntityId);

        // ── Submissions (RelatedEntityType = TaskSubmission) ──
        // The server writes the TASK id as RelatedEntityId for every submission
        // notification (TaskSubmissionsController), because each role's review
        // surface can resolve the submission from its task.
        //
        //   "SubmissionReceived" / "SubmissionReturned"  legacy rows.
        //   SubmissionSubmitted        a new submission for a mentor / staff.
        //   SubmissionFeedbackReceived feedback for the student who submitted.
        bool isSubmission =
            n.RelatedEntityType == "TaskSubmission"
            || n.Type == "SubmissionReceived"
            || n.Type == "SubmissionReturned"
            || n.Type == NotificationTypes.SubmissionSubmitted
            || n.Type == NotificationTypes.SubmissionFeedbackReceived;
        if (isSubmission) return BuildSubmissionUrl(n.RelatedEntityId);

        // ── Tasks (RelatedEntityId = TaskId) ──
        // Defensive: these types are defined but not emitted by the server today.
        // Routed anyway so they deep-link correctly the moment they are.
        if (n.Type == NotificationTypes.TaskAssigned
            || n.Type == NotificationTypes.TaskDueSoon
            || n.Type == NotificationTypes.TaskOverdue)
            return BuildTaskUrl(n.RelatedEntityId);

        return null;
    }

    private string BuildRequestUrl(int? requestId)
    {
        // Choose the right list page per role. Admin/Staff and Mentor get the
        // review surfaces; Student keeps "הבקשות שלי". Each page reads
        // ?requestId= and opens the request in its own detail pane. When the id
        // is missing we still take the user to the right list.
        string basePath =
            RoleService.IsAdminOrStaff(_user) ? "management/requests"
            : RoleService.IsMentor(_user)     ? "mentor-requests"
            :                                    "requests";

        return requestId.HasValue
            ? $"{basePath}?requestId={requestId.Value}"
            : basePath;
    }

    private string BuildSubmissionUrl(int? taskId)
    {
        // RelatedEntityId is the TASK id. Each role opens its own review surface
        // and resolves/opens the submission from that task.
        if (RoleService.IsMentor(_user))
            // The mentor review queue's "הגשות לבדיקה" tab.
            return "mentor/tasks?focus=reviews";

        if (RoleService.IsAdminOrStaff(_user))
            // The lecturer/staff review workspace resolves the submission from
            // the task id and opens it in its left detail pane.
            return taskId.HasValue
                ? $"lecturer/submissions?taskId={taskId.Value}"
                : "lecturer/submissions";

        // Student — their own submission is a task on /tasks, which opens the
        // task detail (TaskDetailModal) from ?taskId=.
        return taskId.HasValue ? $"tasks?taskId={taskId.Value}" : "tasks";
    }

    private string BuildTaskUrl(int? taskId)
    {
        // Role-aware task destination. Only the student tasks page reads a
        // ?taskId= deep link today; the others land on their task surface.
        if (RoleService.IsMentor(_user))       return "mentor/tasks";
        if (RoleService.IsAdminOrStaff(_user)) return "lecturer/tasks";
        return taskId.HasValue ? $"tasks?taskId={taskId.Value}" : "tasks";
    }

    private async Task MarkAllRead()
    {
        bool ok = await NotificationService.MarkAllReadAsync();
        if (ok)
        {
            foreach (var n in _notifications)
            {
                n.IsRead = true;
                n.ReadAt = DateTime.Now;
            }
            _unreadCount = 0;
        }
    }

    private static string NotificationIconClass(string type) => type switch
    {
        "SubmissionReceived"                     => "received",
        NotificationTypes.SubmissionSubmitted    => "received",
        "SubmissionReturned"                     => "returned",
        "RequestReturned"                        => "returned",
        _                                        => "general",
    };

    private static string NotificationIcon(string type) => type switch
    {
        "SubmissionReceived"                     => "oi-data-transfer-upload",
        NotificationTypes.SubmissionSubmitted    => "oi-data-transfer-upload",
        "SubmissionReturned"                     => "oi-arrow-circle-left",
        "RequestReturned"                        => "oi-loop-circular",
        NotificationTypes.MentorDailyDigest      => "oi-inbox",
        _                                        => "oi-bell",
    };

    private static string FormatTime(DateTime dt)
    {
        // Notification CreatedAt comes from the server as UTC (Kind=Unspecified).
        // Compare against UtcNow so the "X minutes ago" math doesn't get
        // skewed by the local-timezone offset.
        var utc  = dt.Kind == DateTimeKind.Utc ? dt : DateTime.SpecifyKind(dt, DateTimeKind.Utc);
        var diff = DateTime.UtcNow - utc;
        if (diff.TotalMinutes < 1) return "הרגע";
        if (diff.TotalMinutes < 60) return $"לפני {(int)diff.TotalMinutes} דקות";
        if (diff.TotalHours   < 24) return $"לפני {(int)diff.TotalHours} שעות";
        if (diff.TotalDays    < 7)  return $"לפני {(int)diff.TotalDays} ימים";
        return dt.IsraelFormat("dd/MM/yy");
    }
}
