@using AuthWithAdmin.Client.Services
@using AuthWithAdmin.Client.Models
@using AuthWithAdmin.Shared.AuthSharedModels
@inject IAuthenticationService _Auth
@inject IDashboardOverviewService _Dashboard
@inject NavigationManager Nav
@implements IDisposable

@*
    ── LecturerTopNav ───────────────────────────────────────────────────────
    The chrome of the finalized Lecturer experience: Motiva logo, one centred
    pill nav (7 items), and a cluster of round icon buttons.

    Mirrors StudentTopNav structurally — same pill track, same badge slot,
    same action cluster, same responsive breakpoint — but differs in:
      • nav items driven by the Lecturer list in NavDefinitions._adminMain
      • badge on "בקשות" (management/requests) showing OpenRequests count
        loaded via IDashboardOverviewService.GetAsync("lecturer")
      • calendar shortcut links to /milestones-overview (not /milestones)
      • avatar routes to /settings, same as the student shell

    Source: design/design-system/MotivaLecturerDesign/Motiva Lecturer Home.dc (1).html
*@

<header class="ltn-bar">

    <a class="ltn-logo" href="/dashboard/lecturer" aria-label="Motiva — לדף הבית">
        <img src="/images/motiva-logo.png" alt="Motiva" class="ltn-logo-img" />
    </a>

    <nav class="ltn-nav" aria-label="ניווט ראשי">
        @foreach (var item in _navMain)
        {
            <NavLink class="ltn-nav-item"
                     ActiveClass="ltn-nav-item-active"
                     href="@item.Href"
                     Match="@item.Match">
                <span class="ltn-nav-label">@item.Label</span>
                @if (item.Href == "management/requests" && _openRequests > 0)
                {
                    <span class="ltn-nav-count" aria-label="@($"{_openRequests} בקשות ממתינות לטיפולך")">
                        @_openRequests
                    </span>
                }
            </NavLink>
        }
    </nav>

    <div class="ltn-actions">

        <a class="ltn-icon-btn" href="/milestones-overview" title="יומן מועדים" aria-label="יומן מועדים">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="3" y="4" width="18" height="18" rx="3"></rect>
                <path d="M16 2v4M8 2v4M3 10h18"></path>
            </svg>
        </a>

        <NotificationBell Icon="NotificationBell.BellIcon.Stroked" />

        <a class="ltn-avatar @(IsProfileRoute ? "ltn-avatar-active" : "")"
           href="/settings"
           title="הפרופיל שלי"
           aria-label="הפרופיל שלי">
            @GetInitials()
        </a>

        <button type="button"
                class="ltn-icon-btn ltn-logout"
                @onclick="HandleLogout"
                title="התנתקות"
                aria-label="התנתקות">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M9 21H6a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h3"></path>
                <path d="M16 17l5-5-5-5M21 12H9"></path>
            </svg>
        </button>
    </div>
</header>

@code {
    [CascadingParameter] private User? _user { get; set; }

    private IReadOnlyList<NavItem> _navMain = Array.Empty<NavItem>();
    private int _openRequests;
    private bool _countLoaded;

    private bool IsProfileRoute =>
        new Uri(Nav.Uri).AbsolutePath.Trim('/').Equals("settings", StringComparison.OrdinalIgnoreCase);

    protected override void OnInitialized()
    {
        Nav.LocationChanged += OnLocationChanged;
        UserModeService.CurrentModeChanged += OnModeChanged;
    }

    protected override async Task OnParametersSetAsync()
    {
        (_navMain, _) = NavDefinitions.GetNavItems(_user);

        if (_user is not null && !_countLoaded)
        {
            _countLoaded = true;
            await RefreshRequestCountAsync();
        }
    }

    private async Task RefreshRequestCountAsync()
    {
        var data = await _Dashboard.GetAsync("lecturer");
        if (data is null) return;
        _openRequests = data.Summary.OpenRequests;
        StateHasChanged();
    }

    // Refresh badge when navigating away from the requests page, because
    // a lecturer acting on a request there reduces the pending count.
    private string _lastPath = "";

    private async void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        var path = new Uri(Nav.Uri).AbsolutePath.Trim('/');
        bool leftRequests = _lastPath.StartsWith("management/requests", StringComparison.OrdinalIgnoreCase)
                            && !path.StartsWith("management/requests", StringComparison.OrdinalIgnoreCase);
        _lastPath = path;

        await InvokeAsync(StateHasChanged);
        if (leftRequests) await InvokeAsync(RefreshRequestCountAsync);
    }

    private async void OnModeChanged()
    {
        (_navMain, _) = NavDefinitions.GetNavItems(_user);
        await InvokeAsync(StateHasChanged);
    }

    private string GetInitials()
    {
        var first = _user?.FirstName?.Trim() ?? "";
        var last  = _user?.LastName?.Trim()  ?? "";
        var a = first.Length > 0 ? first[..1] : "";
        var b = last.Length  > 0 ? last[..1]  : "";
        return (a + b) is { Length: > 0 } s ? s : "?";
    }

    private async Task HandleLogout()
    {
        await _Auth.Logout();
        Nav.NavigateTo(PageRoutes.Login, forceLoad: true);
    }

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
        UserModeService.CurrentModeChanged -= OnModeChanged;
    }
}
