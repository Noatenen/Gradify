@using AuthWithAdmin.Client.Services
@using AuthWithAdmin.Client.Models
@using AuthWithAdmin.Shared.AuthSharedModels
@using AuthWithAdmin.Client.Pages.Requests
@inject IAuthenticationService _Auth
@inject IProjectRequestsService _Requests
@inject IMentorAttentionService _Attention
@inject IDashboardOverviewService _Overview
@inject IPendingMentorApprovalsService _PendingApprovals
@inject ITaskSubmissionsService _SubmissionsService
@inject NavigationManager Nav
@implements IDisposable

@*
    ── MotivaTopNav ─────────────────────────────────────────────────────────
    The chrome of ALL THREE finished experiences: logo, one centred pill nav,
    and a cluster of round icon buttons. It replaces the 248px sidebar for
    Student, Mentor and Lecturer — AppSideNav is untouched and still serves
    Shell.Staff, the legacy fallback.

    LECTURER IS A THIRD BRANCH HERE, NOT A THIRD COMPONENT. There was a
    LecturerTopNav.razor — a copy of this file with the `stn-` prefix renamed
    to `ltn-` — and it has been deleted. It was orphaned (no branch rendered
    it) and it had already drifted: it never received the two specificity
    fixes below, so the NotificationBell inside it would have lost to the
    bell's own stylesheet on bundle order and rendered at the sidebar's 34px
    while every other control in the bar was 38px. Three roles, one bar.

    Source: every screen in design-reference/motiva-student-final (the
    `… final.dc.html` files) AND every `Motiva Mentor *.dc.html` screen draws
    exactly this bar, unchanged, at the top of the canvas. The roles differ
    only in which destinations sit in the pill — which this component never
    hard-codes: it renders NavDefinitions.GetNavItems(_user), so the mentor's
    six (בית · המשימות שלי · פרויקטים בהנחייתי · בקשות · יומן · משאבים), the
    lecturer's seven and the student's come out of the same markup.

    Renamed from StudentTopNav when Mentor adopted the same shell. Behaviour
    for a student is unchanged: same nav source, same badge query, same
    avatar target, same logout. The `stn-` CSS prefix is kept — it is what
    ~200 lines of MotivaTopNav.razor.css and two `::deep` blocks hang off, and
    churning it would be a no-op diff. Read it as "shell top nav".

    WHAT IS DELIBERATELY NOT HERE
    The design's cluster also shows a magnifier. The product has no global
    search — no endpoint, no index, no results surface — so rendering the
    circle would put an inert control in the one place a student expects
    chrome to work. It is left out rather than faked, and the note stays here
    so it is re-added the day search exists.

    The calendar circle IS rendered: /milestones is a real destination, and
    the design shows the shortcut on the dashboard and project screens.
*@

<header class="stn-bar">

    @* The role's OWN home, read off its nav list rather than hard-coded, so
       the mark and the first pill can never point at different screens. For
       a student that is /dashboard, exactly as before. *@
    <a class="stn-logo" href="@HomeHref" aria-label="Motiva — לדף הבית">
        <img src="/images/motiva-logo.png" alt="Motiva" class="stn-logo-img" />
    </a>

    <nav class="stn-nav" aria-label="ניווט ראשי">
        @foreach (var item in _navMain)
        {
            <NavLink class="stn-nav-item"
                     ActiveClass="stn-nav-item-active"
                     href="@item.Href"
                     Match="@item.Match">
                <span class="stn-nav-label">@item.Label</span>
                @if (item.Href == RequestsRoute && _actionRequestCount > 0)
                {
                    <span class="stn-nav-count motiva-count" aria-label="@($"{_actionRequestCount} בקשות ממתינות לתגובתך")">
                        @_actionRequestCount
                    </span>
                }
                @if (item.Href == SubmissionsRoute && _submissionCount > 0)
                {
                    <span class="stn-nav-count motiva-count" aria-label="@($"{_submissionCount} הגשות")">
                        @_submissionCount
                    </span>
                }
            </NavLink>
        }
    </nav>

    <div class="stn-actions">

        @* Three roles, three real calendars — /milestones is the student's
           plan, /mentor/calendar the mentor's scheduling surface and
           /milestones-overview the lecturer's מועדים view. Each is a
           destination that role's own nav already carries. *@
        <a class="stn-icon-btn" href="@CalendarHref" title="יומן ותכנון" aria-label="יומן ותכנון">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="3" y="4" width="18" height="18" rx="3"></rect>
                <path d="M16 2v4M8 2v4M3 10h18"></path>
            </svg>
        </a>

        @* The bell owns its own popover. Same component, same polling, same
           role-aware target routing — only its appearance changes, and that
           is applied from this component's stylesheet via ::deep so the
           bell stays valid for AppTopBar (Lecturer / Staff / Admin). *@
        <NotificationBell Icon="NotificationBell.BellIcon.Stroked" />

        @* ── The dual-role mode control ───────────────────────────────────
           THE EXISTING COMPONENT, MOUNTED WHERE THE SHELL CAN STILL SHOW IT.
           UserModeToggle rendered only inside AppSideNav, so the moment a
           role moved onto this canvas shell its dual-role users lost both
           halves of what it does: the visible מרצה/מנחה switch, AND the
           OnParametersSetAsync block that hydrates the persisted mode out of
           localStorage and lands them on the matching dashboard after login.

           IT SITS BESIDE THE AVATAR, and that is the point of the placement
           rather than an arbitrary slot in the cluster: "which of my two
           roles am I acting as" is a fact about WHO IS SIGNED IN, so it
           belongs with the identity controls at the end of the bar and not
           beside the calendar and bell, which are destinations. The chip and
           the avatar read as one unit — the mode, then the person.

           It renders NOTHING for a single-role user (`_available.Count >= 2`
           is its own guard), so a student's bar and a mentor-only user's bar
           are byte-identical to what they were. No mode logic is duplicated
           or reimplemented here — this is a mount point, and the variant
           chooses markup only. *@
        <UserModeToggle Variant="UserModeToggle.ToggleVariant.Menu" />

        <a class="stn-avatar @(IsProfileRoute ? "stn-avatar-active" : "")"
           href="/settings"
           title="הפרופיל שלי"
           aria-label="הפרופיל שלי">
            @GetInitials()
        </a>

        <button type="button"
                class="stn-icon-btn stn-logout"
                @onclick="HandleLogout"
                title="התנתקות"
                aria-label="התנתקות">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M9 21H6a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h3"></path>
                <path d="M16 17l5-5-5-5M21 12H9"></path>
            </svg>
        </button>
    </div>
</header>

@code {
    [CascadingParameter] private User? _user { get; set; }

    private IReadOnlyList<NavItem> _navMain = Array.Empty<NavItem>();

    // "דורש ממך פעולה" — the count the design puts on the בקשות pill. Real
    // for both roles, and from each role's OWN source of truth, so the badge
    // can never disagree with the page it points at:
    //
    //   Student  GET api/project-requests/mine, bucketed by the same
    //            RequestBuckets.Of() the Requests page uses.
    //   Mentor   GET api/mentor/attention → Counts.AwaitingRequests, which is
    //            the documented single source of truth for everything waiting
    //            on a mentor — the same number Home's shortcut pill and the
    //            daily digest read.
    //   Lecturer GET api/dashboard?scope=lecturer → Summary.OpenRequests, the
    //            same snapshot the Lecturer dashboard's own "בקשות להחלטתך"
    //            pill reads. Server-side scope enforcement means a dual-role
    //            user in Staff mode gets the lecturer number here and the
    //            mentor number after flipping the toggle, from one component.
    private int _actionRequestCount;

    // Global total of all submissions visible to the lecturer (pending + approved).
    // Lecturer-only; always the GLOBAL total — does not change with team or tab filters.
    private int _submissionCount;

    /// <summary>Which experience this bar is being drawn for. Reads the same
    /// NavDefinitions.GetShell as AppLayout, so the bar and the shell can
    /// never disagree — including for a dual-role (Staff + Mentor) user, where
    /// the active mode decides and flipping the toggle re-runs this via the
    /// CurrentModeChanged subscription below.</summary>
    private NavDefinitions.Shell Shell => NavDefinitions.GetShell(_user);

    private bool IsMentor   => Shell == NavDefinitions.Shell.Mentor;
    private bool IsLecturer => Shell == NavDefinitions.Shell.Lecturer;

    /// <summary>The role's own home. Taken from the FIRST nav item — every
    /// role's list opens with בית — so the logo follows NavDefinitions instead
    /// of a literal that has to be remembered when a route moves.</summary>
    private string HomeHref =>
        _navMain.Count > 0 ? "/" + _navMain[0].Href.TrimStart('/') : "/dashboard";

    /// <summary>The route whose nav pill carries the primary action-count badge.
    ///
    /// <para>For Mentor this is now "mentor/tasks" (המשימות שלי), not
    /// "mentor-requests". The design puts the total incoming count (submissions +
    /// requests) on the tasks pill, not a requests-only count on the requests pill.
    /// See the design reference: משימות 1.png — badge "7" is on "המשימות שלי".</para>
    ///
    /// <para>Matched against the nav item's Href rather than a literal so the
    /// badge can never point at a different screen than the label.</para></summary>
    private string RequestsRoute => Shell switch
    {
        NavDefinitions.Shell.Mentor   => "mentor/tasks",
        NavDefinitions.Shell.Lecturer => "management/requests",
        _                             => "requests",
    };

    /// <summary>The route whose nav pill carries the הגשות count badge.
    /// Only meaningful for Lecturer; returns empty for other roles so the
    /// badge condition never fires.</summary>
    private string SubmissionsRoute => IsLecturer ? "lecturer/submissions" : string.Empty;

    /// <summary>Three roles, three real calendars: /milestones is the
    /// student's plan, /mentor/calendar the mentor's scheduling surface and
    /// /milestones-overview the lecturer's cross-cohort מועדים view. Each is a
    /// destination that role's own nav already carries.</summary>
    private string CalendarHref => Shell switch
    {
        NavDefinitions.Shell.Mentor   => "/mentor/calendar",
        NavDefinitions.Shell.Lecturer => "/milestones-overview",
        _                             => "/milestones",
    };

    private bool IsProfileRoute =>
        new Uri(Nav.Uri).AbsolutePath.Trim('/').Equals("settings", StringComparison.OrdinalIgnoreCase);

    protected override void OnInitialized()
    {
        Nav.LocationChanged += OnLocationChanged;
        UserModeService.CurrentModeChanged += OnModeChanged;
    }

    protected override async Task OnParametersSetAsync()
    {
        (_navMain, _) = NavDefinitions.GetNavItems(_user);

        // Only load once per session on first resolve of the user; the bar is
        // a persistent shell component and does not remount on navigation.
        if (_user is not null && !_countLoaded)
        {
            _countLoaded = true;
            await RefreshRequestCountAsync();
        }
    }

    private bool _countLoaded;

    /// <summary>
    /// Which fetch is current. Bumped by every mode change, and captured by
    /// each fetch before it awaits.
    ///
    /// <para><b>The race it closes, which is real and was observed.</b> On a
    /// cold load, a dual-role user's mode is still the default (Lecturer)
    /// when this component first resolves its user — UserModeService is
    /// hydrated from localStorage a moment later, by UserModeToggle. So the
    /// bar issues a LECTURER request, the persisted mode then arrives as
    /// Mentor, OnModeChanged issues a MENTOR request, and whichever HTTP call
    /// happens to land last wins. The lecturer one usually did, and the
    /// mentor's בקשות pill wore the lecturer's 18.</para>
    ///
    /// <para>A response is now written only if no mode change has happened
    /// since its own request went out. Nothing is cancelled and no request is
    /// skipped — a stale answer is simply not allowed to be the last
    /// word.</para></summary>
    private int _countGeneration;

    private async Task RefreshRequestCountAsync()
    {
        var generation = _countGeneration;
        int count;

        if (IsMentor)
        {
            // Never throws and never returns null — an empty snapshot leaves
            // the badge at 0 rather than blanking the bar.
            var attention = await _Attention.GetAsync();
            // The badge rides on "המשימות שלי" (mentor/tasks) and shows the TOTAL
            // incoming count — submissions waiting for review plus requests waiting
            // for a recommendation — matching the "7" badge in the design reference.
            count = attention.Counts.PendingSubmissions + attention.Counts.AwaitingRequests;
        }
        else if (IsLecturer)
        {
            var overview = await _Overview.GetAsync("lecturer");
            if (overview is null) return;

            count = overview.Summary.OpenRequests;

            // Load global submission total for the הגשות nav badge.
            // Runs in parallel with the overview fetch having already resolved.
            var pendingTask  = _PendingApprovals.GetPendingAsync();
            var approvedTask = _SubmissionsService.GetApprovedAsync();
            await Task.WhenAll(pendingTask, approvedTask);

            if (generation != _countGeneration) return;
            _submissionCount = (pendingTask.Result?.Count ?? 0)
                             + (approvedTask.Result?.Count ?? 0);
        }
        else
        {
            var mine = await _Requests.GetMyRequestsAsync();
            if (mine is null) return;

            count = mine.Count(r => RequestBuckets.Of(r.Status) == RequestBucket.Waiting);
        }

        // The mode moved while this was in flight — this answer is about the
        // other role's queue now. Drop it; the fetch that replaced it owns
        // the badge.
        if (generation != _countGeneration) return;

        _actionRequestCount = count;
        StateHasChanged();
    }

    // Leaving the role's requests page is the one navigation that can have
    // changed the count (a reply moves a request out of "waiting on you").
    // Refreshing only there keeps the badge honest without an API call per
    // page.
    private string _lastPath = "";

    private async void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        var path  = new Uri(Nav.Uri).AbsolutePath.Trim('/');
        var route = RequestsRoute;

        // StartsWith, not Equals: the lecturer's route is a two-segment
        // /management/requests whose page pushes deeper paths of its own, and
        // an exact match would then read every one of them as "not on the
        // requests page" and refresh on each. Student and mentor routes are
        // single-segment, so this is the same test it always was for them.
        bool leftRequests = _lastPath.StartsWith(route, StringComparison.OrdinalIgnoreCase)
                            && !path.StartsWith(route, StringComparison.OrdinalIgnoreCase);
        _lastPath = path;

        await InvokeAsync(StateHasChanged);
        if (leftRequests) await InvokeAsync(RefreshRequestCountAsync);
    }

    /// <summary>
    /// A dual-role user flipped מצב מרצה ⇄ מצב מנחה.
    ///
    /// <para>THE COUNT HAS TO BE RE-READ, not just the nav list. Each mode
    /// reads its own source — Summary.OpenRequests for the lecturer,
    /// Counts.AwaitingRequests for the mentor — and they are different
    /// numbers about different queues. Refreshing only the labels left the
    /// mentor's בקשות pill wearing the lecturer's badge until the next full
    /// page load.</para>
    ///
    /// <para>This did not need doing before Lecturer joined the canvas shell:
    /// the two modes rendered DIFFERENT AppLayout branches, so flipping the
    /// toggle destroyed this component and the new one loaded its own count
    /// on first render. Now both modes are the same branch and the bar
    /// persists across the switch — so the reload that used to come free has
    /// to be asked for. `_countLoaded` is cleared for the same reason: it is
    /// the once-per-session guard, and a mode change starts a new session's
    /// worth of state.</para></summary>
    private async void OnModeChanged()
    {
        (_navMain, _) = NavDefinitions.GetNavItems(_user);

        _countGeneration++;
        _countLoaded        = false;
        _actionRequestCount = 0;
        _submissionCount    = 0;

        await InvokeAsync(StateHasChanged);

        if (_user is not null)
        {
            _countLoaded = true;
            await InvokeAsync(RefreshRequestCountAsync);
        }
    }

    private string GetInitials()
    {
        var first = _user?.FirstName?.Trim() ?? "";
        var last  = _user?.LastName?.Trim()  ?? "";
        var a = first.Length > 0 ? first[..1] : "";
        var b = last.Length  > 0 ? last[..1]  : "";
        return (a + b) is { Length: > 0 } s ? s : "?";
    }

    private async Task HandleLogout()
    {
        await _Auth.Logout();
        Nav.NavigateTo(PageRoutes.Login, forceLoad: true);
    }

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
        UserModeService.CurrentModeChanged -= OnModeChanged;
    }
}
