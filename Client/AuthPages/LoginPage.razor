@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Components.Forms
@using AuthWithAdmin.Shared.AuthSharedModels
@using AuthWithAdmin.Client.Services
@using AuthWithAdmin.Client.ClientHelpers
@layout BlankLayout
@inject NavigationManager nav
@inject HttpClient Http
@inject IRememberedLoginService RememberedLogin

<PageTitle>Motiva — התחברות</PageTitle>

@page "/Login"

<div class="lp-page">

    <div class="lp-illustration" aria-hidden="true">

        <h2 class="lp-illustration-headline">
            כל מה שצריך, כדי לסיים <span class="lp-gradient-text">תואר.</span>
        </h2>
        <p class="lp-illustration-sub">המרחב החכם לניהול, מעקב ושיתוף פעולה בפרויקט הגמר.</p>

        <div class="lp-mock">
            <div class="lp-mock-window">
                <div class="lp-mock-sidebar">
                    <span class="lp-mock-sidebar-icon lp-mock-sidebar-icon-active">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 10.5 12 3l9 7.5" /><path d="M5 9.5V20h5v-6h4v6h5V9.5" /></svg>
                    </span>
                    <span class="lp-mock-sidebar-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 6h16M4 12h16M4 18h10" /></svg>
                    </span>
                    <span class="lp-mock-sidebar-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19h16M7 19V9M12 19V5M17 19v-7" /></svg>
                    </span>
                    <span class="lp-mock-sidebar-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9" /><path d="M10.3 21a1.94 1.94 0 0 0 3.4 0" /></svg>
                    </span>
                    <span class="lp-mock-sidebar-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3" /><path d="M12 2v2.5M12 19.5V22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M2 12h2.5M19.5 12H22M4.9 19.1l1.8-1.8M17.3 6.7l1.8-1.8" /></svg>
                    </span>
                </div>

                <div class="lp-mock-content">
                    <div class="lp-mock-row-top">
                        <div class="lp-mock-card lp-mock-progress-card">
                            <span class="lp-mock-card-title">התקדמות</span>
                            <div class="lp-mock-progress-ring">
                                <span class="lp-mock-progress-value">68%</span>
                            </div>
                        </div>

                        <div class="lp-mock-card lp-mock-tasks">
                            <span class="lp-mock-card-title">משימות</span>
                            <span class="lp-mock-row"><span class="lp-mock-status-dot lp-status-done"></span><span class="lp-mock-line"></span></span>
                            <span class="lp-mock-row"><span class="lp-mock-status-dot lp-status-progress"></span><span class="lp-mock-line"></span></span>
                            <span class="lp-mock-row"><span class="lp-mock-status-dot lp-status-pending"></span><span class="lp-mock-line lp-mock-line-short"></span></span>
                        </div>
                    </div>

                    <div class="lp-mock-row-bottom">
                        <div class="lp-mock-card lp-mock-milestone">
                            <span class="lp-mock-card-title">אבני דרך</span>
                            <div class="lp-mock-milestone-visual">
                                <svg class="lp-mock-milestone-path" viewBox="0 0 100 28" preserveAspectRatio="none">
                                    <path d="M2 22 C 26 22, 30 6, 50 6 S 76 22, 98 10" fill="none" stroke="url(#lp-milestone-gradient)" stroke-width="2.5" stroke-linecap="round" />
                                    <defs>
                                        <linearGradient id="lp-milestone-gradient" x1="0" y1="0" x2="1" y2="0">
                                            <stop offset="0" style="stop-color: var(--motiva-color-indigo)" />
                                            <stop offset="1" style="stop-color: var(--motiva-color-teal)" />
                                        </linearGradient>
                                    </defs>
                                </svg>
                                <svg class="lp-mock-flag-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M5 3v18" />
                                    <path d="M5 4h11l-2 4 2 4H5" />
                                </svg>
                            </div>
                        </div>

                        <div class="lp-mock-card lp-mock-reminders">
                            <div class="lp-mock-card-header">
                                <span class="lp-mock-card-title">תזכורות</span>
                                <svg class="lp-mock-bell-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9" />
                                    <path d="M10.3 21a1.94 1.94 0 0 0 3.4 0" />
                                </svg>
                            </div>
                            <span class="lp-mock-row"><span class="lp-mock-status-dot lp-status-progress"></span><span class="lp-mock-line lp-mock-line-short"></span></span>
                            <span class="lp-mock-row"><span class="lp-mock-status-dot lp-status-done"></span><span class="lp-mock-line"></span></span>
                        </div>
                    </div>
                </div>
            </div>

            <span class="lp-mock-sparkle lp-mock-sparkle-1">✦</span>
            <span class="lp-mock-sparkle lp-mock-sparkle-2">✦</span>
            <span class="lp-mock-dot lp-mock-dot-a"></span>
            <span class="lp-mock-dot lp-mock-dot-b"></span>
            <span class="lp-mock-dot lp-mock-dot-c"></span>
        </div>
    </div>

    <div class="lp-form-side">
    <div class="lp-form-inner">

        <img src="/images/motiva-logo.png" alt="Motiva" class="lp-logo" />
        <h1 class="lp-title">ממשיכים מכאן</h1>
        <span class="lp-title-accent"></span>
        <p class="lp-subtitle">התחברו כדי להמשיך לקדם את פרויקט הגמר.</p>

        <EditForm Model="@loginUser" OnValidSubmit="@login">
            <DataAnnotationsValidator />

            <div class="lp-field">
                <label class="lp-label" for="lp-email">כתובת מייל</label>
                <div class="lp-input-shell">
                    @* autocomplete="username" is what lets the browser's own
                       password manager offer and fill a saved account. The app
                       stores nothing itself — this only stops us getting in the
                       manager's way. *@
                    <InputText id="lp-email" class="lp-input" @bind-Value="loginUser.Email"
                               autocomplete="username" placeholder="your@email.com" />
                </div>
                <ValidationMessage For="@(() => loginUser.Email)" />
            </div>

            <div class="lp-field">
                <label class="lp-label" for="lp-password">סיסמה</label>
                <div class="lp-input-shell">
                    <InputText id="lp-password" class="lp-input" type="@(_showPassword ? "text" : "password")"
                               @bind-Value="loginUser.Password"
                               autocomplete="current-password" placeholder="••••••••" />
                    <button type="button" class="lp-toggle-visibility" @onclick="@(() => _showPassword = !_showPassword)"
                            title="@(_showPassword ? "הסתרת סיסמה" : "הצגת סיסמה")" aria-label="@(_showPassword ? "הסתרת סיסמה" : "הצגת סיסמה")">
                        @* open-iconic has no "eye-closed"/eye-slash glyph (.oi-eye is the only eye icon in the
                           set) — inlined here rather than depending on a class name that doesn't exist. *@
                        @if (_showPassword)
                        {
                            <svg class="lp-eye-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M17.94 17.94A10.94 10.94 0 0 1 12 20c-7 0-11-8-11-8a18.5 18.5 0 0 1 5.06-5.94M9.9 4.24A10.94 10.94 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24" />
                                <line x1="1" y1="1" x2="23" y2="23" />
                            </svg>
                        }
                        else
                        {
                            <svg class="lp-eye-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" />
                                <circle cx="12" cy="12" r="3" />
                            </svg>
                        }
                    </button>
                </div>
                <ValidationMessage For="@(() => loginUser.Password)" />
            </div>

            @* Sits directly under the password, quiet and secondary to the CTA:
               one control, no card, no explanatory copy. *@
            <label class="lp-remember">
                <input type="checkbox" class="lp-remember-box" @bind="loginUser.RememberMe" />
                <span class="lp-remember-text">זכור אותי</span>
            </label>

            @if (!string.IsNullOrEmpty(message))
            {
                <div class="lp-error">@message</div>
            }

            <button class="lp-btn" type="submit" disabled="@loading">
                @(loading ? "מתחבר..." : "התחברות")
            </button>

            <div class="lp-divider"><span>או</span></div>

            <a href="api/Users/google/@PageRoutes.Login" class="lp-google-btn">
                <svg class="lp-google-icon" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                    <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
                    <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
                    <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l3.66-2.84z" fill="#FBBC05"/>
                    <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
                </svg>
                התחברות עם Google
            </a>

            <div class="lp-footer">
                <a href="@PageRoutes.ForgetPassword" class="lp-link">שכחת סיסמה?</a>
                <p class="lp-footer-line">
                    אין לך חשבון?
                    <a href="@PageRoutes.Signup" class="lp-link">הרשמה</a>
                </p>
            </div>

        </EditForm>
    </div>
    </div>
</div>


@code {

    private LoginForm loginUser = new LoginForm();

    public string message = "";
    bool loading = false;
    bool _showPassword = false;

    [Inject]
    public IAuthenticationService _Auth { get; set; }


    [CascadingParameter]
    private User user { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (user != null)
        {
            nav.NavigateTo(await GetRedirectTarget(user), forceLoad: true, replace: true);
            return;
        }

        // Restore the FORM, not a session: the address last signed in with and
        // the state of the box. The password field is deliberately left empty —
        // filling it is the browser password manager's job, which the
        // username/current-password attributes invite it to do.
        var remembered = await RememberedLogin.GetRememberedEmailAsync();

        if (!string.IsNullOrWhiteSpace(remembered))
        {
            loginUser.Email      = remembered;
            loginUser.RememberMe = true;
        }
    }

    async Task login()
    {
        loading = true;
        message = "";

        // Captured before the call: AuthenticationService normalises Email on the
        // instance it is handed, and a failed attempt must not change what is
        // remembered.
        var attemptedEmail = loginUser.Email;
        var rememberMe     = loginUser.RememberMe;

        bool LoginOK = await _Auth.Login(loginUser);

        if (LoginOK)
        {
            // Only on success, and only ever this: an email and a boolean.
            // rememberMe false clears any previous entry, which is how unticking
            // the box takes effect on the next sign-in.
            await RememberedLogin.SaveAsync(attemptedEmail, rememberMe);

            var loggedInUser = await _Auth.GetUserFromClaimAsync();
            nav.NavigateTo(await GetRedirectTarget(loggedInUser), forceLoad: true, replace: true);
        }
        else
        {
            message = "שם המשתמש או הסיסמה אינם נכונים";
        }
        loading = false;
    }

    /// <summary>
    /// Where the user was originally headed, captured by NotAllowed when it
    /// refused an unauthenticated request. Absent on an ordinary login.
    /// </summary>
    [SupplyParameterFromQuery(Name = ReturnUrlPolicy.QueryKey)]
    public string? ReturnUrl { get; set; }

    private async Task<string> GetRedirectTarget(User? u)
    {
        // An intended destination wins over the role default — that is the
        // entire point of carrying it. It is honoured ONLY after passing both
        // of ReturnUrlPolicy's gates: it must be a local path (no open
        // redirect) and it must be reachable by this user's roles, so a stale
        // link into another shell falls through to the dashboard instead of
        // dead-ending on PendingPage.
        //
        // Checked before the student branch below, because that branch makes a
        // network call this case does not need.
        if (ReturnUrlPolicy.Sanitize(ReturnUrl, u) is { } destination)
            return destination;

        // Non-students go to their role-specific dashboard
        // (Admin/Staff → /dashboard/lecturer, Mentor → /dashboard/mentor).
        if (!RoleService.IsStudent(u))
            return RoleService.GetDefaultLandingRoute(u);

        // Students: check whether they have a team but no project yet
        try
        {
            var dashboard = await Http.GetFromJsonAsync<DashboardDto>("api/projects/my-dashboard");
            if (dashboard is not null && dashboard.HasTeam && dashboard.Project is null)
                return PageRoutes.StudentCatalog;
        }
        catch { /* fall through to dashboard on any error */ }

        return PageRoutes.Dashboard;
    }


}
