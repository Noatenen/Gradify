@inject IAuthenticationService Auth
@inject NavigationManager nav
@using AuthWithAdmin.Client.Services
@using Microsoft.AspNetCore.Components.Authorization

<!--דף שלא רואים לא צריך לעצב-->

<PageTitle>Redirecting...</PageTitle>

@code {

    // The same Task<AuthenticationState> that AuthorizeRouteView resolved before
    // showing us. Awaiting it guarantees we work with a COMPLETED auth state and
    // never mistake a still-loading (anonymous-by-default) state for "denied".
    [CascadingParameter]
    private Task<AuthenticationState>? AuthState { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (AuthState is not null)
        {
            var authState = await AuthState;

            if (authState.User?.Identity?.IsAuthenticated == true)
            {
                // Auth fully resolved: authenticated but not authorised for this page.
                var isVerified = authState.User.FindFirst("IsVerified")?.Value == "true";
                if (!isVerified)
                    nav.NavigateTo(PageRoutes.VerifyEmail);
                else
                    nav.NavigateTo(PageRoutes.Pending);
                return;
            }

            // Auth fully resolved: anonymous → send to login.
            nav.NavigateTo(ReturnUrlPolicy.LoginWithReturn(nav));
            return;
        }

        // Fallback: AuthState cascading parameter unavailable (should not happen
        // inside CascadingAuthenticationState, but guard against it anyway).
        User user = await Auth.GetUserFromClaimAsync();
        if (user != null)
        {
            if (!user.IsVerified)
                nav.NavigateTo(PageRoutes.VerifyEmail);
            else
                nav.NavigateTo(PageRoutes.Pending);
        }
        else
        {
            nav.NavigateTo(ReturnUrlPolicy.LoginWithReturn(nav));
        }
    }

}
