@inject IAuthenticationService Auth
@inject NavigationManager nav
@using AuthWithAdmin.Client.Services

<!--דף שלא רואים לא צריך לעצב-->

<PageTitle>Redirecting...</PageTitle>

@code {

    //משתמש ניסה להגיע למקום שאין לו הרשאות

    protected override async Task OnInitializedAsync()
    {
        //בדיקה האם מחובר
        User user = await Auth.GetUserFromClaimAsync();
        if (user != null)
        {
            if (!user.IsVerified)
            {
                //אם לא מאומת
                nav.NavigateTo(PageRoutes.VerifyEmail);
            }
            else
            {
                //אם מחובר וללא הרשאות - מעבר לדף המתנה
                //
                // Deliberately NOT carrying a returnUrl here. This branch means
                // "signed in, but this page is not yours", and PendingPage is
                // the existing answer for an account awaiting approval. Sending
                // them back to the same page after login would loop, and the
                // login screen is not even shown to an authenticated user.
                nav.NavigateTo(PageRoutes.Pending);
            }
        }
        else
        {
            // Not signed in — this is the case an emailed deep link lands in
            // when the session has expired or the mentor is on a device that
            // was never signed in. The requested location is still in the
            // address bar at this point, so it is captured now and handed to
            // the login page; nothing else in the app remembers it.
            //
            // ReturnUrlPolicy decides what is safe to carry — see there for the
            // open-redirect rules. A location not worth preserving yields a
            // plain login route.
            nav.NavigateTo(ReturnUrlPolicy.LoginWithReturn(nav));
        }
    }

}
