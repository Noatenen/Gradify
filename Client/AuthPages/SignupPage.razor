@page "/Signup"
@layout BlankLayout
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Components.Forms
@using AuthWithAdmin.Client.Services
@inject NavigationManager nav

@* Third screen onto the SAME shell as Login and Forget Password. It used to
   be a centered white card with its own SignupPage.razor.css — a second set
   of .lp-field/.lp-input/.lp-btn/.lp-footer/.lp-link definitions built on the
   older --g-* tokens, so the three auth screens shared class NAMES and
   nothing else. That file is gone; everything below comes from
   wwwroot/css/motiva-auth.css. *@

<AuthShell Title="הרשמה למערכת"
           Subtitle="יצירת חשבון למרצים ואנשי סגל.">

        <EditForm EditContext="@_editContext" OnValidSubmit="@signup">
            <DataAnnotationsValidator />

            @* Says who this page is NOT for. Students have never registered
               here — they arrive through the link issued when their team is
               created — and the page never said so, which is the whole reason
               a student would try. Copy only: no route, no second form, and
               the team-registration flow is untouched. *@
            <div class="lp-note">
                <svg class="lp-note-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="12" cy="12" r="9" />
                    <path d="M12 11v5" />
                    <path d="M12 8h.01" />
                </svg>
                <span>סטודנטים נכנסים למערכת דרך הקישור שנשלח בעת יצירת הקבוצה.</span>
            </div>

            <div class="sp-name-row">
                <div class="lp-field">
                    <label class="lp-label" for="sp-fname">שם פרטי</label>
                    <div class="lp-input-shell">
                        <InputText id="sp-fname" class="lp-input" @bind-Value="newUser.FirstName"
                                   autocomplete="given-name" placeholder="ישראל" />
                    </div>
                    <ValidationMessage For="@(() => newUser.FirstName)" />
                </div>
                <div class="lp-field">
                    <label class="lp-label" for="sp-lname">שם משפחה</label>
                    <div class="lp-input-shell">
                        <InputText id="sp-lname" class="lp-input" @bind-Value="newUser.LastName"
                                   autocomplete="family-name" placeholder="ישראלי" />
                    </div>
                    <ValidationMessage For="@(() => newUser.LastName)" />
                </div>
            </div>

            <div class="lp-field">
                <label class="lp-label" for="sp-email">כתובת מייל</label>
                <div class="lp-input-shell">
                    <InputText id="sp-email" class="lp-input" @bind-Value="newUser.Email"
                               autocomplete="username" placeholder="your@email.com" />
                </div>
                <ValidationMessage For="@(() => newUser.Email)" />
            </div>

            @* Both password fields stay RAW <input> with @@oninput rather than
               <InputText>: the strength meter and the match indicator update on
               every keystroke, which is what this binding gives them and what
               EditContext-driven binding would not. Unchanged from before —
               only the shell around them is new. *@
            <div class="lp-field">
                <label class="lp-label" for="sp-password">סיסמה</label>
                <div class="lp-input-shell">
                    <input id="sp-password" class="lp-input @(HasError(nameof(SignupForm.Password)) ? "invalid" : "")"
                           type="@(_showPassword ? "text" : "password")"
                           value="@newUser.Password"
                           @oninput="e => newUser.Password = e.Value?.ToString() ?? string.Empty"
                           autocomplete="new-password" placeholder="••••••••" />
                    <button type="button" class="lp-toggle-visibility" @onclick="@(() => _showPassword = !_showPassword)"
                            title="@(_showPassword ? "הסתרת סיסמה" : "הצגת סיסמה")" aria-label="@(_showPassword ? "הסתרת סיסמה" : "הצגת סיסמה")">
                        @if (_showPassword)
                        {
                            <svg class="lp-eye-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M17.94 17.94A10.94 10.94 0 0 1 12 20c-7 0-11-8-11-8a18.5 18.5 0 0 1 5.06-5.94M9.9 4.24A10.94 10.94 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24" />
                                <line x1="1" y1="1" x2="23" y2="23" />
                            </svg>
                        }
                        else
                        {
                            <svg class="lp-eye-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" />
                                <circle cx="12" cy="12" r="3" />
                            </svg>
                        }
                    </button>
                </div>
                <ValidationMessage For="@(() => newUser.Password)" />
                @if (!string.IsNullOrEmpty(newUser.Password))
                {
                    <div class="sp-strength">
                        <div class="sp-strength-bar">
                            <div class="sp-strength-fill sp-strength-@StrengthClass"
                                 style="width: @(PasswordStrength * 20)%"></div>
                        </div>
                        <span class="sp-strength-label sp-strength-label-@StrengthClass">@StrengthLabel</span>
                    </div>
                }
            </div>

            <div class="lp-field">
                <label class="lp-label" for="sp-confirm">אימות סיסמה</label>
                <div class="lp-input-shell">
                    <input id="sp-confirm" class="lp-input @(HasError(nameof(SignupForm.ConfirmPassword)) || ConfirmMismatch ? "invalid" : "")"
                           type="@(_showPassword ? "text" : "password")"
                           value="@newUser.ConfirmPassword"
                           @oninput="e => newUser.ConfirmPassword = e.Value?.ToString() ?? string.Empty"
                           autocomplete="new-password" placeholder="••••••••" />
                </div>
                @* Shown from the moment there is a password to confirm, not from
                   the moment the confirm box has text in it. ConfirmPassword
                   carries [Required] and [Compare], so an EMPTY box already
                   blocked the submit — and with the old condition this indicator
                   was not rendered yet, so the button did nothing and said
                   nothing. Same rules, same messages; they are just no longer
                   invisible in the one case that needed them most. *@
                @if (!string.IsNullOrEmpty(newUser.Password))
                {
                    <div class="sp-match @(ConfirmMismatch ? "sp-match--err" : "sp-match--ok")">
                        <span class="oi @(PasswordsMatch ? "oi-check" : "oi-x")" aria-hidden="true"></span>
                        <span>@(PasswordsMatch ? "הסיסמאות תואמות" : "הסיסמאות אינן תואמות")</span>
                    </div>
                }
            </div>

            @if (!string.IsNullOrEmpty(message))
            {
                <div class="lp-error" role="alert">@message</div>
            }

            <button class="lp-btn" type="submit" disabled="@loading">
                @(loading ? "נרשם..." : "הרשמה")
            </button>

            <div class="lp-divider"><span>או</span></div>

            <a href="api/Users/google/@PageRoutes.Signup" class="lp-google-btn">
                <svg class="lp-google-icon" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                    <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
                    <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
                    <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l3.66-2.84z" fill="#FBBC05"/>
                    <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
                </svg>
                הרשמה עם Google
            </a>

            <div class="lp-footer">
                <a href="@PageRoutes.Login" class="lp-link">כבר יש לך חשבון? התחברות</a>
            </div>

        </EditForm>

</AuthShell>

@code {
    SignupForm newUser = new SignupForm();
    public string message = "";
    bool loading = false;
    bool _showPassword = false;

    // Held explicitly rather than letting EditForm build one from Model=, so
    // the two raw <input>s below can ask it the same question <InputText> asks.
    // Same model, same DataAnnotationsValidator, same rules — EditForm does
    // exactly this internally when handed a Model.
    EditContext _editContext = default!;

    [Inject]
    public IAuthenticationService _Auth { get; set; }

    [CascadingParameter]
    private User user { get; set; }

    protected override async Task OnInitializedAsync()
    {
        _editContext = new EditContext(newUser);

        if (user != null)
            nav.NavigateTo(RoleService.GetDefaultLandingRoute(user), forceLoad: true, replace: true);
    }

    async Task signup()
    {
        message = "";
        loading = true;
        bool ok = await _Auth.Signup(newUser);
        if (ok)
        {
            // Refresh the user claim so the role-aware redirect picks up the
            // newly assigned role (server defaults brand-new accounts to
            // Student, but admins may upgrade later).
            var freshUser = await _Auth.GetUserFromClaimAsync();
            nav.NavigateTo(RoleService.GetDefaultLandingRoute(freshUser), forceLoad: true, replace: true);
        }
        else
        {
            message = "קרתה תקלה בהרשמה. אנא נסו שוב.";
        }
        loading = false;
    }

    /// <summary>
    /// The state Blazor's own &lt;InputText&gt; turns into the <c>invalid</c>
    /// class. The password boxes are raw &lt;input&gt;s — the strength meter and
    /// the match indicator need per-keystroke binding — so they never receive
    /// it, and their shells stayed grey while every field above them went red.
    /// Applied by hand here from the SAME validation messages; no rule, no
    /// message and no submit behaviour changes.
    /// </summary>
    private bool HasError(string field) =>
        _editContext is not null &&
        _editContext.GetValidationMessages(new FieldIdentifier(newUser, field)).Any();

    /// <summary>
    /// There is a password to confirm and the confirmation does not match it.
    /// One source of truth for the indicator's wording and the field's red
    /// border, so the two can never disagree.
    /// </summary>
    private bool ConfirmMismatch =>
        !string.IsNullOrEmpty(newUser.Password) && !PasswordsMatch;

    private bool PasswordsMatch =>
        !string.IsNullOrEmpty(newUser.ConfirmPassword) &&
        newUser.Password == newUser.ConfirmPassword;

    private int PasswordStrength
    {
        get
        {
            var p = newUser.Password ?? "";
            if (p.Length == 0) return 0;
            int score = 0;
            if (p.Length >= 8) score++;
            if (p.Any(char.IsUpper)) score++;
            if (p.Any(char.IsLower)) score++;
            if (p.Any(char.IsDigit)) score++;
            if (p.Any(c => !char.IsLetterOrDigit(c))) score++;
            return score;
        }
    }

    private string StrengthClass => PasswordStrength switch
    {
        <= 1 => "weak",
        <= 3 => "medium",
        _    => "strong"
    };

    private string StrengthLabel => PasswordStrength switch
    {
        1 => "חלשה מאוד",
        2 => "חלשה",
        3 => "בינונית",
        4 => "חזקה",
        _ => "חזקה מאוד"
    };
}
