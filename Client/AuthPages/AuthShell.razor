@*
    AuthShell — the Motiva authentication experience, rendered once.

    Every unauthenticated screen is the SAME page with a different form in
    it: the same split layout, the same decorative left panel, the same
    logo / title / accent / subtitle stack, the same 400px form column.
    Only the copy and the fields change, so only the copy and the fields
    are parameters — everything else lives here and cannot drift between
    Login and Forget Password.

    `.motiva-auth` on the root is the hook every rule in
    wwwroot/css/motiva-auth.css hangs off. It is required: SignupPage still
    carries its own scoped `lp-*` rules for an older centered-card layout,
    and the hook is what keeps the two from colliding.

    No .razor.css of its own — the styles are global for exactly the reason
    this component exists. Scoped CSS could not reach @ChildContent anyway.
*@

<div class="lp-page motiva-auth">

    @* Decorative only — aria-hidden, and hidden outright under 768px. *@
    <div class="lp-illustration" aria-hidden="true">

        <h2 class="lp-illustration-headline">
            כל מה שצריך, כדי לסיים <span class="lp-gradient-text">תואר.</span>
        </h2>
        <p class="lp-illustration-sub">המרחב החכם לניהול, מעקב ושיתוף פעולה בפרויקט הגמר.</p>

        <div class="lp-mock">
            <div class="lp-mock-window">
                <div class="lp-mock-sidebar">
                    <span class="lp-mock-sidebar-icon lp-mock-sidebar-icon-active">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 10.5 12 3l9 7.5" /><path d="M5 9.5V20h5v-6h4v6h5V9.5" /></svg>
                    </span>
                    <span class="lp-mock-sidebar-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 6h16M4 12h16M4 18h10" /></svg>
                    </span>
                    <span class="lp-mock-sidebar-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19h16M7 19V9M12 19V5M17 19v-7" /></svg>
                    </span>
                    <span class="lp-mock-sidebar-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9" /><path d="M10.3 21a1.94 1.94 0 0 0 3.4 0" /></svg>
                    </span>
                    <span class="lp-mock-sidebar-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3" /><path d="M12 2v2.5M12 19.5V22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M2 12h2.5M19.5 12H22M4.9 19.1l1.8-1.8M17.3 6.7l1.8-1.8" /></svg>
                    </span>
                </div>

                <div class="lp-mock-content">
                    <div class="lp-mock-row-top">
                        <div class="lp-mock-card lp-mock-progress-card">
                            <span class="lp-mock-card-title">התקדמות</span>
                            <div class="lp-mock-progress-ring">
                                <span class="lp-mock-progress-value">68%</span>
                            </div>
                        </div>

                        <div class="lp-mock-card lp-mock-tasks">
                            <span class="lp-mock-card-title">משימות</span>
                            <span class="lp-mock-row"><span class="lp-mock-status-dot lp-status-done"></span><span class="lp-mock-line"></span></span>
                            <span class="lp-mock-row"><span class="lp-mock-status-dot lp-status-progress"></span><span class="lp-mock-line"></span></span>
                            <span class="lp-mock-row"><span class="lp-mock-status-dot lp-status-pending"></span><span class="lp-mock-line lp-mock-line-short"></span></span>
                        </div>
                    </div>

                    <div class="lp-mock-row-bottom">
                        <div class="lp-mock-card lp-mock-milestone">
                            <span class="lp-mock-card-title">אבני דרך</span>
                            <div class="lp-mock-milestone-visual">
                                <svg class="lp-mock-milestone-path" viewBox="0 0 100 28" preserveAspectRatio="none">
                                    <path d="M2 22 C 26 22, 30 6, 50 6 S 76 22, 98 10" fill="none" stroke="url(#lp-milestone-gradient)" stroke-width="2.5" stroke-linecap="round" />
                                    <defs>
                                        <linearGradient id="lp-milestone-gradient" x1="0" y1="0" x2="1" y2="0">
                                            <stop offset="0" style="stop-color: var(--motiva-color-indigo)" />
                                            <stop offset="1" style="stop-color: var(--motiva-color-teal)" />
                                        </linearGradient>
                                    </defs>
                                </svg>
                                <svg class="lp-mock-flag-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M5 3v18" />
                                    <path d="M5 4h11l-2 4 2 4H5" />
                                </svg>
                            </div>
                        </div>

                        <div class="lp-mock-card lp-mock-reminders">
                            <div class="lp-mock-card-header">
                                <span class="lp-mock-card-title">תזכורות</span>
                                <svg class="lp-mock-bell-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9" />
                                    <path d="M10.3 21a1.94 1.94 0 0 0 3.4 0" />
                                </svg>
                            </div>
                            <span class="lp-mock-row"><span class="lp-mock-status-dot lp-status-progress"></span><span class="lp-mock-line lp-mock-line-short"></span></span>
                            <span class="lp-mock-row"><span class="lp-mock-status-dot lp-status-done"></span><span class="lp-mock-line"></span></span>
                        </div>
                    </div>
                </div>
            </div>

            <span class="lp-mock-sparkle lp-mock-sparkle-1">✦</span>
            <span class="lp-mock-sparkle lp-mock-sparkle-2">✦</span>
            <span class="lp-mock-dot lp-mock-dot-a"></span>
            <span class="lp-mock-dot lp-mock-dot-b"></span>
            <span class="lp-mock-dot lp-mock-dot-c"></span>
        </div>
    </div>

    <div class="lp-form-side">
    <div class="lp-form-inner">

        <img src="images/motiva-logo.png" alt="Motiva" class="lp-logo" />
        <h1 class="lp-title">@Title</h1>
        <span class="lp-title-accent"></span>
        <p class="lp-subtitle">@Subtitle</p>

        @ChildContent

    </div>
    </div>
</div>

@code {
    /// <summary>The screen's heading — "ממשיכים מכאן", "שכחת סיסמה?".</summary>
    [Parameter, EditorRequired] public string Title { get; set; } = "";

    /// <summary>One line under the accent rule saying what this screen is for.</summary>
    [Parameter, EditorRequired] public string Subtitle { get; set; } = "";

    /// <summary>The form itself — the only thing that differs between screens.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
