@page "/Forget-Password"
@using AuthWithAdmin.Client.ClientHelpers
@using AuthWithAdmin.Shared.AuthSharedModels
@layout BlankLayout

@inject HttpClient http

@* Same shell as Login, and deliberately nothing of its own: this screen is a
   STATE of the authentication experience, not a page that resembles it. It
   used to render on MainLayout — which wrapped it in the signed-in app's
   grey nav chrome on a screen nobody is signed in on — with bare unstyled
   markup inside. BlankLayout + AuthShell is what Login has always used. *@

<AuthShell Title="שכחת סיסמה?"
           Subtitle="הזינו את כתובת המייל שלכם ונשלח אליכם קישור לאיפוס הסיסמה.">

    <EditForm Model="email" OnValidSubmit="Send">
        <DataAnnotationsValidator />

        <div class="lp-field">
            <label class="lp-label" for="fp-email">כתובת מייל</label>
            <div class="lp-input-shell">
                <InputText id="fp-email" class="lp-input" @bind-Value="email.Email"
                           autocomplete="username" placeholder="your@email.com" />
            </div>
            <ValidationMessage For="@(() => email.Email)" />
        </div>

        @* The recovery result, unchanged in meaning — only in dress. Success
           and failure were one grey <p> before; they are now the shell's own
           two notice treatments, so "a link was sent" and "no such user" no
           longer look identical. @succeeded is set alongside @message in the
           same switch and carries no logic of its own. *@
        @if (!string.IsNullOrEmpty(message))
        {
            @if (succeeded)
            {
                <div class="lp-success" role="status">@message</div>
            }
            else
            {
                <div class="lp-error" role="alert">@message</div>
            }
        }

        <button class="lp-btn" type="submit" disabled="@loading">
            @(loading ? "שולח..." : "איפוס סיסמה")
        </button>

        <div class="lp-footer">
            <a href="@PageRoutes.Login" class="lp-link">חזרה להתחברות</a>
            <p class="lp-footer-line">
                אין לך חשבון?
                <a href="@PageRoutes.Signup" class="lp-link">הרשמה</a>
            </p>
        </div>

    </EditForm>

</AuthShell>


@code {

    [Inject]
    public IAuthenticationService _Auth { get; set; }


    ForgetPasswordDTO email = new ForgetPasswordDTO();
    string message ="";
    bool loading = false;

    // Presentation only: which of the two notice treatments the message above
    // gets. Set in the same switch that already decided the wording.
    bool succeeded = false;

    async Task Send()
    {
        message = "";
        loading = true;
        string result = await _Auth.ForgetPassword(email);
        switch (result)
        {
            case AuthResults.Success:
                message = $"קישור לאיפוס הסיסמה נשלח לכתובת {email.Email}";
                succeeded = true;
                break;
            case AuthResults.UserNotFound:
                message = "לא קיים משתמש במייל זה";
                succeeded = false;
                break;
            default:
                message = "קרתה תקלה";
                succeeded = false;
                break;

        }
        loading = false;
    }


}
