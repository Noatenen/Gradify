<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
    </PropertyGroup>

    <ItemGroup>
        <SupportedPlatform Include="browser"/>
    </ItemGroup>

    <ItemGroup>
      <!--
        FIVE <Content Include="obj\Debug\net10.0\..."> ITEMS WERE REMOVED HERE.

        They named this project's own build intermediates - the compiled
        assembly, its PDB, two MSBuild input caches and the SourceLink map -
        and were accidental: an IDE "include in project" on generated files.
        Nothing tracked them (obj/ is git-ignored), and nothing needs them.
        AuthWithAdmin.Shared.dll reaches the Server through the ProjectReference
        that already exists; it does not additionally need to be copied as
        content.

        They were actively harmful to publish. Content items are published by
        default, so they hardcoded a DEBUG output path into the deliverable:
        publishing Release from a clean clone (where obj\Debug\ has never been
        created) asks MSBuild to copy five files that do not exist, and when
        they do exist it ships a stale Debug assembly and a PDB alongside the
        real Release build.

        The appsettings.json Update below is left alone. This project has no
        appsettings.json, so Update matches nothing and the item is inert - but
        it is a metadata declaration rather than a path into build output, and
        removing it is not part of this change.
      -->
      <Content Update="appsettings.json">
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </Content>
    </ItemGroup>
</Project>
